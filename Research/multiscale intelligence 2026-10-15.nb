      "input" -> "V(x)=\\mathcal V[\\Psi,\\mathcal M,\\mathcal N,R]", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "507a16a8-8b76-624c-bb4c-90491067166e"],
 "\nwhere: \n",
