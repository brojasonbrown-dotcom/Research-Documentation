          RowBox[{"\[DoubleVerticalBar]", 
            SubscriptBox[
             StyleBox["x", "TI"], 
             StyleBox["a", "TI"]], "-", 
            SubscriptBox[
             StyleBox["x", "TI"], 
             StyleBox["b", "TI"]], 
            SuperscriptBox["\[DoubleVerticalBar]", "2"]}]], " ", 
         StyleBox["h", "TI"], "\[NegativeThinSpace]", 
         RowBox[{"(", 
           RowBox[{
             FractionBox[
              RowBox[{
                StyleBox["x", "TI"], "-", 
                SubscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["b", "TI"]]}], 
              RowBox[{"\[DoubleVerticalBar]", 
                StyleBox["x", "TI"], "-", 
                SubscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["b", "TI"]], "\[DoubleVerticalBar]"}]], 
             "\[CenterDot]", 
             FractionBox[
              RowBox[{
                SubscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["b", "TI"]], "-", 
                SubscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["a", "TI"]]}], 
              RowBox[{"\[DoubleVerticalBar]", 
                SubscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["b", "TI"]], "-", 
                SubscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["a", "TI"]], "\[DoubleVerticalBar]"}]]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\nu_b(x)=\\kappa\\,\\frac{\\rho_a}{\\|x_a-x_b\\|^2}\\,\n\
h\\!\\left(\\frac{x-x_b}{\\|x-x_b\\|}\\cdot \
\\frac{x_b-x_a}{\\|x_b-x_a\\|}\\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3e9bc20e-2515-f74e-98c4-2adea4801d3a"],
 "\nwith ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
