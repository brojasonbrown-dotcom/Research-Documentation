Cell["Interpretation: ", "Text",ExpressionUUID->"8bc35da2-e6fd-f64c-b622-b98da149ac53"],

Cell["the field state is tested for scale robustness,", "Item",ExpressionUUID->"c877a4ed-b20c-0c42-9c17-b6216d62af74"],

Cell["the dynamics are tested for spectral persistence,", "Item",ExpressionUUID->"1f4723e6-3583-d946-9e3a-6c6e92dbe280"],

Cell["selection under recurrence is tested,", "Item",ExpressionUUID->"d2117133-6eae-724e-9f0f-ee5b2120be48"],

Cell["features are extracted into a finite vector,", "Item",ExpressionUUID->"1c061507-7e70-1641-9e9a-2826b1433cc9"],

Cell["the vector becomes usable as neural input.", "Item",ExpressionUUID->"679f5f5b-1efb-bd44-be00-b50e67358648"],

