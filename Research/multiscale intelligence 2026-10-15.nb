 "\nGood catch: your example failed because this line can leave tiny complex \
noise in the diagonal entries: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"Max", "[", 
          RowBox[{"selection", "[", "\"PointerWeights\"", "]"}], "]"}], ">", 
        RowBox[{"1", "/", "2"}]}]], "ChatCode", "Input", LanguageCategory -> 
     "Input", ShowAutoStyles -> True, ShowStringCharacters -> True, 
     ShowSyntaxStyles -> True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "bb15c740-ab29-6e4f-8972-19d92217f4ab"],
 "\nSo before doing \[OpenCurlyDoubleQuote]17 step 1\[CloseCurlyDoubleQuote], \
first I\[CloseCurlyQuote]ll correct the ",
 StyleBox["selection verdict logic",
  FontWeight->Bold],
 ", then I\[CloseCurlyQuote]ll lay out a ",
 StyleBox["full, rigorous Step 17.1 specialization plan for training with \
neural nets",
  FontWeight->Bold],
 " in Wolfram Language. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"378c4b98-8acb-7141-b1ab-3ba2ea07f271"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"1. Fix the notebook bug first\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"21e629ba-f800-8c4b-85da-4bb7eec9a7a2"],
 "\nIn your ",
 Cell[BoxData[
  TemplateBox[{
    Cell["multiscaleResonanceReport", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "3c6cf6e5-a085-0a4a-aa20-457d6ffe4072"],
 ", replace the selection verdict test with a real-valued version. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Problem\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e6c6d63f-6c99-7f41-b645-31295f0da839"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell["pointerModeData", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "26218964-fd86-a54d-8eba-55590ca3d702"],
 " returns diagonal entries that may be numerically complex with tiny \
imaginary parts like: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0.5", "\[PlusMinus]", "5.5", "\[Cross]", 
         SuperscriptBox["10", "-17"], 
         StyleBox["i", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "0.5 \\pm 5.5\\times 10^{-17} i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a0d5fa05-2adf-534c-86c3-67e262dfc2af"],
 "\nThen ",
 Cell[BoxData[
  TemplateBox[{
   "Max", "paclet:ref/Max", 
    "https://reference.wolfram.com/language/ref/Max.html"},
   "TextRefLink"]],ExpressionUUID->"eae5e5c9-9141-be48-94ee-92effc094db2"],
 " cannot order them. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Correct fix\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"7b1f9ce9-a4bc-bb4a-b9eb-a41a857b54b1"],
 "\nUse either ",
 Cell[BoxData[
  TemplateBox[{
   "Re", "paclet:ref/Re", 
    "https://reference.wolfram.com/language/ref/Re.html"},
   "TextRefLink"]],ExpressionUUID->"0c832521-0a8f-6b4b-993c-87bddae5e45e"],
 " + ",
 Cell[BoxData[
  TemplateBox[{
   "Chop", "paclet:ref/Chop", 
    "https://reference.wolfram.com/language/ref/Chop.html"},
   "TextRefLink"]],ExpressionUUID->"921c160d-0a05-f54c-bba5-3f19b1a395d4"],
 ", or ",
 Cell[BoxData[
  TemplateBox[{
   "Abs", "paclet:ref/Abs", 
    "https://reference.wolfram.com/language/ref/Abs.html"},
   "TextRefLink"]],ExpressionUUID->"9db22daa-efdf-1143-a083-e81f523f4ceb"],
 " if you truly want magnitudes. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Recommended replacement\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"c4807686-af04-434d-99a9-0a08a1bce9e6"],
 "\nChange this part: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"\"SelectionStableQ\"", "->", 
        RowBox[{
          RowBox[{"Max", "[", 
            RowBox[{"selection", "[", "\"PointerWeights\"", "]"}], "]"}], ">", 
          RowBox[{"1", "/", "2"}]}]}]], "ChatCode", "Input", LanguageCategory -> 
     "Input", ShowAutoStyles -> True, ShowStringCharacters -> True, 
     ShowSyntaxStyles -> True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "e5ce2c66-7557-df40-8aa2-8774b687b52c"],
 "\nto: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{"\"SelectionStableQ\"", "->", 
        RowBox[{
          RowBox[{"Max", "[", 
            RowBox[{"Chop", " ", "@", " ", 
              RowBox[{"Re", " ", "@", " ", 
                RowBox[{"selection", "[", "\"PointerWeights\"", "]"}]}]}], 
            "]"}], ">", 
          RowBox[{"1", "/", "2"}]}]}]], "ChatCode", "Input", LanguageCategory -> 
     "Input", ShowAutoStyles -> True, ShowStringCharacters -> True, 
     ShowSyntaxStyles -> True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "1bde4ead-b7a1-3345-9f53-4260e9d15b98"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Safer full rewrite of the report function\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"6a9fb016-e02f-1743-901f-9a0700fcc1d0"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", 
            
            RowBox[{"multiscaleResonanceReport", ",", 
              "synthesisEvidenceScore"}], "]"}], ";"}], "\[IndentingNewLine]",
         "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            
            RowBox[{"multiscaleResonanceReport", "[", "\[IndentingNewLine]", 
              "  ", 
              RowBox[{
                RowBox[{"matrix_", "?", "MatrixQ"}], ",", 
                "\[IndentingNewLine]", "  ", "state_List", ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"initialDensity_", "?", "MatrixQ"}], ",", 
                "\[IndentingNewLine]", "  ", "phaseSchedule_List", ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"p_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", 
                "  ", 
                RowBox[{"steps_Integer", " ", ":", " ", "6"}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"tol_", " ", ":", " ", 
                  RowBox[{"10", "^", 
                    RowBox[{"-", "6"}]}]}]}], "\[IndentingNewLine]", "]"}], 
            ":=", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", 
                  
                  RowBox[{
                   "spec", ",", "scale", ",", "selection", ",", 
                    "pointerWeights", ",", "verdict"}], "}"}], ",", 
                "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                RowBox[{
                  RowBox[{"spec", "=", 
                    RowBox[{"spectralData", "[", "matrix", "]"}]}], ";", 
                  "\[IndentingNewLine]", "  ", 
                  RowBox[{"scale", "=", 
                    RowBox[{"scaleFixedPointData", "[", 
                    RowBox[{"state", ",", "steps", ",", "tol"}], "]"}]}], ";",
                   "\[IndentingNewLine]", "  ", 
                  RowBox[{"selection", "=", 
                    RowBox[{"pointerModeData", "[", 
                    
                    RowBox[{
                    "initialDensity", ",", "phaseSchedule", ",", "p"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", "  ", 
                  RowBox[{"pointerWeights", "=", 
                    RowBox[{"Chop", " ", "@", " ", 
                    RowBox[{"Re", " ", "@", " ", 
                    
                    RowBox[{
                    "selection", "[", "\"PointerWeights\"", "]"}]}]}]}], ";", 
                  "\[IndentingNewLine]", "  ", "\[IndentingNewLine]", "  ", 
                  RowBox[{"verdict", "=", 
                    RowBox[{"<|", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"\"SpectrallyStableQ\"", "->", 
                    RowBox[{"TrueQ", "[", 
                    RowBox[{"spec", "[", "\"ContinuousTimeStableQ\"", "]"}], 
                    "]"}]}], ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"ScaleRobustQ\"", "->", 
                    RowBox[{"TrueQ", "[", 
                    RowBox[{"scale", "[", "\"FixedPointQ\"", "]"}], "]"}]}], 
                    ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"SelectionStableQ\"", "->", 
                    RowBox[{
                    RowBox[{"Max", "[", "pointerWeights", "]"}], ">", 
                    RowBox[{"1", "/", "2"}]}]}]}], "\[IndentingNewLine]", 
                    "  ", "|>"}]}], ";", "\[IndentingNewLine]", "  ", 
                  "\[IndentingNewLine]", "  ", 
                  RowBox[{"<|", "\[IndentingNewLine]", "    ", 
                    RowBox[{
                    RowBox[{"\"Spectral\"", "->", "spec"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"Scale\"", "->", "scale"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"Selection\"", "->", 
                    RowBox[{"Append", "[", 
                    RowBox[{"selection", ",", 
                    
                    RowBox[{"\"PointerWeightsReal\"", "->", 
                    "pointerWeights"}]}], "]"}]}], ",", "\[IndentingNewLine]",
                     "    ", 
                    RowBox[{"\"Verdict\"", "->", "verdict"}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"AllThreeQ\"", "->", 
                    RowBox[{"And", " ", "@@", " ", 
                    RowBox[{"Values", "[", "verdict", "]"}]}]}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"FixedScaleResidual\"", "->", 
                    RowBox[{"fixedScaleResidual", "[", "state", "]"}]}]}], 
                    "\[IndentingNewLine]", "  ", "|>"}]}]}], 
              "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            
            RowBox[{"synthesisEvidenceScore", "[", "report_Association", 
              "]"}], ":=", 
            RowBox[{"Mean", " ", "@", " ", 
              RowBox[{"Boole", " ", "@", " ", 
                RowBox[{"Values", "[", 
                  RowBox[{"report", "[", "\"Verdict\"", "]"}], "]"}]}]}]}], 
          ";"}]}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "67b6abf6-22f9-2044-8ddb-97132f66eab6"],
