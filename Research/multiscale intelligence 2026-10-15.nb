                ";", "\[IndentingNewLine]", "  ", 
                RowBox[{"seq", "=", 
                  RowBox[{"NestList", "[", 
                    
                    RowBox[{
                    "coupledFieldNetworkStep", ",", "state0", ",", "steps"}], 
                    "]"}]}], ";", "\[IndentingNewLine]", "  ", 
                RowBox[{"inputSeq", "=", 
