Cell[CellGroupData[{

Cell["13. Mind-field layer", "Section",ExpressionUUID->"1819c1b7-3a35-884b-98da-8d97bfebaa01"],

Cell[CellGroupData[{

Cell["13.1 Careful statement", "Subsection",ExpressionUUID->"d427174a-23fd-4a4b-9353-3971a786676e"],

Cell["\<\
The claim that \[OpenCurlyDoubleQuote]the mind also has a field\
\[CloseCurlyDoubleQuote] is not established by the mathematics here.\
\>", "Text",ExpressionUUID->"6a5053a3-1856-c840-b56d-4c79e9034a9a"],

Cell[TextData[{
 "However, the notebook provides a disciplined way to model a ",
 StyleBox["mind-field hypothesis",
  FontWeight->Bold],
 ": "
}], "Text",ExpressionUUID->"ed7a2bbf-bd5f-754e-aa98-db0b402f8c6f"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"a recurrent, high-dimensional, geometry-sensitive, \
interaction-selected state field supporting stable modes, circulation \
structure, and latent encodings usable for adaptive inference.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"5a86998c-c665-4e4a-888f-9e6bfdbb7c76"]
}, Open  ]],

Cell[CellGroupData[{

Cell["13.2 Minimal formal interpretation", "Subsection",ExpressionUUID->"32566ee1-4744-cf48-a0ef-7987e9415188"],

Cell["A mind-field candidate should exhibit all of the following:", "Text",ExpressionUUID->"dea44680-881c-2a46-8c3e-50431668f42b"],

Cell["1. persistent modes,", "Text",ExpressionUUID->"928774a2-3167-5846-8141-c0a47178d4d9"],

Cell["2. bounded scale distortion,", "Text",ExpressionUUID->"d563d90d-28bd-8146-9b2c-87e7a0ae2cb9"],

Cell["3. selective stabilization under recurrent coupling,", "Text",ExpressionUUID->"8de0a4f9-d9d9-6349-8020-5f3bb29f13ad"],

Cell["4. structured attractor or circulation topology,", "Text",ExpressionUUID->"5f1117d1-beb5-0941-ad2d-ab7862ce2d0c"],

Cell["\<\
5. interpretable latent embedding for downstream computation.\
\>", "Text",ExpressionUUID->"bbe9d29f-aed7-a443-b1ad-814f0489a13c"],

Cell["\<\
This is still a model hypothesis, not a proof of consciousness ontology. \
\>", "Text",ExpressionUUID->"0594a87b-6fc8-4146-b904-d5c97ded568e"],

