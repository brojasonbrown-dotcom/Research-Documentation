              RowBox[{"len_Integer", "?", "Positive"}], "]"}], ":=", 
            RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"{", 
                  RowBox[{"state", ",", "features", ",", "label"}], "}"}], 
                ",", "\[IndentingNewLine]", "  ", 
                RowBox[{
                  RowBox[{"state", "=", 
                    RowBox[{"Normalize", "[", 
                    RowBox[{
                    RowBox[{"RandomReal", "[", 
                    RowBox[{"1", ",", "len"}], "]"}], ",", "Norm"}], "]"}]}], 
                  ";", "\[IndentingNewLine]", "  ", 
                  RowBox[{"features", "=", 
                    
                    RowBox[{
                    "fieldFeatureVectorNumeric", "[", "state", "]"}]}], ";", 
                  "\[IndentingNewLine]", "  ", 
                  RowBox[{"label", "=", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"features", "[", 
                    RowBox[{"[", "6", "]"}], "]"}], "<", "0.2"}], ",", 
                    "\"ScaleStable\"", ",", "\"ScaleUnstable\""}], "]"}]}], 
                  ";", "\[IndentingNewLine]", "  ", 
                  RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"Input\"", "->", "features"}], ",", 
                    RowBox[{"\"Target\"", "->", "label"}], ",", 
                    RowBox[{"\"State\"", "->", "state"}]}], "|>"}]}]}], 
              "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"makeRegressionExample", "[", 
