Cell["14. Synthesis report", "Section",ExpressionUUID->"1308a9d8-1d3c-8e40-a798-4a47961657e4"],

Cell[CellGroupData[{

Cell["14.1 Combined diagnostics", "Subsection",ExpressionUUID->"b8193b66-0c3b-ee48-a13f-7992af89593f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"multiscaleResonanceReport", ",", "synthesisEvidenceScore"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"multiscaleResonanceReport", "[", 
     RowBox[{
      RowBox[{"matrix_", "?", "MatrixQ"}], ",", "state_List", ",", 
      RowBox[{"initialDensity_", "?", "MatrixQ"}], ",", "phaseSchedule_List", 
      ",", 
      RowBox[{"p_", "?", "NumericQ"}], ",", 
      RowBox[{"steps_Integer", ":", "6"}], ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"spec", ",", "scale", ",", "selection", ",", "verdict"}], 
       "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"spec", "=", 
        RowBox[{"spectralData", "[", "matrix", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"scale", "=", 
        RowBox[{"scaleFixedPointData", "[", 
         RowBox[{"state", ",", "steps", ",", "tol"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"selection", "=", 
        RowBox[{"pointerModeData", "[", 
         RowBox[{"initialDensity", ",", "phaseSchedule", ",", "p"}], "]"}]}], 
       ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"verdict", "=", 
        RowBox[{"<|", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"\"\<SpectrallyStableQ\>\"", "->", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"spec", "[", "\"\<ContinuousTimeStableQ\>\"", "]"}], 
            "]"}]}], ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<ScaleRobustQ\>\"", "->", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"scale", "[", "\"\<FixedPointQ\>\"", "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"\"\<SelectionStableQ\>\"", "->", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"selection", "[", "\"\<PointerWeights\>\"", "]"}], "]"}],
             ">", 
            RowBox[{"1", "/", "2"}]}]}]}], "\[IndentingNewLine]", "  ", 
         "|>"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Spectral\>\"", "->", "spec"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Scale\>\"", "->", "scale"}], ",", "\[IndentingNewLine]",
          "    ", 
         RowBox[{"\"\<Selection\>\"", "->", "selection"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Verdict\>\"", "->", "verdict"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<AllThreeQ\>\"", "->", 
          RowBox[{"And", " ", "@@", " ", 
           RowBox[{"Values", "[", "verdict", "]"}]}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<FixedScaleResidual\>\"", "->", 
          RowBox[{"fixedScaleResidual", "[", "state", "]"}]}]}], 
        "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"synthesisEvidenceScore", "[", "report_Association", "]"}], ":=", 
   RowBox[{"Mean", " ", "@", " ", 
    RowBox[{"Boole", " ", "@", " ", 
     RowBox[{"Values", "[", 
      RowBox[{"report", "[", "\"\<Verdict\>\"", "]"}], "]"}]}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[62]:=",ExpressionUUID->"bd34c47d-4547-bc4a-8d67-aec491c518d8"]
}, Open  ]],

