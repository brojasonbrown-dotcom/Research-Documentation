           ImageSize->Automatic,
           LabelStyle->{FontSize -> 12}]}
        },
        AutoDelete->False,
        BaseStyle->{ShowStringCharacters -> False},
        BaselinePosition->{1, 1},
        GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
