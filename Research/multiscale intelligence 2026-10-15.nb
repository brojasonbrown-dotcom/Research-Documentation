 }], "InlineSubitem",ExpressionUUID->"e98cd7ae-39f7-4544-848d-60dbb51a8481"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "compare to correlation recovery"
 }], "InlineSubitem",ExpressionUUID->"eb4eba76-534e-5741-a48c-105677da28b3"],
 "\n5. ",
 StyleBox["Dimension sweep benchmark",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
