 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"7379e0d0-ef2d-f54a-9049-6ff4d3709108"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Conceptual objective", "Section",ExpressionUUID->"7647c9a0-67ae-434a-9284-af1ec81ff09b"],

Cell["We want a formal bridge between:", "Text",ExpressionUUID->"354e24ec-4b39-6644-bc66-2a76bfd947df"],

Cell[TextData[{
 "1. ",
 StyleBox["Geometry and substrate organization",
  FontWeight->Bold],
 "2. ",
 StyleBox["Multiscale field dynamics",
  FontWeight->Bold],
 "3. ",
 StyleBox["Resonance, persistence, and field topology",
  FontWeight->Bold],
 "4. ",
 StyleBox["Cross-scale encoding into finite resolutions",
  FontWeight->Bold],
 "5. ",
 StyleBox["Neural network consumption of field-derived features",
  FontWeight->Bold],
 "6. ",
 StyleBox["Bidirectional coupling between field and network",
  FontWeight->Bold],
 "7. ",
 StyleBox["RHUFT-style resolution-hierarchy transfer",
  FontWeight->Bold],
 "8. ",
 StyleBox["Mind-field interpretation as a model layer, not a prior proof",
  FontWeight->Bold],
 "The core idea is: "
}], "Text",ExpressionUUID->"7997ec00-beda-d749-88d3-c5419182f747"],

Cell[BoxData[GridBox[{
   {
    PaneBox["\<\"A sensory field may be modeled as a distributed multiscale \
state whose stable, geometry-aware, resolution-compatible summaries can serve \
as neural representations; conversely, neural systems may be understood as \
adaptive operators acting on field-derived latent structure.\"\>",
     BaseStyle->{"Text", FontColor -> LightDarkSwitched[
         GrayLevel[0.35], 
         GrayLevel[0.8602474]]},
     ImageMargins->5,
     ImageSize->{Full, Automatic}]}
  },
  AutoDelete->False,
  GridBoxBackground->{"Columns" -> {{
       LightDarkSwitched[
        GrayLevel[1], 
        GrayLevel[0.278317]]}}},
  GridBoxDividers->{"ColumnsIndexed" -> {1 -> Directive[
        LightDarkSwitched[
         RGBColor[0.87, 0.94, 1], 
         RGBColor[0.2491127, 0.3295188, 0.4231198]], 
        AbsoluteThickness[4]]}, "Rows" -> {{False}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Text", \
"BlockQuote",
 Background->None,ExpressionUUID->"d14bc41c-f29c-7d43-b209-2b4fbff9cc25"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
