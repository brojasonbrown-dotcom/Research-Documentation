         StyleBox["M", "TI"], 
         RowBox[{"[", 
           SubscriptBox["\[CapitalPsi]", 
            StyleBox["n", "TI"]], "]"}], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", 
         StyleBox["F", "TI"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["M", "TI"], 
             RowBox[{"[", 
               SubscriptBox["\[CapitalPsi]", 
                StyleBox["n", "TI"]], "]"}]}], "]"}], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\Psi_{n+1}(x)=\\Psi_n(x)-\\mathcal M[\\Psi_n](x)+\\mathcal F[\\mathcal \
M[\\Psi_n]](x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "59a9b98c-409a-2b4f-b51b-610ee4c49c48"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["F", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal F", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ca9ab39a-fe29-ac45-8c98-41aa86ac556e"],
 " fills the deficit created by measurement.\n\nIf you want explicit void: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["V", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["C", "TI"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["M", "TI"], 
             RowBox[{"[", 
               SubscriptBox["\[CapitalPsi]", 
                StyleBox["n", "TI"]], "]"}]}], "]"}], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "V_n(x)=\\mathcal C[\\mathcal M[\\Psi_n]](x)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c4271216-d659-c946-ace0-f29293883e2f"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["n", "TI"], "+", "1"}]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "-", 
         StyleBox["M", "TI"], 
         RowBox[{"[", 
           SubscriptBox["\[CapitalPsi]", 
            StyleBox["n", "TI"]], "]"}], 
         RowBox[{"(", 
