  " ",
  StyleBox["cross-talk",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"47752979-f5c6-2e46-b3fa-6ecf79b55c6b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
