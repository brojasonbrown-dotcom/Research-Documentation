  Background->None,ExpressionUUID->"c20985ea-9eb9-d14c-8691-4eceb184483e"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Important conceptual correction\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"7091df09-c0f0-c94f-8a60-cde819d5e613"],
 "\nFor real random unit vectors: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "circular convolution is a compressed superposition-like binding"
 }], "InlineItem",ExpressionUUID->"772638b7-eb29-e346-91d1-4acdb4ce6a87"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "correlation-based unbinding works because random vectors behave \
approximately orthogonally"
 }], "InlineItem",ExpressionUUID->"2366975b-a391-be4d-b53a-49691966da09"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "expected distractor cosine is about:"
 }], "InlineItem",ExpressionUUID->"bf1e862c-f620-864d-9dc1-cf2b8bba6325"],
 "\n  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["O", "TI"], "\[NegativeThinSpace]", 
