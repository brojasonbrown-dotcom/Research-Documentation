 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
            
            RowBox[{"fieldFeatureAssociation", ",", "\[IndentingNewLine]", 
              "  ", "fieldFeatureVectorNumeric", ",", "\[IndentingNewLine]", 
              "  ", "makeClassificationExample", ",", "\[IndentingNewLine]", 
              "  ", "makeRegressionExample", ",", "\[IndentingNewLine]", "  ",
               "makeSequenceExample", ",", "\[IndentingNewLine]", "  ", 
              "makeFieldDataset", ",", "\[IndentingNewLine]", "  ", 
              "splitDataset", ",", "\[IndentingNewLine]", "  ", 
              "vectorClassifierNet", ",", "\[IndentingNewLine]", "  ", 
              "vectorRegressorNet", ",", "\[IndentingNewLine]", "  ", 
              "sequencePredictorNet", ",", "\[IndentingNewLine]", "  ", 
              "evaluateClassifierPredictions", ",", "\[IndentingNewLine]", 
              "  ", "evaluateRegressorPredictions"}], "\[IndentingNewLine]", 
            "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"fieldFeatureAssociation", "[", "state_List", "]"}], ":=", 
            RowBox[{"<|", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"\"Length\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"Length", "[", "state", "]"}]}]}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"\"Norm2\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"Norm", "[", 
                    RowBox[{"state", ",", "2"}], "]"}]}]}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"\"Norm1\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"Norm", "[", 
                    RowBox[{"state", ",", "1"}], "]"}]}]}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"\"Mean\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"Mean", "[", "state", "]"}]}]}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"\"Variance\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"Variance", "[", "state", "]"}]}]}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"\"FixedScaleResidual\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"fixedScaleResidual", "[", "state", "]"}]}]}], 
                ",", "\[IndentingNewLine]", "  ", 
                RowBox[{"\"ScaleResidualMean\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"Mean", " ", "@", " ", 
                    
                    RowBox[{
                    "scaleResiduals", "[", "\[IndentingNewLine]", "    ", 
                    RowBox[{"state", ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"Min", "[", 
                    RowBox[{"8", ",", 
                    RowBox[{"Max", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{
                    RowBox[{"Floor", "[", 
                    RowBox[{"Log2", "[", 
                    RowBox[{"Length", "[", "state", "]"}], "]"}], "]"}], "-", 
                    "1"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", "  ", 
                    "]"}]}]}]}]}], "\[IndentingNewLine]", "|>"}]}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"fieldFeatureVectorNumeric", "[", "state_List", "]"}], 
