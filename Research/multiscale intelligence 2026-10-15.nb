Cell[CellGroupData[{

Cell["9. Selection stability and recurrent realization", "Section",ExpressionUUID->"b34bbb9d-6ac2-7144-9448-08761fa7f67e"],

Cell[CellGroupData[{

Cell["9.1 Repeated interaction channel", "Subsection",ExpressionUUID->"0f45229c-1a4a-e54f-8fbe-da7f5f9f0063"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "dephaseStep", ",", "quasiPeriodicSchedule", ",", "pointerModeData"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dephaseStep", "[", 
     RowBox[{
      RowBox[{"state_", "?", "MatrixQ"}], ",", "phase_", ",", 
      RowBox[{"p_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"unitary", ",", "mixed"}], "}"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"unitary", "=", 
        RowBox[{"DiagonalMatrix", "[", 
         RowBox[{"Exp", "[", 
          RowBox[{"I", " ", "phase", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "state", "]"}], "]"}]}], "]"}], "]"}]}], ";",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"mixed", "=", 
        RowBox[{"unitary", ".", "state", ".", 
         RowBox[{"ConjugateTranspose", "[", "unitary", "]"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "p"}], ")"}], " ", "mixed"}], "+", 
        RowBox[{"p", " ", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"Diagonal", "[", "mixed", "]"}], "]"}]}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"quasiPeriodicSchedule", "[", 
     RowBox[{
      RowBox[{"steps_Integer", "?", "Positive"}], ",", 
      RowBox[{"dim_Integer", "?", "Positive"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"2", " ", "Pi", " ", 
          RowBox[{"n", "/", 
           RowBox[{"(", 
            RowBox[{"j", "+", "1"}], ")"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "dim"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "steps"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pointerModeData", "[", 
    RowBox[{
     RowBox[{"initialState_", "?", "MatrixQ"}], ",", "phaseSchedule_List", ",", 
     RowBox[{"p_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "orbit", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"orbit", "=", 
       RowBox[{"FoldList", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dephaseStep", "[", 
           RowBox[{"#1", ",", "#2", ",", "p"}], "]"}], " ", "&"}], ",", 
         "initialState", ",", "phaseSchedule"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Orbit\>\"", "->", "orbit"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<CoherenceNorms\>\"", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{"#", "-", 
               RowBox[{"DiagonalMatrix", "[", 
                RowBox[{"Diagonal", "[", "#", "]"}], "]"}]}], 
              ",", "\"\<Frobenius\>\""}], "]"}], " ", "&"}], " ", "/@", " ", 
           "orbit"}], ")"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<PointerWeights\>\"", "->", 
         RowBox[{"Diagonal", "[", 
          RowBox[{"Last", "[", "orbit", "]"}], "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[45]:=",ExpressionUUID->"28dfe6a5-3123-a544-9d3e-8236ee9ee509"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.2 Interpretation", "Subsection",ExpressionUUID->"24579216-73bb-9845-9107-4339f3e2f361"],

Cell["\<\
A state becomes operationally real in this framework if it persists under \
repeated interaction channels.\
\>", "Text",ExpressionUUID->"e3343e96-4d99-4c4a-9f3c-af12b8e4e166"],

Cell["\<\
This is a formal replacement for loose phrases like \
\[OpenCurlyDoubleQuote]measured into existence.\[CloseCurlyDoubleQuote] \
