 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"makeFieldDataset", "[", "\[IndentingNewLine]", "  ", 
            RowBox[{"taskType_String", ",", "\[IndentingNewLine]", "  ", 
              RowBox[{"count_Integer", "?", "Positive"}], ",", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{"len_Integer", "?", "Positive"}], ",", 
              "\[IndentingNewLine]", "  ", 
              RowBox[{"steps_Integer", ":", " ", "5"}]}], 
            "\[IndentingNewLine]", "]"}], ":=", 
          RowBox[{"Switch", "[", "\[IndentingNewLine]", "  ", 
            
            RowBox[{"taskType", ",", "\[IndentingNewLine]", "  ", 
              "\"Classification\"", ",", 
              RowBox[{"Table", "[", 
                RowBox[{
                  RowBox[{"makeClassificationExample", "[", "len", "]"}], ",", 
                  RowBox[{"{", "count", "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", "  ", "\"Regression\"", ",", 
              RowBox[{"Table", "[", 
                RowBox[{
                  RowBox[{"makeRegressionExample", "[", "len", "]"}], ",", 
                  RowBox[{"{", "count", "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", "  ", "\"Sequence\"", ",", 
              RowBox[{"Table", "[", 
                RowBox[{
                  RowBox[{"makeSequenceExample", "[", 
                    RowBox[{"len", ",", "steps"}], "]"}], ",", 
                  RowBox[{"{", "count", "}"}]}], "]"}], ",", 
              "\[IndentingNewLine]", "  ", "_", ",", "$Failed"}], 
            "\[IndentingNewLine]", "]"}]}], ";"}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
