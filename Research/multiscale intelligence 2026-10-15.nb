 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"7. Concrete candidate equations\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f3ebd741-f407-8147-a2eb-a48afd7d2f12"],
 "\nHere are useful first candidate equations. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Model 1: source-void split\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d194023b-9cfe-ac48-9530-49cfa6451aa1"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["D", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "\[Rho]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "-", "\[Nu]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "D(x)=\\rho(x)-\\nu(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6018b6b1-457c-0b44-a9c4-b5ada4503408"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Nu]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\nu(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "09acf8fc-3769-b84f-b2e5-86199149a938"],
 " is void density.\n\nPotential obeys: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Del]", "2"], "\[CapitalPhi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "4", "\[Pi]", 
         StyleBox["G", "TI"], " ", 
         RowBox[{"(", 
