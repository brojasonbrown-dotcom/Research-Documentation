      "input" -> "O\\!\\left(\\frac{1}{\\sqrt{d}}\\right)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a40658e9-791f-ef46-b102-9519124dd67c"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "but the recovered target cosine is ",
  StyleBox["not",
   FontWeight->Bold],
  " \[OpenCurlyDoubleQuote]exact identity\[CloseCurlyDoubleQuote]; it is a \
statistical retrieval score"
 }], "InlineItem",ExpressionUUID->"127d4083-ea1c-1c45-9009-70a1fb7b8153"],
 "\nSo your section should be renamed something like: \n",
