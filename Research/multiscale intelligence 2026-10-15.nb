         SubscriptBox[
          StyleBox["V", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Psi_{n+1}(x)=\\Psi_n(x)-\\mathcal M[\\Psi_n](x)+V_n(x)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "68e82131-d1da-4840-b820-d8c4fe20dc26"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
