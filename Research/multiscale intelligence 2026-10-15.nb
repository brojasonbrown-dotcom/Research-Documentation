                    RowBox[{"Most", "[", "seq", "]"}]}]}], ";", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"targetSeq", "=", 
                  RowBox[{"fieldFeatureVectorNumeric", " ", "/@", " ", 
                    RowBox[{"Rest", "[", "seq", "]"}]}]}], ";", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"<|", 
                  RowBox[{
                    RowBox[{"\"InputSequence\"", "->", "inputSeq"}], ",", 
