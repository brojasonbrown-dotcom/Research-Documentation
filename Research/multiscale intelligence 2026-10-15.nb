}, Open  ]],

Cell[CellGroupData[{

Cell["2. Terminology normalization", "Section",ExpressionUUID->"33d4f46b-7f66-be4a-b57d-8fbfe90df894"],

Cell[BoxData[
 PaneBox[
  PaneBox[
   StyleBox[
    TagBox[
     TagBox[GridBox[{
        {
         TagBox["\<\"Informal phrase\"\>",
          HoldForm], 
         TagBox["\<\"Rigorous replacement\"\>",
          HoldForm]},
        {"\<\"sensory field\"\>", "\<\"distributed state field with \
interaction-dependent observables\"\>"},
        {"\<\"field of mind\"\>", "\<\"recurrent high-dimensional state field \
with feedback-selected modes\"\>"},
        {"\<\"intelligence in geometry\"\>", "\<\"geometry-constrained \
inference / topology-aware representation\"\>"},
        {"\<\"hyperdimensional information\"\>", "\<\"high-dimensional state \
space / modal coefficient space / latent manifold\"\>"},
        {"\<\"resonance pocket\"\>", "\<\"metastable basin / mode-locking \
region / equilibrium pocket\"\>"},
        {"\<\"vortex\"\>", "\<\"circulation structure / phase winding / \
nontrivial curl configuration\"\>"},
        {"\<\"RHUFT\"\>", "\<\"resolution-hierarchy transfer map\"\>"},
        {"\<\"self-measurement\"\>", "\<\"recurrent internal selection / \
state-dependent feedback\"\>"},
        {"\<\"seamless field-network integration\"\>", "\<\"bidirectional \
field-latent operator coupling\"\>"}
       },
       GridBoxAlignment->{"Columns" -> {Left, {Left}}, "Rows" -> {{Baseline}}},
       GridBoxDividers->{
        "Columns" -> {{False}}, "Rows" -> {False, True, {False}, False}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[2.0999999999999996`]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      {None, OutputFormsDump`HeadedColumns}],
     Function[BoxForm`e$, 
      TableForm[
      BoxForm`e$, 
       TableHeadings -> {
        None, {"Informal phrase", "Rigorous replacement"}}]]], "Text",
    StripOnInput->False,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 5}}],
  ImageMargins->{{0, 0}, {5, 5}}]], "TextTableForm", \
"Text",ExpressionUUID->"a1e49b45-f9be-2045-bf35-f13d1f35b764"],

