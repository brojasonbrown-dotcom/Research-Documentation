 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", "fieldArrayEncoder", "]"}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"fieldArrayEncoder", "[", 
              RowBox[{"array_", "?", "ArrayQ"}], "]"}], ":=", 
            RowBox[{"N", " ", "@", " ", 
              RowBox[{"Flatten", "[", "array", "]"}]}]}], ";"}]}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "36418efa-6de8-3047-9881-43223006cd54"],
 "\nThat is okay, but for training you should also track dimension: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", "fieldArrayEncoding", "]"}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"fieldArrayEncoding", "[", 
              RowBox[{"array_", "?", "ArrayQ"}], "]"}], ":=", 
            RowBox[{"<|", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"\"Vector\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"Flatten", "[", "array", "]"}]}]}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"\"Shape\"", "->", 
                  RowBox[{"Dimensions", "[", "array", "]"}]}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"\"Length\"", "->", 
                  RowBox[{"Length", " ", "@", " ", 
                    RowBox[{"Flatten", "[", "array", "]"}]}]}]}], 
              "\[IndentingNewLine]", "|>"}]}], ";"}]}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "f9320c34-a932-7d4e-8bf7-906177498ec4"],
