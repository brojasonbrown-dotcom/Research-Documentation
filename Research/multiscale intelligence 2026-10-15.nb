  Background->None,ExpressionUUID->"17a95782-6590-6d43-9019-551abb592eb0"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Fix 2: make the encoder deterministic in dimension\"\>", 
