Cell[CellGroupData[{

Cell["4. Geometric intelligence layer", "Section",ExpressionUUID->"29e00643-0059-2c49-bb87-e386f2a4d0c2"],

Cell[CellGroupData[{

Cell["4.1 Geometric substrate models", "Subsection",ExpressionUUID->"9d007686-caff-6f4b-b2f3-7cdb0ff632a1"],

Cell[TextData[{
 StyleBox["Established",
  FontWeight->Bold],
 ": geometry constrains admissible dynamics and observables. "
}], "Text",ExpressionUUID->"9565c35e-1d53-2941-a097-037c8e3e0f5f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "sphereParam", ",", "torusEmbedding", ",", "radialDistance", ",", 
     "geometricMetricWeight"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sphereParam", "[", "\[Rho]_", "]"}], "[", 
     RowBox[{"\[Theta]_", ",", "\[Phi]_"}], "]"}], ":=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\[Rho]", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\[Rho]", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\[Rho]", " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"torusEmbedding", "[", 
      RowBox[{
       RowBox[{"majorRadius_", "?", "NumericQ"}], ",", 
       RowBox[{"minorRadius_", "?", "NumericQ"}]}], "]"}], "[", 
     RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"majorRadius", "+", 
         RowBox[{"minorRadius", " ", 
          RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
       RowBox[{"Cos", "[", "u", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"majorRadius", "+", 
         RowBox[{"minorRadius", " ", 
          RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
       RowBox[{"Sin", "[", "u", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"minorRadius", " ", 
       RowBox[{"Sin", "[", "v", "]"}]}]}], "\[IndentingNewLine]", "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"radialDistance", "[", 
      RowBox[{"{", 
       RowBox[{"x0_", ",", "y0_"}], "}"}], "]"}], "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "-", "x0"}], ")"}], "^", "2"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"y", "-", "y0"}], ")"}], "^", "2"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"geometricMetricWeight", "[", 
    RowBox[{"metricTensor_", "?", "MatrixQ"}], "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"Det", "[", "metricTensor", "]"}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"0adadced-f337-4a4a-a8fb-1b6988172a9d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2 Interpretation", "Subsection",ExpressionUUID->"fdb60745-2e25-b545-aa7a-3dcb227200ff"],

Cell[TextData[{
 "Geometry is treated as an ",
 StyleBox["inductive bias",
  FontWeight->Bold],
 " on intelligence. "
}], "Text",ExpressionUUID->"39731aee-edb4-054d-ae63-8b10fa524c68"],

Cell["Spherical domains support closed isotropic mode families.", "Item",ExpressionUUID->"469ccdae-50fa-8c45-bf3f-6760134068af"],

Cell["\<\
Toroidal domains support recirculation and doubly periodic organization.\
\>", "Item",ExpressionUUID->"671988d5-adb3-b94e-88ca-e98eaa4112cb"],

Cell["\<\
Graph or lattice domains support discrete coupling and message propagation.\
\>", "Item",ExpressionUUID->"a76dad48-e8b0-dd42-ad77-9ba1d9a7c0b9"],

Cell[TextData[{
 StyleBox["Model hypothesis",
  FontWeight->Bold],
 ": geometric intelligence means that representation quality depends not only \
on data values, but on domain topology and invariant structure. "
}], "Text",ExpressionUUID->"56cfecc7-ce4b-7245-bf76-121618d34400"],

