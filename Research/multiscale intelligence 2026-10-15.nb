   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"33650a86-a6ed-2a4d-a167-445395862b0c"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"8. Tests we should run on this idea\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"7acb4b18-42d6-9d49-ac3a-a04f80b693a1"],
 "\nTo make your intuition rigorous, these are the first necessary tests. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"T1. Symmetry test\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e60775bf-5428-a242-83a5-5b1e9f86a2c3"],
 "\nDoes the induced opposite-side charge preserve rotational symmetry when \
no neighbor is present?\n\nExpected: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "yes when isolated,"
 }], "InlineItem",ExpressionUUID->"a03674b6-2f46-6243-957c-7fb47b1ddf65"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "broken anisotropically when a neighbor exists."
 }], "InlineItem",ExpressionUUID->"6f0e39f4-157f-fd43-822c-72159cefcc5a"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"T2. Two-body consistency test\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}},
   ScrollPosition->{0., 0.}]], "InlineSection",
  Background->None,ExpressionUUID->"d85af44b-d118-1342-b753-6668535150bf"],
 "\nFor two stationary bodies, does the model reduce to attraction plus a \
stable anisotropic void structure? \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"T3. Far-field limit\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"3f80ff6d-c079-e540-ae57-388350a58bea"],
 "\nAs ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[Rule]", "\[Infinity]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "r\\to\\infty", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5178e396-07bc-f84c-9013-5442d368cbf6"],
 ", does the opposite-side term vanish appropriately? \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"T4. Near-field regularity\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"bd7e1c77-07fb-0f4b-810b-1d6a37256713"],
 "\nDoes the induced void blow up unphysically near the body boundary? \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"T5. Conservation/balance test\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"eb2236c5-93ff-4342-be3f-76ccb459d82d"],
 "\nIs total signed informational content conserved, increased, or \
recursively restored? \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"T6. Stability test\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"9c151841-50a4-1f43-8360-5f2302c6acd8"],
 "\nDo source-void coupled equations admit stable stationary solutions? \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"T7. Scale-octave test\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"a7c85546-b464-5249-b2d6-0c00bb0176f4"],
 "\nDo similar source/void patterns recur under scale transformation? \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"T8. Emergent-time test\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}},
   ScrollPosition->{0., 0.}]], "InlineSection",
  Background->None,ExpressionUUID->"6c9ddd09-fc99-b348-a874-54b50679edc2"],
 "\nCan repeated measurement-void-regeneration cycles produce an ordered \
effective time parameter? \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"T9. Observability test\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"6358e650-6762-8c43-854d-51c64757827f"],
 "\nCan this void structure be distinguished from ordinary multipole \
gravitational effects? \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"T10. Input-output realizability test\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ba0fd8d5-969d-5945-9d67-142f6f1f79e7"],
 "\nCan the recursion be encoded as a state update system? \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"463bfdad-bb46-f548-8e77-1f722428b3ea"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"9. Input-output system form of your idea\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"5139549d-7c2f-924e-8d63-5d9b3d4d97ed"],
 "\nYes \[LongDash] your idea can absolutely be turned into an input/output \
system.\n\nDefine state: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["n", "TI"]], ",", 
             SubscriptBox["\[Rho]", 
              StyleBox["n", "TI"]], ",", 
             SubscriptBox["\[Nu]", 
              StyleBox["n", "TI"]], ",", 
             SubscriptBox[
              StyleBox["A", "TI"], 
              StyleBox["n", "TI"]], ",", 
             SubscriptBox[
              StyleBox["R", "TI"], 
              StyleBox["n", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "x_n = (\\Psi_n,\\rho_n,\\nu_n,A_n,R_n)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ae1b5763-b45e-d740-bdcd-47797d07c4ad"],
 "\nInput: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["u", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         RowBox[{"(", 
           
           RowBox[{"neighbor configuration", ",", "measurement act", ",", 
             "resolution choice"}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "u_n = (\\text{neighbor configuration},\\text{measurement \
act},\\text{resolution choice})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "14633f93-4395-5742-8c46-a14cb417f173"],
 "\nUpdate: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], 
          RowBox[{
            StyleBox["n", "TI"], "+", "1"}]], "\[LongEqual]", 
         StyleBox["F", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["n", "TI"]], ",", 
             SubscriptBox[
              StyleBox["u", "TI"], 
              StyleBox["n", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "x_{n+1}=F(x_n,u_n)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ec8527c1-bacf-8443-8ecb-2327661692b7"],
 "\nOutput: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["y", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         RowBox[{"(", 
           
           RowBox[{"observable density", ",", "effective potential", ",", 
             "measured reality slice"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "y_n = (\\text{observable density},\\text{effective \
potential},\\text{measured reality slice})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2b25ae18-951a-8948-a2e1-74ef1428c200"],
 "\nSo the whole thing is: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  SubscriptBox[
                   StyleBox["x", "TI"], 
                   RowBox[{
                    StyleBox["n", "TI"], "+", "1"}]]], "InlineFormula"], 
                " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", 
                    StyleBox["F", "TI"], 
                    RowBox[{"(", 
                    RowBox[{
                    SubscriptBox[
                    StyleBox["x", "TI"], 
                    StyleBox["n", "TI"]], ",", 
                    SubscriptBox[
                    StyleBox["u", "TI"], 
                    StyleBox["n", "TI"]]}], ")"}], ","}]], "InlineFormula"], 
                " "}]]}, {
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  SubscriptBox[
                   StyleBox["y", "TI"], 
                   StyleBox["n", "TI"]]], "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", 
                    StyleBox["H", "TI"], 
                    RowBox[{"(", 
                    RowBox[{
                    SubscriptBox[
                    StyleBox["x", "TI"], 
                    StyleBox["n", "TI"]], ",", 
                    SubscriptBox[
                    StyleBox["u", "TI"], 
                    StyleBox["n", "TI"]]}], ")"}], "."}]], "InlineFormula"], 
                " "}]]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}\nx_{n+1} &= F(x_n,u_n),\\\\\ny_n &= H(x_n,u_n).\n\
\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e5c19286-e573-6546-a3c3-46abeaa29857"],
 "\nThat means your ontology is computationally expressible as: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a recursive dynamical system,"
 }], "InlineItem",ExpressionUUID->"e67d2d77-c8ed-8d4e-b5ec-bc90fdfd1937"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a nonlinear state-space system,"
 }], "InlineItem",ExpressionUUID->"8d7936ca-9a6d-a045-99f6-1fd4dc4d7e57"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a measurement-feedback system,"
 }], "InlineItem",ExpressionUUID->"8d70d37b-6772-c640-8482-eb418e55dfcd"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "a multiscale operator system."
 }], "InlineItem",ExpressionUUID->"c77dbd38-cc81-9d48-b03c-522811330ed5"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"3b05f09f-1a48-f548-a032-de3f302dfc3e"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"10. What this adds beyond your earlier OPF\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f4eff980-ab40-a146-b80f-d018fb5e8048"],
 "\nThis new idea introduces a missing component: \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"New OPF ingredient:\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"702afd22-430e-1248-8358-a27d1f1af720"],
 "\n",
 StyleBox["complementary void polarity induced by interaction and measurement",
  FontWeight->Bold],
 "\n\nSo now the ontology becomes:\n\n1. ",
 StyleBox["substrate",
  FontWeight->Bold],
 "\n2. ",
 StyleBox["information concentration",
  FontWeight->Bold],
 "\n3. ",
 StyleBox["interaction-induced opposite-side void",
  FontWeight->Bold],
 "\n4. ",
 StyleBox["measurement collapse",
  FontWeight->Bold],
 "\n5. ",
 StyleBox["deficit regeneration",
  FontWeight->Bold],
 "\n6. ",
 StyleBox["recursive refill",
  FontWeight->Bold],
 "\n7. ",
 StyleBox["emergent time",
  FontWeight->Bold],
 "\n\nThat is much sharper than the earlier static action alone. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"58f58d3d-d0e3-c649-80d6-fba1ff0c81cc"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"11. Best next formalization\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"6f59b68a-f034-8844-92a1-9ef77b72eeb3"],
 "\nI think the cleanest next step is to define a minimal symbolic model with \
five fields: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{"\[Rho]", 
           RowBox[{"(", 
