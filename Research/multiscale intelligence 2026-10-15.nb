Cell[CellGroupData[{

Cell["12. Bidirectional field-network coupling", "Section",ExpressionUUID->"8f1397ff-d495-a449-a53a-cfc00e35ee84"],

Cell[CellGroupData[{

Cell["12.1 Encoder-decoder abstraction", "Subsection",ExpressionUUID->"d22bb698-8e5c-3a45-ab91-0d3867f3b67c"],

Cell["We define three maps: ", "Text",ExpressionUUID->"35de9778-15a0-2044-88d8-1752b0a0fa13"],

Cell[TextData[{
 "field encoder ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], ":", 
         StyleBox["F", "TI"], "\[Rule]", 
         StyleBox["Z", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "E: \\mathcal{F} \\to \\mathcal{Z}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b3b7c098-fbcf-2845-b6d9-ef0dd54e8864"]
}], "Item",ExpressionUUID->"0bb3831d-0294-bc40-9bc0-24dfef650d6f"],

Cell[TextData[{
 "network dynamics ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["N", "TI"], ":", 
         StyleBox["Z", "TI"], "\[Rule]", 
         StyleBox["Z", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "N: \\mathcal{Z} \\to \\mathcal{Z}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7c92e09f-a1ef-f047-9b05-a498663fcd4e"]
}], "Item",ExpressionUUID->"a84c9621-f89e-e843-8d60-6cecd61b68cf"],

Cell[TextData[{
 "field decoder ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["D", "TI"], ":", 
         StyleBox["Z", "TI"], "\[Rule]", 
         StyleBox["F", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "D: \\mathcal{Z} \\to \\mathcal{F}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9005516f-5c15-3642-9848-561d11fe0f6c"]
}], "Item",ExpressionUUID->"8c80eb15-6851-f94f-8a9f-191046e5f4ab"],

Cell[TextData[{
 "The coupled loop is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["F", "TI"], 
         OverscriptBox["\[LongRightArrow]", "E"], 
         StyleBox["Z", "TI"], 
         OverscriptBox["\[LongRightArrow]", "N"], 
         StyleBox["Z", "TI"], 
         OverscriptBox["\[LongRightArrow]", "D"], 
         StyleBox["F", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{F} \\xrightarrow{E} \\mathcal{Z} \\xrightarrow{N} \
\\mathcal{Z} \\xrightarrow{D} \\mathcal{F}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9219bf5a-684b-ac4f-93d9-57d4bad4b737"]
}], "Text",ExpressionUUID->"199feb91-8722-9c4e-a204-4bc8c67dfa59"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12.2 Simple symbolic prototype", "Subsection",ExpressionUUID->"7495ad75-f6e8-b140-a9ba-e9faaa7a3dc8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "fieldEncoder", ",", "latentOperator", ",", "fieldDecoder", ",", 
     "coupledFieldNetworkStep"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fieldEncoder", "[", "state_List", "]"}], ":=", 
    RowBox[{"fieldArrayEncoder", "[", "state", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"latentOperator", "[", "vec_List", "]"}], ":=", 
    RowBox[{"Normalize", "[", 
     RowBox[{
      RowBox[{"vec", "+", 
       RowBox[{"0.01", " ", 
        RowBox[{"RotateLeft", "[", "vec", "]"}]}]}], ",", "Norm"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fieldDecoder", "[", 
     RowBox[{"vec_List", ",", 
      RowBox[{"len_Integer", "?", "Positive"}]}], "]"}], ":=", 
    RowBox[{"Take", "[", 
     RowBox[{"vec", ",", "len"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coupledFieldNetworkStep", "[", "state_List", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "latent", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"latent", "=", 
       RowBox[{"latentOperator", "[", 
        RowBox[{"fieldEncoder", "[", "state", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"fieldDecoder", "[", 
       RowBox[{"latent", ",", 
        RowBox[{"Length", "[", "state", "]"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"6c468e42-afa0-f845-8267-e958f3d93213"]
