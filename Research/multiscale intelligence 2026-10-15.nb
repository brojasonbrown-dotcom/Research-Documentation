Cell[CellGroupData[{

Cell["6.1 One-dimensional bounded domain", "Subsection",ExpressionUUID->"e93c29de-6cad-c343-927b-0f2a6ed7833c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "oneDPDEEigensystem", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"oneDPDEEigensystem", "[", 
    RowBox[{"n_Integer", "?", "Positive"}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"NDEigensystem", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         RowBox[{"u", "''"}], "[", "x", "]"}]}], ",", "\[IndentingNewLine]", 
       "      ", 
       RowBox[{"DirichletCondition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"x", "==", "0"}], "||", 
          RowBox[{"x", "==", "1"}]}]}], "]"}]}], "\[IndentingNewLine]", 
      "    ", "}"}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"u", "[", "x", "]"}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
     "    ", "n"}], "\[IndentingNewLine]", "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"7cc53c6e-9833-244f-96cf-1e489f3f5d7e"]
}, Open  ]],

