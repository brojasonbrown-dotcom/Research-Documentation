  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"f979fea0-48fa-034c-bc26-707b9dec7558"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"6. Immediate notebook corrections for \
learning-readiness\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ba738daa-587e-c84b-94ee-ac16fa50b8ae"],
 "\nBefore we even build the training section, a few existing objects should \
be normalized. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Fix 1: feature vectors should be numeric and ordered\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"0499f1d6-2c78-c645-9fae-679887a3885f"],
 "\nRight now ",
 Cell[BoxData[
  TemplateBox[{
    Cell["fieldFeatureVector", Background -> None]},
   "ChatCodeInlineTemplate"]], "ChatCodeActive",ExpressionUUID->
  "876f5e06-d611-8a4d-b267-4ec4544db8c1"],
 " returns an association. That is fine, but training input should be \
consistent in order.\n\nAdd: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"ClearAll", "[", 
            
            RowBox[{"fieldFeatureAssociation", ",", 
              "fieldFeatureVectorNumeric"}], "]"}], ";"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"fieldFeatureAssociation", "[", "state_List", "]"}], ":=", 
            RowBox[{"<|", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"\"Length\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"Length", "[", "state", "]"}]}]}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"\"Norm2\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"Norm", "[", 
                    RowBox[{"state", ",", "2"}], "]"}]}]}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"\"Norm1\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"Norm", "[", 
                    RowBox[{"state", ",", "1"}], "]"}]}]}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"\"Mean\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"Mean", "[", "state", "]"}]}]}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"\"Variance\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"Variance", "[", "state", "]"}]}]}], ",", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"\"FixedScaleResidual\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"fixedScaleResidual", "[", "state", "]"}]}]}], 
                ",", "\[IndentingNewLine]", "  ", 
                RowBox[{"\"ScaleResidualMean\"", "->", 
                  RowBox[{"N", " ", "@", " ", 
                    RowBox[{"Mean", " ", "@", " ", 
                    RowBox[{"scaleResiduals", "[", 
                    RowBox[{"state", ",", 
                    RowBox[{"Min", "[", 
                    RowBox[{"8", ",", 
                    RowBox[{"Max", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{
                    RowBox[{"Floor", "[", 
                    RowBox[{"Log2", "[", 
                    RowBox[{"Length", "[", "state", "]"}], "]"}], "]"}], "-", 
                    "1"}]}], "]"}]}], "]"}]}], "]"}]}]}]}]}], 
              "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{
            RowBox[{"fieldFeatureVectorNumeric", "[", "state_List", "]"}], 
            ":=", 
            RowBox[{"Values", " ", "@", " ", 
              RowBox[{"fieldFeatureAssociation", "[", "state", "]"}]}]}], 
          ";"}]}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "1635aee9-73e3-5749-9cb2-cbfb6d661f78"],
 "\nThis avoids ambiguous ordering bugs later. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
