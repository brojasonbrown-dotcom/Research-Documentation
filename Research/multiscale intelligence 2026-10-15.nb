  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"fb52d22b-d3a3-664a-83ec-dddc1477ea91"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"D. Recursive restoration dynamics\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"30920596-f75d-874b-91c8-84e08be2fa94"],
 "\nInstead of ordinary time-first dynamics: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["t", "TI"]], 
         StyleBox["u", "TI"], "\[LongEqual]", 
         StyleBox["F", "TI"], 
         RowBox[{"[", 
           StyleBox["u", "TI"], "]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\partial_t u=F[u]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c9d645a8-cf8c-af4d-a2f1-e58b8dd161fa"],
 "\nyou want process-first dynamics: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["n", "TI"], "+", "1"}]], "\[LongEqual]", 
         StyleBox["R", "TI"], "\[NegativeThinSpace]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "\[NegativeThinSpace]", 
