    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ca19f447-bc30-af4a-8f0b-35949842afc4"],
 "\nIf inputs are real, small imaginary parts may appear from numerical FFT \
roundoff. Taking ",
 Cell[BoxData[
  TemplateBox[{
   "Re", "paclet:ref/Re", 
    "https://reference.wolfram.com/language/ref/Re.html"},
   "TextRefLink"]],ExpressionUUID->"5ca0ee29-cd12-fc48-b548-01e4f4684738"],
 " is acceptable, but in a rigorous notebook it should be documented as: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "projection back to real space after numerical Fourier arithmetic"
 }], "InlineItem",ExpressionUUID->"b7aff9bc-70c2-9344-b3ef-8c52cc6223e8"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
