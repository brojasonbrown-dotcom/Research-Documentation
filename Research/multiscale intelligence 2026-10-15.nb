\"Dimension\" -> d,\n     \"MeanRecoverCosSim\" -> Mean[scores[[All, 1]]],\n  \
   \"StdRecoverCosSim\" -> StandardDeviation[scores[[All, 1]]],\n     \
\"MeanCrossNoise\" -> Mean[scores[[All, 2]]],\n     \"StdCrossNoise\" -> \
StandardDeviation[scores[[All, 2]]]\n     |>\n    ], {d, dims}];\n\n(* EAV \
cleanup test with explicit negative token added *)\nd = 4096;\ncodebook = \
AssociationThread[\n   {\"Mass\", \"Charge\", \"Color\", \"Heavy\", \
\"Light\", \"Positive\", \"Negative\", \"Neutral\", \"Gold\", \"Silver\"},\n  \
 Table[RandomUnitVector[d], 10]\n   ];\n\n\
CleanUpMemory[noisyVec_List?VectorQ, dict_Association] :=\n First @ \
MaximalBy[KeyValueMap[<|\"Token\" -> #1, \"Cosine\" -> CosineSim[noisyVec, \
#2]|> &, dict], #Cosine &];\n\nentityRepresentation = Total @ {\n    \
CircularConvolveHRR[codebook[\"Mass\"], codebook[\"Heavy\"]],\n    \
CircularConvolveHRR[codebook[\"Charge\"], codebook[\"Positive\"]],\n    \
CircularConvolveHRR[codebook[\"Color\"], codebook[\"Gold\"]]\n    };\n\n\
queryResult = CircularCorrelateHRR[codebook[\"Charge\"], \
entityRepresentation];\ncell2 = <|\n   \"TargetPositiveCosine\" -> \
CosineSim[queryResult, codebook[\"Positive\"]],\n   \
\"DistractorNegativeCosine\" -> CosineSim[queryResult, \
codebook[\"Negative\"]],\n   \"BestMatch\" -> CleanUpMemory[queryResult, \
codebook]\n   |>;\n\n(* Describe verifier corrected for zero-vector prior and \
explicit novelty/contradiction thresholds *)\n\
VerifyAndConsolidate[priorEntityVec_List?VectorQ, attributeVec_List?VectorQ, \
newValueVec_List?VectorQ, tauReinforce_: 0.25, tauContradiction_: 0.15] :=\n \
Module[{unboundExisting, sim, updatedEntity, status, encoded},\n  encoded = \
CircularConvolveHRR[attributeVec, newValueVec];\n  If[Norm[priorEntityVec] == \
0,\n   status = \"INITIAL_ASSERTION\";\n   updatedEntity = encoded; sim = \
Missing[\"NotAvailable\"],\n   unboundExisting = \
CircularCorrelateHRR[attributeVec, priorEntityVec];\n   sim = \
CosineSim[unboundExisting, newValueVec];\n   Which[\n    NumericQ[sim] && sim \
>= tauReinforce,\n    status = \"REINFORCED_CONSISTENT\";\n    updatedEntity \
= Normalize[priorEntityVec + encoded],\n    NumericQ[sim] && sim <= \
-tauContradiction,\n    status = \"CONTRADICTION_DETECTED\";\n    \
updatedEntity = priorEntityVec,\n    True,\n    status = \"NOVEL_OR_AMBIGUOUS\
\";\n    updatedEntity = Normalize[priorEntityVec + encoded]\n    ]\n   ];\n  \
<|\"Status\" -> status, \"AlignmentScore\" -> sim, \"UpdatedRepresentation\" \
-> updatedEntity|>\n  ];\n\nattr = RandomUnitVector[d]; valTrue = \
RandomUnitVector[d]; valContradict = -valTrue; entity0 = ConstantArray[0., \
d];\npass1 = VerifyAndConsolidate[entity0, attr, valTrue];\npass2 = \
VerifyAndConsolidate[pass1[\"UpdatedRepresentation\"], attr, valTrue];\npass3 \
= VerifyAndConsolidate[pass2[\"UpdatedRepresentation\"], attr, \
valContradict];\ncell3 = {KeyDrop[pass1, \"UpdatedRepresentation\"], \
KeyDrop[pass2, \"UpdatedRepresentation\"], KeyDrop[pass3, \
\"UpdatedRepresentation\"]};\n\n(* Exact decoherence expressions for pure \
dephasing Lindblad channel *)\ngamma = 0.5; tMax = 5.;\ncell4 = <|\n   \
\"rho00\" -> Simplify[1/2],\n   \"absRho01\" -> Simplify[(1/2) Exp[-2 gamma \
t]],\n   \"CoherenceAt5\" -> N[(1/2) Exp[-2 gamma tMax], 10]\n   |>;\n\n\
<|\"Cell1Sweep\" -> cell1, \"Cell2EAV\" -> cell2, \"Cell3Verifier\" -> cell3, \
\"Cell4Decoherence\" -> cell4|>", 
         "Parameters" -> <|
          "code" -> 
           "ClearAll[RandomUnitVector, CircularConvolveHRR, \
CircularCorrelateHRR, CosineSim, VerifyAndConsolidate, CleanUpMemory];\n\n\
SeedRandom[12345];\n\nRandomUnitVector[d_Integer?Positive] := \
Normalize[RandomVariate[NormalDistribution[0, 1], d]];\n\n(* Use standard \
unitary FourierParameters->{0,1}; circular convolution via inverse FFT of \
pointwise product. *)\nCircularConvolveHRR[a_List?VectorQ, b_List?VectorQ] /; \
Length[a] == Length[b] :=\n  Chop @ Re @ InverseFourier[Fourier[a] \
Fourier[b], FourierParameters -> {0, 1}];\n\n(* Approximate inverse in HRR is \
reversal/permutation; use correlation-style unbinding. *)\n\
CircularCorrelateHRR[key_List?VectorQ, composite_List?VectorQ] /; Length[key] \
== Length[composite] :=\n Module[{invKey},\n  invKey = \
RotateLeft[Reverse[key], 1];\n  CircularConvolveHRR[invKey, composite]\n ];\n\
\nCosineSim[u_List?VectorQ, v_List?VectorQ] /; Length[u] == Length[v] := \
Module[{nu = Norm[u], nv = Norm[v]}, If[nu == 0 || nv == 0, Indeterminate, \
(u.v)/(nu nv)]];\n\n(* Sweep with repeated trials for meaningful estimates *)\
\ndims = {512, 1024, 2048, 4096};\ntrials = 40;\n\ncell1 = Table[\n   \
Module[{scores = Table[\n       Module[{attr = RandomUnitVector[d], val = \
RandomUnitVector[d], other = RandomUnitVector[d], bound, rec, cross},\n       \
 bound = CircularConvolveHRR[attr, val];\n        rec = \
CircularCorrelateHRR[attr, bound];\n        cross = CosineSim[rec, other];\n  \
      {CosineSim[rec, val], cross}\n        ], {trials}]},\n    <|\n     \
\"Dimension\" -> d,\n     \"MeanRecoverCosSim\" -> Mean[scores[[All, 1]]],\n  \
   \"StdRecoverCosSim\" -> StandardDeviation[scores[[All, 1]]],\n     \
\"MeanCrossNoise\" -> Mean[scores[[All, 2]]],\n     \"StdCrossNoise\" -> \
StandardDeviation[scores[[All, 2]]]\n     |>\n    ], {d, dims}];\n\n(* EAV \
cleanup test with explicit negative token added *)\nd = 4096;\ncodebook = \
AssociationThread[\n   {\"Mass\", \"Charge\", \"Color\", \"Heavy\", \
\"Light\", \"Positive\", \"Negative\", \"Neutral\", \"Gold\", \"Silver\"},\n  \
 Table[RandomUnitVector[d], 10]\n   ];\n\n\
CleanUpMemory[noisyVec_List?VectorQ, dict_Association] :=\n First @ \
MaximalBy[KeyValueMap[<|\"Token\" -> #1, \"Cosine\" -> CosineSim[noisyVec, \
#2]|> &, dict], #Cosine &];\n\nentityRepresentation = Total @ {\n    \
CircularConvolveHRR[codebook[\"Mass\"], codebook[\"Heavy\"]],\n    \
CircularConvolveHRR[codebook[\"Charge\"], codebook[\"Positive\"]],\n    \
CircularConvolveHRR[codebook[\"Color\"], codebook[\"Gold\"]]\n    };\n\n\
queryResult = CircularCorrelateHRR[codebook[\"Charge\"], \
entityRepresentation];\ncell2 = <|\n   \"TargetPositiveCosine\" -> \
CosineSim[queryResult, codebook[\"Positive\"]],\n   \
\"DistractorNegativeCosine\" -> CosineSim[queryResult, \
codebook[\"Negative\"]],\n   \"BestMatch\" -> CleanUpMemory[queryResult, \
codebook]\n   |>;\n\n(* Describe verifier corrected for zero-vector prior and \
explicit novelty/contradiction thresholds *)\n\
VerifyAndConsolidate[priorEntityVec_List?VectorQ, attributeVec_List?VectorQ, \
newValueVec_List?VectorQ, tauReinforce_: 0.25, tauContradiction_: 0.15] :=\n \
Module[{unboundExisting, sim, updatedEntity, status, encoded},\n  encoded = \
CircularConvolveHRR[attributeVec, newValueVec];\n  If[Norm[priorEntityVec] == \
0,\n   status = \"INITIAL_ASSERTION\";\n   updatedEntity = encoded; sim = \
Missing[\"NotAvailable\"],\n   unboundExisting = \
CircularCorrelateHRR[attributeVec, priorEntityVec];\n   sim = \
CosineSim[unboundExisting, newValueVec];\n   Which[\n    NumericQ[sim] && sim \
>= tauReinforce,\n    status = \"REINFORCED_CONSISTENT\";\n    updatedEntity \
= Normalize[priorEntityVec + encoded],\n    NumericQ[sim] && sim <= \
-tauContradiction,\n    status = \"CONTRADICTION_DETECTED\";\n    \
updatedEntity = priorEntityVec,\n    True,\n    status = \"NOVEL_OR_AMBIGUOUS\
