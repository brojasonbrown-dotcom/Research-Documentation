      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"806407e7-e5a3-bf47-a448-9d5d3b218531"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"3. There is no control experiment for exact identity\"\>", 
    "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"18ae6570-58ba-2449-a69e-def78286e981"],
 "\nA rigorous audit should separate: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  StyleBox["self-recovery",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"499c5ac0-b99c-1f4e-bb5f-cbca41919916"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
