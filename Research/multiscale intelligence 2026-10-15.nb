Cell[CellGroupData[{

Cell["7.2 Dyadic transfer operators", "Subsection",ExpressionUUID->"38dbebc4-783a-964b-9cf3-8dc0c8034def"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "dyadicCoarseGrain", ",", "\[IndentingNewLine]", "  ", "dyadicLift", ",", 
     "\[IndentingNewLine]", "  ", "rgOrbit", ",", "\[IndentingNewLine]", "  ",
      "scaleResiduals", ",", "\[IndentingNewLine]", "  ", 
     "fixedScaleResidual", ",", "\[IndentingNewLine]", "  ", 
     "scaleFixedPointData"}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"dyadicCoarseGrain", "[", "list_List", "]"}], " ", "/;", " ", 
     RowBox[{"EvenQ", "[", 
      RowBox[{"Length", "[", "list", "]"}], "]"}]}], ":=", 
    RowBox[{"Mean", " ", "/@", " ", 
     RowBox[{"Partition", "[", 
      RowBox[{"list", ",", "2"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dyadicLift", "[", "list_List", "]"}], ":=", 
    RowBox[{"Riffle", "[", 
     RowBox[{"list", ",", "list"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rgOrbit", "[", 
     RowBox[{"transform_", ",", "state_List", ",", 
      RowBox[{"steps_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"NestWhileList", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{"transform", ",", "\[IndentingNewLine]", "    ", 
      RowBox[{"N", " ", "@", " ", "state"}], ",", "\[IndentingNewLine]", 
      "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"EvenQ", "[", 
         RowBox[{"Length", "[", "#", "]"}], "]"}], "&&", 
        RowBox[{
         RowBox[{"Length", "[", "#", "]"}], ">", "1"}]}], " ", "&"}], ",", 
      "\[IndentingNewLine]", "    ", "1", ",", "\[IndentingNewLine]", "    ", 
      "steps"}], "\[IndentingNewLine]", "  ", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleResiduals", "[", 
     RowBox[{"state_List", ",", 
      RowBox[{"steps_Integer", ":", "8"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"orbit", ",", "normalizedOrbit"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"orbit", "=", 
        RowBox[{"rgOrbit", "[", 
         RowBox[{"dyadicCoarseGrain", ",", "state", ",", "steps"}], "]"}]}], ";",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"normalizedOrbit", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Normalize", "[", 
           RowBox[{"#", ",", "Norm"}], "]"}], " ", "&"}], " ", "/@", " ", 
         "orbit"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"Norm", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"Normalize", "[", 
             RowBox[{
              RowBox[{"dyadicCoarseGrain", "[", 
               RowBox[{"normalizedOrbit", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "Norm"}], "]"}], "-", 
            RowBox[{"normalizedOrbit", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", 
           "\[IndentingNewLine]", "      ", "2"}], "\[IndentingNewLine]", 
          "    ", "]"}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{
            RowBox[{"Length", "[", "normalizedOrbit", "]"}], "-", "1"}]}], 
          "}"}]}], "\[IndentingNewLine]", "  ", "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"fixedScaleResidual", "[", "state_List", "]"}], " ", "/;", " ", 
     RowBox[{"EvenQ", "[", 
      RowBox[{"Length", "[", "state", "]"}], "]"}]}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"coarse", ",", "lifted"}], "}"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"coarse", "=", 
        RowBox[{"dyadicCoarseGrain", "[", "state", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"lifted", "=", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"dyadicLift", "[", "coarse", "]"}], ",", 
          RowBox[{"Length", "[", "state", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Normalize", "[", 
           RowBox[{"lifted", ",", "Norm"}], "]"}], "-", 
          RowBox[{"Normalize", "[", 
           RowBox[{"state", ",", "Norm"}], "]"}]}], ",", "2"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleFixedPointData", "[", 
    RowBox[{"state_List", ",", 
     RowBox[{"steps_Integer", ":", "8"}], ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}]}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Residuals\>\"", "->", 
      RowBox[{"scaleResiduals", "[", 
       RowBox[{"state", ",", "steps"}], "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<FixedScaleResidual\>\"", "->", 
      RowBox[{"fixedScaleResidual", "[", "state", "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<FixedPointQ\>\"", "->", 
      RowBox[{
       RowBox[{"fixedScaleResidual", "[", "state", "]"}], "<", "tol"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"9e2cca24-5bdb-fd48-a848-af3d38f45977"]
}, Open  ]],

