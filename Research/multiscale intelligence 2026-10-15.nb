  " ",
  "transfer operator construction"
 }], "InlineItem",ExpressionUUID->"9ea225a1-aa2d-3f4d-b58c-839844f53bb5"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "discrete I/O iteration"
 }], "InlineItem",ExpressionUUID->"a801220a-1c01-9848-96f1-94a46741a926"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "stability margins"
 }], "InlineItem",ExpressionUUID->"d98dee1f-d413-d443-a85e-ac9f40f893ba"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "controllability/observability analogs"
 }], "InlineItem",ExpressionUUID->"3fd0d56b-b7df-f843-af79-9df60d5afe1a"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Model selection\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"d26a43c9-0440-da47-ac9d-2809bdb43def"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "compare candidate density definitions"
 }], "InlineItem",ExpressionUUID->"856ab430-00ae-f049-b832-69ffca196dd7"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "compare function spaces"
 }], "InlineItem",ExpressionUUID->"f72dfed7-d1c5-674f-9e01-5d881053188b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
