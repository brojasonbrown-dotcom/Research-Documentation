Cell[CellGroupData[{

Cell["11. Neural network layer", "Section",ExpressionUUID->"a7f15f5b-13bc-7243-a723-8aa0a9b2525f"],

Cell[CellGroupData[{

Cell["11.1 Minimal field-to-network model", "Subsection",ExpressionUUID->"5240007d-6c41-3844-bcd7-3a5216a1cc47"],

Cell[TextData[{
 StyleBox["Established",
  FontWeight->Bold],
 ": symbolic neural nets can consume numeric vector or tensor encodings. "
}], "Text",ExpressionUUID->"c618c414-ddae-ad49-8330-759846ea088b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "minimalFieldNet", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"minimalFieldNet", "[", 
    RowBox[{
     RowBox[{"inputDim_Integer", "?", "Positive"}], ",", 
     RowBox[{"outputDim_Integer", "?", "Positive"}]}], "]"}], ":=", 
   RowBox[{"NetChain", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"LinearLayer", "[", "32", "]"}], ",", "\[IndentingNewLine]", 
       "   ", "Ramp", ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"LinearLayer", "[", "32", "]"}], ",", "\[IndentingNewLine]", 
       "   ", "Ramp", ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"LinearLayer", "[", "outputDim", "]"}]}], 
      "\[IndentingNewLine]", "  ", "}"}], ",", 
     RowBox[{"\"\<Input\>\"", "->", "inputDim"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[53]:=",ExpressionUUID->"4d7ad09f-61fc-da49-a25c-466cb5aaf879"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.2 Geometry-aware variant", "Subsection",ExpressionUUID->"f840f9ad-4fb2-6e47-9ece-e44000a103a5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "geometryAwareFieldNet", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"geometryAwareFieldNet", "[", 
    RowBox[{
     RowBox[{"inputDim_Integer", "?", "Positive"}], ",", 
     RowBox[{"outputDim_Integer", "?", "Positive"}]}], "]"}], ":=", 
   RowBox[{"NetGraph", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"<|", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"\"\<lin1\>\"", "->", 
        RowBox[{"LinearLayer", "[", "64", "]"}]}], ",", "\[IndentingNewLine]",
        "    ", 
       RowBox[{"\"\<act1\>\"", "->", "Ramp"}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"\"\<lin2\>\"", "->", 
        RowBox[{"LinearLayer", "[", "32", "]"}]}], ",", "\[IndentingNewLine]",
        "    ", 
       RowBox[{"\"\<act2\>\"", "->", "Ramp"}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"\"\<out\>\"", "->", 
        RowBox[{"LinearLayer", "[", "outputDim", "]"}]}]}], 
      "\[IndentingNewLine]", "  ", "|>"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"NetPort", "[", "\"\<Input\>\"", "]"}], "->", 
       RowBox[{"\"\<lin1\>\"", "->", 
        RowBox[{"\"\<act1\>\"", "->", 
         RowBox[{"\"\<lin2\>\"", "->", 
          RowBox[{"\"\<act2\>\"", "->", "\"\<out\>\""}]}]}]}]}], 
      "\[IndentingNewLine]", "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Input\>\"", "->", "inputDim"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"In[55]:=",ExpressionUUID->"177b1df8-52ea-eb4a-9c37-efdc81993d45"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.3 Interpretation", "Subsection",ExpressionUUID->"7ec78ec9-8a43-1643-bdaf-77551ca5a600"],

Cell[TextData[{
 "A neural network here is not treated as separate from the field. It is \
treated as an adaptive operator on field-derived coordinates.",
 StyleBox["Model hypothesis",
  FontWeight->Bold],
 ": intelligence may arise when field structure and learned operators become \
mutually compatible descriptions of the same organization."
}], "Text",ExpressionUUID->"9f394e2d-3543-2041-90d9-918f5d08399a"],

Cell[TextData[{
 "See also ",
 ButtonBox["NetChain",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NetChain"],
 ", ",
 ButtonBox["NetGraph",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NetGraph"],
 ", ",
 ButtonBox["NetTrain",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NetTrain"],
 ", ",
 ButtonBox["NetMeasurements",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NetMeasurements"],
 ", and ",
 ButtonBox["NetModel",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NetModel"],
 ". "
}], "Text",ExpressionUUID->"b069942f-4318-e64b-87dd-8e16f150f7e4"],

