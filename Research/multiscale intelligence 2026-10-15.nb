  Background->None,ExpressionUUID->"92693308-8c4b-b040-9e9c-9ffd2b9c541d"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"One more important note about your OPF instruction \
layer\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"525b05c6-1ab3-b14e-99fe-7a38456ef0b5"],
 "\nYou asked for \[OpenCurlyDoubleQuote]utmost \
rigor,\[CloseCurlyDoubleQuote] and your custom framework includes \
requirements like infinite precision and rejecting approximations unless \
derived.\n\nFor this particular HRR test, that standard is ",
 StyleBox["not fully compatible with the object being tested",
  FontWeight->Bold],
 ", because: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "HRR itself is a ",
  StyleBox["finite-dimensional stochastic representation scheme",
   FontWeight->Bold]
 }], "InlineItem",ExpressionUUID->"5dcb93b0-ecaf-5a4d-a24f-6d8b50080b8a"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "its main claims are ",
  StyleBox["probabilistic/statistical",
   FontWeight->Bold],
  ", not exact closed-form ontology"
 }], "InlineItem",ExpressionUUID->"38606878-d225-7348-8981-428f0472905e"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "FFT-based numerical testing is appropriate here"
 }], "InlineItem",ExpressionUUID->"5b178996-90a3-934e-9741-1cf52ee0d764"],
 "\nSo rigor here means: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "explicit definitions"
 }], "InlineItem",ExpressionUUID->"3d0bed17-edeb-384d-a77e-a9e072bc9366"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "exact algebra where possible"
 }], "InlineItem",ExpressionUUID->"67ff7ac8-ef3c-1f42-9539-b239bf6fc962"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "clear separation of exact vs approximate"
 }], "InlineItem",ExpressionUUID->"922e5636-98ac-c64a-8b67-8e1676e011b1"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "repeated trials"
 }], "InlineItem",ExpressionUUID->"784125bb-5a1f-db42-a606-ff4b318b636b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "numerical conditioning checks"
 }], "InlineItem",ExpressionUUID->"8c1f72ce-5426-e140-a566-122ad8edfc05"],
 "\n\[LongDash]not pretending the scheme is exact when it is not. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
