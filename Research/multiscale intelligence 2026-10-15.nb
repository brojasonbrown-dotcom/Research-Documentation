 }], "InlineItem",ExpressionUUID->"dea92e0f-8043-4e47-ae80-c0b17ea28e17"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "compare measurement kernels"
 }], "InlineItem",ExpressionUUID->"24f7c6d0-3d58-cf4e-bdbd-077faae925cf"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "rank by residual/stability/interpretablity"
 }], "InlineItem",ExpressionUUID->"26cb0019-e139-d444-af20-7b0c2348c073"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"844abeff-5264-b04f-8f34-415b69d9c0fe"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"11. Functional tests specifically for \
\[OpenCurlyDoubleQuote]spacetime density\[CloseCurlyDoubleQuote]\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"85b965f0-ecea-6b46-b6b5-ac3ed2454ca4"],
 "\nIf your main target is density of spacetime, then these are the first \
essential tests. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"R. Density-specific test suite\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ff8faef1-f2f5-1140-b6e7-6b3045bfd90f"],
 "\n1. ",
 StyleBox["positivity test",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "is the proposed density nonnegative?"
 }], "InlineSubitem",ExpressionUUID->"a729fdc5-f180-6b4d-9cf6-0e6bbdc91479"],
 "\n2. ",
 StyleBox["integrability test",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "does total density converge on the domain?"
 }], "InlineSubitem",ExpressionUUID->"725aad2d-2807-7248-b1ab-7b2b75437434"],
 "\n3. ",
 StyleBox["scale invariance test",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "does density preserve OPF scale logic?"
 }], "InlineSubitem",ExpressionUUID->"531ebdf3-2bc8-6f47-a245-edd18ec57b63"],
 "\n4. ",
 StyleBox["boundary behavior test",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "what happens at ",
  "0",
  " and ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Infinity]", TraditionalForm], "errors" -> {}, 
      "input" -> "\\infty", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "933488bb-a5c6-774b-bcee-b2ef827e76ac"],
  "?"
 }], "InlineSubitem",ExpressionUUID->"e318e0f5-9371-b34c-8092-634182bce7eb"],
 "\n5. ",
 StyleBox["resolution covariance test",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "how does density transform under ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          StyleBox["R", "TI"], "\[RightTeeArrow]", 
          OverscriptBox[
           StyleBox["R", "TI"], "~"]}], TraditionalForm], "errors" -> {}, 
      "input" -> "R \\mapsto \\tilde R", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "ff58357e-6881-d447-88d9-aa3e24cfba68"],
  "?"
 }], "InlineSubitem",ExpressionUUID->"93dec68a-a726-0647-901a-53a801f7b4ad"],
 "\n6. ",
 StyleBox["measurement consistency test",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "does measured density agree with latent density?"
 }], "InlineSubitem",ExpressionUUID->"26f3cc3d-b7a7-9e46-8d66-fc784c0c3a58"],
 "\n7. ",
 StyleBox["spectral consistency test",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "do density peaks correspond to stable modes?"
 }], "InlineSubitem",ExpressionUUID->"db7b0fea-90d2-b244-8021-22b2beedd13f"],
 "\n8. ",
 StyleBox["stability generation test",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "does higher density stabilize or destabilize solutions?"
 }], "InlineSubitem",ExpressionUUID->"76354213-a679-8645-9a9d-ede933dc8d03"],
 "\n9. ",
 StyleBox["emergent geometry test",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "can density induce effective curvature/metric?"
 }], "InlineSubitem",ExpressionUUID->"a40ef686-8c47-8348-abaa-9e6c46a67edf"],
 "\n10. ",
 StyleBox["inverse recoverability test",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "can density be inferred from observables?"
 }], "InlineSubitem",ExpressionUUID->"0e8c4449-b91e-9641-ab2c-92491e922f3f"],
 "\n11. ",
 StyleBox["topological sensitivity test",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "does density depend on substrate topology?"
 }], "InlineSubitem",ExpressionUUID->"23a48c9f-3f91-f342-b9dc-92c6081c0234"],
 "\n12. ",
 StyleBox["computational tractability test",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "can it be evaluated/refined effectively?"
 }], "InlineSubitem",ExpressionUUID->"98721d39-d4fe-f54e-ac84-2c309e9037aa"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"dc89b9d4-857e-9c4d-9cfa-a5b2fad8aa7b"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"12. A full mathematical structure for your logic\"\>", 
    "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"75f33ab6-88ed-9441-9387-98cef81beda5"],
 "\nHere is the concise formal scaffold I\[CloseCurlyQuote]d recommend. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"S. OPF mathematical skeleton\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"0a1d899a-624f-8c45-9e41-f7ece31ca373"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"S1. Substrate\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"f2dd05f8-56e7-2646-893b-3a7c89c03b63"],
 "\nLet \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], "0"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["X", "TI"], ",", "\[Tau]", ",", "\[Beta]", ",", 
             "\[Sigma]"}], ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{S}_0=(X,\\tau,\\beta,\\sigma)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ec1245a6-51f5-d14d-998e-228455b0d1cd"],
 "\nwhere: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["X", "TI"], TraditionalForm], "errors" -> {}, "input" -> "X",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "95c66f6e-107e-db48-b454-400e4893f57f"],
  " is a sphere-like topological substrate,"
 }], "InlineItem",ExpressionUUID->"ba621185-aff4-a945-9868-1805754e75ef"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Tau]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\tau", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "95f85fff-c3c7-c541-a76e-ae987e9bf128"],
  " is topology,"
 }], "InlineItem",ExpressionUUID->"6b09b160-a8f0-0f43-b8a7-a9370a5c0ed3"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"\[Beta]", "\[LongEqual]", 
          RowBox[{"{", 
            RowBox[{"0", ",", "\[Infinity]"}], "}"}]}], TraditionalForm], 
      "errors" -> {}, "input" -> "\\beta=\\{0,\\infty\\}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "f8e79ea9-4ce5-1c40-a051-1e518abf601b"],
  " is boundary duality,"
 }], "InlineItem",ExpressionUUID->"6ca02ac3-0bf7-5e44-b43f-0734a7fbd805"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|
     "boxes" -> FormBox["\[Sigma]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\sigma", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "9f378657-1d36-3741-aec8-ac5e107f5407"],
  " is symmetry structure."
 }], "InlineItem",ExpressionUUID->"9d5ccc8b-2ece-2149-b055-f5b6b60f0ab0"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"S2. Field layer\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e35ddec3-3ff5-6748-89a0-f5d7f6360387"],
 "\nDefine fields \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
         StyleBox["R", "TI"], ":", 
         StyleBox["X", "TI"], "\[Rule]", 
         StyleBox["R", FontSlant -> "Plain"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\rho,\\chi,R : X \\to \\mathbb{R}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4cbe12c3-1a0f-064d-bb33-5af4d84ca596"],
 "\nwith admissibility: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[Rho]", "\[GreaterEqual]", "0", ",  ", "\[Chi]", ">", "0", ",  ", 
         StyleBox["R", "TI"], ">", "0"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho \\ge 0,\\quad \\chi > 0,\\quad R>0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "82092e51-f35f-cf4c-9c67-942c28bf542f"],
 "\nDefine \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPsi]", "\[LongEqual]", "\[CapitalPsi]", 
         RowBox[{"[", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"]}], "]"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\Psi = \\Psi[\\rho,\\chi,R]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "83ca201f-5ccd-4d43-afb0-e67c7cdf2c32"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"S3. Action\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"07c44ca6-e436-0743-b547-9bd50fbe3ddd"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], 
         RowBox[{"[", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"]}], "]"}], "\[LongEqual]", 
         SubscriptBox["\[Integral]", 
          StyleBox["X", "TI"]], 
         StyleBox["L", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"], ",", "\[Del]", "\[Rho]", ",", "\[Del]", 
             "\[Chi]", ",", "\[Del]", 
             StyleBox["R", "TI"], ",", "\[Ellipsis]"}], ")"}], 
         "\[DifferentialD]", "\[Mu]"}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "S[\\rho,\\chi,R] = \\int_X \
\\mathcal{L}(\\rho,\\chi,R,\\nabla\\rho,\\nabla\\chi,\\nabla R,\\dots)\\, \
d\\mu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cfbd88e1-008b-1f4a-a336-ffbe16a19c7e"],
 "\nstart with \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], "0"], "\[LongEqual]", "\[Rho]", "log", 
         "\[Chi]", "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{L}_0=\\rho\\log\\chi+\\chi R^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a00c2aa6-b21e-724f-992b-071eb310c4e7"],
 "\nthen extend if needed. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"S4. Field equations\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"aa1d9287-d057-4a4f-9ceb-d946830f9797"],
 "\nCompute \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[Delta]", 
            StyleBox["S", "TI"]}], "\[Delta]\[Rho]"], "\[LongEqual]", "0", 
         ",    ", 
         FractionBox[
          RowBox[{"\[Delta]", 
            StyleBox["S", "TI"]}], "\[Delta]\[Chi]"], "\[LongEqual]", "0", 
         ",    ", 
         FractionBox[
          RowBox[{"\[Delta]", 
            StyleBox["S", "TI"]}], 
          RowBox[{"\[Delta]", 
            StyleBox["R", "TI"]}]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\frac{\\delta S}{\\delta \\rho}=0,\\qquad\n\\frac{\\delta S}{\\delta \
\\chi}=0,\\qquad\n\\frac{\\delta S}{\\delta R}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "39d91533-9163-2d4f-8977-61d3e80df8d9"],
 "\npossibly with constraints. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"S5. Linearization\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"e6931ac9-fb6b-8e4a-884e-18ad604e5cec"],
 "\nAt a background solution ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           SubscriptBox["\[Rho]", "0"], ",", 
           SubscriptBox["\[Chi]", "0"], ",", 
           SubscriptBox[
            StyleBox["R", "TI"], "0"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(\\rho_0,\\chi_0,R_0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8cf7d6fd-5870-d84a-952f-bc57c7a879b7"],
 ", write \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[LongEqual]", 
         SubscriptBox["\[Rho]", "0"], "+", "\[Epsilon]", 
         OverscriptBox["\[Rho]", "^"], ",  ", "\[Chi]", "\[LongEqual]", 
         SubscriptBox["\[Chi]", "0"], "+", "\[Epsilon]", 
         OverscriptBox["\[Chi]", "^"], ",  ", 
         StyleBox["R", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["R", "TI"], "0"], "+", "\[Epsilon]", 
         OverscriptBox[
          StyleBox["R", "TI"], "^"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\rho=\\rho_0+\\epsilon \\hat\\rho,\\quad\n\\chi=\\chi_0+\\epsilon \
\\hat\\chi,\\quad\nR=R_0+\\epsilon \\hat R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5da06ec3-3e11-4b4c-aa48-75d6342f8ea2"],
 "\nand derive the linear operator \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
