         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "y"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", "      ", 
       RowBox[{"DirichletCondition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "y"}], "]"}], "==", "0"}], ",", "True"}], 
        "]"}]}], "\[IndentingNewLine]", "    ", "}"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"u", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], " ", "\[Element]", " ", 
      "circularRegion"}], ",", "\[IndentingNewLine]", "    ", "n"}], 
    "\[IndentingNewLine]", "  ", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"a28d6c47-1fc7-464b-a795-07f6df83e523"]
