 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Dataset split\"\>", "Subsection",
    CellFrame->0,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"b94d62b5-171d-3246-b291-2d4ff6a7c71c"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"splitDataset", "[", 
            RowBox[{"data_List", ",", 
              RowBox[{"trainFrac_", ":", " ", "0.7"}], ",", 
              RowBox[{"valFrac_", ":", " ", "0.15"}]}], "]"}], ":=", 
          RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{"{", 
                RowBox[{"n", ",", "shuffled", ",", "nTrain", ",", "nVal"}], 
                "}"}], ",", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"n", "=", 
                  RowBox[{"Length", "[", "data", "]"}]}], ";", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"shuffled", "=", 
                  RowBox[{"RandomSample", "[", "data", "]"}]}], ";", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"nTrain", "=", 
                  RowBox[{"Floor", "[", 
                    RowBox[{"trainFrac", " ", "n"}], "]"}]}], ";", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"nVal", "=", 
                  RowBox[{"Floor", "[", 
                    RowBox[{"valFrac", " ", "n"}], "]"}]}], ";", 
                "\[IndentingNewLine]", "  ", 
                RowBox[{"<|", "\[IndentingNewLine]", "    ", 
                  RowBox[{
                    RowBox[{"\"Train\"", "->", 
                    RowBox[{"shuffled", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", " ", ";;", " ", "nTrain"}], "]"}], "]"}]}], 
                    ",", "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"Validation\"", "->", 
                    RowBox[{"shuffled", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"nTrain", "+", "1"}], " ", ";;", " ", 
                    RowBox[{"nTrain", "+", "nVal"}]}], "]"}], "]"}]}], ",", 
                    "\[IndentingNewLine]", "    ", 
                    RowBox[{"\"Test\"", "->", 
                    RowBox[{"shuffled", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"nTrain", "+", "nVal", "+", "1"}], " ", ";;"}], 
                    "]"}], "]"}]}]}], "\[IndentingNewLine]", "  ", "|>"}]}]}],
             "\[IndentingNewLine]", "]"}]}], ";"}]], "ChatCode", "Input", 
     LanguageCategory -> "Input", ShowAutoStyles -> True, 
     ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "f14e36a7-a0a5-df4a-8819-6d41aef3cd2c"],
