     RowBox[{"\[Beta]", ">=", "0"}], "&&", 
     RowBox[{"\[CurlyEpsilon]", ">", "0"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
