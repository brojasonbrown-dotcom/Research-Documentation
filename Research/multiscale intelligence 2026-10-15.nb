 }], "InlineItem",ExpressionUUID->"017d1e16-e12e-f747-b47d-cec6529f136f"],
 "\nFor example, instead of manual loops for dataset generation, use: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"dataset", "=", 
          RowBox[{"makeFieldDataset", "[", 
            RowBox[{"\"Classification\"", ",", "200", ",", "64"}], "]"}]}], 
        ";"}]], "ChatCode", "Input", LanguageCategory -> "Input", 
     ShowAutoStyles -> True, ShowStringCharacters -> True, ShowSyntaxStyles -> 
     True, TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "8ad5721e-5901-c449-9add-c88d69f3948c"],
 "\ninstead of appending inside a loop. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
