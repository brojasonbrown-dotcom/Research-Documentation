  "CellToStringData" -> 
   "/doc_lookup\n\
NetTrain,NetMeasurements,NetStateObject,NetFoldOperator,NetPort,NetModel,\
BasicRecurrentLayer,LongShortTermMemoryLayer,NetReplacePart\n/exec\nRESULT\n\
Missing[\"NotFound\", \"paclet:ref/NetTrain\"]\n\n======\n\n\
Missing[\"NotFound\", \"paclet:ref/NetMeasurements\"]\n\n======\n\n\
