  Background->None,ExpressionUUID->"fbac73a9-393b-9b4b-9cef-011f198148d8"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"What the first section should become\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ee3d6a5a-e93d-724e-9e8c-f24639890f61"],
 "\nA rigorous first section should test ",
 StyleBox["five layers",
  FontWeight->Bold],
 ":\n\n1. ",
 StyleBox["Formal definitions",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "circular convolution"
 }], "InlineSubitem",ExpressionUUID->"ef26c285-8eef-1e4b-8f77-ec9a59b4fa80"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "circular correlation"
 }], "InlineSubitem",ExpressionUUID->"fa4408ff-0b1f-ee4f-8c0a-71b3da259a0a"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "exact inverse binding when available"
 }], "InlineSubitem",ExpressionUUID->"3eef9cee-b451-4140-9967-5be0e1ee5cfb"],
 "\n2. ",
 StyleBox["Algebraic sanity checks",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "identity element"
 }], "InlineSubitem",ExpressionUUID->"696c1fe8-9093-9c46-bb33-14898b84fa63"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "bilinearity"
 }], "InlineSubitem",ExpressionUUID->"9a5c433c-7583-5b45-9c10-9f87b7250cfc"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "commutativity of circular convolution"
 }], "InlineSubitem",ExpressionUUID->"2f28ce87-e383-5149-aca4-4e96442503f8"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "correlation as approximate inverse, not exact inverse"
 }], "InlineSubitem",ExpressionUUID->"38c0ba20-ab26-614e-9b75-33f5c19d203d"],
 "\n3. ",
 StyleBox["Single-bind recovery experiment",
  FontWeight->Bold],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "bind ",
  StyleBox["attr", "TI"],
