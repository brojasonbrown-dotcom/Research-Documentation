Cell[TextData[StyleBox["explicit about assumptions, hypotheses, and \
speculative interpretations",
 FontWeight->Bold]], "Item",ExpressionUUID->"2bb244d7-fe4f-2041-899f-\
14bae5fd4035"],

Cell[TextData[StyleBox["compatible with neural-network pipelines in the \
Wolfram Language",
 FontWeight->Bold]], "Item",ExpressionUUID->"24819857-2d02-9d4b-a81b-\
4a32dc449e5f"],

Cell[TextData[{
 "It does ",
 StyleBox["not",
  FontWeight->Bold],
 " assume metaphysical conclusions are already established. Instead, it \
provides a mathematical and computational framework for testing whether a \
multiscale field representation can be transformed into a resolution-stable \
latent representation usable by neural networks, and whether neural networks \
can be embedded back into field dynamics. "
}], "Text",ExpressionUUID->"5b9de935-2dc7-9649-b350-a07b6a0e23c3"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"4d3f7e56-498c-d348-903c-3fd5f270dd41"],

Cell[CellGroupData[{

Cell["0. Epistemic policy", "Section",ExpressionUUID->"a7b50a55-f834-7c4d-a682-5485ba7c7910"],

Cell["This notebook uses four labels throughout: ", "Text",ExpressionUUID->"2f1ecd43-6fd3-be41-bb28-6f0d2bede3ad"],

Cell[TextData[{
 StyleBox["Established",
  FontWeight->Bold],
 ": standard mathematics, computation, or neural-network formalism."
}], "Item",ExpressionUUID->"e470f1cf-0878-a248-a16b-1d5b1656cb70"],

Cell[TextData[{
 StyleBox["Model hypothesis",
  FontWeight->Bold],
 ": a proposed structure that can be tested."
}], "Item",ExpressionUUID->"de94e18d-1a70-c34e-80d6-6d7a5b48d29b"],

Cell[TextData[{
 StyleBox["Analogy",
  FontWeight->Bold],
 ": structural similarity without identity proof."
}], "Item",ExpressionUUID->"7f9c4af7-bffb-b249-9b12-139f9a3c3728"],

Cell[TextData[{
 StyleBox["Speculation",
  FontWeight->Bold],
 ": interpretation not derivable from current mathematics alone."
}], "Item",ExpressionUUID->"b085fdbe-9523-4341-a0cf-ca59dcbd9bc7"],

Cell["\<\
The purpose is to preserve rigor while still allowing ambitious synthesis. \
\>", "Text",ExpressionUUID->"89dd1ddc-691e-4544-8faa-1bbf323e6282"],

