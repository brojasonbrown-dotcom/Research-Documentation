          RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
            RowBox[{
              RowBox[{"{", 
                
                RowBox[{
                 "state0", ",", "seq", ",", "inputSeq", ",", "targetSeq"}], 
                "}"}], ",", "\[IndentingNewLine]", "  ", 
              RowBox[{
                RowBox[{"state0", "=", 
