 ".\n\nTruth: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Circular correlation with the involution ",
  Cell[BoxData[
   TemplateBox[{
    "Reverse", "paclet:ref/Reverse", 
     "https://reference.wolfram.com/language/ref/Reverse.html"},
    "TextRefLink"]],ExpressionUUID->"11d9293c-0ccb-af41-a808-c8085814c8ff"],
  "/rotation operation is ",
  StyleBox["not an exact inverse",
   FontWeight->Bold],
  " in general."
 }], "InlineItem",ExpressionUUID->"9fd81894-1f8e-754d-904a-2b0f56f387f9"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "It is an approximate decoder when vectors are random, high-dimensional, \
and near-orthogonal."
 }], "InlineItem",ExpressionUUID->"ce8468a4-2a13-8c45-9276-5c3729d579a9"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "Exact inverse exists only if you define one in frequency space:"
 }], "InlineItem",ExpressionUUID->"5062b8d9-02a6-4e40-a78b-33a4ffe463c5"],
 "\n  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox[
           SuperscriptBox[
            StyleBox["b", "TI"], "-1"], "^"], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         FractionBox["1", 
          SubscriptBox[
           OverscriptBox[
            StyleBox["b", "TI"], "^"], 
           StyleBox["k", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\widehat{b^{-1}}_k = \\frac{1}{\\hat b_k}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d3ffd91f-a9d2-af44-b75f-29f11d3afbc0"],
 "\n  wherever ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["b", "TI"], "^"], 
          StyleBox["k", "TI"]], "\[NotEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\hat b_k \\neq 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ba3c88f3-1966-1b41-bc44-7977196fce4e"],
 ".\n\nThat is a different operation from circular correlation. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
