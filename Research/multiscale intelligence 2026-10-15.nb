Cell[CellGroupData[{

Cell["5. Multiscale field dynamics layer", "Section",ExpressionUUID->"0adead7c-03c7-904b-8213-e316fa30f11e"],

Cell[CellGroupData[{

Cell["5.1 General field equation", "Subsection",ExpressionUUID->"e5252d82-d5ab-1d45-9925-15814cb588b6"],

Cell[TextData[{
 "We study systems of the form: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[PartialD]", 
          StyleBox["t", "TI"], "2"], 
         StyleBox["u", "TI"], "+", "2", "\[Gamma] ", 
         SubscriptBox["\[PartialD]", 
          StyleBox["t", "TI"]], 
         StyleBox["u", "TI"], "+", 
         StyleBox["L", "TI"], 
         StyleBox["u", "TI"], "+", 
         StyleBox["N", "TI"], 
         RowBox[{"(", 
           StyleBox["u", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["f", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\partial_t^2 u + 2\\gamma\\,\\partial_t u + \\mathcal{L}u + \
\\mathcal{N}(u) = f", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9bfe4aa3-98a9-8247-be23-fd7c5d9c006e"],
 "where: "
}], "Text",ExpressionUUID->"8158de60-0f8a-5f4c-a634-c5001231d757"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["u", "TI"], TraditionalForm], "errors" -> {}, "input" -> "u", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "291046c9-4289-1c40-9eef-9577ecebeef9"],
 " is the field state,"
}], "Item",ExpressionUUID->"6628a419-707d-6a4f-8d12-3ef291ffbc36"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["L", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{L}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b13d66bd-6975-e04d-9638-180d73df4358"],
 " is a geometry-dependent linear operator,"
}], "Item",ExpressionUUID->"1f655540-b2e5-c24a-a656-e268af425654"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["N", "TI"], "(", 
         StyleBox["u", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{N}(u)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "488b74c2-219d-7348-ae62-b7566478796e"],
 " is nonlinear coupling,"
}], "Item",ExpressionUUID->"60de86bf-511d-234f-8346-cbe5252f8a73"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["f", "TI"], TraditionalForm], "errors" -> {}, "input" -> "f", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "09e7f8b3-13e3-0b4c-a627-e56c94664264"],
 " is forcing,"
}], "Item",ExpressionUUID->"0b475cdd-44f7-fc48-b82a-746c2c94e472"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Gamma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bb0be8aa-e8dc-e347-a516-77b4daa28fcf"],
 " is damping."
}], "Item",ExpressionUUID->"b4db924c-ff72-a149-8f95-8b1aaaea5677"],

Cell["\<\
This equation is not yet a final ontology. It is a broad test class. \
\>", "Text",ExpressionUUID->"aff58187-fe59-0043-84ff-a92973acc0c2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.2 Matrix surrogate tools", "Subsection",ExpressionUUID->"caa0f208-0a3a-a84a-8af8-02ee4cc11fbc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "dampedLaplacian1D", ",", "\[IndentingNewLine]", "  ", "spectralData", ",",
      "\[IndentingNewLine]", "  ", "truncationStabilityTable", ",", 
     "\[IndentingNewLine]", "  ", "qFactor", ",", "\[IndentingNewLine]", "  ",
      "modeEnergy"}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"dampedLaplacian1D", "[", 
     RowBox[{
      RowBox[{"n_Integer", "?", "Positive"}], ",", 
      RowBox[{"\[Gamma]_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "lap", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"lap", "=", 
        RowBox[{
         RowBox[{"SparseArray", "[", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"{", "\[IndentingNewLine]", "        ", 
            RowBox[{
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", 
              RowBox[{"-", "2"}]}], ",", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"1", ",", "2"}], "}"}], "]"}], "->", "1"}], ",", 
             "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"Band", "[", 
               RowBox[{"{", 
                RowBox[{"2", ",", "1"}], "}"}], "]"}], "->", "1"}]}], 
            "\[IndentingNewLine]", "      ", "}"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"{", 
            RowBox[{"n", ",", "n"}], "}"}]}], "\[IndentingNewLine]", "    ", 
          "]"}], " ", "//", " ", "Normal"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"lap", "-", 
        RowBox[{"\[Gamma]", " ", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"spectralData", "[", 
     RowBox[{"matrix_", "?", "MatrixQ"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "vals", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"vals", "=", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"N", " ", "@", " ", "matrix"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Eigenvalues\>\"", "->", "vals"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<RealParts\>\"", "->", 
          RowBox[{"Re", "[", "vals", "]"}]}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<ImaginaryParts\>\"", "->", 
          RowBox[{"Im", "[", "vals", "]"}]}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<ContinuousTimeStableQ\>\"", "->", 
          RowBox[{"And", " ", "@@", " ", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Re", "[", "vals", "]"}], "<", "0"}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<DiscreteTimeStableQ\>\"", "->", 
          RowBox[{"And", " ", "@@", " ", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Abs", "[", "vals", "]"}], "<", "1"}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StabilityMarginContinuous\>\"", "->", 
          RowBox[{"-", 
           RowBox[{"Max", "[", 
            RowBox[{"Re", "[", "vals", "]"}], "]"}]}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StabilityMarginDiscrete\>\"", "->", 
          RowBox[{"1", "-", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", "vals", "]"}], "]"}]}]}]}], 
        "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"truncationStabilityTable", "[", 
     RowBox[{"operatorBuilder_", ",", "modeCounts_List"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"AssociationMap", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"spectralData", "[", 
        RowBox[{"operatorBuilder", "[", "#", "]"}], "]"}], " ", "&"}], ",", 
      "modeCounts"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qFactor", "[", 
     RowBox[{
      RowBox[{"\[Omega]_", "?", "NumericQ"}], ",", 
      RowBox[{"\[Gamma]_", "?", "NumericQ"}]}], "]"}], " ", "/;", " ", 
    RowBox[{"\[Gamma]", ">", "0"}]}], ":=", 
   RowBox[{"\[Omega]", "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", "\[Gamma]"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qFactor", "[", 
     RowBox[{
      RowBox[{"\[Omega]_", "?", "NumericQ"}], ",", "0"}], "]"}], ":=", 
    "Infinity"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modeEnergy", "[", 
    RowBox[{"a_", ",", "adot_", ",", 
     RowBox[{"\[Omega]_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"adot", "^", "2"}], "+", 
      RowBox[{
       RowBox[{"\[Omega]", "^", "2"}], " ", 
       RowBox[{"a", "^", "2"}]}]}], ")"}]}]}], ";"}]}], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"b9f4210a-cb60-0b42-bdea-7122d97607a5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.3 Spectral convergence diagnostics", "Subsection",ExpressionUUID->"c44c1ed8-fa6a-d64b-b718-15c48c8599e4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "spectralConvergenceReport", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spectralConvergenceReport", "[", 
    RowBox[{"operatorBuilder_", ",", "modeCounts_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"table", ",", "margins"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{
      RowBox[{"table", "=", 
       RowBox[{"truncationStabilityTable", "[", 
        RowBox[{"operatorBuilder", ",", "modeCounts"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"margins", "=", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"table", "[", "#", "]"}], 
           "[", "\"\<StabilityMarginContinuous\>\"", "]"}], " ", "&"}], ",", 
         "modeCounts"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Table\>\"", "->", "table"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Margins\>\"", "->", "margins"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ConvergentMarginQ\>\"", "->", 
         RowBox[{"Quiet", "[", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{"Round", "[", 
              RowBox[{
               RowBox[{"Values", "[", "margins", "]"}], ",", 
               RowBox[{"10", "^", 
                RowBox[{"-", "6"}]}]}], "]"}], "]"}], "]"}], "<=", "3"}], 
          "]"}]}]}], "\[IndentingNewLine]", "  ", "|>"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"5a899411-8796-ff4e-acad-5b6f9ea58b88"],

Cell[TextData[{
 StyleBox["Rigorous requirement",
  FontWeight->Bold],
 ": a persistence claim should not depend arbitrarily on truncation. "
}], "Text",ExpressionUUID->"cbb4169e-1dd7-fa44-a018-7d1ca5a008ac"],

