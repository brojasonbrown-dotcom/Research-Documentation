Cell[CellGroupData[{

Cell["17. Neural training notes", "Section",ExpressionUUID->"b1f1cc15-cc74-cc40-b505-8d10732d87e6"],

Cell[TextData[{
 "If you want to train neural models on field-derived data, use ",
 ButtonBox["NetTrain",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NetTrain"],
 ". Related symbols include ",
 ButtonBox["NetModel",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NetModel"],
 ", ",
 ButtonBox["NetMeasurements",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NetMeasurements"],
 ", ",
 ButtonBox["NetTrainResultsObject",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NetTrainResultsObject"],
 ", and ",
 ButtonBox["NetStateObject",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NetStateObject"],
 "."
}], "Text",ExpressionUUID->"80a079ec-227d-994d-a690-19987797644d"],

Cell[TextData[{
 "For example, training progress can include precision and recall \
measurements; see ",
 ButtonBox["NetTrain",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NetTrain#152404673"],
 "."
}], "Text",ExpressionUUID->"3a627f78-667e-e64d-ac7e-f884e747fae8"],

