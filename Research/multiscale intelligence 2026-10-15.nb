Cell[CellGroupData[{

Cell["8. Sensory field formalization", "Section",ExpressionUUID->"92abb595-3a8d-a24a-811c-42c2cd9ba473"],

Cell[CellGroupData[{

Cell["8.1 Working definition", "Subsection",ExpressionUUID->"4a1f6b8c-de3c-2345-900f-c3bb65b91c91"],

Cell[TextData[{
 "A ",
 StyleBox["sensory field",
  FontWeight->Bold],
 " is modeled here as a distributed state field with: "
}], "Text",ExpressionUUID->"59c05d44-7bae-7140-91fd-c01952ac82f7"],

Cell["local source structure,", "Item",ExpressionUUID->"569aed7f-3365-8947-b486-933be485e064"],

Cell["geometry-conditioned propagation,", "Item",ExpressionUUID->"5890afa8-911e-0d45-9f1a-f76710a95b9e"],

Cell["multiscale observability,", "Item",ExpressionUUID->"881cafc2-749d-7a4e-a19b-9d0f293089c8"],

Cell["repeated-interaction selection,", "Item",ExpressionUUID->"99f4af36-8ac3-4c44-8151-5c42bd87ae3c"],

Cell["field-topological organization.", "Item",ExpressionUUID->"8aba19e7-2e2e-6942-9f32-8e5c5ae581f5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.2 Source-induced field potential", "Subsection",ExpressionUUID->"3a4d1e87-05b4-094f-963a-f03881a928dd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "sourceFieldPotential", ",", "effectivePotential2D", ",", 
     "effectiveForce2D", ",", "curl2D"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sourceFieldPotential", "[", "sources_List", "]"}], "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Total", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"Map", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", "src", "}"}], ",", "\[IndentingNewLine]", "      ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"center", "=", 
              RowBox[{"src", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{"amp", "=", 
              RowBox[{"src", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ",", 
             RowBox[{"width", "=", 
              RowBox[{"src", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], ",", 
           "\[IndentingNewLine]", "        ", 
           RowBox[{"amp", " ", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"x", "-", 
                    RowBox[{"center", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"y", "-", 
                    RowBox[{"center", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "^", "2"}]}], 
                ")"}]}], "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", 
                RowBox[{"width", "^", "2"}]}], ")"}]}], "]"}]}]}], 
          "\[IndentingNewLine]", "      ", "]"}]}], "\[IndentingNewLine]", 
        "    ", "]"}], ",", "\[IndentingNewLine]", "    ", "sources"}], 
      "\[IndentingNewLine]", "  ", "]"}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"effectivePotential2D", "[", 
      RowBox[{"pot_", ",", 
       RowBox[{"\[CapitalOmega]_", "?", "NumericQ"}]}], "]"}], "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"pot", "[", 
      RowBox[{"x", ",", "y"}], "]"}], "-", 
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"\[CapitalOmega]", "^", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"x", "^", "2"}], "+", 
        RowBox[{"y", "^", "2"}]}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"effectiveForce2D", "[", 
      RowBox[{"pot_", ",", 
       RowBox[{"\[CapitalOmega]_", "?", "NumericQ"}]}], "]"}], "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Evaluate", "[", 
     RowBox[{"-", 
      RowBox[{"Grad", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"effectivePotential2D", "[", 
          RowBox[{"pot", ",", "\[CapitalOmega]"}], "]"}], "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"curl2D", "[", "field_", "]"}], "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"field", "[", 
       RowBox[{"[", "2", "]"}], "]"}], ",", "x"}], "]"}], "-", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"field", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", "y"}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"579df1ac-252f-314a-a5f2-7e7a8352f80c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.3 Interpretation", "Subsection",ExpressionUUID->"05ab780e-471f-a047-bcdb-e7358e267809"],

Cell["\<\
The sensory field is not treated as raw metaphysics. It is a testable \
structure in which: \
\>", "Text",ExpressionUUID->"921b656f-9936-374b-9135-2567d0fb3def"],

Cell["sources define local density contrasts,", "Item",ExpressionUUID->"33a030d5-baec-3e49-ac99-7dfd07fbba7e"],

Cell["effective potentials define pockets,", "Item",ExpressionUUID->"077639d9-cf60-fc4e-afc7-0a08f7658978"],

Cell["gradients define force or attention flow,", "Item",ExpressionUUID->"01c36644-e581-1c4d-9983-d38c6302f24e"],

Cell["curl or winding defines circulation structure.", "Item",ExpressionUUID->"c2c02cc8-f25b-af44-87dc-6361c638e85f"],

Cell[TextData[{
 StyleBox["Analogy",
