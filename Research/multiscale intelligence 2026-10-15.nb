Notebook Cell 2: Multi-Property EAV Composite & Clean-Up Memory Retrieval

This tests whether an Entity bound with multiple descriptive properties (e.g. \
`Mass = High`, `Charge = Positive`, `Spin = Half`) can be queried without \
cross-talk crosstalk exceeding the retrieval threshold.

```mathematica
(* ========================================================= *)
(* 2. MULTI-PROPERTY EAV COMPOSITE & CODEBOOK CLEAN-UP TEST   *)
(* ========================================================= *)

ClearAll[CleanUpMemory, CreateCodebook];

(* Exact nearest-neighbor clean-up against a discrete codebook *)
CleanUpMemory[noisyVec_List, codebook_Association] := 
  Module[{sims},
    sims = KeyValueMap[#1 -> CosineSim[noisyVec, #2] &, codebook];
    First @ ReverseSortBy[sims, Last]
  ];

Module[{d = 4096, codebook, eCore, aMass, aCharge, aColor, vHeavy, vPos, \
vGold, entityRepresentation, queryResult, cleaned},
  (* 1. Initialize Codebook Vocabulary *)
  codebook = Association[
    \"Mass\"     -> RandomUnitVector[d],
    \"Charge\"   -> RandomUnitVector[d],
    \"Color\"    -> RandomUnitVector[d],
    \"Heavy\"    -> RandomUnitVector[d],
    \"Light\"    -> RandomUnitVector[d],
    \"Positive\" -> RandomUnitVector[d],
    \"Neutral\"  -> RandomUnitVector[d],
    \"Gold\"     -> RandomUnitVector[d],
    \"Silver\"   -> RandomUnitVector[d]
  ];

  (* 2. Form Composite Descriptive Entity: *)
  (* Entity = (Mass (*) Heavy) + (Charge (*) Positive) + (Color (*) Gold) *)
  entityRepresentation = 
    CircularConvolveHRR[codebook[\"Mass\"], codebook[\"Heavy\"]] +
    CircularConvolveHRR[codebook[\"Charge\"], codebook[\"Positive\"]] +
    CircularConvolveHRR[codebook[\"Color\"], codebook[\"Gold\"]];

  (* 3. Query: \"What is the Charge of this entity?\" *)
  queryResult = CircularCorrelateHRR[codebook[\"Charge\"], \
entityRepresentation];
  
  (* 4. Measure clean-up against vocabulary *)
  Print[\"Querying 'Charge' on multi-property entity:\"];
  Print[\"Raw cosine match to target ('Positive'): \", CosineSim[queryResult, \
codebook[\"Positive\"]]];
  Print[\"Raw cosine match to distractor ('Negative'): \", \
CosineSim[queryResult, RandomUnitVector[d]]];
  
  cleaned = CleanUpMemory[queryResult, codebook];
  Print[\"Clean-Up Winner: \", cleaned];
]
