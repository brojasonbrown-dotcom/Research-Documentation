 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Model 4: emergent-time limit\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"3a13b115-5adc-8745-afc1-17e8e9c3e72c"],
 "\nIf discrete recursion becomes continuous: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", "\[CapitalPsi]"}], 
          RowBox[{"\[PartialD]", "\[Tau]"}]], "\[LongEqual]", "-", 
         StyleBox["M", "TI"], 
         RowBox[{"[", "\[CapitalPsi]", "]"}], "+", 
         StyleBox["F", "TI"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["M", "TI"], 
             RowBox[{"[", "\[CapitalPsi]", "]"}]}], "]"}]}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "\\frac{\\partial \\Psi}{\\partial \\tau}\n=\n-\\mathcal \
M[\\Psi]+\\mathcal F[\\mathcal M[\\Psi]]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ebdccf21-9849-8c4e-9c85-67c7af9230a0"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Tau]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\tau", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "16db297b-3049-2d4f-8530-cdffee9781e2"],
 " is not fundamental time but process depth.\n\nPhysical time then may be: \n\
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["t", "TI"], "\[LongEqual]", 
         StyleBox["t", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Tau]", ",", 
             StyleBox["R", "TI"], ",", "\[Rho]", ",", "\[Chi]"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "t=t(\\tau,R,\\rho,\\chi)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ba791a0f-5f21-6d4b-9de8-5cea767683cc"],
 "\nan emergent observable parameter. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
