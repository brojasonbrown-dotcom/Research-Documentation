   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"1bc862ef-1bc9-5149-8a88-2467861cf82f"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"E. Dimensional octave structure\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"c7da1c6a-ffa7-6342-b64f-6214e8f9155f"],
 "\nYour \[OpenCurlyDoubleQuote]dimensional octaves\[CloseCurlyDoubleQuote] \
idea suggests scale recursion: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], "+", "1"}]], "\[LongEqual]", 
         "\[CapitalLambda]", 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["S", "TI"], 
            StyleBox["k", "TI"]], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal S_{k+1}= \\Lambda(\\mathcal S_k)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7e904dcb-e1c0-c34a-a165-68b1690fc1f0"],
 "\nwith octave-like scaling: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["R", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], "+", "1"}]], "\[LongEqual]", "\[Beta]", 
         SubscriptBox[
          StyleBox["R", "TI"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "R_{k+1}=\\beta R_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ec6e9e0a-685b-b446-a580-e0065b2ced64"],
 "\nfor some factor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Beta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\beta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4418278-261e-5a41-bb84-260d10d75b62"],
 ", maybe 2 in the simplest octave picture.\n\nThen fields decompose by \
scale: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPsi]", "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          StyleBox["k", "TI"], LimitsPositioning -> True], 
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Psi=\\sum_k \\Psi_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "11d7155f-b2d6-f64c-93ca-91dbef709ade"],
 "\nand void/source compensation may happen at each scale: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["k", "TI"]], "\[Rule]", 
         SubscriptBox[
          StyleBox["O", "TI"], 
          StyleBox["k", "TI"]], "\[Rule]", 
         SubscriptBox[
          StyleBox["V", "TI"], 
          StyleBox["k", "TI"]], "\[Rule]", 
         SubscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["k", "TI"], "+", "1"}]], " or ", 
         SubsuperscriptBox["\[CapitalPsi]", 
          StyleBox["k", "TI"], "\[Prime]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Psi_k \\to O_k \\to V_k \\to \\Psi_{k+1} \\text{ or } \\Psi_k'", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d414dbb9-aa39-eb4c-9cc7-0a4b3a004a50"],
