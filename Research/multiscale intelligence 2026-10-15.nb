Notebook Cell 1: HRR Circular Convolution & Exact Unbinding Mechanics

This verifies whether circular convolution (\\(\\circledast\\)) and \
approximate inversion via circular correlation (\\(\\odot\\)) preserve \
orthogonal integrity and signal-to-noise ratio (SNR) as dimension \\(D\\) \
scales.

```mathematica
(* ========================================================= *)
(* 1. HRR CIRCULAR CONVOLUTION & CORRELATION INTEGRITY AUDIT  *)
(* ========================================================= *)

ClearAll[CircularConvolveHRR, CircularCorrelateHRR, CosineSim, \
RandomUnitVector];

(* Generate random Gaussian vectors on the unit sphere in R^D *)
RandomUnitVector[d_Integer] := Normalize[RandomVariate[NormalDistribution[0, \
1], d]];

(* Exact Circular Convolution via FFT: A (*) B *)
CircularConvolveHRR[a_List, b_List] := Re[InverseFourier[Fourier[a] * \
Fourier[b] * Sqrt[Length[a]]]];

(* Approximate Unbinding via Circular Correlation: A (#) C = A (*) Inv(B) *)
CircularCorrelateHRR[query_List, composite_List] := 
  Module[{d = Length[query], invQuery},
    (* Involution in time domain: x[-n mod D] *)
    invQuery = RotateLeft[Reverse[query], 1];
    CircularConvolveHRR[invQuery, composite]
  ];

CosineSim[u_List, v_List] := u . v / (Norm[u] * Norm[v]);

(* Audit over dimensions D = {512, 1024, 2048, 4096, 8192} *)
dimensionSweep = Table[
  Module[{d = dim, entity, attr, val, bound, unbindVal, unbindAttr, simVal, \
simAttr},
    entity = RandomUnitVector[d];
    attr   = RandomUnitVector[d];
    val    = RandomUnitVector[d];
    
    (* Bound pair: Attribute (*) Value *)
    bound = CircularConvolveHRR[attr, val];
    
    (* Unbind Value using Attribute *)
    unbindVal = CircularCorrelateHRR[attr, bound];
    simVal = CosineSim[unbindVal, val];
    
    (* Unbind Attribute using Value *)
    unbindAttr = CircularCorrelateHRR[val, bound];
    simAttr = CosineSim[unbindAttr, attr];
    
    <|\"Dimension\" -> d, 
      \"RecoverValue_CosSim\" -> N[simVal, 4], 
      \"RecoverAttribute_CosSim\" -> N[simAttr, 4],
      \"CrossNoise_CosSim\" -> N[CosineSim[unbindVal, attr], 4]|>
  ],
  {dim, {512, 1024, 2048, 4096, 8192}}
];

Dataset[dimensionSweep]
```

