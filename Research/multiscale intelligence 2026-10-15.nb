      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"7e94732e-2276-f34d-a253-0e31611510e3"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"4. Why this connects to density of spacetime\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"45cc9267-ff8d-4a4f-b638-29e0dcf51184"],
 "\nYou are saying gravity is not just force from mass, but a ",
 StyleBox["restructuring of informational density around bodies",
  FontWeight->Bold],
 ".\n\nSo spacetime density should perhaps be written as: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["D", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["D", "TI"], "0"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", 
         SubscriptBox[
          StyleBox["D", "TI"], "src"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", 
         SubscriptBox[
          StyleBox["D", "TI"], "void"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", 
         SubscriptBox[
          StyleBox["D", "TI"], "meas"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "D(x)=D_0(x)+D_{\\text{src}}(x)+D_{\\text{void}}(x)+D_{\\text{meas}}(x)",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1cb29d4d-b6e6-dd40-9460-7ca701006d82"],
 "\nwhere: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox[
         StyleBox["D", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
      "D_0", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "0ce1f054-b1f0-404f-8a17-0c3fccf23d3c"],
  " = substrate density,"
 }], "InlineItem",ExpressionUUID->"508be299-aa9a-5541-8ea5-c758139af481"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox[
         StyleBox["D", "TI"], "src"], TraditionalForm], "errors" -> {}, 
      "input" -> "D_{\\text{src}}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "662cc415-c018-1345-8206-6101b66a4ae6"],
  " = positive/source concentration,"
 }], "InlineItem",ExpressionUUID->"d8183494-09c7-694a-8a97-741476bee49b"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox[
         StyleBox["D", "TI"], "void"], TraditionalForm], "errors" -> {}, 
      "input" -> "D_{\\text{void}}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "08cf1dcd-c334-ea49-941d-d927a80c1afc"],
  " = opposite-side compensating deficit,"
 }], "InlineItem",ExpressionUUID->"4c96abc7-abac-3e46-bb94-76e8f29afeaf"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox[
         StyleBox["D", "TI"], "meas"], TraditionalForm], "errors" -> {}, 
      "input" -> "D_{\\text{meas}}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "8e601b1f-7092-bf47-bfc1-98d3fcf22152"],
  " = density induced by observation/measurement collapse."
 }], "InlineItem",ExpressionUUID->"5a60ae6b-dab6-0c4d-a37f-91faa80a19a3"],
 "\nThen the gravitational field is not only: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Del]", "\[CapitalPhi]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\nabla \\Phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "71d82130-808e-6a45-8c1b-7f24433ebdbc"],
 "\nbut perhaps: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Del]", 
         SubscriptBox["\[CapitalPhi]", "eff"], "\[LongEqual]", "\[Del]", 
         SubscriptBox["\[CapitalPhi]", "src"], "+", "\[Del]", 
         SubscriptBox["\[CapitalPhi]", "void"], "+", "\[Del]", 
         SubscriptBox["\[CapitalPhi]", "meas"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\nabla \\Phi_{\\text{eff}}=\\nabla \\Phi_{\\text{src}}+\\nabla \\Phi_{\
\\text{void}}+\\nabla \\Phi_{\\text{meas}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "786c39f8-874d-4842-a9f3-108edfd4925c"],
 "\nThis is closer to your idea that: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "attraction is sourced,"
 }], "InlineItem",ExpressionUUID->"8d338462-c6c4-7d4b-9876-4bba2caad0ff"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "but balance/stability is maintained by complementary void generation,"
 }], "InlineItem",ExpressionUUID->"b3cb1a18-466a-2f4f-a627-7073e7247147"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "and the whole thing is recursive."
 }], "InlineItem",ExpressionUUID->"6424d51b-0fe8-5742-8c43-a7210dffdfcd"],
 "\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"bb1210ba-3e34-224a-ab3f-2c1d8df1f7f6"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"5. \[OpenCurlyDoubleQuote]Every time the wave is measured it \
creates a negative void charge again\[CloseCurlyDoubleQuote]\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"ba98e307-d60a-fa47-976b-9c218217deb8"],
 "\nThis is a very important part of your framework.\n\nThat means \
measurement is not just: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPsi]", "\[Rule]", "observable"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Psi \\to \\text{observable}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "685b3da3-8699-e048-ae26-0b3283939b64"],
 "\nIt is: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPsi]", 
         OverscriptBox["\[LongRightArrow]", "M"], 
         StyleBox["O", "TI"], ",    ", 
         StyleBox["O", "TI"], 
         OverscriptBox["\[LongRightArrow]", "V"], "void deficit", ",    ", 
         "void deficit", 
         OverscriptBox["\[LongRightArrow]", "R"], 
         SuperscriptBox["\[CapitalPsi]", "\[Prime]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Psi \\xrightarrow{\\mathcal M} O,\\qquad O \\xrightarrow{\\mathcal V} \
\\text{void deficit},\\qquad \\text{void deficit} \\xrightarrow{\\mathcal R} \
\\Psi'", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ff21a248-f4bf-e949-9873-9680f890c12d"],
 "\nSo measurement creates a residual deficit requiring renewed informational \
filling.\n\nThis is a cyclic ontology: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["n", "TI"]], "\[Rule]", 
         SubscriptBox[
          StyleBox["O", "TI"], 
          StyleBox["n", "TI"]], "\[Rule]", 
         SubscriptBox[
          StyleBox["V", "TI"], 
          StyleBox["n", "TI"]], "\[Rule]", 
         SubscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["n", "TI"], "+", "1"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Psi_n \\to O_n \\to V_n \\to \\Psi_{n+1}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "21be5d47-4caa-e847-b4d1-9cfd0644f540"],
 "\nwhere: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox["\[CapitalPsi]", 
         StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
      "\\Psi_n", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "51289c01-584b-fa48-83e6-3436e10f4213"],
  " = pre-measurement field state,"
 }], "InlineItem",ExpressionUUID->"78904f3a-e626-bd44-a66b-9f5bcb275652"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox[
         StyleBox["O", "TI"], 
         StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
      "O_n", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "87d3d26a-df0a-7e49-a9b3-65f85616ada7"],
  " = realized measured structure,"
 }], "InlineItem",ExpressionUUID->"0301ee55-dd63-e34e-83cf-b935e80dec59"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox[
         StyleBox["V", "TI"], 
         StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
      "V_n", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "5a50132f-6c89-e543-92b6-dff8fb624425"],
  " = induced negative/void complement,"
 }], "InlineItem",ExpressionUUID->"5ab4baf2-791c-564d-85a8-ef8c637a08ad"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox["\[CapitalPsi]", 
         RowBox[{
           StyleBox["n", "TI"], "+", "1"}]], TraditionalForm], "errors" -> {},
       "input" -> "\\Psi_{n+1}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "dc4b2535-57b4-f347-bf6a-565448e47b53"],
  " = field reconfiguration to restore completeness."
 }], "InlineItem",ExpressionUUID->"1deb2ba5-1a48-234c-b888-1d5b8f24aed0"],
 "\nThen ",
 StyleBox["time",
  FontWeight->Bold],
 " is not fundamental. It is the ordered index of repeated compensation: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[RightTeeArrow]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["n", "TI"]], ",", 
             SubscriptBox[
              StyleBox["O", "TI"], 
              StyleBox["n", "TI"]], ",", 
             SubscriptBox[
              StyleBox["V", "TI"], 
              StyleBox["n", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "n \\mapsto (\\Psi_n,O_n,V_n)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c9a7f651-0e01-9840-b57a-59d3f94fa44d"],
 "\nSo emergent time is a bookkeeping of recursive imbalance-restoration \
events.\n\nThat is a strong formal idea. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"dab6413b-3bb9-8b42-a4e7-681a8814658f"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"6. Best mathematical structures for this intuition\"\>", 
    "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"042bdcb0-2a24-c94a-8dfc-7609e99a6ed7"],
 "\nYour concept suggests the following structures. \n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"A. Signed informational density field\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"fa203e6c-2dd0-f846-946b-fa8d0801af0a"],
 "\nDefine: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", "tot"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SubscriptBox["\[Rho]", "+"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "-", 
         SubscriptBox["\[Rho]", "-"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho_{\\text{tot}}(x)=\\rho_+(x)-\\rho_-(x)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7c77a98b-8e0c-6b46-802f-c578bce90cb1"],
 "\nwhere: \n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox["\[Rho]", "+"], TraditionalForm], "errors" -> {}, 
      "input" -> "\\rho_+", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "e84a77ae-a12a-c44d-8873-664049df838d"],
  " = source/information concentration,"
 }], "InlineItem",ExpressionUUID->"e99077eb-216d-4e4e-b878-6630c56bb94f"],
 "\n",
 Cell[TextData[{
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  Cell[BoxData[
   FormBox[
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox["\[Rho]", "-"], TraditionalForm], "errors" -> {}, 
      "input" -> "\\rho_-", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
   "c6922e6a-691c-c142-a589-777dcf381b24"],
  " = void/complement density."
 }], "InlineItem",ExpressionUUID->"bf7af61c-413a-4745-886a-ec09de45bcc3"],
 "\nConstraint: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", "-"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[NotEqual]", 
         "ordinary negative matter"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho_-(x)\\neq \\text{ordinary negative matter}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "59dd9ba4-f7bb-3d40-bed8-5a7f6f5239ec"],
 "\nIt is instead: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", "-"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["C", "TI"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox["\[Rho]", "+"], ",", 
             StyleBox["R", "TI"], ",", 
             StyleBox["M", "TI"], ",", "geometry"}], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho_-(x)=\\mathcal C[\\rho_+,R,\\mathcal M,\\text{geometry}]", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8445faf2-b006-c04f-8bee-0cea127d57e0"],
 "\na compensator functional. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"b617e8d7-b492-ea4d-91bd-faeee906c999"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"B. Relational anisotropy tensor\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"85870b23-8db8-d94c-af49-2fe05fea6e07"],
 "\nNeighbor-relative distortion should not be scalar only. Define: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          StyleBox["k", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["w", "TI"], 
          StyleBox["k", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], " ", 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["d", "TI"], "^"], 
          StyleBox["i", "TI"], 
          RowBox[{"(", 
            StyleBox["k", "TI"], ")"}]], 
         SubsuperscriptBox[
          OverscriptBox[
           StyleBox["d", "TI"], "^"], 
          StyleBox["j", "TI"], 
          RowBox[{"(", 
            StyleBox["k", "TI"], ")"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "A_{ij}(x)=\\sum_k w_k(x)\\,\\hat d_i^{(k)}\\hat d_j^{(k)}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d5dc5ec5-44a1-1d4c-9f2d-7f34eaf2ec89"],
 "\nwhere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        OverscriptBox[
         StyleBox["d", "TI"], "^"], 
        RowBox[{"(", 
          StyleBox["k", "TI"], ")"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat d^{(k)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b893a12c-bbda-7749-a0f6-ffc8eb090acf"],
 " points toward neighboring bodies.\n\nThis tensor measures directional \
loading of the field and can generate opposite-side void lobes. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
