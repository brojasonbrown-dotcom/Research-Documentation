 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"9. Training structure we should use\"\>", "Title",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->26],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"20a06234-119f-b54d-81f5-357d049a40d1"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Classification training data form\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"91b5ca1a-ba17-d540-99d6-89be1a5a9d5c"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{"trainPairs", "=", 
          RowBox[{"Rule", " ", "@@@", " ", 
            RowBox[{"(", 
              RowBox[{
                RowBox[{
                  RowBox[{"split", "[", "\"Train\"", "]"}], "[", 
                  RowBox[{"[", 
                    RowBox[{"All", ",", 
                    RowBox[{"{", 
                    RowBox[{"\"Input\"", ",", "\"Target\""}], "}"}]}], "]"}], 
                  "]"}], " ", "/.", " ", 
                RowBox[{"Association", "->", "List"}]}], ")"}]}]}], ";"}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "daad7bae-1052-ba44-a96b-0b9ea0e5ce9b"],
 "\nBut safer and clearer is: \n",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     BoxData[
      RowBox[{
        RowBox[{
          RowBox[{"trainPairs", "=", 
            RowBox[{
              RowBox[{
                RowBox[{"(", 
                  RowBox[{"#Input", "->", "#Target"}], ")"}], " ", "&"}], " ",
               "/@", " ", 
              RowBox[{"split", "[", "\"Train\"", "]"}]}]}], ";"}], 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"valPairs", "=", 
            RowBox[{
              RowBox[{
                RowBox[{"(", 
                  RowBox[{"#Input", "->", "#Target"}], ")"}], " ", "&"}], " ",
               "/@", " ", 
              RowBox[{"split", "[", "\"Validation\"", "]"}]}]}], ";"}], 
        "\[IndentingNewLine]", 
        RowBox[{
          RowBox[{"testPairs", "=", 
            RowBox[{
              RowBox[{
                RowBox[{"(", 
                  RowBox[{"#Input", "->", "#Target"}], ")"}], " ", "&"}], " ",
               "/@", " ", 
              RowBox[{"split", "[", "\"Test\"", "]"}]}]}], ";"}]}]], 
     "ChatCode", "Input", LanguageCategory -> "Input", ShowAutoStyles -> True,
      ShowStringCharacters -> True, ShowSyntaxStyles -> True, 
     TranslationOptions -> {"Enabled" -> Dynamic[
         AbsoluteCurrentValue[$FrontEnd, {TranslationOptions, "Enabled"}]]}], 
    "Wolfram"},
   "ChatCodeBlockTemplate"]], "ChatCodeBlock",ExpressionUUID->
  "d714952b-6900-6240-b551-935b4b40f04a"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Regression training data form\"\>", "Section",
