                  StripOnInput->False,
                  
                  FontColor->RGBColor[
                   0.53214525, 0.6238195470000001, 0.67275]], 
                 StyleBox["\<\"Create Notebook\"\>",
                  StripOnInput->False,
                  FontWeight->"DemiBold",
                  
                  FontColor->RGBColor[
                   0.53214525, 0.6238195470000001, 0.67275]], 
                 PaneSelectorBox[{True->
