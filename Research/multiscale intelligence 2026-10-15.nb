           RowBox[{"(", 
             StyleBox["x", "TI"], ")"}]}], "}"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\{\\rho(x),\\nu(x),A(x),R(x),\\Psi(x)\\}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5ac23534-1cb3-194d-b1f8-fdf062753a2c"],
