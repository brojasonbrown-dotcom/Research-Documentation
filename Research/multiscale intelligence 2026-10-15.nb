             RowBox[{"(", 
               StyleBox["x", "TI"], ")"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\nabla^2 \\Phi(x)=4\\pi G\\,(\\rho(x)-\\nu(x))", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "84c841f6-6910-7d40-955d-63c8d1e017c4"],
 "\nThen define void density relationally: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Nu]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "\[Integral]", 
         StyleBox["K", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"], ";", 
