Cell[CellGroupData[{

Cell["10. Neural-network-ready field encoding", "Section",ExpressionUUID->"ef09c53b-c21e-bc42-8a23-37bc7e3498f6"],

Cell[CellGroupData[{

Cell["10.1 Objective", "Subsection",ExpressionUUID->"37ba39f3-5bf2-f640-9634-517b669bd834"],

Cell["\<\
We need a map from sensory-field structure to a finite-dimensional \
representation usable by a neural net.\
\>", "Text",ExpressionUUID->"466de957-52a4-1645-a65f-cf203b13df8b"],

Cell[TextData[{
 "Let the encoder be: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], ":", 
         StyleBox["F", "TI"], "\[Rule]", 
         SuperscriptBox[
          StyleBox["R", FontSlant -> "Plain"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "E: \\mathcal{F} \\to \\mathbb{R}^n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "97fddde4-5093-784b-8b82-36712cd3122d"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["F", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{F}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4777cc2f-1b5b-d246-ba36-2aef595915e3"],
 " is a field state space and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["R", FontSlant -> "Plain"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbb{R}^n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "00cc6936-3c48-444d-804e-da67339fc78d"],
 " is a latent vector or tensor space. "
}], "Text",ExpressionUUID->"81f252c6-f2eb-ff4d-8d36-3f3b85f30159"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.2 Field feature extractor", "Subsection",ExpressionUUID->"060874df-efd8-5846-a538-ca0f9d93231e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "fieldFeatureVector", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fieldFeatureVector", "[", "state_List", "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Length\>\"", "->", 
      RowBox[{"Length", "[", "state", "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<Norm2\>\"", "->", 
      RowBox[{"Norm", "[", 
       RowBox[{"state", ",", "2"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Norm1\>\"", "->", 
      RowBox[{"Norm", "[", 
       RowBox[{"state", ",", "1"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Mean\>\"", "->", 
      RowBox[{"Mean", "[", "state", "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Variance\>\"", "->", 
      RowBox[{"Variance", "[", "state", "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<FixedScaleResidual\>\"", "->", 
      RowBox[{"fixedScaleResidual", "[", "state", "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<ScaleResidualMean\>\"", "->", 
      RowBox[{"Mean", "[", 
       RowBox[{"scaleResiduals", "[", 
        RowBox[{"state", ",", 
         RowBox[{"Min", "[", 
          RowBox[{"8", ",", 
           RowBox[{
            RowBox[{"Log2", "[", 
             RowBox[{"Length", "[", "state", "]"}], "]"}], "-", "1"}]}], 
          "]"}]}], "]"}], "]"}]}]}], "\[IndentingNewLine]", "|>"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"6894d3fd-8c6e-fd43-9d13-667a827a67da"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.3 Tensor encoder for arrays", "Subsection",ExpressionUUID->"de2f0f40-432d-8347-96d5-33d7770ff141"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "fieldArrayEncoder", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fieldArrayEncoder", "[", 
    RowBox[{"array_", "?", "ArrayQ"}], "]"}], ":=", 
   RowBox[{"N", " ", "@", " ", 
    RowBox[{"Flatten", "[", "array", "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[51]:=",ExpressionUUID->"2a4b8fec-7615-4b4a-853c-72124a4c6766"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.4 Interpretation", "Subsection",ExpressionUUID->"6cc456b9-8f30-9f43-a851-103d1d1ba7cc"],

Cell["This is the first rigorous bridge: ", "Text",ExpressionUUID->"5bb26d0a-7712-8943-a4c8-a265b2641e70"],

Cell["sensory field dynamics generate structured states,", "Item",ExpressionUUID->"4799b169-77b1-de4e-a363-12f6d5bc9102"],

Cell["RHUFT tests whether they are stable across resolution,", "Item",ExpressionUUID->"197d7e8d-6bb2-ca4a-91e8-f00b24d3a73e"],

Cell["stable states are encoded into vectors/tensors,", "Item",ExpressionUUID->"c7f7a85f-0dc2-194f-a79b-1ceeb388ca91"],

Cell["those vectors become neural network inputs.", "Item",ExpressionUUID->"46cc5abe-f555-5340-9493-6536658200a9"],

Cell["\<\
So a sensory field becomes \[OpenCurlyDoubleQuote]resolution usable\
\[CloseCurlyDoubleQuote] when its latent summary remains stable enough for \
learned processing. \
\>", "Text",ExpressionUUID->"9921711b-bcfe-8142-b1ec-019e4c769469"],

