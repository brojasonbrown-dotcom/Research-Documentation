 }], "InlineSubitem",ExpressionUUID->"e312ce4a-2de0-3048-8504-314437f86dc8"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "recover with correlation"
 }], "InlineSubitem",ExpressionUUID->"9d57d17a-defb-4d40-b153-bd14503012a8"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "measure cosine similarity to target"
 }], "InlineSubitem",ExpressionUUID->"3cb3da69-a950-db40-b10e-76e9d2ad4936"],
 "\n",
 Cell[TextData[{
  "   ",
  StyleBox["\[Bullet]",
   FontColor->LightDarkSwitched[
     GrayLevel[0.5], 
     GrayLevel[0.7533742]]],
  " ",
  "measure similarity to distractor"
 }], "InlineSubitem",ExpressionUUID->"8c526835-164e-b241-9f58-651d577a6879"],
 "\n4. ",
