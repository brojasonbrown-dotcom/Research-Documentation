                 StyleBox["M", "TI"], 
                 RowBox[{"[", 
                   SubscriptBox["\[CapitalPsi]", 
                    StyleBox["n", "TI"]], "]"}]}], ")"}]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Psi_{n+1}=\\mathcal R\\!\\left(\\mathcal V\\!\\left(\\mathcal \
M[\\Psi_n]\\right)\\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "54779a46-4d66-db46-9381-ecbecd4377be"],
 "\nand continuum time appears only as an effective limit. \n",
