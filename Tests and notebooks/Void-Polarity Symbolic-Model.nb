Cell[CellGroupData[{

Cell["14. First concrete reduced model to implement next", "Section",ExpressionUUID->"35f10b3f-4672-e64a-927b-69812c4b2e8c"],

Cell[TextData[{
 "This is the most practical reduced system to analyze first: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{
                    SubscriptBox["\[PartialD]", "\[Tau]"], "\[Rho]"}]], 
                 "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", 
                    SubscriptBox[
                    StyleBox["d", "TI"], "\[Rho]"], " ", 
                    SubsuperscriptBox["\[PartialD]", 
                    StyleBox["x", "TI"], "2"], "\[Rho]", "+", 
                    SubscriptBox[
                    StyleBox["f", "TI"], "\[Rho]"], 
                    RowBox[{"(", 
                    RowBox[{"\[Rho]", ",", "\[Nu]", ",", 
                    StyleBox["A", "TI"], ",", 
                    StyleBox["R", "TI"]}], ")"}], ","}]], "InlineFormula"], 
                " "}]]}, {
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{
                    SubscriptBox["\[PartialD]", "\[Tau]"], "\[Nu]"}]], 
                 "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", 
                    SubscriptBox[
                    StyleBox["d", "TI"], "\[Nu]"], " ", 
                    SubsuperscriptBox["\[PartialD]", 
                    StyleBox["x", "TI"], "2"], "\[Nu]", "+", 
                    SubscriptBox[
                    StyleBox["f", "TI"], "\[Nu]"], 
                    RowBox[{"(", 
                    RowBox[{"\[Rho]", ",", "\[Nu]", ",", 
                    StyleBox["A", "TI"], ",", 
                    StyleBox["R", "TI"], ",", 
                    StyleBox["M", "TI"], 
                    RowBox[{"[", "\[CapitalPsi]", "]"}]}], ")"}], ","}]], 
                 "InlineFormula"], " "}]]}, {
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{
                    SubscriptBox["\[PartialD]", "\[Tau]"], "\[CapitalPsi]"}]],
                  "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", 
                    SubscriptBox[
                    StyleBox["f", "TI"], "\[CapitalPsi]"], 
                    RowBox[{"(", 
                    RowBox[{"\[Rho]", ",", "\[Nu]", ",", 
                    StyleBox["A", "TI"], ",", 
                    StyleBox["R", "TI"]}], ")"}], "-", 
                    StyleBox["M", "TI"], 
                    RowBox[{"[", "\[CapitalPsi]", "]"}], "+", 
                    StyleBox["R", "TI"], 
                    RowBox[{"[", 
                    RowBox[{
                    StyleBox["M", "TI"], 
                    RowBox[{"[", "\[CapitalPsi]", "]"}]}], "]"}], ","}]], 
                 "InlineFormula"], " "}]]}, {
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{
                    StyleBox["D", "TI"], "(", 
                    StyleBox["x", "TI"], ")"}]], "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", "\[Rho]", 
                    RowBox[{"(", 
                    StyleBox["x", "TI"], ")"}], "-", "\[Nu]", 
                    RowBox[{"(", 
                    StyleBox["x", "TI"], ")"}], ","}]], "InlineFormula"], 
                " "}]]}, {
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{
                    SubsuperscriptBox["\[PartialD]", 
                    StyleBox["x", "TI"], "2"], "\[CapitalPhi]"}]], 
                 "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", 
                    SubscriptBox[
                    StyleBox["c", "TI"], "\[Phi]"], 
                    StyleBox["D", "TI"], 
                    RowBox[{"(", 
                    StyleBox["x", "TI"], ")"}], "."}]], "InlineFormula"], 
                " "}]]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}\n\\partial_\\tau \\rho &= d_\\rho\\,\\partial_x^2\\rho \
+ f_\\rho(\\rho,\\nu,A,R),\\\\\n\\partial_\\tau \\nu &= \
d_\\nu\\,\\partial_x^2\\nu + f_\\nu(\\rho,\\nu,A,R,\\mathcal M[\\Psi]),\\\\\n\
\\partial_\\tau \\Psi &= f_\\Psi(\\rho,\\nu,A,R)-\\mathcal M[\\Psi]+\\mathcal \
R[\\mathcal M[\\Psi]],\\\\\nD(x) &= \\rho(x)-\\nu(x),\\\\\n\\partial_x^2 \
\\Phi &= c_\\phi D(x).\n\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a98d5207-03d9-2549-9623-e2023a191250"],
 "This is the right first rigorous notebook milestone. "
}], "Text",ExpressionUUID->"3bf2117b-03ec-7046-b635-3a488882846a"],

