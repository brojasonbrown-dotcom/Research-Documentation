Cell[CellGroupData[{

Cell["11. Effective potential layer", "Section",ExpressionUUID->"e12e9892-b03e-204c-b6c0-0fadffc1fdcb"],

Cell[TextData[{
 "A minimal potential sourced by signed informational density can be \
represented as: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Del]", "2"], "\[CapitalPhi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["C", "TI"], " ", 
         RowBox[{"(", 
           RowBox[{"\[Rho]", 
             RowBox[{"(", 
               StyleBox["x", "TI"], ")"}], "-", "\[Nu]", 
             RowBox[{"(", 
               StyleBox["x", "TI"], ")"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\nabla^2\\Phi(x)=C\\,(\\rho(x)-\\nu(x))", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "86a6e4cb-2569-af42-ae34-79de803907c0"]
}], "Text",ExpressionUUID->"72e09ac1-1fd1-c84a-9773-36e51f8d0e9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"effectivePotentialEquation", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"Laplacian", "[", 
     RowBox[{
      RowBox[{"effectivePotential", "[", "x", "]"}], ",", 
      RowBox[{"{", "x", "}"}]}], "]"}], "==", 
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"c", ",", "phi"}], "]"}], " ", 
     RowBox[{"totalDensity", "[", "x", "]"}]}]}]}], ";"}]], "Input",Expression\
UUID->"d4d740b6-8014-5042-baf9-abb75df02db2"],

Cell["\<\
This lets gravitational-like attraction and opposite-side void structure \
enter through a shared source term. \
\>", "Text",ExpressionUUID->"5be11199-2ad5-9c4d-86ae-46a5e1434489"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"2439586d-9288-394d-a2c2-03d47c7d781c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12. Minimal action extension", "Section",ExpressionUUID->"f0c60484-1c92-4646-a9c4-e87838262833"],

Cell[TextData[{
 "A first OPF extension of the previous action may be written symbolically \
as: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], "\[LongEqual]", "\[Integral]", 
         StyleBox["L", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Nu]", ",", 
             StyleBox["A", "TI"], ",", 
             StyleBox["R", "TI"], ",", "\[CapitalPsi]"}], ")"}], 
         "\[DifferentialD]", "\[CapitalOmega]"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "S=\\int \\mathcal L(\\rho,\\nu,A,R,\\Psi)\\,d\\Omega", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ad7254e7-850b-d04a-9c0f-fd8e6d77fb9d"],
 "with prototype density ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", "\[Rho]", "log", 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox["\[Chi]", "\[Rho]"]}], ")"}], "-", "\[Nu]", "log", 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox["\[Chi]", "\[Nu]"]}], ")"}], "+", "\[Alpha] ", 
         SuperscriptBox[
          StyleBox["A", "TI"], "2"], "+", "\[Beta] ", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "+", "\[Gamma] ", 
         SuperscriptBox["\[CapitalPsi]", "2"], "+", "\[Eta] ", 
         "\[Rho]\[Nu]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal L = \\rho\\log(1+\\chi_\\rho) - \\nu\\log(1+\\chi_\\nu) + \
\\alpha\\,A^2 + \\beta\\,R^2 + \\gamma\\,\\Psi^2 + \\eta\\,\\rho\\nu", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a374d9d7-420e-ed4a-97cf-031ae2c9007f"],
 "This is only a placeholder scaffold to be refined. "
}], "Text",ExpressionUUID->"d1839739-2e17-1847-bddf-2cdb571597a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"lagrangianDensity", "[", "x_", "]"}], ":=", "\[IndentingNewLine]",
    "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"rho", "[", "x", "]"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"chi", ",", "rho"}], "]"}], "[", "x", "]"}]}], "]"}]}], "-", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"nu", "[", "x", "]"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"chi", ",", "nu"}], "]"}], "[", "x", "]"}]}], "]"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"alpha", ",", "a"}], "]"}], " ", 
     RowBox[{
      RowBox[{"anisotropy", "[", "x", "]"}], "^", "2"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"beta", ",", "r"}], "]"}], " ", 
     RowBox[{
      RowBox[{"resolution", "[", "x", "]"}], "^", "2"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"gamma", ",", "psi"}], "]"}], " ", 
     RowBox[{
      RowBox[{"psi", "[", "x", "]"}], "^", "2"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Subscript", "[", 
      RowBox[{"eta", ",", "rhonu"}], "]"}], " ", 
     RowBox[{"rho", "[", "x", "]"}], " ", 
     RowBox[{"nu", "[", "x", "]"}]}]}]}], ";"}]], "Input",ExpressionUUID->\
"e857d492-e4c7-c346-8c98-59b0526bf62b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"action", "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"lagrangianDensity", "[", "x", "]"}], ",", "x"}], "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"9eb8dced-477a-8a42-8603-e3501633d072"],

