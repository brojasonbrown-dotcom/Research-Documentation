 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"aa544d19-7dff-a64f-b715-9e473c3f3dae"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Field definitions", "Section",ExpressionUUID->"4772ba6f-0173-bd49-9574-0d1216d7198f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fields", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<PositiveDensity\>\"", "->", "rho"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<VoidDensity\>\"", "->", "nu"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<AnisotropyField\>\"", "->", "anisotropy"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<ResolutionField\>\"", "->", "resolution"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<TotalField\>\"", "->", "psi"}]}], "\[IndentingNewLine]", 
    "|>"}]}], ";"}]], "Input",ExpressionUUID->"a4db32de-7500-2441-8433-\
deab20e32681"],

Cell[TextData[{
 "A minimal algebraic relation for total effective density is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["D", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "\[Rho]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "-", "\[Nu]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "D(x)=\\rho(x)-\\nu(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "50aac49c-57a4-0242-96a7-282d7f2f1820"]
}], "Text",ExpressionUUID->"17de3bf0-5f4e-f14b-8c38-1d562a62526f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"totalDensity", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"rho", "[", "x", "]"}], "-", 
    RowBox[{"nu", "[", "x", "]"}]}]}], ";"}]], "Input",ExpressionUUID->\
"94d67920-c549-2645-9f97-72ef84144bac"],

Cell[TextData[{
 "A first minimal decomposition for the total field can be recorded \
symbolically as: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPsi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "\[CapitalPsi]", 
         RowBox[{"[", 
           RowBox[{"\[Rho]", 
             RowBox[{"(", 
               StyleBox["x", "TI"], ")"}], ",", "\[Nu]", 
             RowBox[{"(", 
               StyleBox["x", "TI"], ")"}], ",", 
             StyleBox["A", "TI"], 
             RowBox[{"(", 
               StyleBox["x", "TI"], ")"}], ",", 
             StyleBox["R", "TI"], 
             RowBox[{"(", 
               StyleBox["x", "TI"], ")"}]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Psi(x)=\\Psi[\\rho(x),\\nu(x),A(x),R(x)]", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "436f672f-0465-5b4c-b8f3-2b105a1204e3"]
}], "Text",ExpressionUUID->"d5995673-8567-c145-9c7b-26c5a1b788e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"psiRepresentation", "=", 
   RowBox[{
    RowBox[{"psi", "[", "x", "]"}], "==", 
    RowBox[{"psi", "[", 
     RowBox[{
      RowBox[{"rho", "[", "x", "]"}], ",", 
      RowBox[{"nu", "[", "x", "]"}], ",", 
      RowBox[{"anisotropy", "[", "x", "]"}], ",", 
      RowBox[{"resolution", "[", "x", "]"}]}], "]"}]}]}], ";"}]], "Input",Expr\
essionUUID->"b630ac29-0766-d843-b7bd-ec994f65b048"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
