    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"c850ec2c-bfed-3545-a3b5-36504a462b9d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Recursive update law", "Section",ExpressionUUID->"556103b9-0b15-1740-a095-2a1586d69db4"],

Cell[TextData[{
 "A discrete process-depth model expresses emergent time as iterative \
compensation: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["n", "TI"], "+", "1"}]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "-", 
         StyleBox["M", "TI"], 
         RowBox[{"[", 
           SubscriptBox["\[CapitalPsi]", 
            StyleBox["n", "TI"]], "]"}], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", 
         StyleBox["R", "TI"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["M", "TI"], 
             RowBox[{"[", 
               SubscriptBox["\[CapitalPsi]", 
                StyleBox["n", "TI"]], "]"}]}], "]"}], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\Psi_{n+1}(x)=\\Psi_n(x)-\\mathcal M[\\Psi_n](x)+\\mathcal R[\\mathcal \
M[\\Psi_n]](x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "968d11f3-4942-da4d-968e-4ff1dfa26b93"]
}], "Text",ExpressionUUID->"e6c59416-c75f-824c-a493-a36565993e5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"recursiveUpdate", "[", "x_", "]"}], ":=", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{
    RowBox[{"psi", "[", 
     RowBox[{
      RowBox[{"n", "+", "1"}], ",", "x"}], "]"}], "==", "\[IndentingNewLine]",
     "    ", 
    RowBox[{
     RowBox[{"psi", "[", 
      RowBox[{"n", ",", "x"}], "]"}], "-", 
     RowBox[{"measurementOperator", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"psi", "[", 
         RowBox[{"n", ",", "#"}], "]"}], " ", "&"}], ",", "x"}], "]"}], "+", 
     "\[IndentingNewLine]", "      ", 
     RowBox[{"restorationOperator", "[", 
      RowBox[{
       RowBox[{"measurementOperator", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"psi", "[", 
           RowBox[{"n", ",", "#"}], "]"}], " ", "&"}], ",", "x"}], "]"}], ",",
        "x"}], "]"}]}]}]}], ";"}]], "Input",ExpressionUUID->"0050759f-09d6-\
0f4a-8427-5d8dc0dbc1da"],

Cell["\<\
A more state-complete update can also evolve the component fields: \
\>", "CodeText",ExpressionUUID->"c961e608-3e68-0849-961a-bc54c6e4e0db"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"opfState", "[", 
    RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<rho\>\"", "->", 
      RowBox[{"rho", "[", 
       RowBox[{"n", ",", "x"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<nu\>\"", "->", 
      RowBox[{"nu", "[", 
       RowBox[{"n", ",", "x"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<anisotropy\>\"", "->", 
      RowBox[{"anisotropy", "[", 
       RowBox[{"n", ",", "x"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<resolution\>\"", "->", 
      RowBox[{"resolution", "[", 
       RowBox[{"n", ",", "x"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<psi\>\"", "->", 
      RowBox[{"psi", "[", 
       RowBox[{"n", ",", "x"}], "]"}]}]}], "\[IndentingNewLine]", "|>"}]}], 
  ";"}]], "Input",ExpressionUUID->"9da42fd6-7a54-954c-8226-5a7298092c03"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"updateOperator", "[", 
    RowBox[{"state_", ",", "input_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"updateOperator", "[", 
    RowBox[{"state", ",", "input", ",", "x"}], "]"}]}], ";"}]], "Input",Expres\
sionUUID->"fc3f4b7d-0b73-124d-9db5-a80fea7ab8ce"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"opfInput", "[", 
    RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Neighbors\>\"", "->", "neighborConfiguration"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<MeasurementEvent\>\"", "->", 
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"m", ",", "n"}], "]"}], "[", "x", "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<ExternalConstraint\>\"", "->", 
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"u", ",", "n"}], "]"}], "[", "x", "]"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",ExpressionUUID->\
"819016d3-f3cc-4b4b-9556-73cecbf0650b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"opfOutput", "[", 
    RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<TotalDensity\>\"", "->", 
      RowBox[{"totalDensity", "[", "x", "]"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<MeasuredField\>\"", "->", 
      RowBox[{"measurementOperator", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"psi", "[", 
          RowBox[{"n", ",", "#"}], "]"}], " ", "&"}], ",", "x"}], "]"}]}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<RestoredField\>\"", "->", 
      RowBox[{"restorationOperator", "[", 
       RowBox[{
        RowBox[{"measurementOperator", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"psi", "[", 
            RowBox[{"n", ",", "#"}], "]"}], " ", "&"}], ",", "x"}], "]"}], ",",
         "x"}], "]"}]}]}], "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",Ex\
pressionUUID->"4681ec1a-1ad4-3d47-a814-82438017ea15"],

