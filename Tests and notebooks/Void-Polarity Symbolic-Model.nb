Cell[CellGroupData[{

Cell["13. Immediate rigorous notebook update plan", "Section",ExpressionUUID->"16c73983-fb93-b548-b9cf-da590117dd75"],

Cell["The notebook should now be developed in this order: ", "Text",ExpressionUUID->"5f7dd001-c9c3-7548-bf4b-2eb19680d7c8"],

Cell[CellGroupData[{

Cell["Step A. Define assumptions", "Subsection",ExpressionUUID->"84a07eaf-8f00-1741-96ac-02368e1c7d27"],

Cell["Specify admissibility conditions such as: ", "CodeText",ExpressionUUID->"437bb0ab-9b3d-7c46-9168-8421f839e8b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"assumptions", "=", 
   RowBox[{"{", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"rho", "[", "x", "]"}], ">=", "0"}], ",", "\[IndentingNewLine]",
      "  ", 
     RowBox[{
      RowBox[{"nu", "[", "x", "]"}], ">=", "0"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{
      RowBox[{"resolution", "[", "x", "]"}], ">", "0"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"anisotropy", "[", "x", "]"}], ",", "Reals"}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"psi", "[", "x", "]"}], ",", "Reals"}], "]"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",ExpressionUUID->"574ab24d-\
1565-5040-a64c-f46c29a03562"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Step B. Decide representation of anisotropy", "Subsection",ExpressionUUID->"95546069-637f-774e-969b-f387bc9e9650"],

Cell["Choose one of: ", "Text",ExpressionUUID->"5cefff8a-98cf-504e-9028-f594708f0836"],

Cell["scalar field", "Item",ExpressionUUID->"3cc1d9ff-4cc9-d848-bcce-3b7e97841847"],

Cell["vector field", "Item",ExpressionUUID->"a92ed9ae-8eeb-cd48-bee8-70bfc6326ef9"],

Cell["tensor field", "Item",ExpressionUUID->"d1784062-f748-a34d-9a8e-014190a82cd1"],

Cell["For first pass, use scalar or vector. ", "Text",ExpressionUUID->"bf804912-e726-5f46-98dc-f4c39fe6ed59"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Step C. Decide domain", "Subsection",ExpressionUUID->"88160096-5392-fd42-a35d-6e030d5efe8b"],

Cell["Choose one of: ", "Text",ExpressionUUID->"255d820d-c6f7-9e4f-bf6c-f610dc4a89b9"],

Cell["1D symbolic line", "Item",ExpressionUUID->"fc1def90-ab25-f548-84c4-fe8c69507fa8"],

Cell["radial domain", "Item",ExpressionUUID->"139a9934-602a-8e45-a45f-e6a17346c86b"],

Cell["sphere", "Item",ExpressionUUID->"c72b4f69-d0b3-2549-a00f-637269fd8e7b"],

Cell["full 3D domain", "Item",ExpressionUUID->"5d7e66ec-3c45-694f-8fcf-bf54b95a9696"],

Cell[TextData[{
 "For first rigorous derivation, start with ",
 StyleBox["1D or radial",
  FontWeight->Bold],
 ". "
}], "Text",ExpressionUUID->"91cbe225-6379-5f4e-9f01-a2985c85bb0b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Step D. Pick one exact prototype", "Subsection",ExpressionUUID->"7dedd879-1345-a94f-921d-fc21367d6b79"],

Cell["Best starting prototype: ", "Text",ExpressionUUID->"2b23e3e3-6612-e247-983e-824fd897260c"],

Cell["1 spatial variable", "Item",ExpressionUUID->"eb535792-d8da-1b44-8ba7-896dba591207"],

Cell[TextData[{
 "continuous process-depth variable ",
 StyleBox["tau", "TI"]
}], "Item",ExpressionUUID->"8aaa0ee3-caa9-ce40-9f43-7dfa9678159b"],

Cell["explicit kernel-free operators", "Item",ExpressionUUID->"8c04ed00-ef40-c643-8293-b8f89133f831"],

Cell["no numerical approximation yet", "Item",ExpressionUUID->"6603be28-c363-a043-b72b-73ad91463437"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Step E. Derive Euler equations", "Subsection",ExpressionUUID->"647f1d8d-5241-4846-9945-53c58b5b5dff"],

Cell[TextData[{
 "Use the action only after deciding whether ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalPsi]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Psi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "14743049-5cd8-df41-85df-a4568d947d37"],
 " is independent or derived from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", ",", "\[Nu]", ",", 
         StyleBox["A", "TI"], ",", 
         StyleBox["R", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho,\\nu,A,R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2868bd6f-258b-de41-bf64-bf95e225a3d0"],
 ". "
}], "Text",ExpressionUUID->"4769d220-814a-be4b-9fc2-39cbac6448d0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Step F. Build tests", "Subsection",ExpressionUUID->"9dcdfc87-468c-0146-98ef-3b27e2d0ea18"],

Cell["For each object define: ", "Text",ExpressionUUID->"bbb22ad2-9655-9146-9abd-c37f3c54c5cd"],

Cell["well-definedness test", "Item",ExpressionUUID->"2ac89aeb-dce2-5141-ac97-7083a05ad4b4"],

Cell["symmetry test", "Item",ExpressionUUID->"799a6c06-2989-0a45-b295-ef80abc87f0f"],

Cell["stationarity test", "Item",ExpressionUUID->"6fc21c4c-5af0-5349-ad55-0cc21b9553d3"],

Cell["stability test", "Item",ExpressionUUID->"8be30455-7f91-4f41-815b-235611e022d4"],

Cell["input/output consistency test", "Item",ExpressionUUID->"f46f9361-4a6d-6546-8aaa-d6fce0939508"],

