}, Open  ]],

Cell[CellGroupData[{

Cell["7. Measurement operator", "Section",ExpressionUUID->"058d9ffe-21ce-cd42-af76-0bcf8f6826bb"],

Cell["\<\
The measurement operator maps the latent field state into an observable or \
partially decohered structure.\
\>", "Text",ExpressionUUID->"ca7d6c59-6d5e-5a43-ad1e-bf2385dbbc90"],

Cell[TextData[{
 "Minimal symbolic form: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], 
         RowBox[{"[", "\[CapitalPsi]", "]"}], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal M[\\Psi](x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2da51277-a2b5-7341-809c-25b4b8661202"]
}], "Text",ExpressionUUID->"659d1969-e771-1948-94ef-38067788ad71"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"measurementOperator", "[", 
    RowBox[{"field_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"measurementOperator", "[", 
    RowBox[{"field", ",", "measureKernel", ",", "x"}], "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"5f8c5cf9-4f32-fb44-a682-c0d4512cae6c"],

Cell[TextData[{
 "Integral-kernel prototype: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], 
         RowBox[{"[", "\[CapitalPsi]", "]"}], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "\[Integral]", 
         SubscriptBox[
          StyleBox["K", "TI"], 
          StyleBox["M", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"]}], ")"}], " ", "\[CapitalPsi]", 
         RowBox[{"(", 
           StyleBox["y", "TI"], ")"}], "\[DifferentialD]", 
         StyleBox["y", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal M[\\Psi](x)=\\int K_M(x,y)\\,\\Psi(y)\\,dy", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "beea2cf2-d561-a341-a646-c1bbf3d1de7a"]
}], "Text",ExpressionUUID->"f9df91f5-4bee-8d40-b920-d0bc71bb7a91"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"measurementKernelForm", "[", "x_", "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"measurementOperator", "[", 
     RowBox[{"psi", ",", "x"}], "]"}], "==", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"measureKernel", "[", 
        RowBox[{"x", ",", "y"}], "]"}], " ", 
       RowBox[{"psi", "[", "y", "]"}]}], ",", "y"}], "]"}]}]}], 
  ";"}]], "Input",ExpressionUUID->"3511af13-36b8-c24a-ac76-b065eccecf4c"],

Cell["\<\
If the notebook later uses basis expansions, this can be replaced by \
projection onto eigenfunctions. \
\>", "Text",ExpressionUUID->"ed5adb01-8050-b446-84fd-fa0825e34a31"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"1611739c-e5f3-0a4b-9b49-39731de3e277"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Restoration operator", "Section",ExpressionUUID->"8c1aa27e-a7f1-954c-b097-70e59fb6aa6a"],

Cell["\<\
The restoration operator expresses your intuition that measurement creates a \
deficit / void requiring re-filling or re-balancing.\
\>", "Text",ExpressionUUID->"162b4a2b-73ab-9845-96b4-a3474ffcb460"],

Cell[TextData[{
 "Minimal symbolic form: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["M", "TI"], 
             RowBox[{"[", "\[CapitalPsi]", "]"}], ",", "\[Nu]", ",", 
             StyleBox["A", "TI"], ",", 
             StyleBox["R", "TI"]}], "]"}], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal R[\\mathcal M[\\Psi],\\nu,A,R](x)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "56dadb3c-1522-034b-bd61-3d8875a0225f"]
}], "Text",ExpressionUUID->"79ae0790-91d7-0b47-b13b-b478e3712f04"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"restorationOperator", "[", 
    RowBox[{"field_", ",", "x_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
   RowBox[{"restorationOperator", "[", 
    RowBox[{"field", ",", 
     RowBox[{"nu", "[", "x", "]"}], ",", 
     RowBox[{"anisotropy", "[", "x", "]"}], ",", 
     RowBox[{"resolution", "[", "x", "]"}], ",", "restoreKernel", ",", "x"}], 
    "]"}]}], ";"}]], "Input",ExpressionUUID->"d98fc4b1-7c9d-2847-88b6-\
bd3340f8c862"],

Cell["Kernel prototype: ", "CodeText",ExpressionUUID->"3bdda09c-be4f-8b4a-b348-028f09682caa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"restorationKernelForm", "[", "x_", "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"restorationOperator", "[", 
     RowBox[{
      RowBox[{"measurementOperator", "[", 
       RowBox[{"psi", ",", "x"}], "]"}], ",", "x"}], "]"}], "==", 
    "\[IndentingNewLine]", "    ", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"restoreKernel", "[", 
        RowBox[{"x", ",", "y"}], "]"}], " ", 
       RowBox[{"measurementOperator", "[", 
        RowBox[{"psi", ",", "y"}], "]"}]}], ",", "y"}], "]"}]}]}], 
  ";"}]], "Input",ExpressionUUID->"db6cf857-4eb3-e94d-9794-dbcb7871973e"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
