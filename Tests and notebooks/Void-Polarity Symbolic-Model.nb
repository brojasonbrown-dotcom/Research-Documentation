 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"8d0be998-1b70-ae4f-b1d6-371c678ae296"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Neighbor-relative anisotropy structure", "Section",ExpressionUUID->"528d8439-e682-2344-8ced-5697473cceec"],

Cell["\<\
To encode your opposite-side relational intuition, we introduce a symbolic \
neighbor configuration and a directional anisotropy field. \
\>", "Text",ExpressionUUID->"03e32a1f-5118-1c40-a48f-024798f1c636"],

Cell[BoxData[
 RowBox[{
  RowBox[{"neighborConfiguration", "=", 
   RowBox[{"{", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<NeighborPosition\>\"", "->", "y"}], ",", 
       RowBox[{"\"\<NeighborStrength\>\"", "->", 
        RowBox[{"Subscript", "[", 
         RowBox[{"s", ",", "1"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<NeighborPosition\>\"", "->", 
        RowBox[{"Subscript", "[", 
         RowBox[{"y", ",", "2"}], "]"}]}], ",", 
       RowBox[{"\"\<NeighborStrength\>\"", "->", 
        RowBox[{"Subscript", "[", 
         RowBox[{"s", ",", "2"}], "]"}]}]}], "}"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",ExpressionUUID->"c6b43133-35e0-5346-94f1-\
c240a1477408"],

Cell["A generic anisotropy generator can be left symbolic: ", "CodeText",ExpressionUUID->"fc017627-d576-4b47-b17c-58c6bf63b4db"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"anisotropyGenerator", "[", 
    RowBox[{"x_", ",", "neighbors_"}], "]"}], ":=", 
   RowBox[{"anisotropy", "[", 
    RowBox[{"x", ",", "neighbors"}], "]"}]}], ";"}]], "Input",ExpressionUUID->\
"e5ca6799-5909-0545-a9de-77b7b957f152"],

Cell["\<\
Later this can become a scalar, vector, or tensor-valued field. \
\>", "Text",ExpressionUUID->"87108c7c-a58d-5842-910f-34f3675c3851"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"21914085-8d78-8740-b74b-1e7d49248097"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Source equation", "Section",ExpressionUUID->"826af9ab-f5c0-f04b-97fe-9cb3647ad41e"],

Cell["A minimal source equation should capture: ", "Text",ExpressionUUID->"39ab5c92-73cc-8949-856a-e51b53c208b3"],

Cell["intrinsic positive information density,", "Item",ExpressionUUID->"51dcad7e-0236-5f45-8c43-8610a8e3d6f3"],

Cell["neighbor influence,", "Item",ExpressionUUID->"96d790b4-95cf-9a4a-a53d-8e6cd81a9543"],

Cell["possible diffusion or propagation,", "Item",ExpressionUUID->"1301510d-9dbc-6e4e-85ca-fcaf3d9ac182"],

Cell["coupling to resolution and anisotropy.", "Item",ExpressionUUID->"626e5163-82b8-b847-9df2-f5a5118a542c"],

Cell["A general symbolic source operator: ", "CodeText",ExpressionUUID->"78eadfbe-061c-094b-8fa0-8b63a1d6d8c8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sourceOperator", "[", 
    RowBox[{"field_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"sourceOperator", "[", 
    RowBox[{"field", ",", 
     RowBox[{"anisotropy", "[", "x", "]"}], ",", 
     RowBox[{"resolution", "[", "x", "]"}], ",", "x"}], "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"897007c5-008a-f94c-8b96-962ff7dc73e7"],

Cell[TextData[{
 "A first symbolic source equation can be written as: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], "\[Rho]"], 
         RowBox[{"[", 
           RowBox[{"\[Rho]", ",", 
             StyleBox["A", "TI"], ",", 
             StyleBox["R", "TI"]}], "]"}], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{S}_\\rho[\\rho,A,R](x)=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e69698da-4b4a-304e-9ca9-77c13c54bb00"]
}], "Text",ExpressionUUID->"825f0f0f-d4fc-7d44-9666-30ed5bac979d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sourceEquation", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"sourceOperator", "[", 
     RowBox[{"rho", ",", "x"}], "]"}], "==", "0"}]}], ";"}]], "Input",Expressi\
onUUID->"1c076446-fcfd-b54f-88d3-13e819dea33e"],

Cell[TextData[{
 "A more concrete prototype PDE form is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", "\[Tau]"], "\[Rho]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", "\[Tau]"}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["D", "TI"], "\[Rho]"], " ", 
         SuperscriptBox["\[Del]", "2"], "\[Rho]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", "\[Tau]"}], ")"}], "+", 
         SubscriptBox[
          StyleBox["F", "TI"], "\[Rho]"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Nu]", ",", 
             StyleBox["A", "TI"], ",", 
             StyleBox["R", "TI"], ";", 
             StyleBox["x", "TI"], ",", "\[Tau]"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\partial_\\tau \
\\rho(x,\\tau)=D_\\rho\\,\\nabla^2\\rho(x,\\tau)+F_\\rho(\\rho,\\nu,A,R;x,\\\
tau)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6c73e06e-d075-8246-98a4-51ddcd51e124"]
}], "Text",ExpressionUUID->"baa4028b-e429-5448-a406-701cc38a1708"],

Cell[BoxData[
 RowBox[{
  RowBox[{"prototypeSourceEquation", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"rho", "[", 
       RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
    "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"d", ",", "rho"}], "]"}], " ", 
      RowBox[{"Laplacian", "[", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", 
        RowBox[{"{", "x", "}"}]}], "]"}]}], "+", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"f", ",", "rho"}], "]"}], "[", 
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], ",", 
       RowBox[{"nu", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], ",", 
       RowBox[{"anisotropy", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], ",", 
       RowBox[{"resolution", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], ",", "x", ",", "tau"}], "]"}]}]}]}],
   ";"}]], "Input",ExpressionUUID->"68eef4e6-4fe1-4743-8ab2-03213eb16cb6"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"7b647bda-c621-6449-963c-a8b103bb9cab"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Void induction equation", "Section",ExpressionUUID->"441b862e-9beb-6049-af77-edda229fac56"],

Cell["This is the key new ingredient.", "Text",ExpressionUUID->"740ecf9e-af2a-6542-b852-1592a55af173"],

Cell[TextData[{
 "The void field ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Nu]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\nu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c6c8a2a7-d9ed-cf41-8cf3-b32da6e41eaf"],
 " is not treated as ordinary negative matter. It is a compensating induced \
field depending on: "
}], "Text",ExpressionUUID->"902638c1-2898-7741-9b79-89421505aab7"],

Cell["source density,", "Item",ExpressionUUID->"6785a552-ff03-2b40-9eba-3624f55fc7d1"],

Cell["geometry of neighbors,", "Item",ExpressionUUID->"8a86514d-891b-c544-851f-fb3eb51938fb"],

Cell["measurement events,", "Item",ExpressionUUID->"1537b4d5-dc7a-c94c-a5ff-4ae7a7a38db4"],

Cell["anisotropy,", "Item",ExpressionUUID->"de305d5e-5c5d-3a4c-9fb9-90006e2211af"],

Cell["resolution.", "Item",ExpressionUUID->"7c37f16e-2a57-fa41-8223-18a0fbc8596e"],

Cell["A symbolic induction operator: ", "CodeText",ExpressionUUID->"c677be91-6ab1-2e41-a3b7-0511fb148cbc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"voidInductionOperator", "[", 
    RowBox[{"field_", ",", "x_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
   RowBox[{"voidInductionOperator", "[", 
    RowBox[{"field", ",", 
     RowBox[{"anisotropy", "[", "x", "]"}], ",", 
     RowBox[{"resolution", "[", "x", "]"}], ",", "neighborConfiguration", ",",
      "x"}], "]"}]}], ";"}]], "Input",ExpressionUUID->"328fb2c4-2f0f-234b-\
98f0-415a42837d58"],

Cell[TextData[{
 "Minimal symbolic void equation: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], "\[Nu]"], 
         RowBox[{"[", 
           RowBox[{"\[Rho]", ",", "\[Nu]", ",", 
             StyleBox["A", "TI"], ",", 
             StyleBox["R", "TI"], ",", 
             StyleBox["N", "TI"]}], "]"}], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{S}_\\nu[\\rho,\\nu,A,R,\\mathcal N](x)=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3fb22005-3ece-8242-87f2-649af04a745e"]
}], "Text",ExpressionUUID->"5ac27ca9-90c9-ca4a-aea0-617341b6ca42"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"voidEquation", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"voidInductionOperator", "[", 
     RowBox[{"psi", ",", "x"}], "]"}], "==", "0"}]}], ";"}]], "Input",Expressi\
onUUID->"a3d787a4-06ea-5948-9448-2b7876850975"],

Cell[TextData[{
 "A prototype dynamic form: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", "\[Tau]"], "\[Nu]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", "\[Tau]"}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["D", "TI"], "\[Nu]"], " ", 
         SuperscriptBox["\[Del]", "2"], "\[Nu]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", "\[Tau]"}], ")"}], "+", 
         SubscriptBox[
          StyleBox["F", "TI"], "\[Nu]"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Nu]", ",", 
             StyleBox["A", "TI"], ",", 
             StyleBox["R", "TI"], ",", 
             StyleBox["M", "TI"], ",", 
             StyleBox["N", "TI"], ";", 
             StyleBox["x", "TI"], ",", "\[Tau]"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\partial_\\tau \
\\nu(x,\\tau)=D_\\nu\\,\\nabla^2\\nu(x,\\tau)+F_\\nu(\\rho,\\nu,A,R,\\mathcal \
M,\\mathcal N;x,\\tau)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "310c1b2d-2dc2-2d4b-82d3-d0454bfca7f2"]
}], "Text",ExpressionUUID->"09c7ed96-da99-304c-9d9b-5d7ab32047fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"prototypeVoidEquation", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"nu", "[", 
       RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
    "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"d", ",", "nu"}], "]"}], " ", 
      RowBox[{"Laplacian", "[", 
       RowBox[{
        RowBox[{"nu", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", 
        RowBox[{"{", "x", "}"}]}], "]"}]}], "+", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"f", ",", "nu"}], "]"}], "[", "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], ",", 
       RowBox[{"nu", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], ",", 
       RowBox[{"anisotropy", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], ",", 
       RowBox[{"resolution", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], ",", "\[IndentingNewLine]", 
       "      ", 
       RowBox[{"measurementOperator", "[", 
        RowBox[{"psi", ",", "x", ",", "tau"}], "]"}], ",", 
       "neighborConfiguration", ",", "x", ",", "tau"}], "\[IndentingNewLine]",
       "    ", "]"}]}]}]}], ";"}]], "Input",ExpressionUUID->"2f7bf563-c1ca-\
f044-b283-8fa1f6e61891"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
