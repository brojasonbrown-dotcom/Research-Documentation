Cell[CellGroupData[{

Cell["10. Continuous update law", "Section",ExpressionUUID->"05de6052-f46a-c144-b8e9-1ab790fbbd24"],

Cell[TextData[{
 "A continuous process-depth version is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", "\[Tau]"], "\[CapitalPsi]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", "\[Tau]"}], ")"}], "\[LongEqual]", "-", 
         StyleBox["M", "TI"], 
         RowBox[{"[", "\[CapitalPsi]", "]"}], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", "\[Tau]"}], ")"}], "+", 
         StyleBox["R", "TI"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["M", "TI"], 
             RowBox[{"[", "\[CapitalPsi]", "]"}]}], "]"}], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", "\[Tau]"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\partial_\\tau \\Psi(x,\\tau)= -\\mathcal M[\\Psi](x,\\tau)+\\mathcal \
R[\\mathcal M[\\Psi]](x,\\tau)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "71ddf031-115c-9c40-b79b-02a98050e149"]
}], "Text",ExpressionUUID->"33b5e4f4-153f-b947-ab8c-607a1b381406"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"continuousUpdate", "[", "x_", "]"}], ":=", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"psi", "[", 
       RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
    "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"measurementOperator", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"psi", "[", 
          RowBox[{"#", ",", "tau"}], "]"}], " ", "&"}], ",", "x"}], "]"}]}], "+",
      "\[IndentingNewLine]", "      ", 
     RowBox[{"restorationOperator", "[", 
      RowBox[{
       RowBox[{"measurementOperator", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"psi", "[", 
           RowBox[{"#", ",", "tau"}], "]"}], " ", "&"}], ",", "x"}], "]"}], ",",
        "x"}], "]"}]}]}]}], ";"}]], "Input",ExpressionUUID->"dde141f4-f532-\
8346-9f6d-3dd23490952d"],

Cell["A richer coupled continuous system is: ", "CodeText",ExpressionUUID->"d4dab23e-0728-1c43-8a16-cbee76bfa37e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coupledContinuousSystem", "=", 
   RowBox[{"{", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"d", ",", "rho"}], "]"}], " ", 
        RowBox[{"Laplacian", "[", 
         RowBox[{
          RowBox[{"rho", "[", 
           RowBox[{"x", ",", "tau"}], "]"}], ",", 
          RowBox[{"{", "x", "}"}]}], "]"}]}], "+", "\[IndentingNewLine]", 
       "      ", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"f", ",", "rho"}], "]"}], "[", 
        RowBox[{
         RowBox[{"rho", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], ",", 
         RowBox[{"nu", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], ",", 
         RowBox[{"anisotropy", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], ",", 
         RowBox[{"resolution", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], ",", "x", ",", "tau"}], "]"}]}]}],
      ",", "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"nu", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"d", ",", "nu"}], "]"}], " ", 
        RowBox[{"Laplacian", "[", 
         RowBox[{
          RowBox[{"nu", "[", 
           RowBox[{"x", ",", "tau"}], "]"}], ",", 
          RowBox[{"{", "x", "}"}]}], "]"}]}], "+", "\[IndentingNewLine]", 
       "      ", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"f", ",", "nu"}], "]"}], "[", 
        RowBox[{
         RowBox[{"rho", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], ",", 
         RowBox[{"nu", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], ",", 
         RowBox[{"anisotropy", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], ",", 
         RowBox[{"resolution", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], ",", "\[IndentingNewLine]", 
         "        ", 
         RowBox[{"measurementOperator", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"psi", "[", 
             RowBox[{"#", ",", "tau"}], "]"}], " ", "&"}], ",", "x"}], "]"}], 
         ",", "neighborConfiguration", ",", "x", ",", "tau"}], "]"}]}]}], ",",
      "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"anisotropy", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"f", ",", "a"}], "]"}], "[", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", 
        RowBox[{"nu", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", 
        RowBox[{"anisotropy", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", 
        RowBox[{"resolution", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", "neighborConfiguration", ",", 
        "x", ",", "tau"}], "]"}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"resolution", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"f", ",", "r"}], "]"}], "[", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", 
        RowBox[{"nu", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", 
        RowBox[{"anisotropy", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", 
        RowBox[{"resolution", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", "x", ",", "tau"}], "]"}]}], ",",
      "\[IndentingNewLine]", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"psi", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"f", ",", "psi"}], "]"}], "[", 
        RowBox[{
         RowBox[{"rho", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], ",", 
         RowBox[{"nu", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], ",", 
         RowBox[{"anisotropy", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], ",", 
         RowBox[{"resolution", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], ",", "x", ",", "tau"}], "]"}], "-",
        "\[IndentingNewLine]", "      ", 
       RowBox[{"measurementOperator", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"psi", "[", 
           RowBox[{"#", ",", "tau"}], "]"}], " ", "&"}], ",", "x"}], "]"}], "+",
        "\[IndentingNewLine]", "      ", 
       RowBox[{"restorationOperator", "[", 
        RowBox[{
         RowBox[{"measurementOperator", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"psi", "[", 
             RowBox[{"#", ",", "tau"}], "]"}], " ", "&"}], ",", "x"}], "]"}], 
         ",", "x"}], "]"}]}]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",ExpressionUUID->"6c38e33b-1f1f-ad41-bb95-27c90a4cec4b"],

