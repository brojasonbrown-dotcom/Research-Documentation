Cell[CellGroupData[{

Cell["OPF Void-Polarity Extension: Minimal Symbolic Model", "Title",ExpressionUUID->"7cca7563-8d0b-804c-8242-f0e7ff5b9d14"],

Cell[TextData[{
 "This notebook sets up a rigorous minimal symbolic framework for the \
five-field OPF extension with fields ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{"\[Rho]", 
           RowBox[{"(", 
             StyleBox["x", "TI"], ")"}], ",", "\[Nu]", 
           RowBox[{"(", 
             StyleBox["x", "TI"], ")"}], ",", 
           StyleBox["A", "TI"], 
           RowBox[{"(", 
             StyleBox["x", "TI"], ")"}], ",", 
           StyleBox["R", "TI"], 
           RowBox[{"(", 
             StyleBox["x", "TI"], ")"}], ",", "\[CapitalPsi]", 
           RowBox[{"(", 
             StyleBox["x", "TI"], ")"}]}], "}"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\{\\rho(x),\\nu(x),A(x),R(x),\\Psi(x)\\}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "56dfde39-f76f-604e-996b-eb177794ae34"],
 "where: "
}], "Text",ExpressionUUID->"bfe197e4-971c-0c4d-931d-f843fc754561"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Rho]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e62eeb6b-fa45-6b43-ad53-de2ab98161f5"],
 " is positive information density"
}], "Item",ExpressionUUID->"67588f6e-d0ed-cd4b-b7af-59394b7ff8cb"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Nu]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\nu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2edda0d0-89e1-6741-91da-7d4e03058567"],
 " is void / compensating informational density"
}], "Item",ExpressionUUID->"a892c532-1fc3-8544-99dc-3dcc9baa6e7f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> "A", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c545e9cb-61cf-d04d-b240-9458277585c8"],
 " is anisotropy-orientation structure"
}], "Item",ExpressionUUID->"b6bf9b84-9762-b843-a6f7-26b78c91c8bd"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e5dfdefc-2616-e24a-aab1-72ed2660bdb9"],
 " is observational resolution"
}], "Item",ExpressionUUID->"9d9c8cf2-f84e-b645-89c9-c1fc73adea1d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalPsi]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Psi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "544694f5-4a67-b04f-ad67-404c1aa95aef"],
 " is the total field state"
}], "Item",ExpressionUUID->"a5b5e052-9f9c-1842-a71b-f87aaa57de79"],

Cell["The goal is to define:", "Text",ExpressionUUID->"3cec8fec-69c8-7143-8f7b-681d3b0885a2"],

Cell["1. a source equation,", "Text",ExpressionUUID->"3837ec09-545e-2047-a02c-e6a1f35295d1"],

Cell["2. a void induction equation,", "Text",ExpressionUUID->"e7b3d537-5ffe-994b-8cb4-bfd1541dbcb5"],

Cell["3. a measurement operator,", "Text",ExpressionUUID->"20ed824b-bf23-8741-9997-6d1dbe2f2733"],

Cell["4. a restoration operator,", "Text",ExpressionUUID->"d17f16fa-074b-1144-aa6a-4205dd948b86"],

Cell["5. a recursive and continuous update law. ", "Text",ExpressionUUID->"c57431fa-dd0f-4f4e-b4b3-27d621a4aea6"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"6c2699ed-cde5-724f-ad50-950ffdc56b0a"],

Cell[CellGroupData[{

Cell["1. Design principles", "Section",ExpressionUUID->"2b780689-0c5e-1647-b00c-f09393a8d7b4"],

Cell["We will keep the first version intentionally minimal: ", "Text",ExpressionUUID->"17adc9de-b468-4440-8dad-7f6bb6f91817"],

Cell["symbolic first,", "Item",ExpressionUUID->"ae04745f-1b7d-a645-9ac0-dae6c4334109"],

Cell["modular,", "Item",ExpressionUUID->"6668bc48-67ab-9f43-9f46-5b50f0b58f97"],

Cell["input/output compatible,", "Item",ExpressionUUID->"9364291f-76ec-984f-8688-2482257a1646"],

Cell["extensible to variational and spectral analysis,", "Item",ExpressionUUID->"9ae556b5-9d87-e84e-96f5-42c56937825a"],

Cell["\<\
suitable for later conversion into operator/state-space form.\
\>", "Item",ExpressionUUID->"cf2f50b6-0ba3-534b-9b71-c39d04272182"],

Cell[TextData[{
 "We treat the framework as a composition ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], "0"], "\[Rule]", 
         SubscriptBox[
          StyleBox["L", "TI"], "1"], "\[Rule]", 
         SubscriptBox[
          StyleBox["L", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "L_0 \\to L_1 \\to L_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "624e9e23-a085-0847-9ed8-ecaee920e092"],
 "with: "
}], "Text",ExpressionUUID->"5bd0ac31-befd-994d-b503-7fbc8015f7c2"],

Cell["substrate / geometry", "Item",ExpressionUUID->"01112c5a-3d01-074c-813d-a17051f02ba0"],

Cell["informational field evolution", "Item",ExpressionUUID->"e8982ccb-8b50-2145-ab97-c7eb8c6213e0"],

Cell["measurement and maintained observables", "Item",ExpressionUUID->"af439130-83db-a843-af11-1fa1a8d3162d"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"a4391ac9-28c0-e647-935d-c32f6e21ed7e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Core symbolic declarations", "Section",ExpressionUUID->"d3e5e6ec-94ab-b44a-afdc-202907267de8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
   "x", ",", "y", ",", "t", ",", "tau", ",", "n", ",", "\[IndentingNewLine]", 
    "  ", "rho", ",", "nu", ",", "anisotropy", ",", "resolution", ",", "psi", 
    ",", "\[IndentingNewLine]", "  ", "sourceKernel", ",", "voidKernel", ",", 
    "measureKernel", ",", "restoreKernel", ",", "\[IndentingNewLine]", "  ", 
    "measurementOperator", ",", "restorationOperator", ",", "sourceOperator", 
    ",", "\[IndentingNewLine]", "  ", "voidInductionOperator", ",", 
    "updateOperator", ",", "continuousUpdateOperator", ",", 
    "\[IndentingNewLine]", "  ", "neighborConfiguration", ",", 
    "effectivePotential", ",", "totalDensity", ",", "\[IndentingNewLine]", 
    "  ", "sourceEquation", ",", "voidEquation", ",", "recursiveUpdate", ",", 
    "continuousUpdate", ",", "\[IndentingNewLine]", "  ", "opfState", ",", 
    "opfInput", ",", "opfOutput"}], "\[IndentingNewLine]", "]"}], 
  ";"}]], "Input",ExpressionUUID->"009b3e2c-1297-5c46-907d-7fb24c073369"],

Cell["We use the following naming convention: ", "Text",ExpressionUUID->"fb2fd733-613a-0d44-bbb8-858366c6d0ee"],

Cell[TextData[{
 Cell[BoxData[Cell["rho[x]",
   Background->None,ExpressionUUID->"857b9423-78fb-d645-a2bb-1bc596543afa"]], 
  "InlineCode",ExpressionUUID->"36b1267b-b6ab-5d4f-9108-dd6921ca562a"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "57ba7512-02c3-2249-9f01-dd7831926177"]
}], "Item",ExpressionUUID->"c4c1b64b-da06-6649-97aa-1796b16cb6ea"],

Cell[TextData[{
 Cell[BoxData[Cell["nu[x]",
   Background->None,ExpressionUUID->"e288ea08-4140-4142-9521-35a944fd4c63"]], 
  "InlineCode",ExpressionUUID->"1691ea50-25fb-df44-bdb0-a40979a3919b"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Nu]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\nu(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8a0a333d-5c57-0440-9047-77570a3f6550"]
}], "Item",ExpressionUUID->"a9fdd93d-aaaa-ee48-a2f0-a6a84600c7b8"],

Cell[TextData[{
 Cell[BoxData[Cell["anisotropy[x]",
   Background->None,ExpressionUUID->"2a760e8a-b8f7-704e-8723-cf2d9fddd4f9"]], 
  "InlineCode",ExpressionUUID->"6b2cb74d-6142-2544-82be-319dfd25f0b5"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "A(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c4c1d688-7820-4e48-994c-4444ac597902"]
}], "Item",ExpressionUUID->"171abcfb-8f72-f54f-8712-af93c1a246e3"],

Cell[TextData[{
 Cell[BoxData[Cell["resolution[x]",
   Background->None,ExpressionUUID->"b011c9e5-0bd4-ea4b-9cfa-d36ad75443c3"]], 
  "InlineCode",ExpressionUUID->"c0006405-20f6-4044-b8e4-2b53f8a370ae"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "R(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b1ab03db-4b71-004e-846d-cdcf5e29f731"]
}], "Item",ExpressionUUID->"07004bf3-036c-4b4c-8f9c-b60e2c16b7ed"],

Cell[TextData[{
 Cell[BoxData[Cell["psi[x]",
   Background->None,ExpressionUUID->"72b62b97-a32d-2d4e-8623-90938c35543b"]], 
  "InlineCode",ExpressionUUID->"85112aa9-78f5-3748-bf1f-69ffe99f0a90"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPsi]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Psi(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a2e48bf2-4d4c-b444-8a0c-362544d8b95f"]
}], "Item",ExpressionUUID->"5118aec4-f7e4-7f4b-a4ef-62b7f095dce7"],

