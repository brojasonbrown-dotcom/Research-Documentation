Cell[CellGroupData[{

Cell["1. Initialization", "Section",ExpressionUUID->"f733c6c4-6978-4143-b547-36dc62a6ec94"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Rho]0", ",", "\[Chi]0", ",", "r0", ",", "\[Gamma]", ",", 
         "\[CapitalGamma]", ",", "\[Omega]", ",", "kx", ",", "ky", ",", "kz", 
         ",", "\[Lambda]", ",", "\[Alpha]", ",", "\[Beta]", ",", "\[Mu]"}], 
        "}"}], ",", "Reals"}], "]"}], "&&", "\[IndentingNewLine]", "   ", 
     RowBox[{"\[Rho]0", ">", "0"}], "&&", 
     RowBox[{"\[Chi]0", ">", "0"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords4", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spatialCoords", "=", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gradSq4", "[", "f_", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"f", " ", "@@", " ", "coords4"}], ",", "#"}], "]"}], "^", 
       "2"}], " ", "&"}], " ", "/@", " ", "coords4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"boxLike", "[", "f_", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"f", " ", "@@", " ", "coords4"}], ",", 
        RowBox[{"{", 
         RowBox[{"#", " ", ",", "2"}], "}"}]}], "]"}], " ", "&"}], " ", "/@", 
     " ", "coords4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kSq", "=", 
   RowBox[{
    RowBox[{"kx", "^", "2"}], "+", 
    RowBox[{"ky", "^", "2"}], "+", 
    RowBox[{"kz", "^", "2"}]}]}], ";"}]}], "Input",ExpressionUUID->"00f6812b-\
8cf5-c740-a709-e5b35aee98d2"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"6c734987-35bc-b744-ba30-9e873b8987c0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. OPF Layer Definitions", "Section",ExpressionUUID->"6cfd6311-0dd5-0d4b-80e2-f4d4abcad34e"],

Cell[CellGroupData[{

Cell["Layer 0: symbolic substrate", "Subsection",ExpressionUUID->"fa8a616d-ec23-834f-b388-13aa20b2ee0d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"layer0", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\"\<Topology\>\"", "->", "\"\<Sphere\>\""}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<BoundaryDuality\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "Infinity"}], "}"}]}], ",", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{"\"\<TemporalMode\>\"", "->", "\"\<Timeless\>\""}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<Substrate\>\"", "->", "\"\<EmptySpacetime\>\""}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",ExpressionUUID->\
"00d9a113-05d2-f147-ba4e-8538afa75581"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer 1: field variables and action density", "Subsection",ExpressionUUID->"199d7f2a-9693-5642-b30a-b4c2009d7d18"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"lagrangianAlgebraic", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"\[Chi]", "[", 
        RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "]"}]}], "+", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\[Chi]", "[", 
       RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], " ", 
      RowBox[{
       RowBox[{"r", "[", 
        RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "^", "2"}]}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lagrangianRegularized", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{"lagrangianAlgebraic", "+", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\[Alpha]", "/", "2"}], " ", 
     RowBox[{"gradSq4", "[", "\[Rho]", "]"}]}], "+", "\[IndentingNewLine]", 
    "   ", 
    RowBox[{
     RowBox[{"\[Beta]", "/", "2"}], " ", 
     RowBox[{"gradSq4", "[", "\[Chi]", "]"}]}], "+", "\[IndentingNewLine]", 
    "   ", 
    RowBox[{
     RowBox[{"\[Mu]", "/", "2"}], " ", 
     RowBox[{"gradSq4", "[", "r", "]"}]}]}]}], ";"}]}], "Input",ExpressionUUID\
->"6307c4f0-d951-cf46-94b3-b6134a703de8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer 2: measurement and persistence", "Subsection",ExpressionUUID->"1ee2aa65-aaab-4a4c-8f00-3b4d2930585d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"maintenanceEquation", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Phi]", "[", "t", "]"}], ",", "t"}], "]"}], "+", 
     RowBox[{"\[CapitalGamma]", " ", 
      RowBox[{"\[Phi]", "[", "t", "]"}]}]}], "==", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementFunctional", "[", 
    RowBox[{"\[Psi]_", ",", "basis_", ",", "region_"}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"\[Psi]", " ", "basis"}], ",", 
     RowBox[{
      RowBox[{"Evaluate", " ", "@", " ", "Sequence"}], " ", "@@", " ", 
      "region"}], ",", 
     RowBox[{"GenerateConditions", "->", "True"}]}], "]"}]}], ";"}]}], "Input",\
ExpressionUUID->"84d61fa0-f14e-ae46-978d-98d9bfaf5776"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
