Cell[CellGroupData[{

Cell["3. Algebraic Stationarity", "Section",ExpressionUUID->"2fd48cf4-c3fe-f84d-be9b-69b30414473b"],

Cell["\<\
This is the zeroth-order stationary structure of the non-derivative part of \
the action. \
\>", "Text",ExpressionUUID->"62e59154-a28a-8943-8e06-0755a38f09de"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"algEquations", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Rho]s", " ", 
          RowBox[{"Log", "[", "\[Chi]s", "]"}]}], "+", 
         RowBox[{"\[Chi]s", " ", 
          RowBox[{"rs", "^", "2"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"\[Rho]s", ",", "\[Chi]s", ",", "rs"}], "}"}], "}"}]}], 
       "]"}], "==", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"algSolve", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{"algEquations", ",", 
      RowBox[{"{", 
       RowBox[{"\[Rho]s", ",", "\[Chi]s", ",", "rs"}], "}"}], ",", "Reals"}], 
     "]"}], "]"}]}], ";"}]}], "Input",ExpressionUUID->"ac171b7f-7d26-364a-\
b97f-ae0c16006535"],

Cell["Expected exact solution: ", "CodeText",ExpressionUUID->"3f30fec6-fc6e-de49-9a3e-82888faf3baf"],

Cell[BoxData["algSolve"], "Input",ExpressionUUID->"2b19dd91-1937-e040-8e96-630d5e62c880"],

