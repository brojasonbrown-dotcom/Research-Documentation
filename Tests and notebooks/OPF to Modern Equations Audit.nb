Cell[CellGroupData[{

Cell["15. Measurement Kernel Examples", "Section",ExpressionUUID->"314c81d4-fd47-d541-a9e9-18e56eba6df0"],

Cell[CellGroupData[{

Cell["1D Hermite basis prototype", "Subsection",ExpressionUUID->"8f94d642-b0b2-c441-b3d4-c2b09381a5c3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]1", "[", "x1_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{"-", 
     RowBox[{"x1", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"basis1", "[", "n_", "]"}], "[", "x1_", "]"}], ":=", 
    RowBox[{
     RowBox[{"HermiteH", "[", 
      RowBox[{"n", ",", "x1"}], "]"}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"x1", "^", "2"}]}], "/", "2"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"measurementPrototypes", "=", 
   RowBox[{"FullSimplify", "@", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"Integrate", "[", "\[IndentingNewLine]", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Psi]1", "[", "x1", "]"}], " ", 
         RowBox[{
          RowBox[{"basis1", "[", "n", "]"}], "[", "x1", "]"}]}], ",", 
        "\[IndentingNewLine]", "     ", 
        RowBox[{"{", 
         RowBox[{"x1", ",", 
          RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
        "\[IndentingNewLine]", "     ", 
        RowBox[{"GenerateConditions", "->", "True"}]}], "\[IndentingNewLine]",
        "     ", "]"}], ",", "\[IndentingNewLine]", "    ", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", "6"}], "}"}]}], "\[IndentingNewLine]", 
     "    ", "]"}]}]}], ";"}]}], "Input",ExpressionUUID->"17104ed2-9517-d94b-\
90d1-46ab1eb88743"]
}, Open  ]],

