Cell[CellGroupData[{

Cell["16. State-Space Realization of Linearized Modes", "Section",ExpressionUUID->"a46ef823-8aa4-d24d-84bc-e0250d570794"],

Cell[TextData[{
 "Once a linearized ODE or finite-mode truncation is chosen, represent it \
using ",
 ButtonBox["StateSpaceModel",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/StateSpaceModel"],
 "."
}], "Text",ExpressionUUID->"11ffa060-9c6f-a645-a4c1-452134e97dbc"],

Cell["A generic symbolic template: ", "CodeText",ExpressionUUID->"9186ea11-e4ad-6f49-a288-b0f3b6cfa5c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ssmTemplate", "=", 
   RowBox[{"StateSpaceModel", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x1", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"x2", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"x2", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], " ", 
          RowBox[{"x1", "[", "t", "]"}]}], "-", 
         RowBox[{"b", " ", 
          RowBox[{"x2", "[", "t", "]"}]}], "+", 
         RowBox[{"c", " ", 
          RowBox[{"uIn", "[", "t", "]"}]}]}]}]}], "\[IndentingNewLine]", 
      "    ", "}"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x1", "[", "t", "]"}], ",", 
       RowBox[{"x2", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"uIn", "[", "t", "]"}], "}"}], ",", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"x1", "[", "t", "]"}], "}"}], ",", "\[IndentingNewLine]", "   ",
      "t"}], "\[IndentingNewLine]", "   ", "]"}]}], ";"}]], "Input",Expression\
UUID->"f9dab68e-d768-6643-814b-f195bfb45bc8"],

