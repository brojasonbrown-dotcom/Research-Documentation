     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"ed49e715-ed2b-c643-8bc5-701883b00edd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Plane-Wave Modal Reduction", "Section",ExpressionUUID->"0dea403c-b223-9644-9ff2-923f0cae66b2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"planeRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"u", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"u0", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "xx"}], "+", 
              RowBox[{"ky", " ", "yy"}], "+", 
              RowBox[{"kz", " ", "zz"}], "-", 
              RowBox[{"\[Omega]", " ", "tt"}]}], ")"}]}], "]"}]}]}], "]"}]}], 
      ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"v", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"v0", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "xx"}], "+", 
              RowBox[{"ky", " ", "yy"}], "+", 
              RowBox[{"kz", " ", "zz"}], "-", 
              RowBox[{"\[Omega]", " ", "tt"}]}], ")"}]}], "]"}]}]}], "]"}]}], 
      ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"w", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"w0", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "xx"}], "+", 
              RowBox[{"ky", " ", "yy"}], "+", 
              RowBox[{"kz", " ", "zz"}], "-", 
              RowBox[{"\[Omega]", " ", "tt"}]}], ")"}]}], "]"}]}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "   ", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modalAlgebraic", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"linearizedSystem", " ", "/.", " ", "planeRules"}], ")"}], "/", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"kx", " ", "x"}], "+", 
          RowBox[{"ky", " ", "y"}], "+", 
          RowBox[{"kz", " ", "z"}], "-", 
          RowBox[{"\[Omega]", " ", "t"}]}], ")"}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stiffnessMatrix", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"u0", ",", "v0", ",", "w0"}], "}"}]}], "]"}], " ", "&"}], 
      " ", "/@", " ", "modalAlgebraic"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dispersionDet", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Det", "[", "stiffnessMatrix", "]"}], "]"}]}], ";"}]}], "Input",Ex\
pressionUUID->"85d7e450-c3d7-ba4d-a596-a2a5cfd159b6"],

Cell["To impose the stationary background found earlier: ", "CodeText",ExpressionUUID->"639845c2-ad9c-254b-ad6b-a51dac83c728"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"stationaryBackground", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Rho]0", "->", "0"}], ",", 
      RowBox[{"\[Chi]0", "->", "1"}], ",", 
      RowBox[{"r0", "->", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stiffnessAtStationary", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"stiffnessMatrix", " ", "/.", " ", "stationaryBackground"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dispersionAtStationary", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"dispersionDet", " ", "/.", " ", "stationaryBackground"}], 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"f2cc5197-bb2a-414a-abd8-\
cc19662a85de"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"a3d5e568-d44c-a440-9c9b-8277ee895810"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Stable-Frequency Extraction", "Section",ExpressionUUID->"0a373dee-5c47-044a-9370-9dd64d669df2"],

Cell[TextData[{
 "Your OPF directive asks for undamped harmonic modes with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           StyleBox["R", "TI"], 
           StyleBox["e", "TI"]}], 
         RowBox[{"(", "\[Lambda]", ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\operatorname{Re}(\\lambda)=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5d0ea9b9-d5ae-8b4a-87a6-ab45f951e5ad"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           StyleBox["I", "TI"], 
           StyleBox["m", "TI"]}], 
         RowBox[{"(", "\[Lambda]", ")"}], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\operatorname{Im}(\\lambda)>0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "102b0380-e08d-8c4b-991b-caa7bf7c0ce3"],
 "."
}], "Text",ExpressionUUID->"e924d29f-5b53-bb4f-bbc6-16d88aa871cc"],

Cell[TextData[{
 "A practical symbolic route is to solve the dispersion relation for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Omega]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\omega", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "47db2db3-1fde-1f4f-a482-131bd589346b"],
 ": "
}], "CodeText",ExpressionUUID->"9d518d7e-f8e5-a147-a004-380b53f51f5c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"modalFrequencies", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"dispersionAtStationary", "==", "0"}], ",", "\[Omega]"}], "]"}],
     "]"}]}], ";"}]], "Input",ExpressionUUID->"cd9fa121-abd7-0f47-b788-\
f541214eb12f"],

Cell["If you want the spectral matrix itself: ", "CodeText",ExpressionUUID->"486aa395-b395-c54d-adf8-44502423bf67"],

Cell[BoxData[
 RowBox[{
  RowBox[{"eigenData", "=", 
   RowBox[{"Eigensystem", "[", "stiffnessAtStationary", "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"b1c36a6a-8a13-3b44-9046-dbb725a78280"],

Cell["For parameter scans, use: ", "CodeText",ExpressionUUID->"f3f5df2a-1b00-c246-83f2-be7aeb3838a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"stableFrequencyCondition", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{"Reduce", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"dispersionAtStationary", "==", "0"}], "&&", 
      RowBox[{"Element", "[", 
       RowBox[{"\[Omega]", ",", "Complexes"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "   ", "\[Omega]"}], "\[IndentingNewLine]", "   ",
     "]"}]}], ";"}]], "Input",ExpressionUUID->"e2053ef6-04bb-b54a-9356-\
57df9ec1ca24"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
