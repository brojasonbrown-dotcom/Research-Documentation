Cell[CellGroupData[{

Cell["7. Missing-Symbol and Structural Audit", "Section",ExpressionUUID->"b24b7d62-702a-9944-b1e7-b2903be42efe"],

Cell["\<\
This is useful for separating field heads, parameters, operators, and \
incidental symbolic heads. \
\>", "Text",ExpressionUUID->"0fe59f39-17bd-ad49-ad20-faf82cca3675"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"actionSymbols", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{"DeleteDuplicates", " ", "@", " ", 
     RowBox[{"Cases", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{"lagrangianRegularized", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"s_Symbol", " ", "/;", " ", 
        RowBox[{
         RowBox[{"Context", "[", "s", "]"}], "===", "\"\<Global`\>\""}]}], ",",
        "\[IndentingNewLine]", "    ", "Infinity"}], "\[IndentingNewLine]", 
      "  ", "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"actionHeads", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{"DeleteDuplicates", " ", "@", " ", 
     RowBox[{"Cases", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{"lagrangianRegularized", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"hSymbol", "[", "___", "]"}], ":>", "h"}], ",", 
       "\[IndentingNewLine]", "    ", "Infinity"}], "\[IndentingNewLine]", 
      "  ", "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"standardModelLikeConstants", "=", 
    RowBox[{"{", 
     RowBox[{"c", ",", "h", ",", "\[HBar]", ",", "G", ",", "kB", ",", "E", ",", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\[Epsilon]", ",", "0"}], "]"}], ",", 
      RowBox[{"Subscript", "[", 
       RowBox[{"\[Mu]", ",", "0"}], "]"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"opfSymbolsAudit", "=", 
   RowBox[{"Complement", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{"actionSymbols", ",", "actionHeads"}], "]"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"Join", "[", 
      RowBox[{"coords4", ",", 
       RowBox[{"{", "Log", "}"}]}], "]"}]}], "\[IndentingNewLine]", "   ", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"a14d6fd1-b6c0-6d4f-a1cc-\
2937bef6dc0c"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"f2b96031-9a39-1e4c-9325-edaf5590c3b7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Linearization About a Background", "Section",ExpressionUUID->"f15476d8-c5e2-1c48-9c9f-1bd3587f6483"],

Cell["\<\
This is the corrected modern perturbative form using functional replacement \
rules. \
\>", "Text",ExpressionUUID->"0d27fdb6-8a89-124b-83b5-68d0c234d111"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"linRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\[Rho]", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"\[Rho]0", "+", 
          RowBox[{"\[CurlyEpsilon]", " ", 
           RowBox[{"u", "[", 
            RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
        "]"}]}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\[Chi]", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"\[Chi]0", "+", 
          RowBox[{"\[CurlyEpsilon]", " ", 
           RowBox[{"v", "[", 
            RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
        "]"}]}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"r", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"r0", "+", 
          RowBox[{"\[CurlyEpsilon]", " ", 
           RowBox[{"w", "[", 
            RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "   ", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"series1", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"\[CurlyEpsilon]", ",", "0", ",", "1"}], "}"}]}], "]"}], 
       "]"}], " ", "&"}], ",", 
     RowBox[{"eulerLHS", " ", "/.", " ", "linRules"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearizedSystem", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"#", ",", "\[CurlyEpsilon]"}], "]"}], " ", "&"}], " ", "/@", 
      " ", "series1"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"backgroundConditions", "=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{"Series", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{"\[CurlyEpsilon]", ",", "0", ",", "0"}], "}"}]}], "]"}], 
        "]"}], " ", "&"}], ",", 
      RowBox[{"eulerLHS", " ", "/.", " ", "linRules"}]}], "]"}], 
    "\[IndentingNewLine]", "   ", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"c8ee799b-9a80-9b45-a45b-5b194a10fe49"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
