 RowBox[{
  RowBox[{
   RowBox[{"modernToOpfMap", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<WaveEquation\>\"", 
       "->", "\"\<Lorentzian variant of the \[Rho] sector with \[Alpha] \
playing\n   the      role of 1/c^2. Not accessible with the Euclidean gradSq4 \
as written.\>\""}], ",", 
      RowBox[{"\"\<HeatEquation\>\"", 
       "->", "\"\<Natural fit for the Euclidean \[Rho] sector: \[Alpha] acts \
as\n   \[Kappa]      and the Log[\[Chi]] term is a nonlinear source. Mapping \
is tight when \[Chi] is slowly\n   varying.\>\""}], ",", 
      RowBox[{"\"\<KleinGordon\>\"", 
       "->", "\"\<Requires BOTH Lorentzian signature AND a mass term \[Mu]^2\n\
   \[Rho]^2      in the potential. Current L has no \[Rho]^2 mass; the linear \
\[Rho] Log[\[Chi]] gives a      \[Chi]-dependent effective mass instead. See \
intuitive 'brick tower' shorthand.\>\""}], ",", 
      RowBox[{"\"\<Schrodinger\>\"", 
       "->", "\"\<Role-analogy only. OPF has no \[DoubleStruckCapitalI] \
\[HBar],\n   no      unitarity constraint, no probability normalization. Do \
not treat \[Chi] as \[Psi].\>\""}], ",", 
      RowBox[{"\"\<Poisson\>\"", 
       "->", "\"\<Static limit of the \[Chi] sector when all time derivatives\
\n   drop:      \[Beta] \[Del]^2 \[Chi] = \[Rho]/\[Chi] - r^2. The \
Log[\[Chi]] source makes it\n   nonlinear-Poisson.\>\""}], ",", 
      RowBox[{"\"\<Helmholtz\>\"", 
       "->", "\"\<What dispersion determinant REDUCES to at fixed \[Omega] in \
each\n   sector.      The stiffness matrix in section 9 is the coupled \
3-field Helmholtz operator.\>\""}], ",", 
      RowBox[{"\"\<AdvectionDiffusion\>\"", 
       "->", "\"\<Not present in current L (no first-order spatial \
derivative).\n   Would      appear if a coherent-flow term v \[CenterDot] \
\[Del]\[Rho] were added.\>\""}], ",", 
      RowBox[{"\"\<ReactionDiffusion\>\"", 
       "->", "\"\<Closest honest match for the Euclidean \[Rho] sector:      \
\[PartialD]_t \[Rho] = \[Alpha] \[Del]^2 \[Rho] + f(\[Rho], \[Chi]) where     \
 f = -Log[\[Chi]]. Reaction term is the OPF nonlinearity.\>\""}], ",", 
      RowBox[{"\"\<DampedOscillator\>\"", 
       "->", "\"\<Zero-dimensional reduction of the linearized system around \
the      nontrivial branch. The damping \[Zeta] maps to \[CapitalGamma] from \
the maintenance law.\>\""}], ",", 
      RowBox[{"\"\<MaintenanceLaw\>\"", 
       "->", "\"\<The ONE OPF equation that is already in modern form. \
Exactly a      first-order linear decay -- same ODE as RC-circuit discharge. \
F8 shows the nonlinear      upgrade needed for persistence.\>\""}]}], 
     "|>"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
