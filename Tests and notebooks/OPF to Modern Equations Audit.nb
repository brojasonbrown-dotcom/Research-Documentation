             SubscriptBox["\[Psi]", "1"], 
             OverscriptBox[
              SubscriptBox["\[Psi]", "2"], "_"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "I = |\\psi_1|^2 + |\\psi_2|^2 + 2\\gamma \
\\Re(\\psi_1\\overline{\\psi_2})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7f88cce4-ec15-984b-94e4-056582025ad2"],
 "\n",
