                   FEPrivate`FrontEndResource["FEBitmaps", "NotebookIcon"][
                    LightDarkSwitched[
                    GrayLevel[0.651], 
                    GrayLevel[0.6317181]], 
                    LightDarkSwitched[
                    RGBColor[0.86667, 0.066667, 0.], 
                    RGBColor[1, 0.4537951, 0.3912115]]]]]], StandardForm],
               ImageSizeCache->{16., {4.900390625, 11.099609375}},
               SingleEvaluation->True,
               TrackedSymbols:>{}],
              BaselinePosition->Scaled[0.2],
              ContentPadding->False,
              FrameMargins->{{0, 0}, {0, 0}}], 
             StyleBox[
              DynamicBox[ToBoxes[
                FEPrivate`FrontEndResource[
                "ChatbookStrings", "FormattingToolUsed"], StandardForm],
               
               ImageSizeCache->{
                30.095001876354218`, {0.15600000572204564`, 
                 9.256000339508056}}],
              StripOnInput->False,
              FontColor->RGBColor[0.53214525, 0.6238195470000001, 0.67275]], 
             StyleBox["\<\"Create Notebook\"\>",
              StripOnInput->False,
              FontWeight->"DemiBold",
              FontColor->RGBColor[0.53214525, 0.6238195470000001, 0.67275]], 
             PaneSelectorBox[{True->
              TemplateBox[{
                RGBColor[0.55893535, 0.7525889017999999, 0.85595]},
               "DiscardedMaterialCloserIcon"], False->
              TemplateBox[{
                RGBColor[0.55893535, 0.7525889017999999, 0.85595]},
               "DiscardedMaterialOpenerIcon"]}, Dynamic[Typeset`var$$],
              BaselinePosition->Baseline,
