           "]"}]}], "]"}], ",", "z"}], "]"}]}], "\[IndentingNewLine]", "   ", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eulerR", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"lagrangianRegularized", ",", 
        RowBox[{"r", "[", 
