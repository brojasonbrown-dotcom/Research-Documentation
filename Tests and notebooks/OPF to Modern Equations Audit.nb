                    FilledCurveBox[{{{0, 2, 0}, {0, 1, 0}, {0, 1, 0}}, {{0, 2,
                     0}, {0, 1, 0}, {0, 1, 0}}, {{0, 2, 0}, {0, 1, 0}, {0, 1, 
                    0}}, {{0, 2, 0}, {0, 1, 0}, {0, 1, 0}}}, {{{8.25, 
                    14.25}, {14.25, 14.25}, {14.25, 13.5}, {8.25, 13.5}}, {{
                    8.25, 12.}, {14.25, 12.}, {14.25, 11.25}, {8.25, 
                    11.25}}, {{8.25, 9.75}, {14.25, 9.75}, {14.25, 9.}, {8.25,
                     9.}}, {{8.25, 7.5}, {14.25, 7.5}, {14.25, 6.75}, {8.25, 
                    6.75}}}]}, ImageSize -> 11], "\"Copy to clipboard.\""}}, 
                    GridBoxAlignment -> {
                    "Columns" -> {{Left}}, "Rows" -> {{Center}}}, AutoDelete -> 
                    False, GridBoxItemSize -> {
                    "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}, 
                    GridBoxSpacings -> {"Columns" -> {{0.4}}}], "Grid"], 
                    "Text", FontColor -> 
                    RGBColor[0.5372549019607843, 0.5372549019607843, 
                    0.5372549019607843], FontSize -> 12, FontWeight -> 
                    "Plain", StripOnInput -> False], TraditionalForm]], {0, 
                    4}], 
                    EdgeForm[
                    RGBColor[
                    0.9607843137254902, 0.9607843137254902, 
                    0.9607843137254902]], 
                    PolygonBox[{{-2, 0}, {2, 0}, {0, -2}}], 
                    RGBColor[
                    0.8980392156862745, 0.8980392156862745, 
                    0.8980392156862745], 
                    LineBox[{{-3, 0}, {-2, 0}, {0, -2}, {2, 0}, {3, 0}}]}, 
                    ImageSize -> {Automatic, 40}, Background -> None]], 
                    Background -> None], {
                    Offset[{0, 1}, 5], {Center, Top}}, {Center, Bottom}, 
                    "ClosingActions" -> {
                    "ParentChanged", "EvaluatorQuit", "OutsideMouseClick"}]]),
                     "MouseExited" :> 
