 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"No measurement\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"c10b12bf-1862-8141-8953-6e5b7cae8b07"],
 "\nhigh coherence: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["I", "TI"], "\[LongEqual]", "|", 
         SubscriptBox["\[Psi]", "1"], "+", 
         SubscriptBox["\[Psi]", "2"], 
         SuperscriptBox["|", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "I = |\\psi_1+\\psi_2|^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "052f1b10-bd8d-3f48-b2c0-713cb47db2c7"],
 "\n",
 Cell[BoxData[
  PaneBox[
   StyleBox["\<\"Partial measurement\"\>", "Section",
    CellFrame->0,
    ShowStringCharacters->False,
    FontSize->22],
   ImageMargins->{{0, 0}, {5, 15}}]], "InlineSection",
  Background->None,ExpressionUUID->"11dbc076-b873-6744-a5b3-e4ece2bbc03b"],
 "\npartial decoherence: \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["I", "TI"], "\[LongEqual]", "|", 
         SubscriptBox["\[Psi]", "1"], 
         SuperscriptBox["|", "2"], "+", "|", 
         SubscriptBox["\[Psi]", "2"], 
         SuperscriptBox["|", "2"], "+", "2", "\[Gamma]", "\[GothicCapitalR]", 
         RowBox[{"(", 
