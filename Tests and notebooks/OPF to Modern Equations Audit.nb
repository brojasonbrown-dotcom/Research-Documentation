Cell[CellGroupData[{

Cell["5. Variational Form in Modern Structure", "Section",ExpressionUUID->"fc85304e-6aa6-d347-8945-93449930de1c"],

Cell[TextData[{
 "For modern symbolic workflows, it is often useful to preserve operators \
with ",
 ButtonBox["Inactive",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Inactive"],
 " before activation. "
}], "Text",ExpressionUUID->"8b134e83-5893-974b-9d3f-44ad648a0dde"],

Cell[BoxData[
 RowBox[{
  RowBox[{"inactiveEulerSystem", "=", 
   RowBox[{"Inactivate", "[", 
    RowBox[{"eulerSystem", ",", "D"}], "]"}]}], ";"}]], "Input",ExpressionUUID\
->"08722a56-cd48-9540-bc6e-96e20e99e4f9"],

Cell["\<\
You can inspect the inactive structure first and then activate it: \
\>", "CodeText",ExpressionUUID->"f4529618-6733-f74e-a1dc-3918df03a536"],

Cell[BoxData[
 RowBox[{
  RowBox[{"activatedEulerSystem", "=", 
   RowBox[{"Activate", "[", "inactiveEulerSystem", "]"}]}], ";"}]], "Input",Ex\
pressionUUID->"5746cd4f-619b-664b-81c5-34a33443c84d"],

Cell["\<\
This mirrors modern symbolic PDE workflows used for wave-equation derivations \
and operator manipulations. \
\>", "Text",ExpressionUUID->"da448c58-1448-4245-b304-1d69fb17390b"],

