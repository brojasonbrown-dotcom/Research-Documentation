Cell[CellGroupData[{

Cell["4. Explicit Euler-Lagrange System", "Section",ExpressionUUID->"0f9df9c4-3193-2444-be62-cdec5a938e57"],

Cell["\<\
This section keeps your explicit per-field construction, which is robust and \
auditable. \
\>", "Text",ExpressionUUID->"201c6080-2107-0449-b334-06e7084e8bb1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eulerRho", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"lagrangianRegularized", ",", 
        RowBox[{"\[Rho]", "[", 
         RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}], "]"}], "-", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"lagrangianRegularized", ",", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Rho]", "[", 
             RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "t"}], 
           "]"}]}], "]"}], ",", "t"}], "]"}], "-", "\[IndentingNewLine]", 
      "    ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"lagrangianRegularized", ",", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Rho]", "[", 
             RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "x"}], 
           "]"}]}], "]"}], ",", "x"}], "]"}], "-", "\[IndentingNewLine]", 
      "    ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"lagrangianRegularized", ",", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Rho]", "[", 
             RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "y"}], 
           "]"}]}], "]"}], ",", "y"}], "]"}], "-", "\[IndentingNewLine]", 
      "    ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"lagrangianRegularized", ",", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Rho]", "[", 
             RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "z"}], 
           "]"}]}], "]"}], ",", "z"}], "]"}]}], "\[IndentingNewLine]", "   ", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eulerChi", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"lagrangianRegularized", ",", 
        RowBox[{"\[Chi]", "[", 
         RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}], "]"}], "-", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"lagrangianRegularized", ",", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Chi]", "[", 
             RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "t"}], 
           "]"}]}], "]"}], ",", "t"}], "]"}], "-", "\[IndentingNewLine]", 
      "    ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"lagrangianRegularized", ",", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Chi]", "[", 
             RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "x"}], 
           "]"}]}], "]"}], ",", "x"}], "]"}], "-", "\[IndentingNewLine]", 
      "    ", 
      RowBox[{"D", "[", 
