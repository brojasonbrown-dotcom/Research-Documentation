Cell[CellGroupData[{

Cell["11. PDE Form Compatible with Modern Equation Operators", "Section",ExpressionUUID->"088c8f33-6bbf-9440-b6b6-70a09cfbebf0"],

Cell[TextData[{
 "A modern PDE workflow often uses ",
 ButtonBox["Laplacian",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Laplacian"],
 ", ",
 ButtonBox["Div",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Div"],
 ", ",
 ButtonBox["Curl",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Curl"],
 ", and inactive operators."
}], "Text",ExpressionUUID->"98786507-eb1f-d54b-bb06-f36d6e5b2efb"],

Cell["\<\
For scalar-field rewriting, define a purely spatial Laplacian: \
\>", "CodeText",ExpressionUUID->"56552034-a7ed-114d-adb4-66cfebcb13fd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"spatialLaplacian", "[", "f_", "]"}], ":=", 
   RowBox[{"Laplacian", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], ";"}]], "Input",Exp\
ressionUUID->"d736f173-904d-7747-82ee-4d4967265750"],

Cell["A Klein-Gordon-like prototype for comparison: ", "CodeText",ExpressionUUID->"406afe57-76b0-054b-85aa-336c98f0d9f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"kgPrototype", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[CapitalPsi]", "[", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "-", 
     RowBox[{"Laplacian", "[", 
      RowBox[{
       RowBox[{"\[CapitalPsi]", "[", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "+", 
     RowBox[{
      RowBox[{"m", "^", "2"}], " ", 
      RowBox[{"\[CapitalPsi]", "[", 
       RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}]}], "==", "0"}]}], 
  ";"}]], "Input",ExpressionUUID->"188cc3b1-5248-524e-9ad7-582340724c1f"],

