Cell[CellGroupData[{

Cell["13. Residual Validation", "Section",ExpressionUUID->"5a2b560f-9316-7548-8012-2880eaa66d46"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"residualVector", "[", 
     RowBox[{"\[Rho]cand_", ",", "\[Chi]cand_", ",", "rcand_"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"SubtractSides", " ", "/@", " ", "eulerSystem"}], ")"}], " ", "/.",
       " ", 
      RowBox[{"{", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"\[Rho]", "->", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
           "\[Rho]cand"}], "]"}]}], ",", "\[IndentingNewLine]", "      ", 
        RowBox[{"\[Chi]", "->", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
           "\[Chi]cand"}], "]"}]}], ",", "\[IndentingNewLine]", "      ", 
        RowBox[{"r", "->", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
           "rcand"}], "]"}]}]}], "\[IndentingNewLine]", "      ", "}"}]}], 
     "\[IndentingNewLine]", "   ", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trivialResidualCheck", "=", 
   RowBox[{"residualVector", "[", 
    RowBox[{"0", ",", "1", ",", "0"}], "]"}]}], ";"}]}], "Input",ExpressionUUI\
D->"455bcdf7-70c3-9c43-a2c8-a07b5cd03d9c"],

