 RowBox[{
  RowBox[{
   RowBox[{"opfUnmapped", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<incommensurate measurement activation\>\"", 
       "->", "\"\<The 'if not measured requires measurement'      rule is not \
in the Lagrangian. It would need an event-driven field update operator;      \
no standard PDE framework has one.\>\""}], ",", 
      RowBox[{"\"\<scale-anomaly covariance (b-sector)\>\"", 
       "->", "\"\<F7 shows Log[\[Chi]] has a b \[CenterDot]\n   \[Sigma]      \
term that only cancels in the b=0 sector. No modern equation in section 18 \
carries this      asymmetry. Candidate target: anomalous dimension in \
RG.\>\""}], ",", 
      RowBox[{"\"\<Confidence Corridor dynamics\>\"", 
       "->", "\"\<Operational learning layer. Does not derive\n        from a \
Lagrangian. Lives in the AdaptiveConformal / adaptive control family instead.\
\>\""}], ",", 
      RowBox[{"\"\<intelligence as structural attribute\>\"", 
       "->", "\"\<Metaphysical commitment, not an equation.      Keep in the \
ontology notes; do not try to force it into a PDE.\>\""}]}], "|>"}]}], ";"}], 
