Cell[CellGroupData[{

Cell["18. Modern PDE Building Blocks", "Section",ExpressionUUID->"913bcd29-eadc-d941-b95e-1fce83411cd4"],

Cell["Useful modern structures to save and reuse: ", "CodeText",ExpressionUUID->"f9d6ab1b-d91b-5f4f-9d89-c07d3900fb15"],

Cell[BoxData[
 RowBox[{
  RowBox[{"modernEquationLibrary", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\"\<WaveEquation\>\"", "->", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "==", 
       RowBox[{
        RowBox[{"cWave", "^", "2"}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<HeatEquation\>\"", "->", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
       RowBox[{"\[Kappa]", " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<KleinGordon\>\"", "->", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[CapitalPsi]", "[", 
           RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "-", 
        RowBox[{"Laplacian", "[", 
         RowBox[{
          RowBox[{"\[CapitalPsi]", "[", 
           RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "+", 
        RowBox[{
         RowBox[{"m", "^", "2"}], " ", 
         RowBox[{"\[CapitalPsi]", "[", 
          RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}]}], "==", 
       "0"}]}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<Schrodinger\>\"", "->", 
      RowBox[{
       RowBox[{"I", " ", "\[HBar]", " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Psi]", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}]}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[HBar]", "^", "2"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "m"}], ")"}]}], ")"}]}], " ", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"\[Psi]", "[", 
            RowBox[{"x", ",", "t"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"V", "[", "x", "]"}], " ", 
         RowBox[{"\[Psi]", "[", 
          RowBox[{"x", ",", "t"}], "]"}]}]}]}]}], ",", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{"\"\<Poisson\>\"", "->", 
      RowBox[{
       RowBox[{"Laplacian", "[", 
        RowBox[{
         RowBox[{"\[Phi]", "[", 
          RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "==", 
       RowBox[{"src", "[", 
        RowBox[{"x", ",", "y", ",", "z"}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<Helmholtz\>\"", "->", 
      RowBox[{
       RowBox[{
        RowBox[{"Laplacian", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "+", 
        RowBox[{
         RowBox[{"k", "^", "2"}], " ", 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "y", ",", "z"}], "]"}]}]}], "==", "0"}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<AdvectionDiffusion\>\"", "->", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "+", 
        RowBox[{"vAdv", " ", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"x", ",", "t"}], "]"}], ",", "x"}], "]"}]}]}], "==", 
       RowBox[{"\[Kappa]", " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"u", "[", 
           RowBox[{"x", ",", "t"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<ReactionDiffusion\>\"", "->", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], ",", "t"}], "]"}], "==", 
       RowBox[{
        RowBox[{"d", " ", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"u", "[", 
            RowBox[{"x", ",", "t"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], "+", 
        RowBox[{"f", "[", 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], "]"}]}]}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<DampedOscillator\>\"", "->", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
        RowBox[{"2", " ", "\[Zeta]", " ", "\[Omega]n", " ", 
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
        RowBox[{
         RowBox[{"\[Omega]n", "^", "2"}], " ", 
         RowBox[{"x", "[", "t", "]"}]}]}], "==", "0"}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<MaintenanceLaw\>\"", "->", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "t", "]"}], ",", "t"}], "]"}], "+", 
        RowBox[{"\[CapitalGamma]", " ", 
         RowBox[{"\[Phi]", "[", "t", "]"}]}]}], "==", "0"}]}]}], 
    "\[IndentingNewLine]", "   ", "|>"}]}], ";"}]], "Input",ExpressionUUID->\
"064002f9-b43a-3c4f-9c71-5d910c3e5260"],

