        RowBox[{"D", "[", 
         RowBox[{"lagrangianRegularized", ",", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Chi]", "[", 
             RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "y"}], 
           "]"}]}], "]"}], ",", "y"}], "]"}], "-", "\[IndentingNewLine]", 
      "    ", 
