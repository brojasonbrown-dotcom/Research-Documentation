Cell[CellGroupData[{

Cell["6. Hidden-Constraint Solve", "Section",ExpressionUUID->"861ace2b-756d-7543-8a72-cb2d9a6e0e1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hiddenConstraints", "=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{"Solve", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"eulerSystem", " ", "/.", " ", 
       RowBox[{"{", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"2", ",", "0", ",", "0", ",", "0"}], "]"}], "[", "f_", 
            "]"}], "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ":>", "0"}], ",",
          "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"0", ",", "2", ",", "0", ",", "0"}], "]"}], "[", "f_", 
            "]"}], "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ":>", "0"}], ",",
          "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"0", ",", "0", ",", "2", ",", "0"}], "]"}], "[", "f_", 
            "]"}], "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ":>", "0"}], ",",
          "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"0", ",", "0", ",", "0", ",", "2"}], "]"}], "[", "f_", 
            "]"}], "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ":>", "0"}]}], 
        "\[IndentingNewLine]", "      ", "}"}]}], ",", "\[IndentingNewLine]", 
      "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Rho]", "[", 
         RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
        RowBox[{"\[Chi]", "[", 
         RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
        RowBox[{"r", "[", 
         RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "    ", "Reals", ",", "\[IndentingNewLine]", 
      "    ", 
      RowBox[{"MaxExtraConditions", "->", "All"}]}], "\[IndentingNewLine]", 
     "    ", "]"}], "\[IndentingNewLine]", "   ", "]"}]}], ";"}]], "Input",Exp\
ressionUUID->"44238ba8-eec8-d543-b4dc-fec131ac847a"],

