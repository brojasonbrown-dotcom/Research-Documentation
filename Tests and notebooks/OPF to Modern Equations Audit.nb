Cell[CellGroupData[{

Cell["Pole/stability region tools", "Subsection",ExpressionUUID->"23215bcf-2f09-ec43-a9cb-d0b32cca2035"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dStabilityTemplate", "=", 
   RowBox[{"DStabilityConditions", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x1", "'"}], "[", "t", "]"}], "==", 
        RowBox[{"x2", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"x2", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "a"}], " ", 
          RowBox[{"x1", "[", "t", "]"}]}], "-", 
         RowBox[{"b", " ", 
          RowBox[{"x2", "[", "t", "]"}]}]}]}]}], "\[IndentingNewLine]", 
      "    ", "}"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"x1", ",", "x2"}], "}"}], ",", "\[IndentingNewLine]", "   ", 
     "t"}], "\[IndentingNewLine]", "   ", "]"}]}], ";"}]], "Input",ExpressionU\
UID->"e023308c-cda0-a348-a161-007d8c5681a6"]
}, Open  ]],

