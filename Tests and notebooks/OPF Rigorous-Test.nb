Cell[CellGroupData[{

Cell["15. How this framework could be misunderstood", "Section",ExpressionUUID->"f20249de-103d-3b44-8b0b-c02366c18d30"],

Cell[CellGroupData[{

Cell["Common misunderstanding modes", "Subsection",ExpressionUUID->"0623a0d9-7361-ad4a-bdd1-c96e84b5a021"],

Cell[TextData[StyleBox["Mathematical existence mistaken for physical reality",
 FontWeight->Bold]], "Item",ExpressionUUID->"1a890bec-5786-384c-8352-\
c9b01bd1b865"],

Cell[TextData[StyleBox["Scale recursion mistaken for empirical \
renormalization evidence",
 FontWeight->Bold]], "Item",ExpressionUUID->"c58f111e-186f-ac41-b45e-\
fa6c5ac8bb64"],

Cell[TextData[StyleBox["Self-consistency mistaken for consciousness",
 FontWeight->Bold]], "Item",ExpressionUUID->"a7619476-11d2-6744-92d3-\
8a2b11561eb8"],

Cell[TextData[StyleBox["Information treated as energy without a measurement \
map or units",
 FontWeight->Bold]], "Item",ExpressionUUID->"6a947a6c-8056-9d44-aaf4-\
fe84c2850f44"],

Cell[TextData[StyleBox["Golden-ratio proximity mistaken for universality",
 FontWeight->Bold]], "Item",ExpressionUUID->"2fb8ede0-1f06-534b-9b4f-\
b084b6e149e6"],

Cell[TextData[StyleBox["Symbolic elegance mistaken for explanatory \
sufficiency",
 FontWeight->Bold]], "Item",ExpressionUUID->"2882ac12-66c3-f344-83ed-\
1534630bfdef"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Explicit distinction to maintain", "Subsection",ExpressionUUID->"ecfa4b8e-7363-6341-989c-98e1ed865d92"],

Cell[TextData[{
 StyleBox["information", "TI"],
 " is not automatically ",
 StyleBox["energy", "TI"]
}], "Item",ExpressionUUID->"1fbe181d-d34a-0347-a914-06975f052dc5"],

Cell[TextData[{
 Cell[BoxData[Cell["variational action",
   Background->None,ExpressionUUID->"4299de00-47e1-d049-b456-de582359abe5"]], 
  "InlineCode",ExpressionUUID->"5f8fb41f-94a6-804b-b4b5-3875e7bcbbee"],
 " is not automatically a physical action with dimensions"
}], "Item",ExpressionUUID->"6c4ee565-cf14-0c49-8a04-7da74857ffda"],

Cell[TextData[{
 Cell[BoxData[Cell["fixed point",
   Background->None,ExpressionUUID->"5b1466c9-8ee5-3b48-a653-beda91f9e441"]], 
  "InlineCode",ExpressionUUID->"1e4783ea-94e2-ce4a-ad04-4ddad1c0788b"],
 " is not automatically an ontological ground state"
}], "Item",ExpressionUUID->"3da9648e-79ff-6c4a-b948-f55a2a00416f"],

Cell[TextData[{
 StyleBox["observer", "TI"],
 " in equations is not automatically a conscious observer"
}], "Item",ExpressionUUID->"4a4df6c5-a43f-074c-9df0-55ff10889aeb"],

