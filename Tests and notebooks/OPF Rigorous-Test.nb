Cell[CellGroupData[{

Cell["10. Linearization around homogeneous backgrounds", "Section",ExpressionUUID->"06e0513f-1ea6-9743-9a74-6189ec9664ff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"perturbationRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"rho0", "+", 
        RowBox[{"epsilon", " ", 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"chi0", "+", 
        RowBox[{"epsilon", " ", 
         RowBox[{"v", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"res0", "+", 
        RowBox[{"epsilon", " ", 
         RowBox[{"w", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}]}]}]}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearizedEquations", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Normal", " ", "@", " ", 
       RowBox[{"Series", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Subtract", " ", "@@@", " ", "fieldEquations"}], ")"}], 
          " ", "/.", " ", "perturbationRules"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"{", 
          RowBox[{"epsilon", ",", "0", ",", "1"}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}], " ", "/.", " ", 
      RowBox[{"epsilon", "->", "1"}]}], " ", "//", " ", "Expand"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
  RowBox[{"Thread", "[", 
   RowBox[{"linearizedEquations", "==", "0"}], "]"}], "]"}]}], "Input",Express\
ionUUID->"599c3d71-afde-f34d-8cdd-624df5830473"],

Cell[CellGroupData[{

Cell["Modal ansatz", "Subsection",ExpressionUUID->"21606c8f-8d87-6c4c-9bb1-c90a2c852e6e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"modeRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"ur", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"v", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"vr", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"w", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"wr", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modeSystem", "=", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"linearizedEquations", " ", "/.", " ", "modeRules"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"$Assumptions", "&&", 
        RowBox[{"kx", " ", "\[Element]", " ", "Reals"}], "&&", 
        RowBox[{"ks", " ", "\[Element]", " ", "Reals"}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stiffnessMatrix", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CoefficientArrays", "[", 
      RowBox[{"modeSystem", ",", 
       RowBox[{"{", 
        RowBox[{"ur", ",", "vr", ",", "wr"}], "}"}]}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}], " ", "//", " ", "Normal"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "stiffnessMatrix", "]"}]}], "Input",ExpressionUUID\
->"554bb0a8-7e83-4a49-bc01-82f0ad808b84"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Dispersion condition", "Subsection",ExpressionUUID->"7bb20077-adb5-1b4a-b77a-da667c77aa79"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dispersionDet", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Det", "[", "stiffnessMatrix", "]"}], ",", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", "dispersionDet"}], "Input",ExpressionUUID->\
"08acd33e-bcf2-454b-a406-5178f617067b"],

Cell["This gives the condition for nontrivial perturbative modes. ", "Text",ExpressionUUID->"87329406-f3a5-1c49-b1b7-e1faf49479f2"],

Cell[BoxData[
