Cell[CellGroupData[{

Cell["3. Clean setup", "Section",ExpressionUUID->"9910ca53-6c55-674f-bdf8-432f67399ef6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Remove", "[", "VariationalD", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Needs", "[", "\"\<VariationalMethods`\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"assumptionList", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"alpha", ">", "0"}], ",", 
      RowBox[{"beta", ">", "0"}], ",", 
      RowBox[{"gamma", ">", "0"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"eta", ">", "0"}], ",", 
      RowBox[{"zeta", ">", "0"}], ",", 
      RowBox[{"xi", ">", "0"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"delta", " ", "\[Element]", " ", "Reals"}], ",", 
      RowBox[{"lambda", " ", "\[Element]", " ", "Reals"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"x", " ", "\[Element]", " ", "Reals"}], ",", 
      RowBox[{"sigma", " ", "\[Element]", " ", "Reals"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"rho0", " ", "\[Element]", " ", "Reals"}], ",", 
      RowBox[{"chi0", ">", "0"}], ",", 
      RowBox[{"res0", " ", "\[Element]", " ", "Reals"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"epsilon", " ", "\[Element]", " ", "Reals"}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"And", " ", "@@", " ", "assumptionList"}]}], ";"}]}], "Input",Expre\
ssionUUID->"9c08ad47-d8cb-324c-a497-021fa40cc02a"],

