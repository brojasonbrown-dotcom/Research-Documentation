Cell[CellGroupData[{

Cell["6. Homogeneous stationary sector", "Section",ExpressionUUID->"b1a6934c-cbc7-0340-ad81-313366dd7452"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"homogeneousRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "rho0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "chi0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "res0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"homogeneousEquations", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"fieldEquations", " ", "/.", " ", "homogeneousRules"}], ",", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", "homogeneousEquations", "]"}]}], "Input",ExpressionUUID->"6c8505a8-e65b-de4f-9ccd-e7e642f38270"],

Cell[CellGroupData[{

Cell["Correct fixed-point solve", "Subsection",ExpressionUUID->"62553c5f-bd60-2f42-80ee-52065f58b729"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fixedPoints", "=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"Reduce", "[", 
      RowBox[{"homogeneousEquations", ",", 
       RowBox[{"{", 
        RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", "Reals"}], 
      "]"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"chi0", ">", "0"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", "fixedPoints"}], "Input",ExpressionUUID->\
"1ca1555e-b1e2-f64c-bc5c-dcafd33b63e6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Solve explicitly when possible", "Subsection",ExpressionUUID->"7d98f774-417a-f24f-be4e-6cff86850ec1"],

Cell[BoxData[
 RowBox[{"fixedPointRules", "=", 
  RowBox[{
   RowBox[{"Solve", "[", 
    RowBox[{"homogeneousEquations", ",", 
     RowBox[{"{", 
      RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", "Reals"}], 
    "]"}], " ", "//", " ", "FullSimplify"}]}]], "Input",ExpressionUUID->\
"4e3e295e-92f8-5b4f-916a-98b9d4a52e00"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visualize the potential in the homogeneous sector", "Subsection",ExpressionUUID->"26e96804-d5e9-dd41-b39c-7234a87b61d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"homogeneousPotential", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"rho0", " ", 
     RowBox[{"Log", "[", "chi0", "]"}]}], "+", 
    RowBox[{"chi0", " ", 
     RowBox[{"res0", "^", "2"}]}], "+", 
    RowBox[{"delta", " ", "rho0", " ", "chi0", " ", "res0"}], "+", 
    RowBox[{"lambda", " ", 
     RowBox[{"rho0", "^", "2"}]}]}]}], ";"}]], "Input",ExpressionUUID->\
"45c6dafd-82a6-d44b-a7f4-869a6990fa96"],

Cell["For slices with chosen parameter values: ", "CodeText",ExpressionUUID->"39a96504-9efa-c447-926b-c2489473d726"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"deltaVal", "=", "1"}], ",", 
     RowBox[{"lambdaVal", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
   " ", 
   RowBox[{"ContourPlot", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"homogeneousPotential", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"delta", "->", "deltaVal"}], ",", 
         RowBox[{"lambda", "->", "lambdaVal"}], ",", 
         RowBox[{"res0", "->", "0"}]}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"rho0", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"chi0", ",", "0.1", ",", "3"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"PlotLegends", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<rho0\>\"", ",", "\"\<chi0\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
     "PlotLabel", "->", "\"\<Homogeneous potential slice at res0 = 0\>\""}]}],
     "\[IndentingNewLine]", " ", "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"f3b3c63a-a8e6-394e-a973-738cb1202dab"],

