Cell[CellGroupData[{

Cell["16. Do we know what these things actually are?", "Section",ExpressionUUID->"5282fe66-a499-fc47-ae95-d92abd06c4ab"],

Cell["This notebook should keep four levels distinct:", "Text",ExpressionUUID->"bab204b5-155a-cd48-a007-3b34275fb83b"],

Cell[TextData[{
 "1. ",
 StyleBox["Syntax",
  FontWeight->Bold],
 ": symbols such as ",
 StyleBox["rho", "TI"],
 ", ",
 StyleBox["chi", "TI"],
 ", ",
 StyleBox["res", "TI"],
 "."
}], "Text",ExpressionUUID->"ad8acc00-4c1a-824c-9aa6-64b81b5f259e"],

Cell[TextData[{
 "2. ",
 StyleBox["Semantics",
  FontWeight->Bold],
 ": what those symbols are intended to represent."
}], "Text",ExpressionUUID->"157a6d9e-9892-484e-829e-cb188fd3398f"],

Cell[TextData[{
 "3. ",
 StyleBox["Operationalization",
  FontWeight->Bold],
 ": how they would be measured or inferred."
}], "Text",ExpressionUUID->"afbd2019-f73d-a443-bd1c-d585a5ebed79"],

Cell[TextData[{
 "4. ",
 StyleBox["Ontology",
  FontWeight->Bold],
 ": what exists independently of description."
}], "Text",ExpressionUUID->"528b30e5-82aa-ce4b-bd57-f878e50271fa"],

Cell["\<\
A rigorous framework needs all four. Most speculative frameworks become \
ambiguous by moving too quickly from level 1 to level 4. \
\>", "Text",ExpressionUUID->"2e0ca473-11ba-ab43-9852-75a11da8fbc7"],

