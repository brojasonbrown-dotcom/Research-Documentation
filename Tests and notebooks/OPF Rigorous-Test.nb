Cell[CellGroupData[{

Cell["5. Rigorous Euler\[Dash]Lagrange derivation", "Section",ExpressionUUID->"11dc63b4-fd8d-3246-94d5-2ca719dca607"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eulerRho", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"VariationalD", "[", 
        RowBox[{"lagrangianDensity", ",", 
         RowBox[{"rho", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eulerChi", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"VariationalD", "[", 
        RowBox[{"lagrangianDensity", ",", 
         RowBox[{"chi", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eulerRes", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"VariationalD", "[", 
        RowBox[{"lagrangianDensity", ",", 
         RowBox[{"res", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fieldEquations", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eulerRho", ",", "eulerChi", ",", "eulerRes"}], "}"}], "==", 
     "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", "fieldEquations", "]"}]}], "Input",ExpressionUUID->\
"b8398662-ed01-b744-b935-329edd36e8dc"],

Cell[CellGroupData[{

Cell["Cross-check with a manual Euler\[Dash]Lagrange operator", "Subsection",ExpressionUUID->"f1638ef8-9fde-5f41-a480-7a40525ae1f5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "eulerOperator", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"eulerOperator", "[", 
     RowBox[{"lag_", ",", "field_"}], "]"}], ":=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"lag", ",", "field"}], "]"}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"lag", ",", 
           RowBox[{"D", "[", 
            RowBox[{"field", ",", "x"}], "]"}]}], "]"}], ",", "x"}], "]"}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"lag", ",", 
           RowBox[{"D", "[", 
            RowBox[{"field", ",", "sigma"}], "]"}]}], "]"}], ",", "sigma"}], 
        "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"manualRho", "=", 
   RowBox[{"eulerOperator", "[", 
    RowBox[{"lagrangianDensity", ",", 
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"manualChi", "=", 
   RowBox[{"eulerOperator", "[", 
    RowBox[{"lagrangianDensity", ",", 
     RowBox[{"chi", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"manualRes", "=", 
    RowBox[{"eulerOperator", "[", 
     RowBox[{"lagrangianDensity", ",", 
      RowBox[{"res", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"eulerRho", "==", "manualRho"}], ",", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"eulerChi", "==", "manualChi"}], ",", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"eulerRes", "==", "manualRes"}], ",", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}]}], 
  "\[IndentingNewLine]", "}"}]}], "Input",ExpressionUUID->"aae63722-7486-1241-\
924f-2e23226aa9d9"],

Cell[TextData[{
 "This should return three ",
 ButtonBox["True",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/True"],
 " values. If it does not, the derivation pipeline is not trustworthy. "
}], "Text",ExpressionUUID->"b5de30f7-afb6-df46-8631-b9ebda54ea8b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Comparison with the source notebook output", "Subsection",ExpressionUUID->"770d9231-56ef-2540-be89-86ae79c28a82"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sourceClaimedEquations", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "]"}], ",", "\[IndentingNewLine]",
       "  ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"res", "[", 
           RowBox[{"x", ",", "sigma"}], "]"}]}], "+", 
         RowBox[{"delta", " ", 
          RowBox[{"rho", "[", 
           RowBox[{"x", ",", "sigma"}], "]"}]}]}], ")"}]}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"comparisonTable", "=", 
   RowBox[{"Grid", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Prepend", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"MapThread", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", "        ", 
           RowBox[{
           "#1", ",", "\[IndentingNewLine]", "        ", "#2", ",", 
            "\[IndentingNewLine]", "        ", 
            RowBox[{"Simplify", "[", 
             RowBox[{
              RowBox[{"#1", "==", "#2"}], ",", 
              RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}]}], 
           "\[IndentingNewLine]", "      ", "}"}], " ", "&"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"eulerRho", ",", "eulerChi", ",", "eulerRes"}], "}"}], ",",
            "sourceClaimedEquations"}], "}"}]}], "\[IndentingNewLine]", 
        "    ", "]"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"{", 
        RowBox[{"\"\<Derived here\>\"", ",", "\"\<Claimed in source\>\"", 
         ",", "\"\<Equivalent?\>\""}], "}"}]}], "\[IndentingNewLine]", "  ", 
      "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Frame", "->", "All"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", "comparisonTable"}], "Input",ExpressionUUID->\
"e55cf7e8-fced-2b47-b523-c391f485fb61"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
