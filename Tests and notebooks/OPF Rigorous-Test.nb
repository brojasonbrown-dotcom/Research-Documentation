Cell[CellGroupData[{

Cell["13. Probe claim ledger", "Section",ExpressionUUID->"95f34b65-aedd-3e41-b872-9c83542150c6"],

Cell["\<\
This section records claims and the evidence standard required. \
\>", "Text",ExpressionUUID->"da2d8921-103b-874a-9e97-c0414fa59acb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"claimsLedger", "=", 
    RowBox[{"Dataset", "[", 
     RowBox[{"{", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Probe\>\"", "->", "\"\<Equation Foundry\>\""}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<2046 equations generated and scored\>\""}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<MinimumEvidenceNeeded\>\"", 
          "->", "\"\<Generator definition, exact term library, scoring \
function, reproducible dataset\>\""}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StatusInThisNotebook\>\"", 
          "->", "\"\<Partially testable\>\""}]}], "\[IndentingNewLine]", "  ",
         "|>"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Probe\>\"", "->", "\"\<KL rediscovered\>\""}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<Search independently finds KL winner\>\""}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<MinimumEvidenceNeeded\>\"", 
          "->", "\"\<Enumeration code and ranking output\>\""}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StatusInThisNotebook\>\"", 
          "->", "\"\<Directly testable\>\""}]}], "\[IndentingNewLine]", "  ", 
        "|>"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Probe\>\"", 
          "->", "\"\<Original potential scored zero\>\""}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<unstable, unbounded, non-homogeneous\>\""}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<MinimumEvidenceNeeded\>\"", 
          "->", "\"\<Stability, boundedness, homogeneity tests\>\""}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StatusInThisNotebook\>\"", 
          "->", "\"\<Directly testable\>\""}]}], "\[IndentingNewLine]", "  ", 
        "|>"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Probe\>\"", "->", "\"\<Torus-Koopman\>\""}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<incommensurable torus recovered by exact DMD\>\""}], ",",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<MinimumEvidenceNeeded\>\"", 
          "->", "\"\<Trajectory generator, DMD code, spectral recovery \
error\>\""}], ",", "\[IndentingNewLine]", "    ", 
