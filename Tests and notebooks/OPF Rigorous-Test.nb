    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"22922c61-2ea5-b245-a4cc-27c2b962d4e0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
17. Information and energy: how to test the claim rather than assert it\
\>", "Section",ExpressionUUID->"7cf32577-d754-4c4b-b794-5d3e935c0a8a"],

Cell["\<\
If the framework wants to claim that information arises as energy or energy \
is information-like, the notebook should require: \
\>", "Text",ExpressionUUID->"cb5384cd-48f3-4b45-9f28-c460f283b1f7"],

Cell["a dimensional map,", "Item",ExpressionUUID->"d217b93f-68d4-5449-af85-a5f11d47b653"],

Cell["an operational observable,", "Item",ExpressionUUID->"be1fca30-0002-7140-afc2-986ba598ab21"],

Cell["a conserved quantity or balance law,", "Item",ExpressionUUID->"555e5d92-05b0-ab41-bd97-15ad96ce008e"],

Cell["\<\
and a transformation rule linking information-theoretic and energetic \
functionals.\
\>", "Item",ExpressionUUID->"5acc6577-1338-064b-93b3-96506e256b37"],

Cell["A prototype test scaffold: ", "CodeText",ExpressionUUID->"617ccf0e-e4b7-0647-80bf-1645cecf99d4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "informationFunctional", ",", "energyFunctional", ",", 
     "informationEnergyBridge"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"informationFunctional", "[", 
    RowBox[{"r_", ",", "c_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"r", " ", 
     RowBox[{"Log", "[", 
      RowBox[{"r", "/", "c"}], "]"}]}], "-", "r", "+", "c"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"energyFunctional", "[", 
    RowBox[{"c_", ",", "s_"}], "]"}], ":=", 
   RowBox[{"c", " ", 
    RowBox[{"s", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"informationEnergyBridge", "[", 
     RowBox[{"r_", ",", "c_", ",", "s_"}], "]"}], ":=", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"informationFunctional", "[", 
          RowBox[{"r", ",", "c"}], "]"}], ",", "r"}], "]"}], "==", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"energyFunctional", "[", 
          RowBox[{"c", ",", "s"}], "]"}], ",", "s"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"c", ">", "0"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"informationEnergyBridge", "[", 
  RowBox[{"rho0", ",", "chi0", ",", "res0"}], "]"}]}], "Input",ExpressionUUID->\
"5e0747bc-a586-8349-8302-185aa4a7cee8"],

Cell[TextData[{
 "This does ",
 StyleBox["not",
  FontWeight->Bold],
 " prove equivalence; it only exemplifies the kind of explicit bridge needed. "
}], "Text",ExpressionUUID->"978be37b-5ee8-3d40-ae34-de51b56ad74f"],

