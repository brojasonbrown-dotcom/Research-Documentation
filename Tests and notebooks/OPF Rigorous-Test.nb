Cell[CellGroupData[{

Cell["2. Audit of the supplied notebook: immediate issues", "Section",ExpressionUUID->"1491ed90-1f02-9b48-ade6-3511eb17dd51"],

Cell[CellGroupData[{

Cell["\<\
2.1 Potentially misleading conclusions in the source notebook\
\>", "Subsection",ExpressionUUID->"54968ffc-376d-d340-86fe-a26c9b527602"],

Cell["\<\
The source notebook appears to conclude that the Euler\[Dash]Lagrange \
equations are: \
\>", "CodeText",ExpressionUUID->"38a8cfb6-bdb5-4c47-b3d1-90a1a15fd2db"],

Cell[BoxData[
 RowBox[{"{", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Log", "[", 
     RowBox[{"chi", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], "]"}], "==", "0"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"res", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}], "==", "0"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"chi", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"res", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}]}], "+", 
       RowBox[{"delta", " ", 
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}]}]}], ")"}]}], "==", "0"}]}], 
  "\[IndentingNewLine]", "}"}]], "Input",ExpressionUUID->"f9371149-0ac3-7e41-\
81ac-57c39ca955ad"],

Cell[TextData[{
 "That output is ",
 StyleBox["not consistent",
  FontWeight->Bold],
 " with the full Lagrangian shown, because the Lagrangian contains: "
}], "Text",ExpressionUUID->"0778ceb0-e7dd-c447-972a-6c23950c83c4"],

Cell["derivative regularization terms,", "Item",ExpressionUUID->"fa12d19b-10f2-e440-bf50-a7c3933e66d4"],

Cell["cubic coupling,", "Item",ExpressionUUID->"211e9161-23cd-2345-8771-baa1a2ddbdfb"],

Cell["quadratic confineme", "Item",
 CellChangeTimes->{{4.0013311994110107`*^9, 
  4.0013311998262253`*^9}},ExpressionUUID->"1606883f-4e9e-e647-9aed-\
081033316e21"],

Cell["and dependence on all three fields.", "Item",ExpressionUUID->"77fe0794-e101-9744-adcb-036cc1a3a836"],

Cell["\<\
So a rigorous reconstruction must verify whether those terms were \
accidentally omitted, shadowed, or neutralized. \
\>", "Text",ExpressionUUID->"399d0af0-9566-d74d-bd4f-f36a790dac99"]
}, Open  ]],

