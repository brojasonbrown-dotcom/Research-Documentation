Cell[CellGroupData[{

Cell["11. Scale ansatz done correctly", "Section",ExpressionUUID->"027e6b21-f9af-3847-aec8-b516888ada5b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"scaleAnsatz", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{
        RowBox[{"rhoS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"a", " ", "sigma"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{
        RowBox[{"chiS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"b", " ", "sigma"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{
        RowBox[{"resS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"c", " ", "sigma"}], "]"}]}]}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleReducedEquations", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"fieldEquations", " ", "/.", " ", "scaleAnsatz"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"$Assumptions", "&&", 
        RowBox[{
         RowBox[{"chiS", "[", "x", "]"}], ">", "0"}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", "scaleReducedEquations", "]"}]}], "Input",ExpressionUU\
ID->"c9a6845d-af27-2e49-8dd1-e7f00f603cb5"],

Cell[CellGroupData[{

Cell["Exponential power extraction", "Subsection",ExpressionUUID->"d79b4339-3fd8-b542-9b5c-85818c663736"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "expPowers", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"expPowers", "[", "expr_", "]"}], ":=", 
    RowBox[{"DeleteDuplicates", " ", "@", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{"expr", ",", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"k_.", " ", "sigma"}], "]"}], ":>", "k"}], ",", "Infinity"}],
       "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scalePowers", "=", 
   RowBox[{"expPowers", " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{"Subtract", " ", "@@@", " ", "scaleReducedEquations"}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Grid", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Prepend", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", "scalePowers", "]"}], "]"}], ",", 
        "scalePowers"}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<Equation\>\"", ",", "\"\<Exp powers\>\""}], "}"}]}], "]"}],
    ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"Frame", "->", "All"}]}], "\[IndentingNewLine]", "]"}]}], "Input",E\
xpressionUUID->"af183731-309c-0948-8fad-3f0465b7b1bf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Consistency solver for exponent matching", "Subsection",ExpressionUUID->"d54c823b-8e82-d740-9c4f-c5b45575a54c"],

Cell[BoxData[
 RowBox[{"Reduce", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Thread", " ", "/@", " ", 
      RowBox[{"(", 
       RowBox[{"Equal", " ", "@@@", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Partition", "[", 
            RowBox[{"#", ",", "2", ",", "1"}], "]"}], " ", "&"}], " ", "/@", 
          " ", 
          RowBox[{"Select", "[", 
           RowBox[{"scalePowers", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], ">", "1"}], " ", "&"}]}], 
           "]"}]}], ")"}]}], ")"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c"}], "}"}], ",", "Reals"}], 
  "\[IndentingNewLine]", "]"}]], "Input",ExpressionUUID->"551645e6-c3f3-4e40-\
ab76-e10776e4fcce"],

