Cell[CellGroupData[{

Cell["14. How the original notebook could be structured better", "Section",ExpressionUUID->"31b0c9ae-d267-0c4d-8147-374b6c75959a"],

Cell[CellGroupData[{

Cell["Structural improvements", "Subsection",ExpressionUUID->"45823b18-3cc8-574e-bc5a-3184b4879544"],

Cell[TextData[{
 "1. ",
 StyleBox["Separate formal model from interpretation",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"fcf99f94-f09d-5945-aedf-3f7bd976c833"],

Cell["First define fields and equations.", "Subitem",ExpressionUUID->"a861e84d-ce7f-4b49-b395-4f1cd65eb113"],

Cell["Then prove properties.", "Subitem",ExpressionUUID->"af8a21b5-8825-1248-854d-fb73128ff178"],

Cell["Only then discuss ontology.", "Subitem",ExpressionUUID->"661cca85-87f2-bf44-bbda-07a67e715fc2"],

Cell[TextData[{
 "2. ",
 StyleBox["Separate symbolic exact results from numerical experiments",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"39ff81d1-2222-4b4a-b630-82c2918610ab"],

Cell["Analytic section.", "Subitem",ExpressionUUID->"e71c2e99-8ee3-6647-a284-6e317a4ed655"],

Cell["Numerical section.", "Subitem",ExpressionUUID->"60c4f28c-d59c-a548-b262-a3054a9bc9f6"],

Cell["Interpretation section.", "Subitem",ExpressionUUID->"6afe7904-928e-0b41-80a9-dca7079c9b2b"],

Cell[TextData[{
 "3. ",
 StyleBox["Add explicit test harnesses",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"28694c26-80d1-f041-b78c-ec1f3a33cee6"],

Cell["Every claimed property should have a named boolean test.", "Subitem",ExpressionUUID->"6b031b90-fb4e-194a-aab8-4efca4415aa8"],

Cell[TextData[{
 "4. ",
 StyleBox["Record failure conditions",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"7bcde226-a79c-6441-bd6e-afd700468d75"],

Cell["Unbounded directions,", "Subitem",ExpressionUUID->"aa1d111e-a78c-8b4d-92e3-3f0b3c5a91ce"],

Cell[TextData[{
 "domain restrictions like ",
 Cell[BoxData[Cell["chi > 0",
   Background->None,ExpressionUUID->"5428b96d-f4b7-e644-b187-777f947ca626"]], 
  "InlineCode",ExpressionUUID->"4d904097-3194-1145-a22c-763375940d04"],
 ","
}], "Subitem",ExpressionUUID->"f6a729a7-4ee9-754a-9609-a865a7cf3409"],

Cell["singular sets,", "Subitem",ExpressionUUID->"68edc97d-04bb-5e4f-9680-7ba35e48d739"],

Cell["non-isolated equilibria,", "Subitem",ExpressionUUID->"4abd11ec-1a89-9b40-afa7-1d620f85e2d1"],

Cell["marginal directions.", "Subitem",ExpressionUUID->"8cb71553-8ee7-b840-81f8-0c2212fd8339"],

Cell[TextData[{
 "5. ",
 StyleBox["Use a claim/evidence ledger",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"57db0068-c57c-554c-bdd6-3fc63c3f9a10"],

Cell["\<\
Especially when discussing consciousness, information, energy, or ontology.\
\>", "Subitem",ExpressionUUID->"10f34f3a-647b-2243-b7d3-925c8b430d29"],

