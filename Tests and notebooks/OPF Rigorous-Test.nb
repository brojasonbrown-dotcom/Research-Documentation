Cell[CellGroupData[{

Cell["7. Boundedness testing", "Section",ExpressionUUID->"7300a297-0569-e34a-bc81-f2255ffd65a1"],

Cell["\<\
A major structural question is whether the potential is bounded below. This \
matters because unbounded directions undermine interpretation as a stable \
substrate. \
\>", "Text",ExpressionUUID->"3e8d8948-0d74-ca43-8af2-bb5d635b319f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "potential", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"potential", "[", 
    RowBox[{"r_", ",", "c_", ",", "s_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"r", " ", 
     RowBox[{"Log", "[", "c", "]"}]}], "+", 
    RowBox[{"c", " ", 
     RowBox[{"s", "^", "2"}]}], "+", 
    RowBox[{"delta", " ", "r", " ", "c", " ", "s"}], "+", 
    RowBox[{"lambda", " ", 
     RowBox[{"r", "^", "2"}]}]}]}], ";"}]}], "Input",ExpressionUUID->\
"fe9995c8-e05b-cb48-a4ad-d6456c259d0c"],

Cell[CellGroupData[{

Cell["Symbolic ray tests", "Subsection",ExpressionUUID->"78562bf1-d0d3-5b4f-82fc-37128485abb7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rayTests", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<rho -> t, chi -> 1, res -> 0\>\"", "->", 
      RowBox[{"Expand", "[", 
       RowBox[{"potential", "[", 
        RowBox[{"t", ",", "1", ",", "0"}], "]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<rho -> 0, chi -> t, res -> 0\>\"", "->", 
      RowBox[{"Expand", "[", 
       RowBox[{"potential", "[", 
        RowBox[{"0", ",", "t", ",", "0"}], "]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<rho -> t, chi -> Exp[-t^2], res -> 0\>\"", "->", 
      RowBox[{"Expand", "[", 
       RowBox[{"potential", "[", 
        RowBox[{"t", ",", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", 
           RowBox[{"t", "^", "2"}]}], "]"}], ",", "0"}], "]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<rho -> t, chi -> 1, res -> -delta t/2\>\"", "->", 
      RowBox[{"Expand", "[", 
       RowBox[{"potential", "[", 
        RowBox[{"t", ",", "1", ",", 
         RowBox[{
          RowBox[{"-", "delta"}], " ", 
          RowBox[{"t", "/", "2"}]}]}], "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], 
  ";"}], "\[IndentingNewLine]", "rayTests"}], "Input",ExpressionUUID->\
"24aa5f53-5eb4-af47-aae8-cf33f4c1aa41"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visual boundedness scans", "Subsection",ExpressionUUID->"9f2b18b9-b30f-f843-944f-05ccb485b8d1"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"deltaVal", "=", "1"}], ",", 
     RowBox[{"lambdaVal", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
   " ", 
   RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"potential", "[", 
        RowBox[{"r", ",", "c", ",", "0"}], "]"}], " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"delta", "->", "deltaVal"}], ",", 
         RowBox[{"lambda", "->", "lambdaVal"}]}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"r", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "0.1", ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Mesh", "->", "None"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<rho\>\"", ",", "\"\<chi\>\"", ",", "\"\<V\>\""}], "}"}]}],
      ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"PlotLabel", "->", "\"\<Potential landscape slice\>\""}]}], 
    "\[IndentingNewLine]", " ", "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"9b95c9ba-9912-f84b-a9ae-0535efdc1b84"],

