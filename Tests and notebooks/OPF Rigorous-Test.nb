Cell[CellGroupData[{

Cell["8. Scale-homogeneity testing framework", "Section",ExpressionUUID->"88ac59de-42ba-d141-bd57-093e1b61f88a"],

Cell["\<\
The supplied notebook treats scale recursion as central. We therefore define \
a reusable homogeneity test. \
\>", "Text",ExpressionUUID->"9e2bef69-47a6-474b-ad5f-8c3332afd6f3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"weightedScaleTransform", ",", "weightedHomogeneityDegree"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"weightedScaleTransform", "[", 
     RowBox[{"expr_", ",", "weights_", ",", "t_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"expr", " ", "/.", " ", "weights"}], " ", "/.", " ", 
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"rho0", "->", 
        RowBox[{
         RowBox[{"t", "^", "wr"}], " ", "rho0"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"chi0", "->", 
        RowBox[{
         RowBox[{"t", "^", "wc"}], " ", "chi0"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"res0", "->", 
        RowBox[{
         RowBox[{"t", "^", "ws"}], " ", "res0"}]}]}], "\[IndentingNewLine]", 
      "}"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"weightedHomogeneityDegree", "[", 
    RowBox[{"expr_", ",", "weights_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"scaled", ",", "q"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"scaled", "=", 
       RowBox[{"Expand", "[", 
        RowBox[{"weightedScaleTransform", "[", 
         RowBox[{"expr", ",", "weights", ",", "q"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Simplify", "[", 
       RowBox[{"scaled", "/", "expr"}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"a046d8a3-35b4-b945-b60c-\
ecdb7f43cbd6"],

Cell["Example usage: ", "CodeText",ExpressionUUID->"7ef8e40d-da7e-fc47-a7e5-b52fa23ccd4a"],

Cell[BoxData[
 RowBox[{"weightedHomogeneityDegree", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{"homogeneousPotential", ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"wr", "->", "1"}], ",", 
     RowBox[{"wc", "->", "1"}], ",", 
     RowBox[{"ws", "->", "1"}]}], "}"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"afb78164-d08e-124d-b80d-4c3a10cd4999"],

Cell[CellGroupData[{

Cell["Automated term-degree table", "Subsection",ExpressionUUID->"9b41136e-19e0-ae46-8c1b-d54556dd062e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"terms", "=", 
   RowBox[{"List", " ", "@@", " ", 
    RowBox[{"Expand", "[", "homogeneousPotential", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"termDegreeTable", "=", 
   RowBox[{"Grid", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Prepend", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"Table", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", "        ", 
          RowBox[{"term", ",", "\[IndentingNewLine]", "        ", 
           RowBox[{"Simplify", "[", 
            RowBox[{"term", " ", "/.", " ", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"rho0", "->", 
                 RowBox[{"q", " ", "rho0"}]}], ",", 
                RowBox[{"chi0", "->", 
                 RowBox[{"q", " ", "chi0"}]}], ",", 
                RowBox[{"res0", "->", 
                 RowBox[{"q", " ", "res0"}]}]}], "}"}], "/", "term"}]}], 
            "]"}]}], "\[IndentingNewLine]", "      ", "}"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{"{", 
          RowBox[{"term", ",", "terms"}], "}"}]}], "\[IndentingNewLine]", 
        "    ", "]"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"{", 
        RowBox[{"\"\<Term\>\"", ",", "\"\<Uniform scaling factor\>\""}], 
        "}"}]}], "\[IndentingNewLine]", "  ", "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Frame", "->", "All"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", "termDegreeTable"}], "Input",ExpressionUUID->\
"2e679ebb-b537-3244-bbf8-10adcfb24335"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"71aa0426-1b88-ef4e-bb90-70ed6f181f43"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Candidate-potential foundry", "Section",ExpressionUUID->"6e1bfd0d-7330-1a4f-9a82-5c85fd93ca91"],

Cell["\<\
This section is designed to rigorously test the user\[CloseCurlyQuote]s \
\[OpenCurlyDoubleQuote]Equation Foundry\[CloseCurlyDoubleQuote] claim. \
\>", "Text",ExpressionUUID->"5159d8bc-a159-9d4f-af57-669ad9b3a902"],

Cell[CellGroupData[{

Cell["Term library", "Subsection",ExpressionUUID->"9a5b3abd-ea07-8340-92fd-832bac00043f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"candidateTerms", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<rho Log[rho/chi]\>\"", "->", 
      RowBox[{"rho0", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"rho0", "/", "chi0"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<-rho\>\"", "->", 
      RowBox[{"-", "rho0"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<chi\>\"", "->", "chi0"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<res^2/(2 chi)\>\"", "->", 
      RowBox[{
       RowBox[{"res0", "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "chi0"}], ")"}]}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<rho Log[chi]\>\"", "->", 
      RowBox[{"rho0", " ", 
       RowBox[{"Log", "[", "chi0", "]"}]}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<chi res^2\>\"", "->", 
      RowBox[{"chi0", " ", 
       RowBox[{"res0", "^", "2"}]}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<rho^2 chi\>\"", "->", 
      RowBox[{
       RowBox[{"rho0", "^", "2"}], " ", "chi0"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<delta rho chi res\>\"", "->", 
      RowBox[{"delta", " ", "rho0", " ", "chi0", " ", "res0"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<lambda rho^2\>\"", "->", 
      RowBox[{"lambda", " ", 
       RowBox[{"rho0", "^", "2"}]}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<chi^2\>\"", "->", 
      RowBox[{"chi0", "^", "2"}]}]}], "\[IndentingNewLine]", "|>"}]}], 
  ";"}]], "Input",ExpressionUUID->"acc1b5ed-c80e-6442-a244-cd797b927ff4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Utilities for scoring", "Subsection",ExpressionUUID->"0a8bd9c8-0704-de40-8c55-935afba2bc6d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "homogeneousStationarySystem", ",", "hessianMatrix", ",", 
     "boundednessHeuristic", ",", "fixedPointExistsQ", ",", 
     "stableAtCriticalPointQ"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"homogeneousStationarySystem", "[", "expr_", "]"}], ":=", 
    RowBox[{"Thread", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Grad", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"{", 
         RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}]}], "]"}], "==", 
      "0"}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hessianMatrix", "[", "expr_", "]"}], ":=", 
    RowBox[{"D", "[", 
     RowBox[{"expr", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", "2"}], 
       "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"fixedPointExistsQ", "[", "expr_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "sol", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"sol", "=", 
        RowBox[{"Quiet", "@", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"homogeneousStationarySystem", "[", "expr", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", "Reals"}],
           "]"}]}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"sol", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"sol", ",", 
          RowBox[{
           RowBox[{"Simplify", "[", 
            RowBox[{
             RowBox[{"chi0", " ", "/.", " ", 
              RowBox[{"#", ">", "0"}]}], ",", 
             RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}], " ", 
           "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"sol", "=", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{"sol", ",", 
          RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"sol", "=", 
        RowBox[{"DeleteDuplicates", "[", "sol", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"Length", "[", "sol", "]"}], ">", "0"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stableAtCriticalPointQ", "[", "expr_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sol", ",", "hessVals"}], "}"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"sol", "=", 
        RowBox[{"Quiet", "@", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"homogeneousStationarySystem", "[", "expr", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", "Reals"}],
           "]"}]}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"sol", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"sol", ",", 
          RowBox[{
           RowBox[{"Quiet", "@", 
            RowBox[{"TrueQ", "[", 
             RowBox[{"Simplify", "[", 
              RowBox[{"chi0", " ", "/.", " ", 
               RowBox[{"#", ">", "0"}]}], "]"}], "]"}]}], " ", "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sol", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"hessVals", "=", 
        RowBox[{"Quiet", "[", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"hessianMatrix", "[", "expr", "]"}], " ", "/.", " ", 
           "sol"}], ")"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"AnyTrue", "[", 
        RowBox[{"hessVals", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"MatrixQ", "[", "#", "]"}], "&&", 
           RowBox[{"Quiet", "[", 
            RowBox[{"PositiveSemidefiniteMatrixQ", "[", "#", "]"}], "]"}]}], 
          " ", "&"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"boundednessHeuristic", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "rays", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"rays", "=", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"expr", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rho0", "->", "t"}], ",", 
            RowBox[{"chi0", "->", 
             RowBox[{"1", "+", 
              RowBox[{"t", "^", "2"}]}]}], ",", 
            RowBox[{"res0", "->", "0"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"expr", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rho0", "->", "t"}], ",", 
            RowBox[{"chi0", "->", "1"}], ",", 
            RowBox[{"res0", "->", "t"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"expr", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rho0", "->", "t"}], ",", 
            RowBox[{"chi0", "->", 
             RowBox[{"Exp", "[", "t", "]"}]}], ",", 
            RowBox[{"res0", "->", "0"}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"expr", " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rho0", "->", "t"}], ",", 
            RowBox[{"chi0", "->", 
             RowBox[{"Exp", "[", 
              RowBox[{"-", 
               RowBox[{"t", "^", "2"}]}], "]"}]}], ",", 
            RowBox[{"res0", "->", "0"}]}], "}"}]}]}], "\[IndentingNewLine]", 
        "  ", "}"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"rays", ",", 
        RowBox[{
         RowBox[{"Quiet", "@", 
          RowBox[{"TrueQ", "[", 
           RowBox[{
            RowBox[{"Limit", "[", 
             RowBox[{"#", ",", 
              RowBox[{"t", "->", "Infinity"}]}], "]"}], "=!=", 
            RowBox[{"-", "Infinity"}]}], "]"}]}], " ", "&"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"d801194f-18e9-9c4c-8eed-bb6bbe0d8e73"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Enumerate candidate sums", "Subsection",ExpressionUUID->"8c3fee7e-cc9d-2647-98e5-761fb5bc9e31"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"candidateSubsets", "=", 
    RowBox[{"Rest", "@", 
     RowBox[{"Subsets", "[", 
      RowBox[{
       RowBox[{"Keys", "[", "candidateTerms", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "4"}], "}"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"candidateResults", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "expr", ",", "stationary", ",", "fixedQ", ",", "stableQ", ",", 
         "boundedQ"}], "}"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"expr", "=", 
         RowBox[{"Total", "[", 
          RowBox[{"candidateTerms", " ", "/@", " ", "subset"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"fixedQ", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"fixedPointExistsQ", "[", "expr", "]"}]}]}], ";", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"stableQ", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"stableAtCriticalPointQ", "[", "expr", "]"}]}]}], ";", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"boundedQ", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"boundednessHeuristic", "[", "expr", "]"}]}]}], ";", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"stationary", "=", 
         RowBox[{"homogeneousStationarySystem", "[", "expr", "]"}]}], ";", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"<|", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"\"\<Terms\>\"", "->", "subset"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Potential\>\"", "->", "expr"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<FixedPointExists\>\"", "->", "fixedQ"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<StableCriticalPoint\>\"", "->", "stableQ"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<BoundedHeuristic\>\"", "->", "boundedQ"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Score\>\"", "->", 
           RowBox[{"Count", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"fixedQ", ",", "stableQ", ",", "boundedQ"}], "}"}], ",",
              "True"}], "]"}]}]}], "\[IndentingNewLine]", "    ", "|>"}]}]}], 
      "\[IndentingNewLine]", "   ", "]"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"subset", ",", "candidateSubsets"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"21bb597d-616a-af40-8130-2fcb0f7c25f7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Inspect the best candidates", "Subsection",ExpressionUUID->"cbe0fab6-2dd5-b24a-8f38-51fb47504d64"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"bestCandidates", "=", 
   RowBox[{
    RowBox[{"ReverseSortBy", "[", 
     RowBox[{"candidateResults", ",", 
      RowBox[{"#Score", " ", "&"}]}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", " ", ";;", " ", 
      RowBox[{"Min", "[", 
       RowBox[{"20", ",", 
        RowBox[{"Length", "[", "candidateResults", "]"}]}], "]"}]}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", "bestCandidates", "]"}]}], "Input",ExpressionUUID->\
"24040682-9f59-c64c-b25c-a86f9a5c3977"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Explicit KL candidate", "Subsection",ExpressionUUID->"06b9f3b0-d0eb-1642-bff6-b22ab4a52a8e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"klPotential", "=", 
   RowBox[{
    RowBox[{"rho0", " ", 
     RowBox[{"Log", "[", 
      RowBox[{"rho0", "/", "chi0"}], "]"}]}], "-", "rho0", "+", "chi0", "+", 
    RowBox[{
     RowBox[{"res0", "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "chi0"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"klSystem", "=", 
   RowBox[{"homogeneousStationarySystem", "[", "klPotential", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"klSolutions", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{"klSystem", ",", 
      RowBox[{"{", 
       RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", "Reals"}], 
     "]"}], " ", "//", " ", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"klHessian", "=", 
    RowBox[{"hessianMatrix", "[", "klPotential", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"<|", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"\"\<StationaryEquations\>\"", "->", "klSystem"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"\"\<Solutions\>\"", "->", "klSolutions"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"\"\<Hessian\>\"", "->", "klHessian"}]}], "\[IndentingNewLine]", 
  "|>"}]}], "Input",ExpressionUUID->"355ad17a-fe62-fa40-bb9e-7c68cf451fcb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visual comparison: original vs KL", "Subsection",ExpressionUUID->"bec46d10-8688-3e42-bd94-1aa3c036fc24"],

Cell[BoxData[
 RowBox[{"GraphicsRow", "[", 
  RowBox[{"{", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"rho0", " ", 
           RowBox[{"Log", "[", "chi0", "]"}]}], "+", 
          RowBox[{"chi0", " ", 
           RowBox[{"res0", "^", "2"}]}], "+", 
          RowBox[{"lambda", " ", 
           RowBox[{"rho0", "^", "2"}]}]}], ")"}], " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"res0", "->", "0"}], ",", 
          RowBox[{"lambda", "->", "1"}]}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"rho0", ",", 
        RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"chi0", ",", "0.1", ",", "3"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"Mesh", "->", "None"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"PlotLabel", "->", "\"\<Original slice\>\""}]}], 
     "\[IndentingNewLine]", " ", "]"}], ",", "\[IndentingNewLine]", " ", 
    RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{"klPotential", " ", "/.", " ", 
        RowBox[{"res0", "->", "0"}]}], "]"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"{", 
       RowBox[{"rho0", ",", "0.1", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"chi0", ",", "0.1", ",", "3"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"Mesh", "->", "None"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"PlotLabel", "->", "\"\<KL slice\>\""}]}], 
     "\[IndentingNewLine]", " ", "]"}]}], "\[IndentingNewLine]", "}"}], 
  "]"}]], "Input",ExpressionUUID->"4f6ebe21-83f7-1848-a8ea-2507ec814db0"],

