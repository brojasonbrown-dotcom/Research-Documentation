Cell[CellGroupData[{

Cell["4. Define the OPF test Lagrangian carefully", "Section",ExpressionUUID->"36033c67-62f4-e14b-8e43-f1bfeb0b5bec"],

Cell[TextData[{
 "We start from the supplied scale-extended density: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", "\[Rho]", "log", "\[Chi]", "+", 
         "\[Chi] ", 
         StyleBox["r", "TI"], 
         StyleBox["e", "TI"], 
         SuperscriptBox[
          StyleBox["s", "TI"], "2"], "+", "\[Alpha]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", "\[Sigma]"], "\[Rho]"}], ")"}], 
          "2"], "+", "\[Beta]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", "\[Sigma]"], "\[Chi]"}], ")"}], 
          "2"], "+", "\[Gamma]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", "\[Sigma]"], 
              StyleBox["r", "TI"], 
              StyleBox["e", "TI"], 
              StyleBox["s", "TI"]}], ")"}], "2"], "+", "\[Eta]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", 
               StyleBox["x", "TI"]], "\[Rho]"}], ")"}], "2"], "+", "\[Zeta]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", 
               StyleBox["x", "TI"]], "\[Chi]"}], ")"}], "2"], "+", "\[Xi]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", 
               StyleBox["x", "TI"]], 
              StyleBox["r", "TI"], 
              StyleBox["e", "TI"], 
              StyleBox["s", "TI"]}], ")"}], "2"], "+", "\[Delta] ", "\[Rho] ",
          "\[Chi] ", 
         StyleBox["r", "TI"], 
         StyleBox["e", "TI"], 
         StyleBox["s", "TI"], "+", "\[Lambda] ", 
         SuperscriptBox["\[Rho]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{L} = \\rho\\log\\chi + \\chi\\,res^2\n+ \\alpha \
(\\partial_\\sigma \\rho)^2 + \\beta (\\partial_\\sigma \\chi)^2 + \\gamma \
(\\partial_\\sigma res)^2\n+ \\eta (\\partial_x \\rho)^2 + \\zeta \
(\\partial_x \\chi)^2 + \\xi (\\partial_x res)^2\n+ \
\\delta\\,\\rho\\,\\chi\\,res + \\lambda\\,\\rho^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9bcd7914-30fb-9543-b7d7-5f139eb6a82d"]
}], "Text",ExpressionUUID->"3dc61ebe-d014-2a47-9679-0485aa1237c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lagrangianDensity", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"chi", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], "]"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"chi", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{
      RowBox[{"res", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"alpha", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
      "2"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"beta", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"chi", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
      "2"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"gamma", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"res", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
      "2"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"eta", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", "2"}]}], 
    "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"zeta", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"chi", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", "2"}]}], 
    "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"xi", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"res", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", "2"}]}], 
    "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"delta", " ", 
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{"chi", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{"res", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"lambda", " ", 
     RowBox[{
      RowBox[{"rho", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}]}]}]}], ";"}]], "Input",E\
xpressionUUID->"6262b4cf-be5c-bc45-8b70-23cb6c7a8a38"],

