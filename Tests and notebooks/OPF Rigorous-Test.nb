Cell[CellGroupData[{

Cell["12. Visual probe section: ratio scans and golden candidates", "Section",ExpressionUUID->"c42b76c6-50ee-8b46-8f36-778a4ce275f3"],

Cell["\<\
This section tests whether special irrational ratios emerge structurally or \
only by post-selection. \
\>", "Text",ExpressionUUID->"2acf00c3-6f55-1443-86d2-bbf16d1b504e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "ratioScore", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ratioScore", "[", "r_", "]"}], ":=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"r", "-", "GoldenRatio"}], "]"}], ",", "50"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ratioCandidates", "=", 
    RowBox[{
     RowBox[{"Join", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{"n", ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "1", ",", "5", ",", 
           RowBox[{"1", "/", "10"}]}], "}"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"{", 
        RowBox[{"GoldenRatio", ",", 
         RowBox[{"2", " ", 
          RowBox[{"Pi", "/", 
           RowBox[{"GoldenRatio", "^", "2"}]}]}], ",", 
         RowBox[{"GoldenAngle", "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "Pi"}], ")"}]}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], " ", "//", " ", "DeleteDuplicates"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ratioDataset", "=", 
    RowBox[{"Dataset", "@", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Candidate\>\"", "->", "rc"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<NumericValue\>\"", "->", 
          RowBox[{"N", "[", 
           RowBox[{"rc", ",", "30"}], "]"}]}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<DistanceToPhi\>\"", "->", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"rc", "-", "GoldenRatio"}], "]"}], ",", "30"}], 
           "]"}]}]}], "\[IndentingNewLine]", "   ", "|>"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"{", 
        RowBox[{"rc", ",", "ratioCandidates"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "ratioDataset"}], "Input",Ex\
pressionUUID->"f2583e3c-2728-0349-a138-cc935dca4153"],

Cell[CellGroupData[{

Cell["Visualization", "Subsection",ExpressionUUID->"fe122d81-6396-1441-b955-083b3641aa61"],

Cell[BoxData[
 RowBox[{"ListPlot", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"N", "[", "rc", "]"}], ",", 
       RowBox[{"N", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"rc", "-", "GoldenRatio"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"rc", ",", "ratioCandidates"}], "}"}]}], "]"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", "  ", 
