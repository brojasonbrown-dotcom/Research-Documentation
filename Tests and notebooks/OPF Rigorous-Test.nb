Cell[CellGroupData[{

Cell["1. Notebook purpose", "Section",ExpressionUUID->"9d327325-f2f4-f248-85fb-76db9ae200da"],

Cell["Goals of this testing notebook:", "Text",ExpressionUUID->"e01665dc-205d-7d40-8c5e-67e427bc2c89"],

Cell["1. Rebuild the OPF action carefully.", "Text",ExpressionUUID->"c18eda1e-a4d0-ce4b-99f5-87c217b14e52"],

Cell["\<\
2. Derive Euler\[Dash]Lagrange equations correctly and compare with the \
original notebook.\
\>", "Text",ExpressionUUID->"b170f18d-9990-b248-8c66-f6fdad3adf95"],

Cell["3. Identify implementation errors in the source notebook.", "Text",ExpressionUUID->"64a9aa11-eb45-b141-9fd5-42794d7f9bd1"],

Cell["\<\
4. Test fixed points, boundedness, homogeneity, and scale recursion.\
\>", "Text",ExpressionUUID->"64d9736c-104c-f94d-b254-872fd19ce33f"],

Cell["5. Create visual diagnostics for candidate potentials.", "Text",ExpressionUUID->"d4cb79b1-9ce4-4f42-a933-29c118a0a9e4"],

Cell["6. Evaluate the reported probe claims in a reproducible way.", "Text",ExpressionUUID->"4875a1fa-0697-a64c-a76d-e3a8305ca097"],

Cell["\<\
7. Separate what is mathematically shown from what is philosophically \
suggested. \
\>", "Text",ExpressionUUID->"a0df8ab4-6a12-864d-9ac5-18cf7743c30e"],

