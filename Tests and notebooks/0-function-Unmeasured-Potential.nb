Cell["Correct insertion order is therefore:", "Text",ExpressionUUID->"7ea5c2e1-db3b-c844-a4cb-14ccfa2fbaac"],

Cell["1. define symbols", "Text",ExpressionUUID->"6536fed2-4797-7d43-a101-214790e4b48e"],

Cell["2. derive equations", "Text",ExpressionUUID->"9bd5f9ff-26a3-8e4c-8284-ce0d40fbff1c"],

Cell["3. classify branches", "Text",ExpressionUUID->"97205680-baf4-b34c-8fb5-848e2e4de529"],

Cell["4. choose admissible branch", "Text",ExpressionUUID->"fad49823-f2af-644c-bfd5-693b53dc4911"],

Cell["5. insert parameters", "Text",ExpressionUUID->"1adf6c53-5f49-534f-ad49-7a2893b7945d"],

Cell["6. solve or simulate", "Text",ExpressionUUID->"aa3b9897-633a-c94a-8b63-563988d60f02"],

Cell["7. evaluate residuals", "Text",ExpressionUUID->"e747efe3-6e96-774b-9ae3-8770dfebfb88"],

Cell["8. refine / compare / reject if unstable ", "Text",ExpressionUUID->"b99b1974-a922-5240-a71a-110a0fd68797"],

