}, Open  ]],

Cell[CellGroupData[{

Cell["16.2 Then constrained parameter insertion", "Subsection",ExpressionUUID->"9493359b-6fe7-2c40-ac16-e16387bd8508"],

Cell[BoxData[
 RowBox[{
  RowBox[{"parameterSet1", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\[Alpha]", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\[Beta]", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\[Mu]", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\[Sigma]", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\[Lambda]", "->", "2"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\[Eta]", "->", 
      RowBox[{"1", "/", "2"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\[Kappa]", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\[CapitalGamma]", "->", 
      RowBox[{"1", "/", "10"}]}]}], "\[IndentingNewLine]", "|>"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[126]:=",ExpressionUUID->"5764e8bc-182f-8c48-975d-624fc1676bea"]
