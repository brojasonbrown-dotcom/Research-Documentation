Cell[CellGroupData[{

Cell["12. Stability Tests for Emergence", "Section",ExpressionUUID->"d1a6e867-47d1-3444-a654-1eef7cd8b730"],

Cell["\<\
A rigorous emergence criterion is not \[OpenCurlyDoubleQuote]the story sounds \
good\[CloseCurlyDoubleQuote], but whether there is a branch transition and \
stable measured modes. \
\>", "Text",ExpressionUUID->"e577114e-36e9-3b41-b541-145dc48bac95"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"stableFrequencyCondition", "=", 
    RowBox[{
     RowBox[{"Reduce", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"dispersionDet", "==", "0"}], "&&", 
        RowBox[{"Element", "[", 
         RowBox[{"\[Omega]", ",", "Complexes"}], "]"}]}], ",", 
       "\[IndentingNewLine]", "   ", "\[Omega]", ",", "\[IndentingNewLine]", 
       "   ", "Complexes"}], "\[IndentingNewLine]", "   ", "]"}], " ", "//", 
     " ", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"say", "[", "\"\<Stable frequency condition:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"stableFrequencyCondition", " ", "//", " ", "InputForm"}], "]"}], 
  ";"}]}], "Input",
 CellLabel->
  "In[107]:=",ExpressionUUID->"61806425-25dd-684d-a1d2-107fe8a833e7"],

Cell[CellGroupData[{

Cell[BoxData[
 StyleBox["\<\"Stable frequency condition:\"\>",
  StripOnInput->False,
  LineColor->RGBColor[0, 0, 
    Rational[2, 3]],
  FrontFaceColor->RGBColor[0, 0, 
    Rational[2, 3]],
  BackFaceColor->RGBColor[0, 0, 
    Rational[2, 3]],
  GraphicsColor->RGBColor[0, 0, 
    Rational[2, 3]],
