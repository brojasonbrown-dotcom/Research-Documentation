Cell[CellGroupData[{

Cell["14. Scale-Relative Decoherence Structure", "Section",ExpressionUUID->"a6147794-1c51-c941-8eab-6533893652ca"],

Cell[TextData[{
 "Introduce a scale variable ",
 StyleBox["\[ScriptL]", "TI"],
 " and decoherence rate: "
}], "CodeText",ExpressionUUID->"d045c1bf-be7c-5e40-a085-fd71dba098c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"decoherenceRate", "[", "\[ScriptL]_", "]"}], ":=", 
   RowBox[{"\[Gamma]0", " ", 
    RowBox[{"\[ScriptL]", "^", "p"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coherenceAtScale", "[", 
    RowBox[{"obs_", ",", "\[ScriptL]_", ",", "\[Tau]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "\[Kappa]"}], " ", "obs"}], "]"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"decoherenceRate", "[", "\[ScriptL]", "]"}]}], " ", "\[Tau]"}],
      "]"}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"ca5c0815-f9ac-9b4a-accc-4de4f43873c5"],

Cell["\<\
This is the rigorous form of your \[OpenCurlyDoubleQuote]relative at scale\
\[CloseCurlyDoubleQuote] requirement: \
\>", "Text",ExpressionUUID->"ac9e43c4-ecc3-134c-a206-9cca7ce6b9e5"],

Cell["small scales may preserve coherence longer", "Item",ExpressionUUID->"6ed19308-32f4-d04a-bf6c-75eed30046d8"],

Cell["large scales may suppress coherence faster", "Item",ExpressionUUID->"0de6e8a0-512f-984c-b552-7fcb1967e5e3"],

Cell["\<\
observation and scale enter separately and can be fitted to data\
\>", "Item",ExpressionUUID->"0310eae1-cbb0-274b-99d6-6d1cc69b9ce9"],

Cell[CellGroupData[{

Cell["Test surface", "Subsection",ExpressionUUID->"6a956f38-3760-f649-9036-9ea8ccd7b3af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coherenceSurface", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"obsVal", ",", "ellVal", ",", 
       RowBox[{"coherenceAtScale", "[", 
        RowBox[{"obsVal", ",", "ellVal", ",", "\[Tau]"}], "]"}]}], "}"}], ",",
      "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"obsVal", ",", "0", ",", "3", ",", "0.5"}], "}"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"ellVal", ",", "0.1", ",", "2", ",", "0.3"}], "}"}]}], 
    "\[IndentingNewLine]", "   ", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[121]:=",ExpressionUUID->"dcdef4d9-ee55-bd48-95ed-605094b31383"],

