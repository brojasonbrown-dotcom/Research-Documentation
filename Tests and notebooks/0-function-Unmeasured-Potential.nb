Cell[CellGroupData[{

Cell["8. Observation as a Dynamical Trigger", "Section",ExpressionUUID->"cdbe7514-29ed-8741-be0b-fa091d809940"],

Cell["We now promote observation strength to a source term. ", "Text",ExpressionUUID->"855d79a4-966b-c64d-b27d-944e23d0c290"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"obsProfile", "[", "t_", "]"}], ":=", 
    RowBox[{"obs0", " ", 
     RowBox[{"UnitStep", "[", "t", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementSource", "=", 
    RowBox[{"observationalOrder", "[", 
     RowBox[{"obsProfile", "[", "t", "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"maintenanceEquation", "[", "field_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"field", "[", "t", "]"}], ",", "t"}], "]"}], "+", 
      RowBox[{"\[CapitalGamma]", " ", 
       RowBox[{"field", "[", "t", "]"}]}]}], "==", "measurementSource"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"maintenanceSolution", "=", 
    RowBox[{
     RowBox[{"DSolveValue", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"maintenanceEquation", "[", "\[Phi]", "]"}], ",", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "0", "]"}], "==", "0"}]}], "}"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"\[Phi]", "[", "t", "]"}], ",", "\[IndentingNewLine]", "   ", 
       "t"}], "\[IndentingNewLine]", "   ", "]"}], " ", "//", " ", 
     "FullSimplify"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"say", "[", "\"\<Maintenance solution:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"maintenanceSolution", " ", "//", " ", "TraditionalForm"}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[87]:=",ExpressionUUID->"7e885252-cdff-9d47-9265-1cac1820e072"],

