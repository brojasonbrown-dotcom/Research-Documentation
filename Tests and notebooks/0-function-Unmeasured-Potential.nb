Cell[CellGroupData[{

Cell["0. Core Principle", "Section",ExpressionUUID->"fa2dfd6a-15f8-5744-ad12-b97ea3fced47"],

Cell["We encode: ", "Text",ExpressionUUID->"59407c54-9d83-f540-bc8d-05ea99554cc2"],

