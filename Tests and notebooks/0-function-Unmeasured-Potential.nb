Cell["Further practical test: ", "CodeText",ExpressionUUID->"a0c06d1e-b854-9742-ac84-44e587bf45ce"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"purelyOscillatoryCondition", "=", 
    RowBox[{
     RowBox[{"Reduce", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"dispersionDet", "==", "0"}], "&&", 
        RowBox[{
         RowBox[{"Re", "[", "\[Omega]", "]"}], "==", "0"}], "&&", 
        RowBox[{
         RowBox[{"Im", "[", "\[Omega]", "]"}], ">", "0"}]}], ",", 
       "\[IndentingNewLine]", "   ", "\[Omega]", ",", "\[IndentingNewLine]", 
       "   ", "Complexes"}], "\[IndentingNewLine]", "   ", "]"}], " ", "//", 
     " ", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"say", "[", "\"\<Purely oscillatory branch condition:\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
