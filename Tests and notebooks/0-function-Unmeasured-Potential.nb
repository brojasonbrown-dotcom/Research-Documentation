Cell[CellGroupData[{

Cell["23. Correctness Note", "Section",ExpressionUUID->"444b76d5-71fd-f044-8e12-6bdb687f90e0"],

Cell["The strongest rigorous position is: ", "Text",ExpressionUUID->"5904721e-2108-cb4c-b376-6a50aa82365a"],

Cell["define semantic claims as operators", "Item",ExpressionUUID->"28fe23e9-0d0b-6d4f-ab27-41fed762e0a0"],

Cell["derive exact equations before inserting values", "Item",ExpressionUUID->"b8305413-18b0-4241-a908-09bc20609ee8"],

Cell[TextData[{
 "treat cosmology and double-slit as ",
 StyleBox["comparison targets",
  FontWeight->Bold],
 ", not automatic proofs"
}], "Item",ExpressionUUID->"8ac786ff-3e67-4747-bbee-6c2d46b9487c"],

Cell["\<\
require residual, branch, and stability tests before interpreting any result \
physically\
\>", "Item",ExpressionUUID->"0ebfb440-5729-6149-b197-2c991bdc28b7"],

Cell["\<\
That is the mathematically honest route to correctness and predictive testing.\
\>", "Text",ExpressionUUID->"db2357e9-5954-0442-87df-b2bbc05ad00a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"the", " ", 
    RowBox[{"test", " ", ":", " ", "\[IndentingNewLine]", 
     RowBox[{"\"\<\>\"", "\"\<\nOPF FUNCTIONAL OPERATOR & TEST SUITE\n\
====================================\nDirect executable implementation of the \
OPF Emergence Notebook.\nTests the Measurement Bifurcation, Maintenance Law, \
and Dispersion Matrix.\n\>\"", "\"\<\>\""}]}]}], "\n", "\n", 
   RowBox[{"import", " ", "numpy", " ", "as", " ", "np"}], "\n", "\n", 
   RowBox[{
    RowBox[{"class", " ", 
     RowBox[{"OPF_Operator", ":", 
      RowBox[{"def", " ", "__init", "__", 
       RowBox[{"(", 
        RowBox[{"self", ",", 
         RowBox[{"kappa", "=", "1.0"}], ",", 
         RowBox[{"Gamma", "=", "0.1"}]}], ")"}]}], ":", 
      RowBox[{"self", ".", "kappa"}]}]}], "=", "kappa"}], "\n", 
   RowBox[{
    RowBox[{"self", ".", "Gamma"}], "=", "Gamma"}], "\n", "\n", 
   RowBox[{
   "#", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
    "===", "===", "===", "===", 
    RowBox[{"#", " ", "1.", " ", "SYMBOLIC", " ", "OPERATORS", " ", 
     RowBox[{"(", 
      RowBox[{"From", " ", "Section", " ", "3"}], ")"}]}]}], "\n", 
   RowBox[{
    RowBox[{
    "#", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", 
     RowBox[{"def", " ", "unmeasured_component", 
      RowBox[{"(", 
       RowBox[{"self", ",", "state", ",", "obs_strength"}], ")"}]}]}], ":", 
    RowBox[{"\"\<\>\"", "\"\<Latent sector: Decays exponentially with \
observation.\>\"", "\"\<\>\""}]}], "\n", 
   RowBox[{"return", " ", "state", "*", 
    RowBox[{"np", ".", "exp"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"self", ".", "kappa"}]}], "*", "obs_strength"}], ")"}]}], "\n",
    "\n", 
   RowBox[{
    RowBox[{"def", " ", "measurement_operator", 
     RowBox[{"(", 
      RowBox[{"self", ",", "state", ",", "obs_strength"}], ")"}]}], ":", 
    RowBox[{"\"\<\>\"", "\"\<Stabilized sector: Rises as observation \
increases.\>\"", "\"\<\>\""}]}], "\n", 
   RowBox[{"return", " ", "state", "*", 
    RowBox[{"(", 
     RowBox[{"1.0", "-", 
      RowBox[{
       RowBox[{"np", ".", "exp"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"self", ".", "kappa"}]}], "*", "obs_strength"}], ")"}]}]}], 
     ")"}]}], "\n", "\n", 
   RowBox[{
   "#", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
    "===", "===", "===", "===", 
    RowBox[{"#", " ", "2.", " ", "DYNAMICAL", " ", "TRIGGER", " ", 
     RowBox[{"(", 
      RowBox[{"From", " ", "Section", " ", "8"}], ")"}]}]}], "\n", 
   RowBox[{
    RowBox[{
    "#", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", 
     RowBox[{"def", " ", "maintenance_residual", 
      RowBox[{"(", 
       RowBox[{"self", ",", "phi_val", ",", "dphi_dt", ",", "obs_strength"}], 
       ")"}]}]}], ":", 
    RowBox[{"\"\<\>\"", "\"\<\n        Computes the residual of the \
maintenance equation:\n        D[phi, t] + Gamma * phi - measurement_source = \
0\n        \>\"", "\"\<\>\""}]}], "\n", 
   RowBox[{"source", "=", 
    RowBox[{
     RowBox[{"self", ".", "measurement_operator"}], 
     RowBox[{"(", 
      RowBox[{"1.0", ",", "obs_strength"}], ")"}]}]}], "\n", 
   RowBox[{"residual", "=", 
    RowBox[{"dphi_dt", "+", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"self", ".", "Gamma"}], "*", "phi_val"}], ")"}], "-", 
     "source"}]}], "\n", 
   RowBox[{"return", " ", "residual"}], "\n", "\n", 
   RowBox[{
   "#", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", 
    "===", "===", "===", "===", 
    RowBox[{"#", " ", "3.", " ", "DISPERSION", " ", "MATRIX", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"From", " ", "Sections", " ", "10"}], "&"}], " ", "11"}], 
      ")"}]}]}], "\n", 
   RowBox[{
    RowBox[{
    "#", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", 
     RowBox[{"def", " ", "get_stiffness", "_matrix", 
      RowBox[{"(", 
       RowBox[{
       "self", ",", "k_sq", ",", "omega_sq", ",", "params", ",", "bg"}], 
       ")"}]}]}], ":", 
    RowBox[{"\"\<\>\"", "\"\<\n        Constructs the 4x4 Stiffness Matrix \
(M).\n        K = omega^2 - k^2 (Lorentzian signature)\n        Fields: [u, \
v, w, q] corresponding to [rho, chi, r, s] perturbations.\n        \>\"", "\"\
\<\>\""}]}], "\n", 
   RowBox[{"K", "=", 
    RowBox[{"omega_sq", "-", "k_sq"}]}], "\n", "\n", 
   RowBox[{"alpha", ",", "beta", ",", "mu", ",", 
    RowBox[{"sigma", "=", 
     RowBox[{"params", "[", 
      RowBox[{"'", 
       RowBox[{"alpha", "'"}]}], "]"}]}], ",", 
    RowBox[{"params", "[", 
     RowBox[{"'", 
      RowBox[{"beta", "'"}]}], "]"}], ",", 
    RowBox[{"params", "[", 
     RowBox[{"'", 
      RowBox[{"mu", "'"}]}], "]"}], ",", 
    RowBox[{"params", "[", 
     RowBox[{"'", 
      RowBox[{"sigma", "'"}]}], "]"}]}], "\n", 
   RowBox[{"lam", ",", 
    RowBox[{"eta", "=", 
     RowBox[{"params", "[", 
