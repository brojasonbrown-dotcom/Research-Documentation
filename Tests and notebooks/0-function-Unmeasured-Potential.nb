Cell[CellGroupData[{

Cell["11. Plane-Wave Modal Reduction", "Section",ExpressionUUID->"d9c83624-4bb0-5e40-8ac7-edd9dc2b0d2a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"planeRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"u", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"u0", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "xx"}], "+", 
              RowBox[{"ky", " ", "yy"}], "+", 
              RowBox[{"kz", " ", "zz"}], "-", 
              RowBox[{"\[Omega]", " ", "tt"}]}], ")"}]}], "]"}]}]}], "]"}]}], 
      ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"v", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"v0", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "xx"}], "+", 
              RowBox[{"ky", " ", "yy"}], "+", 
              RowBox[{"kz", " ", "zz"}], "-", 
              RowBox[{"\[Omega]", " ", "tt"}]}], ")"}]}], "]"}]}]}], "]"}]}], 
      ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"w", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"w0", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "xx"}], "+", 
              RowBox[{"ky", " ", "yy"}], "+", 
              RowBox[{"kz", " ", "zz"}], "-", 
              RowBox[{"\[Omega]", " ", "tt"}]}], ")"}]}], "]"}]}]}], "]"}]}], 
      ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"q", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"q0", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "xx"}], "+", 
              RowBox[{"ky", " ", "yy"}], "+", 
              RowBox[{"kz", " ", "zz"}], "-", 
              RowBox[{"\[Omega]", " ", "tt"}]}], ")"}]}], "]"}]}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modalAlgebraic", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"linearizedSystem", " ", "/.", " ", "planeRules"}], ")"}], "/", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"kx", " ", "x"}], "+", 
          RowBox[{"ky", " ", "y"}], "+", 
          RowBox[{"kz", " ", "z"}], "-", 
          RowBox[{"\[Omega]", " ", "t"}]}], ")"}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stiffnessMatrix", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "v0", ",", "w0", ",", "q0"}], "}"}]}], "]"}], " ",
       "&"}], " ", "/@", " ", "modalAlgebraic"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dispersionDet", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Det", "[", "stiffnessMatrix", "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"say", "[", "\"\<Dispersion determinant:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"dispersionDet", " ", "//", " ", "TraditionalForm"}], "]"}], 
  ";"}]}], "Input",
 CellLabel->
