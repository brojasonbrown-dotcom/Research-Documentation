Cell[CellGroupData[{

Cell["2. Interpretive Layer Definitions", "Section",ExpressionUUID->"ce6fb6d7-97b4-2a4a-aec4-58830a4d88dd"],

Cell["\<\
These are OPF-level semantic declarations, not yet equations. \
\>", "Text",ExpressionUUID->"472c97ca-dbc1-4b4e-bf17-0a62d121e9d7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"layer0", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<ZeroMeaning\>\"", "->", "\"\<UnmeasuredPotential\>\""}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<MeasuredZero\>\"", "->", "\"\<ObservableNull\>\""}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<TemporalMode\>\"", 
       "->", "\"\<PremeasurementTimeless\>\""}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<Topology\>\"", "->", "\"\<Sphere\>\""}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<BoundaryDuality\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "Infinity"}], "}"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<Substrate\>\"", 
       "->", "\"\<LatentInformationalPotential\>\""}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"layer1", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<StateVector\>\"", "->", 
       RowBox[{"\[CapitalPsi]", "[", 
        RowBox[{"\[Rho]", ",", "\[Chi]", ",", "r", ",", "s"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Interpretation\>\"", 
       "->", "\"\<Self-relational field prior to stabilized \
observation\>\""}]}], "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"layer2", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Interpretation\>\"", 
      "->", "\"\<Measured persistent spacetime sector\>\""}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<PersistenceLaw\>\"", 
      "->", "\"\<D[field,t] + \[CapitalGamma] field == source\>\""}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]}], "Input",
 CellLabel->"In[60]:=",ExpressionUUID->"63e910e3-a316-3e4c-b6ec-74075be75530"],

