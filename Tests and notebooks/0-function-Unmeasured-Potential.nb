    RowBox[{"params", "[", 
     RowBox[{"'", 
      RowBox[{"eta", "'"}]}], "]"}]}], "\n", "\n", 
   RowBox[{"rho0", ",", "chi0", ",", "r0", ",", 
    RowBox[{"s0", "=", 
     RowBox[{"bg", "[", 
      RowBox[{"'", 
       RowBox[{"rho0", "'"}]}], "]"}]}], ",", 
    RowBox[{"bg", "[", 
     RowBox[{"'", 
      RowBox[{"chi0", "'"}]}], "]"}], ",", 
    RowBox[{"bg", "[", 
     RowBox[{"'", 
      RowBox[{"r0", "'"}]}], "]"}], ",", 
    RowBox[{"bg", "[", 
     RowBox[{"'", 
      RowBox[{"s0", "'"}]}], "]"}]}], "\n", "\n", 
   RowBox[{
    RowBox[{
    "#", " ", "Matrix", " ", "rows", " ", "derived", " ", "from", " ", "the", 
     " ", "Euler"}], "-", 
    RowBox[{"Lagrange", " ", "equations"}]}], "\n", 
   RowBox[{
    RowBox[{"#", " ", "Row", " ", "1"}], ":", 
    RowBox[{"rho", " ", 
     RowBox[{"(", "u", ")"}]}]}], "\n", 
   RowBox[{"row1", "=", 
    RowBox[{"[", 
     RowBox[{
      RowBox[{
