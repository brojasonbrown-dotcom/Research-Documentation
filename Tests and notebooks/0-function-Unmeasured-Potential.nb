      RowBox[{
       RowBox[{"'", 
        RowBox[{"chi0", "'"}]}], ":", "1.0"}], ",", 
      RowBox[{
       RowBox[{"'", 
        RowBox[{"r0", "'"}]}], ":", "0.1"}], ",", 
      RowBox[{
       RowBox[{"'", 
        RowBox[{"s0", "'"}]}], ":", "1.0"}]}], "}"}]}], "\n", 
   RowBox[{"roots_stable", "=", 
    RowBox[{
     RowBox[{"opf", ".", "check_stability"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"k_sq", "=", "0.5"}], ",", 
       RowBox[{"params", "=", "params"}], ",", 
       RowBox[{"bg", "=", "bg_stable"}]}], ")"}]}]}], "\n", 
   RowBox[{"print", 
    RowBox[{"(", 
     RowBox[{
     "f", "\"\<  Stable Background Roots (K = omega^2 - k^2): \
{np.round(roots_stable, 4)}\>\""}], ")"}]}], "\n", "\n", 
   RowBox[{"print", 
    RowBox[{"(", "\"\<\\n[ANALYSIS]\>\"", ")"}]}], "\n", 
   RowBox[{"print", 
    RowBox[{
    "(", "\"\<  - Negative K roots indicate Tachyonic modes \
(instability).\>\"", ")"}]}], "\n", 
   RowBox[{"print", 
    RowBox[{
    "(", "\"\<  - Positive K roots indicate stable propagating waves \
(Spacetime geometry).\>\"", ")"}]}], "\n", 
   RowBox[{"print", 
    RowBox[{"(", 
     RowBox[{"\"\<=\>\"", "*", "70"}], ")"}]}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"if", " ", "__name", "__"}], "==", "\"\<__main__\>\""}], ":", 
    RowBox[{"run_tests", 
     RowBox[{"(", ")"}], " "}]}]}]}]], "Input",
