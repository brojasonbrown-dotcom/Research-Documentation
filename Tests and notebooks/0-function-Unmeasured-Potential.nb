Cell[CellGroupData[{

Cell["4. Field Content and Action Structure", "Section",ExpressionUUID->"39321e27-4108-2e46-bb54-68479f6a6a73"],

Cell[TextData[{
 "We introduce a stabilization field ",
 StyleBox["s", "TI"],
 " representing the degree to which spacetime observability has formed. "
}], "Text",ExpressionUUID->"7f1ff561-6b3c-374b-aa36-231a5f09a839"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gradSq4", "[", "head_", "]"}], ":=", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"head", "[", 
