Cell[CellGroupData[{

Cell["10. Linearization Around Latent and Stabilized Backgrounds", "Section",ExpressionUUID->"07a80cf6-c13c-ac4b-b425-154992b65aab"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"linRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\[Rho]", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"\[Rho]0", "+", 
          RowBox[{"\[CurlyEpsilon]", " ", 
           RowBox[{"u", "[", 
            RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
        "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\[Chi]", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"\[Chi]0", "+", 
          RowBox[{"\[CurlyEpsilon]", " ", 
           RowBox[{"v", "[", 
            RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
        "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"r", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"r0", "+", 
          RowBox[{"\[CurlyEpsilon]", " ", 
           RowBox[{"w", "[", 
            RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
        "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"s", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"s0", "+", 
          RowBox[{"\[CurlyEpsilon]", " ", 
           RowBox[{"q", "[", 
            RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"backgroundTerms", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"\[CurlyEpsilon]", ",", "0", ",", "0"}], "}"}]}], "]"}], 
       "]"}], " ", "&"}], " ", "/@", " ", 
     RowBox[{"(", 
      RowBox[{"eulerLHS", " ", "/.", " ", "linRules"}], ")"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearizedSystem", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{
         RowBox[{"Normal", "[", 
          RowBox[{"Series", "[", 
           RowBox[{"#", ",", 
            RowBox[{"{", 
             RowBox[{"\[CurlyEpsilon]", ",", "0", ",", "1"}], "}"}]}], "]"}], 
          "]"}], ",", "\[CurlyEpsilon]"}], "]"}], " ", "&"}], " ", "/@", " ", 
      RowBox[{"(", 
       RowBox[{"eulerLHS", " ", "/.", " ", "linRules"}], ")"}]}], "]"}]}], 
