Cell[CellGroupData[{

Cell["16. Correct Value Insertion and Testing Protocol", "Section",ExpressionUUID->"2b29fcc9-dae7-5048-8be2-4f490ad3ca9f"],

Cell["This is critical. ", "Text",ExpressionUUID->"62520513-98a6-9c49-8fdc-7ef14dccbc9e"],

Cell[CellGroupData[{

Cell["16.1 Symbolic first", "Subsection",ExpressionUUID->"2d011861-2fa0-5842-b8e1-07db50600bac"],

Cell[TextData[{
 "Do ",
 StyleBox["not",
  FontWeight->Bold],
 " insert arbitrary numbers before: "
}], "Text",ExpressionUUID->"a7c7f444-181f-3d4b-8124-c4d6ff9793a8"],

