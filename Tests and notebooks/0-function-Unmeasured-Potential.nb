Cell[CellGroupData[{

Cell["9. Emergent Spacetime Surrogate Equation", "Section",ExpressionUUID->"8449215c-f955-3848-a795-c5ff50d3c58f"],

Cell[TextData[{
 "To model the claim \[OpenCurlyDoubleQuote]once mentioned/observed, it \
becomes stabilized spacetime\[CloseCurlyDoubleQuote], we use ",
 StyleBox["s", "TI"],
 " as the spacetime-stabilization surrogate: "
}], "CodeText",ExpressionUUID->"491fbc60-5bfb-4b4c-9d7c-6a7725c05d93"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"spacetimeSurrogateEquation", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{"SelectFirst", "[", 
     RowBox[{"eulerSystem", ",", 
      RowBox[{
       RowBox[{"!", " ", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"#", ",", 
          RowBox[{"s", "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}], "]"}]}], " ",
        "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "say", "[", "\"\<Spacetime-stabilization surrogate equation:\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"spacetimeSurrogateEquation", " ", "//", " ", "TraditionalForm"}], 
   "]"}], ";"}]}], "Input",
 CellLabel->"In[93]:=",ExpressionUUID->"748b335f-a0fb-b340-a46d-1beb114a7c64"],

