Cell[CellGroupData[{

Cell["1. Initialization", "Section",ExpressionUUID->"a9c45574-ef40-b645-8402-4989ba88260c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Needs", "[", "\"\<VariationalMethods`\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$HistoryLength", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Alpha]", ",", "\[Beta]", ",", "\[Mu]", ",", "\[CapitalGamma]", ",",
          "\[Kappa]", ",", "\[Sigma]", ",", "\[Eta]", ",", "\[CurlyEpsilon]", 
         ",", "\[Rho]0", ",", "\[Chi]0", ",", "r0", ",", "obs", ",", 
         "\[Lambda]", ",", "\[Omega]", ",", "kx", ",", "ky", ",", "kz"}], 
        "}"}], ",", "Reals"}], "]"}], "&&", "\[IndentingNewLine]", "   ", 
     RowBox[{"\[Alpha]", ">", "0"}], "&&", 
     RowBox[{"\[Beta]", ">", "0"}], "&&", 
     RowBox[{"\[Mu]", ">", "0"}], "&&", 
     RowBox[{"\[CapitalGamma]", ">=", "0"}], "&&", 
     RowBox[{"\[Kappa]", ">=", "0"}], "&&", 
     RowBox[{"\[Sigma]", ">=", "0"}], "&&", 
     RowBox[{"\[Eta]", ">=", "0"}], "&&", 
     RowBox[{"\[Chi]0", ">", "0"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords4", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spatialCoords", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fields", "=", 
   RowBox[{"{", 
    RowBox[{"\[Rho]", ",", "\[Chi]", ",", "r", ",", "s"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fieldVars", "=", 
   RowBox[{"Through", "[", 
    RowBox[{"fields", "[", 
     RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kSq", "=", 
    RowBox[{
     RowBox[{"kx", "^", "2"}], "+", 
     RowBox[{"ky", "^", "2"}], "+", 
     RowBox[{"kz", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"say", "[", "msg_", "]"}], ":=", 
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{"msg", ",", "14", ",", "Bold", ",", 
      RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pass", "[", "msg_", "]"}], ":=", 
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"\"\<PASS: \>\"", " ", "<>", " ", "msg"}], ",", 
      RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fail", "[", "msg_", "]"}], ":=", 
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"\"\<FAIL: \>\"", " ", "<>", " ", "msg"}], ",", "Red"}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"warn", "[", "msg_", "]"}], ":=", 
    RowBox[{"Print", "[", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"\"\<WARN: \>\"", " ", "<>", " ", "msg"}], ",", 
       RowBox[{"Darker", "[", "Orange", "]"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"residualNorm", "[", "exprs_", "]"}], ":=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Total", "[", 
     RowBox[{"Expand", "[", 
      RowBox[{"exprs", "^", "2"}], "]"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"f342a55e-8b81-604c-a0f1-7fc98cbb6c9b"],

