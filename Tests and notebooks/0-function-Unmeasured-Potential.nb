Cell[CellGroupData[{

Cell["\<\
3. Operator for Unmeasured Potential and Stabilized Observation\
\>", "Section",ExpressionUUID->"88e8b674-83e9-cd48-8a16-cf8dee2a16dc"],

Cell["We separate three notions: ", "Text",ExpressionUUID->"adea78c1-ecaf-1c40-9863-f4631801d316"],

Cell[TextData[{
 Cell[BoxData[Cell["latentZero",
   Background->None,ExpressionUUID->"abf8e590-5945-ef48-a0af-045fb00efb62"]], 
  "InlineCode",ExpressionUUID->"926d777d-5de9-8a4d-88e6-7d967f15f4a9"],
 ": semantic unmeasured potential"
}], "Item",ExpressionUUID->"8fed9a6c-a332-8643-a07a-51cd5589ebf7"],

Cell[TextData[{
 Cell[BoxData[Cell["observedZero",
   Background->None,ExpressionUUID->"92abae3f-4660-b84e-a6ea-7bed9b1b1141"]], 
  "InlineCode",ExpressionUUID->"0006d281-c632-f44c-a0e2-b9d4ff22bb40"],
 ": actual measured null value"
}], "Item",ExpressionUUID->"e1c24280-edbd-a94e-80ab-b4d604a3d10f"],

Cell[TextData[{
 Cell[BoxData[Cell["measurementOperator",
   Background->None,ExpressionUUID->"c9927c91-65fe-374c-a867-5bbfc138e7b5"]], 
  "InlineCode",ExpressionUUID->"674136c4-8148-0841-b08b-55614541cc80"],
 ": transforms latent state into observed state"
}], "Item",ExpressionUUID->"471dd4e9-2363-d345-88c2-7c3eb2a188d5"],

Cell[CellGroupData[{

Cell["3.1 Symbolic OPF operators", "Subsection",ExpressionUUID->"4ece9066-67ea-e54c-a23d-9186bf09009d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"latentZero", " ", "/:", " ", 
   RowBox[{"Format", "[", "latentZero", "]"}], ":=", 
   RowBox[{"Subscript", "[", 
    RowBox[{"0", ",", "\"\<latent\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"observedZero", " ", "/:", " ", 
    RowBox[{"Format", "[", "observedZero", "]"}], ":=", 
    RowBox[{"Subscript", "[", 
     RowBox[{"0", ",", "\"\<obs\>\""}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"measurementOperator", "[", 
     RowBox[{"state_", ",", "obsStrength_"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", "obsStrength"}], "]"}]}], ")"}], " ", "state"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"unmeasuredComponent", "[", 
     RowBox[{"state_", ",", "obsStrength_"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"-", "obsStrength"}], "]"}], " ", "state"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stabilizationOperator", "[", 
    RowBox[{"state_", ",", "obsStrength_", ",", "\[Gamma]_"}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"measurementOperator", "[", 
      RowBox[{"state", ",", "obsStrength"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", "\[Gamma]"}], ")"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[63]:=",ExpressionUUID->"184bbf0a-547a-2d46-bf73-37acd4f18c07"],

Cell["Interpretation: ", "Text",ExpressionUUID->"30cfe7d9-8f22-634e-82f4-6db0f61807aa"],

Cell[TextData[{
 "if ",
 Cell[BoxData[Cell["obsStrength = 0",
   Background->None,ExpressionUUID->"48e92f2b-a551-fc4c-8520-0d4a289c62de"]], 
  "InlineCode",ExpressionUUID->"50472abb-81ff-de4e-b43e-e65bea2f8a10"],
 " then the measured component is 0 and the state remains latent"
}], "Item",ExpressionUUID->"793f4e89-d67d-1944-8159-fe6bcac98914"],

Cell[TextData[{
 "as ",
 Cell[BoxData[Cell["obsStrength",
   Background->None,ExpressionUUID->"97870bc1-ba3a-7140-a7aa-29c1f83e76f8"]], 
  "InlineCode",ExpressionUUID->"2a70c609-183d-ca44-bf83-06abc905e3fe"],
 " increases, latent potential is transferred into observable stabilized \
sector"
}], "Item",ExpressionUUID->"0047461a-9c7a-1742-bd13-4f73e7c0dc61"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
3.2 Scalar order parameter for observation-induced stabilization\
\>", "Subsection",ExpressionUUID->"93b76130-0f4d-e344-ab4c-00bb0592da97"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"observationalOrder", "[", "obs_", "]"}], ":=", 
   RowBox[{"1", "-", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "\[Kappa]"}], " ", "obs"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[68]:=",ExpressionUUID->"5197ff25-eee5-564d-82af-6bc017960f06"],

Cell["Properties: ", "Text",ExpressionUUID->"6f39afbd-ff56-e64b-9ef6-978be4395056"],

Cell[TextData[Cell[BoxData[Cell["observationalOrder[0] = 0",
  Background->None,ExpressionUUID->
  "39ba893f-f179-bc42-a301-6864445e469e"]], \
"InlineCode",ExpressionUUID->"30d1a463-5f8f-5642-aa4c-58be38725179"]], "Item",\
ExpressionUUID->"4d5ae92f-0de0-ff44-ae2d-b272391e098b"],

Cell["monotone increasing", "Item",ExpressionUUID->"a13e863a-6269-8140-b6f5-cf2022db11fc"],

Cell["bounded by 1 for positive observation strength", "Item",ExpressionUUID->"29d87cad-dbc2-ac40-a28f-e23dbbe11bae"],

Cell["This gives a mathematically clean interpolation between: ", "Text",ExpressionUUID->"64b7104a-f946-d748-8843-e8d924e31cce"],

Cell["unmeasured potential", "Item",ExpressionUUID->"0df3e681-c7c2-8041-98f3-b8615307b9a2"],

