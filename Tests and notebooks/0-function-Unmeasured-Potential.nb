              RowBox[{"t", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], 
              "]"}], " ", "+", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"Derivative", "[", 
                RowBox[{"2", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
                "]"}], "[", "\[Chi]", "]"}], "[", 
              RowBox[{"t", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], 
              "]"}]}], ")"}]}]}], ")"}], " ", "==", " ", "0"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", 
              RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "2"}], 
              "]"}], "[", "r", "]"}], "[", 
            RowBox[{"t", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], "]"}],
            " ", "+", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", 
              RowBox[{"0", ",", " ", "0", ",", " ", "2", ",", " ", "0"}], 
              "]"}], "[", "r", "]"}], "[", 
            RowBox[{"t", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], "]"}],
            " ", "+", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", 
              RowBox[{"0", ",", " ", "2", ",", " ", "0", ",", " ", "0"}], 
              "]"}], "[", "r", "]"}], "[", 
            RowBox[{"t", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], "]"}],
            " ", "+", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", 
              RowBox[{"2", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], 
              "]"}], "[", "r", "]"}], "[", 
            RowBox[{"t", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], 
            "]"}]}], " ", "==", " ", "0"}], ")"}], " ", "==", " ", "0"}], ",",
        " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"s0", "*", "\[Lambda]"}], " ", "==", " ", 
          RowBox[{
           RowBox[{"\[Eta]", "*", "\[Rho]0"}], " ", "+", " ", 
           RowBox[{"\[Sigma]", "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Derivative", "[", 
                 RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "2"}], 
                 "]"}], "[", "s", "]"}], "[", 
               RowBox[{"t", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], 
               "]"}], " ", "+", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Derivative", "[", 
                 RowBox[{"0", ",", " ", "0", ",", " ", "2", ",", " ", "0"}], 
                 "]"}], "[", "s", "]"}], "[", 
               RowBox[{"t", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], 
               "]"}], " ", "+", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"Derivative", "[", 
                 RowBox[{"0", ",", " ", "2", ",", " ", "0", ",", " ", "0"}], 
                 "]"}], "[", "s", "]"}], "[", 
               RowBox[{"t", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], 
               "]"}], " ", "+", " ", 
              RowBox[{
