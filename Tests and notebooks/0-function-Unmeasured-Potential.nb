Cell[CellGroupData[{

Cell["15. Universe Emergence Relative Structure", "Section",ExpressionUUID->"4ce7d1b9-49be-a64f-84bf-4fc0f6e7ab69"],

Cell["\<\
To connect to cosmological emergence rigorously, use a surrogate order \
parameter rather than a direct physical claim. \
\>", "Text",ExpressionUUID->"ebe521a4-780c-044e-a434-ff4b1c87ea77"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cosmicOrderEquation", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"a", "[", "t", "]"}], ",", "t"}], "]"}], "==", 
     RowBox[{
      RowBox[{"\[Nu]", " ", 
