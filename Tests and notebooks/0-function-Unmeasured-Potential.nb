    RowBox[{"\"\<\>\"", "\"\<\n        Finds omega^2 by solving Det(M) = 0, \
which is an eigenvalue problem for K.\n        Since M is linear in K, we can \
solve Det(M(K)) = 0.\n        \>\"", "\"\<\>\""}]}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"#", " ", "For", " ", "this", " ", "specific", " ", "block"}], "-",
      "diagonal", "-", 
     RowBox[{"like", " ", "matrix"}]}], ",", 
    RowBox[{
    "we", " ", "can", " ", "solve", " ", "it", " ", "analytically"}]}], "\n", 
   RowBox[{
    RowBox[{"#", " ", "Det", 
     RowBox[{"(", "M", ")"}]}], "=", 
    RowBox[{
    "0", " ", "implies", " ", "the", " ", "product", " ", "of", " ", "the", " ",
      "diagonal", " ", "blocks", " ", "determinants", " ", "is", " ", 
     "0."}]}], "\n", "\n", 
   RowBox[{"alpha", ",", "beta", ",", "mu", ",", 
