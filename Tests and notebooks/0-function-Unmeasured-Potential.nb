               "]"}]}], ")"}]}]}]}], ")"}], " ", "==", " ", "0"}]}], "}"}], ",",
      " ", 
     RowBox[{"{", 
      RowBox[{"\[Rho]0", ",", " ", "\[Chi]0", ",", " ", "s0"}], "}"}], ",", 
     " ", "Reals"}], "]"}],
   ShowStringCharacters->True,
   NumberMarks->True],
  InputForm[
   Solve[{($CellContext`s0 $CellContext`\[Eta] + $CellContext`\[Alpha] (
         Derivative[
