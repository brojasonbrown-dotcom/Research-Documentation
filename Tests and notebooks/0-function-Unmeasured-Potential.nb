Cell[CellGroupData[{

Cell["\<\
13. Double-Slit Relative Structure: What Is Rigorous to Claim?\
\>", "Section",ExpressionUUID->"ff1c410b-4222-8746-aef3-6eff580602e3"],

Cell["We must separate: ", "Text",ExpressionUUID->"494ec421-3f71-2747-80d6-cafb5ba68cae"],

Cell[CellGroupData[{

Cell["Allowed rigorous analogy", "Subsection",ExpressionUUID->"5efb6f18-9e55-ed4b-bc72-0096b775eb54"],

Cell["\<\
an observation-strength parameter suppresses interference-like coherence\
\>", "Item",ExpressionUUID->"6fc28c3f-d284-f549-8299-a2c6baf794ce"],

Cell["\<\
a measured sector can be modeled by projection / decoherence operators\
\>", "Item",ExpressionUUID->"bc6fd2cc-ef36-d64d-8ebd-df4bcbac1cbe"],

Cell["scale and coupling can change whether interference survives", "Item",ExpressionUUID->"d77488c2-0610-b043-a872-7edf828ba968"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Not allowed without full derivation", "Subsection",ExpressionUUID->"14dbc7de-fe8f-1b4a-a782-3f2aac5deca4"],

Cell["\<\
claiming the OPF Lagrangian directly reproduces quantum electrodynamics\
\>", "Item",ExpressionUUID->"38bc122d-a4db-c64f-af18-1aa4263a8f7b"],

Cell["claiming cosmogenesis is proved by the same equations", "Item",ExpressionUUID->"af1e6c3d-0843-5c4c-bc57-b1b8271acb87"],

Cell["\<\
claiming \[OpenCurlyDoubleQuote]mention causes universe\
\[CloseCurlyDoubleQuote] without an operational measurement map\
\>", "Item",ExpressionUUID->"a54c22a7-c847-5c41-b46a-0b6a27e5a49b"],

Cell["So we define a rigorous surrogate coherence model. ", "Text",ExpressionUUID->"f636e769-f270-9242-861d-63b7e701aafe"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
13.1 Interference amplitude with observation-dependent suppression\
\>", "Subsection",ExpressionUUID->"67005f70-5c59-0c44-9aa9-29f4a4ef5933"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"coherenceFactor", "[", "obs_", "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "\[Kappa]"}], " ", "obs"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"slitAmplitude", "[", 
     RowBox[{"x_", ",", "obs_"}], "]"}], ":=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"a1", "[", "x", "]"}], "+", 
     RowBox[{
      RowBox[{"coherenceFactor", "[", "obs", "]"}], " ", 
      RowBox[{"a2", "[", "x", "]"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"intensity", "[", 
    RowBox[{"x_", ",", "obs_"}], "]"}], ":=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"slitAmplitude", "[", 
       RowBox[{"x", ",", "obs"}], "]"}], "]"}], "^", "2"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[113]:=",ExpressionUUID->"582ee28f-4b0b-594a-a77b-a7e322e51edb"],

Cell["The correct testable statement is: ", "Text",ExpressionUUID->"b4eb9f25-7e42-744a-9098-a1ac5535074b"],

Cell[TextData[{
 "as ",
 StyleBox["obs", "TI"],
 " increases, the interference cross-term is suppressed if the amplitudes \
remain phase-coherent only through the latent sector."
}], "Item",ExpressionUUID->"46ae9c53-b32c-a94c-8b24-c0d1aded4a64"]
}, Open  ]],

Cell[CellGroupData[{

Cell["13.2 Explicit symbolic interference decomposition", "Subsection",ExpressionUUID->"325b303a-e44e-0a4e-a447-7b4980aa9cb3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"interferenceDecomposition", "=", 
    RowBox[{"ComplexExpand", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"intensity", "[", 
       RowBox[{"x", ",", "obs"}], "]"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"TargetFunctions", "->", 
       RowBox[{"{", 
        RowBox[{"Re", ",", "Im"}], "}"}]}]}], "\[IndentingNewLine]", "   ", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "say", "[", "\"\<Observation-dependent interference intensity:\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"interferenceDecomposition", " ", "//", " ", "TraditionalForm"}], 
   "]"}], ";"}]}], "Input",
 CellLabel->
  "In[116]:=",ExpressionUUID->"5517d246-3205-ab4f-8437-3eb2571c3720"],

Cell[CellGroupData[{

Cell[BoxData[
 StyleBox["\<\"Observation-dependent interference intensity:\"\>",
  StripOnInput->False,
  LineColor->RGBColor[0, 0, 
    Rational[2, 3]],
  FrontFaceColor->RGBColor[0, 0, 
    Rational[2, 3]],
  BackFaceColor->RGBColor[0, 0, 
    Rational[2, 3]],
  GraphicsColor->RGBColor[0, 0, 
    Rational[2, 3]],
  FontSize->14,
  FontWeight->Bold,
  FontColor->RGBColor[0, 0, 
    Rational[2, 3]]]], "Print",
 CellChangeTimes->{4.0017517588805046`*^9},
 CellLabel->
  "During evaluation of \
In[116]:=",ExpressionUUID->"6e3791be-6418-6d4e-8c81-dd1db0e16d05"],

Cell[BoxData[
 TagBox[
  FormBox[
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"a1", "(", "x", ")"}], " ", 
     RowBox[{"a2", "(", "x", ")"}], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[Kappa]", " ", 
       RowBox[{"(", 
        RowBox[{"-", "obs"}], ")"}]}]]}], "+", 
    SuperscriptBox[
     RowBox[{"a1", "(", "x", ")"}], "2"], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"a2", "(", "x", ")"}], "2"], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "\[Kappa]", " ", "obs"}]]}]}],
   TraditionalForm],
  TraditionalForm,
  Editable->True]], "Print",
 CellChangeTimes->{4.0017517588955*^9},
 CellLabel->
  "During evaluation of \
In[116]:=",ExpressionUUID->"2ca47635-e2ed-fc4a-8df4-5884f060fd4d"]
}, Open  ]]
}, Open  ]],

