Cell[CellGroupData[{
Cell["\<\
OPF Emergence Notebook: Unmeasured Potential, Stabilized Spacetime, and \
Rigorous Test Structures\
\>", "Title",ExpressionUUID->"464be950-d1b5-7c44-9bc6-bd1ae278ef58"],

Cell["This notebook formalizes your proposed mechanism: ", "Text",ExpressionUUID->"06d4df05-c000-9242-99bf-075fce06417d"],

Cell[TextData[{
 Cell[BoxData[Cell["0",
   Background->None,ExpressionUUID->"7aa71260-1083-d944-a64e-4437e212d6a8"]], 
  "InlineCode",ExpressionUUID->"2464d2d3-c9a5-c547-9ea8-213dbb3ea85b"],
 " as ",
 StyleBox["unmeasured potential",
  FontWeight->Bold],
 " rather than measured emptiness"
}], "Item",ExpressionUUID->"0486733f-8556-f54c-affe-821e8cce7757"],

Cell[TextData[{
 "observation / mention as a ",
 StyleBox["measurement-stabilization operation",
  FontWeight->Bold]
}], "Item",ExpressionUUID->"9794cd2f-d1d1-824a-8adc-501e91c87b95"],

Cell["\<\
emergence of decohered spacetime as a Layer-2 stabilized sector\
\>", "Item",ExpressionUUID->"9be86b34-fb98-0f48-9a91-e1818f73dcee"],

Cell[CellGroupData[{

Cell["comparison targets inspired by:", "Item",ExpressionUUID->"9cbb2b23-88bd-694e-9aed-40f393638c41"],

Cell["early-universe emergence narratives", "Subitem",ExpressionUUID->"8cf7cf8f-0428-8a4e-a777-29d9ab336145"],

Cell["double-slit measurement dependence", "Subitem",ExpressionUUID->"72fe9d53-09ad-af4b-9f84-f1f66d2ea1b5"],

Cell["scale-relative decoherence", "Subitem",ExpressionUUID->"95fce184-9906-0c44-a6d1-5928b1860b98"]
