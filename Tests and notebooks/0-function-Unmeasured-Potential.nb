Cell[CellGroupData[{

Cell["19. Relative Findings Documentation Template", "Section",ExpressionUUID->"ad06e463-f345-914e-a620-13d71db004b7"],

Cell["This section records what is actually supported. ", "Text",ExpressionUUID->"32b0ac5b-ba99-b547-a898-1c8249e31503"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"relativeFindings", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Supported\>\"", "->", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<A mathematically explicit observation-strength operator \
can interpolate between latent and measured sectors.\>\"", ",", 
         "\[IndentingNewLine]", 
         "    ", "\"\<A stabilization field can be introduced and tested as \
an order parameter.\>\"", ",", "\[IndentingNewLine]", 
         "    ", "\"\<Observation-dependent interference suppression can be \
modeled rigorously as coherence damping.\>\"", ",", "\[IndentingNewLine]", 
         "    ", "\"\<Scale-relative coherence loss can be represented by \
explicit decoherence-rate functions.\>\""}], "\[IndentingNewLine]", "  ", 
        "}"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ConditionallySupported\>\"", "->", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<An observed sector may emerge dynamically if background \
branches bifurcate under source terms.\>\"", ",", "\[IndentingNewLine]", 
         "    ", "\"\<A cosmological emergence analogy can be tested using \
surrogate order parameters.\>\""}], "\[IndentingNewLine]", "  ", "}"}]}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<NotYetEstablished\>\"", "->", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Direct derivation of physical spacetime from semantic \
mention alone.\>\"", ",", "\[IndentingNewLine]", 
         "    ", "\"\<Direct explanation of the full double-slit experiment \
from this OPF system without quantum measurement theory and experimental \
fitting.\>\"", ",", "\[IndentingNewLine]", 
