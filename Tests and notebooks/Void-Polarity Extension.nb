Cell[CellGroupData[{

Cell["10. Rigid Workflow for Updating the Notebook", "Section",ExpressionUUID->"0ee2b214-66b5-4e4b-8da7-f9a49b62351e"],

Cell[CellGroupData[{

Cell["Phase 1 \[LongDash] Clarify Definitions", "Subsection",ExpressionUUID->"a32b62a7-7008-af4d-9031-e8eb2fc3cc44"],

Cell["Define precisely:", "Text",ExpressionUUID->"342599de-2f44-694b-a996-306f8c579802"],

Cell["1. what counts as \"information density\"", "Text",ExpressionUUID->"86f9743e-c589-f141-9507-ececa756359a"],

Cell["2. what counts as \"void density\"", "Text",ExpressionUUID->"46ab69d1-c972-4148-bcad-6acb35eedaa5"],

Cell[TextData[{
 "3. whether ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Nu]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\nu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "db723f01-59e4-0f41-9852-f319ce4377f2"],
 " is scalar, tensorial, or operator-valued"
}], "Text",ExpressionUUID->"e642f3b4-6b10-4f45-9083-0a785140602c"],

Cell[TextData[{
 "4. whether anisotropy ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> "A", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "081dd2d9-4795-7f45-9f26-e149d70837ef"],
 " is a vector field, tensor field, or kernel"
}], "Text",ExpressionUUID->"4f229516-6dd6-ef48-b2ee-87b5ad9bc1d8"],

Cell["5. what \"measurement\" means mathematically ", "Text",ExpressionUUID->"68e0943a-e490-1949-b7be-8708aee8f3dd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Phase 2 \[LongDash] Minimal Symbolic Model", "Subsection",ExpressionUUID->"f88dbc98-82d0-f747-936f-49ad22280e47"],

Cell["Build a minimal symbolic model with: ", "Text",ExpressionUUID->"51497d81-0043-e74a-b2ea-42efee87091e"],

Cell[TextData[{
 "domain ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["X", "TI"], TraditionalForm], "errors" -> {}, "input" -> "X", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "12866d51-dccb-e446-876f-6355b3fc6284"]
}], "Item",ExpressionUUID->"60b2d62c-d26d-1445-8927-1c7a61727d20"],

Cell[TextData[{
 "fields ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", ",", "\[Chi]", ",", "\[Nu]", ",", 
         StyleBox["R", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho, \\chi, \\nu, R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1bcbd5fc-b563-7044-a322-556ace01a899"]
}], "Item",ExpressionUUID->"4927688e-16a7-9540-9a05-df40233cf599"],

Cell["extended Lagrangian", "Item",ExpressionUUID->"f6178773-c2c6-1d49-ad38-583bf7279da7"],

Cell["assumptions", "Item",ExpressionUUID->"593bae86-6367-0b4f-a20c-b3926c691d3d"],

Cell["candidate measurement and restoration operators", "Item",ExpressionUUID->"1df498c8-caca-604e-bd58-387ae5acadb2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Phase 3 \[LongDash] Derive Equations", "Subsection",ExpressionUUID->"d7b6223e-e402-f44b-a5dc-0964f61b3a79"],

Cell["1. compute Euler equations", "Text",ExpressionUUID->"26bc17ea-c0a9-ba4b-b2d9-97f3269e50ca"],

Cell["2. inspect whether the original action is degenerate", "Text",ExpressionUUID->"928aad91-fbf9-4345-8e3e-3d14f1721826"],

Cell["3. determine which extra derivative terms are necessary ", "Text",ExpressionUUID->"6d4811fe-c121-184f-a22e-24c6cc7a6114"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Phase 4 \[LongDash] Two-Body Geometry", "Subsection",ExpressionUUID->"156f4b53-1f58-3544-ac0a-cdee6079f0a9"],

Cell["1. define relational axis", "Text",ExpressionUUID->"4e14392c-b029-2f43-857a-dfece4435261"],

Cell["2. define opposite-side kernel", "Text",ExpressionUUID->"ae67c62a-e7e2-1146-b5a7-2daf0908093e"],

Cell["3. formulate induced void profile", "Text",ExpressionUUID->"bade5f0a-7e49-2b4c-a0ce-30c722c6bd61"],

Cell["4. test distance scaling laws ", "Text",ExpressionUUID->"9f5a2fc8-8316-894f-8438-c271a1a79374"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Phase 5 \[LongDash] Stability and Spectrum", "Subsection",ExpressionUUID->"276cdada-cf76-3b45-be55-72cb352ce6be"],

Cell["1. linearize around stationary solutions", "Text",ExpressionUUID->"8300c9d3-fdf0-6640-a72c-367c8e0521f2"],

Cell["2. compute eigenvalues/eigenfunctions", "Text",ExpressionUUID->"ff114b28-bc25-0b4e-ba3a-dc6769a6ad9a"],

Cell["3. identify undamped harmonic modes ", "Text",ExpressionUUID->"95f6ead8-4236-474a-99dd-57504102dba3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Phase 6 \[LongDash] Recursive Time Model", "Subsection",ExpressionUUID->"02c326b1-491a-8848-adb1-78c441ec562c"],

Cell[TextData[{
 "1. implement ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["n", "TI"]], "\[Rule]", 
         SubscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["n", "TI"], "+", "1"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Psi_n \\to \\Psi_{n+1}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "381bcb83-b61d-4f4c-bf42-cd88e1903857"],
 " updates"
}], "Text",ExpressionUUID->"726126d4-1c01-434a-89f8-3889d218ffcc"],

Cell["2. test fixed points, cycles, divergence", "Text",ExpressionUUID->"c66b47af-a8dd-8541-b173-ffb7793672a9"],

Cell["3. define emergent time observables ", "Text",ExpressionUUID->"5684815c-2519-a34f-a394-be55495c75b2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Phase 7 \[LongDash] Notebook Modularization", "Subsection",ExpressionUUID->"95ba715b-9065-8d4d-9506-96bd69031e4b"],

Cell["Separate the notebook into sections:", "Text",ExpressionUUID->"cfd2c43f-206b-6a42-bceb-ee83ad8c8dda"],

Cell["1. axioms", "Text",ExpressionUUID->"2fb28103-ce6b-ca44-b331-5ff121a7bed6"],

Cell["2. definitions", "Text",ExpressionUUID->"25cbbc17-0f1e-6742-b8d1-4bb4c8a32387"],

Cell["3. symbolic derivations", "Text",ExpressionUUID->"c846e668-98ca-1f46-93a2-4593167ce158"],

Cell["4. candidate equations", "Text",ExpressionUUID->"3b03eb45-079f-8841-b3a7-9cf06477df24"],

Cell["5. tests", "Text",ExpressionUUID->"2560dc66-5148-ca4b-9320-d5094e8ffd05"],

Cell["6. numerical experiments", "Text",ExpressionUUID->"4b5fb065-8e45-f444-83c5-5c7861039439"],

Cell["7. open conjectures ", "Text",ExpressionUUID->"a1c063b0-e0f0-5147-8d09-20371b52e952"],

