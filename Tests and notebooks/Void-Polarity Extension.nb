}, Open  ]],

Cell[CellGroupData[{

Cell["5. Two-Body Void-Polarity Model", "Section",ExpressionUUID->"ceb4aca2-55e2-ba45-abf4-68eb6f05133e"],

Cell["Let: ", "Text",ExpressionUUID->"3ae3a104-596c-d440-a4ba-da34826a2513"],

Cell[TextData[{
 "source body at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["a", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "x_a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3945a2c0-1181-b34c-bef0-ff594a4008a2"]
}], "Item",ExpressionUUID->"9b233a55-bc76-184d-98b7-bf0023bca52b"],

Cell[TextData[{
 "response body at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["b", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "x_b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a16e2d19-99a9-c049-956e-e511a3fa64b6"]
}], "Item",ExpressionUUID->"a287d018-08e7-6a4f-856d-2fb227fcef49"],

Cell[TextData[{
 "separation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[LongEqual]", "\[DoubleVerticalBar]", 
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["a", "TI"]], "-", 
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["b", "TI"]], "\[DoubleVerticalBar]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "r = \\|x_a - x_b\\|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "11faae68-a040-8245-82e2-c419f6f0b1c2"]
}], "Item",ExpressionUUID->"93738ae5-1e9a-f049-8583-41fce7688e01"],

Cell[TextData[{
 "Define the unit relational direction: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["d", "TI"], "^"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SubscriptBox[
             StyleBox["x", "TI"], 
             StyleBox["b", "TI"]], "-", 
            SubscriptBox[
             StyleBox["x", "TI"], 
             StyleBox["a", "TI"]]}], 
          RowBox[{"\[DoubleVerticalBar]", 
            SubscriptBox[
             StyleBox["x", "TI"], 
             StyleBox["b", "TI"]], "-", 
            SubscriptBox[
             StyleBox["x", "TI"], 
             StyleBox["a", "TI"]], "\[DoubleVerticalBar]"}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat d_{ab} = \\frac{x_b - x_a}{\\|x_b - x_a\\|}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c632e971-469c-fc42-9497-a18f06ac21a2"],
 "A first anisotropic induced void density on the body centered at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["b", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "x_b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "58e85ece-794e-ae48-a62d-45798c656e6f"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Nu]", 
          StyleBox["b", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "\[Kappa] ", 
         FractionBox[
          SubscriptBox["\[Rho]", 
           StyleBox["a", "TI"]], 
          SuperscriptBox[
           StyleBox["r", "TI"], "2"]], " ", 
         StyleBox["h", "TI"], "\[NegativeThinSpace]", 
         RowBox[{"(", 
           RowBox[{
             FractionBox[
              RowBox[{
                StyleBox["x", "TI"], "-", 
                SubscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["b", "TI"]]}], 
              RowBox[{"\[DoubleVerticalBar]", 
                StyleBox["x", "TI"], "-", 
                SubscriptBox[
                 StyleBox["x", "TI"], 
                 StyleBox["b", "TI"]], "\[DoubleVerticalBar]"}]], 
             "\[CenterDot]", 
             SubscriptBox[
              OverscriptBox[
               StyleBox["d", "TI"], "^"], 
              RowBox[{
                StyleBox["a", "TI"], 
                StyleBox["b", "TI"]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\nu_b(x) = \
\\kappa\\,\\frac{\\rho_a}{r^2}\\,h\\!\\left(\\frac{x-x_b}{\\|x-x_b\\|}\\cdot \
\\hat d_{ab}\\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "27d96c2e-4728-7342-ab9d-7ffe7464c383"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["h", "TI"], TraditionalForm], "errors" -> {}, "input" -> "h", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c9ec2c83-9e44-3a45-8994-aeef99126e60"],
 " is chosen to weight the ",
 StyleBox["opposite side",
  FontWeight->Bold],
 " relative to the source."
}], "Text",ExpressionUUID->"a498e338-34ae-f147-bdcb-f0fe9ea0f59c"],

Cell[TextData[{
 "A simple choice: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["h", "TI"], 
         RowBox[{"(", "\[Mu]", ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{"1", "+", "\[Mu]"}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "h(\\mu) = \\frac{1+\\mu}{2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c690c875-f8c2-3740-bcf5-d0561912f106"],
 "if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Mu]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mu = 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "766a3609-acc4-a545-955e-4d0dc0d49626"],
 " is aligned with the far-side direction. "
}], "Text",ExpressionUUID->"6275fd2c-9bca-ae4e-b07f-255c37508dff"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"4c73da6f-54a6-c949-8729-fb022ea9b48c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Measurement-Regeneration Cycle", "Section",ExpressionUUID->"5fadc7a3-b576-2a48-9fb1-11e16333aad3"],

Cell["Introduce three operators: ", "Text",ExpressionUUID->"bc943883-3315-c148-893f-a85caf969395"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["M", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{M}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "99e5f3b2-691e-e94b-af64-cc28d0e577e5"],
 " \[LongDash] measurement operator"
}], "Item",ExpressionUUID->"a38bbcb7-b56e-b540-b3fb-5549a7ddf16f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["V", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{V}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c876e813-2220-7e4a-964f-3b48c03bdc5b"],
 " \[LongDash] void-generation operator"
}], "Item",ExpressionUUID->"4a9e3522-fc8d-464e-97bf-e570fc0f52e1"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{R}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a4c3cfc2-79c9-8944-8d5b-06b7b2b4fd6f"],
 " \[LongDash] restoration operator"
}], "Item",ExpressionUUID->"db79e0e0-af05-9a42-880a-3c4cc95e8571"],

Cell[TextData[{
 "Recursive form: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["n", "TI"]], 
         OverscriptBox["\[LongRightArrow]", "M"], 
         SubscriptBox[
          StyleBox["O", "TI"], 
          StyleBox["n", "TI"]], 
         OverscriptBox["\[LongRightArrow]", "V"], 
         SubscriptBox[
          StyleBox["V", "TI"], 
          StyleBox["n", "TI"]], 
         OverscriptBox["\[LongRightArrow]", "R"], 
         SubscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["n", "TI"], "+", "1"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\Psi_n \\xrightarrow{\\mathcal{M}} O_n \\xrightarrow{\\mathcal{V}} V_n \
\\xrightarrow{\\mathcal{R}} \\Psi_{n+1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a9542828-480a-5742-b599-1c9250d5821d"],
 "Equivalent update law: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["n", "TI"], "+", "1"}]], "\[LongEqual]", 
         StyleBox["R", "TI"], "\[NegativeThinSpace]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["V", "TI"], "\[NegativeThinSpace]", 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["M", "TI"], 
                 RowBox[{"[", 
                   SubscriptBox["\[CapitalPsi]", 
                    StyleBox["n", "TI"]], "]"}]}], ")"}]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\Psi_{n+1} = \\mathcal{R}\\!\\left(\\mathcal{V}\\!\\left(\\mathcal{M}[\
\\Psi_n]\\right)\\right)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0edd1592-356d-744a-af43-6ccf2c7454bb"],
 "A more explicit additive form: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["n", "TI"], "+", "1"}]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "-", 
         StyleBox["M", "TI"], 
         RowBox[{"[", 
           SubscriptBox["\[CapitalPsi]", 
            StyleBox["n", "TI"]], "]"}], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", 
         SubscriptBox[
          StyleBox["V", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\Psi_{n+1}(x) = \\Psi_n(x) - \\mathcal{M}[\\Psi_n](x) + V_n(x)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fe157763-4ebc-b44a-86ad-3bafb38ec39b"],
 "with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["V", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["C", "TI"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["M", "TI"], 
             RowBox[{"[", 
               SubscriptBox["\[CapitalPsi]", 
                StyleBox["n", "TI"]], "]"}], ",", 
             StyleBox["N", "TI"], ",", 
             StyleBox["R", "TI"]}], "]"}], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "V_n(x) = \\mathcal{C}[\\mathcal{M}[\\Psi_n], \\mathcal{N}, R](x)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fecf8676-bb4a-d941-b3cb-079b36587064"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{N}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9ab140b2-a7c8-224e-9509-29284a1e97f8"],
 " denotes neighborhood configuration. "
}], "Text",ExpressionUUID->"e1c5d17e-bc50-1f46-a62d-2f6794f69549"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"97e813fd-a6d0-1641-82d6-f709cf552e97"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Emergent Time Interpretation", "Section",ExpressionUUID->"0e7b6ba5-9c78-a34f-9e66-5f8a7e617ce2"],

Cell[TextData[{
 "In this extension, time is not fundamental but indexed by process depth: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["n", "TI"]], "\[Rule]", 
         SubscriptBox[
          StyleBox["O", "TI"], 
          StyleBox["n", "TI"]], "\[Rule]", 
         SubscriptBox[
          StyleBox["V", "TI"], 
          StyleBox["n", "TI"]], "\[Rule]", 
         SubscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["n", "TI"], "+", "1"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Psi_n \\to O_n \\to V_n \\to \\Psi_{n+1}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "427fb09b-01b1-0545-afdd-14df4a8cfb12"],
 "The ordering index ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9f50d1df-a670-274c-9439-d5d5376aa6f4"],
 " is the primitive process counter. Effective physical time may be a derived \
observable: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["t", "TI"], "\[LongEqual]", 
         StyleBox["t", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             StyleBox["R", "TI"], ",", "\[Rho]", ",", "\[Chi]", ",", 
             "\[Nu]"}], ")"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "t = t(n, R, \\rho, \\chi, \\nu)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "310d7ced-b4ff-a746-a549-41899772861b"]
}], "Text",ExpressionUUID->"ff3cbf49-43b5-114c-86b0-f1a991ed7c21"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"57fc9c82-9c58-804d-8d5f-dda1587fa783"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Test Suite", "Section",ExpressionUUID->"ae0f1339-8503-3841-ab76-9bc6467600ea"],

Cell[CellGroupData[{

Cell["8.1 Structural Tests", "Subsection",ExpressionUUID->"e00628b9-ddb4-3147-ab0b-5b9be6c02b7e"],

Cell[TextData[{
 "1. positivity/domain constraints on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
         StyleBox["R", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho, \\chi, R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "73b50152-9739-9a45-a397-4d01fab5eaa7"],
 "2. admissibility of signed density ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["D", "TI"], "\[LongEqual]", "\[Rho]", "-", "\[Nu]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "D = \\rho - \\nu", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "df598029-d970-6c4a-b6e9-a91116628b14"],
 "3. regularity of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Nu]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\nu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "578b887d-edd1-e747-9ddf-ac3d520b2376"],
 " on body boundaries"
}], "Text",ExpressionUUID->"8e61cc76-21bd-114c-90e8-47d47c695552"],

Cell[TextData[{
 "4. consistency of anisotropy field ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> "A", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c778999e-7cf5-8948-9b3b-938fc497acfd"]
}], "Text",ExpressionUUID->"b3ba462b-8aa6-9946-b0f7-5323b2926296"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.2 Two-Body Tests", "Subsection",ExpressionUUID->"e120dec9-cca9-e842-af12-f526bbaeea9a"],

Cell["1. isolated-body symmetry restoration", "Text",ExpressionUUID->"d64ae096-3052-a74e-82d6-fb30a6046ee8"],

Cell["2. induced far-side void formation", "Text",ExpressionUUID->"35a9354d-5daf-c841-a27d-084bf08a91e9"],

Cell["3. large-distance decay of induced void", "Text",ExpressionUUID->"7a9e1b2d-25de-434b-8122-eace3234368d"],

Cell["4. near-field boundedness or regularization", "Text",ExpressionUUID->"14794f20-ef27-124a-b027-6e50a0c313c1"],

Cell["5. recovery of ordinary attraction in a limit ", "Text",ExpressionUUID->"f3527c02-6d6a-3740-ad39-21371cad278a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.3 Variational Tests", "Subsection",ExpressionUUID->"89f51c3d-7fab-e446-bb03-84bfdae0aebb"],

Cell["1. derive Euler\[Dash]Lagrange equations for extended action", "Text",ExpressionUUID->"a02ca5fd-499f-8544-b750-ae46498c10be"],

Cell["2. inspect degeneracies", "Text",ExpressionUUID->"2f173b85-8a13-9740-83aa-6903c6529f5f"],

Cell["3. identify missing constraints", "Text",ExpressionUUID->"6d87988d-deef-bf47-96c5-149de261f66a"],

Cell["4. test whether void field must be algebraic or dynamical ", "Text",ExpressionUUID->"fa31deef-31ec-1347-8880-815cd3463c68"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.4 Spectral/Stability Tests", "Subsection",ExpressionUUID->"18ebae5c-4a6d-e54e-88d6-6822ed67337b"],

Cell["1. linearize around stationary background", "Text",ExpressionUUID->"c91a2284-9405-e040-893d-cf3e1d9f610f"],

Cell["2. compute eigenmodes", "Text",ExpressionUUID->"0b438719-e54e-9c49-97b4-b854a58e653e"],

Cell["3. isolate undamped oscillatory modes", "Text",ExpressionUUID->"41198e40-47c4-a745-ab18-cedf827393f6"],

Cell["4. identify instability thresholds ", "Text",ExpressionUUID->"f18f84c1-261e-0741-9fc7-e6b340eb06ea"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.5 Measurement Tests", "Subsection",ExpressionUUID->"21c8c084-5f3a-0f4b-b059-dc8a62abb1bf"],

Cell["1. does measurement produce nonzero deficit?", "Text",ExpressionUUID->"ca5cda2f-cc70-5444-9f69-33d11d46972e"],

Cell["2. can restoration refill the deficit?", "Text",ExpressionUUID->"5bb01f24-7989-324f-995d-c5575e87a617"],

Cell["3. can recursion converge to a stable cycle?", "Text",ExpressionUUID->"953d417b-a247-e44d-b373-5093dcb1f457"],

Cell["4. can process depth induce effective time ordering? ", "Text",ExpressionUUID->"adb687a4-10b7-af40-95bf-ad40071545de"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8.6 Input/Output Tests", "Subsection",ExpressionUUID->"a897a206-071f-e74d-a184-58bfd7615f4c"],

Cell["1. define state vector", "Text",ExpressionUUID->"d2a3a84d-788e-5144-857e-8fd272273c72"],

Cell["2. define input configuration space", "Text",ExpressionUUID->"8faf22e1-c3da-0341-9da8-7f53653f7d60"],

Cell["3. define observable outputs", "Text",ExpressionUUID->"4e984031-85e6-7a44-924c-2c53b19334bb"],

Cell["\<\
4. test controllability-like and observability-like properties \
\>", "Text",ExpressionUUID->"d47a3b46-fa67-cb4d-bc02-562f97cc651f"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"0a0b585f-0854-5a44-85a7-779335b82bc1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Input/Output System Form", "Section",ExpressionUUID->"da28ea55-bcfd-bd4e-81df-2ecdbc7685a6"],

Cell[TextData[{
 "Define state: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["n", "TI"]], ",", 
             SubscriptBox["\[Rho]", 
              StyleBox["n", "TI"]], ",", 
             SubscriptBox["\[Nu]", 
              StyleBox["n", "TI"]], ",", 
             SubscriptBox[
              StyleBox["A", "TI"], 
              StyleBox["n", "TI"]], ",", 
             SubscriptBox[
              StyleBox["R", "TI"], 
              StyleBox["n", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "x_n = (\\Psi_n, \\rho_n, \\nu_n, A_n, R_n)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1ed59897-6896-e94a-8e8d-167731dbc011"],
 "Input: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["u", "TI"], 
          StyleBox["n", "TI"], 
          StyleBox["in", FontSlant -> "Plain"]], "\[LongEqual]", 
         RowBox[{"(", 
           
           RowBox[{"neighbor geometry", ",", "measurement act", ",", 
             "resolution selection"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "u_n^{\\mathrm{in}} = (\\text{neighbor geometry},\\text{measurement \
act},\\text{resolution selection})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e24f572c-79dd-6c40-a0a1-554d1a2661e8"],
 "Update: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], 
          RowBox[{
            StyleBox["n", "TI"], "+", "1"}]], "\[LongEqual]", 
         StyleBox["F", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["n", "TI"]], ",", 
             SubscriptBox[
              StyleBox["u", "TI"], 
              StyleBox["n", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "x_{n+1} = F(x_n, u_n)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4ce2f704-b918-134f-88ef-7fcc39e895d9"],
 "Output: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["y", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["n", "TI"]], ",", 
             SubscriptBox[
              StyleBox["u", "TI"], 
              StyleBox["n", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "y_n = H(x_n, u_n)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "476aeddb-1b32-4d44-91af-c9d7b6e2c5f4"],
 "with outputs such as: "
}], "Text",ExpressionUUID->"3c43f4a1-8e12-2c42-9141-0a17c20a6163"],

Cell[TextData[{
 "effective potential ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalPhi]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "157bf376-3ea4-3f4a-bc40-a3c363244339"]
}], "Item",ExpressionUUID->"ded369aa-9611-5b44-a5c2-6a9e08178548"],

Cell[TextData[{
 "signed density ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["D", "TI"], TraditionalForm], "errors" -> {}, "input" -> "D", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "06ebd210-dd13-d743-8c4e-5dffa09fbe52"]
}], "Item",ExpressionUUID->"7d5391a9-2a49-8440-a4e5-e1d6e8cd9f45"],

Cell["observable field slices", "Item",ExpressionUUID->"a72a70a3-df65-8f44-ae3e-8e458a498273"],

Cell["resonance frequencies", "Item",ExpressionUUID->"65b8d87e-ec74-4a4b-8337-058d3b504311"],

