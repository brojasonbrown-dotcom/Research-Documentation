Cell[CellGroupData[{

Cell["12. Immediate Next Tasks", "Section",ExpressionUUID->"091e5912-155e-dc4c-bb19-4df8f65172f6"],

Cell[CellGroupData[{

Cell["Task A", "Subsection",ExpressionUUID->"d7f24bf9-ac69-8b4c-a2e6-c14a3a30e9c9"],

Cell[TextData[{
 "Formalize the ",
 StyleBox["minimal axioms",
  FontWeight->Bold],
 " for: "
}], "Text",ExpressionUUID->"236dc1c8-a65f-fb40-8def-9dde8d50766c"],

Cell["source density", "Item",ExpressionUUID->"58cfaa65-d59a-1b45-94f2-9ea4a184047c"],

Cell["void density", "Item",ExpressionUUID->"307f9f97-48e7-1342-8e6c-9cfa8dbdf97c"],

Cell["anisotropy", "Item",ExpressionUUID->"fb26bf77-f722-3e45-9709-34fafe942d6a"],

Cell["measurement deficit", "Item",ExpressionUUID->"760c86e4-5044-154d-a35c-1913316bb939"],

Cell["restoration", "Item",ExpressionUUID->"42b9b613-2f1d-c14c-b157-492f333041db"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Task B", "Subsection",ExpressionUUID->"9777b504-d5f1-b548-9831-d9d7a1612bf0"],

Cell[TextData[{
 "Derive the Euler\[Dash]Lagrange equations of the ",
 StyleBox["extended action",
  FontWeight->Bold],
 ". "
}], "Text",ExpressionUUID->"1f05db9a-60a3-c44f-b68c-48542dd56891"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Task C", "Subsection",ExpressionUUID->"bac159ed-51f8-f84e-b402-4d3d5397a40e"],

Cell[TextData[{
 "Construct a first ",
 StyleBox["two-body opposite-side kernel",
  FontWeight->Bold],
 ". "
}], "Text",ExpressionUUID->"b43946d5-e203-db42-bfde-b5da6d7feffd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Task D", "Subsection",ExpressionUUID->"db347e66-4e61-cb4d-99de-626f9f80f1a4"],

Cell[TextData[{
 "Encode the recursive process: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["n", "TI"]], "\[Rule]", 
         SubscriptBox[
          StyleBox["O", "TI"], 
          StyleBox["n", "TI"]], "\[Rule]", 
         SubscriptBox[
          StyleBox["V", "TI"], 
          StyleBox["n", "TI"]], "\[Rule]", 
         SubscriptBox["\[CapitalPsi]", 
          RowBox[{
            StyleBox["n", "TI"], "+", "1"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Psi_n \\to O_n \\to V_n \\to \\Psi_{n+1}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5404935-7401-f24d-b9db-384aed689fbc"],
 "as a discrete state update system. "
}], "Text",ExpressionUUID->"3b236287-1952-9544-ad62-47c4ca68b44f"],

