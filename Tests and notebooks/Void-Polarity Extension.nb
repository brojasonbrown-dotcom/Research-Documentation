}, Open  ]],

Cell[CellGroupData[{

Cell["4. Extension of OPF Action", "Section",ExpressionUUID->"6b35538c-363b-d744-a4eb-fadecdc5aef9"],

Cell[TextData[{
 "The original seed Lagrangian from the OPF prompt was: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], "0"], "\[LongEqual]", "\[Rho]", "log", 
         "\[Chi]", "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{L}_0 = \\rho \\log \\chi + \\chi R^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "357fd378-9de2-144f-9a0b-1302dd35fca3"],
 "To support the new intuition, introduce an extended symbolic Lagrangian \
candidate: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["ext", FontSlant -> "Plain"]], "\[LongEqual]", "\[Rho]", 
         "log", "\[Chi]", "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "+", "\[Alpha] ", 
         SuperscriptBox["\[Nu]", "2"], "+", "\[Beta] ", 
         "\[DoubleVerticalBar]", "\[Del]", 
         SuperscriptBox["\[Nu]\[DoubleVerticalBar]", "2"], "+", "\[Gamma] ", 
         RowBox[{"\[LeftAngleBracket]", 
           RowBox[{
             StyleBox["A", "TI"], ",", "\[Del]", "\[Rho]"}], 
           "\[RightAngleBracket]"}], "+", "\[Eta] ", "\[Rho] ", "\[Nu]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{L}_{\\mathrm{ext}} = \\rho \\log \\chi + \\chi R^2 + \
\\alpha\\,\\nu^2 + \\beta\\,\\|\\nabla \\nu\\|^2 + \\gamma\\,\\langle A, \
\\nabla \\rho \\rangle + \\eta\\,\\rho\\,\\nu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "85ddfc2a-c54d-5843-b006-545d63aa187c"],
 "Possible interpretation of terms: "
}], "Text",ExpressionUUID->"71157ebb-9fe8-2e4f-8264-decad1ea7864"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha] ", 
         SuperscriptBox["\[Nu]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\alpha\\,\\nu^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "86c5cbbf-14ab-d54d-9acc-986cd8b29086"],
 " \[LongDash] void self-penalty or storage cost"
}], "Item",ExpressionUUID->"ef26ac83-4987-d243-a615-b1918904e208"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Beta] ", "\[DoubleVerticalBar]", "\[Del]", 
         SuperscriptBox["\[Nu]\[DoubleVerticalBar]", "2"]}], TraditionalForm],
      "errors" -> {}, "input" -> "\\beta\\,\\|\\nabla \\nu\\|^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f08c9d4d-3ab9-c545-9670-b6b0ddd25253"],
 " \[LongDash] smoothness/spread cost"
}], "Item",ExpressionUUID->"2e577cbf-3006-e648-b7db-d26d9a20eda8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Gamma] ", 
         RowBox[{"\[LeftAngleBracket]", 
           RowBox[{
             StyleBox["A", "TI"], ",", "\[Del]", "\[Rho]"}], 
           "\[RightAngleBracket]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\gamma\\,\\langle A, \\nabla \\rho \\rangle", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2f655906-275e-be44-b706-e5142383487c"],
 " \[LongDash] anisotropic response to neighbor structure"
}], "Item",ExpressionUUID->"170320eb-1b76-af4d-b0c9-bc5debada396"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Eta] ", "\[Rho]\[Nu]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\eta\\,\\rho\\nu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dee4ec40-6c37-3a43-aa7e-fa1afda3d71a"],
 " \[LongDash] source-void coupling"
}], "Item",ExpressionUUID->"dc2893c7-7245-b84b-b65a-a2845670f2d0"],

Cell[TextData[{
 "This is not final truth; it is a ",
 StyleBox["testable symbolic scaffold",
  FontWeight->Bold],
 ". "
}], "Text",ExpressionUUID->"cd79b48b-f301-9146-b430-e1d0d2e43bb9"],

