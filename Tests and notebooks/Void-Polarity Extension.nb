Cell[CellGroupData[{

Cell["11. Proposed Wolfram Language Object Design", "Section",ExpressionUUID->"0f5262dc-e39e-f04d-9fc2-0cae305d3da5"],

Cell["Suggested symbolic containers: ", "CodeText",ExpressionUUID->"dacaf641-dd1c-cf4e-8438-08d578668632"],

Cell[BoxData[{
 RowBox[{"opfModel", "[", "assoc_", "]"}], "\[IndentingNewLine]", 
 RowBox[{"opfFields", "[", "assoc_", "]"}], "\[IndentingNewLine]", 
 RowBox[{"opfAction", "[", "assoc_", "]"}], "\[IndentingNewLine]", 
 RowBox[{"opfEquations", "[", "assoc_", "]"}], "\[IndentingNewLine]", 
 RowBox[{"opfVoidKernel", "[", "assoc_", "]"}], "\[IndentingNewLine]", 
 RowBox[{"opfMeasurement", "[", "assoc_", "]"}], "\[IndentingNewLine]", 
 RowBox[{"opfRestoration", "[", "assoc_", "]"}], "\[IndentingNewLine]", 
 RowBox[{"opfStateUpdate", "[", "assoc_", "]"}], "\[IndentingNewLine]", 
 RowBox[{"opfTests", "[", "assoc_", "]"}]}], "Input",ExpressionUUID->\
"a4d8d859-1ae6-8f43-be68-4afeeb910e11"],

Cell[TextData[{
 "Use ",
 ButtonBox["Association",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Association"],
 " to hold metadata, assumptions, and options."
}], "Text",ExpressionUUID->"b9c76777-545f-d243-8791-f11dc4f60f8a"],

Cell["Suggested keys: ", "CodeText",ExpressionUUID->"e1b441d2-9411-d042-a23c-e45ce4c4b91c"],

Cell[BoxData[
 RowBox[{"<|", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"\"\<Domain\>\"", "->", "..."}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<Fields\>\"", "->", "..."}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<Parameters\>\"", "->", "..."}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"\"\<Action\>\"", "->", "..."}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<Assumptions\>\"", "->", "..."}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"\"\<MeasurementOperator\>\"", "->", "..."}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<VoidOperator\>\"", "->", "..."}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"\"\<RestorationOperator\>\"", "->", "..."}]}], 
  "\[IndentingNewLine]", "|>"}]], "Input",ExpressionUUID->"b4b9adda-c9ab-d840-\
9b21-da59a02093ba"],

