    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"9b2d1a25-d8a3-a747-8899-32eb73ec5e80"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Minimal Mathematical Objects", "Section",ExpressionUUID->"0b741da4-a651-7641-81f7-3f934f81cbdd"],

Cell[TextData[{
 "We introduce five primary fields on a domain ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["X", "TI"], TraditionalForm], "errors" -> {}, "input" -> "X", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9dda7579-458f-1645-8d15-32fd1f6b3b19"],
 ": "
}], "Text",ExpressionUUID->"d49d8128-dab6-2845-b9da-1a3e1645ec1f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d6ae90ef-37ae-774f-9ac9-bda806c2a517"],
 " \[LongDash] positive information density"
}], "Item",ExpressionUUID->"a9d05342-3ba3-7048-b3c9-9f64a2d1ba5f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Nu]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\nu(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1d4bc63c-f23e-4147-a5cc-a4b31cc46fc0"],
 " \[LongDash] complementary void density"
}], "Item",ExpressionUUID->"0e543aa7-0cbd-b249-9fd1-ae7703553cd5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "A(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "62507de6-cb8b-5243-a4df-aaa4c3e6e6ab"],
 " \[LongDash] anisotropy/orientation structure"
}], "Item",ExpressionUUID->"2c914e8b-17dd-8243-916f-56e4ee00183d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "R(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "48c40ea8-b61e-cd43-87fd-b58d0d95b24a"],
 " \[LongDash] observational resolution"
}], "Item",ExpressionUUID->"f3701258-9bc0-164e-8d06-6efec7e39a39"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPsi]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Psi(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "53b22764-4bf1-f44f-908f-95965a983229"],
 " \[LongDash] total field state"
}], "Item",ExpressionUUID->"feb29c31-29fb-6549-af96-b60a058fa43a"],

Cell[TextData[{
 "A first effective signed density: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["D", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "\[Rho]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "-", "\[Nu]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "D(x) = \\rho(x) - \\nu(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ab148642-d4bc-6a48-8ddd-38e9322a39e0"],
 "A first effective potential equation: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Del]", "2"], "\[CapitalPhi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "4", "\[Pi]", 
         StyleBox["G", "TI"], " ", 
         StyleBox["D", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\nabla^2 \\Phi(x) = 4\\pi G\\, D(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0688ff67-8242-d443-9f67-a5bfcde44979"],
 "with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Nu]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\nu", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "95ad5a57-6b36-2549-ae42-090944ab4a38"],
 " not interpreted as textbook negative matter, but as a ",
 StyleBox["relational compensator field",
  FontWeight->Bold],
 ". "
}], "Text",ExpressionUUID->"de1f7dc4-796e-964b-8d89-41f3ab6618f4"],

