MaxExtraConditions -> All] // N[#, 80] &;\n\nstableModes = \
Select[dispersionRoots, Chop[Re[#],10^-40] == 0 && Im[#] > 0 &];\nmissingVars \
= Complement[{alpha, beta, mu, sigma, lam, eta, rho0, chi0, r0}, \n   {c, h, \
G, kB, qe, me, mp, epsilon0, mu0}];\n\npotPlot = Plot[Evaluate[{m1[rho,1,1], \
m2[rho,3/2], m3a[rho], m3b[rho]}], {rho, -5/2, 5/2},\n  PlotLegends -> \
{\"M1\", \"M2\", \"M3a\", \"M3b\"}, PlotRange -> {-2, 3}, ImageSize -> Large,\
\n  AxesLabel -> {\"rho\", \"V(rho)\"}, PlotLabel -> \"Static Potentials\"];\n\
\nmeasPlot = ListLinePlot[meas[\"Residuals\"], ScalingFunctions -> {None, \
\"Log\"}, \n  PlotMarkers -> Automatic, ImageSize -> Large, AxesLabel -> {\"n\
\", \"|rho_(n+1)-rho_n|\"},\n  PlotLabel -> \"Measurement Residuals\"];\n\n\
