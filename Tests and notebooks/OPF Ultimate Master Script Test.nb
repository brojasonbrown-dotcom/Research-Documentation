Cell[CellGroupData[{

Cell["12. Time-Domain Simulation of a Reduced Mode", "Section",ExpressionUUID->"f31322f1-3c34-4040-9e82-995fede76ea4"],

Cell["A simple test of source-driven response: ", "CodeText",ExpressionUUID->"d79ce5ca-85e6-1b47-8b2d-b9445bea6cd4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"reducedEq", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
     RowBox[{"2", " ", "\[Zeta]", " ", "\[Omega]n", " ", 
      RowBox[{
       RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
     RowBox[{
      RowBox[{"\[Omega]n", "^", "2"}], " ", 
      RowBox[{"x", "[", "t", "]"}]}]}], "==", 
    RowBox[{"src", "[", "t", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"src", "[", "t_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "20"}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"t", "-", "3"}], ")"}], "^", "2"}]}], "]"}]}], ";"}]}], "Input",
