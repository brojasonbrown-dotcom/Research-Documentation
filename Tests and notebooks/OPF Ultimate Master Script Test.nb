Cell[CellGroupData[{

Cell["1. Testing Philosophy", "Section",ExpressionUUID->"f2f0e2c9-36a1-d443-8520-8693b7e4b2ab"],

Cell["\<\
We will build a rigorous workflow with the following layers: \
\>", "Text",ExpressionUUID->"2423627f-e1fb-1f49-ad39-1527cd98c2ac"],

Cell[CellGroupData[{

Cell["Layer A: Symbolic correctness", "Subsection",ExpressionUUID->"ebe7f180-2f27-fd43-b65c-cec58fb40847"],

Cell["derive equations in two ways", "Item",ExpressionUUID->"e2ae3ef0-923a-1d4d-a352-d41c90406d32"],

Cell["verify sign consistency", "Item",ExpressionUUID->"99bbff0f-c70f-ee4b-ac04-b2e03d5b86cc"],

Cell["classify stationary backgrounds", "Item",ExpressionUUID->"f5f274b7-4b60-1d45-8818-cad513fd2c7c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer B: Spectral correctness", "Subsection",ExpressionUUID->"e8571581-221f-ee4d-b4d5-9ecaabd26679"],

Cell["compute stiffness matrix", "Item",ExpressionUUID->"eaee49ed-4a9c-9340-89d2-beb170656818"],

Cell["solve determinant conditions", "Item",ExpressionUUID->"6533b929-965c-934e-ba36-83c04d7f5924"],

Cell["identify massless / massive branches", "Item",ExpressionUUID->"157aca94-3061-b346-b953-ae10b761ea3d"],

Cell["test whether modes are real, damped, unstable, or tachyonic", "Item",ExpressionUUID->"2fe320a4-1c06-4149-af7d-89d1f03c75d2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer C: PDE correctness", "Subsection",ExpressionUUID->"65d3b18e-e3ff-5943-bae8-4f11ec9432b8"],

Cell["solve bounded-domain eigenproblems", "Item",ExpressionUUID->"1b67903b-d5c3-1544-80ea-84ce311850b2"],

Cell["visualize eigenmodes", "Item",ExpressionUUID->"dc830460-2391-6d41-85ac-051df852daba"],

Cell["compare operator forms", "Item",ExpressionUUID->"5ef0efc8-2809-b743-add3-09e2773e6486"],

Cell["measure residuals", "Item",ExpressionUUID->"614af5a2-0b7f-3d46-862d-95097abb9229"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer D: Dynamical correctness", "Subsection",ExpressionUUID->"21a8ece4-0eee-8d44-af42-a98fc6a27cd4"],

Cell["simulate time evolution", "Item",ExpressionUUID->"d432a5bc-5c48-2e4d-8a55-a7b9a75585f8"],

Cell["test response to source pulses", "Item",ExpressionUUID->"0c3399b2-27d9-1e44-aaf0-98350a5a1ac6"],

Cell["track conserved / nonconserved quantities where applicable", "Item",ExpressionUUID->"8684eb4c-4a31-5049-984c-d527cd804dce"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer E: Predictive discipline", "Subsection",ExpressionUUID->"f256dbf0-915b-0d49-b158-86ceb5775c8c"],

Cell["separate fit from forecast", "Item",ExpressionUUID->"f0963b27-b651-af4e-bc21-95fcf489ccfe"],

Cell["require out-of-sample agreement", "Item",ExpressionUUID->"36088108-6408-d64b-b504-7f4e46ae16f0"],

Cell["reject claims that are merely post hoc reinterpretations", "Item",ExpressionUUID->"be8c47b8-800f-fb46-8865-06603ca8c836"],

