Cell[CellGroupData[{

Cell["11. Finite-Domain PDE Eigenmode Test", "Section",ExpressionUUID->"0c13fe76-2fde-9c4a-873b-531167b74c56"],

Cell["\<\
This is where we test whether the linearized PDE actually supports stable \
spatial modes.\
\>", "Text",ExpressionUUID->"02375cfa-b830-2d49-9bdf-54a7c9fd3ab9"],

Cell["\<\
We first isolate one scalar prototype from the linearized system. If \
decoupling exists, use one mode directly; otherwise test a reduced operator. \
\>", "Text",ExpressionUUID->"8129db1c-5d7c-1248-916f-6d1a05b9065a"],

Cell[CellGroupData[{

Cell["Example scalar wave-mass operator", "Subsection",ExpressionUUID->"8b6fb666-f0fb-a34b-9cc5-b96c6b0dbdc6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"reg", "=", 
   RowBox[{"Rectangle", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[309]:=",ExpressionUUID->"cfde678b-78c4-d041-9414-656473771855"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"waveMassVals", "=", 
   RowBox[{
    RowBox[{"NDEigenvalues", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Laplacian", "[", 
           RowBox[{
            RowBox[{"\[Psi]", "[", 
             RowBox[{"x", ",", "y"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "+", 
         RowBox[{"m2", " ", 
          RowBox[{"\[Psi]", "[", 
           RowBox[{"x", ",", "y"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"DirichletCondition", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Psi]", "[", 
            RowBox[{"x", ",", "y"}], "]"}], "==", "0"}], ",", "True"}], 
         "]"}]}], "\[IndentingNewLine]", "    ", "}"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\[Psi]", "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], " ", "\[Element]", " ", "reg"}], ",", 
      "9", ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"Method", "->", 
       RowBox[{"{", "\"\<FiniteElement\>\"", "}"}]}]}], "\[IndentingNewLine]",
      "   ", "]"}], " ", "/.", " ", 
    RowBox[{"m2", "->", "1.0"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[310]:=",ExpressionUUID->"18d6588b-c667-f947-b00d-db97bb3c4c70"],

Cell[BoxData[
 TemplateBox[{
  "NDEigenvalues", "noopt", 
   "\"The method specified by \\!\\(\\*RowBox[{\\\"Method\\\", \
\\\"\[Rule]\\\", RowBox[{\\\"{\\\", \\\"\\\\\\\"FiniteElement\\\\\\\"\\\", \\\
\"}\\\"}]}]\\) is not a known built-in method.\"", 2, 310, 52, 
