vacua.\"\"\"\n        return -0.5 \\* mu\\*\\*2 \\* rho\\*\\*2 + 0.25 \\* lam \
\\* rho\\*\\*4\n\n    @staticmethod\n    def m2\\_sine\\_closure(rho, \
eps=1.5):\n        \"\"\"M2: Sine-closure. 'Oscillation that never closes'.\"\
\"\"\n        return 0.5 \\* rho\\*\\*2 + eps \\* np.cos(rho)\n\n    \
@staticmethod\n    def m3a\\_log\\_density(rho):\n        \"\"\"M3a: Original \
log-density. Stable origin (null).\"\"\"\n        return np.log(1 + \
rho\\*\\*2) - 0.5 \\* rho\\*\\*2\n\n    @staticmethod\n    def \
m3b\\_log\\_flipped(rho):\n        \"\"\"M3b: Flipped log-density. Unstable \
origin, broken vacua.\"\"\"\n        return -np.log(1 + rho\\*\\*2) + 0.5 \\* \
rho\\*\\*2\n\ndef find\\_vacua\\_and\\_mass(potential\\_func, \
derivative\\_func, second\\_derivative\\_func):\n    \"\"\"Finds the vacuum \
states and their masses (m^2 = V'').\"\"\"\n    roots = []\n    \\# Search \
for roots in the range [-3, 3]\n    for x0 in np.linspace(-3, 3, 10):\n       \
 res = root(derivative\\_func, x0)\n        if res.success:\n            x = \
res.x[0]\n            \\# Filter duplicates and ensure it's a real number\n   \
         if abs(x.imag) < 1e-10:\n                x = x.real\n                \
if not any(abs(x - r) < 1e-5 for r in roots):\n                    \
roots.append(x)\n    \n    vacua = []\n    for r in roots:\n        m\\_sq = \
second\\_derivative\\_func(r)\n        vacua.append({\"rho\": r, \"m\\_sq\": \
m\\_sq})\n    return vacua\n\n\\# \
=============================================================================\
\n\\# PART 3: MEASUREMENT OSCILLATION (The Closure Gap)\n\\# \
=============================================================================\
\ndef measure\\_oscillation(iterations=40, rho0=0.1):\n    \"\"\"\n    Models \
the iterated measurement map: rho\\_{n+1} = 1.5 \\* sin(rho\\_n)\n    The \
residual \\|rho\\_{n+1} - rho\\_n\\| is the 'mass' of the unclosed gap.\n    \
\"\"\"\n    rho\\_vals = [rho0]\n    residuals = []\n    for \\_ in \
range(iterations):\n        rho\\_next = 1.5 \\* np.sin(rho\\_vals[-1])\n     \
   residual = abs(rho\\_next - rho\\_vals[-1])\n        \
residuals.append(residual)\n        rho\\_vals.append(rho\\_next)\n    return \
rho\\_vals, residuals\n\n\\# \
=============================================================================\
\n\\# PART 4: THERMODYNAMIC PHASE TRANSITION\n\\# \
