Cell["Critical interpretation rule", "Subsection",ExpressionUUID->"5b990c34-153b-5446-89c6-a0b9b39decec"],

Cell[TextData[{
 "If a branch gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Omega]", "2"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["k", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\omega^2 = k^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2fd9f371-0f4f-6140-b89f-2e634832cdca"],
 "then mathematically you have a ",
 StyleBox["massless mode in the chosen normalization",
  FontWeight->Bold],
 "."
}], "Text",ExpressionUUID->"0d008fcb-4908-6e42-8652-b80a06343acd"],

Cell["You may only call it \[OpenCurlyDoubleQuote]light\
\[CloseCurlyDoubleQuote] if you additionally establish: ", "Text",ExpressionUU\
ID->"c966b4b8-ffad-bf41-a159-827c75d5b9ab"],

Cell["correct Lorentz transformation structure", "Item",ExpressionUUID->"9ddab174-601d-2843-9f92-5d732c0b8eec"],

Cell["correct coupling to matter/charge", "Item",ExpressionUUID->"11a30e39-7d53-1a42-9ba5-8a02ff586949"],

Cell["polarization structure if relevant", "Item",ExpressionUUID->"c7050823-8cd8-0048-9ef8-64eb899bef98"],

