Cell[CellGroupData[{

Cell["\<\
Rigorous Review and Test Harness for the Proposed OPF Observer Structure\
\>", "Title",ExpressionUUID->"fc57a894-6b76-6044-a597-fa5489a1c7ef"],

Cell[TextData[{
 "This notebook does ",
 StyleBox["not",
  FontWeight->Bold],
 " assume the interpretation is correct. Instead, it turns the proposal into \
a ",
 StyleBox["falsifiable, auditable test program",
  FontWeight->Bold],
 "."
}], "Text",ExpressionUUID->"bc17fbfd-49f0-a242-9f38-d4c4bc3349de"],

Cell["It separates:", "Text",ExpressionUUID->"e33b57b3-1ad7-a14e-8505-fb28c3cd6565"],

Cell[TextData[{
 "1. ",
 StyleBox["what is mathematically derivable from the equations",
  FontWeight->Bold],
 "2. ",
 StyleBox["what is an interpretation layered on top",
  FontWeight->Bold],
 "3. ",
 StyleBox["what can be numerically tested here",
  FontWeight->Bold],
 "4. ",
 StyleBox["what would require external data or independent validation",
  FontWeight->Bold],
 "The goal is to prevent category errors like: "
}], "Text",ExpressionUUID->"d4fb0b49-0c19-7e4e-ad28-252fca8ed311"],

Cell["\<\
calling a mode \[OpenCurlyDoubleQuote]light\[CloseCurlyDoubleQuote] before \
proving Lorentz-consistent propagation\
\>", "Item",ExpressionUUID->"9df2f7d5-7158-8e4d-b039-8ca491af3246"],

Cell["\<\
calling a field \[OpenCurlyDoubleQuote]consciousness\[CloseCurlyDoubleQuote] \
before showing unique predictive content\
\>", "Item",ExpressionUUID->"6e2a86dc-4adb-7740-85b6-893ed4b0fa69"],

Cell["\<\
inferring lattice/CFL physics from a continuum Lagrangian without a discrete \
model\
\>", "Item",ExpressionUUID->"4db820a2-d5b4-1946-9cb6-cbabc6bdb014"],

