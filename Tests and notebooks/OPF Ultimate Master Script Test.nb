\"FixedPointsMeasurementMap\" -> N[fixedPoints, 40],\n  \
\"FinalMeasurementValue\" -> N[Last[meas[\"Sequence\"]], 40],\n  \
\"FinalResidual\" -> N[Last[meas[\"Residuals\"]], 40],\n  \
