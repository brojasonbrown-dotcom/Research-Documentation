          RowBox[{"u", "[", 
           RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
       "]"}]}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"\[Chi]", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
        RowBox[{"\[Chi]0", "+", 
         RowBox[{"\[CurlyEpsilon]", " ", 
          RowBox[{"v", "[", 
           RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
       "]"}]}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"r", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
        RowBox[{"r0", "+", 
         RowBox[{"\[CurlyEpsilon]", " ", 
          RowBox[{"w", "[", 
           RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
       "]"}]}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"s", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
        RowBox[{"s0", "+", 
         RowBox[{"\[CurlyEpsilon]", " ", 
          RowBox[{"q", "[", 
           RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
       "]"}]}]}], "\[IndentingNewLine]", "   ", "}"}]}], ";"}]], "Input",
