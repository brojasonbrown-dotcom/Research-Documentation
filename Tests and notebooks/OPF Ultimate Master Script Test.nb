ax3.set\\_ylabel('Effective Mass Squared (m^2\\_{eff})')\n    ax3.legend()\n  \
  ax3.grid(True, alpha=0.3)\n    ax3.text(1.0, -1.5, 'Condensation\n(Mass \
Emerges)', color='red', fontsize=12, ha='center')\n\n    \\# \
