\ndef effective\\_mass(T, m0\\_sq=-2.0, c=1.0):\n    \"\"\"m^2\\_eff = \
m^2\\_0 + c\\*T^2. Tachyonic at low T, stable at high T.\"\"\"\n    return m0\
\\_sq + c \\* T\\*\\*2\n\n\\# \
=============================================================================\
\n\\# PART 5: OPF FIELD DYNAMICS (Stiffness Matrix Roots)\n\\# \
=============================================================================\
\ndef opf\\_stiffness\\_matrix(K, alpha, beta, mu, sigma, lam, eta, rho0, \
chi0, r0):\n    \"\"\"\n    Constructs the 4x4 Stiffness Matrix from the \
linearized OPF Lagrangian.\n    K = omega^2 - k^2. Fields: [d\\_rho, d\\_chi, \
d\\_r, d\\_s]\n    \"\"\"\n    M = np.zeros((4, 4), dtype=complex)\n    \n    \
\\# Row 1: Information (rho)\n    M[0, 0] = alpha \\* K\n    M[0, 1] = -1 / \
chi0\n    M[0, 3] = eta\n    \n    \\# Row 2: Complexity (chi)\n    M[1, 0] = \
-1 / chi0\n    M[1, 1] = beta \\* K + (rho0 / chi0\\*\\*2)\n    M[1, 2] = -2 \
\\* r0\n    \n    \\# Row 3: Curvature (r)\n    M[2, 1] = -2 \\* r0\n    M[2, \
2] = mu \\* K - 2 \\* chi0\n    \n    \\# Row 4: Observer (s)\n    M[3, 0] = \
eta\n    M[3, 3] = sigma \\* K - lam\n    \n    return M\n\ndef \
find\\_dispersion\\_roots(params):\n    \"\"\"\n    Finds the roots K by \
evaluating Det(M) at 5 points and fitting a polynomial.\n    \"\"\"\n    \
K\\_vals = np.linspace(-5, 5, 5)\n    det\\_vals = \
np.array([np.linalg.det(opf\\_stiffness\\_matrix(K, \\*params)) for K in \
K\\_vals])\n    \n    \\# Fit a 4th degree polynomial and find its roots\n    \
coeffs = np.polyfit(K\\_vals, det\\_vals, 4)\n    roots = np.roots(coeffs)\n  \
  return roots\n\n\\# \
