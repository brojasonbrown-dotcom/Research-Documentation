\\*\\* -n)\n    \n    @staticmethod\n    def info\\_density(n):\n        \
return Constants.PLANCK\\_DENSITY \\* (Constants.PHI \\*\\* (-4 \\* n))\n\n\
\\# ==========================================================================\
===\n\\# PART 2: STATIC POTENTIALS (M1, M2, M3a, M3b)\n\\# \
=============================================================================\
\nclass Potentials:\n    @staticmethod\n    def m1\\_higgs\\_quartic(rho, \
