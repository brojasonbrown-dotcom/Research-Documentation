Cell[CellGroupData[{

Cell["14. What Would Be Needed to Claim Specific Physics?", "Section",ExpressionUUID->"18ffc410-dcd4-6d48-aab2-15243144b293"],

Cell[CellGroupData[{

Cell["To claim a mode is light", "Subsection",ExpressionUUID->"86a6a975-922d-cb4f-a040-d762e8ebcffc"],

Cell["Need all of: ", "Text",ExpressionUUID->"58fa6d2a-76d9-c943-af5c-6f3b698a5243"],

Cell["massless branch", "Item",ExpressionUUID->"2120cc3c-497a-db4b-be9a-ad1bf336dbeb"],

Cell["Lorentz-consistent causal structure", "Item",ExpressionUUID->"edd88ecf-9f21-fa46-b09d-559c601019a7"],

Cell["correct source coupling", "Item",ExpressionUUID->"50e7424d-b8ef-2a46-8ded-f67ce36f4af8"],

Cell["measurable field observables", "Item",ExpressionUUID->"93a61b66-adf6-774d-8329-99afec3ffe5e"],

Cell["comparison to electromagnetic data", "Item",ExpressionUUID->"9f7edaa9-e2e8-3745-818e-b16879164b30"]
}, Open  ]],

Cell[CellGroupData[{

Cell["To claim a mode is sound", "Subsection",ExpressionUUID->"d9ba9ac1-6ead-a84c-9c3d-7c8ffd297797"],

Cell["Need all of: ", "Text",ExpressionUUID->"9102ca24-c958-4c4d-a84b-63796cf304b6"],

Cell["medium-dependent compressional mode", "Item",ExpressionUUID->"a7973967-605f-e049-9509-564e8ced9951"],

Cell["subluminal group velocity", "Item",ExpressionUUID->"dc8ab724-1a52-1147-a36e-43428572a852"],

Cell["pressure/density interpretation", "Item",ExpressionUUID->"e5c48898-7646-ff45-af64-57fdbc800585"],

Cell["correct acoustic boundary behavior", "Item",ExpressionUUID->"de7dd056-a2f2-7a47-bac7-2f7bac9a279a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["To claim a mode is consciousness", "Subsection",ExpressionUUID->"4923375d-e677-e64d-bb94-f84baee26326"],

Cell["Need all of: ", "Text",ExpressionUUID->"28ede829-ffbd-e142-b3cd-df137cb42bc1"],

Cell["independent operational definition", "Item",ExpressionUUID->"87f70732-7183-2742-b286-df8e3c29db2c"],

Cell["nontrivial predictions not reducible to ordinary dynamics", "Item",ExpressionUUID->"babd7532-89fa-e347-95a3-839df57a4957"],

Cell["reproducible measurements", "Item",ExpressionUUID->"62e355f9-5000-fb4e-acec-a8f8710398e5"],

Cell["falsifiable observer-dependent outcomes", "Item",ExpressionUUID->"7bd04599-d283-2e46-973f-da043c95069c"],

Cell["Without that, the labels remain metaphoric. ", "Text",ExpressionUUID->"5449b0b5-9313-bc40-b09e-14ee69e55b92"],

