ax2.grid(True, alpha=0.3)\n    ax2.text(10, residuals[0]\\*0.1, f\"Converges \
to vacuum:\nrho\\* = {rho\\_vals[-1]:.4f}\", color='purple')\n\n    \\# \
-------------------------------------------------------------------------\n   \
 \\# PLOT 3: Thermodynamic Phase Transition\n    \\# \
