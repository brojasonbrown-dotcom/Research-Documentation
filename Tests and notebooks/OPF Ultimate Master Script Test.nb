         "/wl\n$MaxPrecision = Infinity; $MinPrecision = 0;\n\nClearAll[phi, \
planckLength, planckTemp, planckDensity, temperature, infoDensity,\n  m1, m2, \
m3a, m3b, dm1, dm2, dm3a, dm3b, d2m1, d2m2, d2m3a, d2m3b,\n  \
classifyCriticalPoints, measureMap, measureSequence, effectiveMass,\n  \
opfMatrix, detPoly, dispersionRoots, stableModes, missingVars, action,\n  \
eulerEq, maintenanceEq, measurementKernel, pipeline, rho, chi, r, s, x, t, k, \
omega, K,\n  alpha, beta, mu, sigma, lam, eta, rho0, chi0, r0, eps];\n\nphi = \
(1 + Sqrt[5])/2;\nplanckLength = SetPrecision[1.616255*10^-35, 80];\n\
planckTemp = SetPrecision[1.416784*10^32, 80];\nplanckDensity = \
SetPrecision[5.155*10^96, 80];\n\ntemperature[n_] := planckTemp*phi^-n;\n\
infoDensity[n_] := planckDensity*phi^(-4 n);\n\nm1[rho_, mu_:1, lam_:1] := \
-(1/2) mu^2 rho^2 + (1/4) lam rho^4;\nm2[rho_, eps_:3/2] := (1/2) rho^2 + eps \
Cos[rho];\nm3a[rho_] := Log[1 + rho^2] - (1/2) rho^2;\nm3b[rho_] := -Log[1 + \
rho^2] + (1/2) rho^2;\n\ndm1[rho_] = D[m1[rho, 1, 1], rho] // FullSimplify;\n\
dm2[rho_] = D[m2[rho, 3/2], rho] // FullSimplify;\ndm3a[rho_] = D[m3a[rho], \
rho] // FullSimplify;\ndm3b[rho_] = D[m3b[rho], rho] // FullSimplify;\n\n\
d2m1[rho_] = D[m1[rho, 1, 1], {rho, 2}] // FullSimplify;\nd2m2[rho_] = \
D[m2[rho, 3/2], {rho, 2}] // FullSimplify;\nd2m3a[rho_] = D[m3a[rho], {rho, \
2}] // FullSimplify;\nd2m3b[rho_] = D[m3b[rho], {rho, 2}] // FullSimplify;\n\n\
classifyCriticalPoints[pot_, dpot_, d2pot_, var_Symbol, search_:4] := Module[\
\n  {sol, pts, vals},\n  sol = var /. NSolve[{dpot == 0, -search <= var <= \
search}, var, WorkingPrecision -> 80];\n  pts = DeleteDuplicates[Chop[sol, \
10^-40], Abs[#1 - #2] < 10^-30 &];\n  vals = AssociationThread[pts, (d2pot /. \
var -> #) & /@ pts];\n  <|\n    \"CriticalPoints\" -> pts,\n    \
\"SecondDerivative\" -> vals,\n    \"Minima\" -> Select[pts, (vals[#] > 0) \
&],\n    \"Maxima\" -> Select[pts, (vals[#] < 0) &],\n    \"Flat\" -> \
Select[pts, PossibleZeroQ[vals[#]] &]\n  |>\n];\n\npotResults = <|\n  \"M1\" \
-> classifyCriticalPoints[m1[rho,1,1], dm1[rho], d2m1[rho], rho],\n  \"M2\" \
-> classifyCriticalPoints[m2[rho,3/2], dm2[rho], d2m2[rho], rho],\n  \"M3a\" \
-> classifyCriticalPoints[m3a[rho], dm3a[rho], d2m3a[rho], rho],\n  \"M3b\" \
-> classifyCriticalPoints[m3b[rho], dm3b[rho], d2m3b[rho], rho]\n|>;\n\n\
measureMap[x_] := (3/2) Sin[x];\nmeasureSequence[rhoInit_:1/10, nmax_:40] := \
Module[{seq},\n  seq = NestList[measureMap, SetPrecision[rhoInit,80], nmax];\n\
  <|\"Sequence\" -> seq, \"Residuals\" -> Abs[Differences[seq]]|>\n];\nmeas = \
measureSequence[];\nfixedPoints = x /. NSolve[measureMap[x] == x && -4 <= x \
<= 4, x, WorkingPrecision -> 80];\n\n(* Thermodynamic transition *)\n\
effectiveMass[T_, m0sq_:-2, c_:1] := m0sq + c T^2;\ncriticalTemp = \
FullSimplify[Solve[effectiveMass[T] == 0, T, Reals]];\n\n(* OPF-style action \
and PDE at symbolic level *)\naction = \n  Integrate[rho[x,t] Log[chi[x,t]] + \
chi[x,t] r[x,t]^2 + \n    alpha/2 (D[rho[x,t], t]^2 - D[rho[x,t], x]^2) + \n  \
  beta/2 (D[chi[x,t], t]^2 - D[chi[x,t], x]^2) + \n    mu/2 (D[r[x,t], t]^2 - \
D[r[x,t], x]^2) + \n    sigma/2 (D[s[x,t], t]^2 - D[s[x,t], x]^2) - lam/2 \
s[x,t]^2 + eta rho[x,t] s[x,t],\n    {x, -Infinity, Infinity}, \
GenerateConditions -> False];\n\nlagDensity = rho[x,t] Log[chi[x,t]] + \
chi[x,t] r[x,t]^2 + \n  alpha/2 (D[rho[x,t], t]^2 - D[rho[x,t], x]^2) + \n  \
beta/2 (D[chi[x,t], t]^2 - D[chi[x,t], x]^2) + \n  mu/2 (D[r[x,t], t]^2 - \
D[r[x,t], x]^2) + \n  sigma/2 (D[s[x,t], t]^2 - D[s[x,t], x]^2) - lam/2 \
s[x,t]^2 + eta rho[x,t] s[x,t];\n\neulerEq = <|\n  \"rho\" -> \
FullSimplify[VariationalD[lagDensity, rho[x,t], {x,t}] == 0],\n  \"chi\" -> \
FullSimplify[VariationalD[lagDensity, chi[x,t], {x,t}] == 0],\n  \"r\" -> \
FullSimplify[VariationalD[lagDensity, r[x,t], {x,t}] == 0],\n  \"s\" -> \
FullSimplify[VariationalD[lagDensity, s[x,t], {x,t}] == 0]\n|>;\n\n\
maintenanceEq[f_] := D[f[t], t] + Symbol[\"CapitalGamma\"] f[t] == 0;\n\
measurementKernel[psi_] := HoldForm[Inactive[NIntegrate][psi, {x, -Infinity, \
Infinity}]];\n\nopfMatrix[K_, alpha_, beta_, mu_, sigma_, lam_, eta_, rho0_, \
chi0_, r0_] := {\n  {alpha K, -1/chi0, 0, eta},\n  {-1/chi0, beta K + \
rho0/chi0^2, -2 r0, 0},\n  {0, -2 r0, mu K - 2 chi0, 0},\n  {eta, 0, 0, sigma \
K - lam}\n};\n\nparams = <|alpha -> 1, beta -> 1, mu -> 1, sigma -> 1, lam -> \
