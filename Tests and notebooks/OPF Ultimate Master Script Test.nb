Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Alpha]", ",", "\[Beta]", ",", "\[Mu]", ",", "\[Sigma]", ",", 
        "\[Lambda]", ",", "\[Eta]", ",", "Jobs", ",", "\[Rho]0", ",", 
        "\[Chi]0", ",", "r0", ",", "s0", ",", "\[CurlyEpsilon]", ",", 
        "\[Omega]", ",", "kx", ",", "ky", ",", "kz"}], "}"}], ",", "Reals"}], 
     "]"}], "&&", "\[IndentingNewLine]", "   ", 
    RowBox[{"\[Alpha]", ">", "0"}], "&&", 
    RowBox[{"\[Beta]", ">", "0"}], "&&", 
    RowBox[{"\[Mu]", ">", "0"}], "&&", 
    RowBox[{"\[Sigma]", ">", "0"}], "&&", 
    RowBox[{"\[Chi]0", ">", "0"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[231]:=",ExpressionUUID->"16e68325-86c0-3a46-8fea-ed37e5c39421"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coords4", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
