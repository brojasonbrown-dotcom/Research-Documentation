Cell[CellGroupData[{

Cell["5. Residual Analysis", "Section",ExpressionUUID->"f23af06a-704b-b143-a3b2-62070ae72ba7"],

Cell["\<\
Per your solver directives, validation should include residual analysis.\
\>", "Text",ExpressionUUID->"6f9a48ca-bab5-d841-b7ea-4a64ae66e2ed"],

Cell[TextData[{
 "We compute the pointwise residual ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "-", 
         SuperscriptBox["\[Psi]", "\[Prime]\[Prime]"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", "2", "\[Rho]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "log", 
         RowBox[{"(", 
           RowBox[{"\[Chi]", "(", 
             StyleBox["x", "TI"], ")"}], ")"}], "\[Psi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", "4", "\[Chi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         StyleBox["R", "TI"], 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "2"], "\[Psi]", 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathcal{R}(x) = -\\psi''(x) + 2\\rho(x)\\log(\\chi(x))\\psi(x) + \
4\\chi(x)R(x)^2\\psi(x)^3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e1d33e11-e768-694b-a802-2e2636c818dc"],
 "with the solved field substituted in. "
}], "Text",ExpressionUUID->"02878af3-11b8-3b4b-bb1e-6435f91516f1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "residualFun", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"residualFun", "[", "x_", "]"}], ":=", 
   RowBox[{"Evaluate", "[", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"fieldEq", " ", "/.", " ", 
       RowBox[{"Equal", "->", "Subtract"}]}], " ", "/.", " ", 
      RowBox[{"psi", "->", "opfSolution"}]}], ")"}], "]"}]}], ";"}]}], "Input",\
ExpressionUUID->"fd8c0b71-f5cd-fe44-bad2-a64ec268395a"],

Cell["Sample the residual densely. ", "Text",ExpressionUUID->"aff720f5-2524-df4f-8be9-8e25c04ab7ff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"residualGrid", ",", "residualValues", ",", "maxResidual"}], "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"residualGrid", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"Subdivide", "[", 
      RowBox[{"0", ",", "1", ",", "200"}], "]"}], ",", "60"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"residualValues", "=", 
   RowBox[{"SetPrecision", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"residualFun", " ", "/@", " ", "residualGrid"}], "]"}], ",", 
     "60"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"maxResidual", "=", 
  RowBox[{"Max", "[", "residualValues", "]"}]}]}], "Input",ExpressionUUID->\
"d5d858d5-1e02-034d-86b3-7bd94b7254a1"],

Cell["Residual plot: ", "CodeText",ExpressionUUID->"084c2873-b4cf-e24d-894a-6de04951aca9"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"residualGrid", ",", "residualValues"}], "}"}], "]"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"ScalingFunctions", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", "\"\<Log\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotLabel", "->", "\"\<Residual Magnitude Across Domain\>\""}], ",",
    "\[IndentingNewLine]", "  ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<|Residual|\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"ImageSize", "->", "Large"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"c40bb283-cf34-f740-aa0b-4153b71fa930"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"7030bc2d-fe45-f647-976e-1cb4749c47d3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Resolution / Precision Refinement Study", "Section",ExpressionUUID->"2ed43114-8d1e-eb41-bb84-3d7b6dcc412a"],

Cell["\<\
To make the test complete, we verify that the solution stabilizes as \
precision is increased. \
\>", "Text",ExpressionUUID->"4f2b5b6e-f3de-d743-adf0-54f89e72c8b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "solveAtPrecision", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solveAtPrecision", "[", "wp_Integer", "]"}], ":=", 
  RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"fieldEq", "==", "0"}], ",", "bcs"}], "}"}], ",", 
    "\[IndentingNewLine]", "  ", "psi", ",", "\[IndentingNewLine]", "  ", 
    "domain", ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"WorkingPrecision", "->", "wp"}], ",", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"PrecisionGoal", "->", 
     RowBox[{"Floor", "[", 
      RowBox[{"wp", "/", "2"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"AccuracyGoal", "->", 
     RowBox[{"Floor", "[", 
      RowBox[{"wp", "/", "2"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"Method", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<BoundaryValues\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Shooting\>\"", ",", 
         RowBox[{"\"\<StartingInitialConditions\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"psi", "[", "0", "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"psi", "'"}], "[", "0", "]"}], "==", 
             RowBox[{"1", "/", "10"}]}]}], "}"}]}]}], "}"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",ExpressionUUID->"118ede7c-2c4f-\
b64a-a8dd-db3755e16fe4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "precisions", ",", "refinedSolutions", ",", "probePoints", ",", 
    "convergenceTable"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"precisions", "=", 
   RowBox[{"{", 
    RowBox[{"40", ",", "60", ",", "80"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"refinedSolutions", "=", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{"precisions", ",", 
     RowBox[{"solveAtPrecision", " ", "/@", " ", "precisions"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"probePoints", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Subdivide", "[", 
       RowBox[{"0", ",", "1", ",", "20"}], "]"}], ",", "50"}], "]"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"convergenceTable", "=", 
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"s1", "=", 
            RowBox[{"refinedSolutions", "[", "p1", "]"}]}], ",", 
           RowBox[{"s2", "=", 
            RowBox[{"refinedSolutions", "[", "p2", "]"}]}]}], "}"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Pair\>\"", "->", 
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}]}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"\"\<MaxDifference\>\"", "->", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"s1", " ", "/@", " ", "probePoints"}], ")"}], "-", 
               RowBox[{"(", 
                RowBox[{"s2", " ", "/@", " ", "probePoints"}], ")"}]}], "]"}],
              "]"}]}]}], "\[IndentingNewLine]", "    ", "|>"}]}], 
        "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"p1", ",", 
         RowBox[{"Most", "[", "precisions", "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"p2", ",", 
         RowBox[{"Rest", "[", "precisions", "]"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], " ", "//", " ", "Flatten"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", "convergenceTable", "]"}]}], "Input",ExpressionUUID->\
"cd87f990-f2d9-ff4a-bf59-5e2b2379bc5c"],

Cell["Plot the solutions together. ", "Text",ExpressionUUID->"b3be48e8-60b3-5242-b58d-a2a2f755d75f"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"refinedSolutions", "[", "wp", "]"}], "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"wp", ",", "precisions"}], "}"}]}], "]"}], "]"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"ToString", " ", "/@", " ", "precisions"}], ",", "Right"}], 
     "]"}]}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotLabel", "->", "\"\<Precision Refinement Comparison\>\""}], ",",
    "\[IndentingNewLine]", "  ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<\[Psi](x)\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"ImageSize", "->", "Large"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"5a3e429a-92f2-2a4f-93cb-9c4fcb1d1086"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"5d7d4856-1519-034f-9d5f-ca11fdb83df7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Stable Frequency Extraction", "Section",ExpressionUUID->"a802659f-8cd6-cf42-8aea-2e84c8dd709d"],

Cell["\<\
Your directive asks for linearization and eigenvalue extraction.\
\>", "Text",ExpressionUUID->"37f6c9d0-84fa-674b-b58a-6e2f6eea7187"],

Cell[TextData[{
 "Linearize about the computed background solution ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Psi]", "0"], "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\psi_0(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d210224b-3f5c-5945-8023-ab78d9b6ca5d"],
 " by setting ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Psi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SubscriptBox["\[Psi]", "0"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", "\[Epsilon]", 
         StyleBox["u", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\psi(x) = \\psi_0(x) + \\varepsilon u(x)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b3866da1-cfe6-1c4d-983c-e8f58879c8c2"],
 "Then the linearized operator is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         StyleBox["u", "TI"], "\[LongEqual]", "-", 
         SuperscriptBox[
          StyleBox["u", "TI"], "\[Prime]\[Prime]"], "+", 
         RowBox[{"(", 
           RowBox[{"2", "\[Rho]", "log", 
             RowBox[{"(", "\[Chi]", ")"}], "+", "12", "\[Chi]", 
             SuperscriptBox[
              StyleBox["R", "TI"], "2"], 
             SubsuperscriptBox["\[Psi]", "0", "2"]}], ")"}], 
         StyleBox["u", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{L}u = -u'' + \\left(2\\rho\\log(\\chi) + 12\\chi R^2 \
\\psi_0^2\\right)u", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "361f0083-b1c1-da4a-b532-2c461993d055"],
 "We discretize this as a Sturm\[Dash]Liouville eigenproblem on the same \
interval with homogeneous Dirichlet conditions. "
}], "Text",ExpressionUUID->"88e6068c-2348-5b44-b7dd-14c9e69ddce5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "potentialFun", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"potentialFun", "[", "x_", "]"}], ":=", 
   RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"rhoFun", "[", "x", "]"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"chiFun", "[", "x", "]"}], "]"}]}], "+", 
     RowBox[{"12", " ", 
      RowBox[{"chiFun", "[", "x", "]"}], " ", 
      RowBox[{
       RowBox[{"resFun", "[", "x", "]"}], "^", "2"}], " ", 
      RowBox[{
       RowBox[{"opfSolution", "[", "x", "]"}], "^", "2"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"073df3d3-26c8-7845-8366-b53a152bd220"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"eigenvals", ",", "eigenfuns"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"eigenvals", ",", "eigenfuns"}], "}"}], "=", 
   RowBox[{"NDEigensystem", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"u", "''"}], "[", "x", "]"}]}], "+", 
        RowBox[{
         RowBox[{"potentialFun", "[", "x", "]"}], " ", 
         RowBox[{"u", "[", "x", "]"}]}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"DirichletCondition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"x", "==", "0"}], "||", 
          RowBox[{"x", "==", "1"}]}]}], "]"}]}], "\[IndentingNewLine]", "  ", 
      "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"u", "[", "x", "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", "6", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"WorkingPrecision", "->", "60"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"Method", "->", 
      RowBox[{"{", "\"\<FiniteElement\>\"", "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"7d179473-f174-3b47-823a-\
5dc41a471a71"],

Cell["Display the eigenvalues. ", "Text",ExpressionUUID->"c7c5510b-3248-6447-88ec-9de8188e180b"],

Cell[BoxData[
 RowBox[{"Grid", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Prepend", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#2", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "#1"}], "}"}], " ", "&"}], ",",
        "eigenvals"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<Mode\>\"", ",", "\"\<Eigenvalue\>\""}], "}"}]}], 
    "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"Frame", "->", "All"}]}], "\[IndentingNewLine]", "]"}]], "Input",Ex\
pressionUUID->"f51eab44-ff6a-2949-98de-5c2bccdff206"],

Cell["\<\
For this self-adjoint linearization, undamped oscillatory modes correspond \
naturally to positive spectral values. Frequencies are: \
\>", "CodeText",ExpressionUUID->"66162982-8f4d-ec40-b6a4-990a9d8da6ec"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "frequencies", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"frequencies", "=", 
  RowBox[{
   RowBox[{"Sqrt", "[", "eigenvals", "]"}], " ", "//", " ", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"#", ",", "30"}], "]"}], " ", "&"}]}]}]}], "Input",ExpressionUUID\
->"cefe041c-3e28-0f44-bc8a-cabc076fab3b"],

Cell["Visualize the first modes. ", "Text",ExpressionUUID->"864becbe-1836-e248-bab7-9f514cecf01a"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"eigenfuns", "[", 
     RowBox[{"[", 
      RowBox[{"1", " ", ";;", " ", "4"}], "]"}], "]"}], "]"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
   "PlotLabel", "->", "\"\<First Four Linearized OPF Eigenmodes\>\""}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<mode amplitude\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"ImageSize", "->", "Large"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"81454c02-627c-5d41-a0ee-439fa77a08d6"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"dcc8fe15-f6bb-3e4e-be3e-a09e9ce09e20"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Missing Variable Analysis", "Section",ExpressionUUID->"205a305f-9ebd-5742-8f89-20770aa4250b"],

Cell["\<\
Your instruction says to compute variables absent from standard model \
constants and expose solvable structure.\
\>", "Text",ExpressionUUID->"c85d1e0c-a233-e049-a0ef-e27b4f64844c"],

Cell["\<\
Here we identify the symbolic variables in the OPF action and in the reduced \
field equation. \
\>", "Text",ExpressionUUID->"c07d09a8-1f3c-174f-8855-87e9b87d64ad"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"actionVariables", ",", "reducedEquationVariables"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"actionVariables", "=", 
   RowBox[{"DeleteDuplicates", " ", "@", " ", 
    RowBox[{"Cases", "[", 
     RowBox[{"lagrangian", ",", "_Symbol", ",", "Infinity"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"reducedEquationVariables", "=", 
    RowBox[{"DeleteDuplicates", " ", "@", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{"fieldEq", ",", "_Symbol", ",", "Infinity"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"<|", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"\"\<ActionVariables\>\"", "->", "actionVariables"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<ReducedEquationVariables\>\"", "->", 
    "reducedEquationVariables"}]}], "\[IndentingNewLine]", "|>"}]}], "Input",E\
xpressionUUID->"15b63fc2-3b63-444d-b097-ffde433ee199"],

Cell["\<\
A more useful structural result is to solve the field equation algebraically \
for the cubic coefficient term when possible. \
\>", "Text",ExpressionUUID->"f9f8421d-96db-ec4a-b11c-0dc56b62320a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "algebraicRearrangement", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"algebraicRearrangement", "=", 
  RowBox[{
   RowBox[{"Solve", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"fieldEq", "==", "0"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"psi", "''"}], "[", "x", "]"}]}], "\[IndentingNewLine]", "]"}], 
   " ", "//", " ", "FullSimplify"}]}]}], "Input",ExpressionUUID->"8de8deb3-\
de6e-7844-b65e-d2e4414b93cf"],

Cell["\<\
This exposes the morphism from OPF coefficients into curvature of the field. \
\>", "Text",ExpressionUUID->"ef1388dc-5136-a649-a8f0-b94fdc1a65c9"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"84802df1-37ba-2f4c-864b-37f542d307c2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Layer 2 Measurement Operator", "Section",ExpressionUUID->"2d601a5c-4305-7f4b-bfe4-e9c45c7ffc42"],

Cell["\<\
Per your Layer 2 definition, observables are integrals of the field over an \
eigenbasis.\
\>", "Text",ExpressionUUID->"734e41d8-05c1-3943-9f81-f2472446ed09"],

Cell[TextData[{
 "For the 1D reduced case, define modal observables ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Integral]", "0", "1"], "\[Psi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], " ", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[DifferentialD]", 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "M_n = \\int_0^1 \\psi(x) \\, e_n(x)\\, dx", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a95d17f7-b448-b641-b082-1d77b0cc7740"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "e_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "56456045-3b89-3947-aceb-5b29a8771798"],
 " are normalized eigenfunctions. "
}], "Text",ExpressionUUID->"25d6d927-da4a-4a42-963a-7a795fa68b39"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "measurementOperator", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementOperator", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"opfSolution", "[", "x", "]"}], " ", 
      RowBox[{"eigenfuns", "[", 
       RowBox[{"[", "n", "]"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"WorkingPrecision", "->", "60"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"PrecisionGoal", "->", "30"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"AccuracyGoal", "->", "30"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"e7eabc78-bfb9-7b45-a253-303cc8ba792d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "measurements", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"measurements", "=", 
  RowBox[{"Association", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"n", "->", 
      RowBox[{"measurementOperator", "[", "n", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"Length", "[", "eigenfuns", "]"}]}], "}"}]}], 
    "]"}]}]}]}], "Input",ExpressionUUID->"ffd7404d-ccc1-7246-bbef-\
bccbc3837f0d"],

Cell["Visualize modal amplitudes. ", "Text",ExpressionUUID->"765e4a0d-6882-b64e-bc6d-c688f4dbb8c8"],

Cell[BoxData[
 RowBox[{"BarChart", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Values", "[", "measurements", "]"}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"ChartLabels", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"Keys", "[", "measurements", "]"}], ",", "Below"}], "]"}]}], ",",
    "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotLabel", "->", "\"\<Layer 2 Measurement Amplitudes\>\""}], ",",
    "\[IndentingNewLine]", "  ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Mode\>\"", ",", "\"\<Observable\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"ImageSize", "->", "Large"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"87e4d5ed-f6a2-ef41-814d-60eec8c2791a"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"141c2e80-b7ab-1e41-9b75-f47170898163"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. L0 \[RightArrow] L1 \[RightArrow] L2 Pipeline", "Section",ExpressionUUID->"5a08cd0a-547b-8640-a939-5222941bad99"],

Cell["Now compose the full callable pipeline as requested. ", "Text",ExpressionUUID->"17414d8b-7570-da46-8e2a-c2fe62d7ecd9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "layer0", ",", "layer1Operator", ",", "layer2Operator", ",", 
     "opfPipeline"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer0", "[", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Geometry\>\"", 
       "->", "\"\<SphereBoundaryDualityPlaceholder\>\""}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<TemporalMode\>\"", "->", "\"\<Timeless\>\""}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Substrate\>\"", "->", "\"\<EmptySpacetime\>\""}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer1Operator", "[", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Lagrangian\>\"", "->", "lagrangian"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<EulerEquation\>\"", "->", "eulerEq"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ConcreteEquation\>\"", "->", "fieldEq"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Solution\>\"", "->", "opfSolution"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ResidualMax\>\"", "->", "maxResidual"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Eigenvalues\>\"", "->", "eigenvals"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Frequencies\>\"", "->", "frequencies"}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer2Operator", "[", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Measurements\>\"", "->", "measurements"}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"opfPipeline", "=", 
   RowBox[{"RightComposition", "[", 
    RowBox[{"layer0", ",", 
     RowBox[{"Function", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<L0\>\"", "->", "#"}], ",", 
        RowBox[{"\"\<L1\>\"", "->", 
         RowBox[{"layer1Operator", "[", "]"}]}], ",", 
        RowBox[{"\"\<L2\>\"", "->", 
         RowBox[{"layer2Operator", "[", "]"}]}]}], "|>"}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"31ef711b-c3b5-0d40-9eb3-b8bf9a795ca2"],

Cell["Inspect the pipeline output. ", "Text",ExpressionUUID->"1e052c9d-2e30-8d49-bed2-42604379f3ce"],

Cell[BoxData[
 RowBox[{"opfPipeline", "[", "]"}]], "Input",ExpressionUUID->"25a977d8-4c45-9a48-af47-afbb7ad3c3bd"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"f84a82fe-b5ac-8c44-ad5d-b680f55bb5b2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Automated Verification Tests", "Section",ExpressionUUID->"a4747d70-026d-6345-8128-0f1a9c6a1d48"],

Cell["\<\
We now make the notebook a complete test harness with actual pass/fail \
indications. \
\>", "Text",ExpressionUUID->"d098dd8e-018f-fa4e-bc7d-24b692d25c15"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "tests", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tests", "=", 
   RowBox[{"{", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{"eulerEq", ",", "_Equal"}], "]"}], ",", "\[IndentingNewLine]",
        "    ", "True", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-EL-Derivation-001\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{
          RowBox[{"opfSolution", "[", "0", "]"}], ",", 
          RowBox[{"10", "^", 
           RowBox[{"-", "40"}]}]}], "]"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", "    ", "True", ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-BC-Left-002\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"opfSolution", "[", "1", "]"}], "-", 
          RowBox[{"1", "/", "10"}]}], "]"}], "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "40"}]}]}], ",", "\[IndentingNewLine]", "    ", "True", 
       ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-BC-Right-003\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"maxResidual", "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "30"}]}]}], ",", "\[IndentingNewLine]", "    ", "True", 
       ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-Residual-004\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Rest", "[", "eigenvals", "]"}], ",", 
         RowBox[{
          RowBox[{"#", ">", 
           RowBox[{"eigenvals", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], " ", "&"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "    ", "True", ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-Spectrum-Ordered-005\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{"eigenvals", ",", "Positive"}], "]"}], ",", 
       "\[IndentingNewLine]", "    ", "True", ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-Stable-Modes-006\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"refinedSolutions", "[", "60", "]"}], " ", "/@", " ", 
             "probePoints"}], ")"}], "-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"refinedSolutions", "[", "80", "]"}], " ", "/@", " ", 
             "probePoints"}], ")"}]}], "]"}], "]"}], "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "20"}]}]}], ",", "\[IndentingNewLine]", "    ", "True", 
       ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-Precision-Convergence-007\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"VectorQ", "[", 
        RowBox[{
         RowBox[{"Values", "[", "measurements", "]"}], ",", "NumericQ"}], 
        "]"}], ",", "\[IndentingNewLine]", "    ", "True", ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-Measurement-Numeric-008\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]}], "Input",ExpressionUUID->"afdf760e-baa3-6c4a-a479-3187da2a4a65"],

Cell["Evaluate the tests: ", "CodeText",ExpressionUUID->"8b59b185-76e9-dc46-87ce-bcc97398d611"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "testResults", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"testResults", "=", 
  RowBox[{"TestReport", "[", "tests", "]"}]}]}], "Input",ExpressionUUID->\
"442ba7af-f777-364d-b7f3-00a50fac2805"],

Cell["Compact summary: ", "CodeText",ExpressionUUID->"c8c0e187-a915-ca42-a37f-5feb052c59c6"],

Cell[BoxData[
 RowBox[{"testSummary", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{"testResults", "[", "\"\<TestResults\>\"", "]"}], "]"}], 
  "]"}]], "Input",ExpressionUUID->"9757941f-f56c-5c4b-a918-8ad17e5c2ad4"],

Cell["Overall pass indicator: ", "CodeText",ExpressionUUID->"f650c49e-b8f4-3249-bfa5-9e2157949a1f"],

Cell[BoxData[
 RowBox[{"<|", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"\"\<AllTestsPassed\>\"", "->", 
    RowBox[{"testResults", "[", "\"\<AllTestsSucceeded\>\"", "]"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<TestsRun\>\"", "->", 
    RowBox[{"Length", "[", 
     RowBox[{"testResults", "[", "\"\<TestResults\>\"", "]"}], "]"}]}]}], 
  "\[IndentingNewLine]", "|>"}]], "Input",ExpressionUUID->"fdd28bd6-7d2f-1748-\
9b27-4756d1cda993"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"3567fcbc-1826-9641-8175-b7846f80a4ad"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12. Final Visual Dashboard", "Section",ExpressionUUID->"18fb89e2-8489-8d4b-8f50-667a3981ba7e"],

Cell["This section produces a compact visual inspection panel. ", "Text",ExpressionUUID->"78274544-2d7d-fe48-9708-30a8f4175fed"],

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"opfSolution", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotLabel", "->", "\"\<Field Solution\>\""}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<\[Psi](x)\>\""}], "}"}]}]}], "]"}], 
       ",", "\[IndentingNewLine]", "      ", 
       RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", "        ", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"residualGrid", ",", "residualValues"}], "}"}], "]"}], ",",
          "\[IndentingNewLine]", "        ", 
         RowBox[{"ScalingFunctions", "->", 
          RowBox[{"{", 
           RowBox[{"None", ",", "\"\<Log\>\""}], "}"}]}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotLabel", "->", "\"\<Residual\>\""}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<|R|\>\""}], "}"}]}]}], "]"}]}], 
      "\[IndentingNewLine]", "    ", "}"}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"{", "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{"Plot", "[", "\[IndentingNewLine]", "        ", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"eigenfuns", "[", 
           RowBox[{"[", 
            RowBox[{"1", " ", ";;", " ", "3"}], "]"}], "]"}], "]"}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotLabel", "->", "\"\<Eigenmodes\>\""}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<mode\>\""}], "}"}]}]}], "]"}], ",", 
       "\[IndentingNewLine]", "      ", 
       RowBox[{"BarChart", "[", "\[IndentingNewLine]", "        ", 
        RowBox[{
         RowBox[{"Values", "[", "measurements", "]"}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"ChartLabels", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"Keys", "[", "measurements", "]"}], ",", "Below"}], 
           "]"}]}], ",", "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotLabel", "->", "\"\<Measurements\>\""}]}], "]"}]}], 
      "\[IndentingNewLine]", "    ", "}"}]}], "\[IndentingNewLine]", "  ", 
    "}"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"ImageSize", "->", "Large"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"facc9c24-073e-5e48-9c0c-f710e53dd6ee"],

