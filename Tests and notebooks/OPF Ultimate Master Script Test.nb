Cell[CellGroupData[{

Cell["2. Layer Definitions", "Section",ExpressionUUID->"d55ee80f-bc30-df4f-8e11-5a1db19b047c"],

Cell[TextData[{
 "Your OPF Layer 1 action is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], "\[LongEqual]", "\[Integral]", 
         RowBox[{"(", 
           RowBox[{"\[Rho]", "log", 
             RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
             SuperscriptBox[
              StyleBox["R", "TI"], "2"]}], ")"}], "\[DifferentialD]", 
         "\[CapitalOmega]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "S = \\int \\left(\\rho \\log(\\chi) + \\chi R^2\\right) \\, d\\Omega", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c30221f2-dd8f-134d-b054-6bd1e7fb8464"],
 "To make this computationally testable as a field theory, we use a rigorous \
reduced model in which the information field ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Psi]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\psi(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7c42f080-7b9f-cf46-a9b4-a4b29b56e317"],
 " carries gradient energy and nonlinear potential terms induced by OPF \
variables."
}], "Text",ExpressionUUID->"b441b690-2753-6540-89ea-b22adff20dd2"],

Cell[TextData[{
 "We define ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Psi]", ",", 
             SuperscriptBox["\[Psi]", "\[Prime]"], ",", 
             StyleBox["x", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox["1", "2"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SuperscriptBox["\[Psi]", "\[Prime]"], "(", 
              StyleBox["x", "TI"], ")"}], ")"}], "2"], "+", "\[Rho]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "log", 
         RowBox[{"(", 
           RowBox[{"\[Chi]", "(", 
             StyleBox["x", "TI"], ")"}], ")"}], " ", "\[Psi]", 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "2"], "+", "\[Chi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         StyleBox["R", "TI"], 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "2"], " ", "\[Psi]", 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "4"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathcal{L}(\\psi, \\psi', x) = \\frac{1}{2}(\\psi'(x))^2 + \\rho(x) \
\\log(\\chi(x))\\, \\psi(x)^2 + \\chi(x) R(x)^2 \\, \\psi(x)^4", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "301267c2-b835-d148-bba4-a8e40d56ff3a"],
 "This yields a real Euler\[Dash]Lagrange equation and still respects your \
Layer 1 variable structure. "
}], "Text",ExpressionUUID->"7f177cbf-1ba3-d940-a0e6-35a9632ba188"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "x", ",", "psi", ",", "rho", ",", "chi", ",", "res", ",", "lagrangian"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lagrangian", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"psi", "[", "x", "]"}], ",", "x"}], "]"}], "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{"rho", "[", "x", "]"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"chi", "[", "x", "]"}], "]"}], " ", 
     RowBox[{
      RowBox[{"psi", "[", "x", "]"}], "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{"chi", "[", "x", "]"}], " ", 
     RowBox[{
      RowBox[{"res", "[", "x", "]"}], "^", "2"}], " ", 
     RowBox[{
      RowBox[{"psi", "[", "x", "]"}], "^", "4"}]}]}]}], ";"}]}], "Input",Expre\
ssionUUID->"60c43086-e9a3-144e-adee-e2cf6b044a10"],

Cell["Derive the Euler\[Dash]Lagrange equation symbolically. ", "Text",ExpressionUUID->"4afd33b4-287a-4c4a-b303-57bc1ecfa3e1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "eulerEq", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"eulerEq", "=", 
  RowBox[{"FullSimplify", " ", "@", " ", 
   RowBox[{
    RowBox[{"EulerEquations", "[", 
     RowBox[{"lagrangian", ",", 
      RowBox[{"psi", "[", "x", "]"}], ",", "x"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]}], "Input",ExpressionUUID->"e37a0ffc-\
91a8-4b4d-bda2-4de89176c9cb"],

Cell[TextData[{
 "Expected form: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         SuperscriptBox["\[Psi]", "\[Prime]\[Prime]"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", "2", "\[Rho]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "log", 
         RowBox[{"(", 
           RowBox[{"\[Chi]", "(", 
             StyleBox["x", "TI"], ")"}], ")"}], "\[Psi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", "4", "\[Chi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         StyleBox["R", "TI"], 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "2"], "\[Psi]", 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "3"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "-\\psi''(x) + 2\\rho(x)\\log(\\chi(x))\\psi(x) + \
4\\chi(x)R(x)^2\\psi(x)^3 = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5d00b1cd-7123-894b-a750-0367b1d33226"]
}], "Text",ExpressionUUID->"2a701cf7-dd96-c646-aac0-0e4c86958251"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"6053955a-7d27-0642-addf-3bd23d9bc684"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Concrete Test Model", "Section",ExpressionUUID->"a9aaeb28-ebf6-104d-ae38-fcb2c081ced8"],

Cell[TextData[{
 "For a real complete test, we must fully specify ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Rho]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "29a28492-e579-8c4b-ae9c-87e6f0e93e2a"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Chi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\chi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "98073e6b-5bdb-6541-b786-14419c8e0033"],
 ", and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "914a6ddd-5ebb-6c47-b16f-69bf09f0b711"],
 "."
}], "Text",ExpressionUUID->"311406de-712c-7e4f-8721-423ff615854e"],

Cell[TextData[{
 "We choose smooth positive fields so that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"log", "(", "\[Chi]", ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\log(\\chi)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4255922c-4e03-2241-bbf8-4cd0748bb022"],
 " is well-defined and the PDE is well-posed. "
}], "Text",ExpressionUUID->"1362ca1b-dca9-d049-8177-315c7be9b570"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"rhoFun", ",", "chiFun", ",", "resFun"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhoFun", "[", "x_", "]"}], ":=", 
   RowBox[{"1", "+", 
    RowBox[{"x", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"chiFun", "[", "x_", "]"}], ":=", 
   RowBox[{"2", "+", 
    RowBox[{"x", "/", "5"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"resFun", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"3", "/", "2"}], "+", 
    RowBox[{
     RowBox[{"x", "^", "2"}], "/", "10"}]}]}], ";"}]}], "Input",ExpressionUUID\
->"06a3d9fd-da7c-b34d-b670-3dd4731d903d"],

Cell["Substitute these into the symbolic field equation. ", "Text",ExpressionUUID->"01e5b5bd-2818-6948-b43b-46237cf047f1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "fieldEq", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"fieldEq", "=", 
  RowBox[{
   RowBox[{"eulerEq", " ", "/.", " ", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"rho", "->", "rhoFun"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"chi", "->", "chiFun"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"res", "->", "resFun"}]}], "\[IndentingNewLine]", "}"}]}], " ", 
   "//", " ", "FullSimplify"}]}]}], "Input",ExpressionUUID->"80d6b7ba-bcec-\
6a40-9270-df64c5f02407"],

Cell[TextData[{
 "We solve the boundary-value problem on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "\[Element]", 
         RowBox[{"[", 
           RowBox[{"0", ",", "1"}], "]"}]}], TraditionalForm], "errors" -> {},
      "input" -> "x \\in [0,1]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "18e4576c-39c0-1d42-91b8-a1c3e8e65712"],
 " with physical boundary conditions ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Psi]", 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", "0", ",  ", "\[Psi]", 
         RowBox[{"(", "1", ")"}], "\[LongEqual]", 
         FractionBox["1", "10"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\psi(0) = 0, \\quad \\psi(1) = \\frac{1}{10}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5341c4db-752b-794c-ae05-8f1f53031572"]
}], "Text",ExpressionUUID->"40009b27-6ef1-3e4d-ad19-2c1e5121b086"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"domain", ",", "bcs"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"domain", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bcs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"psi", "[", "0", "]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{"psi", "[", "1", "]"}], "==", 
      RowBox[{"1", "/", "10"}]}]}], "}"}]}], ";"}]}], "Input",ExpressionUUID->\
"a3179f7b-d683-534c-9a16-e5183223f0b7"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"59debf15-917c-0947-b6b1-7f1d0c72eacc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. High-Precision Numerical Solve", "Section",ExpressionUUID->"7d778385-c9a8-9745-bcd9-17a8c8370f8a"],

Cell[TextData[{
 StyleBox["Important rigor note:",
  FontWeight->Bold],
 " exact infinite working precision is not available for practical numerical \
solving. A rigorous computational substitute is to use ",
 StyleBox["arbitrarily high finite precision",
  FontWeight->Bold],
 " and then certify convergence and residual reduction. \[AliasDelimiter]"
}], "Text",
 CellChangeTimes->{
  4.00176559644528*^9},ExpressionUUID->"f284d127-e25f-8040-b9d1-fcd9bfffa096"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "opfSolution", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"opfSolution", "=", 
   RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fieldEq", "==", "0"}], ",", "bcs"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", "psi", ",", "\[IndentingNewLine]", "  ", 
     "domain", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"WorkingPrecision", "->", "80"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"PrecisionGoal", "->", "40"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"AccuracyGoal", "->", "40"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<BoundaryValues\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Shooting\>\"", ",", 
          RowBox[{"\"\<StartingInitialConditions\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"psi", "[", "0", "]"}], "==", "0"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"psi", "'"}], "[", "0", "]"}], "==", 
              RowBox[{"1", "/", "10"}]}]}], "}"}]}]}], "}"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"04cfa74d-3c19-c741-8044-af004fd065c8"],

Cell["Visualize the field. ", "Text",ExpressionUUID->"3441f223-f316-d844-8dc3-83efcc05f0c4"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"opfSolution", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{
   "PlotLabel", "->", "\"\<OPF Layer 1 Field Solution \[Psi](x)\>\""}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<\[Psi](x)\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"ImageSize", "->", "Large"}]}], "]"}]], "Input",ExpressionUUID->\
"8127d578-bf93-5e4c-bdf9-6e157aac7a1a"],

