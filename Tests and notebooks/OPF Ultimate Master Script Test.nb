Expand[opfDispersionPolynomial[k2, params]];\\\",\\n\\\"  roots = k2 /. \
NSolve[poly == 0, k2, WorkingPrecision -> 50];\\\",\\n\\\"  iter = \
opfMeasurementIterate[1/10, 3/2, 40];\\\",\\n\\\"  tc = Sqrt[2];\\\",\\n\\\"  \
scales = Table[{n, opfScaleTemperature[n], opfScaleDensity[n]}, {n, -3, \
6}];\\\",\\n\\\"  kernelValue = opfMeasurementKernel[Exp[-(x^2 + y^2)], {x, \
y}, {{-3, 3}, {-3, 3}}];\\\",\\n\\\"  <|\\\",\\n\\\"    \
\\\\\\\"EulerEquations\\\\\\\" -> euler,\\\",\\n\\\"    \
\\\\\\\"StationaryConditions\\\\\\\" -> stationary,\\\",\\n\\\"    \
\\\\\\\"HessianAtRho1ChiE\\\\\\\" -> hessianAtTest,\\\",\\n\\\"    \
\\\\\\\"DispersionPolynomial\\\\\\\" -> poly,\\\",\\n\\\"    \
\\\\\\\"DispersionRoots\\\\\\\" -> roots,\\\",\\n\\\"    \
\\\\\\\"MeasurementIteration\\\\\\\" -> iter,\\\",\\n\\\"    \
\\\\\\\"CriticalTemperature\\\\\\\" -> tc,\\\",\\n\\\"    \
\\\\\\\"ScaleTable\\\\\\\" -> scales,\\\",\\n\\\"    \
\\\\\\\"MeasurementKernelValue\\\\\\\" -> kernelValue\\\",\\n\\\"  |>\\\",\\n\
\\\"\\\"];\\\",\\n\\\"\\\",\\n\\\"End[]\\\",\\n\\\"EndPackage[]\\\"\\n}, \\\"\
\\\\n\\\"];\\n\\nopfPackagePath = FileNameJoin[{NotebookDirectory[], \
\\\"OPFFramework.wl\\\"}];\\nExport[opfPackagePath, opfPackageText, \
\\\"String\\\"]\\n```\\n\\n## 2. Load the \
package\\n\\n```wl\\nGet[opfPackagePath]\\n```\\n\\n## 3. Run the complete \
framework evaluation\\n\\n```wl\\nresults = \
OPFFramework`opfFullPipeline[];\\nresults // Keys\\n```\\n\\n## 4. Print the \
symbolic core results\\n\\n```wl\\nPrint[Style[\\\"OPF MAIN FRAMEWORK RESULTS\
\\\", 18, Bold]];\\nPrint[Style[\\\"1. Euler-Lagrange equations from the \
Layer 1 action\\\", 14, Bold]];\\nresults[\\\"EulerEquations\\\"] // \
TableForm\\n\\nPrint[Style[\\\"2. Static stationary conditions of V[rho, chi, \
R] = rho Log[chi] + chi R^2\\\", 14, \
Bold]];\\nresults[\\\"StationaryConditions\\\"]\\n\\nPrint[Style[\\\"3. \
Hessian of the potential at the test point {rho, chi, R} = {1, E, 0}\\\", 14, \
Bold]];\\nMatrixForm[results[\\\"HessianAtRho1ChiE\\\"]]\\n\\nPrint[Style[\\\"\
4. Dispersion polynomial Det[M(k^2)]\\\", 14, \
Bold]];\\nresults[\\\"DispersionPolynomial\\\"]\\n\\nPrint[Style[\\\"5. \
Dispersion roots\\\", 14, \
Bold]];\\nresults[\\\"DispersionRoots\\\"]\\n\\nPrint[Style[\\\"6. Critical \
temperature from m_eff^2(T) = -2 + T^2\\\", 14, \
Bold]];\\nresults[\\\"CriticalTemperature\\\"] // N[#, 30] \
&\\n\\nPrint[Style[\\\"7. Gaussian measurement kernel integral over a finite \
2D domain\\\", 14, Bold]];\\nresults[\\\"MeasurementKernelValue\\\"]\\n```\\n\
\\n## 5. Print the iterative measurement results in depth\\n\\n```wl\\niter = \
results[\\\"MeasurementIteration\\\"];\\n\\nPrint[Style[\\\"MEASUREMENT \
ITERATION DETAILS\\\", 16, Bold]];\\nPrint[\\\"Fixed point estimate: \\\", \
N[iter[\\\"FixedPointEstimate\\\"], 30]];\\nPrint[\\\"Initial residual: \\\", \
N[First[iter[\\\"Residuals\\\"]], 30]];\\nPrint[\\\"Final residual:   \\\", \
N[Last[iter[\\\"Residuals\\\"]], 30]];\\n\\nGrid[\\n  Prepend[\\n    \
MapIndexed[{First[#2] - 1, N[#1, 20]} &, iter[\\\"States\\\"]],\\n    \
{\\\"n\\\", \\\"rho_n\\\"}\\n  ],\\n  Frame -> All,\\n  Background -> {None, \
{Lighter[Gray, .95], White}}\\n]\\n```\\n\\n## 6. Generate the complete \
visual dashboard\\n\\n```wl\\nscaleData = results[\\\"ScaleTable\\\"];\\niter \
= results[\\\"MeasurementIteration\\\"];\\nparams = <|\\\"Alpha\\\" -> 1, \
\\\"Beta\\\" -> 1, \\\"Mu\\\" -> 1, \\\"Sigma\\\" -> 1, \\\"Lambda\\\" -> 2, \
\\\"Eta\\\" -> 1/2, \\\"Rho0\\\" -> 0, \\\"Chi0\\\" -> 1, \\\"Res0\\\" -> \
1/10|>;\\npoly = OPFFramework`opfDispersionPolynomial[k2, params];\\nroots = \
results[\\\"DispersionRoots\\\"];\\n\\npotentialPlot = Plot[\\n  Evaluate[{x \
Log[y] + y z^2 /. {y -> E, z -> 0}, x Log[E] + E (r^2) /. r -> x/2}],\\n  {x, \
-2, 2},\\n  PlotLegends -> {\\\"V[rho,E,0]\\\", \\\"Vtest[x] = x + E \
x^2/4\\\"},\\n  PlotLabel -> \\\"Static OPF potential slices\\\",\\n  \
AxesLabel -> {\\\"field coordinate\\\", \\\"V\\\"},\\n  ImageSize -> \
Large\\n];\\n\\nmeasurementPlot = ListLinePlot[\\n  \
N[iter[\\\"Residuals\\\"], 30],\\n  ScalingFunctions -> {None, \
\\\"Log\\\"},\\n  PlotMarkers -> Automatic,\\n  PlotStyle -> Purple,\\n  \
PlotLabel -> \\\"Measurement residuals\\\",\\n  AxesLabel -> {\\\"iteration\\\
\", \\\"|\[CapitalDelta]rho|\\\"},\\n  ImageSize -> \
Large\\n];\\n\\nthermalPlot = Plot[\\n  \
OPFFramework`opfThermalMassSquared[temp],\\n  {temp, 0, 3},\\n  Filling -> \
Axis,\\n  PlotStyle -> Red,\\n  PlotLabel -> \\\"Thermal mass squared\\\",\\n \
 AxesLabel -> {\\\"T\\\", \\\"m_eff^2(T)\\\"},\\n  Epilog -> {\\n    Black, \
Dashed, Line[{{Sqrt[2], -2}, {Sqrt[2], 7}}],\\n    Text[Style[Row[{\\\"T_c = \
\\\", NumberForm[N[Sqrt[2], 8], 8]}], 12, Bold], {1.8, 1}]\\n  },\\n  \
ImageSize -> Large\\n];\\n\\ndispersionPlot = Show[\\n  Plot[Evaluate[poly], \
{k2, -5, 5}, PlotRange -> All, PlotStyle -> Blue, AxesLabel -> {\\\"k^2-like \
variable\\\", \\\"Det[M]\\\"}, PlotLabel -> \\\"Dispersion \
determinant\\\"],\\n  Graphics[{Red, PointSize[0.02], \
Point[Transpose[{N[roots], ConstantArray[0, Length[roots]]}]]}],\\n  \
ImageSize -> Large\\n];\\n\\nGraphicsGrid[\\n  Partition[{potentialPlot, \
measurementPlot, thermalPlot, dispersionPlot}, 2],\\n  Spacings -> {0.5, 0.5}\
\\n]\\n```\\n\\n## 7. Real-results summary report\\n\\n```wl\\nPrint[Style[\\\
\"FINAL REPORT\\\", 18, Bold, Darker[Blue]]];\\n\\nPrint[Style[\\\"A. Layer 1 \
variational equations\\\", 14, \
Bold]];\\nPrint[results[\\\"EulerEquations\\\"]];\\n\\nPrint[Style[\\\"B. \
Static criticality conditions\\\", 14, \
Bold]];\\nPrint[results[\\\"StationaryConditions\\\"]];\\n\\nPrint[Style[\\\"\
C. Dispersion roots classified\\\", 14, Bold]];\\nScan[\\n  Function[root,\\n \
   Print[\\n      Which[\\n        Chop[Im[root]] == 0 && Re[root] > 0, \
Row[{NumberForm[N[root, 12], 12], \\\"  -> positive real mode\\\"}],\\n       \
 Chop[Im[root]] == 0 && Re[root] == 0, Row[{NumberForm[N[root, 12], 12], \\\" \
 -> null mode\\\"}],\\n        Chop[Im[root]] == 0 && Re[root] < 0, \
Row[{NumberForm[N[root, 12], 12], \\\"  -> negative real mode\\\"}],\\n       \
 True, Row[{NumberForm[N[root, 12], 12], \\\"  -> complex mode\\\"}]\\n      \
]\\n    ]\\n  ],\\n  \
results[\\\"DispersionRoots\\\"]\\n];\\n\\nPrint[Style[\\\"D. Measurement \
closure\\\", 14, Bold]];\\nPrint[\\\"rho* \[TildeTilde] \\\", \
N[iter[\\\"FixedPointEstimate\\\"], 30]];\\nPrint[\\\"Residual ratio \
final/initial \[TildeTilde] \\\", N[Last[iter[\\\"Residuals\\\"]]/First[iter[\
\\\"Residuals\\\"]], 30]];\\n\\nPrint[Style[\\\"E. Scale ladder sample\\\", \
14, Bold]];\\nGrid[\\n  Prepend[\\n    Map[{#[[1]], ScientificForm[#[[2]], \
4], ScientificForm[#[[3]], 4]} &, scaleData],\\n    {\\\"n\\\", \
\\\"Temperature\\\", \\\"Density\\\"}\\n  ],\\n  Frame -> All,\\n  Background \
-> {None, {Lighter[Blue, .9], White}}\\n]\\n```\\n\\n## Notes\\n\\n- This is \
a real Wolfram Language package written to disk as ``OPFFramework.wl``.\\n- \
The notebook computes symbolic variational derivatives with \
[VariationalD](paclet:ref/VariationalD), exact determinants with \
[Det](paclet:ref/Det), roots with [Solve](paclet:ref/Solve) or \
[NSolve](paclet:ref/NSolve), and numerical integrals with \
[NIntegrate](paclet:ref/NIntegrate).\\n- The original user instruction \
demanded infinite working precision for all numerical integration. In \
practical Wolfram Language execution, ``WorkingPrecision -> Infinity`` is not \
a valid numerical setting for [NIntegrate](paclet:ref/NIntegrate). This \
notebook therefore uses high finite precision and prints actual computed \
results.\\n- If you want, I can next convert this into a cleaner production \
package with usage messages, tests, and an exported report notebook.\"\>",
                    Background->None,
                    FrameMargins->1,
                    FrameStyle->Dynamic[
                    CurrentValue[Background]],
                    StripOnInput->False], True->
                    FrameBox[
                    
                    StyleBox["\<\"# OPF Main Framework Package and Test \
Notebook\\n\\nThis notebook creates a Wolfram Language package, loads it, \
runs a full symbolic and numeric test pipeline, and prints real computed \
results with visuals.\\n\\n## 1. Create the package file\\n\\nEvaluate this \
cell first.\\n\\n```wl\\nopfPackageText = \
StringRiffle[{\\n\\\"BeginPackage[\\\\\\\"OPFFramework`\\\\\\\"]\\\",\\n\\\"\\\
\",\\n\\\"opfAction::usage = \\\\\\\"opfAction[rho, chi, res, coords] gives \
the OPF action density integral \
form.\\\\\\\";\\\",\\n\\\"opfEulerEquations::usage = \
\\\\\\\"opfEulerEquations[coords] returns Euler-Lagrange equations for rho, \
chi, res.\\\\\\\";\\\",\\n\\\"opfPotential::usage = \\\\\\\"opfPotential[rho, \
chi, res] gives the static OPF potential rho Log[chi] + chi res^2.\\\\\\\";\\\
\",\\n\\\"opfPotentialStationary::usage = \\\\\\\"opfPotentialStationary[] \
returns symbolic stationary \
conditions.\\\\\\\";\\\",\\n\\\"opfPotentialHessian::usage = \
\\\\\\\"opfPotentialHessian[rho0, chi0, res0] gives the Hessian matrix at a \
point.\\\\\\\";\\\",\\n\\\"opfLinearizedMatrix::usage = \
\\\\\\\"opfLinearizedMatrix[k2, params] gives a simple OPF linearized \
stiffness matrix.\\\\\\\";\\\",\\n\\\"opfDispersionPolynomial::usage = \\\\\\\
\"opfDispersionPolynomial[k2, params] gives Det of the stiffness \
matrix.\\\\\\\";\\\",\\n\\\"opfDispersionRoots::usage = \
\\\\\\\"opfDispersionRoots[params] solves the dispersion polynomial.\\\\\\\";\
\\\",\\n\\\"opfMeasurementKernel::usage = \\\\\\\"opfMeasurementKernel[psi, \
vars, ranges] numerically integrates a supplied field over ranges.\\\\\\\";\\\
\",\\n\\\"opfMeasurementMap::usage = \\\\\\\"opfMeasurementMap[rho, eps] \
gives eps Sin[rho].\\\\\\\";\\\",\\n\\\"opfMeasurementIterate::usage = \\\\\\\
\"opfMeasurementIterate[rho0, eps, n] iterates the OPF self-measurement map \
and returns states and \
residuals.\\\\\\\";\\\",\\n\\\"opfThermalMassSquared::usage = \
\\\\\\\"opfThermalMassSquared[temp, m0sq, c] gives m0sq + c \
temp^2.\\\\\\\";\\\",\\n\\\"opfScaleTemperature::usage = \
\\\\\\\"opfScaleTemperature[n] gives Planck temperature scaled by \
GoldenRatio^-n.\\\\\\\";\\\",\\n\\\"opfScaleDensity::usage = \
\\\\\\\"opfScaleDensity[n] gives Planck density scaled by GoldenRatio^(-4 n).\
\\\\\\\";\\\",\\n\\\"opfFullPipeline::usage = \\\\\\\"opfFullPipeline[] \
returns an association with symbolic and numeric OPF test results.\\\\\\\";\\\
\",\\n\\\"\\\",\\n\\\"Begin[\\\\\\\"`Private`\\\\\\\"]\\\",\\n\\\"\\\",\\n\\\"\
$Assumptions = Element[{x, y, z, t, k2, rho0, chi0, res0, eps, m0sq, c, \
temp}, Reals] && chi0 > 0;\\\",\\n\\\"\\\",\\n\\\"planckTemperature = \
QuantityMagnitude @ UnitConvert[Quantity[1.416784*^32, \
\\\\\\\"Kelvins\\\\\\\"], \\\\\\\"Kelvins\\\\\\\"];\\\",\\n\\\"planckDensity \
= 5.155*^96;\\\",\\n\\\"goldenRatio = \
GoldenRatio;\\\",\\n\\\"\\\",\\n\\\"opfPotential[rho_, chi_, res_] := rho \
Log[chi] + chi res^2 /; chi > 0\\\",\\n\\\"\\\",\\n\\\"opfAction[rho_, chi_, \
res_, coords_: {x, y, z, t}] := \\\",\\n\\\"  Integrate[rho @@ coords Log[chi \
@@ coords] + (chi @@ coords) (res @@ coords)^2, Sequence @@ ({#, -Infinity, \
Infinity} & /@ coords)];\\\",\\n\\\"\\\",\\n\\\"opfEulerEquations[coords_: \
{x, y, z, t}] := Module[{rho, chi, res, lag},\\\",\\n\\\"  lag = rho @@ \
coords Log[chi @@ coords] + (chi @@ coords) (res @@ coords)^2;\\\",\\n\\\"  \
<|\\\",\\n\\\"    \\\\\\\"RhoEquation\\\\\\\" -> FullSimplify @ \
VariationalD[lag, rho @@ coords, coords],\\\",\\n\\\"    \
\\\\\\\"ChiEquation\\\\\\\" -> FullSimplify @ VariationalD[lag, chi @@ \
coords, coords],\\\",\\n\\\"    \\\\\\\"ResEquation\\\\\\\" -> FullSimplify @ \
VariationalD[lag, res @@ coords, coords]\\\",\\n\\\"  \
|>\\\",\\n\\\"\\\"];\\\",\\n\\\"\\\",\\n\\\"opfPotentialStationary[] := \
FullSimplify @ Thread[Grad[rho Log[chi] + chi res^2, {rho, chi, res}] == 0, \
chi > 0] /. {rho -> rho0, chi -> chi0, res -> \
res0}\\\",\\n\\\"\\\",\\n\\\"opfPotentialHessian[rhoVal_, chiVal_, resVal_] \
:= Module[{vars, h},\\\",\\n\\\"  vars = {rho, chi, res};\\\",\\n\\\"  h = \
D[rho Log[chi] + chi res^2, {{vars, 2}}];\\\",\\n\\\"  FullSimplify[h /. {rho \
-> rhoVal, chi -> chiVal, res -> resVal}, chiVal > \
0]\\\",\\n\\\"\\\"];\\\",\\n\\\"\\\",\\n\\\"opfLinearizedMatrix[k2_, \
params_Association] := Module[\\\",\\n\\\"  {alpha, beta, mu, sigma, lambda, \
eta, rhoBack, chiBack, resBack},\\\",\\n\\\"  {alpha, beta, mu, sigma, \
lambda, eta, rhoBack, chiBack, resBack} = Lookup[params, {\\\\\\\"Alpha\\\\\\\
\", \\\\\\\"Beta\\\\\\\", \\\\\\\"Mu\\\\\\\", \\\\\\\"Sigma\\\\\\\", \
\\\\\\\"Lambda\\\\\\\", \\\\\\\"Eta\\\\\\\", \\\\\\\"Rho0\\\\\\\", \
\\\\\\\"Chi0\\\\\\\", \\\\\\\"Res0\\\\\\\"}];\\\",\\n\\\"  {\\\",\\n\\\"    \
{alpha k2, -1/chiBack, 0, eta},\\\",\\n\\\"    {-1/chiBack, beta k2 + \
rhoBack/chiBack^2 + resBack^2, 2 resBack, 0},\\\",\\n\\\"    {0, 2 resBack, \
mu k2 + 2 chiBack, 0},\\\",\\n\\\"    {eta, 0, 0, sigma k2 - \
lambda}\\\",\\n\\\"  \
}\\\",\\n\\\"\\\"];\\\",\\n\\\"\\\",\\n\\\"opfDispersionPolynomial[k2_, \
params_Association] := FullSimplify[Det[opfLinearizedMatrix[k2, \
params]]];\\\",\\n\\\"\\\",\\n\\\"opfDispersionRoots[params_Association] := \
Module[{poly},\\\",\\n\\\"  poly = Together[opfDispersionPolynomial[k2, \
params]];\\\",\\n\\\"  k2 /. Solve[poly == 0, k2, \
Reals]\\\",\\n\\\"\\\"];\\\",\\n\\\"\\\",\\n\\\"opfMeasurementKernel[psi_, \
vars_List, ranges_List] := NIntegrate[Evaluate[psi], Sequence @@ \
MapThread[List, {vars, ranges[[All, 1]], ranges[[All, 2]]}], WorkingPrecision \
-> 50, AccuracyGoal -> 30, PrecisionGoal -> \
30];\\\",\\n\\\"\\\",\\n\\\"opfMeasurementMap[rho_, eps_: 3/2] := eps \
Sin[rho]\\\",\\n\\\"\\\",\\n\\\"opfMeasurementIterate[rho0_, eps_: 3/2, n_: \
40] := Module[{states},\\\",\\n\\\"  states = NestList[opfMeasurementMap[#, \
eps] &, N[rho0, 50], n];\\\",\\n\\\"  <|\\\",\\n\\\"    \
\\\\\\\"States\\\\\\\" -> states,\\\",\\n\\\"    \\\\\\\"Residuals\\\\\\\" -> \
Abs[Differences[states]],\\\",\\n\\\"    \\\\\\\"FixedPointEstimate\\\\\\\" \
-> Last[states]\\\",\\n\\\"  \
|>\\\",\\n\\\"\\\"];\\\",\\n\\\"\\\",\\n\\\"opfThermalMassSquared[temp_, \
m0sq_ : -2, c_ : 1] := m0sq + c \
temp^2\\\",\\n\\\"\\\",\\n\\\"opfScaleTemperature[n_] := planckTemperature \
goldenRatio^-n\\\",\\n\\\"opfScaleDensity[n_] := planckDensity \
goldenRatio^(-4 n)\\\",\\n\\\"\\\",\\n\\\"opfFullPipeline[] := \
Module[\\\",\\n\\\"  {euler, stationary, hessianAtTest, params, poly, roots, \
iter, tc, scales, kernelValue},\\\",\\n\\\"  euler = \
opfEulerEquations[];\\\",\\n\\\"  stationary = opfPotentialStationary[];\\\",\
\\n\\\"  hessianAtTest = opfPotentialHessian[1, E, 0];\\\",\\n\\\"  params = \
<|\\\\\\\"Alpha\\\\\\\" -> 1, \\\\\\\"Beta\\\\\\\" -> 1, \\\\\\\"Mu\\\\\\\" \
-> 1, \\\\\\\"Sigma\\\\\\\" -> 1, \\\\\\\"Lambda\\\\\\\" -> 2, \
\\\\\\\"Eta\\\\\\\" -> 1/2, \\\\\\\"Rho0\\\\\\\" -> 0, \\\\\\\"Chi0\\\\\\\" \
-> 1, \\\\\\\"Res0\\\\\\\" -> 1/10|>;\\\",\\n\\\"  poly = \
Expand[opfDispersionPolynomial[k2, params]];\\\",\\n\\\"  roots = k2 /. \
NSolve[poly == 0, k2, WorkingPrecision -> 50];\\\",\\n\\\"  iter = \
opfMeasurementIterate[1/10, 3/2, 40];\\\",\\n\\\"  tc = Sqrt[2];\\\",\\n\\\"  \
scales = Table[{n, opfScaleTemperature[n], opfScaleDensity[n]}, {n, -3, \
6}];\\\",\\n\\\"  kernelValue = opfMeasurementKernel[Exp[-(x^2 + y^2)], {x, \
y}, {{-3, 3}, {-3, 3}}];\\\",\\n\\\"  <|\\\",\\n\\\"    \
\\\\\\\"EulerEquations\\\\\\\" -> euler,\\\",\\n\\\"    \
\\\\\\\"StationaryConditions\\\\\\\" -> stationary,\\\",\\n\\\"    \
\\\\\\\"HessianAtRho1ChiE\\\\\\\" -> hessianAtTest,\\\",\\n\\\"    \
\\\\\\\"DispersionPolynomial\\\\\\\" -> poly,\\\",\\n\\\"    \
\\\\\\\"DispersionRoots\\\\\\\" -> roots,\\\",\\n\\\"    \
\\\\\\\"MeasurementIteration\\\\\\\" -> iter,\\\",\\n\\\"    \
\\\\\\\"CriticalTemperature\\\\\\\" -> tc,\\\",\\n\\\"    \
\\\\\\\"ScaleTable\\\\\\\" -> scales,\\\",\\n\\\"    \
\\\\\\\"MeasurementKernelValue\\\\\\\" -> kernelValue\\\",\\n\\\"  |>\\\",\\n\
\\\"\\\"];\\\",\\n\\\"\\\",\\n\\\"End[]\\\",\\n\\\"EndPackage[]\\\"\\n}, \\\"\
\\\\n\\\"];\\n\\nopfPackagePath = FileNameJoin[{NotebookDirectory[], \
\\\"OPFFramework.wl\\\"}];\\nExport[opfPackagePath, opfPackageText, \
\\\"String\\\"]\\n```\\n\\n## 2. Load the \
package\\n\\n```wl\\nGet[opfPackagePath]\\n```\\n\\n## 3. Run the complete \
framework evaluation\\n\\n```wl\\nresults = \
