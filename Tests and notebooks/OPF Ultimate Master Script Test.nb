Cell["We linearize around a symbolic background: ", "CodeText",ExpressionUUID->"f2f7455e-accb-2641-b397-161fbd3f1701"],

Cell[BoxData[
 RowBox[{
  RowBox[{"linRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\[Rho]", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
