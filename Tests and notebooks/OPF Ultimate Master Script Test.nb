Cell[CellGroupData[{

Cell["0. Review Summary: What Is Valid vs Not Yet Established", "Section",ExpressionUUID->"cd644a78-4bbb-b84a-b282-a0f1ca4f6dcc"],

Cell[CellGroupData[{

Cell["What is mathematically valid to test", "Subsection",ExpressionUUID->"62a6848d-d3a6-4743-bc03-a01a90938e0e"],

Cell["Given a Lagrangian density of the form ", "Text",ExpressionUUID->"b62fbac0-5994-f844-b8cf-a9063fb9c8af"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$HistoryLength", "=", "0"}], ";"}]}], "Input",
 CellLabel->
  "In[225]:=",ExpressionUUID->"c4e832af-2395-4148-b324-e6327c95a539"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coords4", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spatialCoords", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}]}], "Input",
 CellLabel->
  "In[227]:=",ExpressionUUID->"7902c585-a821-8e46-8361-27e2c85d88f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lagrangianCandidate", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Alpha]", "/", "2"}], " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "c"}], 
         "]"}], "^", "2"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "coords4"}], "}"}]}], "]"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\[Beta]", "/", "2"}], " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Chi]", "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "c"}], 
         "]"}], "^", "2"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "coords4"}], "}"}]}], "]"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\[Mu]", "/", "2"}], " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "c"}], 
         "]"}], "^", "2"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "coords4"}], "}"}]}], "]"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\[Sigma]", "/", "2"}], " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"s", "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "c"}], 
         "]"}], "^", "2"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "coords4"}], "}"}]}], "]"}]}], "-", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"(", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], " ", 
       RowBox[{"Log", "[", 
        RowBox[{"\[Chi]", "[", 
         RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "]"}]}], "+", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"\[Chi]", "[", 
        RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], " ", 
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "^", "2"}]}], "+",
       "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"\[Lambda]", "/", "2"}], " ", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "^", "2"}]}], "-",
       "\[IndentingNewLine]", "    ", 
      RowBox[{"\[Eta]", " ", 
       RowBox[{"s", "[", 
        RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], " ", 
       RowBox[{"\[Rho]", "[", 
        RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}]}], 
     "\[IndentingNewLine]", "  ", ")"}], "+", 
    RowBox[{"Jobs", " ", 
     RowBox[{"s", "[", 
      RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}]}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[229]:=",ExpressionUUID->"725ad0fa-83b4-2144-871c-3f5ca6baa8a5"],

Cell["you can rigorously test: ", "Text",ExpressionUUID->"4222704f-c14d-ff47-bcaa-5884c9252088"],

Cell["Euler\[Dash]Lagrange equations", "Item",ExpressionUUID->"537dd347-ede2-d043-8441-cda8c0e1bcc2"],

Cell["constant-background existence conditions", "Item",ExpressionUUID->"1413306a-3b71-de4f-bb85-be9f4037da64"],

Cell["linearization around a background", "Item",ExpressionUUID->"7a501f15-71ce-2348-b522-8582c7f61ce9"],

Cell["dispersion relations", "Item",ExpressionUUID->"08eb4085-11c5-d74e-8c77-512bac84eab5"],

Cell["whether a mode is massless or massive", "Item",ExpressionUUID->"8d09ed3a-313c-2045-bfe6-edb0f599fb03"],

Cell["whether propagation is hyperbolic/elliptic/unstable", "Item",ExpressionUUID->"febf5072-4164-274b-ade2-fe7a1c8ce34d"],

Cell["whether a finite-domain PDE has stable eigenmodes", "Item",ExpressionUUID->"c85e877a-7fe3-ca46-bc56-14f37831c5bf"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "What is ",
 StyleBox["not",
  FontWeight->Bold],
 " established by the equations alone"
}], "Subsection",ExpressionUUID->"e7949475-3d56-254b-a197-bed5f5188300"],

Cell[TextData[{
 "The following are ",
 StyleBox["interpretive hypotheses",
  FontWeight->Bold],
 ", not derived facts: "
}], "Text",ExpressionUUID->"b565b78b-3666-8240-9332-efc3c57413ed"],

Cell[TextData[{
 StyleBox["\[Rho]", "TI"],
 " = thoughts"
}], "Item",ExpressionUUID->"e42953dc-c52f-f240-ab03-10a263d461b6"],

Cell[TextData[{
 StyleBox["r", "TI"],
 " = light"
}], "Item",ExpressionUUID->"fc68a3e5-d813-084d-9026-31f2be40607a"],

Cell[TextData[{
 StyleBox["\[Chi]", "TI"],
 " = sound/mechanical vibration"
}], "Item",ExpressionUUID->"f07f3942-3c5e-b748-9574-6dc5add6e9a1"],

Cell[TextData[{
 StyleBox["s", "TI"],
 " = consciousness"
}], "Item",ExpressionUUID->"b6511306-ba98-ce4a-882c-b7d12da393b6"],

Cell[TextData[{
 StyleBox["c", "TI"],
 " = CFL speed of a lattice"
}], "Item",ExpressionUUID->"4a01bcfb-6cc0-e04b-9301-acaaa6d318b4"],

Cell["\[OpenCurlyDoubleQuote]observer source\[CloseCurlyDoubleQuote] as \
physical consciousness", "Item",ExpressionUUID->"43101c96-ccee-1643-898e-\
17afa64596f2"],

Cell[TextData[{
 "Those claims require ",
 StyleBox["extra predictive evidence",
  FontWeight->Bold],
 ", not just symbolic resemblance. "
}], "Text",ExpressionUUID->"1a517a6e-3e20-f941-b6ca-78b04ee9e3b8"],

