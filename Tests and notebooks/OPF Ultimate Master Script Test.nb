Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"classifyBranch", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"e", "=", 
       RowBox[{"FullSimplify", "[", "expr", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Which", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"FreeQ", "[", 
        RowBox[{"e", ",", 
         RowBox[{"kx", " ", "|", " ", "ky", " ", "|", " ", "kz"}]}], "]"}], 
       ",", "\"\<Pure gap / mass-only branch\>\"", ",", "\[IndentingNewLine]",
        "   ", 
       RowBox[{"MatchQ", "[", 
        RowBox[{"e", ",", "kSq"}], "]"}], ",", "\"\<Massless branch\>\"", ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"MatchQ", "[", 
        RowBox[{"e", ",", 
         RowBox[{"kSq", "+", "_"}]}], "]"}], 
       ",", "\"\<Massive relativistic-like branch\>\"", ",", 
       "\[IndentingNewLine]", "   ", "True", 
       ",", "\"\<Mixed / coupled branch\>\""}], "\[IndentingNewLine]", "   ", 
      "]"}]}], "\[IndentingNewLine]", "  ", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[300]:=",ExpressionUUID->"863bebe4-42cd-7f47-900a-105ab17207be"],

