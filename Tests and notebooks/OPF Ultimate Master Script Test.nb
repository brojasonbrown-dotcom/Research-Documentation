Cell[CellGroupData[{

Cell["8. Plane-Wave Reduction and Stiffness Matrix", "Section",ExpressionUUID->"815ee1a6-b354-fb41-bc36-1e415ac66bdf"],

Cell["\<\
This is the proper place to ask whether there are massless or massive \
branches. \
