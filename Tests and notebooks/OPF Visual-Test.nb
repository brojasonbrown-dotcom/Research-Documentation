}, Open  ]],

Cell[CellGroupData[{

Cell["15. Suggested next refinements", "Section",ExpressionUUID->"f289bd0e-baad-4d43-a2af-4c0d9b36f314"],

Cell[CellGroupData[{

Cell["Mathematical", "Subsection",ExpressionUUID->"0ede3e00-307b-f543-80dd-ebeda6d181ec"],

Cell["\<\
Replace heuristic boundedness tests with formal coercivity conditions where \
possible.\
\>", "Item",ExpressionUUID->"8e082b9e-1c2b-354f-8b91-6a21bdcf034d"],

Cell["\<\
Compute exact Hessian signatures symbolically for parameter regions.\
\>", "Item",ExpressionUUID->"d819cf6f-32ba-d94a-a9b4-a6516ac2ee4f"],

Cell["\<\
Derive the full linearized PDE operator around each admissible background.\
\>", "Item",ExpressionUUID->"c46e4647-b2e5-5241-9377-a80671e7ed80"],

Cell[TextData[{
 "Use ",
 ButtonBox["DEigensystem",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/DEigensystem"],
 " for exact cases and ",
 ButtonBox["NDEigensystem",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NDEigensystem"],
 " for numerical ones."
}], "Item",ExpressionUUID->"375d0b40-c06e-5842-873f-6dbc940677de"],

Cell[TextData[{
 "For periodic scale sectors, consider ",
 ButtonBox["PeriodicBoundaryCondition",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/PeriodicBoundaryCondition"],
 "."
}], "Item",ExpressionUUID->"8dd81c6d-3009-fb48-8181-71f24497f64c"],

Cell[TextData[{
 "Use mesh-refinement studies because eigenvalues depend on discretization; \
see ",
 ButtonBox["NDEigenvalues",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NDEigenvalues"],
 " and ",
 ButtonBox["NDEigensystem",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/NDEigensystem"],
 "."
}], "Item",ExpressionUUID->"326d2fae-f7e1-8e47-b71e-1cf535981a6e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Numerical", "Subsection",ExpressionUUID->"ecd40ba7-6f92-6543-a7ba-3e60d7f0ddde"],

Cell["\<\
Add mesh refinement and convergence plots for every PDE eigenvalue claim.\
\>", "Item",ExpressionUUID->"f3c16787-0664-ef4e-8cc9-7aed4dba2cd9"],

Cell["Add deterministic seeds and regression baselines.", "Item",ExpressionUUID->"7ff648a9-7228-0141-b828-50126838be2e"],

Cell["\<\
Store candidate-scan results as datasets with reproducible metadata.\
\>", "Item",ExpressionUUID->"edb64e18-314e-e149-9e09-2fa3fda96dd6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Conceptual", "Subsection",ExpressionUUID->"e6da7f31-1a1e-664f-b26c-e7bacdf6c0c4"],

Cell["Separate \[OpenCurlyDoubleQuote]OPF axioms\[CloseCurlyDoubleQuote] from \
\[OpenCurlyDoubleQuote]testable surrogate models\[CloseCurlyDoubleQuote].", \
"Item",ExpressionUUID->"d30a030b-efce-1c45-ad5a-8ee82fcd41bd"],

Cell["\<\
Explicitly label metaphysical interpretation as interpretation.\
\>", "Item",ExpressionUUID->"ae83d6d1-8fa7-a446-8e9f-6b6089e10bc6"],

Cell["\<\
Avoid claiming physical significance for ratio matches without null-model \
comparison.\
\>", "Item",ExpressionUUID->"f1832842-2bb2-354c-8025-f7e369249d1e"],

