Cell[CellGroupData[{

Cell["2. Clean initialization", "Section",ExpressionUUID->"9a67dc6d-0028-b640-b5de-d6a1981e3b07"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", "\"\<Global`VariationalD\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", 
    RowBox[{"And", " ", "@@", " ", 
     RowBox[{"{", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"alpha", ">", "0"}], ",", 
       RowBox[{"beta", ">", "0"}], ",", 
       RowBox[{"gamma", ">", "0"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"eta", ">", "0"}], ",", 
       RowBox[{"zeta", ">", "0"}], ",", 
       RowBox[{"xi", ">", "0"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"Element", "[", 
        RowBox[{
         RowBox[{"delta", " ", "|", " ", "lambda"}], ",", "Reals"}], "]"}], ",",
        "\[IndentingNewLine]", "   ", 
       RowBox[{"Element", "[", 
        RowBox[{
         RowBox[{"x", " ", "|", " ", "sigma"}], ",", "Reals"}], "]"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"phi", ">", "1"}]}], "\[IndentingNewLine]", "}"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<VariationalMethods`\>\"", "]"}], ";"}]}], "Input",\
ExpressionUUID->"763e149a-e018-a342-9c02-c87cda229720"],

Cell[CellGroupData[{

Cell["Regression checks", "Subsection",ExpressionUUID->"fcdef0d7-62fb-a445-a75a-b0a5effa9e1d"],

Cell[BoxData[
 RowBox[{"{", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Context", "[", "VariationalD", "]"}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"MemberQ", "[", 
    RowBox[{
     RowBox[{"Names", "[", "\"\<Global`*\>\"", "]"}], 
     ",", "\"\<VariationalD\>\""}], "]"}]}], "\[IndentingNewLine]", 
  "}"}]], "Input",ExpressionUUID->"cc83c80e-171d-4d47-bfdf-a980b682308a"],

Cell["Expected: ", "Text",ExpressionUUID->"098a80cf-79df-9f40-ae92-432bc8ae6830"],

Cell[TextData[{
 Cell[BoxData[Cell["VariationalD",
   Background->None,ExpressionUUID->"4551be5a-c1b8-0e4a-9a13-d09336e5aeda"]], 
