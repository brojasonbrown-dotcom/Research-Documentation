Cell[CellGroupData[{

Cell["\<\
14. What these objects actually are, in rigorous modeling terms\
\>", "Section",ExpressionUUID->"803ead9b-6a0f-bf45-9dfe-d9e501c2f141"],

Cell["Within this notebook, the main objects are: ", "Text",ExpressionUUID->"c9c707dd-b18a-294f-b109-136cbab24cfa"],

Cell[TextData[{
 Cell[BoxData[Cell["rho[x,sigma]",
   Background->None,ExpressionUUID->"164b89ec-2599-9947-bf62-24423765e846"]], 
  "InlineCode",ExpressionUUID->"15297879-fb53-ee41-930a-4a58b330e720"],
 ": a scalar field chosen to represent information density."
}], "Item",ExpressionUUID->"ee9a8a14-6bc8-4649-9c67-9377b2d5b222"],

Cell[TextData[{
 Cell[BoxData[Cell["chi[x,sigma]",
   Background->None,ExpressionUUID->"8ba65250-9a0f-fc48-9aa0-3fbb8cf605b5"]], 
  "InlineCode",ExpressionUUID->"30d28034-83ac-9c45-baf5-17fec6addafa"],
 ": a positive scalar field chosen to represent complexity."
}], "Item",ExpressionUUID->"c64d0fc9-e71f-a143-8dfd-ec0d3cc107b7"],

Cell[TextData[{
 Cell[BoxData[Cell["res[x,sigma]",
   Background->None,ExpressionUUID->"bb5eb319-7beb-7546-9274-d4082032c354"]], 
  "InlineCode",ExpressionUUID->"9dd7904c-20f8-4a4e-b0de-0c125d92df97"],
 ": a scalar field chosen to represent observational resolution."
}], "Item",ExpressionUUID->"bc8a3d18-fa2e-2a4c-98b7-a3d9450eb95f"],

Cell[TextData[{
 Cell[BoxData[Cell["lagrangianDensity",
   Background->None,ExpressionUUID->"171ffa3b-3a77-f740-9862-67e217a9bda6"]], 
  "InlineCode",ExpressionUUID->"d3cc6b5c-2204-7845-9d24-a492d13395ee"],
 ": a symbolic functional density encoding the model\[CloseCurlyQuote]s \
couplings and regularization."
}], "Item",ExpressionUUID->"8aa0ce1b-337d-7948-81aa-ad5ffc434663"],

Cell[TextData[{
 Cell[BoxData[Cell["fieldEquations",
   Background->None,ExpressionUUID->"c04774ec-a2a2-5943-a690-ca6bd26b12e4"]], 
  "InlineCode",ExpressionUUID->"f1224f74-84c2-6348-a40b-3e5e1e3b6f85"],
 ": Euler\[Dash]Lagrange equations of that chosen functional."
}], "Item",ExpressionUUID->"a8b40583-958b-574c-bf1b-e48a21eb0c32"],

Cell[TextData[{
 Cell[BoxData[Cell["fixedPoints",
   Background->None,ExpressionUUID->"a7319b83-0f5c-1e44-b5c7-f87ed1bd494a"]], 
  "InlineCode",ExpressionUUID->"8f37bb8f-3c81-f64e-b0b4-0f38147ed7be"],
 ": constant solutions of the stationarity conditions."
}], "Item",ExpressionUUID->"80beb050-3998-644a-9f02-ff3a3201b9bc"],

Cell[TextData[{
 Cell[BoxData[Cell["kernelMatrix",
   Background->None,ExpressionUUID->"02828fee-f75d-b64f-9709-3c9f24e466b1"]], 
  "InlineCode",ExpressionUUID->"9ae2bdc4-8847-ad40-89ea-f670089e1d17"],
 ": a discretized compact operator used as a probe of self-consistent mode \
selection."
}], "Item",ExpressionUUID->"dc56c403-f94f-c54b-be7d-2673f7a4ad7f"],

Cell["That is their rigorous status here.", "Text",ExpressionUUID->"9155599d-01b7-a446-bdfc-09c9104547e9"],

Cell["Anything beyond that requires either: ", "Text",ExpressionUUID->"86fd3617-bb26-114f-aca8-ad3a4c64565b"],

Cell["empirical identification,", "Item",ExpressionUUID->"7af41dd3-aacf-8e43-91d2-b320133ab0b7"],

Cell["derivation from accepted theory,", "Item",ExpressionUUID->"616eb00b-cc75-aa4e-8a6b-39dff1527865"],

Cell["or new experimental evidence.", "Item",ExpressionUUID->"d295828f-fe9a-db48-b363-1c9d9feed15d"],

