Cell[CellGroupData[{

Cell["6. Effective potential diagnostics", "Section",ExpressionUUID->"8ffa1698-c38a-2340-b117-ed4eb6e51e36"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"potential", "[", 
     RowBox[{"rhoVar_", ",", "chiVar_", ",", "resVar_"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"rhoVar", " ", 
      RowBox[{"Log", "[", "chiVar", "]"}]}], "+", 
     RowBox[{"chiVar", " ", 
      RowBox[{"resVar", "^", "2"}]}], "+", 
     RowBox[{"delta", " ", "rhoVar", " ", "chiVar", " ", "resVar"}], "+", 
     RowBox[{"lambda", " ", 
      RowBox[{"rhoVar", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hessian", "=", 
    RowBox[{
     RowBox[{"D", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"potential", "[", 
        RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "]"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "}"}], ",", "2"}],
         "}"}]}], "\[IndentingNewLine]", "]"}], " ", "//", " ", 
     "FullSimplify"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hessianAtFixedPoints", "=", 
   RowBox[{"hessian", " ", "/.", " ", "fixedPointRules"}]}], ";"}]}], "Input",\
ExpressionUUID->"05d2e2c2-e91d-3243-a168-74f8be9b7a1f"],

Cell[CellGroupData[{

Cell["Stationary-point classification helper", "Subsection",ExpressionUUID->"fbe98def-2b5c-5141-9e13-48a91fe9e178"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"classifyStationaryPoint", "[", "rules_", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"mat", ",", "eigs"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"mat", "=", 
        RowBox[{"hessian", " ", "/.", " ", "rules"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"eigs", "=", 
        RowBox[{
         RowBox[{"Eigenvalues", "[", "mat", "]"}], " ", "//", " ", 
         "FullSimplify"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Point\>\"", "->", "rules"}], ",", "\[IndentingNewLine]",
          "    ", 
         RowBox[{"\"\<Hessian\>\"", "->", "mat"}], ",", "\[IndentingNewLine]",
          "    ", 
         RowBox[{"\"\<Eigenvalues\>\"", "->", "eigs"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<PositiveSemidefiniteQ\>\"", "->", 
          RowBox[{"Simplify", "[", 
           RowBox[{"And", " ", "@@", " ", 
            RowBox[{"Thread", "[", 
             RowBox[{"eigs", ">=", "0"}], "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<PositiveDefiniteQ\>\"", "->", 
          RowBox[{"Simplify", "[", 
           RowBox[{"And", " ", "@@", " ", 
            RowBox[{"Thread", "[", 
             RowBox[{"eigs", ">", "0"}], "]"}]}], "]"}]}]}], 
        "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stationaryClassification", "=", 
   RowBox[{"classifyStationaryPoint", " ", "/@", " ", "fixedPointRules"}]}], 
  ";"}], "\[IndentingNewLine]", "stationaryClassification"}], "Input",Expressi\
onUUID->"07be084e-9732-fd4e-901c-e68a1363c81a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visual slices of the potential", "Subsection",ExpressionUUID->"1403acff-d167-1446-b220-8eece0419e4d"],

Cell["For concrete parameter choices: ", "CodeText",ExpressionUUID->"843dab40-6175-694f-8393-4157d3ed2d38"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"samplePars", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"delta", "->", 
       RowBox[{"1", "/", "2"}]}], ",", 
      RowBox[{"lambda", "->", "1"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ContourPlot", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"potential", "[", 
      RowBox[{"rhoVar", ",", "chiVar", ",", "0"}], "]"}], " ", "/.", " ", 
     "samplePars"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{"rhoVar", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"chiVar", ",", "0.05", ",", "3"}], "}"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotLegends", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<rho\>\"", ",", "\"\<chi\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",ExpressionUUID->"3bf03deb-b152-5b48-\
b869-31ddfdae1056"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "  ", 
