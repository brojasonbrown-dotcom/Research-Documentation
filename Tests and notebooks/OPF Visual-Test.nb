Cell[CellGroupData[{

Cell["16. PDE modal stability template", "Section",ExpressionUUID->"46497883-63c4-e64c-b548-0555993546d9"],

Cell["\<\
For a real spatial-domain model, build the linearized operator and test its \
spectrum carefully. \
\>", "Text",ExpressionUUID->"c6f0b1ce-0014-5f48-8d22-987877d17b1a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Placeholder", " ", "template", " ", "once", " ", "a", " ", "specific", " ",
     "background", " ", "is", " ", "chosen"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"linOp", "[", "u_", "]"}], ":=", 
     RowBox[{"-", 
      RowBox[{"Laplacian", "[", 
       RowBox[{
        RowBox[{"u", "[", "x", "]"}], ",", 
        RowBox[{"{", "x", "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"exactModes", "=", 
     RowBox[{"DEigensystem", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"linOp", "[", "u", "]"}], ",", 
         RowBox[{"DirichletCondition", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "x", "]"}], "==", "0"}], ",", "True"}], "]"}]}],
         "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"u", "[", "x", "]"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "Pi"}], "}"}], ",", "\[IndentingNewLine]",
        "  ", "4", ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"Method", "->", "\"\<Normalize\>\""}]}], "\[IndentingNewLine]",
       "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numericModesCoarse", "=", 
     RowBox[{"NDEigensystem", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"linOp", "[", "u", "]"}], ",", 
         RowBox[{"DirichletCondition", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "x", "]"}], "==", "0"}], ",", "True"}], "]"}]}],
         "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"u", "[", "x", "]"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "Pi"}], "}"}], ",", "\[IndentingNewLine]",
        "  ", "4"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numericModesFine", "=", 
     RowBox[{"NDEigensystem", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"linOp", "[", "u", "]"}], ",", 
         RowBox[{"DirichletCondition", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "[", "x", "]"}], "==", "0"}], ",", "True"}], "]"}]}],
         "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"u", "[", "x", "]"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "Pi"}], "}"}], ",", "\[IndentingNewLine]",
        "  ", "4", ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"Method", "->", 
        RowBox[{"{", "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<PDEDiscretization\>\"", "->", 
          RowBox[{"{", "\[IndentingNewLine]", "      ", 
           
           RowBox[{"\"\<FiniteElement\>\"", ",", "\[IndentingNewLine]", 
            "      ", 
            RowBox[{"{", 
             RowBox[{"\"\<MeshOptions\>\"", "->", 
              RowBox[{"{", 
               RowBox[{"\"\<MaxCellMeasure\>\"", "->", "0.01"}], "}"}]}], 
             "}"}]}], "\[IndentingNewLine]", "    ", "}"}]}], 
         "\[IndentingNewLine]", "  ", "}"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}]}]}]], "Input",ExpressionUUID->"558eec50-ef38-4c49-b733-\
0f583e82dfe4"],

Cell["\<\
This is essential because discretization granularity changes eigenvalue \
accuracy. \
\>", "Text",ExpressionUUID->"f9032007-9972-e545-a0d5-9b9baf0ce9e8"],

