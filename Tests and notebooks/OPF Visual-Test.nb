Notebook[{

Cell[CellGroupData[{
Cell["Rigorous OPF Visual Testing Notebook", "Title",ExpressionUUID->"958b1979-e59e-3f43-9b64-2ecef383386c"],

Cell[TextData[{
 "This notebook restructures the supplied material into a ",
 StyleBox["verification-first test notebook",
  FontWeight->Bold],
 ". "
}], "Text",ExpressionUUID->"2afdda35-a094-2a42-abd1-fa0cdcc0cd23"],

Cell[CellGroupData[{

Cell["Important scientific status", "Section",ExpressionUUID->"3eeb7d62-0fec-8d49-a53a-ee97cdabaa17"],

Cell[TextData[{
 "The claims below are treated as ",
 StyleBox["hypotheses and computational constructions",
  FontWeight->Bold],
 ", not established physical law. The notebook is organized to distinguish:"
}], "Text",ExpressionUUID->"00d2e553-de30-6748-b09d-134b85ced458"],

Cell[TextData[{
 "1. ",
 StyleBox["Definitions",
  FontWeight->Bold],
 "2. ",
 StyleBox["Derived mathematics",
  FontWeight->Bold],
 "3. ",
 StyleBox["Internal consistency checks",
  FontWeight->Bold],
 "4. ",
 StyleBox["Numerical experiments",
  FontWeight->Bold],
 "5. ",
 StyleBox["Interpretive/speculative claims",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"0b039def-bf8f-a540-9d44-f52fc973c807"],

Cell[CellGroupData[{

Cell["\<\
please now take my visions and structures and create the ultime and most \
accurate and complete rigorous no mock no speculation notebook ,,truly \
professional ,,dont mention the prompt or instructions and follow truly \
precise professional mathematician approaches , produce the full and complete \
most rigorous notebook possible run many many different reviews and passes\
\>", "ChatInput",
