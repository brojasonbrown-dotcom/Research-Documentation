Cell[CellGroupData[{

Cell["11. Probe 3 rebuilt: self-measurement kernel", "Section",ExpressionUUID->"742e8b89-c2bf-1c49-a62e-0b15dc9e98e4"],

Cell["\<\
We define a deterministic integral-kernel operator and test fixed-point \
convergence. \
\>", "Text",ExpressionUUID->"e68fffd6-b337-e042-a5cc-43ce4cefc6ff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nGrid", "=", "128"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xGrid", "=", 
    RowBox[{"N", "@", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"0", ",", "10", ",", 
       RowBox[{"nGrid", "-", "1"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dx", "=", 
    RowBox[{
     RowBox[{"xGrid", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "-", 
     RowBox[{"xGrid", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"kernelMatrix", "[", 
     RowBox[{"theta_", ",", 
      RowBox[{"s_", ":", " ", "0.5"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"mat", ",", "lamMax"}], "}"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"mat", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"xGrid", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "-", 
                 RowBox[{"xGrid", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "^", "2"}]}], "/", 
             RowBox[{"(", 
              RowBox[{"2", " ", 
               RowBox[{"s", "^", "2"}]}], ")"}]}], "]"}], " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"theta", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"xGrid", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "-", 
               RowBox[{"xGrid", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"{", 
           RowBox[{"i", ",", "nGrid"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "nGrid"}], "}"}]}], "\[IndentingNewLine]", "  ", 
         "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"lamMax", "=", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"2", " ", "Pi"}], "]"}], " ", 
         RowBox[{"s", "/", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "2"}], " ", 
             RowBox[{"theta", "^", "2"}], " ", 
             RowBox[{"s", "^", "2"}]}], "]"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"dx", "/", "lamMax"}], ")"}], " ", "mat"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"powerIterate", "[", 
    RowBox[{"theta_", ",", 
     RowBox[{"s_", ":", " ", "0.5"}], ",", 
     RowBox[{"seed_", ":", " ", "7"}], ",", 
     RowBox[{"maxIter_", ":", " ", "400"}], ",", 
     RowBox[{"tol_", ":", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mat", ",", "psi", ",", "new", ",", "rng"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"rng", "=", 
       RowBox[{"SeedRandom", "[", "seed", "]"}]}], ";", "\[IndentingNewLine]",
       "  ", 
      RowBox[{"psi", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "nGrid"}], "]"}]}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"psi", "=", 
       RowBox[{"psi", "/", 
        RowBox[{"Norm", "[", "psi", "]"}]}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"mat", "=", 
       RowBox[{"kernelMatrix", "[", 
        RowBox[{"theta", ",", "s"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"new", "=", 
          RowBox[{"mat", ".", "psi"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"new", "=", 
          RowBox[{"new", "/", 
           RowBox[{"Norm", "[", "new", "]"}]}]}], ";", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"new", "-", "psi"}], "]"}], "<", "tol"}], ",", 
           RowBox[{
            RowBox[{"psi", "=", "new"}], ";", " ", 
            RowBox[{"Break", "[", "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"psi", "=", "new"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", "maxIter", "}"}]}], "\[IndentingNewLine]", "  ", "]"}], ";",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<State\>\"", "->", "psi"}], ",", 
        RowBox[{"\"\<Residual\>\"", "->", 
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"mat", ".", "psi"}], "-", "psi"}], "]"}]}], ",", 
        RowBox[{"\"\<Matrix\>\"", "->", "mat"}]}], "|>"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"521a9d0d-70bb-1945-82f4-8c8c929ab8e9"],

Cell[CellGroupData[{

Cell["Run deterministic tests", "Subsection",ExpressionUUID->"56953687-7239-c946-bd85-c36567f0afee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"thetaSet", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"3", ",", 
       RowBox[{"2", " ", "phiValue"}], ",", 
       RowBox[{"2", " ", 
        RowBox[{"Sqrt", "[", "2", "]"}]}]}], "}"}], ",", "30"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"probe3Runs", "=", 
   RowBox[{"AssociationMap", "[", 
    RowBox[{"powerIterate", ",", "thetaSet"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"probe3Residuals", "=", 
   RowBox[{"KeyValueMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#1", "->", 
       RowBox[{"#2", "[", "\"\<Residual\>\"", "]"}]}], " ", "&"}], ",", 
     "probe3Runs"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", "probe3Residuals"}], "Input",ExpressionUUID->\
"72036801-f5b3-fe4d-b449-759190bbba52"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visualize fixed-point states", "Subsection",ExpressionUUID->"9a857c31-0605-4d47-a508-9732380055df"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"KeyValueMap", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Tooltip", "[", 
       RowBox[{
        RowBox[{"#2", "[", "\"\<State\>\"", "]"}], ",", "#1"}], "]"}], " ", 
      "&"}], ",", "probe3Runs"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"ToString", " ", "/@", " ", 
       RowBox[{"Keys", "[", "probe3Runs", "]"}]}], ",", "Right"}], "]"}]}], ",",
    "\[IndentingNewLine]", "  ", 
   RowBox[{
   "PlotLabel", 
    "->", "\"\<Fixed-point candidates from kernel power iteration\>\""}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",ExpressionUUID->"aeb8697c-3132-8248-\
ae75-67a150b61da5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Discrete eigensystem cross-check", "Subsection",ExpressionUUID->"ad34ab01-dcc0-3045-9978-960b31928a2d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"thetaTest", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"2", " ", "phiValue"}], ",", "30"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"matTest", "=", 
   RowBox[{"kernelMatrix", "[", "thetaTest", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"valsTest", ",", "vecsTest"}], "}"}], "=", 
    RowBox[{"Eigensystem", "[", 
     RowBox[{"matTest", ",", "5"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Take", "[", 
  RowBox[{"valsTest", ",", "5"}], "]"}]}], "Input",ExpressionUUID->"ed64f001-\
6f0a-5145-9b15-862ccaa9f301"],

Cell["Interpretation note:", "Text",ExpressionUUID->"22df7ff0-3aca-594c-8055-4649a2eca4bd"],

Cell[TextData[{
 "This shows a numerical fixed point of a compact operator approximation. It \
does ",
 StyleBox["not",
  FontWeight->Bold],
 " establish that \[OpenCurlyDoubleQuote]information is energy\
\[CloseCurlyDoubleQuote] in the physical sense. It establishes only that a \
chosen operator has stable dominant modes. "
}], "Text",ExpressionUUID->"7b6f0987-1dc7-8449-a1b1-a85b43ddb78d"],

