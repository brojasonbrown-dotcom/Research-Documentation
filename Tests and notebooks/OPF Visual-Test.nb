Cell[CellGroupData[{

Cell["10. Probe 2 rebuilt: torus / Koopman / DMD test harness", "Section",ExpressionUUID->"b98d83b0-ae00-f740-92ef-3f1f52b9e040"],

Cell["\<\
This section tests whether two incommensurate oscillatory components can be \
robustly recovered from a deterministic trajectory. \
\>", "Text",ExpressionUUID->"2202d13a-9ba9-a348-8546-31982053fa18"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"phiValue", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"Sqrt", "[", "5", "]"}]}], ")"}], "/", "2"}], ",", "50"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"omega1", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"omega2", "=", "phiValue"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"signal", "[", "t_", "]"}], ":=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"omega1", " ", "t"}], "]"}], "+", 
       RowBox[{"0.15", " ", 
        RowBox[{"Cos", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"omega1", "+", "omega2"}], ")"}], " ", "t"}], "]"}]}]}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"omega2", " ", "t"}], "]"}], "+", 
       RowBox[{"0.15", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"omega1", "-", "omega2"}], ")"}], " ", "t"}], "]"}]}]}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ts", "=", 
   RowBox[{"N", "@", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "400", ",", "0.05"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"signal", " ", "/@", " ", "ts"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"ts", ",", 
      RowBox[{"data", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<x1(t)\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
   "PlotLabel", "->", "\"\<Incommensurate torus-like component\>\""}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",ExpressionUUID->"7721c4b1-5363-cc48-\
a485-c88f47b1dbdf"],

Cell[CellGroupData[{

Cell["Spectral recovery via Fourier baseline", "Subsection",ExpressionUUID->"5d786d5c-ae6a-ea49-801e-b56c783ceb8f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"freqSpectrum", "=", 
   RowBox[{"Abs", "[", 
    RowBox[{"Fourier", "[", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"frequencies", "=", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"Length", "[", "freqSpectrum", "]"}], "-", "1"}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Length", "[", "ts", "]"}], " ", "0.05"}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"frequencies", "[", 
       RowBox[{"[", 
        RowBox[{"1", " ", ";;", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"Length", "[", "frequencies", "]"}], "/", "8"}], "]"}]}], 
        "]"}], "]"}], ",", 
      RowBox[{"freqSpectrum", "[", 
       RowBox[{"[", 
        RowBox[{"1", " ", ";;", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"Length", "[", "freqSpectrum", "]"}], "/", "8"}], "]"}]}], 
        "]"}], "]"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<frequency\>\"", ",", "\"\<amplitude\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotLabel", "->", "\"\<Spectrum of probe-2 signal\>\""}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",ExpressionUUID->"836fec4e-00f9-af45-\
8787-8b28bdf070e0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Ratio check", "Subsection",ExpressionUUID->"d6cabade-0c61-2548-b056-792a45bab758"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"peakIndices", "=", 
   RowBox[{
    RowBox[{"Ordering", "[", 
     RowBox[{
      RowBox[{"freqSpectrum", "[", 
       RowBox[{"[", 
        RowBox[{"2", " ", ";;", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"Length", "[", "freqSpectrum", "]"}], "/", "8"}], "]"}]}], 
        "]"}], "]"}], ",", 
      RowBox[{"-", "6"}]}], "]"}], "+", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"peakFreqs", "=", 
   RowBox[{"Sort", "[", 
    RowBox[{"frequencies", "[", 
     RowBox[{"[", "peakIndices", "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", "peakFreqs"}], "Input",ExpressionUUID->\
"6ca6c69f-507d-1247-91ba-679183dc74b8"],

Cell["Interpretation note: ", "Text",ExpressionUUID->"c13ed300-a031-6a4d-b46c-8c7e119293f1"],

Cell["\<\
Recovery of near-golden ratios from a toroidal signal is a statement about \
the signal generator and spectral method.\
\>", "Item",ExpressionUUID->"a3ad658c-26f1-9844-a5a5-88ea631a4247"],

Cell[TextData[{
 "It is ",
 StyleBox["not by itself",
  FontWeight->Bold],
 " evidence that nature fundamentally prefers the golden ratio."
}], "Item",ExpressionUUID->"44952601-c4b2-6a4d-8efe-cd59ae5858de"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"873186b5-699c-134f-9d86-794d0b3572ff"]
}, Open  ]]
