Cell[CellGroupData[{

Cell["0. Design goals of this testing notebook", "Section",ExpressionUUID->"48a6d02c-971e-6d4a-a9ae-0f939d9ef651"],

Cell["This notebook is built to: ", "Text",ExpressionUUID->"189001f2-c5e0-bb4c-b4a1-361125f7fb03"],

Cell["correct technical issues in the original draft,", "Item",ExpressionUUID->"64d59c10-c976-ad43-be38-c0227fe7991d"],

Cell["prevent silent symbolic mistakes,", "Item",ExpressionUUID->"ac642fac-0bb0-4c48-aba5-9251ecbc3c3d"],

Cell["separate exact from numerical claims,", "Item",ExpressionUUID->"6ded7307-9935-5d43-96a1-f44d1eb13a4a"],

Cell["provide visual and regression tests,", "Item",ExpressionUUID->"b2d56d3b-ed26-4d46-b80c-a5c0805bc2d6"],

Cell["expose ambiguity and possible misunderstanding,", "Item",ExpressionUUID->"2ac546b5-5db3-2147-8f42-72dd2d79aa78"],

Cell["suggest a better structure for future development.", "Item",ExpressionUUID->"6862f818-6cc3-a74b-bd9b-a3538a95ca46"],

Cell[CellGroupData[{

Cell["Core evaluation questions", "Subsection",ExpressionUUID->"024dd401-d1d6-9c48-ab81-7567fe0909e1"],

Cell["Is the proposed action mathematically well-posed?", "Item",ExpressionUUID->"9d989c55-e5a0-6140-94d8-ae13c43f8bfd"],

Cell["Are the Euler\[Dash]Lagrange equations derived correctly?", "Item",ExpressionUUID->"30c35ce5-2f35-f14a-8c56-8ead23fa5c9a"],

Cell["Do fixed points actually exist under stated assumptions?", "Item",ExpressionUUID->"1c01971e-9b8f-4748-b57e-f8b0b9b30f34"],

Cell["Is the potential bounded below?", "Item",ExpressionUUID->"dda04dca-c828-a34c-b577-7ad71efa6bfc"],

Cell["\<\
Are candidate stationary points minima, saddles, or flat directions?\
\>", "Item",ExpressionUUID->"3a39caa1-3f72-a942-acd0-bcec344ebe17"],

Cell["Are scale-homogeneity claims true or only approximate?", "Item",ExpressionUUID->"65063a59-70fd-f544-9d13-205f0d6bc0c7"],

Cell["Are modal-stability results robust to discretization?", "Item",ExpressionUUID->"8c12fb90-965d-0548-8831-8c9dde321061"],

Cell["Are frequency-ratio claims genuine or artifacts of numerics?", "Item",ExpressionUUID->"579a3d3e-e587-3142-b2ad-da78de4dc8f5"],

Cell["\<\
Which statements are mathematics, which are modeling choices, and which are \
metaphysical interpretation?\
\>", "Item",ExpressionUUID->"968f03dc-5ec1-e248-863a-c0113290e829"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
