Cell[CellGroupData[{

Cell["4. Correct Euler\[Dash]Lagrange derivation", "Section",ExpressionUUID->"c615e771-6914-bc4d-a599-3bbcb84666d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eulerRho", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"VariationalD", "[", 
        RowBox[{"lagrangianDensity", ",", 
         RowBox[{"rho", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "domainAssumptions"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eulerChi", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"VariationalD", "[", 
        RowBox[{"lagrangianDensity", ",", 
         RowBox[{"chi", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "domainAssumptions"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eulerRes", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"VariationalD", "[", 
        RowBox[{"lagrangianDensity", ",", 
         RowBox[{"res", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "domainAssumptions"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fieldEquations", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eulerRho", ",", "eulerChi", ",", "eulerRes"}], "}"}], "==", 
     "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"fieldEquations", " ", "//", " ", "TableForm"}]}], "Input",Expression\
UUID->"7e7ef06b-1102-8842-9d7b-f306e03c44a2"],

Cell[CellGroupData[{

Cell["Independent manual cross-check", "Subsection",ExpressionUUID->"2322a016-20cd-0641-b75a-b03bb948cf0d"],

Cell["\<\
To guard against package misuse, compute the Euler\[Dash]Lagrange expressions \
manually: \
\>", "CodeText",ExpressionUUID->"df18ea8d-7e62-d042-abac-63d444347263"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"manualEL", "[", 
     RowBox[{"expr_", ",", "f_"}], "]"}], ":=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"expr", ",", "f"}], "]"}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"D", "[", 
            RowBox[{"f", ",", "x"}], "]"}]}], "]"}], ",", "x"}], "]"}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"D", "[", 
            RowBox[{"f", ",", "sigma"}], "]"}]}], "]"}], ",", "sigma"}], 
        "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "domainAssumptions"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"manualRho", "=", 
   RowBox[{"manualEL", "[", 
    RowBox[{"lagrangianDensity", ",", 
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"manualChi", "=", 
   RowBox[{"manualEL", "[", 
    RowBox[{"lagrangianDensity", ",", 
     RowBox[{"chi", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"manualRes", "=", 
    RowBox[{"manualEL", "[", 
     RowBox[{"lagrangianDensity", ",", 
      RowBox[{"res", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"crossCheckEL", "=", 
   RowBox[{"Simplify", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"eulerRho", "-", "manualRho"}], ",", 
        RowBox[{"eulerChi", "-", "manualChi"}], ",", 
        RowBox[{"eulerRes", "-", "manualRes"}]}], "}"}], "==", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", "\[IndentingNewLine]",
      "  ", 
     RowBox[{"Assumptions", "->", "domainAssumptions"}]}], 
    "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", "crossCheckEL"}], "Input",ExpressionUUID->\
"194d3932-fa4c-1e49-8681-01bc2278203b"],

Cell["Expected: ", "CodeText",ExpressionUUID->"4569b335-c529-154a-9170-67013990a238"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Input",ExpressionUUID->\
"b4d04cfd-74c2-4345-846b-1b130b490a9d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Why this matters", "Subsection",ExpressionUUID->"32830a3e-4c40-b749-b963-0b300694a7aa"],

Cell["The earlier notebook output ", "Text",ExpressionUUID->"09086f5d-4fa6-f24e-8b2b-cda128ca2c43"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Log", "[", 
   RowBox[{"chi", "[", 
    RowBox[{"x", ",", "sigma"}], "]"}], "]"}], "==", "0"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"res", "[", 
    RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}], "==", "0"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"chi", "[", 
    RowBox[{"x", ",", "sigma"}], "]"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"res", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}]}], "+", 
     RowBox[{"delta", " ", 
      RowBox[{"rho", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}]}]}], ")"}]}], "==", "0"}]}], "Input",\
ExpressionUUID->"0829fe03-9eae-d448-a63b-9bfba347cf3a"],

Cell[TextData[{
 "cannot be the full Euler\[Dash]Lagrange system for the stated Lagrangian, \
because the gradient terms and the ",
 Cell[BoxData[Cell["lambda rho^2",
   Background->None,ExpressionUUID->"e93a0b46-e236-ae40-a5b2-30b3bddaa3b6"]], 
  "InlineCode",ExpressionUUID->"2140c4cc-16e1-fe43-a922-fdf30c2bd5fb"],
 " term should contribute. This was a major correctness issue. "
}], "Text",ExpressionUUID->"71110fdd-bef4-6a49-a852-f3b48a88a6b5"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
