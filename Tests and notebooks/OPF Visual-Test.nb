Cell[CellGroupData[{

Cell["3. Exact definition of the scale-extended action density", "Section",ExpressionUUID->"e1abaed0-9788-c845-a7cd-23e9d6441bd2"],

Cell[TextData[{
 "We begin with the proposed Layer 1 extension: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", "\[Rho]", "log", "\[Chi]", "+", 
         "\[Chi] ", 
         StyleBox["r", "TI"], 
         StyleBox["e", "TI"], 
         SuperscriptBox[
          StyleBox["s", "TI"], "2"], "+", "\[Alpha]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", "\[Sigma]"], "\[Rho]"}], ")"}], 
          "2"], "+", "\[Beta]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", "\[Sigma]"], "\[Chi]"}], ")"}], 
          "2"], "+", "\[Gamma]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", "\[Sigma]"], 
              StyleBox["r", "TI"], 
              StyleBox["e", "TI"], 
              StyleBox["s", "TI"]}], ")"}], "2"], "+", "\[Eta]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", 
               StyleBox["x", "TI"]], "\[Rho]"}], ")"}], "2"], "+", "\[Zeta]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", 
               StyleBox["x", "TI"]], "\[Chi]"}], ")"}], "2"], "+", "\[Xi]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", 
               StyleBox["x", "TI"]], 
              StyleBox["r", "TI"], 
              StyleBox["e", "TI"], 
              StyleBox["s", "TI"]}], ")"}], "2"], "+", "\[Delta] ", "\[Rho] ",
          "\[Chi] ", 
         StyleBox["r", "TI"], 
         StyleBox["e", "TI"], 
         StyleBox["s", "TI"], "+", "\[Lambda] ", 
         SuperscriptBox["\[Rho]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{L} = \\rho \\log \\chi + \\chi \\, res^2 + \\alpha \
(\\partial_\\sigma \\rho)^2 + \\beta (\\partial_\\sigma \\chi)^2 + \\gamma \
(\\partial_\\sigma res)^2 + \\eta (\\partial_x \\rho)^2 + \\zeta (\\partial_x \
\\chi)^2 + \\xi (\\partial_x res)^2 + \\delta \\, \\rho \\, \\chi \\, res + \
\\lambda \\, \\rho^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "43501b38-c0aa-644c-83ce-bbce187e335a"]
}], "Text",ExpressionUUID->"664e88c2-6bb3-6b4a-83fb-68f17769191e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lagrangianDensity", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"chi", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], "]"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"chi", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{
      RowBox[{"res", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"alpha", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
      "2"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"beta", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"chi", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
      "2"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"gamma", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"res", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
      "2"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"eta", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", "2"}]}], 
    "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"zeta", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"chi", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", "2"}]}], 
    "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"xi", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"res", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", "2"}]}], 
    "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"delta", " ", 
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{"chi", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{"res", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"lambda", " ", 
     RowBox[{
      RowBox[{"rho", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}]}]}]}], ";"}]], "Input",E\
xpressionUUID->"c5ab1573-69be-da4e-8287-7e2f333b6dcb"],

Cell[CellGroupData[{

Cell["Domain sanity check", "Subsection",ExpressionUUID->"11e30cc8-d12c-2e40-aae6-c57ae58bd7e4"],

Cell[TextData[{
 "Because of ",
 Cell[BoxData[
  RowBox[{"Log", "[", 
   RowBox[{"chi", "[", 
    RowBox[{"x", ",", "sigma"}], "]"}], "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "fdb1f5d6-37ef-0842-997d-f78a8b516ca1"],
 ", the natural real-domain condition is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Chi]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", "\[Sigma]"}], ")"}], ">", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\chi(x,\\sigma) > 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5eecb906-e2a6-f043-8b25-0476de83f6db"],
 "We therefore define: "
}], "CodeText",ExpressionUUID->"9c16e630-6d18-4f4e-9d65-683f5fa48771"],

Cell[BoxData[
 RowBox[{
  RowBox[{"domainAssumptions", "=", 
   RowBox[{"$Assumptions", "&&", 
    RowBox[{
     RowBox[{"chi", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], ">", "0"}]}]}], ";"}]], "Input",Expr\
essionUUID->"54629ad7-81e7-5a44-96b6-97c9408d71b3"],

