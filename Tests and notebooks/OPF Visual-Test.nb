Cell[CellGroupData[{

Cell["7. Boundedness below tests", "Section",ExpressionUUID->"5bfc6412-e242-8d4e-8dfa-09c46b47179c"],

Cell["\<\
A central issue in the original material was whether the potential is bounded \
below. \
\>", "Text",ExpressionUUID->"bf07c000-3437-0048-ab7e-f3fd9c7275c1"],

Cell[CellGroupData[{

Cell["Symbolic asymptotic probes", "Subsection",ExpressionUUID->"d5bd88c1-e87e-2743-a2b6-c22b00bddd6e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"boundednessProbes", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<chiTo0+\>\"", "->", 
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"potential", "[", 
          RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "]"}], ",", 
         RowBox[{"chiVar", "->", "0"}], ",", 
         RowBox[{"Direction", "->", "\"\<FromAbove\>\""}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<chiToInfinity\>\"", "->", 
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"potential", "[", 
          RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "]"}], ",", 
         RowBox[{"chiVar", "->", "Infinity"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<rhoToInfinity\>\"", "->", 
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"potential", "[", 
          RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "]"}], ",", 
         RowBox[{"rhoVar", "->", "Infinity"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<rhoToMinusInfinity\>\"", "->", 
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"potential", "[", 
          RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "]"}], ",", 
         RowBox[{"rhoVar", "->", 
          RowBox[{"-", "Infinity"}]}]}], "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<resToInfinity\>\"", "->", 
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"potential", "[", 
          RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "]"}], ",", 
         RowBox[{"resVar", "->", "Infinity"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<resToMinusInfinity\>\"", "->", 
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"potential", "[", 
          RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "]"}], ",", 
         RowBox[{"resVar", "->", 
          RowBox[{"-", "Infinity"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
     "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "boundednessProbes"}], \
"Input",ExpressionUUID->"61bc11f7-2fe8-1340-9c64-304f0efea5d5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Random numeric stress test", "Subsection",ExpressionUUID->"a2e3cc67-cdf1-1448-a289-ce29f39fc5a2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "1234", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"randomSamples", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2000", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"randomSamples", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}], "=", 
    RowBox[{"Rescale", "[", 
     RowBox[{
      RowBox[{"randomSamples", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
      RowBox[{"MinMax", "[", 
       RowBox[{"randomSamples", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"0.01", ",", "4"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sampleValues", "=", 
    RowBox[{
     RowBox[{"potential", " ", "@@@", " ", "randomSamples"}], " ", "/.", " ", 
     "samplePars"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Histogram", "[", 
  RowBox[{"sampleValues", ",", "50", ",", 
   RowBox[{"PlotLabel", "->", "\"\<Potential sample distribution\>\""}]}], 
  "]"}]}], "Input",ExpressionUUID->"14673b34-a014-0243-8349-b817a6b537af"],

