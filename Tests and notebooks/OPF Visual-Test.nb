Cell[CellGroupData[{

Cell["5. Homogeneous stationary sector", "Section",ExpressionUUID->"394721b6-2705-4142-a5f3-f44d5adb125f"],

Cell["Now restrict to constant fields: ", "CodeText",ExpressionUUID->"f9d9da88-7017-3948-a341-da5534f075c1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"homogeneousRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "rho0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "chi0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "res0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"homogeneousEquations", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"fieldEquations", " ", "/.", " ", "homogeneousRules"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"$Assumptions", "&&", 
        RowBox[{"chi0", ">", "0"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"homogeneousEquations", " ", "//", " ", "TableForm"}]}], "Input",Expr\
essionUUID->"963d71ac-e41b-1c43-9829-fd481ef55658"],

Cell[CellGroupData[{

Cell["Solve correctly", "Subsection",ExpressionUUID->"89bd33ba-a897-fc4d-803d-2fdbc61054ec"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fixedPoints", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Reduce", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{"homogeneousEquations", ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", 
        "\[IndentingNewLine]", "    ", "Reals"}], "\[IndentingNewLine]", "  ",
        "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"$Assumptions", "&&", 
        RowBox[{"chi0", ">", "0"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", "fixedPoints"}], \
"Input",ExpressionUUID->"97747302-b68b-1246-b633-229ccb50874c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Optional explicit solutions", "Subsection",ExpressionUUID->"1527f510-572d-2943-94be-78525dde3db8"],

Cell[BoxData[
 RowBox[{"fixedPointRules", "=", 
  RowBox[{
   RowBox[{"Solve", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{"homogeneousEquations", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", "Reals"}], "\[IndentingNewLine]", "]"}], 
   " ", "//", " ", "FullSimplify"}]}]], "Input",ExpressionUUID->"4e45818a-\
192a-9e42-9f43-7e78cac164d4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visual interpretation", "Subsection",ExpressionUUID->"e29fa6e2-85f1-c848-b606-5c83ea9324f7"],

Cell[TextData[{
 "The constant-sector equations should be interpreted as stationary \
conditions of an effective potential ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["r", "TI"], 
             StyleBox["e", "TI"], 
             StyleBox["s", "TI"]}], ")"}], "\[LongEqual]", "\[Rho]", "log", 
         "\[Chi]", "+", "\[Chi]", 
         StyleBox["r", "TI"], 
         StyleBox["e", "TI"], 
         SuperscriptBox[
          StyleBox["s", "TI"], "2"], "+", "\[Delta]\[Rho]\[Chi]", 
         StyleBox["r", "TI"], 
         StyleBox["e", "TI"], 
         StyleBox["s", "TI"], "+", 
         SuperscriptBox["\[Lambda]\[Rho]", "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "V(\\rho,\\chi,res)=\\rho \\log \\chi + \\chi res^2 + \\delta \\rho \
\\chi res + \\lambda \\rho^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1ffc1306-740f-514b-b842-b3c7f6907db4"],
 "not yet as physical states. "
}], "Text",ExpressionUUID->"de936446-91f1-1346-bd9e-a80d27f3c00b"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"60717e85-998c-9841-9e71-e83a681b7023"]
}, Open  ]]
