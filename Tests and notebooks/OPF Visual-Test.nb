Cell[CellGroupData[{

Cell["9. Probe 1 rebuilt: equation foundry in Wolfram Language", "Section",ExpressionUUID->"ccc5b211-611c-2a4e-a948-d2b7e3f2d7f1"],

Cell["\<\
This section recreates the search logic natively in the Wolfram Language so \
it can be tested and maintained in one notebook. \
\>", "Text",ExpressionUUID->"cf0b67a0-b7c8-b342-8bee-65173e4533e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"potTerms", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<rhoLogChi\>\"", "->", 
      RowBox[{"rhoVar", " ", 
       RowBox[{"Log", "[", "chiVar", "]"}]}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<rhoLogRhoOverChi\>\"", "->", 
      RowBox[{"rhoVar", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"rhoVar", "/", "chiVar"}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<chiR2\>\"", "->", 
      RowBox[{"chiVar", " ", 
       RowBox[{"resVar", "^", "2"}]}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<R2Over2Chi\>\"", "->", 
      RowBox[{
       RowBox[{"resVar", "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "chiVar"}], ")"}]}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<lambdaRho2\>\"", "->", 
      RowBox[{"lambda", " ", 
       RowBox[{"rhoVar", "^", "2"}]}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<deltaRhoChiR\>\"", "->", 
      RowBox[{"delta", " ", "rhoVar", " ", "chiVar", " ", "resVar"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<-rho+chi\>\"", "->", 
      RowBox[{
       RowBox[{"-", "rhoVar"}], "+", "chiVar"}]}], ",", "\[IndentingNewLine]",
      "  ", 
     RowBox[{"\"\<rho2chi\>\"", "->", 
      RowBox[{
       RowBox[{"rhoVar", "^", "2"}], " ", "chiVar"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<chiLogChi\>\"", "->", 
      RowBox[{"chiVar", " ", 
       RowBox[{"Log", "[", "chiVar", "]"}]}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<R4\>\"", "->", 
      RowBox[{"resVar", "^", "4"}]}]}], "\[IndentingNewLine]", "|>"}]}], 
  ";"}]], "Input",ExpressionUUID->"b00cd074-2d40-1040-b529-d8323cdf8d4b"],

Cell[CellGroupData[{

Cell["Candidate generation", "Subsection",ExpressionUUID->"4f97c5a9-e942-1041-91c7-b57f1abe0511"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"candidateMasks", "=", 
   RowBox[{"Rest", " ", "@", " ", 
    RowBox[{"Tuples", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], ",", 
      RowBox[{"Length", "[", "potTerms", "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"termNames", "=", 
   RowBox[{"Keys", "[", "potTerms", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"termExprs", "=", 
    RowBox[{"Values", "[", "potTerms", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"candidatePotentialFromMask", "[", "mask_", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{"Pick", "[", 
     RowBox[{"termExprs", ",", "mask", ",", "1"}], "]"}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"6f4b88c4-8aaf-e247-9e52-eafaea45d56f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Constant-sector equations", "Subsection",ExpressionUUID->"a67ddce3-479f-8844-9e9b-8ce71b2e3034"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"constGrad", "[", "expr_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Grad", "[", 
     RowBox[{"expr", ",", 
      RowBox[{"{", 
       RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "}"}]}], "]"}], " ", 
    "//", " ", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"constHessian", "[", "expr_", "]"}], ":=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"expr", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "}"}], ",", "2"}], 
       "}"}]}], "]"}], " ", "//", " ", "FullSimplify"}]}], ";"}]}], "Input",Ex\
pressionUUID->"4f6a7f66-2532-3e4d-8fe0-d2d6ac5451d6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Fixed-point finder", "Subsection",ExpressionUUID->"095aa5a7-705e-414c-84d0-e8a85a9dc3bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"findFixedPoints", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"pars_", ":", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"delta", "->", 
         RowBox[{"1", "/", "2"}]}], ",", 
        RowBox[{"lambda", "->", "1"}]}], "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"grad", ",", "sols"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"grad", "=", 
       RowBox[{"constGrad", "[", 
        RowBox[{"expr", " ", "/.", " ", "pars"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"sols", "=", 
       RowBox[{"Quiet", " ", "@", " ", 
        RowBox[{"Solve", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{"grad", "==", "0"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"chiVar", ">", "0"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"{", 
           RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "}"}], ",", 
          "\[IndentingNewLine]", "    ", "Reals"}], "\[IndentingNewLine]", 
         "  ", "]"}]}]}], ";", "\[IndentingNewLine]", "  ", "sols"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",ExpressionUUID->"dc82cbd8-\
0c24-e844-a97d-efaa6b3c69c5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Local stability classifier", "Subsection",ExpressionUUID->"7bf26267-6969-6f41-acaf-b374415e0b28"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"stablePointQ", "[", 
    RowBox[{"expr_", ",", "sol_", ",", 
     RowBox[{"pars_", ":", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"delta", "->", 
         RowBox[{"1", "/", "2"}]}], ",", 
        RowBox[{"lambda", "->", "1"}]}], "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "eig", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"eig", "=", 
       RowBox[{
        RowBox[{"Eigenvalues", "[", 
         RowBox[{
          RowBox[{"constHessian", "[", 
           RowBox[{"expr", " ", "/.", " ", "pars"}], "]"}], " ", "/.", " ", 
          "sol"}], "]"}], " ", "//", " ", "N"}]}], ";", "\[IndentingNewLine]",
       "  ", 
      RowBox[{
       RowBox[{"VectorQ", "[", 
        RowBox[{"eig", ",", "NumericQ"}], "]"}], "&&", 
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{"Re", "[", "eig", "]"}], "]"}], ">", "0"}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",ExpressionUUID->"8776b1fd-\
c810-af4f-a1bd-27020e1b5188"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Boundedness heuristic", "Subsection",ExpressionUUID->"dc3d5708-0ea9-8541-a3c4-dc0f242f27e0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"boundedHeuristicQ", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"pars_", ":", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"delta", "->", 
         RowBox[{"1", "/", "2"}]}], ",", 
        RowBox[{"lambda", "->", "1"}]}], "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pts", ",", "vals"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"pts", "=", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"800", ",", "3"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"pts", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "=", 
       RowBox[{"Rescale", "[", 
        RowBox[{
         RowBox[{"pts", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"MinMax", "[", 
          RowBox[{"pts", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0.05", ",", "3"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"vals", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Quiet", "[", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"expr", " ", "/.", " ", "pars"}], " ", "/.", " ", 
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "}"}], "->", 
              "#"}], "]"}]}], "]"}], "]"}], " ", "&"}], " ", "/@", " ", 
        "pts"}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"FreeQ", "[", 
        RowBox[{"vals", ",", 
         RowBox[{
         "_Complex", " ", "|", " ", "Indeterminate", " ", "|", " ", 
          "DirectedInfinity"}]}], "]"}], "&&", 
       RowBox[{
        RowBox[{"Min", "[", "vals", "]"}], ">", 
        RowBox[{"-", 
         RowBox[{"10", "^", "6"}]}]}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"79316180-ad61-474d-9334-ee1987c497cf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Homogeneity check", "Subsection",ExpressionUUID->"6ee6a47c-f986-a64a-ae46-bbd05cee8c0b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"homogeneousQ", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"scaled", "=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"expr", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"rhoVar", "->", 
            RowBox[{"t", " ", "rhoVar"}]}], ",", 
           RowBox[{"chiVar", "->", 
            RowBox[{"t", " ", "chiVar"}]}], ",", 
           RowBox[{"resVar", "->", 
            RowBox[{"t", " ", "resVar"}]}]}], "}"}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"MatchQ", "[", 
      RowBox[{
       RowBox[{"Together", "[", 
        RowBox[{"scaled", "/", "expr"}], "]"}], ",", 
       RowBox[{"t", "^", "_."}]}], "]"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"91d490db-b348-6644-8d59-8530b1999d5f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Search and scoring", "Subsection",ExpressionUUID->"8ff6fd7d-3a70-2745-8ce5-b7c5c4077a92"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SeedRandom", "[", "2025", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scoreCandidate", "[", 
     RowBox[{"mask_", ",", 
      RowBox[{"pars_", ":", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"delta", "->", 
          RowBox[{"1", "/", "2"}]}], ",", 
         RowBox[{"lambda", "->", "1"}]}], "}"}]}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "expr", ",", "fps", ",", "stable", ",", "bounded", ",", "homog"}], 
       "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"expr", "=", 
        RowBox[{"candidatePotentialFromMask", "[", "mask", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"fps", "=", 
        RowBox[{"findFixedPoints", "[", 
         RowBox[{"expr", ",", "pars"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"stable", "=", 
        RowBox[{"AnyTrue", "[", 
         RowBox[{"fps", ",", 
          RowBox[{
           RowBox[{"stablePointQ", "[", 
            RowBox[{"expr", ",", "#", ",", "pars"}], "]"}], " ", "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"bounded", "=", 
        RowBox[{"boundedHeuristicQ", "[", 
         RowBox[{"expr", ",", "pars"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"homog", "=", 
        RowBox[{"homogeneousQ", "[", "expr", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Mask\>\"", "->", "mask"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"\"\<Terms\>\"", "->", 
          RowBox[{"Pick", "[", 
           RowBox[{"termNames", ",", "mask", ",", "1"}], "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Potential\>\"", "->", "expr"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<FixedPointExists\>\"", "->", 
          RowBox[{"(", 
           RowBox[{"fps", "=!=", 
            RowBox[{"{", "}"}]}], ")"}]}], ",", "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Stable\>\"", "->", "stable"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<BoundedHeuristic\>\"", "->", "bounded"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Homogeneous\>\"", "->", "homog"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<Score\>\"", "->", 
          RowBox[{
           RowBox[{"4", " ", 
            RowBox[{"Boole", "[", "stable", "]"}]}], "+", 
           RowBox[{"2", " ", 
            RowBox[{"Boole", "[", "bounded", "]"}]}], "+", 
           RowBox[{"Boole", "[", "homog", "]"}], "+", 
           RowBox[{"Boole", "[", 
            RowBox[{"fps", "=!=", 
             RowBox[{"{", "}"}]}], "]"}]}]}]}], "\[IndentingNewLine]", "  ", 
        "|>"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"probe1Results", "=", 
   RowBox[{"scoreCandidate", " ", "/@", " ", 
    RowBox[{"Take", "[", 
     RowBox[{"candidateMasks", ",", 
      RowBox[{"UpTo", "[", "128", "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", 
  RowBox[{"SortBy", "[", 
   RowBox[{"probe1Results", ",", 
    RowBox[{
     RowBox[{"-", "#Score"}], " ", "&"}]}], "]"}], "]"}]}], "Input",Expression\
UUID->"3f097072-df8d-eb4e-a6f3-f9c26679e0a4"]
}, Open  ]],

