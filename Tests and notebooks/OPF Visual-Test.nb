Cell[CellGroupData[{

Cell["13. How the original framework could be misunderstood", "Section",ExpressionUUID->"ebeccb96-ee8d-b74d-afe5-ebe2fa48ad7c"],

Cell[CellGroupData[{

Cell["Category errors to guard against", "Subsection",ExpressionUUID->"81191155-7926-ad4c-a047-2d8967a2625b"],

Cell[TextData[{
 "1. ",
 StyleBox["Formal variable vs measured observable",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"3599fb0d-5fc8-5b4c-91c4-1978b3d70d4b"],

Cell[TextData[{
 StyleBox["rho", "TI"],
 ", ",
 StyleBox["chi", "TI"],
 ", and ",
 StyleBox["res", "TI"],
 " are model fields, not yet empirically identified observables."
}], "Subitem",ExpressionUUID->"28bfa1fb-36b1-8a4b-9769-f5e4f4b83292"],

Cell[TextData[{
 "2. ",
 StyleBox["Stationary solution vs ontology",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"1312bf72-ecba-084d-8d5c-8edcb927c76c"],

Cell["\<\
A fixed point in a PDE model is not automatically a statement about \
\[OpenCurlyDoubleQuote]what reality is\[CloseCurlyDoubleQuote].\
\>", "Subitem",ExpressionUUID->"8c154edc-e427-0c46-9786-49a74478a076"],

Cell[TextData[{
 "3. ",
 StyleBox["Information vs energy",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"d5de2b3d-36d3-094a-9b59-038b4ab2ef8b"],

Cell["\<\
Information-theoretic quantities can enter an energy-like functional, but \
this does not imply identity between information and physical energy.\
\>", "Subitem",ExpressionUUID->"4779b0eb-7a08-3540-83d7-a90bf283317f"],

Cell[TextData[{
 "4. ",
 StyleBox["Golden ratio appearance",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"1d9945ac-38b5-3d4c-827a-daacdf2006b6"],

Cell[TextData[{
 "A recovered near-",
 StyleBox["phi", "TI"],
 " frequency ratio may come from construction, symmetry, or optimization \
bias, not fundamental law."
}], "Subitem",ExpressionUUID->"5f533f93-31e8-a34b-a1c6-799275d3d478"],

Cell[TextData[{
 "5. ",
 StyleBox["Self-measurement",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"8da333c6-038e-f340-b49a-e097eb310d8d"],

Cell["\<\
A kernel acting on its own state space is a mathematical self-map. Calling it \
\[OpenCurlyDoubleQuote]self-measurement\[CloseCurlyDoubleQuote] is \
interpretive language unless tied to a precise measurement theory.\
\>", "Subitem",ExpressionUUID->"6466cca1-3557-e241-8a94-a06603d63e9b"],

Cell[TextData[{
 "6. ",
 StyleBox["Scale invariance",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"01ded86e-9116-5d4c-95f8-e2399fa82fe2"],

Cell["\<\
Exact scale invariance is much stronger than informal self-similarity. It \
must be tested symbolically.\
\>", "Subitem",ExpressionUUID->"24d93ecc-05dc-7d42-a12c-26c7a2c4d31d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Stronger wording standard", "Subsection",ExpressionUUID->"4da65f45-d684-e441-bb49-143368c95292"],

Cell["Instead of: ", "Text",ExpressionUUID->"7de37951-49b8-b642-a95e-5a3ff926d045"],

Cell["\[OpenCurlyDoubleQuote]The toroidal fluctuations ARE captured...\
\[CloseCurlyDoubleQuote]", "Item",ExpressionUUID->"c7f80a6f-9d0e-4249-810b-\
fbbdd37e51ec"],

Cell["prefer: ", "Text",ExpressionUUID->"0f28f2df-d0fc-2041-b943-e13e93dffb72"],

Cell["\<\
\[OpenCurlyDoubleQuote]For this deterministic torus model, the dominant \
oscillatory components are numerically recoverable by the chosen spectral \
method.\[CloseCurlyDoubleQuote]\
\>", "Item",ExpressionUUID->"7ae1d283-e041-b142-8ee8-11f0e00bf723"],

Cell["Instead of: ", "Text",ExpressionUUID->"5ab69186-6c98-284a-90eb-44da88e63268"],

Cell["\[OpenCurlyDoubleQuote]information arises as energy\
\[CloseCurlyDoubleQuote]", "Item",ExpressionUUID->"c9c186eb-9891-1e41-b3b8-\
2a0aba6bed7a"],

Cell["prefer: ", "Text",ExpressionUUID->"1ab26bae-85da-1a40-aab1-75378cffcfd5"],

Cell["\<\
\[OpenCurlyDoubleQuote]the model uses information-theoretic terms inside an \
action-like functional whose stationary points and modes can be studied \
mathematically.\[CloseCurlyDoubleQuote]\
\>", "Item",ExpressionUUID->"1e21bd1a-bcd6-ea48-9bc2-115ba9c6de89"],

