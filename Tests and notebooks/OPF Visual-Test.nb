Cell[CellGroupData[{

Cell["8. Scale ansatz done correctly", "Section",ExpressionUUID->"9e11624e-002a-064a-a50a-6ee1fc20b139"],

Cell[TextData[{
 "The original notebook attempted to append assumptions using ",
 ButtonBox["Join",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Join"],
 " on a logical expression. The correct form is logical conjunction. "
}], "Text",ExpressionUUID->"89aa91c1-e247-cd49-9b88-9644c4ff7e1a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"scaleAnsatz", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{
        RowBox[{"rhoS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"a", " ", "sigma"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{
        RowBox[{"chiS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"b", " ", "sigma"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{
        RowBox[{"resS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"c", " ", "sigma"}], "]"}]}]}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleReducedEquations", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"fieldEquations", " ", "/.", " ", "scaleAnsatz"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"$Assumptions", "&&", 
        RowBox[{
         RowBox[{"chiS", "[", "x", "]"}], ">", "0"}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"scaleReducedEquations", " ", "//", " ", "TableForm"}]}], "Input",Exp\
ressionUUID->"2f9120ac-47d0-ad47-91ef-1eea7fe40cb5"],

Cell[CellGroupData[{

Cell["Extract sigma exponents robustly", "Subsection",ExpressionUUID->"3aa34fb3-6551-e444-ad60-2b884ac4b114"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"expPowers", "[", "expr_", "]"}], ":=", 
    RowBox[{"DeleteDuplicates", " ", "@", " ", 
     RowBox[{"Cases", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{"expr", ",", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"k_.", " ", "sigma"}], "]"}], ":>", "k"}], ",", 
       "\[IndentingNewLine]", "  ", "Infinity"}], "\[IndentingNewLine]", 
      "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scalePowers", "=", 
   RowBox[{"expPowers", " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{"Subtract", " ", "@@@", " ", "scaleReducedEquations"}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", "scalePowers"}], "Input",Express\
ionUUID->"04eada24-0fea-7342-950e-e7ddbdcf68bb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Homogeneity test of the potential", "Subsection",ExpressionUUID->"0b30564b-deb8-184c-bbb9-51b3654cdc8d"],

Cell[TextData[{
 "A more rigorous homogeneity test is to check whether ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["t", "TI"], "\[Rho]", ",", 
             StyleBox["t", "TI"], "\[Chi]", ",", 
             StyleBox["t", "TI"], 
             StyleBox["r", "TI"], 
             StyleBox["e", "TI"], 
             StyleBox["s", "TI"]}], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["t", "TI"], 
          StyleBox["n", "TI"]], 
         StyleBox["V", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["r", "TI"], 
             StyleBox["e", "TI"], 
             StyleBox["s", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "V(t\\rho,t\\chi,t res)=t^n V(\\rho,\\chi,res)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1a71f3d5-14af-9946-85eb-07ea5d83e8ba"],
 "for some degree ",
 StyleBox["n", "TI"],
 ". "
}], "Text",ExpressionUUID->"b3ec4c92-1321-7c43-98b4-bccefae53452"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"homogeneityDegree", "[", 
     RowBox[{"expr_", ",", "vars_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"scaled", "=", 
        RowBox[{"Simplify", "[", 
         RowBox[{"expr", " ", "/.", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"vars", "->", 
            RowBox[{"t", " ", "vars"}]}], "]"}]}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Which", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{"scaled", "==", "expr"}], "]"}], "===", "True"}], ",", "0", 
        ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"MatchQ", "[", 
         RowBox[{
          RowBox[{"FactorTerms", "[", 
           RowBox[{
            RowBox[{"scaled", "/", "expr"}], ",", "t"}], "]"}], ",", 
          RowBox[{"t", "^", "_"}]}], "]"}], ",", 
        RowBox[{"Exponent", "[", 
         RowBox[{
          RowBox[{"Together", "[", 
           RowBox[{"scaled", "/", "expr"}], "]"}], ",", "t"}], "]"}], ",", 
        "\[IndentingNewLine]", "    ", "True", ",", 
        RowBox[{"Missing", "[", "\"\<NonHomogeneous\>\"", "]"}]}], 
       "\[IndentingNewLine]", "  ", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"candidatePotentials", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Original\>\"", "->", 
       RowBox[{
        RowBox[{"rhoVar", " ", 
         RowBox[{"Log", "[", "chiVar", "]"}]}], "+", 
        RowBox[{"chiVar", " ", 
         RowBox[{"resVar", "^", "2"}]}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<KLLike\>\"", "->", 
       RowBox[{
        RowBox[{"rhoVar", " ", 
         RowBox[{"Log", "[", 
          RowBox[{"rhoVar", "/", "chiVar"}], "]"}]}], "-", "rhoVar", "+", 
        "chiVar", "+", 
        RowBox[{
         RowBox[{"resVar", "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "chiVar"}], ")"}]}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<rho2chi\>\"", "->", 
       RowBox[{
        RowBox[{"rhoVar", "^", "2"}], " ", "chiVar"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<chiR2+deltaTerm+rho2chi\>\"", "->", 
       RowBox[{
        RowBox[{"chiVar", " ", 
         RowBox[{"resVar", "^", "2"}]}], "+", 
        RowBox[{"delta", " ", "rhoVar", " ", "chiVar", " ", "resVar"}], "+", 
        RowBox[{
         RowBox[{"rhoVar", "^", "2"}], " ", "chiVar"}]}]}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"homogeneityTable", "=", 
    RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"homogeneityDegree", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "}"}], ",", "t"}],
         "]"}], " ", "&"}], ",", "\[IndentingNewLine]", "  ", 
      "candidatePotentials"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "homogeneityTable"}], \
"Input",ExpressionUUID->"048a5c9a-aa5e-8944-ad36-30e11e9cc5b5"],

