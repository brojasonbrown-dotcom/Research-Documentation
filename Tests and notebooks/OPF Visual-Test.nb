Cell[CellGroupData[{

Cell["12. Visual regression tests", "Section",ExpressionUUID->"8cc4f7e8-584b-b44b-836c-b343dbc296b6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"testReport", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"VerificationTest", "[", 
       RowBox[{
        RowBox[{"Context", "[", "VariationalD", "]"}], 
        ",", "\"\<VariationalMethods`\>\"", ",", 
        RowBox[{"TestID", "->", "\"\<VariationalDContext\>\""}]}], "]"}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"VerificationTest", "[", 
       RowBox[{"crossCheckEL", ",", 
        RowBox[{"{", 
         RowBox[{"True", ",", "True", ",", "True"}], "}"}], ",", 
        RowBox[{"TestID", "->", "\"\<EulerLagrangeCrossCheck\>\""}]}], "]"}], 
      ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"VerificationTest", "[", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{"fixedPoints", ",", 
          RowBox[{
          "_Equal", " ", "|", " ", "_And", " ", "|", " ", "_Or", " ", "|", 
           " ", "True", " ", "|", " ", "False"}]}], "]"}], ",", "True", ",", 
        RowBox[{
        "TestID", "->", "\"\<FixedPointReduceReturnedLogicalForm\>\""}]}], 
       "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"VerificationTest", "[", 
       RowBox[{
        RowBox[{"And", " ", "@@", " ", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"Values", "[", "probe3Residuals", "]"}], "<", 
           RowBox[{"10", "^", 
            RowBox[{"-", "6"}]}]}], "]"}]}], ",", "True", ",", 
        RowBox[{"TestID", "->", "\"\<Probe3ResidualsSmall\>\""}]}], "]"}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"TestReport", "[", "testReport", "]"}]}], "Input",ExpressionUUID->\
"4408e3f9-50d5-6940-9cd4-a619eca1d2d5"],

