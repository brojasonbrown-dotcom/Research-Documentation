  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "310e1cd8-0203-ac4a-a5fa-ec551a807ef7"],
 " as a scalar closure"
}], "Item",ExpressionUUID->"50ae9b71-e54f-6e41-beb5-374ae5237b88"],

Cell[TextData[{
 "using ",
 Cell[BoxData[
  RowBox[{"Tr", "[", "anisotropyTensor", "]"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
