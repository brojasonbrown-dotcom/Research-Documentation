  CellChangeTimes->{4.001422694101549*^9},ExpressionUUID->
  "b9de4fc7-474f-fa47-b236-f82b6ff12b3f"],
 "\nA true equilibrium must produce zero residuals in all equations. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
