 "\n10. Numerical solution with reproducible initial data\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"initialConditions", "=", 
     RowBox[{"{", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"rhoVar", "[", "0", "]"}], "==", "1.2"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"nuVar", "[", "0", "]"}], "==", "0.8"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"psiVar", "[", "0", "]"}], "==", "0.3"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"rVar", "[", "0", "]"}], "==", "1.0"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"a1Var", "[", "0", "]"}], "==", "0.2"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"a2Var", "[", "0", "]"}], "==", "0.1"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"a3Var", "[", "0", "]"}], "==", "0.15"}]}], 
      "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"numericSolution", "=", 
    RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{"odeSystem", ",", "initialConditions"}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{
       "rhoVar", ",", "nuVar", ",", "psiVar", ",", "rVar", ",", "a1Var", ",", 
        "a2Var", ",", "a3Var"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"tau", ",", "0", ",", "20"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Method", "->", 
       RowBox[{"{", "\"\<StiffnessSwitching\>\"", "}"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"WorkingPrecision", "->", "50"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"PrecisionGoal", "->", "30"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"AccuracyGoal", "->", "30"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"MaxSteps", "->", "Infinity"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}]}], "Input",ExpressionUUID->
  "5093697b-9525-5a44-9101-58680ab928ab"],
