       RowBox[{"psi", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], " ", 
       RowBox[{"r", "[", 
        RowBox[{"x", ",", "tau"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"\[Sqrt]", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"anisotropyVec1", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"anisotropyVec2", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"anisotropyVec3", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], "2"]}], ")"}]}], " ", 
       RowBox[{"psi", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], " ", 
       RowBox[{"r", "[", 
        RowBox[{"x", ",", "tau"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"\[Sqrt]", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"anisotropyVec1", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"anisotropyVec2", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"anisotropyVec3", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], "2"]}], ")"}]}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"nu", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], "-", 
         RowBox[{"rho", "[", 
          RowBox[{"x", ",", "tau"}], "]"}]}], ")"}]}], "-", 
      RowBox[{"rho", "[", 
       RowBox[{"x", ",", "tau"}], "]"}]}]}]}], "\[RightAssociation]"}]], 
  "Output",
  CellChangeTimes->{4.0014226936708107`*^9},ExpressionUUID->
  "95e59dd1-e644-8e4e-ba88-cc99a8d98332"],
 "\nWhy this fixes the earlier issue\nYour earlier notebook used equations of \
the form ",
 Cell[BoxData[Cell["lhs == rhs",
   Background->None,ExpressionUUID->"9710ff2a-c916-b246-b3c9-841b7fe344c8"]], 
  "InlineCode",ExpressionUUID->"f2d426c1-8962-bc43-ac33-d65764b964de"],
 " directly in ",
 ButtonBox["ReplaceAll",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ReplaceAll"],
 ".  \nFor replacement, Wolfram Language needs ",
 StyleBox["rules",
  FontWeight->Bold],
 " of the form ",
 Cell[BoxData[Cell["lhs -> rhs",
   Background->None,ExpressionUUID->"32aa3e70-6a3c-114f-b70b-ae43b201d2b0"]], 
  "InlineCode",ExpressionUUID->"63be1b83-0349-b146-96af-d692ded79726"],
 ".  \nThe line \n",
 Cell[BoxData[
  RowBox[{
   RowBox[{"rhsRules", "=", 
    RowBox[{"Rule", " ", "@@@", " ", "dynamicSystem"}]}], ";"}]], "Input",
  ExpressionUUID->"03a5c5a2-1682-b54a-bfa9-1bac7026569c"],
 "\nconverts each differential equation into a valid replacement rule. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "Text", "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"1fa4c5ed-fe5c-d64d-9d3d-46015d01d44d"],
 "\n6. Exact derived forms\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"derivedForms", "=", 
     RowBox[{"<|", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"\"\<SignedDensityEvolutionExpanded\>\"", "->", 
         RowBox[{"Expand", "[", "signedDensityBalance", "]"}]}], " ", "//", 
        " ", "FullSimplify"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"\"\<PsiEvolutionExpanded\>\"", "->", 
         RowBox[{"Expand", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"psi", "[", 
              RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], " ", "/.",
            " ", "rhsRules"}], "]"}]}], " ", "//", " ", "FullSimplify"}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"\"\<rEvolutionExpanded\>\"", "->", 
         RowBox[{"Expand", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"r", "[", 
              RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], " ", "/.",
            " ", "rhsRules"}], "]"}]}], " ", "//", " ", "FullSimplify"}]}], 
      "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]",
  "derivedForms"}], "Input",ExpressionUUID->
  "2e5626fc-0cde-f94f-a054-c62ec7707122"],
 "\n",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"\<\"SignedDensityEvolutionExpanded\"\>", "\[Rule]", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "+", 
           RowBox[{"\[Sqrt]", 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox[
               RowBox[{"anisotropyVec1", "[", 
                RowBox[{"x", ",", "tau"}], "]"}], "2"], "+", 
              SuperscriptBox[
               RowBox[{"anisotropyVec2", "[", 
                RowBox[{"x", ",", "tau"}], "]"}], "2"], "+", 
              SuperscriptBox[
               RowBox[{"anisotropyVec3", "[", 
                RowBox[{"x", ",", "tau"}], "]"}], "2"]}], ")"}]}]}], ")"}], " ", 
         RowBox[{"nu", "[", 
          RowBox[{"x", ",", "tau"}], "]"}]}], ")"}]}], "+", 
      RowBox[{"rho", "[", 
       RowBox[{"x", ",", "tau"}], "]"}], "+", 
      RowBox[{
       RowBox[{"\[Sqrt]", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"anisotropyVec1", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"anisotropyVec2", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], "2"], "+", 
          SuperscriptBox[
           RowBox[{"anisotropyVec3", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], "2"]}], ")"}]}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], "+", 
         RowBox[{"rho", "[", 
          RowBox[{"x", ",", "tau"}], "]"}]}], ")"}]}]}]}], ",", 
    RowBox[{"\<\"PsiEvolutionExpanded\"\>", "\[Rule]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"\[Sqrt]", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"anisotropyVec1", "[", 
             RowBox[{"x", ",", "tau"}], "]"}], "2"], "+", 
           SuperscriptBox[
            RowBox[{"anisotropyVec2", "[", 
             RowBox[{"x", ",", "tau"}], "]"}], "2"], "+", 
           SuperscriptBox[
            RowBox[{"anisotropyVec3", "[", 
             RowBox[{"x", ",", "tau"}], "]"}], "2"]}], ")"}]}]}], ")"}], " ", 
      RowBox[{"psi", "[", 
       RowBox[{"x", ",", "tau"}], "]"}], " ", 
      RowBox[{"r", "[", 
       RowBox[{"x", ",", "tau"}], "]"}]}]}], ",", 
    RowBox[{"\<\"rEvolutionExpanded\"\>", "\[Rule]", 
     RowBox[{
      RowBox[{"nu", "[", 
       RowBox[{"x", ",", "tau"}], "]"}], "+", 
      RowBox[{"psi", "[", 
       RowBox[{"x", ",", "tau"}], "]"}], "-", 
      RowBox[{"rho", "[", 
       RowBox[{"x", ",", "tau"}], "]"}]}]}]}], "\[RightAssociation]"}]], 
  "Output",
  CellChangeTimes->{4.001422693794895*^9},ExpressionUUID->
  "c794f290-5eeb-7241-bea9-92b74eee62c0"],
 "\nReading these equations\nIf the signed-density derivative is positive, \
the ",
 Cell[BoxData[Cell["rho - nu",
   Background->None,ExpressionUUID->"95e48e10-447d-1745-b426-3370485ca4b7"]], 
  "InlineCode",ExpressionUUID->"ef065b63-71eb-1243-a220-a7bb11469108"],
 " contrast amplifies.\nIf it is negative, contrast decays.\n",
 StyleBox["psi", "TI"],
 " evolves according to measurement times a gain term involving anisotropy \
magnitude.\n",
 StyleBox["r", "TI"],
 " evolves according to coherence mismatch.\nThat is the core mechanism by \
which the model expresses ",
 StyleBox["field competition, coherence correction, and anisotropic \
amplification",
  FontWeight->Bold],
 ". \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "Text", "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"9d449ced-80d9-2547-8408-3fca8da4278d"],
 "\n7. Stationary system and exact equilibrium solving\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "rho0", ",", "nu0", ",", "psi0", ",", "r0", ",", "a1", ",", "a2", ",", 
      "a3", ",", "aMag", ",", "stationaryAlgebraicSystem"}], "]"}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"stationaryAlgebraicSystem", "=", 
     RowBox[{"{", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"0", "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"rho0", "-", "nu0"}], ")"}], "+", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"a1", "^", "2"}], "+", 
            RowBox[{"a2", "^", "2"}], "+", 
            RowBox[{"a3", "^", "2"}]}], "]"}], " ", "r0"}]}]}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"0", "==", 
        RowBox[{"nu0", "-", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"a1", "^", "2"}], "+", 
            RowBox[{"a2", "^", "2"}], "+", 
            RowBox[{"a3", "^", "2"}]}], "]"}], " ", 
          RowBox[{"(", 
           RowBox[{"rho0", "-", "nu0"}], ")"}]}]}]}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"0", "==", 
        RowBox[{"psi0", "-", "rho0", "+", "nu0"}]}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"0", "==", 
        RowBox[{"psi0", " ", "r0", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"Sqrt", "[", 
            RowBox[{
             RowBox[{"a1", "^", "2"}], "+", 
             RowBox[{"a2", "^", "2"}], "+", 
             RowBox[{"a3", "^", "2"}]}], "]"}]}], ")"}]}]}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"0", "==", 
        RowBox[{"psi0", "-", "rho0", "+", "nu0"}]}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"0", "==", 
        RowBox[{"rho0", "-", "nu0"}]}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"0", "==", 
        RowBox[{"rho0", "-", "nu0"}]}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"0", "==", 
        RowBox[{"rho0", "-", "nu0"}]}]}], "\[IndentingNewLine]", "}"}]}], 
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"stationaryReduced", "=", 
    RowBox[{"FullSimplify", "[", "stationaryAlgebraicSystem", "]"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"stationarySolutions", "=", 
     RowBox[{"Reduce", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{"stationaryReduced", ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{
        "rho0", ",", "nu0", ",", "psi0", ",", "r0", ",", "a1", ",", "a2", ",",
          "a3"}], "}"}], ",", "\[IndentingNewLine]", "  ", "Reals", ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"MaxExtraConditions", "->", "All"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 "stationarySolutions"}], "Input",ExpressionUUID->
  "163ad583-f1b2-0146-b6c3-d10278b1510b"],
 "\n",
 Cell[BoxData[
  TemplateBox[{
   "Reduce", "optx", 
    "\"Unknown option \\!\\(\\*RowBox[{\\\"MaxExtraConditions\\\"}]\\) in \\!\
\\(\\*RowBox[{\\\"Reduce\\\", \\\"[\\\", RowBox[{RowBox[{\\\"{\\\", \
RowBox[{RowBox[{\\\"nu0\\\", \\\"\[Equal]\\\", \
RowBox[{RowBox[{SqrtBox[RowBox[{\\\"Plus\\\", \\\"[\\\", RowBox[{\\\"\
\[LeftSkeleton]\\\", \\\"3\\\", \\\"\[RightSkeleton]\\\"}], \\\"]\\\"}]], \
\\\" \\\", \\\"r0\\\"}], \\\"+\\\", \\\"rho0\\\"}]}], \\\",\\\", \
RowBox[{RowBox[{\\\"nu0\\\", \\\"+\\\", RowBox[{SqrtBox[RowBox[{\\\"Plus\\\", \
\\\"[\\\", RowBox[{\\\"\[LeftSkeleton]\\\", \\\"3\\\", \\\"\[RightSkeleton]\\\
\"}], \\\"]\\\"}]], \\\" \\\", RowBox[{\\\"(\\\", RowBox[{\\\"nu0\\\", \
\\\"+\\\", RowBox[{\\\"Times\\\", \\\"[\\\", RowBox[{\\\"\[LeftSkeleton]\\\", \
\\\"2\\\", \\\"\[RightSkeleton]\\\"}], \\\"]\\\"}]}], \\\")\\\"}]}]}], \\\"\
\[Equal]\\\", \\\"0\\\"}], \\\",\\\", RowBox[{RowBox[{\\\"nu0\\\", \\\"+\\\", \
\\\"psi0\\\"}], \\\"\[Equal]\\\", \\\"rho0\\\"}], \\\",\\\", \
RowBox[{RowBox[{SqrtBox[RowBox[{RowBox[{\\\"Power\\\", \\\"[\\\", \
RowBox[{\\\"\[LeftSkeleton]\\\", \\\"2\\\", \\\"\[RightSkeleton]\\\"}], \\\"]\
\\\"}], \\\"+\\\", RowBox[{\\\"Power\\\", \\\"[\\\", RowBox[{\\\"\
\[LeftSkeleton]\\\", \\\"2\\\", \\\"\[RightSkeleton]\\\"}], \\\"]\\\"}], \
\\\"+\\\", RowBox[{\\\"Power\\\", \\\"[\\\", RowBox[{\\\"\[LeftSkeleton]\\\", \
\\\"2\\\", \\\"\[RightSkeleton]\\\"}], \\\"]\\\"}]}]], \\\" \\\", \
\\\"psi0\\\", \\\" \\\", \\\"r0\\\"}], \\\"\[Equal]\\\", \
RowBox[{\\\"psi0\\\", \\\" \\\", \\\"r0\\\"}]}], \\\",\\\", \
RowBox[{RowBox[{\\\"nu0\\\", \\\"+\\\", \\\"psi0\\\"}], \\\"\[Equal]\\\", \
\\\"rho0\\\"}], \\\",\\\", RowBox[{\\\"nu0\\\", \\\"\[Equal]\\\", \
\\\"rho0\\\"}], \\\",\\\", RowBox[{\\\"nu0\\\", \\\"\[Equal]\\\", \
\\\"rho0\\\"}], \\\",\\\", RowBox[{\\\"nu0\\\", \\\"\[Equal]\\\", \
\\\"rho0\\\"}]}], \\\"}\\\"}], \\\",\\\", RowBox[{\\\"{\\\", RowBox[{\\\"rho0\
\\\", \\\",\\\", \\\"nu0\\\", \\\",\\\", \\\"psi0\\\", \\\",\\\", \\\"r0\\\", \
\\\",\\\", \\\"a1\\\", \\\",\\\", \\\"a2\\\", \\\",\\\", \\\"a3\\\"}], \
\\\"}\\\"}], \\\",\\\", TemplateBox[List[], \\\"Reals\\\"], \\\",\\\", \
RowBox[{\\\"MaxExtraConditions\\\", \\\"\[Rule]\\\", \\\"All\\\"}]}], \\\"]\\\
\"}]\\).\"", 2, 32, 1, 30836912595828248742, "Local"},
   "MessageTemplate",
   BaseStyle->"MSG"]], "Message",
  CellChangeTimes->{4.0014226940675507`*^9},ExpressionUUID->
  "c4ac80b4-b033-664c-bcb3-af66db67c6d0"],
 "\n",
 Cell[BoxData[
  RowBox[{"Reduce", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"nu0", "\[Equal]", 
       RowBox[{
        RowBox[{
         SqrtBox[
          RowBox[{
           SuperscriptBox["a1", "2"], "+", 
           SuperscriptBox["a2", "2"], "+", 
           SuperscriptBox["a3", "2"]}]], " ", "r0"}], "+", "rho0"}]}], ",", 
      RowBox[{
       RowBox[{"nu0", "+", 
        RowBox[{
         SqrtBox[
          RowBox[{
           SuperscriptBox["a1", "2"], "+", 
           SuperscriptBox["a2", "2"], "+", 
           SuperscriptBox["a3", "2"]}]], " ", 
         RowBox[{"(", 
          RowBox[{"nu0", "-", "rho0"}], ")"}]}]}], "\[Equal]", "0"}], ",", 
      RowBox[{
       RowBox[{"nu0", "+", "psi0"}], "\[Equal]", "rho0"}], ",", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{
          SuperscriptBox["a1", "2"], "+", 
          SuperscriptBox["a2", "2"], "+", 
          SuperscriptBox["a3", "2"]}]], " ", "psi0", " ", "r0"}], "\[Equal]", 
       RowBox[{"psi0", " ", "r0"}]}], ",", 
      RowBox[{
       RowBox[{"nu0", "+", "psi0"}], "\[Equal]", "rho0"}], ",", 
      RowBox[{"nu0", "\[Equal]", "rho0"}], ",", 
      RowBox[{"nu0", "\[Equal]", "rho0"}], ",", 
      RowBox[{"nu0", "\[Equal]", "rho0"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
     "rho0", ",", "nu0", ",", "psi0", ",", "r0", ",", "a1", ",", "a2", ",", 
      "a3"}], "}"}], ",", 
    TemplateBox[{},
     "Reals"], ",", 
    RowBox[{"MaxExtraConditions", "\[Rule]", "All"}]}], "]"}]], "Output",
  CellChangeTimes->{4.001422694077551*^9},ExpressionUUID->
  "3a145752-ceff-e041-a665-4bb7d742f030"],
 "\nInterpretation\nThis uses the full stationary requirement for all time \
derivatives, not just the first three equations.  \nThat is more rigorous \
than the earlier partial stationary system. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "Text", "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"0505d118-e74c-a142-9fb8-143b1f5026ab"],
 "\n8. Residual analysis framework\nThis section is crucial: every proposed \
solution should be checked by plugging it back into the equations and \
measuring residuals. \n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "systemResiduals", "]"}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"systemResiduals", "[", "solRules_", "]"}], ":=", 
    RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "dynamicSystem", "]"}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"(", 
        RowBox[{"Subtract", " ", "@@@", " ", 
         RowBox[{"(", 
          RowBox[{"dynamicSystem", " ", "/.", " ", "solRules"}], ")"}]}], 
        ")"}], "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
  ExpressionUUID->"e7e36191-e7e6-fc42-9341-54203a1f4c64"],
 "\nExample usage with a candidate equilibrium: \n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"candidateEq", "=", 
     RowBox[{"{", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], "->", "1"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"nu", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], "->", "1"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"psi", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], "->", "0"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], "->", "1"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"anisotropyVec1", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], "->", "1"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"anisotropyVec2", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], "->", "0"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"anisotropyVec3", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], "->", "0"}]}], 
      "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{"systemResiduals", "[", "candidateEq", "]"}]}], "Input",
  ExpressionUUID->"b8d5644c-ef55-9e42-910c-9ce7139c8bfe"],
 "\n",
 Cell[BoxData[
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"1", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{
       SuperscriptBox["rho", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"0", ",", "1"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"x", ",", "tau"}], "]"}]}]}], ",", 
    RowBox[{"2", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{
       SuperscriptBox["nu", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"0", ",", "1"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"x", ",", "tau"}], "]"}]}]}], ",", 
    RowBox[{"3", "\[Rule]", 
     RowBox[{
      SuperscriptBox["psi", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"0", ",", "1"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"x", ",", "tau"}], "]"}]}], ",", 
