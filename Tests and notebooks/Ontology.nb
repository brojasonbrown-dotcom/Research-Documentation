structurally\>\"", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"anisotropyScalarFromVector", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], "^", "2"}], "==", 
       RowBox[{
        RowBox[{"anisotropyVec", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ".", 
        RowBox[{"anisotropyVec", "[", 
         RowBox[{"x", ",", "tau"}], "]"}]}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"test4", "=", 
    RowBox[{"printTestResult", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Test 4: restoration equals anisotropy magnitude times \
measurement\>\"", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"restorationOperator", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], "==", 
       RowBox[{
        RowBox[{"anisotropyScalarFromVector", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], " ", 
        RowBox[{"measurementOperator", "[", 
         RowBox[{"x", ",", "tau"}], "]"}]}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"test5", "=", 
