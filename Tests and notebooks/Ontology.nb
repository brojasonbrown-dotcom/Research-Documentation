 "\n4. Symbolic test harness\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "runTest", "]"}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"runTest", "[", 
      RowBox[{"name_String", ",", "expr_"}], "]"}], ":=", 
     RowBox[{"<|", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"\"\<Test\>\"", "->", "name"}], ",", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"\"\<Result\>\"", "->", 
        RowBox[{"Simplify", "[", "expr", "]"}]}], ",", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"\"\<FullForm\>\"", "->", 
        RowBox[{"HoldForm", "[", "expr", "]"}]}]}], "\[IndentingNewLine]", 
      "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"basicTests", "=", 
     RowBox[{"{", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"runTest", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Signed density definition\>\"", ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"signedDensity", "[", 
           RowBox[{"x", ",", "tau"}], "]"}], "==", 
          RowBox[{
           RowBox[{"rho", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], "-", 
           RowBox[{"nu", "[", 
            RowBox[{"x", ",", "tau"}], "]"}]}]}]}], "\[IndentingNewLine]", 
        "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"runTest", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Central coherence identity\>\"", ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"centralCoherence", "[", 
           RowBox[{"x", ",", "tau"}], "]"}], "==", 
          RowBox[{
           RowBox[{"psi", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], "-", 
           RowBox[{"rho", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], "+", 
           RowBox[{"nu", "[", 
            RowBox[{"x", ",", "tau"}], "]"}]}]}]}], "\[IndentingNewLine]", 
        "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"runTest", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Vector anisotropy norm identity\>\"", ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"anisotropyScalarFromVector", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], "^", "2"}], "==", 
          RowBox[{
           RowBox[{"anisotropyVec", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], ".", 
           RowBox[{"anisotropyVec", "[", 
            RowBox[{"x", ",", "tau"}], "]"}]}]}]}], "\[IndentingNewLine]", 
        "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"runTest", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Tensor trace identity\>\"", ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{
          RowBox[{"anisotropyScalarFromTensor", "[", 
           RowBox[{"x", ",", "tau"}], "]"}], "==", 
