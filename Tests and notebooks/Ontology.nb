                    RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], 
              "->", "\[IndentingNewLine]", "    ", 
              RowBox[{"Simplify", "[", 
                RowBox[{
                  RowBox[{"D", "[", 
                    RowBox[{
                    RowBox[{"signedDensity", "[", 
