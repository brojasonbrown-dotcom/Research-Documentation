Cell["11. Notes on rigor", "Section",ExpressionUUID->"da70e237-18b5-b64e-b5ff-4eff6b0edd3b"],

Cell["\<\
This upgrade makes the anisotropy representation more faithful to directional \
structure, but several choices remain prototypes: \
\>", "Text",ExpressionUUID->"aafe959a-432d-844e-b35d-9cf4773694f1"],

Cell[TextData[{
 "using ",
