 "\nInterpretation\nThese plots show whether: \ncontrast between ",
 StyleBox["rho", "TI"],
 " and ",
 StyleBox["nu", "TI"],
 " grows or decays,\ncoherence ",
 StyleBox["psi", "TI"],
 " amplifies or collapses,\nresponse ",
 StyleBox["r", "TI"],
 " tracks mismatch,\nanisotropy accumulates through sustained imbalance.\n\
That is a direct visual explanation of multiscale field dynamics: the system \
stores imbalance into directional structure and feeds it back into later \
evolution. \n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      TemplateBox[{0},
       "Spacer1"]},
     {
      TemplateBox[{0},
       "Spacer1"]}
    },
    AutoDelete->False,
    FrameStyle->Directive[
      LightDarkSwitched[
       GrayLevel[0.8], 
       GrayLevel[0.4867756]], 
      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "Text", "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"fc3d6427-bb5b-e243-a164-e4be555396b4"],
 "\n12. Derived observable plots\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"signedDensityTraj", "=", 
     RowBox[{"Plot", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"rhoVar", "[", "tau", "]"}], "-", 
           RowBox[{"nuVar", "[", "tau", "]"}]}], ")"}], " ", "/.", " ", 
         "numericSolution"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"tau", ",", "0", ",", "20"}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"PlotLabel", "->", "\"\<Signed Density\>\""}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"PlotStyle", "->", "Red"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"ImageSize", "->", "Large"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"GridLines", "->", "Automatic"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"coherenceTraj", "=", 
     RowBox[{"Plot", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"psiVar", "[", "tau", "]"}], "-", 
           RowBox[{"rhoVar", "[", "tau", "]"}], "+", 
           RowBox[{"nuVar", "[", "tau", "]"}]}], ")"}], " ", "/.", " ", 
