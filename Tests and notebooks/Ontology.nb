Cell[CellGroupData[{

Cell["6. Dynamic system with vector anisotropy magnitude", "Section",ExpressionUUID->"f542f3b1-e634-c748-b7ee-8506b12e65ba"],

Cell["\<\
We now promote the old scalar anisotropy evolution into component-wise vector \
dynamics.\
\>", "Text",ExpressionUUID->"b232fc27-4de2-db4c-956c-8f6215968b17"],

Cell[TextData[{
 "Prototype rule: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", "\[Tau]"], 
         StyleBox["a", FontSlant -> "Bold"], "\[LongEqual]", 
         StyleBox["D", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", "\[Tau]"}], ")"}], " ", 
         StyleBox["1", FontSlant -> "Bold"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\partial_\\tau \\mathbf a = D(x,\\tau)\\,\\mathbf 1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "96079d3d-f632-4b4d-8b9c-ab88931199c6"],
 "This is still a hypothesis, but it is more structured than a scalar field. "
}], "Text",ExpressionUUID->"b3d0e37c-b241-1b4e-9bb9-fcfa3cf366a3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "anisotropyDynamics", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"anisotropyDynamics", "[", 
     RowBox[{"x_", ",", "tau_"}], "]"}], ":=", 
    RowBox[{"Thread", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"anisotropyVec", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"signedDensity", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", "3"}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dynamicSystem", "=", 
    RowBox[{"Join", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"rho", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
         RowBox[{"sourceOperator", "[", 
          RowBox[{"x", ",", "tau"}], "]"}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"nu", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
         RowBox[{"voidOperator", "[", 
          RowBox[{"x", ",", "tau"}], "]"}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"psi", "[", 
            RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"measurementOperator", "[", 
            RowBox[{"x", ",", "tau"}], "]"}]}], "+", 
          RowBox[{"restorationOperator", "[", 
