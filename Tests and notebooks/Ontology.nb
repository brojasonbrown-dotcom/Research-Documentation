Cell[CellGroupData[{

Cell["10. State object upgrade", "Section",ExpressionUUID->"713626b4-5c7c-4040-a7d3-6a7146becfec"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "opfState", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"opfState", "[", 
     RowBox[{"x_", ",", "tau_"}], "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<rho\>\"", "->", 
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "tau"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<nu\>\"", "->", 
       RowBox[{"nu", "[", 
        RowBox[{"x", ",", "tau"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<anisotropyVector\>\"", "->", 
       RowBox[{"anisotropyVec", "[", 
        RowBox[{"x", ",", "tau"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<anisotropyTensor\>\"", "->", 
       RowBox[{"anisotropyTensor", "[", 
        RowBox[{"x", ",", "tau"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<anisotropyScalarFromVector\>\"", "->", 
       RowBox[{"anisotropyScalarFromVector", "[", 
        RowBox[{"x", ",", "tau"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<anisotropyScalarFromTensor\>\"", "->", 
       RowBox[{"anisotropyScalarFromTensor", "[", 
        RowBox[{"x", ",", "tau"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<r\>\"", "->", 
       RowBox[{"r", "[", 
        RowBox[{"x", ",", "tau"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<psi\>\"", "->", 
       RowBox[{"psi", "[", 
        RowBox[{"x", ",", "tau"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<SignedDensity\>\"", "->", 
       RowBox[{"signedDensity", "[", 
        RowBox[{"x", ",", "tau"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<CentralCoherence\>\"", "->", 
       RowBox[{"centralCoherence", "[", 
        RowBox[{"x", ",", "tau"}], "]"}]}]}], "\[IndentingNewLine]", "|>"}]}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<Upgraded OPF state:\>\"", ",", "Purple", ",", "Bold"}], 
     "]"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"opfState", "[", 
  RowBox[{"x", ",", "tau"}], "]"}]}], "Input",
 CellLabel->
  "In[278]:=",ExpressionUUID->"8053671f-acca-c946-9ca5-d60da4442e89"],

