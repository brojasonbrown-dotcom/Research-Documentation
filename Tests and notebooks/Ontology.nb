Cell[CellGroupData[{

Cell["1. Clear and redeclare symbols", "Section",ExpressionUUID->"d3198b79-9c0a-b543-9736-60cc212892c7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "x", ",", "y", ",", "z", ",", "tau", ",", "\[IndentingNewLine]", "  ", 
     "rho", ",", "nu", ",", "r", ",", "psi", ",", "\[IndentingNewLine]", "  ",
      "anisotropyVec", ",", "anisotropyTensor", ",", "\[IndentingNewLine]", 
     "  ", "signedDensity", ",", "centralCoherence", ",", 
     "\[IndentingNewLine]", "  ", "anisotropyScalarFromVector", ",", 
     "anisotropyScalarFromTensor", ",", "\[IndentingNewLine]", "  ", 
     "sourceOperator", ",", "voidOperator", ",", "measurementOperator", ",", 
     "restorationOperator", ",", "\[IndentingNewLine]", "  ", 
     "stationarySystem", ",", "dynamicSystem", ",", "balanceEquations", ",", 
     "\[IndentingNewLine]", "  ", "equilibriumRules", ",", "printTestResult", 
     ",", "\[IndentingNewLine]", "  ", "coords1D", ",", "coords3D"}], 
    "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Element", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z", ",", "tau"}], "}"}], ",", "Reals"}],
        "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], ">=", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"nu", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], ">=", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"r", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], ">", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Element", "[", 
       RowBox[{
        RowBox[{"psi", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", "Reals"}], "]"}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"printTestResult", "[", 
     RowBox[{"name_String", ",", "expr_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
