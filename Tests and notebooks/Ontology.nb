        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"x", ",", "tau"}], "]"}]}], ",", 
    RowBox[{"7", "\[Rule]", 
     RowBox[{
      SuperscriptBox["anisotropyVec3", 
