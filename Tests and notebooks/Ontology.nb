Cell[CellGroupData[{

Cell["3. Core state and coherence definitions", "Section",ExpressionUUID->"5414a0ae-3052-f846-bfca-64d25fc39a0b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"signedDensity", "[", 
     RowBox[{"x_", ",", "tau_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "tau"}], "]"}], "-", 
     RowBox[{"nu", "[", 
      RowBox[{"x", ",", "tau"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"centralCoherence", "[", 
     RowBox[{"x_", ",", "tau_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"psi", "[", 
      RowBox[{"x", ",", "tau"}], "]"}], "-", 
     RowBox[{"signedDensity", "[", 
      RowBox[{"x", ",", "tau"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"equilibriumRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"psi", "[", 
       RowBox[{"x", ",", "tau"}], "]"}], "->", 
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], "-", 
       RowBox[{"nu", "[", 
        RowBox[{"x", ",", "tau"}], "]"}]}]}], "\[IndentingNewLine]", "}"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<Upgrade 1 / Section 3 complete: signed density and \
coherence retained.\>\"", ",", 
      RowBox[{"Darker", "[", "Green", "]"}], ",", "Bold"}], "]"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"printTestResult", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{"\"\<Central coherence vanishes under equilibrium rule\>\"", ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"centralCoherence", "[", 
