      AbsoluteThickness[1]],
    GridBoxDividers->{
     "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
    GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
   "Grid"]], "Text", "MarkdownDelimiter",
  ShowStringCharacters->False,
  Background->None,ExpressionUUID->"0bdba7c1-414a-5244-a6c8-ca46b665e575"],
 "\n9. Finite-dimensional reduced model for simulation\nTo obtain concrete \
plots, we now reduce the PDE-like symbolic fields to a spatially local ODE \
model by fixing a point or assuming local homogeneity. \n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
     "rhoVar", ",", "nuVar", ",", "psiVar", ",", "rVar", ",", "a1Var", ",", 
      "a2Var", ",", "a3Var", ",", "\[IndentingNewLine]", "  ", "aMagVar", ",",
       "odeSystem", ",", "params"}], "\[IndentingNewLine]", "]"}], ";"}], 
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"aMagVar", "[", 
      RowBox[{"a1_", ",", "a2_", ",", "a3_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"a1", "^", "2"}], "+", 
       RowBox[{"a2", "^", "2"}], "+", 
       RowBox[{"a3", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"odeSystem", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"rhoVar", "'"}], "[", "tau", "]"}], "==", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"rhoVar", "[", "tau", "]"}], "-", 
          RowBox[{"nuVar", "[", "tau", "]"}]}], ")"}], "+", 
        RowBox[{
         RowBox[{"aMagVar", "[", 
          RowBox[{
           RowBox[{"a1Var", "[", "tau", "]"}], ",", 
           RowBox[{"a2Var", "[", "tau", "]"}], ",", 
           RowBox[{"a3Var", "[", "tau", "]"}]}], "]"}], " ", 
         RowBox[{"rVar", "[", "tau", "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"nuVar", "'"}], "[", "tau", "]"}], "==", 
       RowBox[{
        RowBox[{"nuVar", "[", "tau", "]"}], "-", 
        RowBox[{
         RowBox[{"aMagVar", "[", 
          RowBox[{
           RowBox[{"a1Var", "[", "tau", "]"}], ",", 
           RowBox[{"a2Var", "[", "tau", "]"}], ",", 
           RowBox[{"a3Var", "[", "tau", "]"}]}], "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"rhoVar", "[", "tau", "]"}], "-", 
           RowBox[{"nuVar", "[", "tau", "]"}]}], ")"}]}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"psiVar", "'"}], "[", "tau", "]"}], "==", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"aMagVar", "[", 
           RowBox[{
            RowBox[{"a1Var", "[", "tau", "]"}], ",", 
            RowBox[{"a2Var", "[", "tau", "]"}], ",", 
            RowBox[{"a3Var", "[", "tau", "]"}]}], "]"}]}], ")"}], " ", 
        RowBox[{"psiVar", "[", "tau", "]"}], " ", 
        RowBox[{"rVar", "[", "tau", "]"}]}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"rVar", "'"}], "[", "tau", "]"}], "==", 
       RowBox[{
        RowBox[{"psiVar", "[", "tau", "]"}], "-", 
        RowBox[{"rhoVar", "[", "tau", "]"}], "+", 
        RowBox[{"nuVar", "[", "tau", "]"}]}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"a1Var", "'"}], "[", "tau", "]"}], "==", 
       RowBox[{
        RowBox[{"rhoVar", "[", "tau", "]"}], "-", 
        RowBox[{"nuVar", "[", "tau", "]"}]}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"a2Var", "'"}], "[", "tau", "]"}], "==", 
       RowBox[{
        RowBox[{"rhoVar", "[", "tau", "]"}], "-", 
        RowBox[{"nuVar", "[", "tau", "]"}]}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"a3Var", "'"}], "[", "tau", "]"}], "==", 
       RowBox[{
        RowBox[{"rhoVar", "[", "tau", "]"}], "-", 
        RowBox[{"nuVar", "[", "tau", "]"}]}]}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}]}], "Input",ExpressionUUID->
  "0a23300f-43d4-c54a-83cc-5930988e2ade"],
