Cell[CellGroupData[{

Cell["2. Define anisotropy fields", "Section",ExpressionUUID->"f433e482-450d-0e46-881c-50ce420ad87a"],

Cell[TextData[{
 "We replace scalar ",
 Cell[BoxData[Cell["a[x,tau]",
   Background->None,ExpressionUUID->"0a8ff045-1d85-7543-87c4-3c5e87b7899e"]], 
  "InlineCode",ExpressionUUID->"35d5aff9-3a1b-4145-a8a5-e5e72fa0fab0"],
 " by two possible anisotropy carriers: "
}], "Text",ExpressionUUID->"387a49d1-dac0-0646-a8d7-15520f0a5434"],

Cell[TextData[{
 "vector form: ",
 Cell[BoxData[Cell["anisotropyVec[x,tau]",
   Background->None,ExpressionUUID->"5415a5d8-7711-d245-bede-34e686122c34"]], 
  "InlineCode",ExpressionUUID->"11c2dd74-a2a1-364b-949b-01777718d2f4"]
}], "Item",ExpressionUUID->"b42b30bf-9ab6-8d4e-9c5a-81f1492b723c"],

Cell[TextData[{
 "tensor form: ",
 Cell[BoxData[Cell["anisotropyTensor[x,tau]",
   Background->None,ExpressionUUID->"70a76300-3496-f841-adf4-5305d8657bce"]], 
  "InlineCode",ExpressionUUID->"0c0492e6-4516-e940-9742-877ca97e8c0c"]
}], "Item",ExpressionUUID->"1e9049e5-c6a4-c842-9c42-0500460c96c0"],

Cell["\<\
For practical symbolic closure, we derive scalar invariants: \
\>", "Text",ExpressionUUID->"63a07b45-1bf6-1f44-ad05-8254f4b632f7"],

Cell[TextData[{
 "vector-induced scalar: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["v", "TI"]], "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            StyleBox["a", FontSlant -> "Bold"], "\[CenterDot]", 
            StyleBox["a", FontSlant -> "Bold"]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "a_v = \\sqrt{\\mathbf a \\cdot \\mathbf a}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "40330df1-7208-144d-b5ad-67dc932d488b"]
}], "Item",ExpressionUUID->"b6ee20dc-0f18-a44c-9015-7169f77b670c"],

Cell[TextData[{
 "tensor-induced scalar: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["T", "TI"]], "\[LongEqual]", 
         StyleBox["Tr", FontSlant -> "Plain"], 
         RowBox[{"(", 
           StyleBox["A", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "a_T = \\mathrm{Tr}(A)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e43872ae-253e-c646-a639-c5cbd8005215"]
}], "Item",ExpressionUUID->"bb0f4c37-f0d2-5c49-af9d-d4824a94d8ab"],

Cell["\<\
These are prototype scalarizations, kept explicit so they can later be \
replaced. \
\>", "Text",ExpressionUUID->"ee057f58-bc7f-2b4a-926f-3ea37cd79931"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"anisotropyVec", "[", 
     RowBox[{"x_", ",", "tau_"}], "]"}], ":=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"anisotropyVec1", "[", 
       RowBox[{"x", ",", "tau"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
