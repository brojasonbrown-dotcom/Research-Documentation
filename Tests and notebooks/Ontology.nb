Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"rho\"\>", "\[Rule]", 
    RowBox[{"rho", "[", 
     RowBox[{"x", ",", "tau"}], "]"}]}], ",", 
   RowBox[{"\<\"nu\"\>", "\[Rule]", 
    RowBox[{"nu", "[", 
     RowBox[{"x", ",", "tau"}], "]"}]}], ",", 
   RowBox[{"\<\"anisotropyVector\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"anisotropyVec1", "[", 
       RowBox[{"x", ",", "tau"}], "]"}], ",", 
      RowBox[{"anisotropyVec2", "[", 
       RowBox[{"x", ",", "tau"}], "]"}], ",", 
      RowBox[{"anisotropyVec3", "[", 
       RowBox[{"x", ",", "tau"}], "]"}]}], "}"}]}], ",", 
   RowBox[{"\<\"anisotropyTensor\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"anisotropyTensor11", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", 
        RowBox[{"anisotropyTensor12", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", 
        RowBox[{"anisotropyTensor13", "[", 
         RowBox[{"x", ",", "tau"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"anisotropyTensor21", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", 
        RowBox[{"anisotropyTensor22", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", 
        RowBox[{"anisotropyTensor23", "[", 
         RowBox[{"x", ",", "tau"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"anisotropyTensor31", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", 
        RowBox[{"anisotropyTensor32", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], ",", 
        RowBox[{"anisotropyTensor33", "[", 
         RowBox[{"x", ",", "tau"}], "]"}]}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"anisotropyScalarFromVector\"\>", "\[Rule]", 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"anisotropyVec1", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"anisotropyVec2", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], "2"], "+", 
      SuperscriptBox[
       RowBox[{"anisotropyVec3", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], "2"]}]]}], ",", 
   RowBox[{"\<\"anisotropyScalarFromTensor\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"anisotropyTensor11", "[", 
      RowBox[{"x", ",", "tau"}], "]"}], "+", 
     RowBox[{"anisotropyTensor22", "[", 
      RowBox[{"x", ",", "tau"}], "]"}], "+", 
     RowBox[{"anisotropyTensor33", "[", 
      RowBox[{"x", ",", "tau"}], "]"}]}]}], ",", 
   RowBox[{"\<\"r\"\>", "\[Rule]", 
    RowBox[{"r", "[", 
     RowBox[{"x", ",", "tau"}], "]"}]}], ",", 
   RowBox[{"\<\"psi\"\>", "\[Rule]", 
    RowBox[{"psi", "[", 
     RowBox[{"x", ",", "tau"}], "]"}]}], ",", 
   RowBox[{"\<\"SignedDensity\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"nu", "[", 
       RowBox[{"x", ",", "tau"}], "]"}]}], "+", 
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "tau"}], "]"}]}]}], ",", 
   RowBox[{"\<\"CentralCoherence\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"nu", "[", 
      RowBox[{"x", ",", "tau"}], "]"}], "+", 
     RowBox[{"psi", "[", 
      RowBox[{"x", ",", "tau"}], "]"}], "-", 
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "tau"}], "]"}]}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.0014220673832493`*^9, 4.0014221363673306`*^9, 
