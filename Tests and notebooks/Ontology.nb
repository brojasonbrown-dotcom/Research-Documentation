  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "d83e9abb-d9fc-a441-b73d-28cdb81f3df5"],
 " as a tensor scalarization"
}], "Item",ExpressionUUID->"14f32f32-65a8-b84b-873a-e508585e90ed"],

