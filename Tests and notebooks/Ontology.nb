      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"name", " ", "<>", " ", "\"\<:\>\""}], ",", "Bold", ",", 
           "Blue"}], "]"}], ",", "\"\< \>\"", ",", "res"}], "]"}], ";", 
       "\[IndentingNewLine]", "  ", "res"}]}], "\[IndentingNewLine]", "]"}]}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords1D", "=", 
   RowBox[{"{", "x", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coords3D", "=", 
