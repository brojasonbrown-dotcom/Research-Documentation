   RowBox[{"test1", "=", 
    RowBox[{"printTestResult", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Test 1: signed density definition\>\"", ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"signedDensity", "[", 
        RowBox[{"x", ",", "tau"}], "]"}], "==", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "tau"}], "]"}], "-", 
        RowBox[{"nu", "[", 
         RowBox[{"x", ",", "tau"}], "]"}]}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
