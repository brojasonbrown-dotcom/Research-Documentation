         RowBox[{"anisotropyVec1", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"anisotropyVec2", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"anisotropyVec3", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], "2"]}]], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"nu", "[", 
          RowBox[{"x", ",", "tau"}], "]"}]}], "+", 
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "tau"}], "]"}]}], ")"}]}]}], "\[Equal]", "0"}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"nu", "[", 
      RowBox[{"x", ",", "tau"}], "]"}], "+", 
     RowBox[{"psi", "[", 
      RowBox[{"x", ",", "tau"}], "]"}], "-", 
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "tau"}], "]"}]}], "\[Equal]", "0"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{4.0014220673412476`*^9, 4.001422136309332*^9, 
  4.0014267357124443`*^9},
