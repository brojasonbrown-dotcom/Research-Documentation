     RowBox[{"anisotropyTensor", "[", 
      RowBox[{"x", ",", "tau"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<Upgrade 1 / Section 2 complete: anisotropy vector and \
tensor fields defined.\>\"", ",", 
      RowBox[{"Darker", "[", "Green", "]"}], ",", "Bold"}], "]"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", 
