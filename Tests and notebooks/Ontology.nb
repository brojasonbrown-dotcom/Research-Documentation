 "\n5. Dynamic system and corrected balance-law derivation\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"dynamicSystem", ",", "anisotropyDynamics", ",", "rhsRules"}], 
     "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"anisotropyDynamics", "[", 
      RowBox[{"x_", ",", "tau_"}], "]"}], ":=", 
     RowBox[{"Thread", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"anisotropyVec", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"signedDensity", "[", 
          RowBox[{"x", ",", "tau"}], "]"}], ",", "3"}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dynamicSystem", "=", 
     RowBox[{"Join", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"rho", "[", 
             RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
          RowBox[{"sourceOperator", "[", 
           RowBox[{"x", ",", "tau"}], "]"}]}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"nu", "[", 
             RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
          RowBox[{"voidOperator", "[", 
           RowBox[{"x", ",", "tau"}], "]"}]}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"psi", "[", 
             RowBox[{"x", ",", "tau"}], "]"}], ",", "tau"}], "]"}], "==", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"measurementOperator", "[", 
             RowBox[{"x", ",", "tau"}], "]"}]}], "+", 
           RowBox[{"restorationOperator", "[", 
            RowBox[{"x", ",", "tau"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{
          RowBox[{"D", "[", 
