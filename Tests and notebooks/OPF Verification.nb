Cell[CellGroupData[{

Cell["2. Formal axiomatization", "Section",ExpressionUUID->"2b40172e-c9ac-0641-bf84-cbf261f0e641"],

Cell[CellGroupData[{

Cell["2.1 Layer L0: topological substrate", "Subsection",ExpressionUUID->"ade52fb7-c0b8-2547-9d6f-927144c24078"],

Cell[TextData[{
 "The background layer is represented as a sphere with a distinguished \
boundary duality between limiting vertex markers 0 and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Infinity]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\infty", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e86b1806-c378-f145-82fd-31b76e6907c5"],
 ". "
}], "Text",ExpressionUUID->"98a9bf68-0362-d549-a7e6-446c9afa62c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"l0Topology", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\"\<UnderlyingManifold\>\"", "->", 
      RowBox[{"Sphere", "[", "]"}]}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<BoundaryDuality\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"DirectedInfinity", "[", "1", "]"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<TemporalMode\>\"", "->", "\"\<Timeless\>\""}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<Substrate\>\"", "->", "\"\<EmptySpacetime\>\""}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",ExpressionUUID->\
"3663f72d-740c-a849-bcac-f98559cfbf71"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2 Layer L1: field variables and action density", "Subsection",ExpressionUUID->"65a6e184-178b-a94c-bb51-9f7bd352f89e"],

Cell["Introduce three scalar fields/parameters: ", "Text",ExpressionUUID->"311157a8-540a-9d43-ba2c-92f03698e840"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Rho]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8b82dc48-9b74-b648-8030-d3f777269ac4"],
 ": information density,"
}], "Item",ExpressionUUID->"c76584aa-2208-4540-8c2d-a5ffe6ea5109"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Chi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\chi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1fe8910c-9630-5f4c-9141-42bab23cdd13"],
 ": field complexity,"
}], "Item",ExpressionUUID->"1d7bfe09-45ad-8542-a143-c43c0897a47c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "edf93548-ec03-824d-a54b-52e8cd66c306"],
 ": observational resolution."
}], "Item",ExpressionUUID->"28866453-375f-3e46-945b-a8cac023539e"],

Cell[TextData[{
 "The proposed action density is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"]}], ")"}], "\[LongEqual]", "\[Rho]", "log", 
         RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{L}(\\rho,\\chi,R)=\\rho\\log(\\chi)+\\chi R^2.", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fffe6f6c-8758-2741-8a2e-c41d7ffbd111"],
 "To make variational analysis rigorous, we allow the quantities to depend on \
coordinates. We begin with the one-dimensional base case and then state the \
multidimensional extension. "
}], "Text",ExpressionUUID->"713e920f-c0aa-0147-a512-d1ca0531ec86"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"\[Rho]f", ",", "\[Chi]f", ",", "Rf", ",", "x", ",", "t"}], "]"}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lagrangian1D", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]f", "[", "x", "]"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"\[Chi]f", "[", "x", "]"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"\[Chi]f", "[", "x", "]"}], " ", 
     RowBox[{
      RowBox[{"Rf", "[", "x", "]"}], "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"action1D", "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"lagrangian1D", "[", "x", "]"}], ",", "x"}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"9c066fcd-fa89-a341-adfd-b2ffc4fd2b64"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.3 Layer L2: maintained physical sector", "Subsection",ExpressionUUID->"8208659f-6dbd-d146-bd8e-cea44b53085d"],

Cell[TextData[{
 "The maintenance law is specified as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["u", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "+", "\[CapitalGamma]", 
         StyleBox["u", "TI"], "\[LongEqual]", "0", ","}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\frac{d u}{dt}+\\Gamma u=0,", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f86ae0ca-980a-c549-bb6f-f8038f784485"],
 "with exact solution ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["u", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", "\[Nu]", 
         RowBox[{"(", "0", ")"}], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", "\[CapitalGamma]", 
            StyleBox["t", "TI"]}]], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "u(t)=\\nu(0)e^{-\\Gamma t}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1e5b3a46-d68b-8a4d-b566-0b476f76aee5"],
 "We encode this as a general maintenance operator acting on a time-dependent \
quantity. "
}], "Text",ExpressionUUID->"e905f2c6-c3ac-d941-9752-31987ffab262"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"maintenanceOperator", ",", "maintainedSolution", ",", "u"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"maintenanceOperator", "[", "expr_", "]"}], ":=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"expr", ",", "t"}], "]"}], "+", 
    RowBox[{"\[CapitalGamma]", " ", "expr"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"maintainedSolution", "=", 
  RowBox[{
   RowBox[{"DSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"maintenanceOperator", "[", 
         RowBox[{"u", "[", "t", "]"}], "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"u", "[", "0", "]"}], "==", "u0"}]}], "}"}], ",", "u", ",", 
     "t"}], "]"}], " ", "//", " ", "FullSimplify"}]}]}], "Input",ExpressionUUI\
D->"8523f717-6c6a-2641-8cce-27fc094ed771"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
