Cell[CellGroupData[{

Cell["16. Review pass III: perturbative audit", "Section",ExpressionUUID->"d970b954-9c13-b443-9ba7-6be649af196e"],

Cell[TextData[{
 "Introduce infinitesimal perturbations about the exact stationary point: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[Rho]", "\[LongEqual]", "\[Delta]\[Rho]", ",    ", "\[Chi]", 
         "\[LongEqual]", "1", "+", "\[Delta]\[Chi]", ",    ", 
         StyleBox["R", "TI"], "\[LongEqual]", "\[Delta]", 
         StyleBox["R", "TI"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\rho = \\delta\\rho,\\qquad \\chi = 1 + \\delta\\chi,\\qquad R = \
\\delta R.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f5dc0cb8-1d1f-9442-ba01-c391f65c91aa"],
 "Expand the stationarity map to first order. "
}], "Text",ExpressionUUID->"58c295e2-900f-d143-be87-34cab1e01f24"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "\[Delta]\[Rho]", ",", "\[Delta]\[Chi]", ",", "\[Delta]R", ",", 
    "perturbativeExpansion"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"perturbativeExpansion", "=", 
  RowBox[{
   RowBox[{"Normal", "@", 
    RowBox[{"Series", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"stationarityMap", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Rho]", "->", "\[Delta]\[Rho]"}], ",", 
         RowBox[{"\[Chi]", "->", 
          RowBox[{"1", "+", "\[Delta]\[Chi]"}]}], ",", 
         RowBox[{"R", "->", "\[Delta]R"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"{", 
       RowBox[{"\[Delta]\[Rho]", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Delta]\[Chi]", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Delta]R", ",", "0", ",", "1"}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}], " ", "//", " ", 
   "FullSimplify"}]}]}], "Input",ExpressionUUID->"9245631e-da7d-5840-8d04-\
65b63524f2c8"],

Cell["\<\
This should coincide with multiplication by the linearized matrix. \
\>", "Text",ExpressionUUID->"b23ee083-dc93-e642-b438-30b734a4290a"],

Cell[BoxData[
 RowBox[{"linearCheck", "=", 
  RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
   RowBox[{
    RowBox[{"linearizedMatrix", " ", ".", " ", 
     RowBox[{"{", 
      RowBox[{"\[Delta]\[Rho]", ",", "\[Delta]\[Chi]", ",", "\[Delta]R"}], 
      "}"}]}], "==", "perturbativeExpansion"}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",ExpressionUUID->"de1fa73a-cc02-594e-99c8-ac022fc1595c"],

