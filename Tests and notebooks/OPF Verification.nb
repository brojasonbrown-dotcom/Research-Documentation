Cell[CellGroupData[{

Cell["18. Review pass V: model classification", "Section",ExpressionUUID->"ce1c5bf5-888c-054c-85fa-c0630a660805"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "modelClassification", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"modelClassification", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<MathematicalType\>\"", 
      "->", "\"\<Algebraic variational model with auxiliary first-order decay \
law\>\""}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<StationarySector\>\"", "->", "\"\<Exactly solvable\>\""}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<PropagatingModes\>\"", 
      "->", "\"\<Not derivable from supplied action\>\""}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<StrictOriginalConstraints\>\"", 
      "->", "\"\<Incompatible with nontrivial stationary solution\>\""}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<MinimalConsistentStationaryPoint\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Rho]", "->", "0"}], ",", 
        RowBox[{"\[Chi]", "->", "1"}], ",", 
        RowBox[{"R", "->", "0"}]}], "}"}]}]}], "\[IndentingNewLine]", 
    "|>"}]}], ";"}]}], "Input",ExpressionUUID->"492ee5b3-1da0-e446-b445-\
b0cf4268f8cc"],

