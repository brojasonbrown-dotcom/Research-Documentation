Cell[CellGroupData[{

Cell["19. Optional extension template for a true field theory", "Section",ExpressionUUID->"d3c97da6-ad78-cc4d-829c-7f177e0908fe"],

Cell[TextData[{
 "If one wishes to obtain genuine PDEs and a nontrivial spectral problem, \
gradient or kinetic terms must be added. This section is a ",
 StyleBox["template only",
  FontWeight->Bold],
 " and is clearly separated from the supplied model."
}], "Text",ExpressionUUID->"1713527e-11bf-a04e-a27d-4e2dd3249b46"],

Cell[TextData[{
 "For example, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["ext", FontSlant -> "Plain"]], "\[LongEqual]", "\[Rho]", 
         "log", 
         RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "+", 
         FractionBox[
          SubscriptBox[
           StyleBox["a", "TI"], "\[Rho]"], "2"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"\[Del]", "\[Rho]"}], ")"}], "2"], "+", 
         FractionBox[
          SubscriptBox[
           StyleBox["a", "TI"], "\[Chi]"], "2"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"\[Del]", "\[Chi]"}], ")"}], "2"], "+", 
         FractionBox[
          SubscriptBox[
           StyleBox["a", "TI"], 
           StyleBox["R", "TI"]], "2"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"\[Del]", 
              StyleBox["R", "TI"]}], ")"}], "2"], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathcal{L}_{\\mathrm{ext}} = \\rho\\log(\\chi)+\\chi R^2 + \
\\frac{a_\\rho}{2}(\\nabla\\rho)^2 + \\frac{a_\\chi}{2}(\\nabla\\chi)^2 + \
\\frac{a_R}{2}(\\nabla R)^2.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d6eb6928-ec68-4640-8800-38054152189f"]
}], "Text",ExpressionUUID->"746cb20d-9add-4f48-bda0-5130d167890f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "a\[Rho]", ",", "a\[Chi]", ",", "aR", ",", "\[Rho]x", ",", "\[Chi]x", ",", 
    "Rx", ",", "\[ScriptCapitalL]ext"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalL]ext", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Rho]x", "[", "x", "]"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"\[Chi]x", "[", "x", "]"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"\[Chi]x", "[", "x", "]"}], " ", 
      RowBox[{
       RowBox[{"Rx", "[", "x", "]"}], "^", "2"}]}], "+", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"a\[Rho]", "/", "2"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Rho]x", "'"}], "[", "x", "]"}], ")"}], "^", "2"}]}], "+", 
     RowBox[{
      RowBox[{"a\[Chi]", "/", "2"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Chi]x", "'"}], "[", "x", "]"}], ")"}], "^", "2"}]}], "+", 
     RowBox[{
      RowBox[{"aR", "/", "2"}], " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Rx", "'"}], "[", "x", "]"}], ")"}], "^", "2"}]}]}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"extendedEulerLagrange", "=", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"\[ScriptCapitalL]ext", ",", 
        RowBox[{"\[Rho]x", "[", "x", "]"}]}], "]"}], "-", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"\[ScriptCapitalL]ext", ",", 
          RowBox[{
           RowBox[{"\[Rho]x", "'"}], "[", "x", "]"}]}], "]"}], ",", "x"}], 
       "]"}]}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"\[ScriptCapitalL]ext", ",", 
        RowBox[{"\[Chi]x", "[", "x", "]"}]}], "]"}], "-", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"\[ScriptCapitalL]ext", ",", 
          RowBox[{
           RowBox[{"\[Chi]x", "'"}], "[", "x", "]"}]}], "]"}], ",", "x"}], 
       "]"}]}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"\[ScriptCapitalL]ext", ",", 
        RowBox[{"Rx", "[", "x", "]"}]}], "]"}], "-", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"\[ScriptCapitalL]ext", ",", 
          RowBox[{
           RowBox[{"Rx", "'"}], "[", "x", "]"}]}], "]"}], ",", "x"}], 
       "]"}]}]}], "\[IndentingNewLine]", "}"}], " ", "//", " ", 
   "FullSimplify"}]}]}], "Input",ExpressionUUID->"3ee815f4-a6aa-c34e-bd4e-\
ccc67f830410"],

Cell["\<\
This section is not part of the original model; it only demonstrates the \
mathematical mechanism required for a genuine field equation. \
\>", "Text",ExpressionUUID->"fbf86204-6715-524e-8a00-7c5010e6b8ad"],

