   RowBox[{"domainCompatibilityAudit", ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<\[Chi]PositivityNeededForLog\>\"", "->", 
       RowBox[{"Simplify", "[", 
        RowBox[{"\[Chi]", ">", "0"}], "]"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<StrictRPositivityCompatibleWithStationarity\>\"", "->", 
       RowBox[{"stationarySolutions", "=!=", "False"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<RelaxedRNonnegativityCompatibleWithStationarity\>\"", "->", 
       RowBox[{"stationarySolutionsRelaxed", "=!=", "False"}]}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", \
