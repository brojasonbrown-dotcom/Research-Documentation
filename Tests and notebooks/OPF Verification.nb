Cell[CellGroupData[{

Cell["13. Consistency diagnostics report", "Section",ExpressionUUID->"172218f9-5100-a640-8abd-1a3806419d7a"],

Cell["Assemble a structured summary. ", "Text",ExpressionUUID->"3977e48b-9315-d34d-b88b-a26dced367cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "diagnosticReport", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"diagnosticReport", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<ActionDensity\>\"", "->", "\[ScriptCapitalL]"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<EulerLagrangeEquations\>\"", "->", 
       RowBox[{"{", "\[IndentingNewLine]", "     ", 
        RowBox[{
         RowBox[{
          RowBox[{"Log", "[", "\[Chi]", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", "     ", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Rho]", "/", "\[Chi]"}], "+", 
           RowBox[{"R", "^", "2"}]}], "==", "0"}], ",", "\[IndentingNewLine]",
          "     ", 
         RowBox[{
          RowBox[{"2", " ", "\[Chi]", " ", "R"}], "==", "0"}]}], 
        "\[IndentingNewLine]", "   ", "}"}]}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"\"\<StrictConstraintConsistency\>\"", "->", 
       "stationarySolutions"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<RelaxedConstraintConsistency\>\"", "->", 
       "stationarySolutionsRelaxed"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<ExactStationaryPoint\>\"", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Rho]", "->", "0"}], ",", 
         RowBox[{"\[Chi]", "->", "1"}], ",", 
         RowBox[{"R", "->", "0"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"\"\<LinearizedEigenvalues\>\"", "->", 
       RowBox[{"Eigenvalues", "[", "linearizedMatrix", "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<StableHarmonicModes\>\"", "->", "stableModes"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<MaintenanceLawSolution\>\"", "->", "maintenanceSolution"}],
       ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<MaintenanceVerification\>\"", "->", 
       "maintenanceVerification"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<StationaryVerification\>\"", "->", 
       "stationaryVerification"}]}], "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"diagnosticReport", " ", "//", " ", "Dataset"}]}], "Input",Expression\
UUID->"fffe6167-d538-6f40-9dd2-218832e75fc9"],

