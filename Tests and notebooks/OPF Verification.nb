Cell[CellGroupData[{

Cell["1. Notebook setup", "Section",ExpressionUUID->"77395706-2248-804c-83c7-bc3aeecfb586"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "x", ",", "y", ",", "z", ",", "r", ",", "t", ",", "\[Rho]", ",", 
         "\[Chi]", ",", "R", ",", "\[CapitalGamma]", ",", "\[Lambda]", ",", 
         "\[Omega]"}], "}"}], ",", "Reals"}], "]"}], "&&", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"R", ">", "0"}], "&&", 
     RowBox[{"\[Chi]", ">", "0"}], "&&", 
     RowBox[{"\[CapitalGamma]", ">=", "0"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetOptions", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Integrate", ",", "DSolve", ",", "Reduce", ",", "FullSimplify", ",", 
      "Simplify", ",", "Eigenvalues", ",", "Eigensystem"}], "}"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
   "]"}], ";"}]}], "Input",ExpressionUUID->"c134f97c-dde2-0540-b2a6-\
4c8a66b7c11f"],

Cell[CellGroupData[{

Cell["Precision policy", "Subsection",ExpressionUUID->"ef7a2c2d-9c95-a04d-aa74-f585eb429710"],

Cell["\<\
The framework requests exact or arbitrarily high precision methods whenever \
possible. Since literal infinite machine precision is not an executable \
numerical setting, the notebook adopts the mathematically correct substitute: \
\>", "Text",ExpressionUUID->"30071613-8083-3047-9b64-0d4517c69311"],

Cell["exact symbolic computation first,", "Item",ExpressionUUID->"feef8af7-9ebf-8444-a619-4927f6b1ad76"],

Cell["arbitrary precision numerical computation second,", "Item",ExpressionUUID->"399db1d5-86c6-8649-958d-de0fac024ed6"],

Cell[CellGroupData[{

Cell["explicit residual certification for any numerical result.", "Item",ExpressionUUID->"eb7ab5c3-bcf2-034d-84bc-59d1aa87d206"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"precisionGoal", "=", "80"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"workingPrecision", "=", "120"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"accuracyGoal", "=", "80"}], ";"}]}], "Input",ExpressionUUID->\
"7c3822f9-7f34-4e4d-9532-6c796d98fe7f"]
}, Open  ]],

