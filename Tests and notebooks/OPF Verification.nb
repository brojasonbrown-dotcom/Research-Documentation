Cell["3. Variational derivation", "Section",ExpressionUUID->"1f1feca6-0772-4d4d-8cc8-f1751eca2943"],

Cell[CellGroupData[{

Cell["3.1 Euler--Lagrange analysis for the supplied action", "Section",ExpressionUUID->"ad85ce57-a496-7846-8cd2-e203408e8743"],

Cell["\<\
Because the proposed Lagrangian contains no derivatives of the fields, the \
Euler--Lagrange equations reduce to algebraic stationarity conditions. \
\>", "Text",ExpressionUUID->"8718283a-0057-f64b-bf38-6c4bc251877c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"eL\[Rho]", ",", "eL\[Chi]", ",", "eLR"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eL\[Rho]", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"lagrangian1D", "[", "x", "]"}], ",", 
       RowBox[{"\[Rho]f", "[", "x", "]"}]}], "]"}], "==", "0"}], " ", "//", 
    " ", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eL\[Chi]", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"lagrangian1D", "[", "x", "]"}], ",", 
       RowBox[{"\[Chi]f", "[", "x", "]"}]}], "]"}], "==", "0"}], " ", "//", 
    " ", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eLR", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"lagrangian1D", "[", "x", "]"}], ",", 
        RowBox[{"Rf", "[", "x", "]"}]}], "]"}], "==", "0"}], " ", "//", " ", 
     "FullSimplify"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"eL\[Rho]", ",", "eL\[Chi]", ",", "eLR"}], "}"}]}], "Input",Expressi\
onUUID->"f2165d0e-66bf-9e42-a594-8f27be03d60e"],

Cell[TextData[{
 "Expected symbolic form: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"log", 
         RowBox[{"(", "\[Chi]", ")"}], "\[LongEqual]", "0", ",    ", 
         FractionBox["\[Rho]", "\[Chi]"], "+", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "\[LongEqual]", "0", ",    ", "2", 
         "\[Chi]", 
         StyleBox["R", "TI"], "\[LongEqual]", "0."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\log(\\chi)=0,\\qquad \\frac{\\rho}{\\chi}+R^2=0,\\qquad 2\\chi R=0.", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "29ece89a-afe2-9644-af1c-da47a5ee502b"]
}], "Text",ExpressionUUID->"0cc6e7cc-ac60-af48-8b17-c9f8ef136fd3"],

Cell[CellGroupData[{

Cell["3.2 Exact stationary solutions", "Subsection",ExpressionUUID->"429f1865-8a97-2941-b984-a485a1060b5e"],

Cell["Solve the stationarity system exactly. ", "Text",ExpressionUUID->"6b433782-b426-fe48-ae60-188d739b5104"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "stationarySolutions", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"stationarySolutions", "=", 
  RowBox[{
   RowBox[{"Reduce", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", "\[Chi]", "]"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Rho]", "/", "\[Chi]"}], "+", 
         RowBox[{"R", "^", "2"}]}], "==", "0"}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{
        RowBox[{"2", " ", "\[Chi]", " ", "R"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"\[Chi]", ">", "0"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"R", ">", "0"}]}], "\[IndentingNewLine]", "   ", "}"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"\[Rho]", ",", "\[Chi]", ",", "R"}], "}"}], ",", 
     "\[IndentingNewLine]", "   ", "Reals", ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"MaxExtraConditions", "->", "All"}]}], "\[IndentingNewLine]", 
    "]"}], " ", "//", " ", "FullSimplify"}]}]}], "Input",ExpressionUUID->\
"c8a60a64-f299-8b4a-974a-89ed5b21f43a"],

Cell["\<\
This test is crucial: it determines whether the stated positivity constraints \
are compatible with the variational equations. \
\>", "Text",ExpressionUUID->"1505080c-e429-a948-a498-0ba2a474d3ec"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.3 Constraint-relaxed analysis", "Subsection",ExpressionUUID->"e7dc8310-ed9a-e449-bef0-5756b3fe9aa1"],

Cell[TextData[{
 "If the positivity condition on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2ee844ba-596e-6c42-89c5-ef02e89ebf40"],
 " is relaxed to allow ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "R=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0435aa02-d023-f648-b1a7-603b0742ee2e"],
 ", recompute the exact stationary set. "
}], "Text",ExpressionUUID->"321e948c-da79-cd4e-b3dc-02574f4f2035"],

Cell[BoxData[
 RowBox[{"stationarySolutionsRelaxed", "=", 
  RowBox[{
   RowBox[{"Reduce", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", "\[Chi]", "]"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Rho]", "/", "\[Chi]"}], "+", 
         RowBox[{"R", "^", "2"}]}], "==", "0"}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{
        RowBox[{"2", " ", "\[Chi]", " ", "R"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"\[Chi]", ">", "0"}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"R", ">=", "0"}]}], "\[IndentingNewLine]", "   ", "}"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"\[Rho]", ",", "\[Chi]", ",", "R"}], "}"}], ",", 
     "\[IndentingNewLine]", "   ", "Reals", ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"MaxExtraConditions", "->", "All"}]}], "\[IndentingNewLine]", 
    "]"}], " ", "//", " ", "FullSimplify"}]}]], "Input",ExpressionUUID->\
"b21d126e-010e-3f4b-a9fd-52c7dd2db476"],

