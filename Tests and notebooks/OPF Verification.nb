Cell[CellGroupData[{

Cell["22. Exportable summary object", "Section",ExpressionUUID->"5ffe7cfb-4959-b74b-aa02-f05ff834e4a2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "opfSummary", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"opfSummary", "[", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Topology\>\"", "->", "l0Topology"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ActionDensity\>\"", "->", "\[ScriptCapitalL]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<StationaryEquations\>\"", "->", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"Log", "[", "\[Chi]", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Rho]", "/", "\[Chi]"}], "+", 
           RowBox[{"R", "^", "2"}]}], "==", "0"}], ",", "\[IndentingNewLine]",
          "    ", 
         RowBox[{
          RowBox[{"2", " ", "\[Chi]", " ", "R"}], "==", "0"}]}], 
        "\[IndentingNewLine]", "  ", "}"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<StrictConsistency\>\"", "->", "stationarySolutions"}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<RelaxedConsistency\>\"", "->", 
       "stationarySolutionsRelaxed"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<StationaryPoint\>\"", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Rho]", "->", "0"}], ",", 
         RowBox[{"\[Chi]", "->", "1"}], ",", 
         RowBox[{"R", "->", "0"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<LinearizedMatrix\>\"", "->", "linearizedMatrix"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<LinearizedEigenvalues\>\"", "->", 
       RowBox[{"Eigenvalues", "[", "linearizedMatrix", "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<StableModes\>\"", "->", "stableModes"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<MaintenanceSolution\>\"", "->", "maintenanceSolution"}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Diagnostics\>\"", "->", "diagnosticReport"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Classification\>\"", "->", "modelClassification"}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"opfSummary", "[", "]"}]}], "Input",ExpressionUUID->"90ff1395-aaef-\
f048-852a-632d8af39f84"],

