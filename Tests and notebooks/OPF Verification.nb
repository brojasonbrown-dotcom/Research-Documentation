 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"45d28582-1c97-434e-98b0-650a5cba3c1b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Multidimensional formulation", "Section",ExpressionUUID->"7a39690e-31b3-054e-9580-8a234e3c727d"],

Cell[TextData[{
 "Let the fields depend on coordinates ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", FontSlant -> "Bold"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], "1"], ",", "\[Ellipsis]", ",", 
             SubscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["n", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathbf{x}=(x_1,\\dots,x_n)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6341e40e-3976-9a4a-affc-dd813db25fc5"],
 ". Since the density contains no gradients, the field equations remain \
pointwise algebraic. "
}], "Text",ExpressionUUID->"4c740056-d036-d041-8524-cc4bbf9d86a5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "n", ",", "coords", ",", "\[Rho]g", ",", "\[Chi]g", ",", "Rg", ",", 
    "lagrangianND"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coords", "[", 
    RowBox[{"n_Integer", "?", "Positive"}], "]"}], ":=", 
   RowBox[{"Array", "[", 
    RowBox[{"x", ",", "n"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lagrangianND", "[", 
    RowBox[{"n_Integer", "?", "Positive"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]g", " ", "@@", " ", 
      RowBox[{"coords", "[", "n", "]"}]}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"\[Chi]g", " ", "@@", " ", 
       RowBox[{"coords", "[", "n", "]"}]}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"\[Chi]g", " ", "@@", " ", 
      RowBox[{"coords", "[", "n", "]"}]}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Rg", " ", "@@", " ", 
        RowBox[{"coords", "[", "n", "]"}]}], ")"}], "^", "2"}]}]}]}], 
  ";"}]}], "Input",ExpressionUUID->"819ce9b3-e5d1-384b-8455-8a3d2e9fe589"],

Cell[TextData[{
 "For completeness, verify the variational derivatives formally in dimension ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "891f5e3e-9972-3243-bc75-4add520c3a85"],
 ". "
}], "Text",ExpressionUUID->"d33591ac-24da-2642-93a9-70522272bf94"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "variationalStationarityND", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"variationalStationarityND", "[", 
     RowBox[{"n_Integer", "?", "Positive"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xx", "=", 
         RowBox[{"coords", "[", "n", "]"}]}], ",", "\[Rho]var", ",", 
        "\[Chi]var", ",", "rvar", ",", "\[ScriptCapitalL]"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"\[Rho]var", "=", 
        RowBox[{"\[Rho]g", " ", "@@", " ", "xx"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"\[Chi]var", "=", 
        RowBox[{"\[Chi]g", " ", "@@", " ", "xx"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"rvar", "=", 
        RowBox[{"Rg", " ", "@@", " ", "xx"}]}], ";", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"\[ScriptCapitalL]", "=", 
        RowBox[{
         RowBox[{"\[Rho]var", " ", 
          RowBox[{"Log", "[", "\[Chi]var", "]"}]}], "+", 
         RowBox[{"\[Chi]var", " ", 
          RowBox[{"rvar", "^", "2"}]}]}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<dL/d\[Rho]\>\"", "->", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{"D", "[", 
            RowBox[{"\[ScriptCapitalL]", ",", "\[Rho]var"}], "]"}], "]"}]}], ",",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<dL/d\[Chi]\>\"", "->", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{"D", "[", 
            RowBox[{"\[ScriptCapitalL]", ",", "\[Chi]var"}], "]"}], "]"}]}], ",",
          "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<dL/dR\>\"", "->", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{"D", "[", 
            RowBox[{"\[ScriptCapitalL]", ",", "rvar"}], "]"}], "]"}]}]}], 
        "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"variationalStationarityND", "[", "3", "]"}]}], "Input",ExpressionUUI\
D->"206d851b-55b8-7f4a-bfd1-42c7b59836aa"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"8c3d57c8-760b-9946-8b04-6c43a1acfeda"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Existence and consistency review", "Section",ExpressionUUID->"33a6735d-8495-0d4a-8fc4-d0b7eef6dba8"],

Cell["\<\
The first rigorous question is whether the model admits nontrivial stationary \
points under its own declared domain restrictions. \
\>", "Text",ExpressionUUID->"ed16b51f-7715-0945-9715-9e06f63f78cb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "consistencyReport", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"consistencyReport", ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<StrictPositiveR\>\"", "->", "stationarySolutions"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<NonnegativeR\>\"", "->", "stationarySolutionsRelaxed"}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "consistencyReport"}], \
"Input",ExpressionUUID->"aef856f4-4d8e-0a4f-a21c-926b6d17b589"],

Cell[CellGroupData[{

Cell["Interpretation rule", "Subsection",ExpressionUUID->"1b3067d8-e2a2-bd42-9252-ca270b003a27"],

Cell[TextData[{
 "If the strict system reduces to ",
 ButtonBox["False",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/False"],
 ", then the original action and domain conditions are internally \
inconsistent for stationary solutions."
}], "Item",ExpressionUUID->"25a9e7e5-193c-9745-bd15-f7919c728fcc"],

Cell["\<\
If the relaxed system yields a solution, that solution represents the exact \
stationary sector of the model as written.\
\>", "Item",ExpressionUUID->"046a0f24-8ccf-4d4b-b4dc-64ee253814ef"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"beb3d088-2649-b14b-8e88-23bb6aae173e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Missing-variable analysis", "Section",ExpressionUUID->"df91b94b-809e-8e44-ad34-5e2469f460ff"],

Cell["\<\
Define the model-variable set and compare it with a list of representative \
Standard Model constants or parameters only as a bookkeeping device. \
\>", "Text",ExpressionUUID->"92943705-a502-9247-adf1-77d834654738"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "layer1Variables", ",", "standardModelBookkeeping", ",", 
     "missingVariables"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"layer1Variables", "=", 
    RowBox[{"{", 
     RowBox[{"\[Rho]", ",", "\[Chi]", ",", "R"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"standardModelBookkeeping", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
     "c", ",", "h", ",", "\:0127", ",", "G", ",", "kB", ",", "\[Alpha]", ",", 
      "me", ",", "mmu", ",", "mtau", ",", "mu", ",", "md", ",", "ms", ",", 
      "mc", ",", "mb", ",", "mt", ",", "\[IndentingNewLine]", "   ", "mW", ",",
       "mZ", ",", "mH", ",", "gStrong", ",", "gWeak", ",", "gHypercharge", ",",
       "\[Theta]W", ",", "vHiggs"}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"missingVariables", "=", 
  RowBox[{"Complement", "[", 
   RowBox[{"layer1Variables", ",", "standardModelBookkeeping"}], 
   "]"}]}]}], "Input",ExpressionUUID->"2941a6da-a167-4147-964f-7bdce13a357d"],

Cell["Now solve the field equations identically when possible. ", "Text",ExpressionUUID->"9675c0e7-1c68-e34f-94e9-b45919ddf2fd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "solveAlwaysStationary", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"solveAlwaysStationary", "=", 
  RowBox[{
   RowBox[{"SolveAlways", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", "\[Chi]", "]"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Rho]", "/", "\[Chi]"}], "+", 
         RowBox[{"R", "^", "2"}]}], "==", "0"}], ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{
        RowBox[{"2", " ", "\[Chi]", " ", "R"}], "==", "0"}]}], 
      "\[IndentingNewLine]", "   ", "}"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"\[Rho]", ",", "\[Chi]", ",", "R"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}], " ", "//", " ", 
   "FullSimplify"}]}]}], "Input",ExpressionUUID->"6959dc20-26e4-a441-aeb6-\
3e7a6fac6214"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"f868eed4-72b1-5c43-b65c-48761eb1228a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Hessian and local structure of the action density", "Section",ExpressionUUID->"70ad4e54-cca4-c442-a16e-f8d04ee09c57"],

Cell[TextData[{
 "To distinguish extrema, saddle points, or degeneracy, compute the Hessian \
of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "(", 
         RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
           StyleBox["R", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{L}(\\rho,\\chi,R)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5ade672-5b74-ac45-92ad-6af7a4aee598"],
 ". "
}], "Text",ExpressionUUID->"10beefdd-58ab-7b49-adcb-98b6ada703e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"\[ScriptCapitalL]", ",", "hessianL", ",", "vars"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[ScriptCapitalL]", "=", 
   RowBox[{
    RowBox[{"\[Rho]", " ", 
     RowBox[{"Log", "[", "\[Chi]", "]"}]}], "+", 
    RowBox[{"\[Chi]", " ", 
     RowBox[{"R", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"\[Rho]", ",", "\[Chi]", ",", "R"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"hessianL", "=", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{"\[ScriptCapitalL]", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Rho]", ",", "\[Chi]", ",", "R"}], "}"}], ",", "2"}], 
      "}"}]}], "]"}], " ", "//", " ", "FullSimplify"}]}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "hessianL", "]"}]}], "Input",ExpressionUUID->\
"ba5cd168-e958-4745-becb-34d0f6bb8d7b"],

Cell["\<\
Evaluate the Hessian on the relaxed stationary point, if one exists. \
\>", "Text",ExpressionUUID->"3758b4e9-f31c-f64c-95fd-3a1803f37542"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hessianAtStationary", "=", 
   RowBox[{
    RowBox[{"hessianL", " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Rho]", "->", "0"}], ",", 
       RowBox[{"\[Chi]", "->", "1"}], ",", 
       RowBox[{"R", "->", "0"}]}], "}"}]}], " ", "//", " ", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Eigenvalues", "[", "hessianAtStationary", "]"}], ",", 
   RowBox[{"MatrixForm", "[", "hessianAtStationary", "]"}]}], "}"}]}], "Input",\
ExpressionUUID->"25ded986-5056-7349-ba54-ef53765e71eb"],

Cell["\<\
This reveals whether the exact stationary solution is isolated, degenerate, \
or unstable at quadratic order. \
\>", "Text",ExpressionUUID->"6688719b-53df-4a4a-9d82-11f1aa9e8354"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"d80c1fb6-3a93-f14a-80ae-bccce96f0eec"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Linearization and stable-frequency analysis", "Section",ExpressionUUID->"248c281d-3c57-8d4e-aa0c-334b0fac10b4"],

Cell["\<\
The supplied action has no derivative terms, so it does not directly define a \
propagating wave equation. To make the spectral request mathematically \
precise, we construct the Jacobian of the algebraic stationarity operator and \
examine its linear modes near the stationary configuration.\
\>", "Text",ExpressionUUID->"adfad682-db20-bc49-8134-479e253d702a"],

Cell[TextData[{
 "Define the stationarity map: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["F", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"]}], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"log", "\[Chi]", ", ", "\[Rho]", "/", "\[Chi]", "+", 
             SuperscriptBox[
              StyleBox["R", "TI"], "2"], ", ", "2", "\[Chi]", 
             StyleBox["R", "TI"]}], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "F(\\rho,\\chi,R)=\\left(\\log \\chi,\\, \\rho/\\chi + R^2,\\, 2\\chi \
R\\right).", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c85b66b7-a13f-1f41-a954-2693cda84a85"]
}], "Text",ExpressionUUID->"aa9a43c7-9dcf-ce4b-b8dd-5c82b74d3735"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"stationarityMap", ",", "jacobianF", ",", "stationaryPoint"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stationarityMap", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"Log", "[", "\[Chi]", "]"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"\[Rho]", "/", "\[Chi]"}], "+", 
       RowBox[{"R", "^", "2"}]}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"2", " ", "\[Chi]", " ", "R"}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"jacobianF", "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"stationarityMap", ",", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\[Rho]", ",", "\[Chi]", ",", "R"}], "}"}], "}"}]}], "]"}], 
    " ", "//", " ", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stationaryPoint", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Rho]", "->", "0"}], ",", 
     RowBox[{"\[Chi]", "->", "1"}], ",", 
     RowBox[{"R", "->", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearizedMatrix", "=", 
    RowBox[{
     RowBox[{"jacobianF", " ", "/.", " ", "stationaryPoint"}], " ", "//", " ",
      "FullSimplify"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"MatrixForm", "[", "linearizedMatrix", "]"}], ",", 
   RowBox[{"Eigenvalues", "[", "linearizedMatrix", "]"}]}], "}"}]}], "Input",E\
xpressionUUID->"fe2bc436-d8f6-dc43-bfeb-b2f5e4c2d585"],

Cell[CellGroupData[{

Cell["Stable-frequency criterion", "Subsection",ExpressionUUID->"42b20e01-85ff-514e-9d38-12d7a1707aea"],

Cell[TextData[{
 "A genuine undamped harmonic mode requires eigenvalues of the form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[Omega]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "i\\omega", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "30d384be-b12c-f24a-94a8-b5a520e2a726"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Omega]", ">", "0"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\omega>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0a913ac2-3a0a-2c4b-ab71-4e8396e73904"],
 " and zero real part. Test this criterion directly. "
}], "Text",ExpressionUUID->"2fc9748d-25fe-c34a-970b-c011d4c091d7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "stableFrequencies", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stableFrequencies", "[", "eigs_List", "]"}], ":=", 
    RowBox[{"Select", "[", 
     RowBox[{"eigs", ",", 
      RowBox[{
       RowBox[{"TrueQ", "[", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Re", "[", "#", "]"}], "==", "0"}], "&&", 
          RowBox[{
           RowBox[{"Im", "[", "#", "]"}], ">", "0"}]}], "]"}], "]"}], " ", 
       "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"stableModes", "=", 
  RowBox[{"stableFrequencies", "[", 
   RowBox[{"Eigenvalues", "[", "linearizedMatrix", "]"}], "]"}]}]}], "Input",E\
xpressionUUID->"0a2525e2-2b83-1c4f-a305-b3c0958b10cc"],

Cell["\<\
If this returns the empty list, then the model as currently defined does not \
produce undamped harmonic modes at linear order. \
\>", "Text",ExpressionUUID->"9195ef7f-3c10-f942-8ea2-a6f5bd00925f"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"df585db5-5af5-e349-9d8c-342943e58bf3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Residual-certified numerical verification", "Section",ExpressionUUID->"122daea2-a6c4-484c-b7b5-c93e7a50b44b"],

Cell["\<\
Although the core stationary problem is exactly solvable, numerical \
confirmation is useful as an implementation audit. \
\>", "Text",ExpressionUUID->"96ce3496-5d2c-a840-8122-b01b6ca526ac"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"numericalRoot", ",", "residualNorm"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"numericalRoot", "=", 
    RowBox[{"FindRoot", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"Log", "[", "\[Chi]", "]"}], "==", "0"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Rho]", "/", "\[Chi]"}], "+", 
          RowBox[{"R", "^", "2"}]}], "==", "0"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{
         RowBox[{"2", " ", "\[Chi]", " ", "R"}], "==", "0"}]}], 
       "\[IndentingNewLine]", "   ", "}"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Rho]", ",", "0.1`80"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Chi]", ",", "1.1`80"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"R", ",", "0.01`80"}], "}"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"WorkingPrecision", "->", "workingPrecision"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"PrecisionGoal", "->", "precisionGoal"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"AccuracyGoal", "->", "accuracyGoal"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"Method", "->", "\"\<Newton\>\""}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"residualNorm", "[", "sol_", "]"}], ":=", 
    RowBox[{"Norm", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"stationarityMap", " ", "/.", " ", "sol"}], ",", "100"}], 
       "]"}], ",", "\[IndentingNewLine]", "   ", "Infinity"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"<|", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"\"\<NumericalRoot\>\"", "->", "numericalRoot"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<ResidualInfinityNorm\>\"", "->", 
    RowBox[{"residualNorm", "[", "numericalRoot", "]"}]}]}], 
  "\[IndentingNewLine]", "|>"}]}], "Input",ExpressionUUID->"5b6d5272-47b9-\
1247-851e-fdcaa523b03f"],

Cell[CellGroupData[{

Cell["Automated refinement loop", "Subsection",ExpressionUUID->"01f6ad16-ed13-b945-a97e-6f1aa1cfc523"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "refineRoot", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"refineRoot", "[", 
     RowBox[{"wp_Integer", "?", "Positive"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "sol", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"sol", "=", 
        RowBox[{"FindRoot", "[", "\[IndentingNewLine]", "    ", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", "     ", 
           RowBox[{
            RowBox[{
             RowBox[{"Log", "[", "\[Chi]", "]"}], "==", "0"}], ",", 
            "\[IndentingNewLine]", "     ", 
            RowBox[{
             RowBox[{
              RowBox[{"\[Rho]", "/", "\[Chi]"}], "+", 
              RowBox[{"R", "^", "2"}]}], "==", "0"}], ",", 
            "\[IndentingNewLine]", "     ", 
            RowBox[{
             RowBox[{"2", " ", "\[Chi]", " ", "R"}], "==", "0"}]}], 
           "\[IndentingNewLine]", "    ", "}"}], ",", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Rho]", ",", "0.1`50"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Chi]", ",", "1.1`50"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"R", ",", "0.01`50"}], "}"}]}], "}"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"WorkingPrecision", "->", "wp"}], ",", 
          "\[IndentingNewLine]", "    ", 
          RowBox[{"PrecisionGoal", "->", 
           RowBox[{"Floor", "[", 
            RowBox[{"0.7", " ", "wp"}], "]"}]}], ",", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"AccuracyGoal", "->", 
           RowBox[{"Floor", "[", 
            RowBox[{"0.7", " ", "wp"}], "]"}]}]}], "\[IndentingNewLine]", 
         "  ", "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<WorkingPrecision\>\"", "->", "wp"}], ",", 
         RowBox[{"\"\<Solution\>\"", "->", "sol"}], ",", 
         RowBox[{"\"\<Residual\>\"", "->", 
          RowBox[{"residualNorm", "[", "sol", "]"}]}]}], "|>"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"refinementTable", "=", 
   RowBox[{"refineRoot", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"50", ",", "80", ",", "120", ",", "160"}], "}"}]}]}], 
  ";"}]}], "Input",ExpressionUUID->"eed9e4ab-2d7c-2945-9a56-61b37c198583"],

Cell["Inspect convergence behavior: ", "CodeText",ExpressionUUID->"9d5dd34b-6ba4-f849-b9ab-e0955a1ca331"],

Cell[BoxData[
 RowBox[{"refinementTable", " ", "//", " ", "Dataset"}]], "Input",ExpressionUU\
ID->"248176fd-ea4f-1e47-acd6-b396718b7af9"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"3c9501e2-2597-8b41-acc2-3a44fc82df11"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Measurement map construction", "Section",ExpressionUUID->"912a1f50-e30f-6e41-9b7a-d75c71826ff2"],

Cell["\<\
The proposal specifies observables via integration of the Layer L1 state over \
an eigenbasis. Because no concrete eigenbasis is supplied by the algebraic \
action, define the measurement construction abstractly first.\
\>", "Text",ExpressionUUID->"99306990-6197-6a4b-beb1-0f4bece13020"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPsi]", "(", 
         RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
           StyleBox["R", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Psi(\\rho,\\chi,R)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e2b9f61b-c844-9d41-bd89-bb1d56e95588"],
 " be a state function and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SubscriptBox["\[Phi]", 
          StyleBox["n", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\phi_n\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "967af2c5-565a-bd43-8a64-af36499e6015"],
 " an orthonormal basis on a domain ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalOmega]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Omega", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "96b4b200-f7ee-794a-ac2d-0b2eca7609e1"],
 ". Then the measured observable is defined as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"[", "\[CapitalPsi]", "]"}], "\[LongEqual]", 
         SubscriptBox["\[Integral]", "\[CapitalOmega]"], "\[CapitalPsi]", 
         RowBox[{"(", 
           StyleBox["x", FontSlant -> "Bold"], ")"}], " ", 
         SubscriptBox["\[Phi]", 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", FontSlant -> "Bold"], ")"}], "\[DifferentialD]", 
         "\[CapitalOmega]", "."}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{M}_n[\\Psi] = \\int_\\Omega \
\\Psi(\\mathbf{x})\\,\\phi_n(\\mathbf{x})\\,d\\Omega.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5f3fd2ae-b8ef-924b-9ac9-4bc951d0e2a0"]
}], "Text",ExpressionUUID->"e2f71558-da68-1047-89b8-58b3beabe119"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "measurementKernel", ",", "\[Psi]", ",", "\[Phi]", ",", 
    "\[CapitalOmega]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementKernel", "[", 
    RowBox[{"state_", ",", "basis_", ",", "domain_"}], "]"}], ":=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"state", " ", "basis"}], ",", "domain", ",", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"12c8561f-0eb1-194e-9d53-d4709ced5714"],

Cell[CellGroupData[{

Cell["10.1 Canonical one-dimensional basis test", "Subsection",ExpressionUUID->"3852fa76-1f66-734b-91f5-69f30ed943ca"],

Cell[TextData[{
 "Use the interval ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"[", 
         RowBox[{"0", ",", "\[Pi]"}], "]"}], TraditionalForm], "errors" -> {},
      "input" -> "[0,\\pi]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f2f9f723-16ca-c24b-a296-ff63db0c7096"],
 " with sine basis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Phi]", 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "sin", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], 
             StyleBox["x", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\phi_n(x)=\\sin(nx)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "06ad7008-f3a5-8b47-be8e-742f62ab8214"],
 " as a standard verification environment. "
}], "Text",ExpressionUUID->"589921df-4169-9b46-aeee-0ff719926e7c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"\[Psi]test", ",", "basis1D", ",", "measuredMode"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]test", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], "+", 
    RowBox[{"2", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", " ", "x"}], "]"}]}], "+", 
    RowBox[{"3", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"3", " ", "x"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"basis1D", "[", 
      RowBox[{"n_Integer", "?", "Positive"}], "]"}], "[", "x_", "]"}], ":=", 
    RowBox[{"Sin", "[", 
     RowBox[{"n", " ", "x"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"measuredMode", "[", 
     RowBox[{"n_Integer", "?", "Positive"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Psi]test", "[", "x", "]"}], " ", 
        RowBox[{
         RowBox[{"basis1D", "[", "n", "]"}], "[", "x", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "Pi"}], "}"}]}], "]"}], " ", "//", " ", 
     "FullSimplify"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"n", ",", 
     RowBox[{"measuredMode", "[", "n", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "1", ",", "5"}], "}"}]}], "]"}]}], "Input",ExpressionUUI\
D->"b798e1f6-369b-5741-9921-bb167c23ffe8"],

Cell["\<\
This confirms that the measurement kernel correctly extracts basis amplitudes \
up to normalization. \
\>", "Text",ExpressionUUID->"67aea84b-be19-f34d-8bbd-dbe463aa92fa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.2 Abstract OPF measurement pipeline", "Subsection",ExpressionUUID->"0b3c1a0d-dc07-a847-818d-f4cfc204f539"],

Cell["\<\
Define a compositional pipeline from substrate to field equations to \
measurement. \
\>", "Text",ExpressionUUID->"b1b5f1ec-355c-4041-a943-5143a49d9638"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"l0ToL1", ",", "l1ToL2", ",", "opfPipeline"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"l0ToL1", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"topology", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Topology\>\"", "->", "topology"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ActionDensity\>\"", "->", "\[ScriptCapitalL]"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<StationarityMap\>\"", "->", "stationarityMap"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Jacobian\>\"", "->", "jacobianF"}]}], 
       "\[IndentingNewLine]", "  ", "|>"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"l1ToL2", "=", 
    RowBox[{"Function", "[", 
     RowBox[{"fieldData", ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"state", ",", "basis", ",", "domain"}], "}"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"<|", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"\"\<FieldData\>\"", "->", "fieldData"}], ",", 
          "\[IndentingNewLine]", "      ", 
          RowBox[{"\"\<Measurement\>\"", "->", 
           RowBox[{"measurementKernel", "[", 
            RowBox[{"state", ",", "basis", ",", "domain"}], "]"}]}]}], 
         "\[IndentingNewLine]", "    ", "|>"}]}], "\[IndentingNewLine]", "  ",
        "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"opfPipeline", "=", 
   RowBox[{"RightComposition", "[", 
    RowBox[{"l0ToL1", ",", "l1ToL2"}], "]"}]}], ";"}]}], "Input",ExpressionUUI\
D->"7813d301-6669-cf4c-ac4d-189d0d395ebc"],

Cell["Apply the pipeline in a simple test case. ", "Text",ExpressionUUID->"3ed70eaf-3731-2c4e-bf02-2d48707a4708"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pipelineInstance", "=", 
   RowBox[{"opfPipeline", "[", "l0Topology", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"pipelineMeasurement", "=", 
  RowBox[{
   RowBox[{"pipelineInstance", "[", 
    RowBox[{
     RowBox[{"\[Psi]test", "[", "x", "]"}], ",", 
     RowBox[{
      RowBox[{"basis1D", "[", "2", "]"}], "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "Pi"}], "}"}]}], "]"}], " ", "//", " ", 
   "FullSimplify"}]}]}], "Input",ExpressionUUID->"b7e8b4c5-3e04-7c4b-8374-\
3671ad7a6745"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"01650002-6b5c-104d-ae4c-aa837568d5bd"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Exact maintenance dynamics", "Section",ExpressionUUID->"a6072cfd-3eea-ac41-b88b-96ff80bda2bc"],

Cell["\<\
The maintenance law can be analyzed independently of the stationary action. \
\>", "Text",ExpressionUUID->"d1b3a1d8-d527-9a40-aee0-2328b2566bb0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"fieldState", ",", "maintenanceSolution"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"maintenanceSolution", "=", 
  RowBox[{
   RowBox[{"DSolveValue", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"fieldState", "[", "t", "]"}], ",", "t"}], "]"}], "+", 
         RowBox[{"\[CapitalGamma]", " ", 
          RowBox[{"fieldState", "[", "t", "]"}]}]}], "==", "0"}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"fieldState", "[", "0", "]"}], "==", "field0"}]}], 
      "\[IndentingNewLine]", "   ", "}"}], ",", "\[IndentingNewLine]", "   ", 
     "fieldState", ",", "\[IndentingNewLine]", "   ", "t"}], 
    "\[IndentingNewLine]", "]"}], " ", "//", " ", 
   "FullSimplify"}]}]}], "Input",ExpressionUUID->"2f956998-dc0a-7047-b411-\
09209d92e0ea"],

Cell[CellGroupData[{

Cell["Regime classification", "Subsection",ExpressionUUID->"163e0ad7-5a75-704a-83fd-66fd3237c5fa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "maintenanceRegime", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maintenanceRegime", "=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Conserved\>\"", ",", 
        RowBox[{"\[CapitalGamma]", "==", "0"}]}], "}"}], ",", 
      "\[IndentingNewLine]", "    ", 
      RowBox[{"{", 
       RowBox[{"\"\<Damped\>\"", ",", 
        RowBox[{"\[CapitalGamma]", ">", "0"}]}], "}"}]}], 
     "\[IndentingNewLine]", "}"}], "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"2c0aa97d-27bb-a546-ba7c-789d59832d09"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalGamma]", ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Gamma>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "60095484-7288-764d-83f1-46889619dcfc"],
 ", the maintained sector decays exponentially and is not persistent without \
external replenishment. That conclusion follows exactly from the differential \
equation itself. "
}], "Text",ExpressionUUID->"2c3ea65d-d439-344a-aa44-40247c4b3ea0"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"f51308eb-4828-614e-9e58-906e9cd47f2c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["12. Internal theorem-style checks", "Section",ExpressionUUID->"6b84d542-2508-9c48-ae8e-7ed7db54017b"],

Cell["\<\
Certain identities can be audited symbolically. For example, verify that the \
maintenance solution satisfies the differential law exactly. \
\>", "Text",ExpressionUUID->"3442ee2d-856b-864c-b6af-890fab4129aa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "maintenanceVerification", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maintenanceVerification", "=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"maintenanceOperator", "[", "maintenanceSolution", "]"}], "==", 
      "0"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"$Assumptions", "&&", 
       RowBox[{"field0", " ", "\[Element]", " ", "Reals"}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"1c4a1f4c-3029-8c45-a4bd-e9940cd697af"],

Cell["\<\
Verify the stationary solution of the relaxed variational system. \
\>", "Text",ExpressionUUID->"817c77b8-99a9-3b41-ba7f-a221e83960be"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "stationaryVerification", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stationaryVerification", "=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{"stationarityMap", " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Rho]", "->", "0"}], ",", 
       RowBox[{"\[Chi]", "->", "1"}], ",", 
       RowBox[{"R", "->", "0"}]}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"c193626a-3ee7-e54e-adef-3d9e7cda5613"],

