Cell[CellGroupData[{

Cell["20. Final conclusions", "Section",ExpressionUUID->"1cfba428-3b3c-0a4b-b3b1-bdd1be5fd55e"],

Cell["\<\
The formal analysis of the model as defined yields the following rigorous \
conclusions:\
\>", "Text",ExpressionUUID->"7c38ce0b-f2a0-3447-b326-b69bf33d5c46"],

Cell["1. The supplied Layer L1 action density", "Text",ExpressionUUID->"20c0fc5c-eac7-564b-9a38-8a82ccaf3e1b"],

Cell[TextData[{
 "   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", "\[Rho]", "log", 
         RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{L}=\\rho\\log(\\chi)+\\chi R^2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ae912de0-af02-734f-aea5-9442f7feb882"],
 "   produces ",
 StyleBox["algebraic stationarity equations",
  FontWeight->Bold],
 ", not propagating PDEs."
}], "Text",ExpressionUUID->"1173c1e2-55e9-624c-975d-19dddda60047"],

Cell[TextData[{
 "2. Under the strict condition ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], ">", "0"}], TraditionalForm], "errors" -> {}, 
     "input" -> "R>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d0ede86f-045b-d54d-a237-a514e35f9482"],
 ", the stationary system is ",
 StyleBox["internally inconsistent",
  FontWeight->Bold],
 "."
}], "Text",ExpressionUUID->"6f310c71-65ac-2b42-b234-84f942cc0a8b"],

Cell[TextData[{
 "3. Under the relaxed condition ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[GreaterEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "R\\ge 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "020ec5a3-81bd-9948-98dc-4586e00db2d0"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Chi]", ">", "0"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\chi>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f6b9d6fe-9c32-134c-b626-4fcfd5878610"],
 ", the exact stationary point is"
}], "Text",ExpressionUUID->"730211b0-aa85-374d-98f6-b2cdf2883ced"],

Cell[TextData[{
 "   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
        "\[Rho]", "\[LongEqual]", "0", ",  ", "\[Chi]", "\[LongEqual]", "1", 
         ",  ", 
         StyleBox["R", "TI"], "\[LongEqual]", "0."}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\rho=0,\\quad \\chi=1,\\quad R=0.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ab1e8313-14cd-b847-995a-6e29fdd048f7"],
 "4. The linearized stationarity operator at that point yields no nontrivial \
undamped harmonic modes."
}], "Text",ExpressionUUID->"fc4f9412-2ec3-5b42-af95-8fd76fda3423"],

Cell[TextData[{
 "5. The maintenance equation is exactly solvable and gives exponential decay \
unless ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalGamma]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Gamma=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d19253ab-8ce6-f849-a568-6d07c289eb51"],
 "."
}], "Text",ExpressionUUID->"e56630ef-620f-cc43-800c-4d16a55ee1ff"],

Cell["\<\
6. The measurement map can be defined abstractly and tested independently, \
but its concrete physical content requires a specified state space and \
eigenbasis.\
\>", "Text",ExpressionUUID->"23695065-642f-c74c-bd84-560870fec08e"],

Cell["\<\
7. The model is mathematically consistent only in a reduced stationary sense \
after constraint relaxation; additional derivative terms are necessary for a \
true field-theoretic spectral dynamics. \
\>", "Text",ExpressionUUID->"c148c3b4-d122-4241-b9ff-a0ed40b9b7f2"],

