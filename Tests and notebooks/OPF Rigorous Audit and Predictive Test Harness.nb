Cell[CellGroupData[{

Cell["6. Hidden Constraint Solve and Structural Simplification", "Section",ExpressionUUID->"34e12834-c4a4-1048-a842-17842ebf5d14"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"hiddenConstraints", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"Solve", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"eulerSystem", " ", "/.", " ", 
        RowBox[{"{", "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", 
              RowBox[{"2", ",", "0", ",", "0", ",", "0"}], "]"}], "[", "f_", 
             "]"}], "[", 
            RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ":>", "0"}], ",",
           "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", 
              RowBox[{"0", ",", "2", ",", "0", ",", "0"}], "]"}], "[", "f_", 
             "]"}], "[", 
            RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ":>", "0"}], ",",
           "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", 
              RowBox[{"0", ",", "0", ",", "2", ",", "0"}], "]"}], "[", "f_", 
             "]"}], "[", 
            RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ":>", "0"}], ",",
           "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", 
              RowBox[{"0", ",", "0", ",", "0", ",", "2"}], "]"}], "[", "f_", 
             "]"}], "[", 
            RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ":>", "0"}]}],
          "\[IndentingNewLine]", "    ", "}"}]}], ",", "\[IndentingNewLine]", 
       "   ", "fieldVars", ",", "\[IndentingNewLine]", "   ", "Reals", ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"MaxExtraConditions", "->", "All"}]}], "\[IndentingNewLine]", 
      "  ", "]"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "say", "[", "\"\<Hidden constraints under second-derivative \
suppression:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
