Cell[CellGroupData[{

Cell["15. Measurement Kernel Tests", "Section",ExpressionUUID->"cb06db12-e1c5-cf40-bc3b-1ed74728492e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]1", "[", "x1_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{"-", 
     RowBox[{"x1", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"basis1", "[", "n_", "]"}], "[", "x1_", "]"}], ":=", 
    RowBox[{
     RowBox[{"HermiteH", "[", 
      RowBox[{"n", ",", "x1"}], "]"}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"x1", "^", "2"}]}], "/", "2"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementPrototypes", "=", 
    RowBox[{"FullSimplify", " ", "@", " ", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"Integrate", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Psi]1", "[", "x1", "]"}], " ", 
          RowBox[{
           RowBox[{"basis1", "[", "n", "]"}], "[", "x1", "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"x1", ",", 
           RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"GenerateConditions", "->", "True"}]}], 
        "\[IndentingNewLine]", "   ", "]"}], ",", "\[IndentingNewLine]", 
       "   ", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", "6"}], "}"}]}], "\[IndentingNewLine]", 
      "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"projectionCoefficient", "[", 
     RowBox[{"n_", ",", "\[Psi]_"}], "]"}], ":=", 
    RowBox[{"Integrate", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Psi]", "[", "x1", "]"}], " ", 
       RowBox[{
        RowBox[{"basis1", "[", "n", "]"}], "[", "x1", "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"x1", ",", 
        RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"GenerateConditions", "->", "True"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"say", "[", "\"\<Measurement prototypes:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"measurementPrototypes", " ", "//", " ", "TableForm"}], "]"}], 
  ";"}]}], "Input",
 CellLabel->
