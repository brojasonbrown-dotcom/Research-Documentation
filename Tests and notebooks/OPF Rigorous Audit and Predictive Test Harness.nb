Cell[CellGroupData[{

Cell["9. Linearization About the Background", "Section",ExpressionUUID->"5249558d-6baa-1a4e-9a0a-554fb7791fe5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"linRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\[Rho]", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"\[Rho]0", "+", 
          RowBox[{"\[CurlyEpsilon]", " ", 
           RowBox[{"u", "[", 
            RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
        "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\[Chi]", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"\[Chi]0", "+", 
          RowBox[{"\[CurlyEpsilon]", " ", 
           RowBox[{"v", "[", 
            RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
        "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"r", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"r0", "+", 
          RowBox[{"\[CurlyEpsilon]", " ", 
           RowBox[{"w", "[", 
            RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"series0", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"\[CurlyEpsilon]", ",", "0", ",", "0"}], "}"}]}], "]"}], 
       "]"}], " ", "&"}], ",", 
     RowBox[{"eulerLHS", " ", "/.", " ", "linRules"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"series1", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"\[CurlyEpsilon]", ",", "0", ",", "1"}], "}"}]}], "]"}], 
       "]"}], " ", "&"}], ",", 
     RowBox[{"eulerLHS", " ", "/.", " ", "linRules"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"backgroundConditions", "=", 
   RowBox[{"FullSimplify", "[", "series0", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearizedSystem", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"#", ",", "\[CurlyEpsilon]"}], "]"}], " ", "&"}], " ", "/@", 
      " ", "series1"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "say", "[", "\"\<Background conditions from zeroth-order expansion:\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"backgroundConditions", " ", "//", " ", "TableForm"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"say", "[", "\"\<Linearized equations:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"linearizedSystem", " ", "//", " ", "TableForm"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"backgroundConditions", " ", "/.", " ", 
     RowBox[{"stationaryBackground", "===", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Length", "[", "backgroundConditions", "]"}]}], "]"}]}]}], ",",
     "\[IndentingNewLine]", "  ", 
    RowBox[{
    "pass", "[", "\"\<Stationary background satisfies zeroth-order equations.\
\>\"", "]"}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{
    "warn", "[", "\"\<Chosen stationary background does not annihilate all \
zeroth-order terms exactly under current assumptions.\>\"", "]"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]}], "Input",
 CellLabel->
  "In[106]:=",ExpressionUUID->"ad0a0949-e458-0248-bc03-951c48066590"],

