Cell[CellGroupData[{

Cell["1. Initialization", "Section",ExpressionUUID->"6eeaf6c3-1154-6c48-b154-7d14f2ba061e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Needs", "[", "\"\<VariationalMethods`\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$HistoryLength", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Rho]0", ",", "\[Chi]0", ",", "r0", ",", "\[Gamma]", ",", 
         "\[CapitalGamma]", ",", "\[Omega]", ",", "kx", ",", "ky", ",", "kz", 
         ",", "\[Lambda]", ",", "\[Alpha]", ",", "\[Beta]", ",", "\[Mu]", ",",
          "\[CurlyEpsilon]", ",", "m"}], "}"}], ",", "Reals"}], "]"}], "&&", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\[Rho]0", ">", "0"}], "&&", 
     RowBox[{"\[Chi]0", ">", "0"}], "&&", 
     RowBox[{"\[Alpha]", ">", "0"}], "&&", 
     RowBox[{"\[Beta]", ">", "0"}], "&&", 
     RowBox[{"\[Mu]", ">", "0"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords4", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spatialCoords", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fields", "=", 
   RowBox[{"{", 
    RowBox[{"\[Rho]", ",", "\[Chi]", ",", "r"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fieldVars", "=", 
    RowBox[{"Through", "[", 
     RowBox[{"fields", "[", 
      RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"say", "[", "msg_", "]"}], ":=", 
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{"msg", ",", "14", ",", "Bold", ",", 
      RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pass", "[", "msg_", "]"}], ":=", 
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"\"\<PASS: \>\"", " ", "<>", " ", "msg"}], ",", 
      RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fail", "[", "msg_", "]"}], ":=", 
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"\"\<FAIL: \>\"", " ", "<>", " ", "msg"}], ",", "Red"}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"warn", "[", "msg_", "]"}], ":=", 
  RowBox[{"Print", "[", 
   RowBox[{
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"\"\<WARN: \>\"", " ", "<>", " ", "msg"}], ",", 
      RowBox[{"Darker", "[", "Orange", "]"}]}], "]"}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"withTiming", "[", 
      RowBox[{"label_", ",", "expr_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tm", ",", "res"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{
        RowBox[{"say", "[", "label", "]"}], ";", "\[IndentingNewLine]", "  ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tm", ",", "res"}], "}"}], "=", 
         RowBox[{"AbsoluteTiming", "[", "expr", "]"}]}], ";", 
        "\[IndentingNewLine]", "  ", 
        RowBox[{"Print", "[", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{"\"\<Time: \>\"", ",", 
            RowBox[{"NumberForm", "[", 
             RowBox[{"tm", ",", 
              RowBox[{"{", 
               RowBox[{"8", ",", "4"}], "}"}]}], "]"}], ",", "\"\< s\>\""}], 
           "}"}], "]"}], "]"}], ";", "\[IndentingNewLine]", "  ", "res"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"reportAssociation", "[", 
      RowBox[{"name_", ",", "assoc_"}], "]"}], ":=", 
     RowBox[{"(", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"say", "[", "name", "]"}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"Print", "[", 
        RowBox[{"Dataset", "[", "assoc", "]"}], "]"}], ";"}], 
      "\[IndentingNewLine]", ")"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gradSq4", "[", "head_", "]"}], ":=", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"head", "[", 
            RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "#"}], 
          "]"}], "^", "2"}], " ", "&"}], " ", "/@", " ", "coords4"}], "]"}]}],
     ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"boxLike", "[", "head_", "]"}], ":=", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"head", "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"#", ",", "2"}], "}"}]}], "]"}], " ", "&"}], " ", "/@", 
       " ", "coords4"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"spatialLap", "[", "head_", "]"}], ":=", 
     RowBox[{"Laplacian", "[", 
      RowBox[{
       RowBox[{"head", "[", 
        RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
       "spatialCoords"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"kSq", "=", 
     RowBox[{
      RowBox[{"kx", "^", "2"}], "+", 
      RowBox[{"ky", "^", "2"}], "+", 
      RowBox[{"kz", "^", "2"}]}]}], ";"}]}]}]}], "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"4f28d92a-5e40-6f43-851c-be357abee9c5"],

