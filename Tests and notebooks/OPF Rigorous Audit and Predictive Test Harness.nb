Cell[CellGroupData[{

Cell["3. Algebraic Stationarity Tests", "Section",ExpressionUUID->"02b61b3c-6c72-6242-826c-b468e7701d51"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"algEquations", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Rho]s", " ", 
