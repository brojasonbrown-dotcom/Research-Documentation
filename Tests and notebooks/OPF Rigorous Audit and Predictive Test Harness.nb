Cell[CellGroupData[{

Cell["2. OPF Layer Definitions", "Section",ExpressionUUID->"e38913e8-a48a-594f-ac0d-9d1281e84c72"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"layer0", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Topology\>\"", "->", "\"\<Sphere\>\""}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<BoundaryDuality\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", "Infinity"}], "}"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<TemporalMode\>\"", "->", "\"\<Timeless\>\""}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Substrate\>\"", "->", "\"\<EmptySpacetime\>\""}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lagrangianAlgebraic", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Rho]", "[", 
       RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"\[Chi]", "[", 
        RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"\[Chi]", "[", 
       RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], " ", 
      RowBox[{
       RowBox[{"r", "[", 
        RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "^", "2"}]}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lagrangianRegularized", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{"lagrangianAlgebraic", "+", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\[Alpha]", "/", "2"}], " ", 
      RowBox[{"gradSq4", "[", "\[Rho]", "]"}]}], "+", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{
      RowBox[{"\[Beta]", "/", "2"}], " ", 
      RowBox[{"gradSq4", "[", "\[Chi]", "]"}]}], "+", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{
      RowBox[{"\[Mu]", "/", "2"}], " ", 
      RowBox[{"gradSq4", "[", "r", "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maintenanceEquation", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Phi]", "[", "t", "]"}], ",", "t"}], "]"}], "+", 
     RowBox[{"\[CapitalGamma]", " ", 
      RowBox[{"\[Phi]", "[", "t", "]"}]}]}], "==", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"measurementFunctional", "[", 
     RowBox[{"\[Psi]_", ",", "basis_", ",", "region_"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"\[Psi]", " ", "basis"}], ",", 
      RowBox[{
       RowBox[{"Evaluate", "@", "Sequence"}], " ", "@@", " ", "region"}], ",", 
      RowBox[{"GenerateConditions", "->", "True"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "say", "[", "\"\<Initialized OPF layers and regularized Lagrangian.\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"lagrangianRegularized", " ", "//", " ", "TraditionalForm"}], 
   "]"}], ";"}]}], "Input",
 CellLabel->"In[60]:=",ExpressionUUID->"24a90e35-021d-044f-a668-ff58dc572177"],

