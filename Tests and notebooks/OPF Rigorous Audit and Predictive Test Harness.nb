  RowBox[{
   RowBox[{"activatedEulerSystem", "=", 
    RowBox[{"Activate", "[", "inactiveEulerSystem", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"inactiveAudit", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"activatedEulerSystem", "==", "eulerSystem"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
