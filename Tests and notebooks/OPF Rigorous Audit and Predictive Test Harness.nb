Cell[CellGroupData[{

Cell["18. State-Space Realization and Stability Tests", "Section",ExpressionUUID->"cfe55006-a650-9c44-a075-571c2fea9a21"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ssmTemplate", "=", 
    RowBox[{"StateSpaceModel", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x1", "'"}], "[", "t", "]"}], "==", 
         RowBox[{"x2", "[", "t", "]"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"x2", "'"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "a"}], " ", 
           RowBox[{"x1", "[", "t", "]"}]}], "-", 
          RowBox[{"b", " ", 
           RowBox[{"x2", "[", "t", "]"}]}], "+", 
          RowBox[{"c", " ", 
           RowBox[{"uIn", "[", "t", "]"}]}]}]}]}], "\[IndentingNewLine]", 
       "  ", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x1", "[", "t", "]"}], ",", 
        RowBox[{"x2", "[", "t", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"{", 
       RowBox[{"uIn", "[", "t", "]"}], "}"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"{", 
       RowBox[{"x1", "[", "t", "]"}], "}"}], ",", "\[IndentingNewLine]", "  ",
       "t"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"controllabilityCheck", "=", 
   RowBox[{"ControllableModelQ", "[", "ssmTemplate", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stabilityPoles", "=", 
    RowBox[{"SystemsModelPoles", "[", "ssmTemplate", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"say", "[", "\"\<State-space controllability:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "controllabilityCheck", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"say", "[", "\"\<State-space poles:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"stabilityPoles", " ", "//", " ", "InputForm"}], "]"}], 
  ";"}]}], "Input",
 CellLabel->
  "In[161]:=",ExpressionUUID->"d1c39be6-724f-c644-ae5e-f6c2b2fcf149"],

