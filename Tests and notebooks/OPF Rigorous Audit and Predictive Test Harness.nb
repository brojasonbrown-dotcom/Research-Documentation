Cell[CellGroupData[{

Cell["8. Background Classification with Reduce", "Section",ExpressionUUID->"30d7f19c-b497-cb41-bffb-f4f57eb6b0ab"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"backgroundEquations", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"eulerLHS", " ", "/.", " ", 
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Rho]", "[", 
          RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "->", 
         "\[Rho]0"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\[Chi]", "[", 
          RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "->", 
         "\[Chi]0"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"r", "[", 
          RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "->", "r0"}]}], 
       "\[IndentingNewLine]", "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"backgroundClassification", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"Reduce", "[", 
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"backgroundEquations", "==", "0"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Rho]0", ",", "\[Chi]0", ",", "r0"}], "}"}], ",", "Reals"}],
       "]"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"say", "[", "\"\<Background classification:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"backgroundClassification", " ", "//", " ", "InputForm"}], "]"}], 
  ";"}]}], "Input",
 CellLabel->
