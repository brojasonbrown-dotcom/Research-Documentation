Cell[CellGroupData[{

Cell["24. True Rigorous Testing Strategy", "Section",ExpressionUUID->"2e5aaa4f-7fcc-504d-a04f-95af91aef547"],

Cell[TextData[{
 "The most rigorous method is not a single solver. It is a ",
 StyleBox["stack of mutually constraining tests",
  FontWeight->Bold],
 ": "
}], "Text",ExpressionUUID->"d2a04e33-43eb-3d4f-9f84-b7af6d1bff80"],

Cell[CellGroupData[{

Cell["Symbolic truth layer", "Subsection",ExpressionUUID->"7a6351a8-42bf-9346-a9a7-87732ccc47e7"],

Cell["derive equations exactly", "Item",ExpressionUUID->"7ab634c9-3128-de4d-96d1-e821d55d449a"],

Cell["verify same equations in two ways", "Item",ExpressionUUID->"a93f95d2-7fef-f449-99b1-d639c8072c99"],

Cell[TextData[{
 "classify equilibria with ",
