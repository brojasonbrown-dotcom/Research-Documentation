Cell[CellGroupData[{

Cell["12. Stable-Mode Decision Functions", "Section",ExpressionUUID->"dbedbd45-bea8-e94d-a93f-b92b475c9438"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stableImaginaryModes", "[", "expr_", "]"}], ":=", 
    RowBox[{"Solve", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"expr", "==", "0"}], "&&", 
       RowBox[{
        RowBox[{"Re", "[", "\[Omega]", "]"}], "==", "0"}], "&&", 
       RowBox[{
        RowBox[{"Im", "[", "\[Omega]", "]"}], ">", "0"}]}], ",", 
      "\[IndentingNewLine]", "  ", "\[Omega]", ",", "\[IndentingNewLine]", 
      "  ", "Complexes"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"purelyOscillatoryModes", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"stableImaginaryModes", "[", "dispersionDet", "]"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
