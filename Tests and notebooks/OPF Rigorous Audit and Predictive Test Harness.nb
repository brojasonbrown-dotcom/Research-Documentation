Cell[CellGroupData[{

Cell["23. Suggested Python Benchmark Skeleton", "Section",ExpressionUUID->"fcdef901-edf2-df42-b796-d354e24339fa"],

Cell[CellGroupData[{

Cell["\<\
import json
import time
import torch

with open(\"opf-benchmark-export.json\", \"r\") as f:
    payload = json.load(f)

# Replace this with a hand-transcribed or generated determinant function.
def dispersion_det(alpha, beta, mu, kx, ky, kz, omega):
    ksq = kx*kx + ky*ky + kz*kz
    # placeholder: replace with exported symbolic expression
    return alpha*(omega**2 + ksq) + beta*(omega**2 + ksq) + mu*(omega**2 + ksq)


def bench(device=\"cuda\", n=1_000_000):
    torch.set_default_dtype(torch.float64)
    alpha = torch.ones(n, device=device)
    beta = torch.ones(n, device=device)
    mu = torch.ones(n, device=device)
    kx = torch.randn(n, device=device)
    ky = torch.randn(n, device=device)
    kz = torch.randn(n, device=device)
    omega = 1j * torch.abs(torch.randn(n, device=device, \
dtype=torch.float64)).to(torch.complex128)

    torch.cuda.synchronize() if device == \"cuda\" else None
    t0 = time.time()
    val = dispersion_det(alpha, beta, mu, kx, ky, kz, omega)
    torch.cuda.synchronize() if device == \"cuda\" else None
    t1 = time.time()
    print({
        \"device\": device,
        \"n\": n,
        \"elapsed_sec\": t1 - t0,
        \"sample_abs_mean\": torch.mean(torch.abs(val)).item()
    })

if __name__ == \"__main__\":
    bench(\"cpu\", 100000)
    if torch.cuda.is_available():
        bench(\"cuda\", 1000000)\
\>", "ExternalLanguage",
 CellEvaluationLanguage->"Python",
 CellLabel->
  "In[176]:=",ExpressionUUID->"0b7a90a5-ecc0-9b46-b2c6-98af3acb9656"],

