Cell[CellGroupData[{

Cell["17. PDE Benchmark: Schr\[ODoubleDot]dinger-Type Spectral Test", \
"Section",ExpressionUUID->"8db7a508-ab79-8749-b60a-be45e43ae619"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hVal", "=", 
   RowBox[{"1", "/", "10"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"UnitStep", "[", "x", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{"2", " ", 
       RowBox[{"x", "^", "2"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"UnitStep", "[", 
      RowBox[{"-", "x"}], "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", "^", "2"}], "/", "2"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"schOp", "=", 
    RowBox[{"SchrodingerPDEComponent", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[CapitalPsi]", "[", "x", "]"}], ",", 
        RowBox[{"{", "x", "}"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<SchrodingerPotential\>\"", "->", 
         RowBox[{"V", "[", "x", "]"}]}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ReducedPlanckConstant\>\"", "->", "hVal"}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Mass\>\"", "->", 
         RowBox[{"1", "/", "2"}]}]}], "\[IndentingNewLine]", "  ", "|>"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"schBench", "=", 
    RowBox[{"withTiming", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Running Schr\[ODoubleDot]dinger spectral benchmark\>\"", ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vals", ",", "funs"}], "}"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"vals", ",", "funs"}], "}"}], "=", 
          RowBox[{"NDEigensystem", "[", "\[IndentingNewLine]", "      ", 
           RowBox[{"schOp", ",", "\[IndentingNewLine]", "      ", 
            RowBox[{"\[CapitalPsi]", "[", "x", "]"}], ",", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"{", 
             RowBox[{"x", ",", 
              RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
            "\[IndentingNewLine]", "      ", "6", ",", "\[IndentingNewLine]", 
            "      ", 
            RowBox[{"Method", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<PDEDiscretization\>\"", "->", 
               RowBox[{"{", 
                RowBox[{"\"\<FiniteElement\>\"", ",", 
                 RowBox[{"{", 
                  RowBox[{"\"\<MeshOptions\>\"", "->", 
                   RowBox[{"{", 
                    RowBox[{"MaxCellMeasure", "->", "0.05"}], "}"}]}], 
                  "}"}]}], "}"}]}], "}"}]}]}], "\[IndentingNewLine]", "    ", 
           "]"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Eigenvalues\>\"", "->", "vals"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<PotentialAt0\>\"", "->", 
            RowBox[{"V", "[", "0", "]"}]}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"\"\<SampleNorms\>\"", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"NIntegrate", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#1", "[", "x", "]"}], "^", "2"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"x", ",", 
                   RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "]"}], " ", "&"}],
               " ", "/@", " ", "funs"}], ")"}]}]}], "\[IndentingNewLine]", 
          "    ", "|>"}]}]}], "\[IndentingNewLine]", "  ", "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reportAssociation", "[", 
   RowBox[{"\"\<Schr\[ODoubleDot]dinger solver benchmark\>\"", ",", 
    "schBench"}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[156]:=",ExpressionUUID->"e5fe95d5-6258-f348-8a43-0ba4235bdbcf"],

