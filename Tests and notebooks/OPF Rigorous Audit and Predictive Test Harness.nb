Cell[CellGroupData[{

Cell["10. Hessian and Mass/Stiffness Cross-Checks", "Section",ExpressionUUID->"f162ee53-d722-aa42-b8bc-d01112310bb8"],

Cell["\<\
This extracts the local algebraic Hessian of the potential-like term and \
compares it to the zero-wave-number linear structure. \
\>", "Text",ExpressionUUID->"5732745a-c109-fb4d-814e-f089fe65acf8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"potentialPart", "=", 
   RowBox[{
    RowBox[{"\[Rho]s", " ", 
     RowBox[{"Log", "[", "\[Chi]s", "]"}]}], "+", 
    RowBox[{"\[Chi]s", " ", 
     RowBox[{"rs", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"potentialHessian", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{"potentialPart", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Rho]s", ",", "\[Chi]s", ",", "rs"}], "}"}], ",", "2"}], 
       "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"potentialHessianAtStationary", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"potentialHessian", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Rho]s", "->", "0"}], ",", 
        RowBox[{"\[Chi]s", "->", "1"}], ",", 
        RowBox[{"rs", "->", "0"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "say", "[", "\"\<Potential Hessian at stationary background:\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"MatrixForm", "[", "potentialHessianAtStationary", "]"}], "]"}], 
  ";"}]}], "Input",
 CellLabel->
  "In[116]:=",ExpressionUUID->"32c21b62-c6a6-054c-881a-3a8672dceb20"],

