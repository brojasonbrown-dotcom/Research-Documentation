}], "Item",ExpressionUUID->"b745db8f-e437-fb42-bcf3-bb2adfae1cc3"],

Cell["inspect residual identities", "Item",ExpressionUUID->"82715c9d-b53d-5242-b9f6-13bff449e46c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Numerical truth layer", "Subsection",ExpressionUUID->"8276ae37-f505-304a-b071-abc662e12084"],

Cell[TextData[{
 "use ",
