Cell[BoxData[{
 RowBox[{
  RowBox[{"inactiveEulerSystem", "=", 
   RowBox[{"Inactivate", "[", 
    RowBox[{"eulerSystem", ",", 
     RowBox[{
     "D", " ", "|", " ", "Laplacian", " ", "|", " ", "Div", " ", "|", " ", 
      "Grad"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
