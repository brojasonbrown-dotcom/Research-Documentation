Cell[CellGroupData[{

Cell["19. Precision Audit", "Section",ExpressionUUID->"75a8e61e-8dd2-8646-a21d-1edc1e1f998d"],

Cell["\<\
Your OPF instructions request effectively unbounded precision. Built-in PDE \
solvers do not support literal infinite working precision in finite element \
workflows. The rigorous practical method is:\
\>", "Text",ExpressionUUID->"26b74692-b2d8-ff42-8f62-73c9bd2756ab"],

Cell["1. use exact symbolic derivation where possible", "Text",ExpressionUUID->"b5922aae-4dfe-de4c-84f1-54d07f26e9f8"],

Cell["2. use arbitrary precision numerics where supported", "Text",ExpressionUUID->"bdc5e774-b564-8a4f-a5e0-d11c9f39691f"],

Cell["3. refine meshes / truncations", "Text",ExpressionUUID->"e00c2a34-ad6f-0844-bd98-f0491ec6d59a"],

Cell["4. perform convergence and residual testing", "Text",ExpressionUUID->"77673710-249a-0047-a49f-1220cd90dc4a"],

Cell["5. reject results that are not stable under refinement", "Text",ExpressionUUID->"1ce1f6c2-6301-ed49-9912-a1d08b6fddb4"],

Cell["This section implements a practical convergence audit. ", "Text",ExpressionUUID->"495a0ced-8762-794c-8ce0-f44c610bb677"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "precisionSweepResidual", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"precisionSweepResidual", "[", "prec_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "val", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"val", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"dispersionDet", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Alpha]", "->", "1"}], ",", 
             RowBox[{"\[Beta]", "->", "1"}], ",", 
             RowBox[{"\[Mu]", "->", "1"}], ",", 
             RowBox[{"kx", "->", "1"}], ",", 
             RowBox[{"ky", "->", "0"}], ",", 
             RowBox[{"kz", "->", "0"}], ",", 
             RowBox[{"\[Omega]", "->", "I"}]}], "}"}]}], ",", "prec"}], 
         "]"}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Precision\>\"", "->", "prec"}], ",", 
         RowBox[{"\"\<AbsValue\>\"", "->", 
          RowBox[{"Abs", "[", "val", "]"}]}]}], "|>"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"precisionAudit", "=", 
   RowBox[{"precisionSweepResidual", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"30", ",", "50", ",", "80", ",", "120"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reportAssociation", "[", 
   RowBox[{"\"\<Precision audit\>\"", ",", 
    RowBox[{"AssociationThread", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "precisionAudit", "]"}], "]"}], ",", 
      "precisionAudit"}], "]"}]}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[168]:=",ExpressionUUID->"92f02a62-1d80-1e49-b132-3eccc01301a8"],

