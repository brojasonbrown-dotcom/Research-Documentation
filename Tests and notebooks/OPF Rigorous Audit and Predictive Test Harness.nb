                  RowBox[{"\[Chi]", "[", 
                   RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
                  "#"}], "]"}]}], "]"}], ",", "#"}], "]"}], " ", "&"}], " ", "/@",
            " ", "coords4"}], "]"}]}], "\[IndentingNewLine]", "  ", "]"}]}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<r\>\"", "->", 
       RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"lagrangianRegularized", ",", 
