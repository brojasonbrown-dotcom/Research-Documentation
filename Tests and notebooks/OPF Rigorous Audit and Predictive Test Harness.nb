Cell[CellGroupData[{

Cell["11. Plane-Wave Modal Reduction", "Section",ExpressionUUID->"0d86e711-d1fa-0145-97ef-3bc2309029e6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"planeRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"u", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"u0", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "xx"}], "+", 
              RowBox[{"ky", " ", "yy"}], "+", 
              RowBox[{"kz", " ", "zz"}], "-", 
              RowBox[{"\[Omega]", " ", "tt"}]}], ")"}]}], "]"}]}]}], "]"}]}], 
      ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"v", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"v0", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "xx"}], "+", 
              RowBox[{"ky", " ", "yy"}], "+", 
              RowBox[{"kz", " ", "zz"}], "-", 
              RowBox[{"\[Omega]", " ", "tt"}]}], ")"}]}], "]"}]}]}], "]"}]}], 
      ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"w", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"w0", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "xx"}], "+", 
              RowBox[{"ky", " ", "yy"}], "+", 
              RowBox[{"kz", " ", "zz"}], "-", 
              RowBox[{"\[Omega]", " ", "tt"}]}], ")"}]}], "]"}]}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modalAlgebraic", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"linearizedSystem", " ", "/.", " ", "stationaryBackground"}], 
        " ", "/.", " ", "planeRules"}], ")"}], "/", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"kx", " ", "x"}], "+", 
          RowBox[{"ky", " ", "y"}], "+", 
          RowBox[{"kz", " ", "z"}], "-", 
          RowBox[{"\[Omega]", " ", "t"}]}], ")"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stiffnessMatrix", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
         RowBox[{"u0", ",", "v0", ",", "w0"}], "}"}]}], "]"}], " ", "&"}], 
     " ", "/@", " ", "modalAlgebraic"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dispersionDet", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Det", "[", "stiffnessMatrix", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eigenData", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Eigensystem", "[", "stiffnessMatrix", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"modalFrequencies", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"dispersionDet", "==", "0"}], ",", "\[Omega]"}], "]"}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stableFrequencyCondition", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Reduce", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dispersionDet", "==", "0"}], "&&", 
        RowBox[{"Element", "[", 
         RowBox[{"\[Omega]", ",", "Complexes"}], "]"}]}], ",", "\[Omega]"}], 
      "]"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"say", "[", "\"\<Modal stiffness matrix:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"MatrixForm", "[", "stiffnessMatrix", "]"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"say", "[", "\"\<Dispersion determinant:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"dispersionDet", " ", "//", " ", "TraditionalForm"}], "]"}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"say", "[", "\"\<Modal frequencies:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"modalFrequencies", " ", "//", " ", "InputForm"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"say", "[", "\"\<Stable frequency condition:\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"stableFrequencyCondition", " ", "//", " ", "InputForm"}], "]"}], 
  ";"}]}], "Input",
 CellLabel->
  "In[121]:=",ExpressionUUID->"66bd5e5b-36ec-5144-804a-a7cb58fb6918"],

