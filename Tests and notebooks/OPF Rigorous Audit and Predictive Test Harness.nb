                  "#"}], "]"}]}], "]"}], ",", "#"}], "]"}], " ", "&"}], " ", "/@",
            " ", "coords4"}], "]"}]}], "\[IndentingNewLine]", "  ", "]"}]}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<\[Chi]\>\"", "->", 
