Cell[CellGroupData[{

Cell["20. Predictive Testing Methodology", "Section",ExpressionUUID->"22f5e9e3-983b-a148-bf2a-a3017e452c8a"],

Cell["\<\
A predictive model is not validated by elegance alone. Use this hierarchy: \
\>", "Text",ExpressionUUID->"9a325aba-9938-f241-a216-1ff643ae1196"],

Cell[CellGroupData[{

Cell["Tier 1 \[LongDash] Symbolic correctness", "Subsection",ExpressionUUID->"1a353c7d-0ac8-1442-a067-93316bbf0ceb"],

Cell["Euler\[Dash]Lagrange agreement", "Item",ExpressionUUID->"5b9db066-f8fd-b44e-b709-eaebd5076f75"],

Cell["residual identity checks", "Item",ExpressionUUID->"4c838335-a2f1-1545-9602-342dee8821c6"],

Cell["background classification", "Item",ExpressionUUID->"868be43a-2e62-d945-8f97-8f607c31b5a6"],

Cell["modal determinant consistency", "Item",ExpressionUUID->"8008f498-269c-1647-bf0c-86ceac8f27b9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tier 2 \[LongDash] Numerical correctness", "Subsection",ExpressionUUID->"ba2b7546-c009-0540-8b13-b908bf2c7026"],

Cell["mesh refinement convergence", "Item",ExpressionUUID->"8a27d853-68f8-7e41-ab8e-f71167f18be6"],

Cell["precision convergence", "Item",ExpressionUUID->"a5cf06e6-1537-9f45-bc20-689c5bb9783e"],

Cell["normalization audits", "Item",ExpressionUUID->"a9e3420a-b1c0-ab49-ba41-967977ae1ea3"],

Cell["independent solver comparison", "Item",ExpressionUUID->"8436e7db-c44d-f745-b9b6-d5e27c3a2caf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tier 3 \[LongDash] Structural correctness", "Subsection",ExpressionUUID->"a7c68e74-c660-514a-bb97-570aeb8c89db"],

Cell["observability / controllability of reduced forms", "Item",ExpressionUUID->"a51e5a6f-0d0f-be47-9fa6-25784e65243e"],

Cell["stability under perturbation", "Item",ExpressionUUID->"7b3f1fa8-3063-2541-9845-9bba7244ec35"],

Cell["parameter sensitivity", "Item",ExpressionUUID->"e509c6dc-d888-294a-a6a5-9a5df45f8d14"],

Cell["identification of singular / rigid modes", "Item",ExpressionUUID->"2d4431d9-ccc0-dc4b-b5a8-490cd2524988"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tier 4 \[LongDash] Predictive correctness", "Subsection",ExpressionUUID->"8a17f558-375f-af44-a7f8-d5c0bbd50e66"],

Cell["fit on one dataset", "Item",ExpressionUUID->"fdc3e6b3-0190-9e4b-9f1d-49c27e8936dc"],

Cell["predict on held-out datasets", "Item",ExpressionUUID->"66181eba-5a22-2541-88ec-f0cd368b1e20"],

Cell["compare forecast residuals", "Item",ExpressionUUID->"a9c9a543-da49-3f4f-999f-04d28833ed3a"],

Cell["reject models that only interpolate", "Item",ExpressionUUID->"1b96eabc-0679-e347-ad46-afbd79920471"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tier 5 \[LongDash] Deployment correctness", "Subsection",ExpressionUUID->"df6acb6d-77fb-5446-a82d-f4ab86f0c157"],

Cell["benchmark on target hardware", "Item",ExpressionUUID->"6b346f90-a5fa-b642-b746-5177fbe93618"],

