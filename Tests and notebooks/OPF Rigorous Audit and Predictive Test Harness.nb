Cell[CellGroupData[{

Cell["7. Symbol Audit and Missing-Variable Report", "Section",ExpressionUUID->"9f4af98b-5ed0-6e44-8935-22b62c861d87"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"actionSymbols", "=", 
    RowBox[{"DeleteDuplicates", " ", "@", " ", 
     RowBox[{"Cases", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{"lagrangianRegularized", ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"s_Symbol", " ", "/;", " ", 
        RowBox[{
         RowBox[{"Context", "[", "s", "]"}], "===", "\"\<Global`\>\""}]}], ",",
        "\[IndentingNewLine]", "   ", "Infinity"}], "\[IndentingNewLine]", 
      "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"actionHeads", "=", 
    RowBox[{"DeleteDuplicates", " ", "@", " ", 
     RowBox[{"Cases", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{"lagrangianRegularized", ",", "\[IndentingNewLine]", "   ", 
       RowBox[{
        RowBox[{"hSymbol", "[", "___", "]"}], ":>", "h"}], ",", 
       "\[IndentingNewLine]", "   ", "Infinity"}], "\[IndentingNewLine]", 
      "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"standardModelLikeConstants", "=", 
   RowBox[{"{", 
    RowBox[{"c", ",", "h", ",", "\[HBar]", ",", "G", ",", "kB", ",", "E", ",", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[Epsilon]", ",", "0"}], "]"}], ",", 
     RowBox[{"Subscript", "[", 
      RowBox[{"\[Mu]", ",", "0"}], "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"opfSymbolsAudit", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{
     RowBox[{"Join", "[", 
      RowBox[{"actionSymbols", ",", "actionHeads"}], "]"}], ",", 
     RowBox[{"Join", "[", 
      RowBox[{"coords4", ",", 
       RowBox[{"{", "Log", "}"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"missingVsStandardModel", "=", 
    RowBox[{"Complement", "[", 
     RowBox[{"opfSymbolsAudit", ",", "standardModelLikeConstants"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reportAssociation", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<Symbol audit\>\"", ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"<|", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"\"\<AllGlobalSymbolsAndHeads\>\"", "->", "opfSymbolsAudit"}], ",",
       "\[IndentingNewLine]", "    ", 
      RowBox[{"\"\<MissingVsSMConstants\>\"", "->", 
       "missingVsStandardModel"}]}], "\[IndentingNewLine]", "  ", "|>"}]}], 
