Cell[CellGroupData[{

Cell["16. PDE Benchmark: Numerical Eigenmode Test", "Section",ExpressionUUID->"13a41779-ffcd-3846-854b-bf2a5b7ff7a9"],

Cell[TextData[{
 "This is not the OPF PDE itself; it is a ",
 StyleBox["solver sanity benchmark",
  FontWeight->Bold],
 " using built-in eigenmode infrastructure. If this fails, your PDE numerics \
stack is suspect. "
}], "Text",ExpressionUUID->"8292d641-db8f-c24c-8fad-16bc0a808682"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pdeBench", "=", 
    RowBox[{"withTiming", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Running numerical PDE eigenmode sanity test\>\"", ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vals", ",", "funs"}], "}"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"vals", ",", "funs"}], "}"}], "=", 
          RowBox[{"NDEigensystem", "[", "\[IndentingNewLine]", "      ", 
           RowBox[{
            RowBox[{"{", "\[IndentingNewLine]", "        ", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Laplacian", "[", 
                RowBox[{
                 RowBox[{"u", "[", 
                  RowBox[{"x", ",", "y"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ",", 
              "\[IndentingNewLine]", "        ", 
              RowBox[{"DirichletCondition", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"u", "[", 
                  RowBox[{"x", ",", "y"}], "]"}], "==", "0"}], ",", "True"}], 
               "]"}]}], "\[IndentingNewLine]", "      ", "}"}], ",", 
            "\[IndentingNewLine]", "      ", 
            RowBox[{"u", "[", 
             RowBox[{"x", ",", "y"}], "]"}], ",", "\[IndentingNewLine]", 
            "      ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"x", ",", "y"}], "}"}], " ", "\[Element]", " ", 
             RowBox[{"Disk", "[", "]"}]}], ",", "\[IndentingNewLine]", 
            "      ", "4"}], "\[IndentingNewLine]", "    ", "]"}]}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Eigenvalues\>\"", "->", "vals"}], ",", 
           "\[IndentingNewLine]", "      ", 
           RowBox[{"\"\<L2NormsApprox\>\"", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"NIntegrate", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#1", "[", 
                   RowBox[{"x", ",", "y"}], "]"}], "^", "2"}], ",", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"x", ",", "y"}], "}"}], " ", "\[Element]", " ", 
                  RowBox[{"Disk", "[", "]"}]}]}], "]"}], " ", "&"}], " ", "/@",
               " ", "funs"}], ")"}]}]}], "\[IndentingNewLine]", "    ", 
          "|>"}]}]}], "\[IndentingNewLine]", "  ", "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"reportAssociation", "[", 
   RowBox[{"\"\<PDE eigenmode solver sanity benchmark\>\"", ",", "pdeBench"}],
    "]"}], ";"}]}], "Input",
 CellLabel->
  "In[154]:=",ExpressionUUID->"57ca9c3b-e155-4d4b-b190-aa01fe0fce74"],

Cell[BoxData[
 TemplateBox[{
  "NIntegrate", "inumr", 
   "\"The integrand \
\\!\\(\\*SuperscriptBox[RowBox[{RowBox[{RowBox[{\\\"InterpolatingFunction\\\",\
 \\\"[\\\", RowBox[{\\\"\[LeftSkeleton]\\\", \\\"1\\\", \
\\\"\[RightSkeleton]\\\"}], \\\"]\\\"}], \\\"[\\\", RowBox[{\\\"x\\\", \
