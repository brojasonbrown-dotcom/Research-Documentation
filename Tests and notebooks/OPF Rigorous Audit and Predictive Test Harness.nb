Cell[CellGroupData[{

Cell["27. Important Practical Note", "Section",ExpressionUUID->"5ad5474f-c231-2445-9da8-99fb9425b709"],

Cell["\<\
Your OPF instruction requests infinite working precision for all \
spatial/temporal integrations. In practical finite numerical computing, \
literal infinite precision is not available for FEM eigensolvers. The \
rigorous replacement is: \
\>", "Text",ExpressionUUID->"fb49a13e-7909-1049-8fee-94be937d2e5c"],

Cell["exact symbolic derivation first", "Item",ExpressionUUID->"0789b0a5-1f93-a248-97aa-593de4326a56"],

Cell["arbitrary precision where supported", "Item",ExpressionUUID->"47ee64cc-9b50-094a-ab0e-83fbfa91ec92"],

Cell["systematic convergence sweeps", "Item",ExpressionUUID->"4f85953f-0b71-ff45-9419-e4caa52c0533"],

Cell["residual-based acceptance", "Item",ExpressionUUID->"87e413e9-ac6b-2b48-90c0-8df8c6f28d3d"],

Cell["independent cross-validation", "Item",ExpressionUUID->"60169e87-633f-2143-99ec-ed2c286c68d7"],

Cell["\<\
That is the closest mathematically honest implementation path for predictive \
testing.\
\>", "Text",ExpressionUUID->"b5636976-776a-474e-83c9-740d5dab3342"]
}, Open  ]]
}, Open  ]]
