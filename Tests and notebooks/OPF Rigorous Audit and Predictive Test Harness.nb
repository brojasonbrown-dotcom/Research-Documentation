Cell[CellGroupData[{

Cell["22. PyTorch / CUDA Benchmark Hooks", "Section",ExpressionUUID->"ecb94b80-5d73-fc49-9f4a-dc7d73654237"],

Cell["\<\
The Wolfram side should export clean tensors / arrays for external runs. \
\>", "Text",ExpressionUUID->"441a255b-cf54-c64a-9fb4-27abfac15f07"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"benchmarkExport", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<StationaryBackground\>\"", "->", "stationaryBackground"}], 
      ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<StiffnessMatrix\>\"", "->", "stiffnessMatrix"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<DispersionDeterminant\>\"", "->", "dispersionDet"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<LinearizedSystem\>\"", "->", "linearizedSystem"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ParameterPoint\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<\[Alpha]\>\"", "->", "1."}], ",", 
         RowBox[{"\"\<\[Beta]\>\"", "->", "1."}], ",", 
         RowBox[{"\"\<\[Mu]\>\"", "->", "1."}], ",", 
         RowBox[{"\"\<kx\>\"", "->", "1."}], ",", 
         RowBox[{"\"\<ky\>\"", "->", "0."}], ",", 
         RowBox[{"\"\<kz\>\"", "->", "0."}]}], "|>"}]}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], 
       ",", "\"\<opf-benchmark-export.wl\>\""}], "}"}], "]"}], ",", 
    "benchmarkExport"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Export", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"NotebookDirectory", "[", "]"}], 
        ",", "\"\<opf-benchmark-export.json\>\""}], "}"}], "]"}], ",", 
     RowBox[{"Normal", "[", "benchmarkExport", "]"}], ",", "\"\<JSON\>\""}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
