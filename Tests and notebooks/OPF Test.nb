Cell[CellGroupData[{

Cell["5. Euler\[Dash]Lagrange derivation", "Section",ExpressionUUID->"ede7611b-0139-ad49-bb1f-b7d344593d05"],

Cell[TextData[{
 "Use ",
 ButtonBox["VariationalD",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/VariationalD"],
 " carefully and inspect the result explicitly. "
}], "Text",ExpressionUUID->"eacd9de4-fce3-f547-b6c5-0001ee58cfc2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"eulerRhoRaw", "=", 
   RowBox[{"VariationalD", "[", 
    RowBox[{"lagrangianDensity", ",", 
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eulerChiRaw", "=", 
   RowBox[{"VariationalD", "[", 
    RowBox[{"lagrangianDensity", ",", 
     RowBox[{"chi", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eulerResRaw", "=", 
    RowBox[{"VariationalD", "[", 
     RowBox[{"lagrangianDensity", ",", 
      RowBox[{"res", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eulerRho", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"eulerRhoRaw", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eulerChi", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"eulerChiRaw", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eulerRes", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"eulerResRaw", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fieldEquations", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eulerRho", ",", "eulerChi", ",", "eulerRes"}], "}"}], "==", 
     "0"}], "]"}]}], ";"}]}], "Input",ExpressionUUID->"9bf402ea-a720-354a-\
8334-07fb1dbb8a29"],

Cell[CellGroupData[{

Cell["Expected symbolic forms", "Subsection",ExpressionUUID->"4ce1d88c-a66d-9846-ade1-e2fd994dcb06"],

Cell["\<\
For this Lagrangian, the Euler\[Dash]Lagrange equations should include \
second-derivative terms. In particular: \
\>", "CodeText",ExpressionUUID->"7eeaefe9-a728-ac49-9430-bfa68f6dc2ed"],

Cell[BoxData[{
 RowBox[{"expectedEulerRho", "=", "\[IndentingNewLine]", "   ", 
  RowBox[{
   RowBox[{"Log", "[", 
    RowBox[{"chi", "[", 
     RowBox[{"x", ",", "sigma"}], "]"}], "]"}], "+", 
   RowBox[{"delta", " ", 
    RowBox[{"chi", "[", 
     RowBox[{"x", ",", "sigma"}], "]"}], " ", 
    RowBox[{"res", "[", 
     RowBox[{"x", ",", "sigma"}], "]"}]}], "+", 
   RowBox[{"2", " ", "lambda", " ", 
    RowBox[{"rho", "[", 
     RowBox[{"x", ",", "sigma"}], "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"   ", 
  RowBox[{
   RowBox[{"-", "2"}], " ", "alpha", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Derivative", "[", 
