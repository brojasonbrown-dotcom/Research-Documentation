Cell[CellGroupData[{

Cell["6. Homogeneous stationary sector", "Section",ExpressionUUID->"10417256-143f-474f-87e6-102ec34bc7b7"],

Cell["Define the homogeneous substitution rules more compactly. ", "Text",ExpressionUUID->"5f3141f6-2ec5-4848-9484-c3a661501712"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"homogeneousRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "rho0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "chi0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "res0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"homogeneousEquations", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"fieldEquations", " ", "/.", " ", "homogeneousRules"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"chi0", ">", "0"}]}]}], "]"}]}], ";"}]}], "Input",ExpressionUUID\
->"2b4da358-a299-b648-9917-941cee5b8688"],

