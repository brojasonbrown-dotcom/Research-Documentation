Cell[CellGroupData[{

Cell["8. Scale ansatz without assumption errors", "Section",ExpressionUUID->"b93f2460-cc6d-3d40-9ff4-9c80a8457fe3"],

Cell[TextData[{
 "The earlier notebook used ",
 ButtonBox["Join",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Join"],
 " incorrectly on ",
 ButtonBox["$Assumptions",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/$Assumptions"],
 ". Use logical conjunction instead. "
}], "Text",ExpressionUUID->"c529576c-0a53-dc41-bc8a-6fd2ea68deb2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"scaleAnsatz", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{
        RowBox[{"rhoS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"a", " ", "sigma"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{
        RowBox[{"chiS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"b", " ", "sigma"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{
        RowBox[{"resS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"c", " ", "sigma"}], "]"}]}]}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scaleReducedEquations", "=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"fieldEquations", " ", "/.", " ", "scaleAnsatz"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"(", 
       RowBox[{"$Assumptions", "&&", 
        RowBox[{
         RowBox[{"chiS", "[", "x", "]"}], ">", "0"}]}], ")"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"4f88bb2d-ca81-5341-bd49-259ae180bf27"],

Cell[CellGroupData[{

Cell["Extract exponent structure", "Subsection",ExpressionUUID->"0dd0f416-0259-a94a-adfe-c6afe6817ed7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"expPowers", "[", "expr_", "]"}], ":=", 
   RowBox[{"DeleteDuplicates", " ", "@", " ", 
    RowBox[{"Cases", "[", 
     RowBox[{"expr", ",", 
      RowBox[{
       RowBox[{"E", "^", 
        RowBox[{"(", 
         RowBox[{"k_.", " ", "sigma"}], ")"}]}], ":>", "k"}], ",", 
      "Infinity"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scalePowers", "=", 
   RowBox[{"expPowers", " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{"Subtract", " ", "@@@", " ", "scaleReducedEquations"}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", "scalePowers"}], "Input",Express\
ionUUID->"22e7f43c-92ce-d244-bd52-ac3494acf7d6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Interpretation", "Subsection",ExpressionUUID->"bbd86ede-9ae0-0944-8d27-897172216056"],

Cell["\<\
If multiple distinct scale exponents appear in a single reduced equation, \
then strict scale covariance generally requires matching conditions such as: \
\>", "Text",ExpressionUUID->"74ddf2bb-4a8f-0c46-8622-c303dc2330e6"],

Cell[TextData[{
 Cell[BoxData[Cell["a == b",
   Background->None,ExpressionUUID->"e5de3839-7664-6341-a976-68d5f35af8ba"]], 
  "InlineCode",ExpressionUUID->"678fcb22-8c90-124b-92c2-5520b16656dd"],
 ","
}], "Item",ExpressionUUID->"82c8bb85-39c5-7e4b-9632-b643e0728db6"],

Cell[TextData[{
 Cell[BoxData[Cell["a == c",
   Background->None,ExpressionUUID->"6855b9a1-b956-0c43-9f28-daa48102623b"]], 
  "InlineCode",ExpressionUUID->"eb086bcc-dd07-ae4f-ab39-dd58e5647969"],
 ","
}], "Item",ExpressionUUID->"4ae08a1a-ab37-1944-aab4-32deeebe68c0"],

Cell["\<\
or vanishing coefficients/functions for incompatible sectors.\
\>", "Item",ExpressionUUID->"6690353e-c51f-634c-af92-62cbdb58f127"],

Cell[TextData[{
 "This is a ",
 StyleBox["consistency filter",
  FontWeight->Bold],
 ", not yet a physical result. "
}], "Text",ExpressionUUID->"65eaed02-7bdf-3f49-8ef9-151589bfadb0"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"8dff93a5-7c85-c14a-9a8d-bbb4c1a5e185"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Linearization around a homogeneous fixed point", "Section",ExpressionUUID->"b83a41df-0726-5440-895d-5a1dd0e015de"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[LongEqual]", 
         SubscriptBox["\[Rho]", "0"], "+", "\[Epsilon]", 
         StyleBox["u", "TI"], ",  ", "\[Chi]", "\[LongEqual]", 
         SubscriptBox["\[Chi]", "0"], "+", "\[Epsilon]", 
         StyleBox["v", "TI"], ",  ", 
         StyleBox["r", "TI"], 
         StyleBox["e", "TI"], 
         StyleBox["s", "TI"], "\[LongEqual]", 
         StyleBox["r", "TI"], 
         StyleBox["e", "TI"], 
         SubscriptBox[
          StyleBox["s", "TI"], "0"], "+", "\[Epsilon]", 
         StyleBox["w", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho = \\rho_0 + \\epsilon u,\\quad \\chi = \\chi_0 + \\epsilon \
v,\\quad res = res_0 + \\epsilon w", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d199213-ef1f-e344-98c0-b9c1ee167838"],
 "and keep first order in ",
 StyleBox["epsilon", "TI"],
 ". "
}], "Text",ExpressionUUID->"e29411fd-bfa9-594c-aa89-2f2f0c26800f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"linearizationRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"rho0", "+", 
        RowBox[{"epsilon", " ", 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"chi0", "+", 
        RowBox[{"epsilon", " ", 
         RowBox[{"v", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"res0", "+", 
        RowBox[{"epsilon", " ", 
         RowBox[{"w", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}]}]}]}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearizedEquations", "=", 
    RowBox[{
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"Series", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"fieldEquations", " ", "/.", " ", "linearizationRules"}], ",",
         "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"epsilon", ",", "0", ",", "1"}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}], " ", "//", " ", "Thread"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"firstOrderEquations", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"#", ",", "epsilon", ",", "1"}], "]"}], "==", "0"}], " ", 
     "&"}], " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{"Subtract", " ", "@@@", " ", "linearizedEquations"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", "firstOrderEquations"}], "Input",ExpressionUUI\
D->"6bfc3be7-1e77-f041-89a2-6e4955351027"],

Cell[CellGroupData[{

Cell["Modal ansatz", "Subsection",ExpressionUUID->"11ff52a2-7edd-a943-98dd-1fa82161ba95"],

Cell["Use Fourier separation: ", "CodeText",ExpressionUUID->"bc062935-937a-4a48-a35d-5725f9147153"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"modalRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"uAmp", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"v", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"vAmp", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"w", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"wAmp", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modalSystem", "=", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Subtract", " ", "@@@", " ", "firstOrderEquations"}], ")"}], 
        " ", "/.", " ", "modalRules"}], " ", "//", " ", 
       RowBox[{
        RowBox[{"DivideBy", "[", 
         RowBox[{"#", ",", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "x"}], "+", 
              RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}], "]"}], " ", 
        "&"}]}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stiffnessMatrix", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CoefficientArrays", "[", 
      RowBox[{"modalSystem", ",", 
       RowBox[{"{", 
        RowBox[{"uAmp", ",", "vAmp", ",", "wAmp"}], "}"}]}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}], " ", "//", " ", "Normal"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "stiffnessMatrix", "]"}]}], "Input",ExpressionUUID\
->"29969d34-3404-864e-950b-323bc5cc3c59"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Dispersion condition", "Subsection",ExpressionUUID->"4c765e2e-69fc-584a-8726-d5caf5c6405c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dispersionCondition", "=", 
   RowBox[{
    RowBox[{"Det", "[", "stiffnessMatrix", "]"}], " ", "//", " ", 
    "FullSimplify"}]}], ";"}]], "Input",ExpressionUUID->"aaeed793-95d3-1740-\
8d0d-f28bf415b5b5"],

Cell["\<\
This determinant defines the modal stability condition. Stable undamped modes \
in the user's OPF framing correspond to spectral conditions imposed on this \
matrix. \
\>", "Text",ExpressionUUID->"f0f348f6-e725-ac45-9436-f67c7eea9420"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"5f6ba2d0-6df6-344f-acab-5d5edf458fb9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Visual parameter scans", "Section",ExpressionUUID->"22e874bf-3af7-1f40-8617-7aa265e7817d"],

Cell["Pick a concrete parameter set only for diagnostics. ", "Text",ExpressionUUID->"156a6106-9887-a145-8791-b6a12cebcfd3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"parameterSet", "=", 
   RowBox[{"{", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"alpha", "->", "1"}], ",", 
     RowBox[{"beta", "->", "1"}], ",", 
     RowBox[{"gamma", "->", "1"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"eta", "->", "1"}], ",", 
     RowBox[{"zeta", "->", "1"}], ",", 
     RowBox[{"xi", "->", "1"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"delta", "->", "1"}], ",", 
     RowBox[{"lambda", "->", 
      RowBox[{"1", "/", "2"}]}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"rho0", "->", "0"}], ",", 
     RowBox[{"chi0", "->", "1"}], ",", 
     RowBox[{"res0", "->", "0"}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",ExpressionUUID->"36d2a3c7-92d4-8042-919b-688f2ee28899"],

Cell[CellGroupData[{

Cell["Potential landscape slices", "Subsection",ExpressionUUID->"401ccf44-df10-ed40-ae85-ae262673a464"],

Cell[BoxData[
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"potentialHomogeneous", " ", "/.", " ", "parameterSet"}], " ", "/.",
      " ", 
     RowBox[{"res0", "->", "0"}]}], "]"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{"rho0", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"chi0", ",", "0.2", ",", "3"}], "}"}], ",", "\[IndentingNewLine]",
    " ", 
   RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<rho0\>\"", ",", "\"\<chi0\>\"", ",", "\"\<V\>\""}], "}"}]}],
    ",", "\[IndentingNewLine]", " ", 
   RowBox[{"PlotLabel", "->", "\"\<Potential slice at res0 = 0\>\""}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",ExpressionUUID->"fa29272b-67a6-f243-\
bbd3-af9a39cb79e1"],

Cell[BoxData[
 RowBox[{"ContourPlot", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"potentialHomogeneous", " ", "/.", " ", "parameterSet"}], " ", "/.",
      " ", 
     RowBox[{"res0", "->", "0"}]}], "]"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{"rho0", ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"chi0", ",", "0.2", ",", "3"}], "}"}], ",", "\[IndentingNewLine]",
    " ", 
   RowBox[{"Contours", "->", "20"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<rho0\>\"", ",", "\"\<chi0\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"PlotLabel", "->", "\"\<Potential contours\>\""}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",ExpressionUUID->"a6b291ad-d929-5f45-\
827d-5bc0b66fd8d0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Hessian eigenvalue scan", "Subsection",ExpressionUUID->"df4c0f56-1371-c343-8593-60eeabbc94cb"],

Cell[BoxData[
 RowBox[{"With", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mat", "=", 
     RowBox[{
      RowBox[{"hessian", " ", "/.", " ", "parameterSet"}], " ", "/.", " ", 
      RowBox[{"res0", "->", "0"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"Plot", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"Eigenvalues", "[", 
       RowBox[{"mat", " ", "/.", " ", 
        RowBox[{"chi0", "->", "1"}]}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{"rho0", ",", 
       RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"PlotLegends", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<rho0\>\"", ",", "\"\<eigenvalue\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{
     "PlotLabel", 
      "->", "\"\<Hessian eigenvalues along chi0 = 1, res0 = 0\>\""}]}], 
    "\[IndentingNewLine]", "  ", "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"9c8829f5-2868-8843-a054-56568cfb8335"],

