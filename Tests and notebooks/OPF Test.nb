Cell[CellGroupData[{

Cell["12. Golden-ratio and angular scans", "Section",ExpressionUUID->"e4be6a6b-320f-e24d-8c91-3e9ad8c4da6f"],

Cell["\<\
If you want ratio testing, keep it separate from the field-theory derivation. \
\>", "Text",ExpressionUUID->"ce31b683-0014-0743-9191-f2b67a4d43cd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"goldenRatio", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Sqrt", "[", "5", "]"}]}], ")"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"goldenAngle", "=", 
   RowBox[{"2", " ", "Pi", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"1", "/", "goldenRatio"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"N", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"goldenRatio", ",", "goldenAngle"}], "}"}], ",", "30"}], 
  "]"}]}], "Input",ExpressionUUID->"5043da16-4b34-074a-9912-49b2b6d6d52b"],

Cell[CellGroupData[{

Cell["Ratio error utility", "Subsection",ExpressionUUID->"27f50e8e-e63f-1b48-8c52-bee72a05654f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ratioError", "[", 
     RowBox[{"estimate_", ",", "target_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"estimate", "-", "target"}], "]"}], "/", 
     RowBox[{"Abs", "[", "target", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"ratioError", "[", 
     RowBox[{"1.61581", ",", "goldenRatio"}], "]"}], "<", "0.002"}], ",", 
   "\[IndentingNewLine]", " ", "True", ",", "\[IndentingNewLine]", " ", 
   RowBox[{"TestID", "->", "\"\<GoldenRatioExampleErrorBound\>\""}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",ExpressionUUID->"831f9143-04f8-c845-\
bdfa-dc87eb0b8c59"],

