Cell[CellGroupData[{

Cell["11. Candidate potential comparison framework", "Section",ExpressionUUID->"7a178e15-f698-e848-8ef9-9179649004de"],

Cell["\<\
To mirror the Python \[OpenCurlyDoubleQuote]equation foundry\
\[CloseCurlyDoubleQuote] idea, structure candidate potentials explicitly. \
\>", "Text",ExpressionUUID->"a9116134-0aee-7642-aeb2-3b60e8969598"],

Cell[BoxData[
 RowBox[{
  RowBox[{"candidatePotentials", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\"\<Original\>\"", "->", 
      RowBox[{
       RowBox[{"rho0", " ", 
        RowBox[{"Log", "[", "chi0", "]"}]}], "+", 
       RowBox[{"chi0", " ", 
        RowBox[{"res0", "^", "2"}]}]}]}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<KLLike\>\"", "->", 
      RowBox[{
       RowBox[{"rho0", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"rho0", "/", "chi0"}], "]"}]}], "-", "rho0", "+", "chi0", "+", 
       RowBox[{
        RowBox[{"res0", "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "chi0"}], ")"}]}]}]}], ",", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{"\"\<RhoSquaredChi\>\"", "->", 
      RowBox[{
       RowBox[{"rho0", "^", "2"}], " ", "chi0"}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<MixedPolynomial\>\"", "->", 
      RowBox[{
       RowBox[{"chi0", " ", 
        RowBox[{"res0", "^", "2"}]}], "+", 
       RowBox[{"delta", " ", "rho0", " ", "chi0", " ", "res0"}], "+", 
       RowBox[{
        RowBox[{"rho0", "^", "2"}], " ", "chi0"}]}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",ExpressionUUID->\
"4a94e3ff-c8eb-4840-8513-291ce2d1efa3"],

Cell[CellGroupData[{

Cell["Property tests", "Subsection",ExpressionUUID->"1e06b9ff-d48a-c941-a4c8-5bb084120d81"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"candidateSummary", "=", 
    RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"v", ",", "\[IndentingNewLine]", "     ", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"grad", ",", "hes"}], "}"}], ",", "\[IndentingNewLine]", 
          "       ", 
          RowBox[{
           RowBox[{"grad", "=", 
            RowBox[{"D", "[", 
             RowBox[{"v", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", 
                "1"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           "       ", 
           RowBox[{"hes", "=", 
            RowBox[{"D", "[", 
             RowBox[{"v", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", 
                "2"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           "       ", 
           RowBox[{"<|", "\[IndentingNewLine]", "         ", 
            RowBox[{
             RowBox[{"\"\<Gradient\>\"", "->", "grad"}], ",", 
             "\[IndentingNewLine]", "         ", 
             RowBox[{"\"\<Hessian\>\"", "->", "hes"}], ",", 
             "\[IndentingNewLine]", "         ", 
             RowBox[{"\"\<AtSpecialPointGradient\>\"", "->", 
              RowBox[{"Simplify", "[", 
               RowBox[{"grad", " ", "/.", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"rho0", "->", "0"}], ",", 
                  RowBox[{"chi0", "->", "1"}], ",", 
                  RowBox[{"res0", "->", "0"}]}], "}"}]}], "]"}]}], ",", 
             "\[IndentingNewLine]", "         ", 
             RowBox[{
              RowBox[{"\"\<AtSpecialPointEigenvalues\>\"", "->", 
               RowBox[{"Eigenvalues", "[", 
                RowBox[{"hes", " ", "/.", " ", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"rho0", "->", "0"}], ",", 
                   RowBox[{"chi0", "->", "1"}], ",", 
                   RowBox[{"res0", "->", "0"}]}], "}"}]}], "]"}]}], " ", "//",
               " ", "Simplify"}]}], "\[IndentingNewLine]", "       ", 
            "|>"}]}]}], "\[IndentingNewLine]", "     ", "]"}]}], 
       "\[IndentingNewLine]", "   ", "]"}], ",", "\[IndentingNewLine]", "   ",
       "candidatePotentials"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "candidateSummary"}], \
"Input",ExpressionUUID->"c3cdeeb8-4541-af48-8761-006c1eeb7fa6"],

Cell[TextData[{
 "This does not fully reproduce the Python search, but it creates a ",
 StyleBox["transparent symbolic testing harness",
  FontWeight->Bold],
 " for candidate potentials. "
}], "Text",ExpressionUUID->"94ed94ac-bea3-6e4c-a193-f7e092618964"],

