Cell[CellGroupData[{

Cell["13. Self-measurement kernel as a mathematical object", "Section",ExpressionUUID->"c5d52591-93d6-f247-82aa-31493e8b0605"],

Cell["\<\
To keep the notebook rigorous, define a kernel independently of metaphysical \
interpretation. \
\>", "Text",ExpressionUUID->"71e1fe97-af6f-d845-adba-8c076b23e6a0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"selfKernel", ",", "psi"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"selfKernel", "[", 
    RowBox[{"x_", ",", "y_", ",", "theta_", ",", "s_"}], "]"}], ":=", 
   "\[IndentingNewLine]", "   ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "y"}], ")"}], "^", "2"}]}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"s", "^", "2"}]}], ")"}]}], "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"theta", " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "y"}], ")"}]}], "]"}]}]}], ";"}]}], "Input",Expressio\
nUUID->"575e5656-e335-6e40-9eec-a88a4517840a"],

Cell["An operator form can be written as: ", "CodeText",ExpressionUUID->"3604c76c-64b5-bd42-862f-581a28ab4397"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"qOperator", "[", 
    RowBox[{"psi_", ",", "x_", ",", "theta_", ",", "s_"}], "]"}], ":=", 
   "\[IndentingNewLine]", "   ", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"selfKernel", "[", 
       RowBox[{"x", ",", "y", ",", "theta", ",", "s"}], "]"}], " ", 
      RowBox[{"psi", "[", "y", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"s", ">", "0"}], ",", 
        RowBox[{"theta", " ", "\[Element]", " ", "Reals"}], ",", 
        RowBox[{"x", " ", "\[Element]", " ", "Reals"}]}], "}"}]}]}], "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"daead6bd-dab0-2a41-990b-c58229597e03"],

Cell["This section should distinguish carefully among: ", "Text",ExpressionUUID->"5a124e64-fe95-c74f-a152-c08db01fc75d"],

Cell["kernel definition,", "Item",ExpressionUUID->"155a0033-21c9-294d-8824-e3f41c167722"],

Cell["spectral properties,", "Item",ExpressionUUID->"994a5393-4478-4e4b-b45a-e0f635d9e5cf"],

Cell["fixed points,", "Item",ExpressionUUID->"95b23a99-5b72-1b41-b61b-48472c11a1d3"],

Cell["interpretation as \[OpenCurlyDoubleQuote]self-measurement\
\[CloseCurlyDoubleQuote].", "Item",ExpressionUUID->"e6cd0b4d-25ae-bc47-b2ac-\
7f0d0741c694"],

Cell["Those are not the same thing. ", "Text",ExpressionUUID->"df623193-59f4-b042-8079-96eaa067a7fd"],

Cell[BoxData[
 TagBox[GridBox[{
    {
