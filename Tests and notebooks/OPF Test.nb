Cell[CellGroupData[{

Cell["4. Define the scale-extended Lagrangian density", "Section",ExpressionUUID->"f7b0dcb1-58cf-8140-b9cd-320c7bf1b853"],

Cell["\<\
We separate the potential part from the derivative regularizers. \
\>", "Text",ExpressionUUID->"647fa7b2-6ef9-0449-ad2f-37386fe7fed3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"potentialDensity", "=", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"rho", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "]"}]}], "+", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"chi", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], " ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}]}], "+", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"delta", " ", 
      RowBox[{"rho", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], " ", 
      RowBox[{"chi", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], " ", 
      RowBox[{"res", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}]}], "+", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{"lambda", " ", 
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"regularizationDensity", "=", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"alpha", " ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"rho", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
       "2"}]}], "+", "\[IndentingNewLine]", "   ", 
     RowBox[{"beta", " ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"chi", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
       "2"}]}], "+", "\[IndentingNewLine]", "   ", 
     RowBox[{"gamma", " ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"res", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
       "2"}]}], "+", "\[IndentingNewLine]", "   ", 
     RowBox[{"eta", " ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"rho", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", "2"}]}],
      "+", "\[IndentingNewLine]", "   ", 
     RowBox[{"zeta", " ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"chi", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", "2"}]}],
      "+", "\[IndentingNewLine]", "   ", 
     RowBox[{"xi", " ", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"res", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", 
       "2"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lagrangianDensity", "=", 
   RowBox[{"potentialDensity", "+", "regularizationDensity"}]}], 
  ";"}]}], "Input",ExpressionUUID->"8cf51e1f-a8b7-1748-bc34-a929777b47e8"],

Cell[CellGroupData[{

Cell["Structural checks", "Subsection",ExpressionUUID->"d8dbb1a8-85c4-1f47-ac73-cb8986f882b1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"lagrangianDensity", "===", 
      RowBox[{"potentialDensity", "+", "regularizationDensity"}]}], "]"}], ",",
     "\[IndentingNewLine]", " ", "True", ",", "\[IndentingNewLine]", " ", 
    RowBox[{"TestID", "->", "\"\<LagrangianSplitMatchesDefinition\>\""}]}], 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Cases", "[", 
     RowBox[{"lagrangianDensity", ",", "_Log", ",", "Infinity"}], "]"}], "=!=", 
    RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", " ", "True", ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"TestID", "->", "\"\<LogTermPresent\>\""}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",ExpressionUUID->"786ef3fb-5ba8-7747-\
8739-a3a499019422"],

