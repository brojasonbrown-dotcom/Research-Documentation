       RowBox[{"rho0", "->", "0"}], ",", 
       RowBox[{"chi0", "->", "1"}], ",", 
       RowBox[{"res0", "->", "0"}]}], "}"}]}], " ", "//", " ", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Eigenvalues", "[", "hessianAtSpecial", "]"}]}], "Input",ExpressionUU\
ID->"2609c6a1-0ee3-1a41-a58a-a0c92384863a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tests for the original potential pathology", "Subsection",ExpressionUUID->"193b26a3-b7c4-3f4a-83d7-4dc0227f1a43"],

Cell[TextData[{
 "Set ",
 Cell[BoxData[Cell["delta -> 0",
   Background->None,ExpressionUUID->"4bb18388-011c-4e4d-bced-3336d34c814e"]], 
  "InlineCode",ExpressionUUID->"8af7f034-0845-af46-8315-038785587c17"],
