Cell[CellGroupData[{

Cell["7. Potential-only equilibrium and Hessian stability", "Section",ExpressionUUID->"0d5de1e7-6ddb-5f45-a043-ecf9e550b2f3"],

Cell["\<\
A constant-background equilibrium should be checked through the homogeneous \
potential. \
\>", "Text",ExpressionUUID->"90dd0433-b41b-244b-98fc-27fcaf14d4ea"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"potentialHomogeneous", "=", 
    RowBox[{"potentialDensity", " ", "/.", " ", 
     RowBox[{"{", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], "->", "rho0"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{
        RowBox[{"chi", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], "->", "chi0"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{
        RowBox[{"res", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], "->", "res0"}]}], 
      "\[IndentingNewLine]", "}"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hessian", "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"potentialHomogeneous", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", "2"}], 
       "}"}]}], "]"}], " ", "//", " ", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "hessian", "]"}]}], "Input",ExpressionUUID->\
"62362aaf-07ed-6845-bbb9-5c9dd59bf37d"],

Cell[CellGroupData[{

Cell["Stability criteria", "Subsection",ExpressionUUID->"02d3ce0d-8edf-b942-9e36-f8c8433f9aa3"],

Cell["\<\
A strict local minimum requires positive definiteness of the Hessian at a \
fixed point. \
\>", "Text",ExpressionUUID->"88b4b14f-5cb0-9549-97fb-c561d6a14ad3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hessianAtSpecial", "=", 
   RowBox[{
    RowBox[{"hessian", " ", "/.", " ", 
