       RowBox[{"delta", " ", "rho0", " ", "chi0"}]}], "==", "0"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",ExpressionUUID->"73f22ba6-\
b73a-314b-b02d-114f3c1c4a3e"]
}, Open  ]],

