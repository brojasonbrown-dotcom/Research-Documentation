Cell[CellGroupData[{

Cell["1. Design goals", "Section",ExpressionUUID->"3e6089b6-8067-d74b-aaa0-edc4cc3f39a3"],

Cell["We want a notebook that:", "Text",ExpressionUUID->"3e9c619c-0016-7a45-92d8-992c8e75e1c4"],

Cell[TextData[{
 "1. separates ",
 StyleBox["definition",
  FontWeight->Bold],
 ", ",
 StyleBox["derivation",
  FontWeight->Bold],
 ", ",
 StyleBox["computation",
  FontWeight->Bold],
 ", and ",
 StyleBox["interpretation",
  FontWeight->Bold],
 ";"
}], "Text",ExpressionUUID->"f2f13a95-c7b1-464c-96b8-4e6ee829f6bf"],

Cell["2. catches symbolic mistakes early;", "Text",ExpressionUUID->"a2ad176c-5a3f-1a46-8f1a-69381dcadb9e"],

Cell["3. verifies each claimed result with explicit tests;", "Text",ExpressionUUID->"f6529873-0bc2-f248-bf7a-82edf4b566b8"],

Cell["4. avoids silent failures and unsupported conclusions;", "Text",ExpressionUUID->"d795a8b8-2f03-414b-a83b-a9114380ade6"],

Cell["5. makes misunderstandings visible. ", "Text",ExpressionUUID->"f7b94b41-2a2e-d047-9c0b-71671f83b6f6"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"88fbe833-404a-c24d-9001-f8663ef30fe2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Structural problems in the original draft", "Section",ExpressionUUID->"1e7fc8dd-91a3-e04b-9fac-1f1a510eacaf"],

Cell[CellGroupData[{

Cell["2.1 Mixing formal claims and evidence", "Subsection",ExpressionUUID->"b59c644b-3363-4b45-a75d-5490d4b6d8dd"],

Cell["The original draft interleaves: ", "Text",ExpressionUUID->"af914c8b-b2f3-a04d-8448-b4555ebb2133"],

Cell["OPF axiomatic statements,", "Item",ExpressionUUID->"aeb6ab3d-2866-6743-bc7e-ccc10ac846f6"],

Cell["symbolic derivations,", "Item",ExpressionUUID->"e93c3fcf-c7d4-fb4f-a95b-76f74786f936"],

Cell["numerical claims,", "Item",ExpressionUUID->"d80fe50a-9001-db4f-80f1-daababcd1b70"],

Cell["philosophical interpretation,", "Item",ExpressionUUID->"cce86471-99e9-e149-9bd1-ce4790be6862"],

Cell["imported results from Python.", "Item",ExpressionUUID->"2b56d1d1-1f83-c144-a77c-a5a310990bf1"],

Cell["These should be split into separate sections. ", "Text",ExpressionUUID->"20a031c6-f885-2048-b584-85685044465a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2 Silent symbolic failure risk", "Subsection",ExpressionUUID->"393374bc-cc8f-b24f-934b-b959805eba6c"],

Cell["\<\
The displayed Euler\[Dash]Lagrange output omitted derivative terms, which \
indicates the derivation was not being checked rigorously enough. \
\>", "Text",ExpressionUUID->"ea8209f9-b768-7c47-9c24-67ef499e7f6a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.3 Incorrect assumption handling", "Subsection",ExpressionUUID->"81cedaed-12dd-2848-bc98-2ca43abacc05"],

Cell[TextData[{
 ButtonBox["$Assumptions",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/$Assumptions"],
 " was defined as a single logical expression, but later treated like a list \
using ",
 ButtonBox["Join",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Join"],
 ". That caused the ",
 Cell[BoxData[Cell["Join::heads",
   Background->None,ExpressionUUID->"92250b71-5fc9-1d4d-a836-6572d7a1f0e2"]], 
  "InlineCode",ExpressionUUID->"c9fc42fb-c54a-6e4f-866d-449483e94641"],
 " error. "
}], "Text",ExpressionUUID->"f91b57f7-490f-9949-b292-a57a9d34f7dc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.4 Incorrect option usage", "Subsection",ExpressionUUID->"210070ae-0d9f-0140-b5a7-51f09f6687f3"],

Cell[TextData[{
 ButtonBox["Reduce",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Reduce"],
 " does not take ",
 Cell[BoxData[
  RowBox[{"MaxExtraConditions", "->", "All"}]], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "928dfe2d-c010-b742-81dc-38ca445a5f9a"],
 ". That option belongs to ",
 ButtonBox["Solve",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Solve"],
 ", ",
 ButtonBox["Reduce",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Reduce"],
 " alternatives, or related functions in other contexts. "
}], "Text",ExpressionUUID->"933b1f25-0ace-ea40-bcdc-a3c66c5aa03a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.5 Interpretation drift", "Subsection",ExpressionUUID->"791db226-ae95-1e43-8ac8-d7f8bbfe6d37"],

Cell["\<\
Statements like \[OpenCurlyDoubleQuote]information arises as energy\
\[CloseCurlyDoubleQuote] are not yet mathematical theorems in the notebook. \
