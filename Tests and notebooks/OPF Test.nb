Notebook[{

Cell[CellGroupData[{
Cell["Rigorous OPF Testing Notebook", "Title",ExpressionUUID->"a690b00a-906d-da4b-8f62-a0d1556de85c"],

Cell[TextData[{
 "This notebook restructures the provided material into a ",
 StyleBox["verification-first",
  FontWeight->Bold],
 " Wolfram Language workflow. "
}], "Text",ExpressionUUID->"e442b28d-1bc7-e245-bd74-850518f59e91"],

Cell[CellGroupData[{

Cell["Important note", "Section",ExpressionUUID->"e673d27a-dd69-9649-bc8c-026f748fb153"],

Cell[TextData[{
 "This notebook treats the OPF constructions as ",
 StyleBox["formal hypotheses",
  FontWeight->Bold],
 " to be tested for: "
}], "Text",ExpressionUUID->"e7f20ecb-c992-6d4d-bfbf-5a87e9bfb572"],

Cell["symbolic correctness,", "Item",ExpressionUUID->"2a1e4752-362e-474a-89d2-896024dadaa7"],

Cell["internal consistency,", "Item",ExpressionUUID->"306b8d76-ec82-ca40-9aa2-d5144564c120"],

Cell["numerical stability,", "Item",ExpressionUUID->"b9622b88-aee7-4a44-b536-40056efb88b5"],

Cell["reproducibility,", "Item",ExpressionUUID->"bf377e2a-decd-024d-b7c1-13e982a81726"],

Cell["interpretation limits.", "Item",ExpressionUUID->"3ba10617-1cd7-cb4d-ab7e-caff376ed0be"],

Cell[TextData[{
 "It does ",
 StyleBox["not",
  FontWeight->Bold],
 " assume these hypotheses are established physics. "
}], "Text",ExpressionUUID->"83848f90-0292-f34f-a4af-454988f31a49"],

