 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"5f687a65-b2dd-f24c-87dc-7002b6f7ceac"]
}, Open  ]],

Cell[CellGroupData[{

Cell["14. What could be misunderstood", "Section",ExpressionUUID->"155ee77c-0702-5647-8f50-f51271a3dd84"],

Cell[CellGroupData[{

Cell["\<\
14.1 \[OpenCurlyDoubleQuote]Scale invariance\[CloseCurlyDoubleQuote] vs \
\[OpenCurlyDoubleQuote]self-similarity\[CloseCurlyDoubleQuote] vs \
\[OpenCurlyDoubleQuote]homogeneity\[CloseCurlyDoubleQuote]\
\>", "Subsection",ExpressionUUID->"4704ba91-a6ed-5242-8c93-8e2ec08b5193"],

Cell["These are distinct: ", "Text",ExpressionUUID->"c7dde531-cef0-a94b-a024-daf764c9f3d1"],

Cell[TextData[{
 StyleBox["scale invariance",
  FontWeight->Bold],
 ": unchanged under a scaling transformation,"
}], "Item",ExpressionUUID->"f0b9a808-f573-a244-a934-1a556ad5ee85"],

Cell[TextData[{
 StyleBox["homogeneity",
  FontWeight->Bold],
 ": transforms by an overall power,"
}], "Item",ExpressionUUID->"0aef1f07-33b5-3a40-b197-2d3ca3400188"],

Cell[TextData[{
 StyleBox["self-similarity",
  FontWeight->Bold],
 ": repeated structure across scales, often weaker."
}], "Item",ExpressionUUID->"d3be714e-1055-1c4f-8c1e-8eb20ec68b4c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["14.2 \[OpenCurlyDoubleQuote]Stable equilibrium\[CloseCurlyDoubleQuote] \
vs \[OpenCurlyDoubleQuote]bounded below\[CloseCurlyDoubleQuote]", "Subsection",\
ExpressionUUID->"c2fd0fa0-24f5-2e41-9705-79f6ef069671"],

Cell["\<\
A potential can be bounded below without having a strict isolated minimum. \
\>", "Text",ExpressionUUID->"df70686a-1ad0-3340-8423-aa507d6e68f2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["14.3 \[OpenCurlyDoubleQuote]Mode selection\[CloseCurlyDoubleQuote] vs \
\[OpenCurlyDoubleQuote]meaning\[CloseCurlyDoubleQuote]", "Subsection",Expressi\
onUUID->"7936fc11-54ca-2e4c-a6f2-aba2a074cc81"],

Cell["\<\
Recovering a preferred spectral mode does not automatically imply \
consciousness, selfhood, or ontological primacy. \
\>", "Text",ExpressionUUID->"c6bf8d63-4697-1a4e-a379-053498c67c2d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["14.4 \[OpenCurlyDoubleQuote]Information as energy\
\[CloseCurlyDoubleQuote]", "Subsection",ExpressionUUID->"c0a1f97a-d38d-b143-\
9832-010fea7d2667"],

Cell["\<\
This phrase is easy to overstate. In a rigorous notebook it should mean one \
of the following:\
\>", "Text",ExpressionUUID->"3af89e35-8170-e348-a0f9-2dd3266284ad"],

Cell["\<\
1. an explicit energetic functional depends on information-like fields;\
\>", "Text",ExpressionUUID->"0162209c-f567-9240-9a6a-2023e4305286"],

Cell["\<\
2. minimizing the action couples informational variables to energy-like terms;\
\>", "Text",ExpressionUUID->"3529c691-9807-504f-8061-106c47d9cc1b"],

Cell["3. a thermodynamic or variational dictionary is proposed.", "Text",ExpressionUUID->"1a6e72d9-de5b-c540-93a8-515018261574"],

Cell["Without one of those, it remains metaphorical. ", "Text",ExpressionUUID->"e88e1437-ae10-4142-acaf-be6eccbf6520"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"45c4f78b-1dcd-8746-9467-a292547237ab"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["15. Better notebook structure", "Section",ExpressionUUID->"394c9777-24ee-2a4e-8ffc-c987de3b3220"],

Cell["A better structure is:", "Text",ExpressionUUID->"60b32177-8d11-674e-9cfb-52b061b8994f"],

Cell[TextData[{
 "1. ",
 StyleBox["Definitions",
  FontWeight->Bold],
 "2. ",
 StyleBox["Assumptions",
  FontWeight->Bold],
 "3. ",
 StyleBox["Action / potential",
  FontWeight->Bold],
 "4. ",
 StyleBox["Euler\[Dash]Lagrange derivation",
  FontWeight->Bold],
 "5. ",
 StyleBox["Homogeneous fixed points",
  FontWeight->Bold],
 "6. ",
 StyleBox["Stability analysis",
  FontWeight->Bold],
 "7. ",
 StyleBox["Scale ansatz and consistency conditions",
  FontWeight->Bold],
 "8. ",
 StyleBox["Linearization and spectrum",
  FontWeight->Bold],
 "9. ",
 StyleBox["Numerical experiments",
  FontWeight->Bold],
 "10. ",
 StyleBox["Imported external evidence",
  FontWeight->Bold],
 "11. ",
 StyleBox["Interpretation limits",
  FontWeight->Bold],
 "12. ",
 StyleBox["Open conjectures",
  FontWeight->Bold],
 "This prevents philosophical conclusions from being mistaken for derived \
results. "
}], "Text",ExpressionUUID->"755b6014-0f74-4b44-b270-f89eec3ad19b"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"c7fcb58e-0236-1741-bb98-28e894f849e7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["16. Test report cell", "Section",ExpressionUUID->"d807c462-f452-0340-97a2-8a4b58935cf6"],

Cell[BoxData[
 RowBox[{"TestReport", "[", 
  RowBox[{"{", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"VerificationTest", "[", 
     RowBox[{
      RowBox[{"Head", "[", "$Assumptions", "]"}], ",", "And", ",", 
      RowBox[{
      "TestID", "->", "\"\<AssumptionsStoredAsLogicalExpression\>\""}]}], 
     "]"}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"VerificationTest", "[", 
     RowBox[{
      RowBox[{"FreeQ", "[", 
       RowBox[{"assumptionList", ",", "_Join"}], "]"}], ",", "True", ",", 
      RowBox[{"TestID", "->", "\"\<AssumptionListIsComposable\>\""}]}], "]"}],
     ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"VerificationTest", "[", 
     RowBox[{
      RowBox[{"Simplify", "[", 
       RowBox[{"lagrangianDensity", "===", 
        RowBox[{"potentialDensity", "+", "regularizationDensity"}]}], "]"}], ",",
       "True", ",", 
      RowBox[{"TestID", "->", "\"\<LagrangianSplitMatchesDefinition\>\""}]}], 
     "]"}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"VerificationTest", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Cases", "[", 
        RowBox[{"lagrangianDensity", ",", "_Log", ",", "Infinity"}], "]"}], "=!=", 
       RowBox[{"{", "}"}]}], ",", "True", ",", 
      RowBox[{"TestID", "->", "\"\<LogTermPresent\>\""}]}], "]"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"VerificationTest", "[", 
     RowBox[{
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"eulerRho", "==", "expectedEulerRho"}], ",", 
        RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}], ",", "True", ",", 
      RowBox[{"TestID", "->", "\"\<EulerRhoCorrect\>\""}]}], "]"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"VerificationTest", "[", 
     RowBox[{
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"eulerChi", "==", "expectedEulerChi"}], ",", 
        RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}], ",", "True", ",", 
      RowBox[{"TestID", "->", "\"\<EulerChiCorrect\>\""}]}], "]"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"VerificationTest", "[", 
     RowBox[{
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"eulerRes", "==", "expectedEulerRes"}], ",", 
        RowBox[{"Assumptions", "->", "$Assumptions"}]}], "]"}], ",", "True", ",", 
      RowBox[{"TestID", "->", "\"\<EulerResCorrect\>\""}]}], "]"}], ",", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"VerificationTest", "[", 
     RowBox[{
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{
        "homogeneousEquations", "==", "expectedHomogeneousEquations"}], ",", 
        RowBox[{"Assumptions", "->", 
         RowBox[{"chi0", ">", "0"}]}]}], "]"}], ",", "True", ",", 
      RowBox[{"TestID", "->", "\"\<HomogeneousReductionCorrect\>\""}]}], 
     "]"}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"VerificationTest", "[", 
     RowBox[{
      RowBox[{"PositiveDefiniteMatrixQ", "[", "originalHessianAtPoint", "]"}],
       ",", "False", ",", 
      RowBox[{
      "TestID", "->", "\"\<OriginalPotentialNotStrictlyStable\>\""}]}], "]"}],
     ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"VerificationTest", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ratioError", "[", 
        RowBox[{"1.61581", ",", "goldenRatio"}], "]"}], "<", "0.002"}], ",", 
      "True", ",", 
      RowBox[{"TestID", "->", "\"\<GoldenRatioExampleErrorBound\>\""}]}], 
     "]"}]}], "\[IndentingNewLine]", "}"}], "]"}]], "Input",ExpressionUUID->\
"3f14ec66-d6fc-7d4c-95f0-ed3f607a559c"],

