  "InlineCode",ExpressionUUID->"a41b3b9c-3d74-ac45-a3a9-1bd427d5b919"],
 ". "
}], "Text",ExpressionUUID->"95f27448-68c0-664b-8ee2-00b5b22160e2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"originalPotential", "=", 
   RowBox[{
    RowBox[{"rho0", " ", 
     RowBox[{"Log", "[", "chi0", "]"}]}], "+", 
    RowBox[{"chi0", " ", 
     RowBox[{"res0", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"originalHessian", "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"originalPotential", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", "2"}], 
       "}"}]}], "]"}], " ", "//", " ", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"originalHessianAtPoint", "=", 
    RowBox[{"originalHessian", " ", "/.", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rho0", "->", "0"}], ",", 
       RowBox[{"chi0", "->", "1"}], ",", 
       RowBox[{"res0", "->", "0"}]}], "}"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"PositiveDefiniteMatrixQ", "[", "originalHessianAtPoint", "]"}], ",",
    "\[IndentingNewLine]", " ", "False", ",", "\[IndentingNewLine]", " ", 
   RowBox[{"TestID", "->", "\"\<OriginalPotentialNotStrictlyStable\>\""}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",ExpressionUUID->"7d9de7ca-6f65-0446-\
beba-6eed7d750ea1"],

Cell["\<\
This directly supports the claim that the original potential is not a \
satisfactory stable foundation. \
\>", "Text",ExpressionUUID->"e7cd6440-a8ef-974c-b3da-68f83f77400b"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
