Cell[CellGroupData[{

Cell["3. Clean setup", "Section",ExpressionUUID->"e011762c-7c30-7944-ba6b-8f232c0acc66"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Needs", "[", "\"\<VariationalMethods`\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"assumptionList", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"alpha", ">", "0"}], ",", 
      RowBox[{"beta", ">", "0"}], ",", 
      RowBox[{"gamma", ">", "0"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"eta", ">", "0"}], ",", 
      RowBox[{"zeta", ">", "0"}], ",", 
      RowBox[{"xi", ">", "0"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"delta", " ", "\[Element]", " ", "Reals"}], ",", 
      RowBox[{"lambda", " ", "\[Element]", " ", "Reals"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"x", " ", "\[Element]", " ", "Reals"}], ",", 
      RowBox[{"sigma", " ", "\[Element]", " ", "Reals"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"rho0", " ", "\[Element]", " ", "Reals"}], ",", 
      RowBox[{"chi0", ">", "0"}], ",", 
      RowBox[{"res0", " ", "\[Element]", " ", "Reals"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"a", " ", "\[Element]", " ", "Reals"}], ",", 
      RowBox[{"b", " ", "\[Element]", " ", "Reals"}], ",", 
      RowBox[{"c", " ", "\[Element]", " ", "Reals"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"phi", ">", "1"}]}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"And", " ", "@@", " ", "assumptionList"}]}], ";"}]}], "Input",Expre\
ssionUUID->"a42f6c29-6db9-d547-97d2-caffe99b20f2"],

Cell[CellGroupData[{

Cell["Setup tests", "Subsection",ExpressionUUID->"123ebcb3-fa22-564f-966b-a1cfd3811f2e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"Head", "[", "$Assumptions", "]"}], ",", "\[IndentingNewLine]", 
    " ", "And", ",", "\[IndentingNewLine]", " ", 
    RowBox[{
    "TestID", "->", "\"\<AssumptionsStoredAsLogicalExpression\>\""}]}], 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"FreeQ", "[", 
    RowBox[{"assumptionList", ",", "_Join"}], "]"}], ",", 
   "\[IndentingNewLine]", " ", "True", ",", "\[IndentingNewLine]", " ", 
   RowBox[{"TestID", "->", "\"\<AssumptionListIsComposable\>\""}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",ExpressionUUID->"8497a0d6-fc77-9748-\
94e8-b34b5c1dd090"],

