Cell[CellGroupData[{

Cell["12. Visual modal diagnostics", "Section",ExpressionUUID->"752d53f4-7cff-774b-a416-eb78728b3b12"],

Cell["\<\
For a numeric parameter choice, visualize the determinant over wave-number \
space. \
\>", "Text",ExpressionUUID->"a256e2ee-681f-b740-8330-c873c39cb4fb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"numericPars", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"alpha", "->", "1"}], ",", 
      RowBox[{"beta", "->", "1"}], ",", 
      RowBox[{"gamma", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"eta", "->", "1"}], ",", 
      RowBox[{"zeta", "->", "1"}], ",", 
      RowBox[{"xi", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"delta", "->", "1"}], ",", 
      RowBox[{"lambda", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"rho0", "->", "1"}], ",", 
      RowBox[{"chi0", "->", "1"}], ",", 
      RowBox[{"res0", "->", "0"}]}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot3D", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Re", "[", 
     RowBox[{"Det", "[", 
      RowBox[{"modeMatrix", " ", "/.", " ", "numericPars"}], "]"}], "]"}], 
    "]"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"{", 
    RowBox[{"kx", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"ks", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"Mesh", "->", "None"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<kx\>\"", ",", "\"\<ks\>\"", ",", "\"\<det\>\""}], "}"}]}], ",",
    "\[IndentingNewLine]", " ", 
   RowBox[{
   "PlotLabel", 
    "->", "\"\<Mode determinant over spatial and scale wave numbers\>\""}]}], 
