  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"3cefd50c-b94c-0a4b-a194-519698bf2042"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Clean initialization and rigor fixes", "Section",ExpressionUUID->"85a96a1b-a35d-f047-99b6-14551364f623"],

Cell[CellGroupData[{

Cell["Purpose", "Subsection",ExpressionUUID->"fd4690bf-7983-164e-9a68-70559d86f455"],

Cell["\<\
The original notebook had at least three rigor problems immediately: \
\>", "Text",ExpressionUUID->"c0ff14c8-aad4-5e4e-b0ed-e97f0330eb57"],

Cell[TextData[{
 "a context/shadowing issue with ",
 Cell[BoxData[Cell["VariationalD",
   Background->None,ExpressionUUID->"d307f731-1eae-bf49-acd2-ba4cda78e263"]], 
  "InlineCode",ExpressionUUID->"dfbf468b-039c-204f-b92b-8c2eef8303b1"]
}], "Item",ExpressionUUID->"340b3eb6-5c55-3943-ba8f-04b95f96edc1"],

Cell[TextData[{
 "misuse of ",
 ButtonBox["Reduce",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Reduce"],
 " option ",
 ButtonBox["MaxExtraConditions",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MaxExtraConditions"]
}], "Item",ExpressionUUID->"c5da1bca-5356-4c4c-8644-30f71cf74d2b"],

Cell[TextData[{
 "invalid use of ",
 ButtonBox["Join",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Join"],
 " on logical assumptions"
}], "Item",ExpressionUUID->"61a9cf66-d2ab-e34f-8636-afae713343b8"],

Cell["This section repairs those before doing any science. ", "Text",ExpressionUUID->"bf6e9f74-ac68-5a45-96ee-ac196a5355a7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Remove", "[", "\"\<Global`VariationalD\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Needs", "[", "\"\<VariationalMethods`\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", 
    RowBox[{"And", " ", "@@", " ", 
     RowBox[{"{", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"alpha", ">", "0"}], ",", 
       RowBox[{"beta", ">", "0"}], ",", 
       RowBox[{"gamma", ">", "0"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"eta", ">", "0"}], ",", 
       RowBox[{"zeta", ">", "0"}], ",", 
       RowBox[{"xi", ">", "0"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"delta", " ", "\[Element]", " ", "Reals"}], ",", 
       RowBox[{"lambda", " ", "\[Element]", " ", "Reals"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"x", " ", "\[Element]", " ", "Reals"}], ",", 
       RowBox[{"sigma", " ", "\[Element]", " ", "Reals"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"phi", ">", "1"}]}], "\[IndentingNewLine]", "}"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"assumptionList", "=", 
   RowBox[{"{", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"alpha", ">", "0"}], ",", 
     RowBox[{"beta", ">", "0"}], ",", 
     RowBox[{"gamma", ">", "0"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"eta", ">", "0"}], ",", 
     RowBox[{"zeta", ">", "0"}], ",", 
     RowBox[{"xi", ">", "0"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"delta", " ", "\[Element]", " ", "Reals"}], ",", 
     RowBox[{"lambda", " ", "\[Element]", " ", "Reals"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"x", " ", "\[Element]", " ", "Reals"}], ",", 
     RowBox[{"sigma", " ", "\[Element]", " ", "Reals"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"phi", ">", "1"}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]}], "Input",ExpressionUUID->"f0b7e419-02a0-9746-9645-cb87183e8cca"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Sanity checks", "Subsection",ExpressionUUID->"9bc2285b-6f97-294b-89a2-8907ca431b4c"],

