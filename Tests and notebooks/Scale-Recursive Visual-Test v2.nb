 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"121863b2-886d-cf43-97cc-b76d535a9019"],

Cell[CellGroupData[{

Cell["0. Executive testing principles", "Section",ExpressionUUID->"84aba47e-6340-4c46-9930-31ef7b035c2b"],

Cell["\<\
We distinguish five layers that were partially conflated in the original \
draft:\
\>", "Text",ExpressionUUID->"2ba4d553-5b32-cd41-b9b8-bcaae09231e1"],

Cell[TextData[{
 "1. ",
 StyleBox["Symbolic formalization",
  FontWeight->Bold],
 " \[LongDash] what equations are actually defined."
}], "Text",ExpressionUUID->"d0a9ccfe-3a0c-f647-b673-7042f4ea5942"],

Cell[TextData[{
 "2. ",
 StyleBox["Mathematical well-posedness",
  FontWeight->Bold],
 " \[LongDash] boundedness, fixed points, coercivity, variational consistency."
}], "Text",ExpressionUUID->"51697b04-90be-8742-9a8d-7084d6601962"],

Cell[TextData[{
 "3. ",
 StyleBox["Dynamical behavior",
  FontWeight->Bold],
 " \[LongDash] stability, linear modes, resonances, bifurcations."
}], "Text",ExpressionUUID->"75ea1dc9-7aa1-9942-8db5-925cc3971296"],

Cell[TextData[{
 "4. ",
 StyleBox["Measurement construction",
  FontWeight->Bold],
 " \[LongDash] how observables are extracted from symbolic states."
}], "Text",ExpressionUUID->"30941ef9-b824-0a4a-9765-151a3a47fadb"],

Cell[TextData[{
 "5. ",
 StyleBox["Interpretation",
  FontWeight->Bold],
 " \[LongDash] whether phrases like \"self-measurement\", \"information\", or \
\"energy\" are literal, derived, or metaphorical."
}], "Text",ExpressionUUID->"56bb6166-606a-884d-86c2-3beea03209d4"],

Cell["This notebook tests each separately. ", "Text",ExpressionUUID->"3354239e-fc5f-1248-8bbd-ba20617f4369"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
