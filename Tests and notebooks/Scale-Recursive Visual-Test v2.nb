Cell[CellGroupData[{

Cell["17. Do we know what these things actually are?", "Section",ExpressionUUID->"4e2d7a79-af35-b944-bc4a-06433fc5ee1e"],

Cell["At present, mathematically: ", "Text",ExpressionUUID->"4a962559-ac30-ea48-8810-a308048d3e59"],

Cell[TextData[{
 StyleBox["rho", "TI"],
 " is a scalar field in an ansatz"
}], "Item",ExpressionUUID->"f0b25e68-2674-b74f-aa7b-d61af5f9450a"],

Cell[TextData[{
 StyleBox["chi", "TI"],
 " is a scalar field in an ansatz"
}], "Item",ExpressionUUID->"83a84f4b-c194-2646-bcfb-21a55689bc4d"],

Cell[TextData[{
 StyleBox["res", "TI"],
 " is a scalar field in an ansatz"
}], "Item",ExpressionUUID->"88b0d8fd-b4ec-6943-8a3a-fbcdd9c89608"],

Cell[TextData[{
 "We do ",
 StyleBox["not",
  FontWeight->Bold],
 " yet know, from the notebook alone, whether they correspond to: "
}], "Text",ExpressionUUID->"8b7c1c30-3c49-964f-9ddb-f727baa2bd71"],

Cell["thermodynamic entropy density", "Item",ExpressionUUID->"02646201-f0c1-4a48-a908-62699e022b00"],

Cell["algorithmic complexity density", "Item",ExpressionUUID->"59f33c79-d2e6-c341-bb60-8f0b12c2db4b"],

Cell["coarse-graining scale", "Item",ExpressionUUID->"7df3b7ab-b4ba-5649-9edd-7d2a6dcbd8ef"],

Cell["instrumental resolution", "Item",ExpressionUUID->"39d96f4b-db7a-6344-8c89-ce965b92d751"],

Cell["renormalization-group scale field", "Item",ExpressionUUID->"9df97f24-1c5c-284f-ab2c-91da77ac4d91"],

Cell["effective free-energy variables", "Item",ExpressionUUID->"3b27faab-db6a-af47-8b00-e61a990a764c"],

Cell["\<\
A rigorous next step is to define admissible dimensions/units and \
transformation laws. \
\>", "Text",ExpressionUUID->"ea34e474-7303-5c40-a6ff-4287e51415fb"],

Cell[CellGroupData[{

Cell["Unit-consistency scaffold", "Subsection",ExpressionUUID->"12c6a374-7cc5-8f4d-ad4a-737f0551958d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"unitLedger", "=", 
    RowBox[{"Dataset", "[", 
     RowBox[{"{", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Quantity\>\"", "->", "\"\<rho\>\""}], ",", 
         RowBox[{"\"\<InterpretationCandidates\>\"", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<information density\>\"", 
            ",", "\"\<entropy density\>\"", ",", "\"\<effective scalar\>\""}],
            "}"}]}], ",", 
         RowBox[{"\"\<UnitsAssigned\>\"", "->", 
          RowBox[{"Missing", "[", "\"\<NotAssigned\>\"", "]"}]}]}], "|>"}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Quantity\>\"", "->", "\"\<chi\>\""}], ",", 
         RowBox[{"\"\<InterpretationCandidates\>\"", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<complexity field\>\"", 
            ",", "\"\<susceptibility-like variable\>\"", 
            ",", "\"\<latent field\>\""}], "}"}]}], ",", 
         RowBox[{"\"\<UnitsAssigned\>\"", "->", 
          RowBox[{"Missing", "[", "\"\<NotAssigned\>\"", "]"}]}]}], "|>"}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Quantity\>\"", "->", "\"\<res\>\""}], ",", 
         RowBox[{"\"\<InterpretationCandidates\>\"", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<resolution\>\"", 
            ",", "\"\<inverse coarse-graining length\>\"", 
            ",", "\"\<measurement scale\>\""}], "}"}]}], ",", 
         RowBox[{"\"\<UnitsAssigned\>\"", "->", 
          RowBox[{"Missing", "[", "\"\<NotAssigned\>\"", "]"}]}]}], "|>"}]}], 
      "\[IndentingNewLine]", "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "unitLedger"}], "Input",Expr\
essionUUID->"723acdcb-2cad-e24e-bdcf-98c04194d7ab"],

