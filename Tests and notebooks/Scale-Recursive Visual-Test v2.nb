Cell[CellGroupData[{

Cell[TextData[{
 "2. Explicit ontology map: what the symbols ",
 StyleBox["are",
  FontSlant->Italic]
}], "Section",ExpressionUUID->"089256c3-1ae5-7c4f-a163-b785a9af5922"],

Cell["Before testing equations, define the status of each object. ", "Text",ExpressionUUID->"77d462eb-fef6-a641-b98a-63e46081df00"],

Cell[BoxData[
 PaneBox[
  PaneBox[
   StyleBox[
    TagBox[
     TagBox[GridBox[{
        {
         TagBox["\<\"Symbol\"\>",
          HoldForm], 
         TagBox["\<\"Intended meaning\"\>",
          HoldForm], 
         TagBox["\<\"Mathematical type\"\>",
          HoldForm], 
         TagBox["\<\"Empirical status\"\>",
          HoldForm]},
        {Cell[BoxData[Cell["rho[x,sigma]",
           Background->None,ExpressionUUID->
           "980f1cb5-b855-fc42-8342-0c1244eeeee9"]], "InlineCode",
          ExpressionUUID->
          "36da56aa-642a-7041-b2c6-5380946996b3"], "\<\"information density\"\
\>", "\<\"scalar field\"\>", "\<\"hypothetical\"\>"},
        {Cell[BoxData[Cell["chi[x,sigma]",
           Background->None,ExpressionUUID->
           "85387bf4-b5e8-2f43-9250-652b83f760cf"]], "InlineCode",
          ExpressionUUID->
          "69006054-3e79-c545-8160-0030b8cbdda7"], "\<\"field \
complexity\"\>", "\<\"scalar field\"\>", "\<\"hypothetical\"\>"},
        {Cell[BoxData[Cell["res[x,sigma]",
           Background->None,ExpressionUUID->
           "fdfc6a80-0318-c749-aed1-f45ce28064b0"]], "InlineCode",
          ExpressionUUID->
          "a4ab3af9-19e1-9e41-bfa8-386192c5a610"], "\<\"observational \
resolution\"\>", "\<\"scalar field\"\>", "\<\"hypothetical\"\>"},
        {
         StyleBox["sigma", 
          "TI"], "\<\"logarithmic scale coordinate\"\>", "\<\"continuous \
variable\"\>", "\<\"formal modeling choice\"\>"},
        {
         StyleBox["x", 
          "TI"], "\<\"spatial coordinate\"\>", "\<\"continuous variable\"\>", \
"\<\"standard\"\>"},
        {Cell[BoxData[Cell["lagrangianDensity",
           Background->None,ExpressionUUID->
           "4ebf81c3-6fcc-fb42-9366-41059f5e2b87"]], "InlineCode",
          ExpressionUUID->
          "c1bdf180-011b-8942-a06b-d86c7b4859fc"], "\<\"OPF test Lagrangian\"\
\>", "\<\"scalar density\"\>", "\<\"constructed ansatz\"\>"}
       },
       GridBoxAlignment->{
        "Columns" -> {Left, Left, Right, {Left}}, "Rows" -> {{Baseline}}},
       GridBoxDividers->{
        "Columns" -> {{False}}, "Rows" -> {False, True, {False}, False}},
       GridBoxSpacings->{"Columns" -> {
           Offset[0.27999999999999997`], {
            Offset[2.0999999999999996`]}, 
           Offset[0.27999999999999997`]}, "Rows" -> {
           Offset[0.2], {
            Offset[0.4]}, 
           Offset[0.2]}}],
      {None, OutputFormsDump`HeadedColumns}],
     Function[BoxForm`e$, 
      TableForm[
      BoxForm`e$, 
       TableHeadings -> {
        None, {"Symbol", "Intended meaning", "Mathematical type", 
          "Empirical status"}}]]], "Text",
    StripOnInput->False,
    ShowStringCharacters->False],
   ImageMargins->{{0, 0}, {5, 5}}],
  ImageMargins->{{0, 0}, {5, 5}}]], "TextTableForm", \
"Text",ExpressionUUID->"160570f9-c764-4c4c-80bd-fa6c0df6edd7"],

Cell[CellGroupData[{

Cell["Important interpretive note", "Subsection",ExpressionUUID->"25e93503-720b-b245-bfc6-68074ac5f6fc"],

Cell["Nothing in the equations alone proves that: ", "Text",ExpressionUUID->"1afc7aee-8136-f642-a3fd-0f0d4e348003"],

Cell["information is energy", "Item",ExpressionUUID->"9bc653c6-4395-1b4a-b534-7dfef222fd4e"],

Cell["consciousness is a field", "Item",ExpressionUUID->"c3f11630-4461-2d4c-9a93-9bd7fc22373f"],

Cell["self-measurement is physical measurement", "Item",ExpressionUUID->"54ab97f8-c245-0849-a364-c882c81fcd0a"],

Cell["scale recursion implies ontology", "Item",ExpressionUUID->"89120c3c-0756-d047-914d-94b308eefc3b"],

Cell["\<\
Those require additional bridges, not just symbolic consistency. \
\>", "Text",ExpressionUUID->"30e07beb-7ced-074d-8fa7-cc01f4f7cf5c"],

