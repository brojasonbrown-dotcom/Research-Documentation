Cell[CellGroupData[{

Cell["15. Claim-evidence ledger for your reported probes", "Section",ExpressionUUID->"d8074a04-00da-c34c-bc55-7d16e7b2dff5"],

Cell["\<\
This section converts your claims into auditable test targets. \
\>", "Text",ExpressionUUID->"13222447-15bd-a047-a905-4af622199326"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"claimLedger", "=", 
    RowBox[{"Dataset", "[", 
     RowBox[{"{", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Probe\>\"", "->", "\"\<Equation Foundry\>\""}], ",", 
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<2046 equations generated and scored\>\""}], ",", 
         RowBox[{"\"\<NeededEvidence\>\"", 
          "->", "\"\<source generator, scoring function, reproducible \
parameter grid, raw results table\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", 
          "->", "\"\<unverified in current notebook\>\""}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Probe\>\"", "->", "\"\<Equation Foundry\>\""}], ",", 
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<KL potential rediscovered as winner\>\""}], ",", 
         RowBox[{"\"\<NeededEvidence\>\"", 
          "->", "\"\<explicit search space and ranking table\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", 
          "->", "\"\<plausible but not yet reproduced here\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Probe\>\"", "->", "\"\<Equation Foundry\>\""}], ",", 
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<original potential scored zero\>\""}], ",", 
         RowBox[{"\"\<NeededEvidence\>\"", 
          "->", "\"\<boundedness, equilibrium, homogeneity tests applied \
automatically\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", 
          "->", "\"\<partially consistent with current symbolic \
analysis\>\""}]}], "|>"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Probe\>\"", "->", "\"\<Torus-Koopman\>\""}], ",", 
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<DMD recovered golden-ratio-related frequencies\>\""}], ",", 
         RowBox[{"\"\<NeededEvidence\>\"", 
          "->", "\"\<time series generator, DMD code, residual analysis, null \
comparison\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", 
          "->", "\"\<not yet reproduced here\>\""}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Probe\>\"", 
          "->", "\"\<Hyperdimensional Self-Measurement\>\""}], ",", 
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<encoded fixed point remains a fixed point\>\""}], ",", 
         RowBox[{"\"\<NeededEvidence\>\"", 
          "->", "\"\<encoding map, operator, similarity metric, \
reproducibility test\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", 
          "->", "\"\<not yet reproduced here\>\""}]}], "|>"}]}], 
      "\[IndentingNewLine]", "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "claimLedger"}], "Input",Exp\
ressionUUID->"48ca3bc1-17a0-134a-b0bd-4f863b05f87b"],

