Cell[CellGroupData[{

Cell["13. Measurement kernel construction", "Section",ExpressionUUID->"b702d165-2d5c-8046-b51b-21ea22a43637"],

Cell["\<\
The original notebook mentions a self-measurement kernel, but this concept \
needs operational definition.\
\>", "Text",ExpressionUUID->"0f9cb937-3990-e440-a816-1c8da31484aa"],

Cell["A minimal testable version is: ", "CodeText",ExpressionUUID->"ea31eff9-6764-a143-a4e7-36d8fb5a4f9b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"measurementKernel", "[", 
    RowBox[{"state_", ",", "kernel_"}], "]"}], ":=", 
   RowBox[{"kernel", "[", "state", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"selfMeasurementEquation", "[", 
    RowBox[{"state_", ",", "kernel_"}], "]"}], ":=", 
   RowBox[{"state", "==", 
    RowBox[{"measurementKernel", "[", 
     RowBox[{"state", ",", "kernel"}], "]"}]}]}], ";"}]}], "Input",ExpressionU\
UID->"46e888b7-b412-584f-bd74-e6bee854194f"],

Cell[CellGroupData[{

Cell["Example: Gaussian smoothing as a self-map", "Subsection",ExpressionUUID->"96f06973-2bc6-a947-a7bc-8146979536fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaussianKernel", "[", "f_", "]"}], ":=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", "x", "}"}], ",", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "y"}], ")"}], "^", "2"}]}], "]"}], " ", 
        RowBox[{"f", "[", "y", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<GlobalAdaptive\>\"", ",", 
          RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}]}], 
      "]"}]}], "]"}]}], ";"}]], "Input",ExpressionUUID->"c6d1081e-7a66-7a47-\
b266-6c4d87b9b6d2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Conceptual critique", "Subsection",ExpressionUUID->"156b9fc3-a55e-a446-baed-3bf50fed0127"],

Cell["A physical measurement map should specify: ", "Text",ExpressionUUID->"b5a722b7-24c8-6b4d-9ac3-e36fd51bae16"],

Cell["domain", "Item",ExpressionUUID->"e19f68b3-8e0d-af45-8fc4-6404f1832cdf"],

Cell["codomain", "Item",ExpressionUUID->"39754b1c-ace6-ed43-9ef9-d9ac89407a33"],

Cell["conserved quantities", "Item",ExpressionUUID->"1f341c68-2979-3d46-a9e4-47b410c2ad42"],

Cell["\<\
whether it is linear, positive, contractive, or completely positive\
\>", "Item",ExpressionUUID->"12bd2edc-6f29-5846-81fc-c440937ddf30"],

Cell["whether fixed points are unique", "Item",ExpressionUUID->"492dfcba-c713-7847-8a53-80279b5a1e97"],

Cell["\<\
Without this, \"self-measurement\" risks being only a metaphor. \
\>", "Text",ExpressionUUID->"7102c7aa-23bf-e34d-a3b1-307efc579691"],

