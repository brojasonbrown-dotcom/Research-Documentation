Cell[CellGroupData[{

Cell["14. Ratio scans including golden-ratio candidates", "Section",ExpressionUUID->"46028e68-97e1-214d-ae37-2ba3d8ba5f1d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"goldenRatio", "=", 
   RowBox[{"N", "[", 
    RowBox[{"GoldenRatio", ",", "50"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"goldenAngle", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"2", " ", "Pi", " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"1", "/", "GoldenRatio"}]}], ")"}]}], ",", "50"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"<|", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"\"\<GoldenRatio\>\"", "->", "goldenRatio"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"\"\<GoldenAngle\>\"", "->", "goldenAngle"}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"\"\<GoldenAngleDegrees\>\"", "->", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"goldenAngle", " ", 
       RowBox[{"180", "/", "Pi"}]}], ",", "30"}], "]"}]}]}], 
  "\[IndentingNewLine]", "|>"}]}], "Input",ExpressionUUID->"c387c4d2-6b73-\
a34c-b26e-9347c8891ca6"],

Cell[CellGroupData[{

Cell["Rational approximation diagnostics", "Subsection",ExpressionUUID->"886711b6-247f-d44a-a1a7-18465f5835e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", "\[IndentingNewLine]", " ", 
   RowBox[{
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<n\>\"", "->", "n"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<ContinuedFractionTerm\>\"", "->", 
       RowBox[{"ContinuedFraction", "[", 
        RowBox[{"GoldenRatio", ",", "n"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<Convergent\>\"", "->", 
       RowBox[{"FromContinuedFraction", "[", 
        RowBox[{"ContinuedFraction", "[", 
         RowBox[{"GoldenRatio", ",", "n"}], "]"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<Error\>\"", "->", 
       RowBox[{"Abs", "[", 
        RowBox[{"GoldenRatio", "-", 
         RowBox[{"FromContinuedFraction", "[", 
          RowBox[{"ContinuedFraction", "[", 
           RowBox[{"GoldenRatio", ",", "n"}], "]"}], "]"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", " ", "|>"}], ",", "\[IndentingNewLine]", " ", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", "8"}], "}"}]}], "\[IndentingNewLine]", "]"}],
   " ", "//", " ", "Dataset"}]], "Input",ExpressionUUID->"e228b205-a8f1-2f4b-\
9905-dc3ff7a24db0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Important warning", "Subsection",ExpressionUUID->"b483439c-7ea7-124d-90f7-223c35fb33d9"],

Cell["\<\
Finding a good fit to the golden ratio in a spectrum is not by itself \
evidence of ontology. It may reflect: \
\>", "Text",ExpressionUUID->"8d774c95-cefc-194a-931e-abbcbd2e7f79"],

Cell["quasiperiodicity", "Item",ExpressionUUID->"96257b18-3d36-bc48-9d8c-a95d5ddb2b2d"],

Cell["extremal packing", "Item",ExpressionUUID->"cf8bcd4e-f3e8-e54b-b490-ede2b28d06a0"],

Cell["Diophantine robustness", "Item",ExpressionUUID->"5266526d-35c3-ec46-a41d-4c2b3ee65c52"],

Cell["model tuning", "Item",ExpressionUUID->"e01407ae-176d-d44e-8eaa-5dbb0c03fec3"],

Cell["numerology if no null model is used", "Item",ExpressionUUID->"aa7d4dd0-9bf7-184b-ac9c-e443e99b4c67"],

Cell["\<\
A rigorous notebook must compare against null distributions. \
\>", "Text",ExpressionUUID->"7ecb10a6-ebfc-2d4e-9763-2946fa176ffa"],

