Cell[CellGroupData[{

Cell["22. Closing note", "Section",ExpressionUUID->"5fa082d0-9334-e24a-a1f7-62af27e7c6b4"],

Cell[TextData[{
 "The strongest thing currently available is ",
 StyleBox["formal exploration of candidate variational structures",
  FontWeight->Bold],
 ", not yet a demonstrated physical theory."
}], "Text",ExpressionUUID->"327d0feb-4875-8446-bb6b-039af41a5550"],

Cell["That is still valuable.", "Text",ExpressionUUID->"9538e09d-5d88-4244-8183-0339aed8689b"],

Cell["\<\
A rigorous notebook should make that strength clear without over-claiming \
what has not yet been shown.\
\>", "Text",ExpressionUUID->"4c0aaa7b-be7d-b34e-881e-76b2f8f5f2a5"]
}, Open  ]]
