Cell[CellGroupData[{

Cell["3. Define the candidate Lagrangian density", "Section",ExpressionUUID->"ae189da8-c701-2348-9298-b871cad0af7d"],

Cell["\<\
This reproduces the intended extended Layer 1 model in a testable way. \
\>", "Text",ExpressionUUID->"cd4679b9-8415-a24a-b1c2-496585406c98"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lagrangianDensity", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"chi", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], "]"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"chi", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{
      RowBox[{"res", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"alpha", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
      "2"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"beta", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"chi", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
      "2"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"gamma", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"res", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
      "2"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"eta", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", "2"}]}], 
    "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"zeta", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"chi", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", "2"}]}], 
    "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"xi", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"res", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", "2"}]}], 
    "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"delta", " ", 
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{"chi", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{"res", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"lambda", " ", 
     RowBox[{
      RowBox[{"rho", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}]}]}]}], ";"}]], "Input",E\
xpressionUUID->"3f4e86bf-07d8-2544-931d-5aab51bfaf51"],

Cell[CellGroupData[{

Cell["Visual decomposition of the Lagrangian", "Subsection",ExpressionUUID->"a59bc7be-cab9-9e42-af3f-ec57e3e2b0d8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"terms", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<EntropyLike\>\"", "->", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], " ", 
        RowBox[{"Log", "[", 
         RowBox[{"chi", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ResolutionCoupling\>\"", "->", 
       RowBox[{
        RowBox[{"chi", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], " ", 
        RowBox[{
         RowBox[{"res", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ScaleRegularizationRho\>\"", "->", 
       RowBox[{"alpha", " ", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"rho", "[", 
            RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
         "2"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ScaleRegularizationChi\>\"", "->", 
       RowBox[{"beta", " ", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"chi", "[", 
            RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
         "2"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ScaleRegularizationRes\>\"", "->", 
       RowBox[{"gamma", " ", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"res", "[", 
            RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
         "2"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<SpatialRegularizationRho\>\"", "->", 
       RowBox[{"eta", " ", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"rho", "[", 
            RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", 
         "2"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<SpatialRegularizationChi\>\"", "->", 
       RowBox[{"zeta", " ", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"chi", "[", 
            RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", 
         "2"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<SpatialRegularizationRes\>\"", "->", 
       RowBox[{"xi", " ", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"res", "[", 
            RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", 
         "2"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<CubicCoupling\>\"", "->", 
       RowBox[{"delta", " ", 
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], " ", 
        RowBox[{"chi", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], " ", 
        RowBox[{"res", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<Confinement\>\"", "->", 
       RowBox[{"lambda", " ", 
        RowBox[{
         RowBox[{"rho", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}]}]}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", "\[IndentingNewLine]", " ", 
  RowBox[{"KeyValueMap", "[", "\[IndentingNewLine]", "   ", 
   RowBox[{
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Term\>\"", "->", "#1"}], ",", 
       RowBox[{"\"\<Expression\>\"", "->", "#2"}]}], "|>"}], " ", "&"}], ",", 
    "terms"}], "\[IndentingNewLine]", " ", "]"}], "\[IndentingNewLine]", 
  "]"}]}], "Input",ExpressionUUID->"160c7e49-b00a-f945-883e-2c97bde46633"]
}, Open  ]],

Cell[CellGroupData[{

Cell["First structural critique", "Subsection",ExpressionUUID->"1221ef4e-c66e-4a40-b676-b8939f826d8f"],

Cell["A better structure would separate:", "Text",ExpressionUUID->"af5b10b8-3982-184d-b460-9f0050658daa"],

Cell[TextData[{
 "1. ",
 StyleBox["core potential",
  FontWeight->Bold],
 " ",
 Cell[BoxData[Cell["V[rho, chi, res]",
   Background->None,ExpressionUUID->"8e079688-97a2-2643-8930-fd642f5afa73"]], 
  "InlineCode",ExpressionUUID->"b7d194cd-6931-1142-a7db-886f234d2d68"],
 "2. ",
 StyleBox["gradient terms",
  FontWeight->Bold],
 " in ",
 StyleBox["x", "TI"],
 "3. ",
 StyleBox["scale-gradient terms",
  FontWeight->Bold],
 " in ",
 StyleBox["sigma", "TI"],
 "4. ",
 StyleBox["measurement functional",
  FontWeight->Bold],
 "instead of mixing ontology and regularization in one expression. "
}], "Text",ExpressionUUID->"3b4e2771-f79f-c243-89ab-024008183149"],

