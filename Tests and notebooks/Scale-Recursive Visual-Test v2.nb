Cell[CellGroupData[{

Cell["18. How might information arise as energy?", "Section",ExpressionUUID->"02c2eb51-add0-7348-9ec1-c30a68f281c7"],

Cell["This must be phrased carefully.", "Text",ExpressionUUID->"ba5f159e-0581-bd46-ae27-65fd166c87d5"],

Cell["There are at least four logically distinct possibilities:", "Text",ExpressionUUID->"2fd88f5c-2413-4d41-85f0-dee1b22093f4"],

Cell[TextData[{
 "1. ",
 StyleBox["Information contributes to an effective energy functional",
  FontWeight->Bold],
 "2. ",
 StyleBox["Energy bounds information-processing cost",
  FontWeight->Bold],
 "3. ",
 StyleBox["Information geometry induces dynamics resembling energetic \
principles",
  FontWeight->Bold],
 "4. ",
 StyleBox["A field called \[OpenCurlyDoubleQuote]information\
\[CloseCurlyDoubleQuote] is postulated and assigned energetic density",
  FontWeight->Bold],
 "These are ",
 StyleBox["not equivalent",
  FontSlant->Italic],
 ". "
}], "Text",ExpressionUUID->"ed685bdd-8a40-9949-8a91-221253372c6f"],

Cell[CellGroupData[{

Cell["Minimal rigorous bridge", "Subsection",ExpressionUUID->"f49524af-d305-7d49-8c61-5fff64489a25"],

Cell["\<\
To say information behaves as energy, define an effective Hamiltonian or \
stress tensor. \
\>", "Text",ExpressionUUID->"bfea6036-9664-6b48-9c18-b8bb1fcfc117"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"potentialEnergyDensity", "=", 
    RowBox[{"potential", "[", 
     RowBox[{
      RowBox[{"rho", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], ",", 
      RowBox[{"chi", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], ",", 
      RowBox[{"res", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "candidateStressTensorNote", 
   "=", "\"\<Need explicit spacetime metric coupling before a true \
stress-energy tensor can be derived.\>\""}], ";"}]}], "Input",ExpressionUUID->\
"24b4e2ec-8a60-0847-82ee-27194da79d3d"],

Cell["Without metric coupling, the statement remains heuristic. ", "Text",ExpressionUUID->"627b38f2-8647-9642-9ea1-a8faa380e417"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
