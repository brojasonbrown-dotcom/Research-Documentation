Cell[CellGroupData[{

Cell["4. Euler\[Dash]Lagrange equations, done correctly", "Section",ExpressionUUID->"a5c3ae73-c7e9-8b44-ae4b-2537889f255f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eulerRho", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"VariationalMethods`VariationalD", "[", 
        RowBox[{"lagrangianDensity", ",", 
         RowBox[{"rho", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eulerChi", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"VariationalMethods`VariationalD", "[", 
        RowBox[{"lagrangianDensity", ",", 
         RowBox[{"chi", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eulerRes", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"VariationalMethods`VariationalD", "[", 
        RowBox[{"lagrangianDensity", ",", 
         RowBox[{"res", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fieldEquations", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eulerRho", ",", "eulerChi", ",", "eulerRes"}], "}"}], "==", 
     "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"fieldEquations", " ", "//", " ", "TableForm"}]}], "Input",Expression\
UUID->"c0d220e4-1d83-1d4e-a2a7-6fef645451d8"],

Cell[CellGroupData[{

Cell["Rigor test", "Subsection",ExpressionUUID->"613b6238-fcee-7544-ad25-0e8565d64fe6"],

Cell["\<\
If the derivative terms disappear from the Euler\[Dash]Lagrange equations, \
that means the variational construction has been mishandled or simplification \
assumptions are too aggressive. \
\>", "Text",ExpressionUUID->"53af4598-3060-1342-bf85-e95000f1248b"],

Cell[BoxData[
 RowBox[{"ContainsAny", "[", 
  RowBox[{
   RowBox[{"ToString", " ", "/@", " ", "fieldEquations"}], ",", 
   RowBox[{"{", 
    RowBox[{"\"\<Derivative\>\"", ",", "\"\<rho'\>\"", ",", "\"\<chi'\>\"", 
     ",", "\"\<res'\>\"", ",", "\"\<D[\>\""}], "}"}]}], "]"}]], "Input",Expres\
sionUUID->"a49157b7-5c0f-ff42-b1cd-c3967cdcfbf0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Interpretation", "Subsection",ExpressionUUID->"26dd7dee-fb12-5747-92e8-2b01c1992fa2"],

Cell[TextData[{
 "If this returns ",
 ButtonBox["False",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/False"],
 ", then the current derived equations are not representing the intended \
regularized field theory. "
}], "Text",ExpressionUUID->"fbc2d300-fbb3-d641-be7b-6a714a510338"],

