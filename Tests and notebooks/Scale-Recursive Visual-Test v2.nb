Cell[CellGroupData[{

Cell["9. Scale ansatz, repaired", "Section",ExpressionUUID->"c53a3aa3-687f-0847-a3db-2c330f92efd0"],

Cell["\<\
The original notebook attempted a separable scale ansatz but misused \
assumptions. \
\>", "Text",ExpressionUUID->"f44e2e20-61c0-fe4a-9b1c-535978c9cce2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"scaleAnsatz", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{
        RowBox[{"rhoS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"a", " ", "sigma"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{
        RowBox[{"chiS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"b", " ", "sigma"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{
        RowBox[{"resS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"c", " ", "sigma"}], "]"}]}]}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleReducedEquations", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"fieldEquations", " ", "/.", " ", "scaleAnsatz"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"(", 
        RowBox[{"$Assumptions", "&&", 
         RowBox[{
          RowBox[{"chiS", "[", "x", "]"}], ">", "0"}]}], ")"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"scaleReducedEquations", " ", "//", " ", "TableForm"}]}], "Input",Exp\
ressionUUID->"13ea932f-f946-394a-9070-6b8709bad474"],

Cell[CellGroupData[{

Cell["Exponent consistency extractor", "Subsection",ExpressionUUID->"71f52685-b589-b546-ac05-0e8c33ea6e2a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"expPowers", "[", "expr_", "]"}], ":=", 
   RowBox[{"DeleteDuplicates", " ", "@", " ", 
    RowBox[{"Cases", "[", 
     RowBox[{"expr", ",", 
      RowBox[{
       RowBox[{"E", "^", 
        RowBox[{"(", 
         RowBox[{"k_.", " ", "sigma"}], ")"}]}], ":>", "k"}], ",", 
      "Infinity"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scalePowers", "=", 
   RowBox[{"expPowers", " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{"Subtract", " ", "@@@", " ", "scaleReducedEquations"}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", 
  RowBox[{"MapIndexed", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Equation\>\"", "->", 
        RowBox[{"First", "[", "#2", "]"}]}], ",", 
       RowBox[{"\"\<Powers\>\"", "->", "#1"}]}], "|>"}], " ", "&"}], ",", 
    "scalePowers"}], "]"}], "]"}]}], "Input",ExpressionUUID->"3ba3475b-1750-\
9b4d-a9dc-0126ca65ed3e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Better interpretation", "Subsection",ExpressionUUID->"90226917-ab26-4f4a-8506-d58fc29f8022"],

Cell[TextData[{
 "Scale invariance should be formulated explicitly, e.g. via weighted \
homogeneity under ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["r", "TI"], 
             StyleBox["e", "TI"], 
             StyleBox["s", "TI"]}], ")"}], "\[RightTeeArrow]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["s", "TI"], 
              SubscriptBox[
               StyleBox["w", "TI"], "\[Rho]"]], "\[Rho]", ",", 
             SuperscriptBox[
              StyleBox["s", "TI"], 
              SubscriptBox[
               StyleBox["w", "TI"], "\[Chi]"]], "\[Chi]", ",", 
             SuperscriptBox[
              StyleBox["s", "TI"], 
              SubscriptBox[
               StyleBox["w", "TI"], 
               StyleBox["r", "TI"]]], 
             StyleBox["r", "TI"], 
             StyleBox["e", "TI"], 
             StyleBox["s", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "(\\rho, \\chi, res) \\mapsto (s^{w_\\rho}\\rho, s^{w_\\chi}\\chi, \
s^{w_r}res)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5dfde316-110c-bd43-bdf8-036a3c982bea"],
 "rather than only via an exponential ansatz in ",
 StyleBox["sigma", "TI"],
 ". "
}], "Text",ExpressionUUID->"e48ccfbd-c56d-e947-a574-7800c317dabf"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"88fa5a69-e72b-e540-a116-9746e8f3c618"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Weighted homogeneity test of the potential", "Section",ExpressionUUID->"1ea58965-a35f-e64e-8199-285681bd69ca"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"weightedDegree", "[", 
     RowBox[{"expr_", ",", "vars_", ",", "weights_", ",", "s_"}], "]"}], ":=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"expr", " ", "/.", " ", 
      RowBox[{"Thread", "[", 
       RowBox[{"vars", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"s", "^", "weights"}], " ", "vars"}], ")"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"{", 
    RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"weights", "=", 
    RowBox[{"{", 
     RowBox[{"wrho", ",", "wchi", ",", "wres"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"homogeneityEquation", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"weightedDegree", "[", 
        RowBox[{
         RowBox[{"extendedPotential", "[", 
          RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "]"}], ",", 
         "vars", ",", "weights", ",", "s"}], "]"}], "==", 
       RowBox[{
        RowBox[{"s", "^", "d"}], " ", 
        RowBox[{"extendedPotential", "[", 
         RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"s", ">", "0"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "homogeneityEquation"}], \
"Input",ExpressionUUID->"a7de26b6-f0d8-1c4b-bb4d-860b183a7472"],

Cell["\<\
This usually exposes that the mixture of logarithms and polynomial terms \
obstructs strict homogeneity unless special reinterpretations are used. \
\>", "Text",ExpressionUUID->"d1d42ed2-4844-3649-9cd4-0c6c276a9fe4"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"fba8e637-a9f7-ba4e-b765-600ee4106e7f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Linearization around a background", "Section",ExpressionUUID->"a8369b6e-c4cc-c44b-93a7-8b291676e12c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"epsilon", ",", "u", ",", "v", ",", "w"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"perturbationRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"rho0", "+", 
        RowBox[{"epsilon", " ", 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"chi0", "+", 
        RowBox[{"epsilon", " ", 
         RowBox[{"v", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"res0", "+", 
        RowBox[{"epsilon", " ", 
         RowBox[{"w", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}]}]}]}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"linearizedEquations", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Normal", " ", "@", " ", 
      RowBox[{"Series", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Subtract", " ", "@@@", " ", "fieldEquations"}], ")"}], " ",
          "/.", " ", "perturbationRules"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"{", 
         RowBox[{"epsilon", ",", "0", ",", "1"}], "}"}]}], 
       "\[IndentingNewLine]", "  ", "]"}]}], " ", "/.", " ", 
     RowBox[{"Equal", "->", "Subtract"}]}], " ", "//", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"#", ",", "epsilon", ",", "1"}], "]"}], " ", "&"}], " ", "/@", 
     " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", "0"}], "]"}]}]}]}], ";"}]}], "Input",ExpressionUUID->\
"3c439bed-0aae-584e-9144-54025229d61d"],

Cell["\<\
Because the previous line is awkward, use a clearer construction: \
\>", "CodeText",ExpressionUUID->"53db02cf-bd25-a043-8953-7778fcef95cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"linearizedResiduals", "=", 
    RowBox[{"Coefficient", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"Normal", " ", "@", " ", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Subtract", " ", "@@@", " ", "fieldEquations"}], ")"}], 
          " ", "/.", " ", "perturbationRules"}], ",", 
         RowBox[{"{", 
          RowBox[{"epsilon", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", "epsilon", ",", "1"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"linearizedResiduals", " ", "//", " ", "TableForm"}]}], "Input",Expre\
ssionUUID->"9c7dfcd9-e1b2-904b-b174-eb1d30757e3c"],

Cell[CellGroupData[{

Cell["Plane-wave mode test", "Subsection",ExpressionUUID->"565796ab-7a21-a048-b87e-1d599c923b52"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"modeRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"uAmp", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"v", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"vAmp", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"w", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", 
       RowBox[{"wAmp", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"modeMatrix", "=", 
    RowBox[{"Normal", " ", "@", " ", 
     RowBox[{
      RowBox[{"CoefficientArrays", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{"linearizedResiduals", " ", "/.", " ", "modeRules"}], " ", "/.",
           " ", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"kx", " ", "x"}], "+", 
               RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}], "->", "1"}]}], 
         "]"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"uAmp", ",", "vAmp", ",", "wAmp"}], "}"}]}], 
       "\[IndentingNewLine]", "  ", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"modeMatrix", " ", "//", " ", "MatrixForm"}]}], "Input",ExpressionUUI\
D->"c7cf6241-0489-0943-864e-cbc57e7f0d0d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Dispersion condition", "Subsection",ExpressionUUID->"a19a4abe-fb48-d244-907d-68696aed5109"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dispersionCondition", "=", 
   RowBox[{"FullSimplify", "[", 
