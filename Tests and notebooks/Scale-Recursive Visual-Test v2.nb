Cell[CellGroupData[{

Cell["5. Independent manual variational cross-check", "Section",ExpressionUUID->"fc5d181c-40f7-c340-b627-06f8485a0e94"],

Cell["\<\
To avoid trusting a single symbolic route, compute the Euler expressions \
manually. \
\>", "Text",ExpressionUUID->"40e66115-52f6-a641-8019-0dc9e54dce9f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"manualEL", "[", 
     RowBox[{"expr_", ",", "field_"}], "]"}], ":=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"expr", ",", 
         RowBox[{"field", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}]}], "]"}], "-", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"field", "[", 
              RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}]}], "]"}], 
         ",", "x"}], "]"}], "-", "\[IndentingNewLine]", "   ", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"field", "[", 
              RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}]}], 
          "]"}], ",", "sigma"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"manualRho", "=", 
   RowBox[{"manualEL", "[", 
    RowBox[{"lagrangianDensity", ",", "rho"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"manualChi", "=", 
   RowBox[{"manualEL", "[", 
    RowBox[{"lagrangianDensity", ",", "chi"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"manualRes", "=", 
    RowBox[{"manualEL", "[", 
     RowBox[{"lagrangianDensity", ",", "res"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"crossCheck", "=", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", "   ", 
        RowBox[{
         RowBox[{"eulerRho", "-", "manualRho"}], ",", "\[IndentingNewLine]", 
         "   ", 
         RowBox[{"eulerChi", "-", "manualChi"}], ",", "\[IndentingNewLine]", 
         "   ", 
         RowBox[{"eulerRes", "-", "manualRes"}]}], "\[IndentingNewLine]", 
        "  ", "}"}], "==", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", "$Assumptions"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "crossCheck"}], "Input",Expr\
essionUUID->"2e5ddc73-b760-7f48-a586-09e696b68055"],

Cell[TextData[{
 "Expected: ",
 Cell[BoxData[Cell["{True, True, True}",
   Background->None,ExpressionUUID->"823259de-9cb4-c14d-8436-175caf619ff8"]], 
  "InlineCode",ExpressionUUID->"41df1fec-6441-2348-9016-861e933b399f"],
 "If not true, the derivation pipeline is not yet rigorous. "
}], "Text",ExpressionUUID->"38dd5beb-4d9a-e743-9d90-3aa1b481bffe"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"d1225be4-eae2-4049-bc68-9440c78c1f5b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Homogeneous stationary sector", "Section",ExpressionUUID->"1efcd312-6928-f640-a1ea-1458e0b9425f"],

Cell["\<\
This is where the original notebook tried to define fixed points. \
\>", "Text",ExpressionUUID->"e876a010-d321-174a-bde7-dfe64a0e5f59"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"homogeneousRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "rho0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "chi0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "res0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"homogeneousEquations", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"fieldEquations", " ", "/.", " ", "homogeneousRules"}], ",", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"chi0", ">", "0"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"homogeneousEquations", " ", "//", " ", "TableForm"}]}], "Input",Expr\
essionUUID->"2a3c1ce7-59c1-de47-ab8b-e7a0ae904cac"],

Cell[CellGroupData[{

Cell["Solve fixed points correctly", "Subsection",ExpressionUUID->"25f14201-7a4d-9743-a570-b29b1cedf283"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fixedPoints", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Reduce", "[", 
       RowBox[{"homogeneousEquations", ",", 
        RowBox[{"{", 
         RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", "Reals"}], 
       "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"chi0", ">", "0"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "fixedPoints"}], "Input",Exp\
ressionUUID->"607d76f8-fb41-ae46-81fd-3c80b759a73c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Better alternative structure", "Subsection",ExpressionUUID->"9b019f73-91b5-b14e-bc0f-b45226d90b51"],

Cell["\<\
A more transparent route is to define the homogeneous potential directly: \
\>", "CodeText",ExpressionUUID->"ba9444b9-1eaf-1840-9eba-75b5977f1e5d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"potential", "[", 
     RowBox[{"rhoVar_", ",", "chiVar_", ",", "resVar_"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"rhoVar", " ", 
      RowBox[{"Log", "[", "chiVar", "]"}]}], "+", 
     RowBox[{"chiVar", " ", 
      RowBox[{"resVar", "^", "2"}]}], "+", 
     RowBox[{"delta", " ", "rhoVar", " ", "chiVar", " ", "resVar"}], "+", 
     RowBox[{"lambda", " ", 
      RowBox[{"rhoVar", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stationaryConditions", "=", 
    RowBox[{"Thread", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Grad", "[", 
       RowBox[{
        RowBox[{"potential", "[", 
         RowBox[{"rho0", ",", "chi0", ",", "res0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}]}], "]"}], "==", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"stationaryConditions", ",", 
   RowBox[{"Reduce", "[", 
    RowBox[{"stationaryConditions", ",", 
     RowBox[{"{", 
      RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", "Reals"}], 
    "]"}]}], "}"}]}], "Input",ExpressionUUID->"dcae9728-3194-5344-91db-\
f913927cc53d"],

Cell["This avoids mixing PDE and homogeneous algebra prematurely. ", "Text",ExpressionUUID->"ad589130-a153-0849-aff1-7c7079c76ea4"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"c61cac71-7837-1c48-bdb5-fe49769a35d8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Hessian-based stability test at fixed points", "Section",ExpressionUUID->"4c0bf968-d301-fc42-9cc3-bb6f8e1a40e0"],

Cell["A fixed point is not enough. We need local curvature. ", "Text",ExpressionUUID->"9edbcd20-030f-4241-bd8d-31a2deabdc56"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hessian", "=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"potential", "[", 
      RowBox[{"rho0", ",", "chi0", ",", "res0"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", "2"}], 
      "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"hessian", " ", "//", " ", "MatrixForm"}]}], "Input",ExpressionUUID->\
"9a817990-abae-4545-a673-b5e8dc34bd20"],

Cell["Evaluate at each fixed-point branch if possible. ", "Text",ExpressionUUID->"997f0602-6ceb-1b42-a388-923f8b267a7c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fixedPointRules", "=", 
    RowBox[{"Solve", "[", 
     RowBox[{"stationaryConditions", ",", 
      RowBox[{"{", 
       RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", "Reals"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stabilityData", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<FixedPoint\>\"", "->", 
         RowBox[{"fixedPointRules", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<Hessian\>\"", "->", 
         RowBox[{"Simplify", "[", 
          RowBox[{"hessian", " ", "/.", " ", 
           RowBox[{"fixedPointRules", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Eigenvalues\>\"", "->", 
         RowBox[{"Simplify", "[", 
          RowBox[{"Eigenvalues", "[", 
           RowBox[{"hessian", " ", "/.", " ", 
            RowBox[{"fixedPointRules", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"Length", "[", "fixedPointRules", "]"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", "stabilityData", "]"}]}], "Input",ExpressionUUID->\
"b0b4a035-a5b2-0341-9387-1cc04c0bec78"],

Cell[CellGroupData[{

Cell["Interpretation", "Subsection",ExpressionUUID->"d49d1190-849d-834c-8d77-9581ab43b069"],

Cell["all positive eigenvalues: strict local minimum", "Item",ExpressionUUID->"86f62016-9b65-0741-9865-fc549928f777"],

Cell["one or more zero eigenvalues: flat direction or marginality", "Item",ExpressionUUID->"413438d2-5c26-454d-aa8c-2df7ba7f5f6a"],

Cell["negative eigenvalue: instability", "Item",ExpressionUUID->"f1a85dd3-d39b-854e-b0f0-fec0570241af"],

