 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"8dc2dfd4-672f-7a40-9dc5-f3ec047b1e42"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["19. Proposed better notebook structure", "Section",ExpressionUUID->"d0aa4935-0e4e-2c4a-abdc-cbbbd68c7db3"],

Cell["A more rigorous organization would be:", "Text",ExpressionUUID->"7358a407-2de9-4b43-9a7e-f19624d1a8c2"],

Cell[TextData[{
 "1. ",
 StyleBox["Definitions and status labels",
  FontWeight->Bold],
 "2. ",
 StyleBox["Dimensional analysis",
  FontWeight->Bold],
 "3. ",
 StyleBox["Action / potential",
  FontWeight->Bold],
 "4. ",
 StyleBox["Variational derivation",
  FontWeight->Bold],
 "5. ",
 StyleBox["Independent derivation cross-check",
  FontWeight->Bold],
 "6. ",
 StyleBox["Homogeneous equilibria",
  FontWeight->Bold],
 "7. ",
 StyleBox["Hessian stability",
  FontWeight->Bold],
 "8. ",
 StyleBox["Boundedness/coercivity",
  FontWeight->Bold],
 "9. ",
 StyleBox["Scale invariance / homogeneity",
  FontWeight->Bold],
 "10. ",
 StyleBox["Linearized modes / dispersion",
  FontWeight->Bold],
 "11. ",
 StyleBox["Measurement operator definition",
  FontWeight->Bold],
 "12. ",
 StyleBox["Numerical experiments",
  FontWeight->Bold],
 "13. ",
 StyleBox["Null models and controls",
  FontWeight->Bold],
 "14. ",
 StyleBox["Interpretation limits",
  FontWeight->Bold],
 "15. ",
 StyleBox["Physical predictions required for falsifiability",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"a35dd8b9-8f7c-dc4e-8f3e-1493f5f33bf0"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"1fadad0c-046b-7547-bfd3-1707371aee68"]
}, Open  ]],

Cell[CellGroupData[{

Cell["20. Final notebook checklist", "Section",ExpressionUUID->"68ba157d-9dc1-304d-9439-ced0a1c3bd93"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"verificationChecklist", "=", 
    RowBox[{"Dataset", "[", 
     RowBox[{"{", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Test\>\"", "->", "\"\<No symbol shadowing\>\""}], ",", 
         RowBox[{"\"\<PassCondition\>\"", 
          "->", "\"\<VariationalD only in VariationalMethods`\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", "->", "\"\<to evaluate\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Test\>\"", "->", "\"\<Euler-Lagrange cross-check\>\""}],
          ",", 
         RowBox[{"\"\<PassCondition\>\"", 
          "->", "\"\<manual and package derivations agree\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", "->", "\"\<to evaluate\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Test\>\"", "->", "\"\<Fixed-point existence\>\""}], ",", 
         RowBox[{"\"\<PassCondition\>\"", 
          "->", "\"\<Reduce/Solve returns real solutions\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", "->", "\"\<to evaluate\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Test\>\"", "->", "\"\<Local stability\>\""}], ",", 
         RowBox[{"\"\<PassCondition\>\"", 
          "->", "\"\<Hessian eigenvalues nonnegative/positive as \
claimed\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", "->", "\"\<to evaluate\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Test\>\"", "->", "\"\<Boundedness below\>\""}], ",", 
         RowBox[{"\"\<PassCondition\>\"", 
          "->", "\"\<no runaway ray to -Infinity\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", "->", "\"\<to evaluate\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Test\>\"", "->", "\"\<Scale homogeneity\>\""}], ",", 
         RowBox[{"\"\<PassCondition\>\"", 
          "->", "\"\<weighted scaling law holds\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", "->", "\"\<to evaluate\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Test\>\"", "->", "\"\<Linear mode spectrum\>\""}], ",", 
         RowBox[{"\"\<PassCondition\>\"", 
          "->", "\"\<dispersion relation derived and interpreted\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", "->", "\"\<to evaluate\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Test\>\"", 
          "->", "\"\<Measurement operator well-defined\>\""}], ",", 
         RowBox[{"\"\<PassCondition\>\"", 
          "->", "\"\<domain/codomain/fixed points specified\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", "->", "\"\<to evaluate\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Test\>\"", "->", "\"\<Claim-evidence linkage\>\""}], ",", 
         RowBox[{"\"\<PassCondition\>\"", 
          "->", "\"\<every major claim linked to raw computational evidence\>\
\""}], ",", 
         RowBox[{"\"\<Status\>\"", "->", "\"\<to evaluate\>\""}]}], "|>"}]}], 
      "\[IndentingNewLine]", "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "verificationChecklist"}], \
"Input",ExpressionUUID->"c7727169-f301-d64e-b0d4-17ff7e6a3f0a"],

