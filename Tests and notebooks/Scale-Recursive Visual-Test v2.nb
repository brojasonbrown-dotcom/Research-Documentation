Cell[CellGroupData[{

Cell["8. Boundedness-below analysis", "Section",ExpressionUUID->"42c734ec-a355-194d-ba73-4d6fba815aea"],

Cell["\<\
This is one of the most important tests because your own probe report claims \
the original potential fails here. \
\>", "Text",ExpressionUUID->"4968e63e-5bda-9e4c-afd1-868a802920cf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"originalPotential", "[", 
    RowBox[{"rhoVar_", ",", "chiVar_", ",", "resVar_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"rhoVar", " ", 
     RowBox[{"Log", "[", "chiVar", "]"}]}], "+", 
    RowBox[{"chiVar", " ", 
     RowBox[{"resVar", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"extendedPotential", "[", 
    RowBox[{"rhoVar_", ",", "chiVar_", ",", "resVar_"}], "]"}], ":=", 
   RowBox[{"potential", "[", 
    RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"76f4adda-d920-924f-b6ca-96f9ab84838b"],

Cell[CellGroupData[{

Cell["Symbolic rays through field space", "Subsection",ExpressionUUID->"7e1d84a8-921d-314c-b884-38bd66056a63"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rayTests", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"rhoVar", "->", "t"}], ",", 
        RowBox[{"chiVar", "->", "1"}], ",", 
        RowBox[{"resVar", "->", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"rhoVar", "->", 
         RowBox[{"-", "t"}]}], ",", 
        RowBox[{"chiVar", "->", "1"}], ",", 
        RowBox[{"resVar", "->", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"rhoVar", "->", "t"}], ",", 
        RowBox[{"chiVar", "->", 
         RowBox[{"Exp", "[", 
          RowBox[{"-", "t"}], "]"}]}], ",", 
        RowBox[{"resVar", "->", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"rhoVar", "->", "t"}], ",", 
        RowBox[{"chiVar", "->", 
         RowBox[{"1", "/", "t"}]}], ",", 
        RowBox[{"resVar", "->", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"rhoVar", "->", "t"}], ",", 
        RowBox[{"chiVar", "->", "1"}], ",", 
        RowBox[{"resVar", "->", "t"}]}], "}"}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"boundednessTable", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"<|", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{"\"\<Ray\>\"", "->", "ray"}], ",", "\[IndentingNewLine]", 
        "    ", 
        RowBox[{"\"\<OriginalAsymptotic\>\"", "->", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{"Asymptotic", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"originalPotential", "[", 
              RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "]"}], " ", "/.",
              " ", "ray"}], ",", 
            RowBox[{"t", "->", "Infinity"}]}], "]"}], "]"}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<ExtendedAsymptotic\>\"", "->", 
         RowBox[{"FullSimplify", "[", 
          RowBox[{"Asymptotic", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"extendedPotential", "[", 
              RowBox[{"rhoVar", ",", "chiVar", ",", "resVar"}], "]"}], " ", "/.",
              " ", "ray"}], ",", 
            RowBox[{"t", "->", "Infinity"}]}], "]"}], "]"}]}]}], 
       "\[IndentingNewLine]", "  ", "|>"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"ray", ",", "rayTests"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", "boundednessTable", "]"}]}], "Input",ExpressionUUID->\
"ea8294ef-2933-db43-b539-1ed9417edbd1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visual scan", "Subsection",ExpressionUUID->"9e849453-233d-ce43-99ab-2bb39866722d"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"chiSlice", "=", "1"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"ContourPlot", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"extendedPotential", "[", 
       RowBox[{"rhoVar", ",", "chiSlice", ",", "resVar"}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"rhoVar", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"resVar", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"PlotLegends", "->", "Automatic"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<rho\>\"", ",", "\"\<res\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
     "PlotLabel", "->", "\"\<Extended potential slice at chi = 1\>\""}]}], 
    "\[IndentingNewLine]", " ", "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"aed6315c-5975-0440-a8ef-a06638d5aac0"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"4ea58b46-95fc-1f46-bbd5-7c29c15edd9c"]
}, Open  ]]
