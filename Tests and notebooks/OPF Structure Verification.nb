   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"5a1c4cd0-5ac0-e846-b6d5-75c699409bfb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Residual Analysis", "Section",ExpressionUUID->"955373fa-afc8-8841-b104-a897711c3eed"],

Cell["\<\
Per your solver directives, validation should include residual analysis.\
\>", "Text",ExpressionUUID->"56cceaf8-8073-f14b-8724-640d3878cf29"],

Cell[TextData[{
 "We compute the pointwise residual ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "-", 
         SuperscriptBox["\[Psi]", "\[Prime]\[Prime]"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", "2", "\[Rho]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "log", 
         RowBox[{"(", 
           RowBox[{"\[Chi]", "(", 
             StyleBox["x", "TI"], ")"}], ")"}], "\[Psi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", "4", "\[Chi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         StyleBox["R", "TI"], 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "2"], "\[Psi]", 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathcal{R}(x) = -\\psi''(x) + 2\\rho(x)\\log(\\chi(x))\\psi(x) + \
4\\chi(x)R(x)^2\\psi(x)^3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "101b896e-0904-004f-a8c5-74a10241576e"],
 "with the solved field substituted in. "
}], "Text",ExpressionUUID->"1869ef42-02bd-3147-a8bb-1c315bc11322"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "residualFun", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"residualFun", "[", "x_", "]"}], ":=", 
   RowBox[{"Evaluate", "[", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"fieldEq", " ", "/.", " ", 
       RowBox[{"Equal", "->", "Subtract"}]}], " ", "/.", " ", 
      RowBox[{"psi", "->", "opfSolution"}]}], ")"}], "]"}]}], ";"}]}], "Input",\
ExpressionUUID->"2682f59a-4bbd-0149-8963-483b40d8a535"],

Cell["Sample the residual densely. ", "Text",ExpressionUUID->"7e735744-9df6-0849-b9c4-6f4d3ecbfabc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"residualGrid", ",", "residualValues", ",", "maxResidual"}], "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"residualGrid", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"Subdivide", "[", 
      RowBox[{"0", ",", "1", ",", "200"}], "]"}], ",", "60"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"residualValues", "=", 
   RowBox[{"SetPrecision", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"residualFun", " ", "/@", " ", "residualGrid"}], "]"}], ",", 
     "60"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"maxResidual", "=", 
  RowBox[{"Max", "[", "residualValues", "]"}]}]}], "Input",ExpressionUUID->\
"b625009d-3eb2-9941-ae92-be006554e500"],

Cell["Residual plot: ", "CodeText",ExpressionUUID->"9b586b17-4f6d-a142-80a4-4030cf625cb7"],

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"residualGrid", ",", "residualValues"}], "}"}], "]"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"ScalingFunctions", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", "\"\<Log\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotLabel", "->", "\"\<Residual Magnitude Across Domain\>\""}], ",",
    "\[IndentingNewLine]", "  ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<|Residual|\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"ImageSize", "->", "Large"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"59f5d344-65f9-c847-98de-d5f628ae3b95"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"7891c175-fda0-3549-9ab3-81a0321ded77"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Resolution / Precision Refinement Study", "Section",ExpressionUUID->"340ad31d-2cd6-7944-ba7f-6d1091d9268f"],

Cell["\<\
To make the test complete, we verify that the solution stabilizes as \
precision is increased. \
\>", "Text",ExpressionUUID->"a6963f89-9c57-0246-a5fc-bb6bbf10fe1b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "solveAtPrecision", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solveAtPrecision", "[", "wp_Integer", "]"}], ":=", 
  RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"fieldEq", "==", "0"}], ",", "bcs"}], "}"}], ",", 
    "\[IndentingNewLine]", "  ", "psi", ",", "\[IndentingNewLine]", "  ", 
    "domain", ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"WorkingPrecision", "->", "wp"}], ",", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{"PrecisionGoal", "->", 
     RowBox[{"Floor", "[", 
      RowBox[{"wp", "/", "2"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"AccuracyGoal", "->", 
     RowBox[{"Floor", "[", 
      RowBox[{"wp", "/", "2"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
    RowBox[{"Method", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<BoundaryValues\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<Shooting\>\"", ",", 
         RowBox[{"\"\<StartingInitialConditions\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"psi", "[", "0", "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"psi", "'"}], "[", "0", "]"}], "==", 
             RowBox[{"1", "/", "10"}]}]}], "}"}]}]}], "}"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",ExpressionUUID->"275bc426-52b9-\
b84d-8346-b76e4e9c8f12"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "precisions", ",", "refinedSolutions", ",", "probePoints", ",", 
    "convergenceTable"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"precisions", "=", 
   RowBox[{"{", 
    RowBox[{"40", ",", "60", ",", "80"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"refinedSolutions", "=", 
   RowBox[{"AssociationThread", "[", 
    RowBox[{"precisions", ",", 
     RowBox[{"solveAtPrecision", " ", "/@", " ", "precisions"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"probePoints", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Subdivide", "[", 
       RowBox[{"0", ",", "1", ",", "20"}], "]"}], ",", "50"}], "]"}]}], ";"}],
   "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"convergenceTable", "=", 
    RowBox[{
     RowBox[{"Table", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"s1", "=", 
            RowBox[{"refinedSolutions", "[", "p1", "]"}]}], ",", 
           RowBox[{"s2", "=", 
            RowBox[{"refinedSolutions", "[", "p2", "]"}]}]}], "}"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"<|", "\[IndentingNewLine]", "      ", 
          RowBox[{
           RowBox[{"\"\<Pair\>\"", "->", 
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2"}], "}"}]}], ",", "\[IndentingNewLine]", 
           "      ", 
           RowBox[{"\"\<MaxDifference\>\"", "->", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"s1", " ", "/@", " ", "probePoints"}], ")"}], "-", 
               RowBox[{"(", 
                RowBox[{"s2", " ", "/@", " ", "probePoints"}], ")"}]}], "]"}],
              "]"}]}]}], "\[IndentingNewLine]", "    ", "|>"}]}], 
        "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"p1", ",", 
         RowBox[{"Most", "[", "precisions", "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"p2", ",", 
         RowBox[{"Rest", "[", "precisions", "]"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], " ", "//", " ", "Flatten"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Dataset", "[", "convergenceTable", "]"}]}], "Input",ExpressionUUID->\
"4b210da2-32fc-fe48-b847-a7fc608cbe88"],

Cell["Plot the solutions together. ", "Text",ExpressionUUID->"401ddbab-2ed8-2944-9e46-1eb538ee6d58"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"refinedSolutions", "[", "wp", "]"}], "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"wp", ",", "precisions"}], "}"}]}], "]"}], "]"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"ToString", " ", "/@", " ", "precisions"}], ",", "Right"}], 
     "]"}]}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotLabel", "->", "\"\<Precision Refinement Comparison\>\""}], ",",
    "\[IndentingNewLine]", "  ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<\[Psi](x)\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"ImageSize", "->", "Large"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"6d01498f-8f4d-734c-932d-60686cad532e"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"5834079a-2b78-cc4a-8f6c-f8d730d7e0ae"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Stable Frequency Extraction", "Section",ExpressionUUID->"21d1a747-4633-d540-82ad-23c8f81136db"],

Cell["\<\
Your directive asks for linearization and eigenvalue extraction.\
\>", "Text",ExpressionUUID->"70b09f1d-ed41-c74f-94ef-55434dfefc01"],

Cell[TextData[{
 "Linearize about the computed background solution ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Psi]", "0"], "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\psi_0(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4d7807bd-7dbe-e14c-9191-1e12413fa427"],
 " by setting ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Psi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SubscriptBox["\[Psi]", "0"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", "\[Epsilon]", 
         StyleBox["u", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\psi(x) = \\psi_0(x) + \\varepsilon u(x)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1a278972-c9e0-4a47-aa7a-a5b36eb6b22d"],
 "Then the linearized operator is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         StyleBox["u", "TI"], "\[LongEqual]", "-", 
         SuperscriptBox[
          StyleBox["u", "TI"], "\[Prime]\[Prime]"], "+", 
         RowBox[{"(", 
           RowBox[{"2", "\[Rho]", "log", 
             RowBox[{"(", "\[Chi]", ")"}], "+", "12", "\[Chi]", 
             SuperscriptBox[
              StyleBox["R", "TI"], "2"], 
             SubsuperscriptBox["\[Psi]", "0", "2"]}], ")"}], 
         StyleBox["u", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{L}u = -u'' + \\left(2\\rho\\log(\\chi) + 12\\chi R^2 \
\\psi_0^2\\right)u", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41dd2fe8-9545-0641-a246-0b8a6e5359ac"],
 "We discretize this as a Sturm\[Dash]Liouville eigenproblem on the same \
interval with homogeneous Dirichlet conditions. "
}], "Text",ExpressionUUID->"d7e3153f-b0c3-2c4a-81ba-c59facf4f008"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "potentialFun", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"potentialFun", "[", "x_", "]"}], ":=", 
   RowBox[{"Evaluate", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"rhoFun", "[", "x", "]"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"chiFun", "[", "x", "]"}], "]"}]}], "+", 
     RowBox[{"12", " ", 
      RowBox[{"chiFun", "[", "x", "]"}], " ", 
      RowBox[{
       RowBox[{"resFun", "[", "x", "]"}], "^", "2"}], " ", 
      RowBox[{
       RowBox[{"opfSolution", "[", "x", "]"}], "^", "2"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"26ce4663-6e09-2144-a08d-e1d6ef1a52e5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"eigenvals", ",", "eigenfuns"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"eigenvals", ",", "eigenfuns"}], "}"}], "=", 
   RowBox[{"NDEigensystem", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"u", "''"}], "[", "x", "]"}]}], "+", 
        RowBox[{
         RowBox[{"potentialFun", "[", "x", "]"}], " ", 
         RowBox[{"u", "[", "x", "]"}]}]}], ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"DirichletCondition", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "[", "x", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"x", "==", "0"}], "||", 
          RowBox[{"x", "==", "1"}]}]}], "]"}]}], "\[IndentingNewLine]", "  ", 
      "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"u", "[", "x", "]"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", "6", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"WorkingPrecision", "->", "60"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"Method", "->", 
      RowBox[{"{", "\"\<FiniteElement\>\"", "}"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"24a91983-8127-9e43-9f17-\
01e2645009e9"],

Cell["Display the eigenvalues. ", "Text",ExpressionUUID->"259aa2aa-bf2c-5a4a-aa7f-833ae7a2f7b5"],

Cell[BoxData[
 RowBox[{"Grid", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Prepend", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#2", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "#1"}], "}"}], " ", "&"}], ",",
        "eigenvals"}], "]"}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{"\"\<Mode\>\"", ",", "\"\<Eigenvalue\>\""}], "}"}]}], 
    "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"Frame", "->", "All"}]}], "\[IndentingNewLine]", "]"}]], "Input",Ex\
pressionUUID->"ec7c4f50-8d75-da49-a487-f28eff6fbd49"],

Cell["\<\
For this self-adjoint linearization, undamped oscillatory modes correspond \
naturally to positive spectral values. Frequencies are: \
\>", "CodeText",ExpressionUUID->"3b554fc0-c3f0-4247-bc78-5def5389a5e3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "frequencies", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"frequencies", "=", 
  RowBox[{
   RowBox[{"Sqrt", "[", "eigenvals", "]"}], " ", "//", " ", 
   RowBox[{
    RowBox[{"N", "[", 
     RowBox[{"#", ",", "30"}], "]"}], " ", "&"}]}]}]}], "Input",ExpressionUUID\
->"b465e440-e532-8840-b3b9-fc76e7f87b95"],

Cell["Visualize the first modes. ", "Text",ExpressionUUID->"f4f24349-ec55-dc48-a598-82a60d06630f"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"eigenfuns", "[", 
     RowBox[{"[", 
      RowBox[{"1", " ", ";;", " ", "4"}], "]"}], "]"}], "]"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
   "PlotLabel", "->", "\"\<First Four Linearized OPF Eigenmodes\>\""}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<mode amplitude\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"ImageSize", "->", "Large"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"3e51fe08-9f87-5948-961c-985241b6228b"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"c2324cd9-ec34-5144-a703-a58dbdb5e97f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Missing Variable Analysis", "Section",ExpressionUUID->"235b8435-2005-6642-92a7-1b71c7d521da"],

Cell["\<\
Your instruction says to compute variables absent from standard model \
constants and expose solvable structure.\
\>", "Text",ExpressionUUID->"803b0686-4644-474c-9a5a-e3541c086594"],

Cell["\<\
Here we identify the symbolic variables in the OPF action and in the reduced \
field equation. \
\>", "Text",ExpressionUUID->"9ec29a2d-1e8e-3544-8a61-230a2145f403"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"actionVariables", ",", "reducedEquationVariables"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"actionVariables", "=", 
   RowBox[{"DeleteDuplicates", " ", "@", " ", 
    RowBox[{"Cases", "[", 
     RowBox[{"lagrangian", ",", "_Symbol", ",", "Infinity"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"reducedEquationVariables", "=", 
    RowBox[{"DeleteDuplicates", " ", "@", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{"fieldEq", ",", "_Symbol", ",", "Infinity"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"<|", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"\"\<ActionVariables\>\"", "->", "actionVariables"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<ReducedEquationVariables\>\"", "->", 
    "reducedEquationVariables"}]}], "\[IndentingNewLine]", "|>"}]}], "Input",E\
xpressionUUID->"68253408-01af-6140-b4bb-003f9d64b72a"],

Cell["\<\
A more useful structural result is to solve the field equation algebraically \
for the cubic coefficient term when possible. \
\>", "Text",ExpressionUUID->"fc9c5169-55a0-2e4d-9b8f-563cf5372b07"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "algebraicRearrangement", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"algebraicRearrangement", "=", 
  RowBox[{
   RowBox[{"Solve", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"fieldEq", "==", "0"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"psi", "''"}], "[", "x", "]"}]}], "\[IndentingNewLine]", "]"}], 
   " ", "//", " ", "FullSimplify"}]}]}], "Input",ExpressionUUID->"a470e7df-\
f2b2-e94c-82c7-195ede43e889"],

Cell["\<\
This exposes the morphism from OPF coefficients into curvature of the field. \
\>", "Text",ExpressionUUID->"f0e21843-8096-6845-a633-b8f1c821f6b0"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"d8ad5e42-e52b-4b46-9a8f-8cc466153ed3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Layer 2 Measurement Operator", "Section",ExpressionUUID->"1329944c-638f-074f-a737-ed4b043dce6d"],

Cell["\<\
Per your Layer 2 definition, observables are integrals of the field over an \
eigenbasis.\
\>", "Text",ExpressionUUID->"ed0f2789-2d0c-b949-8160-ac88f8ae635d"],

Cell[TextData[{
 "For the 1D reduced case, define modal observables ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Integral]", "0", "1"], "\[Psi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], " ", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[DifferentialD]", 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "M_n = \\int_0^1 \\psi(x) \\, e_n(x)\\, dx", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "072bc61d-a48a-ff4b-b208-6e2bfabca616"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "e_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d42a9951-d0cf-ee4b-8fcf-c3b3783bc23f"],
 " are normalized eigenfunctions. "
}], "Text",ExpressionUUID->"664b39d6-157d-d94a-85ae-3970c6fef72e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "measurementOperator", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementOperator", "[", "n_Integer", "]"}], ":=", 
   RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"opfSolution", "[", "x", "]"}], " ", 
      RowBox[{"eigenfuns", "[", 
       RowBox[{"[", "n", "]"}], "]"}]}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"WorkingPrecision", "->", "60"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"PrecisionGoal", "->", "30"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"AccuracyGoal", "->", "30"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"fa46a7c6-aff9-a84f-8598-4caf692da48f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "measurements", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"measurements", "=", 
  RowBox[{"Association", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"n", "->", 
      RowBox[{"measurementOperator", "[", "n", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"Length", "[", "eigenfuns", "]"}]}], "}"}]}], 
    "]"}]}]}]}], "Input",ExpressionUUID->"92b7659e-c708-b14e-833e-\
377973ed359f"],

Cell["Visualize modal amplitudes. ", "Text",ExpressionUUID->"dfe8eba9-0517-f442-b941-941dac0016aa"],

Cell[BoxData[
 RowBox[{"BarChart", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"Values", "[", "measurements", "]"}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"ChartLabels", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"Keys", "[", "measurements", "]"}], ",", "Below"}], "]"}]}], ",",
    "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"PlotLabel", "->", "\"\<Layer 2 Measurement Amplitudes\>\""}], ",",
    "\[IndentingNewLine]", "  ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Mode\>\"", ",", "\"\<Observable\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"ImageSize", "->", "Large"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"ed4e8325-13f0-1d41-a094-39d40d7d7897"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"d04e7035-9c9f-c145-82cd-f85244245240"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. L0 \[RightArrow] L1 \[RightArrow] L2 Pipeline", "Section",ExpressionUUID->"e3181c5f-33ea-ed45-b9ae-11b8f2975030"],

Cell["Now compose the full callable pipeline as requested. ", "Text",ExpressionUUID->"8a88355e-d1d8-5544-a7f6-9ae977c12b95"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "layer0", ",", "layer1Operator", ",", "layer2Operator", ",", 
     "opfPipeline"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer0", "[", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Geometry\>\"", 
       "->", "\"\<SphereBoundaryDualityPlaceholder\>\""}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<TemporalMode\>\"", "->", "\"\<Timeless\>\""}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Substrate\>\"", "->", "\"\<EmptySpacetime\>\""}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer1Operator", "[", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Lagrangian\>\"", "->", "lagrangian"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<EulerEquation\>\"", "->", "eulerEq"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ConcreteEquation\>\"", "->", "fieldEq"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Solution\>\"", "->", "opfSolution"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ResidualMax\>\"", "->", "maxResidual"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Eigenvalues\>\"", "->", "eigenvals"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Frequencies\>\"", "->", "frequencies"}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer2Operator", "[", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Measurements\>\"", "->", "measurements"}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"opfPipeline", "=", 
   RowBox[{"RightComposition", "[", 
    RowBox[{"layer0", ",", 
     RowBox[{"Function", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<L0\>\"", "->", "#"}], ",", 
        RowBox[{"\"\<L1\>\"", "->", 
         RowBox[{"layer1Operator", "[", "]"}]}], ",", 
        RowBox[{"\"\<L2\>\"", "->", 
         RowBox[{"layer2Operator", "[", "]"}]}]}], "|>"}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"249c2445-9e1f-a949-bc3e-b4f2ffa0fa71"],

Cell["Inspect the pipeline output. ", "Text",ExpressionUUID->"62ddfaac-cdf3-1648-989f-05cc727724cb"],

Cell[BoxData[
 RowBox[{"opfPipeline", "[", "]"}]], "Input",ExpressionUUID->"d99463e4-c096-0f49-8064-cd108ee28940"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"ecc8c26d-1d4c-974b-901d-b1ac920753aa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Automated Verification Tests", "Section",ExpressionUUID->"d0149554-974c-ad45-b2c3-090bd64ce74a"],

Cell["\<\
We now make the notebook a complete test harness with actual pass/fail \
indications. \
\>", "Text",ExpressionUUID->"bea202db-6acd-1645-bab2-6512b04f079a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "tests", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tests", "=", 
   RowBox[{"{", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{"eulerEq", ",", "_Equal"}], "]"}], ",", "\[IndentingNewLine]",
        "    ", "True", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-EL-Derivation-001\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{
          RowBox[{"opfSolution", "[", "0", "]"}], ",", 
          RowBox[{"10", "^", 
           RowBox[{"-", "40"}]}]}], "]"}], "==", "0"}], ",", 
       "\[IndentingNewLine]", "    ", "True", ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-BC-Left-002\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"opfSolution", "[", "1", "]"}], "-", 
          RowBox[{"1", "/", "10"}]}], "]"}], "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "40"}]}]}], ",", "\[IndentingNewLine]", "    ", "True", 
       ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-BC-Right-003\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"maxResidual", "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "30"}]}]}], ",", "\[IndentingNewLine]", "    ", "True", 
       ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-Residual-004\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{"Rest", "[", "eigenvals", "]"}], ",", 
         RowBox[{
          RowBox[{"#", ">", 
           RowBox[{"eigenvals", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], " ", "&"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "    ", "True", ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-Spectrum-Ordered-005\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{"eigenvals", ",", "Positive"}], "]"}], ",", 
       "\[IndentingNewLine]", "    ", "True", ",", "\[IndentingNewLine]", 
       "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-Stable-Modes-006\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"refinedSolutions", "[", "60", "]"}], " ", "/@", " ", 
             "probePoints"}], ")"}], "-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"refinedSolutions", "[", "80", "]"}], " ", "/@", " ", 
             "probePoints"}], ")"}]}], "]"}], "]"}], "<", 
        RowBox[{"10", "^", 
         RowBox[{"-", "20"}]}]}], ",", "\[IndentingNewLine]", "    ", "True", 
       ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-Precision-Convergence-007\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}], ",", "\[IndentingNewLine]", "  ", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"VerificationTest", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"VectorQ", "[", 
        RowBox[{
         RowBox[{"Values", "[", "measurements", "]"}], ",", "NumericQ"}], 
        "]"}], ",", "\[IndentingNewLine]", "    ", "True", ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"TestID", "->", "\"\<OPF-Measurement-Numeric-008\>\""}]}], 
      "\[IndentingNewLine]", "  ", "]"}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]}], "Input",ExpressionUUID->"6c9a0f13-0084-9348-a4ca-c0fc279648b9"],

Cell["Evaluate the tests: ", "CodeText",ExpressionUUID->"95f6fb0c-751f-6941-ac93-2152469cd2df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "testResults", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"testResults", "=", 
  RowBox[{"TestReport", "[", "tests", "]"}]}]}], "Input",ExpressionUUID->\
"57222c72-daa5-0d4c-b675-a62776266e30"],

Cell["Compact summary: ", "CodeText",ExpressionUUID->"385ebe3a-0a3d-de42-869f-0a75a76a015f"],

Cell[BoxData[
 RowBox[{"testSummary", "[", 
  RowBox[{"Normal", "[", 
   RowBox[{"testResults", "[", "\"\<TestResults\>\"", "]"}], "]"}], 
  "]"}]], "Input",ExpressionUUID->"7db72865-17b3-4e4c-b42e-52e9377beb33"],

Cell["Overall pass indicator: ", "CodeText",ExpressionUUID->"f5763bcc-2d37-0441-a960-76b0e6dd1c63"],

Cell[BoxData[
 RowBox[{"<|", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"\"\<AllTestsPassed\>\"", "->", 
    RowBox[{"testResults", "[", "\"\<AllTestsSucceeded\>\"", "]"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<TestsRun\>\"", "->", 
    RowBox[{"Length", "[", 
     RowBox[{"testResults", "[", "\"\<TestResults\>\"", "]"}], "]"}]}]}], 
  "\[IndentingNewLine]", "|>"}]], "Input",ExpressionUUID->"478a9888-0545-ce4e-\
9ef7-6e64026be9ef"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"fe8c6aed-eb59-bb46-9f3c-5f4affd73fe4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12. Final Visual Dashboard", "Section",ExpressionUUID->"55a4ea22-0893-9b46-84d2-d8f6de1ba69d"],

Cell["This section produces a compact visual inspection panel. ", "Text",ExpressionUUID->"883eca49-99fa-ce4c-bb57-363f1248aadc"],

Cell[BoxData[
 RowBox[{"GraphicsGrid", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"opfSolution", "[", "x", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotLabel", "->", "\"\<Field Solution\>\""}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<\[Psi](x)\>\""}], "}"}]}]}], "]"}], 
       ",", "\[IndentingNewLine]", "      ", 
       RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", "        ", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"residualGrid", ",", "residualValues"}], "}"}], "]"}], ",",
          "\[IndentingNewLine]", "        ", 
         RowBox[{"ScalingFunctions", "->", 
          RowBox[{"{", 
           RowBox[{"None", ",", "\"\<Log\>\""}], "}"}]}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotLabel", "->", "\"\<Residual\>\""}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<|R|\>\""}], "}"}]}]}], "]"}]}], 
      "\[IndentingNewLine]", "    ", "}"}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"{", "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{"Plot", "[", "\[IndentingNewLine]", "        ", 
        RowBox[{
         RowBox[{"Evaluate", "[", 
          RowBox[{"eigenfuns", "[", 
           RowBox[{"[", 
            RowBox[{"1", " ", ";;", " ", "3"}], "]"}], "]"}], "]"}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotLabel", "->", "\"\<Eigenmodes\>\""}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"AxesLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<mode\>\""}], "}"}]}]}], "]"}], ",", 
       "\[IndentingNewLine]", "      ", 
       RowBox[{"BarChart", "[", "\[IndentingNewLine]", "        ", 
        RowBox[{
         RowBox[{"Values", "[", "measurements", "]"}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"ChartLabels", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"Keys", "[", "measurements", "]"}], ",", "Below"}], 
           "]"}]}], ",", "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
         "\[IndentingNewLine]", "        ", 
         RowBox[{"PlotLabel", "->", "\"\<Measurements\>\""}]}], "]"}]}], 
      "\[IndentingNewLine]", "    ", "}"}]}], "\[IndentingNewLine]", "  ", 
    "}"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"ImageSize", "->", "Large"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"b5c50401-6a66-7c43-9fef-fa6dc41d6c0a"],

