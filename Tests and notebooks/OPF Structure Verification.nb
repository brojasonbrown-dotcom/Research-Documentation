 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"81666335-31f5-fe4b-9478-18f5456d582c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Layer Definitions", "Section",ExpressionUUID->"f2a4ec98-f5f4-3445-9c51-5bad897ffe0e"],

Cell[TextData[{
 "Your OPF Layer 1 action is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], "\[LongEqual]", "\[Integral]", 
         RowBox[{"(", 
           RowBox[{"\[Rho]", "log", 
             RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
             SuperscriptBox[
              StyleBox["R", "TI"], "2"]}], ")"}], "\[DifferentialD]", 
         "\[CapitalOmega]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "S = \\int \\left(\\rho \\log(\\chi) + \\chi R^2\\right) \\, d\\Omega", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7354efc4-cf7f-8e4c-937b-4a7815635025"],
 "To make this computationally testable as a field theory, we use a rigorous \
reduced model in which the information field ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Psi]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\psi(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0d3e06d7-89e8-b348-a9af-9dc78444c86e"],
 " carries gradient energy and nonlinear potential terms induced by OPF \
variables."
}], "Text",ExpressionUUID->"d8f12404-17c8-4c4c-bae7-3ba7fb257595"],

Cell[TextData[{
 "We define ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Psi]", ",", 
             SuperscriptBox["\[Psi]", "\[Prime]"], ",", 
             StyleBox["x", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox["1", "2"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SuperscriptBox["\[Psi]", "\[Prime]"], "(", 
              StyleBox["x", "TI"], ")"}], ")"}], "2"], "+", "\[Rho]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "log", 
         RowBox[{"(", 
           RowBox[{"\[Chi]", "(", 
             StyleBox["x", "TI"], ")"}], ")"}], " ", "\[Psi]", 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "2"], "+", "\[Chi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         StyleBox["R", "TI"], 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "2"], " ", "\[Psi]", 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "4"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathcal{L}(\\psi, \\psi', x) = \\frac{1}{2}(\\psi'(x))^2 + \\rho(x) \
\\log(\\chi(x))\\, \\psi(x)^2 + \\chi(x) R(x)^2 \\, \\psi(x)^4", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f6ffef17-2511-aa49-93be-2d5bed6f5bf0"],
 "This yields a real Euler\[Dash]Lagrange equation and still respects your \
Layer 1 variable structure. "
}], "Text",ExpressionUUID->"775296f8-d9fd-624a-8e1a-e3f483bc595a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "x", ",", "psi", ",", "rho", ",", "chi", ",", "res", ",", "lagrangian"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lagrangian", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"psi", "[", "x", "]"}], ",", "x"}], "]"}], "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{"rho", "[", "x", "]"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"chi", "[", "x", "]"}], "]"}], " ", 
     RowBox[{
      RowBox[{"psi", "[", "x", "]"}], "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{"chi", "[", "x", "]"}], " ", 
     RowBox[{
      RowBox[{"res", "[", "x", "]"}], "^", "2"}], " ", 
     RowBox[{
      RowBox[{"psi", "[", "x", "]"}], "^", "4"}]}]}]}], ";"}]}], "Input",Expre\
ssionUUID->"e82d7d25-78b1-f942-a5a9-2b0fe7964c0a"],

Cell["Derive the Euler\[Dash]Lagrange equation symbolically. ", "Text",ExpressionUUID->"d74bd29a-5eb2-384a-81b6-6ce325ec9413"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "eulerEq", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"eulerEq", "=", 
  RowBox[{"FullSimplify", " ", "@", " ", 
   RowBox[{
    RowBox[{"EulerEquations", "[", 
     RowBox[{"lagrangian", ",", 
      RowBox[{"psi", "[", "x", "]"}], ",", "x"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]}], "Input",ExpressionUUID->"db7f5d58-\
5856-f24d-bc5e-14064c94add9"],

Cell[TextData[{
 "Expected form: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         SuperscriptBox["\[Psi]", "\[Prime]\[Prime]"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", "2", "\[Rho]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "log", 
         RowBox[{"(", 
           RowBox[{"\[Chi]", "(", 
             StyleBox["x", "TI"], ")"}], ")"}], "\[Psi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", "4", "\[Chi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         StyleBox["R", "TI"], 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "2"], "\[Psi]", 
         SuperscriptBox[
          RowBox[{"(", 
            StyleBox["x", "TI"], ")"}], "3"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "-\\psi''(x) + 2\\rho(x)\\log(\\chi(x))\\psi(x) + \
4\\chi(x)R(x)^2\\psi(x)^3 = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "43caa716-c1ea-ed4d-a6ee-8e7ee9c22a79"]
}], "Text",ExpressionUUID->"b24a9c91-8acf-5442-8540-3edd6ca89e69"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"dd4666e3-9324-8f48-ada6-06d86c049b59"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Concrete Test Model", "Section",ExpressionUUID->"c8f4db9b-bf0b-134f-ab31-eaf31284f134"],

Cell[TextData[{
 "For a real complete test, we must fully specify ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Rho]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dc37ecbe-462f-434e-882e-428c2c2e7863"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Chi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\chi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b83bbf7f-0b53-4f4e-aedb-ef9b93293644"],
 ", and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b6a86b39-b56f-5846-84f5-fb1e0d2073cd"],
 "."
}], "Text",ExpressionUUID->"1e24ed4c-f9c1-9b4e-bd67-dd3bf6f93ffe"],

Cell[TextData[{
 "We choose smooth positive fields so that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"log", "(", "\[Chi]", ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\log(\\chi)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e28fac5e-3c8c-eb42-b670-774190c0eae0"],
 " is well-defined and the PDE is well-posed. "
}], "Text",ExpressionUUID->"8d41bcff-4699-4242-b7a1-315c8e1bf9eb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"rhoFun", ",", "chiFun", ",", "resFun"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhoFun", "[", "x_", "]"}], ":=", 
   RowBox[{"1", "+", 
    RowBox[{"x", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"chiFun", "[", "x_", "]"}], ":=", 
   RowBox[{"2", "+", 
    RowBox[{"x", "/", "5"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"resFun", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"3", "/", "2"}], "+", 
    RowBox[{
     RowBox[{"x", "^", "2"}], "/", "10"}]}]}], ";"}]}], "Input",ExpressionUUID\
->"1b641c1c-8193-cc45-8285-6b9a9a0c80f1"],

Cell["Substitute these into the symbolic field equation. ", "Text",ExpressionUUID->"14236493-571c-3345-9564-a7b538e620d5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "fieldEq", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"fieldEq", "=", 
  RowBox[{
   RowBox[{"eulerEq", " ", "/.", " ", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"rho", "->", "rhoFun"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"chi", "->", "chiFun"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"res", "->", "resFun"}]}], "\[IndentingNewLine]", "}"}]}], " ", 
   "//", " ", "FullSimplify"}]}]}], "Input",ExpressionUUID->"6fe06ce0-55c0-\
5349-8b49-4cdf4ac1dedb"],

Cell[TextData[{
 "We solve the boundary-value problem on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "\[Element]", 
         RowBox[{"[", 
           RowBox[{"0", ",", "1"}], "]"}]}], TraditionalForm], "errors" -> {},
      "input" -> "x \\in [0,1]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "31d73d31-23e8-ab45-8c17-ec88fbea476a"],
 " with physical boundary conditions ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Psi]", 
         RowBox[{"(", "0", ")"}], "\[LongEqual]", "0", ",  ", "\[Psi]", 
         RowBox[{"(", "1", ")"}], "\[LongEqual]", 
         FractionBox["1", "10"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\psi(0) = 0, \\quad \\psi(1) = \\frac{1}{10}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d65b7f67-4f37-ef46-86d9-ff4951d7af72"]
}], "Text",ExpressionUUID->"0cc14a88-ee11-514b-86a9-d5bbdc7f97c7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"domain", ",", "bcs"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"domain", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bcs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"psi", "[", "0", "]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{"psi", "[", "1", "]"}], "==", 
      RowBox[{"1", "/", "10"}]}]}], "}"}]}], ";"}]}], "Input",ExpressionUUID->\
"8aaf21d6-cf34-eb47-ba9b-af1572691403"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"aafdf2c8-b188-d24e-a64a-538026add3e2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. High-Precision Numerical Solve", "Section",ExpressionUUID->"579d127f-3e8b-7946-bf11-417fef064611"],

Cell[TextData[{
 StyleBox["Important rigor note:",
  FontWeight->Bold],
 " exact infinite working precision is not available for practical numerical \
solving. A rigorous computational substitute is to use ",
 StyleBox["arbitrarily high finite precision",
  FontWeight->Bold],
 " and then certify convergence and residual reduction. "
}], "Text",ExpressionUUID->"8f3ff720-9f3f-8c42-b043-3075265c1d6d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "opfSolution", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"opfSolution", "=", 
   RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fieldEq", "==", "0"}], ",", "bcs"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", "psi", ",", "\[IndentingNewLine]", "  ", 
     "domain", ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"WorkingPrecision", "->", "80"}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"PrecisionGoal", "->", "40"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"AccuracyGoal", "->", "40"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<BoundaryValues\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<Shooting\>\"", ",", 
          RowBox[{"\"\<StartingInitialConditions\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"psi", "[", "0", "]"}], "==", "0"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"psi", "'"}], "[", "0", "]"}], "==", 
              RowBox[{"1", "/", "10"}]}]}], "}"}]}]}], "}"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"ad04d28f-b2e5-0b49-b53c-506ee258f34f"],

Cell["Visualize the field. ", "Text",ExpressionUUID->"d5275c89-4966-7448-b4ff-391379dd21ac"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"opfSolution", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{
   "PlotLabel", "->", "\"\<OPF Layer 1 Field Solution \[Psi](x)\>\""}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<\[Psi](x)\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", " ", 
   RowBox[{"ImageSize", "->", "Large"}]}], "]"}]], "Input",ExpressionUUID->\
"8c08c1f9-48d9-9f48-99ff-7d06073573b3"],

