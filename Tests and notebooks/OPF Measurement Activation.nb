Cell[CellGroupData[{

Cell["12. Numerical test structures", "Section",ExpressionUUID->"fa3b5ffd-f138-8c40-9665-ad824c39ec0d"],

Cell["\<\
For practical predictive testing, exact symbolic work should be followed by \
numerical experiments. \
\>", "Text",ExpressionUUID->"34fa2d0f-c3c7-514c-8ce8-d7e8906a3d64"],

Cell[CellGroupData[{

Cell["12.1 1D activation PDE prototype", "Subsection",ExpressionUUID->"a087e327-e243-1649-8d06-024cfffeef24"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"uLatentSol", ",", "uObsSol", ",", "sol1D"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"paramsNum", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalGamma]", "->", "0.4"}], ",", 
     RowBox[{"\[Kappa]", "->", "1.2"}], ",", 
     RowBox[{"\[Sigma]", "->", "0.1"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Rnum", "=", "1.0"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sol1D", "=", 
    RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", "   ", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"uLatent", "[", 
             RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "==", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"uLatent", "[", 
             RowBox[{"t", ",", "x"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "   ", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"uObs", "[", 
              RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "+", 
           RowBox[{"\[CapitalGamma]", " ", 
            RowBox[{"uObs", "[", 
             RowBox[{"t", ",", "x"}], "]"}]}]}], "==", "\[IndentingNewLine]", 
          "    ", 
          RowBox[{"\[Kappa]", " ", 
           RowBox[{"UnitStep", "[", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"uLatent", "[", 
               RowBox[{"t", ",", "x"}], "]"}], "]"}], "-", 
             RowBox[{"\[Sigma]r", "[", "Rnum", "]"}]}], "]"}], " ", 
           RowBox[{"uLatent", "[", 
            RowBox[{"t", ",", "x"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
         "   ", 
         RowBox[{
          RowBox[{"uLatent", "[", 
           RowBox[{"0", ",", "x"}], "]"}], "==", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "20"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", "-", 
               RowBox[{"1", "/", "2"}]}], ")"}], "^", "2"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "   ", 
         RowBox[{
          RowBox[{"uObs", "[", 
           RowBox[{"0", ",", "x"}], "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", "   ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"0", ",", "1"}], "]"}], "[", "uLatent", "]"}], "[", 
           RowBox[{"t", ",", "0"}], "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", "   ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"0", ",", "1"}], "]"}], "[", "uLatent", "]"}], "[", 
           RowBox[{"t", ",", "1"}], "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", "   ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"0", ",", "1"}], "]"}], "[", "uObs", "]"}], "[", 
           RowBox[{"t", ",", "0"}], "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", "   ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"0", ",", "1"}], "]"}], "[", "uObs", "]"}], "[", 
           RowBox[{"t", ",", "1"}], "]"}], "==", "0"}]}], 
        "\[IndentingNewLine]", "  ", "}"}], " ", "/.", " ", "paramsNum"}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"{", 
       RowBox[{"uLatent", ",", "uObs"}], "}"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "say", "[", "\"\<Computed 1D latent/observed activation PDE solution.\>\"", 
   "]"}], ";"}]}], "Input",ExpressionUUID->"fd0b6036-99b4-9742-9eb1-\
bd735edccc59"]
}, Open  ]],

