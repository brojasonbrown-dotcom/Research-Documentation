Cell[CellGroupData[{

Cell["\<\
9. Double-slit analogy: measurement changes interference structure\
\>", "Section",ExpressionUUID->"e1ce4452-f807-6049-830a-73393575b76e"],

Cell[TextData[{
 "The most rigorous use here is ",
 StyleBox["comparative phenomenology",
  FontWeight->Bold],
 "."
}], "Text",ExpressionUUID->"414a0059-9929-5c42-810d-5880d4ddc8be"],

Cell["A double-slit experiment shows: ", "Text",ExpressionUUID->"0146194b-0561-ce41-b270-63347405a006"],

Cell["unmeasured path information allows interference", "Item",ExpressionUUID->"c6a8c8a1-196d-c141-9f92-3673f6b3b5a2"],

Cell["path measurement suppresses interference visibility", "Item",ExpressionUUID->"04bc58e1-555c-dc45-b8a5-19ff7754f4da"],

Cell["\<\
That maps naturally to a decoherence operator, not necessarily to universal \
spacetime creation. \
\>", "Text",ExpressionUUID->"87988d69-04d2-f543-981f-313e23b11964"],

Cell[CellGroupData[{

Cell["9.1 Two-path amplitude model", "Subsection",ExpressionUUID->"b74b1d88-3406-4143-b557-9830e9bc053a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "\[Psi]1", ",", "\[Psi]2", ",", "\[Psi]Tot", ",", "intensityUnmeasured", ",",
      "intensityMeasured"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]1", "[", "x_", "]"}], ":=", 
   RowBox[{"a1", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", 
      RowBox[{"\[Phi]1", "[", "x", "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]2", "[", "x_", "]"}], ":=", 
   RowBox[{"a2", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", 
      RowBox[{"\[Phi]2", "[", "x", "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Psi]Tot", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"\[Psi]1", "[", "x", "]"}], "+", 
     RowBox[{"\[Psi]2", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"intensityUnmeasured", "[", "x_", "]"}], ":=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"ComplexExpand", "[", 
     RowBox[{
      RowBox[{"Conjugate", "[", 
       RowBox[{"\[Psi]Tot", "[", "x", "]"}], "]"}], " ", 
      RowBox[{"\[Psi]Tot", "[", "x", "]"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"intensityMeasured", "[", "x_", "]"}], ":=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Conjugate", "[", 
         RowBox[{"\[Psi]1", "[", "x", "]"}], "]"}], " ", 
        RowBox[{"\[Psi]1", "[", "x", "]"}]}], "+", 
       RowBox[{
        RowBox[{"Conjugate", "[", 
         RowBox[{"\[Psi]2", "[", "x", "]"}], "]"}], " ", 
        RowBox[{"\[Psi]2", "[", "x", "]"}]}]}], "]"}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"visibilityDifference", "[", "x_", "]"}], ":=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"intensityUnmeasured", "[", "x", "]"}], "-", 
     RowBox[{"intensityMeasured", "[", "x", "]"}]}], "]"}]}], ";"}]}], "Input",\
ExpressionUUID->"d2b1df83-df14-fd43-8d6c-eeb5cf86a250"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.2 Interpretation", "Subsection",ExpressionUUID->"bd074111-7463-494d-96cc-c92bc8e92533"],

Cell[TextData[{
 Cell[BoxData[Cell["intensityUnmeasured",
   Background->None,ExpressionUUID->"5e1d0f32-0901-fb42-82cf-941f59ee258c"]], 
  "InlineCode",ExpressionUUID->"4db1533e-3630-a743-b19e-f2f3ad2a2342"],
 " contains interference cross-terms"
}], "Item",ExpressionUUID->"b38c108c-57c0-af48-8455-8a8d2041cab0"],

Cell[TextData[{
 Cell[BoxData[Cell["intensityMeasured",
   Background->None,ExpressionUUID->"91e20d08-563f-e14b-83c8-6c710e03ecaa"]], 
  "InlineCode",ExpressionUUID->"f6711396-53c1-f54d-be53-e6b065728df2"],
 " removes them"
}], "Item",ExpressionUUID->"6aea0684-5149-9047-afe8-3c4758fa4cfd"],

Cell["\<\
the difference isolates coherence information lost under measurement\
\>", "Item",ExpressionUUID->"0370bbae-a0fb-744c-afe1-57b7b20bfd96"],

Cell["This is the correct rigorous comparison structure. ", "Text",ExpressionUUID->"e0572209-8a95-564d-b6b9-88ca43ef371f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.3 Relative scale interpretation", "Subsection",ExpressionUUID->"f71aefab-ca58-ff4b-ac4a-def61fc8009e"],

Cell["Measurement strength can be made resolution-dependent: ", "CodeText",ExpressionUUID->"d0347eaf-cdfb-5a40-b61b-60b425a21116"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "coherenceWeight", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"coherenceWeight", "[", "R_", "]"}], ":=", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "\[Eta]"}], "/", "R"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"intensityPartialMeasurement", "[", "R_", "]"}], "[", "x_", "]"}],
    ":=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"Conjugate", "[", 
       RowBox[{"\[Psi]1", "[", "x", "]"}], "]"}], " ", 
      RowBox[{"\[Psi]1", "[", "x", "]"}]}], "+", 
     RowBox[{
      RowBox[{"Conjugate", "[", 
       RowBox[{"\[Psi]2", "[", "x", "]"}], "]"}], " ", 
      RowBox[{"\[Psi]2", "[", "x", "]"}]}], "+", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"coherenceWeight", "[", "R", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", 
          RowBox[{"\[Psi]1", "[", "x", "]"}], "]"}], " ", 
         RowBox[{"\[Psi]2", "[", "x", "]"}]}], "+", 
        RowBox[{
         RowBox[{"Conjugate", "[", 
          RowBox[{"\[Psi]2", "[", "x", "]"}], "]"}], " ", 
         RowBox[{"\[Psi]1", "[", "x", "]"}]}]}], ")"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"2416f9fd-b648-9d4e-98ac-1cc95ecf53cc"],

Cell["This is a rigorous scale-relative interpolation model. ", "Text",ExpressionUUID->"5906fe13-eaa8-dd42-8f37-0a788cf8595c"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"27fef4cb-f226-1b42-9408-4440b17b9035"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Operator ordering and correct insertion of values", "Section",ExpressionUUID->"ad378008-2111-2046-9c73-b1fa776f2b6e"],

Cell["\<\
To test rigorously, values must be inserted in the right order. \
\>", "Text",ExpressionUUID->"8e1f8e4d-eea2-d040-b654-0d2ded70f951"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Correct order", "Section",ExpressionUUID->"8ebd68c1-25dd-9346-8a61-abc9153de9a4"],

Cell["1. define symbolic latent action", "Text",ExpressionUUID->"3c800629-589f-7c40-aa69-958cee5850bd"],

Cell["2. derive exact Euler\[Dash]Lagrange equations", "Text",ExpressionUUID->"fc1a2b19-2c43-ee49-bbeb-d19b702916e1"],

Cell["3. define activation operator separately", "Text",ExpressionUUID->"b3d0e22d-f343-2446-a5fc-1d7addac1770"],

Cell["4. classify stationary latent backgrounds", "Text",ExpressionUUID->"1c54f0f9-5405-c44d-bb80-025e611170c0"],

Cell["5. linearize about admissible backgrounds", "Text",ExpressionUUID->"8beec05d-9a40-484b-90a9-834adb815a69"],

Cell["6. only then insert parameter values", "Text",ExpressionUUID->"e167c7e8-e3d1-cf4e-aede-da4c4cb2ee14"],

Cell["7. test residuals after substitution", "Text",ExpressionUUID->"ef37e94e-b074-6a49-bc1e-6898d2efe467"],

Cell["8. compare multiple numerical implementations ", "Text",ExpressionUUID->"d18fd2f5-6a9a-834d-b3eb-8210d0051e1d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Incorrect order", "Section",ExpressionUUID->"44b3b1fc-50a7-804b-a562-97561bf43c90"],

Cell["\<\
inserting numerical values before derivation if exact structure is needed\
\>", "Item",ExpressionUUID->"21c82d82-81ba-5f4f-b78c-0298a27a8d59"],

Cell["\<\
mixing postulated measurement equations into the latent action without saying \
so\
\>", "Item",ExpressionUUID->"77cad3d4-6513-0045-9580-702a97eff2e2"],

Cell["\<\
interpreting every thresholded update as variationally derived\
\>", "Item",ExpressionUUID->"e6eb7671-4f8c-f149-910e-53b52c6adb4c"],

Cell["\<\
claiming emergence from measurement without distinguishing analogy from \
derivation\
\>", "Item",ExpressionUUID->"864e895c-87f7-bc40-a391-e6a1d1351c5f"],

Cell[CellGroupData[{

Cell["Formal insertion template", "Subsection",ExpressionUUID->"09e02edf-8007-8247-af06-cb29d9bbd4a0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "parameterSet", ",", "backgroundSet", ",", "applyParameters", ",", 
     "applyBackground"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"parameterSet", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\[Alpha]", "->", "1"}], ",", 
      RowBox[{"\[Beta]", "->", "1"}], ",", 
      RowBox[{"\[Mu]", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\[CapitalGamma]", "->", "0.1"}], ",", 
      RowBox[{"\[Kappa]", "->", "1"}], ",", 
      RowBox[{"\[Lambda]", "->", "1"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\[Sigma]", "->", "0.2"}], ",", 
      RowBox[{"\[Eta]", "->", "0.3"}]}], "\[IndentingNewLine]", "|>"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"backgroundSet", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
