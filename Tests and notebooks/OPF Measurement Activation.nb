   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"de147d52-96ce-b247-8ba6-18fcd4091c3c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. A rigorous OPF activation equation", "Section",ExpressionUUID->"657bc721-4948-4b4b-85aa-430fbb280e53"],

Cell["\<\
A mathematically testable version is to let the latent field obey one \
equation and the observed field obey a measurement-coupled equation.\
\>", "Text",ExpressionUUID->"0d26d2ee-53c7-3d46-a6ce-0d7fd0f17486"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalPsi]", 
        StyleBox["L", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Psi_L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e0137efb-cbf2-9b48-9c14-ec23f5ed5a01"],
 " be latent and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalPsi]", 
        StyleBox["O", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Psi_O", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a3fac1e5-2a66-394d-9c9d-5b04eaaaae89"],
 " observed. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["t", "TI"]], 
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["O", "TI"]], "+", 
         SubscriptBox["\[CapitalGamma]\[CapitalPsi]", 
          StyleBox["O", "TI"]], "\[LongEqual]", "\[Kappa] ", 
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["R", "TI"]], 
         RowBox[{"[", 
           SubscriptBox["\[CapitalPsi]", 
            StyleBox["L", "TI"]], "]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\partial_t \\Psi_O + \\Gamma \\Psi_O = \
\\kappa\\,\\mathcal{M}_R[\\Psi_L]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d5d6f82f-5ddd-fa49-9164-d266f7e7f020"],
 "This says: "
}], "Text",ExpressionUUID->"c8fe3277-3d7f-2043-8fcd-01a68e20bcfa"],

Cell["latent field exists as potential", "Item",ExpressionUUID->"6424b0f6-0b51-b04b-be92-de874e95d256"],

Cell["measurement produces an activated source", "Item",ExpressionUUID->"3d5e65f7-75e1-874b-bab8-5d7851af30a6"],

Cell[CellGroupData[{

Cell[TextData[{
 "stabilization occurs through the persistence term ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalGamma]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Gamma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bb5528ab-2084-9e4c-92fb-9277f8795fc0"]
}], "Item",ExpressionUUID->"4b169312-dcfd-ba4f-853d-ef92e136d548"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "\[Psi]L", ",", "\[Psi]O", ",", "measurementKernelR", ",", 
     "activationEquation"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"measurementKernelR", "[", "R_", "]"}], "[", "\[Psi]_", "]"}], ":=", 
    RowBox[{
     RowBox[{"resolutionThresholdActivation", "[", "R", "]"}], "[", "\[Psi]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"activationEquation", "[", "R_", "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"\[Psi]O", "[", 
        RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "t"}], "]"}],
      "+", 
     RowBox[{"\[CapitalGamma]", " ", 
      RowBox[{"\[Psi]O", "[", 
       RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}]}], "==", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{"\[Kappa]", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"measurementKernelR", "[", "R", "]"}], "[", "\[Psi]L", "]"}], "[", 
      RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}]}]}], 
  ";"}]}], "Input",ExpressionUUID->"182ec0a4-474d-d740-aeb1-584cadb30755"]
}, Open  ]],

Cell["This is a valid modern hybrid field equation template. ", "Text",ExpressionUUID->"4d1018a9-63de-e44d-a550-60724c17a1e3"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"8519b13b-d48b-8044-a598-56dcee5a0cbf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Recovering spacetime stabilization", "Section",ExpressionUUID->"40926758-ff27-2d40-a53c-132721731b48"],

Cell[TextData[{
 "If \[OpenCurlyDoubleQuote]observation stabilizes spacetime\
\[CloseCurlyDoubleQuote] means measured observables persist, then a minimal \
rule is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["t", "TI"]], 
         StyleBox["g", "TI"], "+", 
         SubscriptBox["\[CapitalGamma]", 
          StyleBox["g", "TI"]], 
         StyleBox["g", "TI"], "\[LongEqual]", 
         StyleBox["F", "TI"], 
         RowBox[{"(", 
           SubscriptBox["\[CapitalPsi]", 
            StyleBox["O", "TI"]], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\partial_t g + \\Gamma_g g = F(\\Psi_O)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "257c3cf8-c650-9c4e-8f7e-4f0038aa9f42"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["g", "TI"], TraditionalForm], "errors" -> {}, "input" -> "g", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "01b176a4-c0bc-de4b-85e6-ee079c6c3872"],
 " is some effective spacetime descriptor or geometric observable. "
}], "Text",ExpressionUUID->"5bc160c1-1275-7b4f-aef7-6212bf0b55b0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"g", ",", "geometryActivationEquation"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"geometryActivationEquation", "[", "R_", "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "t"}], "]"}],
      "+", 
     RowBox[{"\[CapitalGamma]", " ", 
      RowBox[{"g", "[", 
       RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}]}], "==", 
    RowBox[{"\[Lambda]", " ", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"\[Psi]O", "[", 
        RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "]"}], "^", 
      "2"}]}]}]}], ";"}]}], "Input",ExpressionUUID->"c9c5b6d9-f171-1249-9314-\
2046be43bdc3"],

Cell[TextData[{
 "This does ",
 StyleBox["not",
  FontWeight->Bold],
 " prove spacetime literally emerges from measurement, but it gives a \
rigorous testable mathematical implementation of that postulate. "
}], "Text",ExpressionUUID->"ab580717-3759-e041-8bf2-2855c826060a"],

Cell[BoxData[
 TagBox[GridBox[{
