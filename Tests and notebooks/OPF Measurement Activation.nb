Cell[CellGroupData[{

Cell["13. Relative findings to document rigorously", "Section",ExpressionUUID->"ea967e8e-1c18-c64b-8d2a-962ec2d6eb57"],

Cell[TextData[{
 "This section separates ",
 StyleBox["supported",
  FontWeight->Bold],
 ", ",
 StyleBox["analogical",
  FontWeight->Bold],
 ", and ",
 StyleBox["unsupported",
  FontWeight->Bold],
 " claims. "
}], "Text",ExpressionUUID->"1800267e-35f4-a54e-a739-41b953f9edf0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"relativeFindings", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<SupportedByModelStructure\>\"", "->", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<A latent field sector can be defined independently of \
observed sector equations.\>\"", ",", "\[IndentingNewLine]", 
         "    ", "\"\<Observation can be modeled as projection, damping, \
event update, source activation, or thresholding.\>\"", ",", 
         "\[IndentingNewLine]", 
         "    ", "\"\<Measurement-induced suppression of interference is \
naturally represented by decoherence-weighted cross-terms.\>\"", ",", 
         "\[IndentingNewLine]", 
         "    ", "\"\<Persistent observed sectors can be modeled by \
first-order stabilization equations.\>\""}], "\[IndentingNewLine]", "  ", 
        "}"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<AnalogicalButNotDerived\>\"", "->", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<Universe formation from immeasurable substrate to \
measurable spacetime.\>\"", ",", "\[IndentingNewLine]", 
         "    ", "\"\<Spacetime itself emerging from mention/observation.\>\"",
          ",", "\[IndentingNewLine]", 
         "    ", "\"\<Layer-0 timeless potential as literal physical \
pre-universe ontology.\>\""}], "\[IndentingNewLine]", "  ", "}"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<UnsupportedWithoutAdditionalPhysics\>\"", "->", 
       RowBox[{"{", "\[IndentingNewLine]", "    ", 
        RowBox[{"\"\<That measurement alone creates the universe.\>\"", ",", 
         "\[IndentingNewLine]", 
         "    ", "\"\<That double-slit path measurement directly proves \
spacetime activation.\>\"", ",", "\[IndentingNewLine]", 
         "    ", "\"\<That the proposed activation law is unique or \
fundamental.\>\""}], "\[IndentingNewLine]", "  ", "}"}]}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Dataset", "[", "relativeFindings", "]"}], "]"}], ";"}]}], "Input",\
ExpressionUUID->"1d48026e-b6e3-7147-b7a5-5b25e477bb67"],

