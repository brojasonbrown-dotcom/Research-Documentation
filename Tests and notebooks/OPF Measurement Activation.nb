ressionUUID->"83557098-33df-b344-a036-bab26c8af43d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["B. Linearization tests", "Subsection",ExpressionUUID->"22ecbb25-9fa4-b040-917b-671de7315f41"],

Cell["\<\
Linearize latent equations and activation equation around a chosen \
background. \
\>", "Text",ExpressionUUID->"8f3d17a8-844d-6b40-83be-c17aec0818e6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"linRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\[Rho]", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"\[CurlyEpsilon]", " ", 
          RowBox[{"u\[Rho]", "[", 
           RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}], 
        "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\[Chi]", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"1", "+", 
          RowBox[{"\[CurlyEpsilon]", " ", 
           RowBox[{"u\[Chi]", "[", 
            RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}]}], 
        "]"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"r", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"\[CurlyEpsilon]", " ", 
          RowBox[{"ur", "[", 
           RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "]"}]}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"linearizedLatent", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"Coefficient", "[", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"subtractSides", " ", "/@", " ", "eulerLatent"}], " ", "/.",
           " ", "linRules"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[CurlyEpsilon]", ",", "0", ",", "1"}], "}"}]}], "]"}], 
       "]"}], ",", "\[CurlyEpsilon]"}], "]"}], " ", "//", " ", 
    "FullSimplify"}]}], ";"}]}], "Input",ExpressionUUID->"18441755-842c-c04e-\
9387-06fb329f32b3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["C. Modal tests", "Subsection",ExpressionUUID->"fef271f0-278c-ac4a-b8b5-08b8cff15e8d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"planeRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"u\[Rho]", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"a\[Rho]", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "xx"}], "+", 
              RowBox[{"ky", " ", "yy"}], "+", 
              RowBox[{"kz", " ", "zz"}], "-", 
              RowBox[{"\[Omega]", " ", "tt"}]}], ")"}]}], "]"}]}]}], "]"}]}], 
      ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"u\[Chi]", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"a\[Chi]", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "xx"}], "+", 
              RowBox[{"ky", " ", "yy"}], "+", 
              RowBox[{"kz", " ", "zz"}], "-", 
              RowBox[{"\[Omega]", " ", "tt"}]}], ")"}]}], "]"}]}]}], "]"}]}], 
      ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"ur", "->", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"tt", ",", "xx", ",", "yy", ",", "zz"}], "}"}], ",", 
         RowBox[{"ar", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "xx"}], "+", 
              RowBox[{"ky", " ", "yy"}], "+", 
              RowBox[{"kz", " ", "zz"}], "-", 
              RowBox[{"\[Omega]", " ", "tt"}]}], ")"}]}], "]"}]}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"modalSystem", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"linearizedLatent", " ", "/.", " ", "planeRules"}], ")"}], "/", 
     RowBox[{"Exp", "[", 
      RowBox[{"I", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"kx", " ", "x"}], "+", 
         RowBox[{"ky", " ", "y"}], "+", 
         RowBox[{"kz", " ", "z"}], "-", 
         RowBox[{"\[Omega]", " ", "t"}]}], ")"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"modalMatrix", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{"#", ",", 
       RowBox[{"{", 
        RowBox[{"a\[Rho]", ",", "a\[Chi]", ",", "ar"}], "}"}]}], "]"}], " ", 
     "&"}], " ", "/@", " ", "modalSystem"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dispersionDet", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Det", "[", "modalMatrix", "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Dispersion determinant: \>\"", ",", "dispersionDet"}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"e51c4ede-cf60-a845-888e-55e588346701"]
}, Open  ]],

Cell[CellGroupData[{

Cell["D. Stability tests", "Subsection",ExpressionUUID->"c6128839-4166-cd4d-ae7a-1527e1c0dca1"],

