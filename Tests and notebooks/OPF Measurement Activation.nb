Cell[CellGroupData[{

Cell["1. Initialization", "Section",ExpressionUUID->"49015ded-1457-894d-b5b7-65ab8bdeb40f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Needs", "[", "\"\<VariationalMethods`\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$HistoryLength", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Alpha]", ",", "\[Beta]", ",", "\[Mu]", ",", "\[CapitalGamma]", ",",
          "\[Sigma]", ",", "\[Eta]", ",", "\[Kappa]", ",", "\[Lambda]", ",", 
         "\[Omega]", ",", "kx", ",", "ky", ",", "kz", ",", 
         "\[CurlyEpsilon]"}], "}"}], ",", "Reals"}], "]"}], "&&", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\[Alpha]", ">", "0"}], "&&", 
     RowBox[{"\[Beta]", ">", "0"}], "&&", 
     RowBox[{"\[Mu]", ">", "0"}], "&&", 
     RowBox[{"\[CapitalGamma]", ">=", "0"}], "&&", 
     RowBox[{"\[Sigma]", ">=", "0"}], "&&", 
     RowBox[{"\[Eta]", ">=", "0"}], "&&", 
     RowBox[{"\[Kappa]", ">=", "0"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords4", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spatialCoords", "=", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"say", "[", "msg_", "]"}], ":=", 
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{"msg", ",", "14", ",", "Bold", ",", 
      RowBox[{"Darker", "[", "Blue", "]"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pass", "[", "msg_", "]"}], ":=", 
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"\"\<PASS: \>\"", " ", "<>", " ", "msg"}], ",", 
      RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fail", "[", "msg_", "]"}], ":=", 
   RowBox[{"Print", "[", 
    RowBox[{"Style", "[", 
     RowBox[{
      RowBox[{"\"\<FAIL: \>\"", " ", "<>", " ", "msg"}], ",", "Red"}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"warn", "[", "msg_", "]"}], ":=", 
    RowBox[{"Print", "[", 
     RowBox[{"Style", "[", 
      RowBox[{
       RowBox[{"\"\<WARN: \>\"", " ", "<>", " ", "msg"}], ",", 
       RowBox[{"Darker", "[", "Orange", "]"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"subtractSides", "[", "eq_Equal", "]"}], ":=", 
   RowBox[{
    RowBox[{"eq", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "-", 
    RowBox[{"eq", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}]}], "Input",ExpressionUUID->\
