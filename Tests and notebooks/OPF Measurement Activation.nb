Cell[CellGroupData[{

Cell["3. The operator for \[OpenCurlyDoubleQuote]true zero as unmeasured \
potential\[CloseCurlyDoubleQuote]", "Section",ExpressionUUID->"c74b25f3-3237-\
be42-bc57-cb395d8b2d64"],

Cell[TextData[{
 "The cleanest rigorous way to encode your idea is ",
 StyleBox["not",
  FontWeight->Bold],
 " to say that the field is numerically zero."
}], "Text",ExpressionUUID->"103da1a9-6747-7b42-a75a-9e5ff650797e"],

Cell["Instead define: ", "Text",ExpressionUUID->"dd3f1aed-0d36-c44c-bf88-3c27bae67685"],

Cell[TextData[{
 "a latent state ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[CapitalPsi]", 
        StyleBox["L", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\Psi_L", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2ad3cd78-1bad-2942-8aad-c29aa24cb4b9"]
}], "Item",ExpressionUUID->"e6262f4d-05dd-dd4f-ae0f-6ea42213b745"],

Cell[TextData[{
 "a measurement activation operator ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["M", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{M}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "53cbf2c9-0fdb-1346-a518-ece7a0b6be62"]
}], "Item",ExpressionUUID->"b11ab04b-f916-db4b-8e10-ed3edbca840c"],

Cell[TextData[{
 "a stabilization operator ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["S", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{S}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4df6a851-78bd-a54f-8ab5-018e1c8f52f7"]
}], "Item",ExpressionUUID->"6e18defe-4f16-1a4a-a593-9ec7f509c196"],

Cell[TextData[{
 "with composition ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", "obs"], "\[LongEqual]", 
         StyleBox["S", "TI"], "\[EmptySmallCircle]", 
         StyleBox["M", "TI"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox["\[CapitalPsi]", 
              StyleBox["L", "TI"]], ";", 
             StyleBox["O", "TI"], ",", 
             StyleBox["R", "TI"]}], "]"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\Psi_{\\text{obs}} = \\mathcal{S} \\circ \\mathcal{M}[\\Psi_L; O, R]", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8d1d3019-a69f-fa4f-a22b-6aec682bc933"],
 "where: "
}], "Text",ExpressionUUID->"3601a11c-444c-4146-b426-5c6928d4c1c1"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["O", "TI"], TraditionalForm], "errors" -> {}, "input" -> "O", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "39e37c9c-0772-3346-995e-994effcd8b12"],
 " is the observation protocol / observable"
}], "Item",ExpressionUUID->"fb382ddc-cf40-1b40-b31b-4ea91698f014"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b99441c0-de28-2f4a-9c7a-527b4d0d7a60"],
 " is the measurement resolution scale"
}], "Item",ExpressionUUID->"bbf16563-303c-4441-b5f5-4c194e41c4cf"],

Cell[CellGroupData[{

Cell["3.1 Symbolic operator definitions", "Subsection",ExpressionUUID->"08289935-9ca5-e949-ad3f-cc367b2fe2c3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "latentState", ",", "measurementActivation", ",", "stabilizationOperator",
      ",", "observedState"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"latentState", "[", 
     RowBox[{"t_", ",", "x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
    RowBox[{"\[CapitalPsi]L", "[", 
     RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"measurementActivation", "[", 
     RowBox[{"\[Psi]_", ",", "obsKernel_", ",", "resolution_"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"obsKernel", "[", "resolution", "]"}], "[", "\[Psi]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stabilizationOperator", "[", "\[Psi]_", "]"}], ":=", 
    RowBox[{"FixedPoint", "[", 
     RowBox[{"stabilizeStep", ",", "\[Psi]", ",", "12"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"observedState", "[", 
    RowBox[{"\[Psi]_", ",", "obsKernel_", ",", "resolution_"}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"stabilizationOperator", " ", "@", " ", 
    RowBox[{"measurementActivation", "[", 
     RowBox[{"\[Psi]", ",", "obsKernel", ",", "resolution"}], "]"}]}]}], 
  ";"}]}], "Input",ExpressionUUID->"db98d707-269c-774d-8dab-7fb9c85a69d2"],

Cell["\<\
This is only a framework until we specify the actual activation law. \
\>", "Text",ExpressionUUID->"db2d4328-8ee7-d741-8bf2-2b63237c92f3"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
