Cell[CellGroupData[{

Cell["0. Core methodological warning", "Section",ExpressionUUID->"cb8808b2-41db-2043-b318-7bec2330802a"],

Cell["Your proposed rule ", "Text",ExpressionUUID->"83c04bda-0d98-e241-956e-2288768522a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"opfUnmapped", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<incommensurate measurement activation\>\"", "->", 
     "\[IndentingNewLine]", 
     "    ", "\"\<The 'if not measured requires measurement' rule is not in \
the Lagrangian. \\\n     It would need an event-driven field update operator; \
\\\n     no standard PDE framework has one.\>\""}], "\[IndentingNewLine]", 
    "|>"}]}], ";"}]], "Input",ExpressionUUID->"aa7881d4-11e2-444f-ae33-\
7f9598efd437"],

Cell["is correct.", "Text",ExpressionUUID->"af89cdfb-6296-d04c-bb38-26a45de43d2d"],

Cell[TextData[{
 "A standard Lagrangian density of the form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "(", 
         RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
           StyleBox["r", "TI"], ",", "\[PartialD]", "\[Rho]", ",", 
           "\[PartialD]", "\[Chi]", ",", "\[PartialD]", 
           StyleBox["r", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{L}(\\rho,\\chi,r,\\partial\\rho,\\partial\\chi,\\partial r)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "81091ced-74d4-ba45-bbca-ba7385bffead"],
 StyleBox["does not by itself encode",
  FontWeight->Bold],
 " a rule like: "
}], "Text",ExpressionUUID->"70816afe-9f2a-bb4d-812b-a13146018434"],

Cell["\[OpenCurlyDoubleQuote]unmeasured = latent potential\
\[CloseCurlyDoubleQuote]", "Item",ExpressionUUID->"d29273a3-20c4-1042-96bc-\
9a2c6a1db8f4"],

Cell["\[OpenCurlyDoubleQuote]observation = \
activation\[CloseCurlyDoubleQuote]", "Item",ExpressionUUID->"99635cc8-a57f-\
b54e-889a-f2ab7cee56c3"],

Cell["\[OpenCurlyDoubleQuote]mention collapses or stabilizes spacetime\
\[CloseCurlyDoubleQuote]", "Item",ExpressionUUID->"47757682-d8cb-564b-8ecb-\
059c8c6f1144"],

Cell["To model that rigorously, we must add at least one of:", "Text",ExpressionUUID->"ba23aaa3-acc9-2646-add1-f72facb72593"],

Cell[TextData[{
 "1. a ",
 StyleBox["measurement operator",
  FontWeight->Bold],
 "2. an ",
 StyleBox["event-triggered update law",
  FontWeight->Bold],
 "3. a ",
 StyleBox["hybrid continuous-discrete system",
  FontWeight->Bold],
 "4. a ",
 StyleBox["state-dependent decoherence functional",
  FontWeight->Bold],
 "5. an ",
 StyleBox["observation-dependent source term or projection map",
  FontWeight->Bold],
 "So the correct workflow is: "
}], "Text",ExpressionUUID->"fbf27fcf-e7f8-cf4b-9792-7a71dac31602"],

Cell[TextData[{
 "keep the OPF latent substrate as a ",
 StyleBox["pre-measurement state space postulate",
  FontWeight->Bold]
}], "Item",ExpressionUUID->"5e3bce54-2f37-c54e-bd08-4a8757953089"],

Cell[TextData[{
 "define a ",
 StyleBox["measurement activation operator",
  FontWeight->Bold],
 " separately"
}], "Item",ExpressionUUID->"ad766635-ad84-e848-8c11-ea8459a0b928"],

Cell["\<\
test whether that operator yields stable post-measurement dynamics\
\>", "Item",ExpressionUUID->"ffb0639e-1720-4047-9785-fb1341059656"],

Cell["\<\
compare its consequences with known interference / decoherence phenomena\
\>", "Item",ExpressionUUID->"b4bb627f-88d2-0a43-a294-543de18a9d03"],

