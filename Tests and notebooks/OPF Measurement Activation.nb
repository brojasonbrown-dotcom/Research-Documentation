Cell[CellGroupData[{

Cell["16. Exportable summary object", "Section",ExpressionUUID->"fe1f5c75-8b4e-4b41-b9dd-0a4d2526a5d1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"finalSummary", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Layer0\>\"", "->", "layer0"}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<LatentLagrangian\>\"", "->", "latentLagrangian"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<LatentEulerEquations\>\"", "->", "eulerLatent"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ActivationEquation\>\"", "->", 
       RowBox[{"activationEquation", "[", "R", "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<GeometryActivationEquation\>\"", "->", 
       RowBox[{"geometryActivationEquation", "[", "R", "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<OriginAudit\>\"", "->", "opfOriginAudit"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<DispersionDeterminant\>\"", "->", "dispersionDet"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<DoubleSlitTests\>\"", "->", "doubleSlitTests"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<RelativeFindings\>\"", "->", "relativeFindings"}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"NotebookDirectory", "[", "]"}], 
       ",", "\"\<opf-measurement-activation-summary.wl\>\""}], "}"}], "]"}], ",",
     "finalSummary"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
