Cell[CellGroupData[{

Cell["12.3 Plots", "Subsection",ExpressionUUID->"ba7d332d-8fab-cd4b-bb91-3b57d077602b"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "@", 
