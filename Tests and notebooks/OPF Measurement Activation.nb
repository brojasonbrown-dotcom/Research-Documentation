Cell[CellGroupData[{

Cell["17. Final conclusion", "Section",ExpressionUUID->"5e00ec81-34b9-ec44-a0a4-27b4da3f0477"],

Cell["Your statement ", "Text",ExpressionUUID->"cc0d2f29-0b87-f44a-a041-49aa5a3da1e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"opfUnmapped", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{"\"\<incommensurate measurement activation\>\"", "->", 
     "\[IndentingNewLine]", 
     "    ", "\"\<The 'if not measured requires measurement' rule is not in \
the Lagrangian. \\\n     It would need an event-driven field update operator; \
\\\n     no standard PDE framework has one.\>\""}], "\[IndentingNewLine]", 
    "|>"}]}], ";"}]], "Input",ExpressionUUID->"10e30d40-f75a-534b-bdd5-\
f5af83d505a1"],

Cell["is the correct starting point.", "Text",ExpressionUUID->"3427ab10-dbc4-8b45-be09-85178dd484ad"],

Cell["The most rigorous upgrade is:", "Text",ExpressionUUID->"d4c0ee1a-3a73-6e43-93b5-aea0bdf9e58d"],

Cell["1. keep the OPF latent field action separate", "Text",ExpressionUUID->"06c327da-c612-ce4b-aecd-89550eeb1a96"],

Cell[TextData[{
 "2. add a ",
 StyleBox["measurement activation operator",
  FontWeight->Bold],
 " explicitly"
}], "Text",ExpressionUUID->"817a6270-f848-1b40-9d6c-a5a7f616dfa1"],

Cell["3. choose one of: ", "Text",ExpressionUUID->"5849ec8c-024e-644f-9bed-8291cfe08975"],

Cell["projection", "Subitem",ExpressionUUID->"7c35f040-29ee-6a46-9e40-c9e69ecad5ab"],

Cell["decoherence", "Subitem",ExpressionUUID->"1dc9adfa-ce9d-394f-810b-ddc181e0e047"],

Cell["event-triggered update", "Subitem",ExpressionUUID->"473c4f4a-acc1-7d43-8021-fa7ad39f8230"],

Cell["source activation", "Subitem",ExpressionUUID->"9b0b8556-dff6-b545-8efe-7783641fd017"],

Cell["threshold / resolution activation", "Subitem",ExpressionUUID->"ba178d19-bbfb-134a-9dba-ae088a3d5a60"],

Cell["4. test each against: ", "Text",ExpressionUUID->"63abed40-5e50-fa4c-9b72-6cb3377d766c"],

Cell["residual consistency", "Subitem",ExpressionUUID->"30d36cac-57fa-8347-8984-8f24eef2d33b"],

Cell["modal stability", "Subitem",ExpressionUUID->"1a303c0b-ecdb-514a-a237-ed1ad781c4c7"],

Cell["double-slit coherence suppression", "Subitem",ExpressionUUID->"40c9c206-ecff-3441-a61c-f4c9c9f86ac5"],

Cell["scale dependence", "Subitem",ExpressionUUID->"390ac234-4581-6949-b158-0f7e3cf291d3"],

Cell["persistence of observed sector", "Subitem",ExpressionUUID->"72ef4515-976d-604a-a64b-e9cfba862e59"],

Cell["5. document clearly which parts are: ", "Text",ExpressionUUID->"3ca9984d-6d2a-4349-a7c2-4fb6e59daf78"],

Cell["derived", "Subitem",ExpressionUUID->"fe54f8dd-e59c-d34b-a672-dc5dd7df4460"],

Cell["assumed", "Subitem",ExpressionUUID->"ecc944b9-4a4c-974e-ba39-9249f17fa6e7"],

Cell["analogical", "Subitem",ExpressionUUID->"88bff4ae-9fc6-2a40-81f3-768cd2a03614"],

Cell["unsupported", "Subitem",ExpressionUUID->"ee0a681d-79f6-1f48-ae10-0099cca8a096"],

Cell["That is the rigorous path. ", "Text",ExpressionUUID->"a0d4a274-0b1e-9942-83d3-b27f6f8f6b79"],

