      RowBox[{"obsSamples", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<t\>\"", ",", "\"\<uLatent(t,0.5)\>\"", 
         ",", "\"\<uObs(t,0.5)\>\""}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Frame", "->", "All"}]}], "\[IndentingNewLine]", "]"}], "]"}], 
