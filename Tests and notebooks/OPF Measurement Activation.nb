Cell[CellGroupData[{
Cell["OPF Measurement Activation Notebook", "Title",ExpressionUUID->"d2197f30-b138-e047-927e-cac616afe136"],

Cell["This notebook formalizes your unmapped statement ", "Text",ExpressionUUID->"9cd8de15-6326-6844-a54b-49a24fc46098"],

Cell[BoxData[GridBox[{
   {
    PaneBox[Cell[TextData[{
      StyleBox["\"incommensurate measurement activation\"",
       FontWeight->Bold],
      " \[RightArrow] the unmeasured state behaves like a zero-valued but \
