Cell[CellGroupData[{

Cell["7. Variational status audit", "Section",ExpressionUUID->"f85286a9-c6c0-9747-9b8e-bbe83bfbd327"],

Cell["\<\
We must explicitly mark which equations come from the Lagrangian and which do \
not. \
\>", "Text",ExpressionUUID->"6a4463e4-4197-6447-a097-7ecaa0dc76bd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eulerLatent", "=", 
    RowBox[{
     RowBox[{"EulerEquations", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{"latentLagrangian", ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Rho]", "[", 
          RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
         RowBox[{"\[Chi]", "[", 
          RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
         RowBox[{"r", "[", 
          RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", "   ", "coords4"}], "\[IndentingNewLine]", 
      "]"}], " ", "//", " ", "FullSimplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"opfOriginAudit", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<DerivedFromLatentLagrangian\>\"", "->", "eulerLatent"}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<NotDerivedFromLatentLagrangian\>\"", "->", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<MeasurementActivation\>\"", "->", 
          RowBox[{"activationEquation", "[", "R", "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<GeometryActivation\>\"", "->", 
          RowBox[{"geometryActivationEquation", "[", "R", "]"}]}]}], 
        "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
     "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "say", "[", "\"\<Origin audit: derived vs postulated structures\>\"", "]"}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Dataset", "[", "opfOriginAudit", "]"}], "]"}], ";"}]}], "Input",Ex\
pressionUUID->"cd2de706-2779-4b43-a555-d75687b8c13d"],

Cell["This distinction is essential for rigor. ", "Text",ExpressionUUID->"fd57ffc4-50a9-444b-8712-c5ee73590f20"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"384346c6-c260-0046-a573-08aee36f585c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
8. Early-universe analogy: from unmeasured latent potential to stabilized \
sector\
\>", "Section",ExpressionUUID->"4835d366-83c9-264a-b870-d1a7863934ff"],

Cell[TextData[{
 "A rigorous analogy is ",
 StyleBox["not",
  FontWeight->Bold],
 " \[OpenCurlyDoubleQuote]the universe was literally observed into existence.\
\[CloseCurlyDoubleQuote]"
}], "Text",ExpressionUUID->"3bd0f475-2a3f-0b4a-9a47-0617fdfd1805"],

Cell["A safer mathematical analogy is: ", "Text",ExpressionUUID->"071e1809-55b1-6546-b201-694a8160ee51"],

Cell["latent symmetric or prelocalized field sector", "Item",ExpressionUUID->"5918c401-5e1f-d944-869a-b60825e9ee57"],

Cell["instability / threshold / decoherence / coupling", "Item",ExpressionUUID->"24b3642d-8d1f-984d-8714-d57f9edc89f8"],

Cell["emergence of persistent classical observables", "Item",ExpressionUUID->"e58eea03-e235-0040-b1e5-cbaccacd3861"],

Cell["This is structurally similar to: ", "Text",ExpressionUUID->"0bffcfcb-6a58-184d-8815-a3f184fd3cd5"],

Cell["symmetry breaking", "Item",ExpressionUUID->"9b8eb963-5734-9340-8a82-91e019b8cc72"],

Cell["phase transition", "Item",ExpressionUUID->"78995d1e-fad0-9140-816e-ed107a6751a5"],

Cell["reheating / mode freezing", "Item",ExpressionUUID->"2a6aab14-c3f5-bb4c-83f9-f29562ac9a9d"],

Cell["decoherence after inflationary perturbations", "Item",ExpressionUUID->"b69a3793-1f84-b64e-b5fd-f66491174931"],

Cell[CellGroupData[{

Cell["Testable surrogate model", "Subsection",ExpressionUUID->"7724b9c6-b540-c345-b133-6cebcf92662b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"uLatent", ",", "uObs", ",", "latentToObservedPDE"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"latentToObservedPDE", "[", "R_", "]"}], ":=", 
   RowBox[{"{", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"uLatent", "[", 
         RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "==", 
      RowBox[{"-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"uLatent", "[", 
          RowBox[{"t", ",", "x"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}]}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"uObs", "[", 
          RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "+", 
       RowBox[{"\[CapitalGamma]", " ", 
        RowBox[{"uObs", "[", 
         RowBox[{"t", ",", "x"}], "]"}]}]}], "==", 
      RowBox[{"\[Kappa]", " ", 
       RowBox[{"UnitStep", "[", 
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"uLatent", "[", 
           RowBox[{"t", ",", "x"}], "]"}], "]"}], "-", 
         RowBox[{"\[Sigma]r", "[", "R", "]"}]}], "]"}], " ", 
       RowBox[{"uLatent", "[", 
        RowBox[{"t", ",", "x"}], "]"}]}]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]}], "Input",ExpressionUUID->"789e8f69-ab10-7949-9091-4c783a3877a3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["What to test", "Subsection",ExpressionUUID->"170e0b17-634e-344e-8f14-1c369cd115ea"],

Cell[TextData[{
