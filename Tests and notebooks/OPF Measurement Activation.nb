Cell[CellGroupData[{

Cell["14. What is the most rigorous and correct structure?", "Section",ExpressionUUID->"fadc0fcd-0d67-9645-8231-bf5ec0c355a9"],

Cell["For your stated goal, the best rigorous structure is: ", "Text",ExpressionUUID->"4684989d-0704-5c4f-b760-3274a0f6e4db"],

Cell[CellGroupData[{

Cell["Structure S1: latent variational sector", "Subsection",ExpressionUUID->"a033f6ae-31ae-d54f-a827-5891379b9414"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Delta]", 
         SubscriptBox[
          StyleBox["S", "TI"], 
          StyleBox["L", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\delta S_L = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d526332-9555-7b44-b79f-4e501cedfac3"],
 "for the OPF field carrier. "
}], "Text",ExpressionUUID->"26c0a90d-d779-a34a-932f-3d8c59686943"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Structure S2: measurement activation map", "Subsection",ExpressionUUID->"1f7228f9-9fbe-d74c-bf46-65bf840bb876"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["O", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["R", "TI"]], 
         RowBox[{"[", 
           SubscriptBox["\[CapitalPsi]", 
            StyleBox["L", "TI"]], "]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Psi_O = \\mathcal{M}_R[\\Psi_L]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "59ce3db7-ffd2-454d-9c9a-05533bcaf9d5"],
 "or in dynamic form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["t", "TI"]], 
         SubscriptBox["\[CapitalPsi]", 
          StyleBox["O", "TI"]], "+", 
         SubscriptBox["\[CapitalGamma]\[CapitalPsi]", 
          StyleBox["O", "TI"]], "\[LongEqual]", "\[Kappa]", 
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["R", "TI"]], 
         RowBox[{"[", 
           SubscriptBox["\[CapitalPsi]", 
            StyleBox["L", "TI"]], "]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\partial_t \\Psi_O + \\Gamma \\Psi_O = \\kappa \
\\mathcal{M}_R[\\Psi_L]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3ae372d-ee71-7c48-bb05-9ac5fc6f24bf"]
}], "Text",ExpressionUUID->"bb56be43-658f-4f49-b5dd-216996195ea7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Structure S3: geometry or observable persistence map", "Subsection",ExpressionUUID->"aa0b778e-05c2-9e43-97dc-8086fb2ab57b"],

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox["\[PartialD]", 
         StyleBox["t", "TI"]], 
        StyleBox["g", "TI"], "+", 
        SubscriptBox["\[CapitalGamma]", 
         StyleBox["g", "TI"]], 
        StyleBox["g", "TI"], "\[LongEqual]", 
        StyleBox["F", "TI"], 
        RowBox[{"(", 
          SubscriptBox["\[CapitalPsi]", 
           StyleBox["O", "TI"]], ")"}]}], TraditionalForm], "errors" -> {}, 
    "input" -> "\\partial_t g + \\Gamma_g g = F(\\Psi_O)", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"6d395901-43fe-f049-92bc-06534c4bf5b9"]], \
"Text",ExpressionUUID->"670857dd-1b12-6248-b587-f93fd667a004"]
}, Open  ]],

