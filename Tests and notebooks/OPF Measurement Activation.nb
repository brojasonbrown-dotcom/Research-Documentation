   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"cc8cf05a-6633-3746-87f1-2dfa51a98c60"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Correct mathematical ways to represent activation", "Section",ExpressionUUID->"1d4110b7-8e98-cf49-9076-52e2192fa91f"],

Cell["\<\
There are several rigorous possibilities. They should be kept distinct. \
\>", "Text",ExpressionUUID->"440dba03-b763-fe44-9a7f-16343b6e43da"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Approach A: projection-like measurement operator", "Section",ExpressionUUID->"91366b2f-3456-2b43-a64d-92fca8d1e062"],

Cell[TextData[{
 "Observation acts by projection onto a measured basis. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], "\[CapitalPi]"], 
         RowBox[{"[", "\[CapitalPsi]", "]"}], "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          StyleBox["n", "TI"], LimitsPositioning -> True], 
         RowBox[{"\[LeftAngleBracket]", 
           RowBox[{
             SubscriptBox[
              StyleBox["b", "TI"], 
              StyleBox["n", "TI"]], ",", "\[CapitalPsi]"}], 
           "\[RightAngleBracket]"}], 
         SubscriptBox[
          StyleBox["b", "TI"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{M}_{\\Pi}[\\Psi] = \\sum_n \\langle b_n, \\Psi \\rangle b_n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c615fcfa-866f-2349-9c30-08889152c6ba"]
}], "Text",ExpressionUUID->"a150dd21-5478-c543-b43d-15fc132a2441"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "projectionActivation", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"projectionActivation", "[", 
     RowBox[{"basis_", ",", "region_"}], "]"}], "[", "\[Psi]_", "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"Sum", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Psi]", "[", "\[Xi]", "]"}], " ", 
         RowBox[{
          RowBox[{"basis", "[", "n", "]"}], "[", "\[Xi]", "]"}]}], ",", 
        RowBox[{
         RowBox[{"Evaluate", "@", "Sequence"}], " ", "@@", " ", "region"}]}], 
       "]"}], " ", 
      RowBox[{
       RowBox[{"basis", "[", "n", "]"}], "[", "x", "]"}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "nMax"}], "}"}]}], "\[IndentingNewLine]", 
    "  ", "]"}]}], ";"}]}], "Input",ExpressionUUID->"49435974-bd1f-1b44-9e4e-\
21e517c7eb43"],

Cell[TextData[StyleBox["Use when testing:",
 FontWeight->Bold]], "Text",ExpressionUUID->"9a209f6c-ada4-a746-b8c4-aacfc52abf5d"],

Cell["mode selection", "Item",ExpressionUUID->"51aecf25-0ebc-4b4a-b55e-02ecabfe4b27"],

Cell["basis truncation effects", "Item",ExpressionUUID->"4026028e-f6d0-7a42-894f-dfcc3ed3dc81"],

Cell["scale-dependent observability", "Item",ExpressionUUID->"d15c8035-0947-d647-9aff-3f02d7ac5afd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Approach B: decoherence / damping activation", "Section",ExpressionUUID->"98793ba4-c054-9d42-aba0-65b89a531593"],

Cell[TextData[{
 "Observation adds damping of nonclassical coherence. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["t", "TI"]], "\[CapitalPsi]", "\[LongEqual]", 
         StyleBox["F", "TI"], 
         RowBox[{"[", "\[CapitalPsi]", "]"}], "-", "\[Eta] ", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["I", "TI"], "-", 
             StyleBox["P", "TI"]}], ")"}], "\[CapitalPsi]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\partial_t \\Psi = F[\\Psi] - \\eta\\,(I-\\mathcal{P})\\Psi", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "42b5a597-d8da-ee46-95e5-03c22ce5c38b"],
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["P", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{P}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6ed302f5-6683-1d49-a6d7-9a614da05729"],
 " is the measured subspace. "
}], "Text",ExpressionUUID->"54dd13c3-0b32-9d4c-953d-9c1fecb989ff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "decoherenceOperator", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"decoherenceOperator", "[", 
     RowBox[{"proj_", ",", "\[Eta]_"}], "]"}], "[", "\[Psi]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "\[Eta]"}], " ", 
    RowBox[{"(", 
     RowBox[{"\[Psi]", "-", 
      RowBox[{"proj", "[", "\[Psi]", "]"}]}], ")"}]}]}], ";"}]}], "Input",Expr\
essionUUID->"4df3a381-258a-d848-849e-b297c98bfc69"],

Cell[TextData[StyleBox["Use when testing:",
 FontWeight->Bold]], "Text",ExpressionUUID->"ff3744a7-7df1-1a42-ae51-4eac2e68282f"],

Cell["double-slit visibility loss", "Item",ExpressionUUID->"2efe468e-b409-ed47-8211-0cb86879b957"],

Cell["environment-induced selection", "Item",ExpressionUUID->"a4733cbe-03a1-5b44-8eac-4a72837a29c6"],

Cell["stabilization timescales", "Item",ExpressionUUID->"9bdb3b1f-c6fa-e549-ac42-d150b21d7511"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Approach C: hybrid event-triggered activation", "Section",ExpressionUUID->"dadb5b0b-0088-ee40-9753-2f24394bb444"],

Cell[TextData[{
 "Observation occurs at event times ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["t", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "t_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3a6add93-0bae-364a-8f65-aa4a7bc5f92b"],
 " and updates state discontinuously. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPsi]", 
         RowBox[{"(", 
           SubsuperscriptBox[
            StyleBox["t", "TI"], 
            StyleBox["i", "TI"], "+"], ")"}], "\[LongEqual]", 
         StyleBox["M", "TI"], 
         RowBox[{"[", 
           RowBox[{"\[CapitalPsi]", "(", 
             SubsuperscriptBox[
              StyleBox["t", "TI"], 
              StyleBox["i", "TI"], "-"], ")"}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Psi(t_i^+) = \\mathcal{M}[\\Psi(t_i^-)]", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e9a01b22-f5c1-0a4c-b233-6d6e1b9df38d"]
}], "Text",ExpressionUUID->"2318f166-ce87-8346-bd4b-441d2bad3220"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "eventUpdateRule", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eventUpdateRule", "[", 
    RowBox[{"\[Psi]Before_", ",", "activation_"}], "]"}], ":=", 
   RowBox[{"activation", "[", "\[Psi]Before", "]"}]}], ";"}]}], "Input",Expres\
sionUUID->"16f1c3c7-96c1-3841-84f8-bfe6ddaf2354"],

Cell[TextData[StyleBox["Use when testing:",
 FontWeight->Bold]], "Text",ExpressionUUID->"128d50e6-fc1d-1e4e-a5e7-b3d453bc12ce"],

Cell["detector clicks", "Item",ExpressionUUID->"a76662ab-d70e-4d40-8e21-06e6e4753325"],

Cell["thresholded mention/observation events", "Item",ExpressionUUID->"1c67c03a-1b28-624e-b99c-ba7177bfe97f"],

Cell["discrete intervention experiments", "Item",ExpressionUUID->"dabbf1f9-e4c2-4246-a1f3-66db49f429db"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Approach D: source-triggered activation of spacetime sector", "Section",ExpressionUUID->"23a0a5e1-405c-a945-a290-41f1a0fac196"],

Cell[TextData[{
 "Observation activates the measured sector by source injection. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], 
         RowBox[{"[", "\[CapitalPhi]", "]"}], "\[LongEqual]", "0  ", 
         "\[Rule]  ", 
         StyleBox["E", "TI"], 
         RowBox[{"[", "\[CapitalPhi]", "]"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["J", "TI"], 
          StyleBox["O", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{E}[\\Phi] = 0 \\quad \\to \\quad \\mathcal{E}[\\Phi] = J_O", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "696a696a-a14e-7143-892e-b1b6ca784690"]
}], "Text",ExpressionUUID->"e43253f8-35a8-6e4a-9739-af0562b80a06"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "activationSource", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"activationSource", "[", 
    RowBox[{"obsStrength_", ",", "obsProfile_"}], "]"}], ":=", 
   RowBox[{"obsStrength", " ", 
    RowBox[{"obsProfile", "[", 
     RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}]}], ";"}]}], "Input",\
ExpressionUUID->"d8ce81e2-770b-2b4d-aeb9-af15555ca108"],

Cell[TextData[StyleBox["Use when testing:",
 FontWeight->Bold]], "Text",ExpressionUUID->"bc7db6b4-0c28-3742-9d6b-6caee7b57170"],

Cell["symmetry breaking analogies", "Item",ExpressionUUID->"f48ea7dc-548d-f942-8fb5-ab44bed47721"],

Cell["early-universe nucleation analogies", "Item",ExpressionUUID->"b52f7739-1d11-e343-b930-7470addde715"],

Cell["detector-induced localization", "Item",ExpressionUUID->"a8f4dfc3-0e4d-f445-b948-96f4f26389f3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Approach E: resolution-threshold activation", "Section",ExpressionUUID->"048ea6e8-a657-2d48-b456-953f426d1aa7"],

Cell[TextData[{
 "Only structure above a scale-dependent threshold is stabilized. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["R", "TI"]], 
         RowBox[{"[", "\[CapitalPsi]", "]"}], "\[LongEqual]", 
         StyleBox["H", "TI"], 
         RowBox[{"(", 
           RowBox[{"|", "\[CapitalPsi]", "|", "-", "\[Sigma]", 
             RowBox[{"(", 
               StyleBox["R", "TI"], ")"}]}], ")"}], " ", "\[CapitalPsi]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{M}_R[\\Psi] = H(|\\Psi| - \\sigma(R))\\,\\Psi", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c3b51730-7b86-2f4a-8a6c-c4f815e3ccf8"]
}], "Text",ExpressionUUID->"98962c0c-aa98-f841-bb7c-b235c5ff217f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"resolutionThresholdActivation", ",", "\[Sigma]r"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]r", "[", "R_", "]"}], ":=", 
   RowBox[{"\[Sigma]", "/", "R"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"resolutionThresholdActivation", "[", "R_", "]"}], "[", "\[Psi]_",
     "]"}], ":=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"UnitStep", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"\[Psi]", "[", 
          RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "]"}], "-", 
        RowBox[{"\[Sigma]r", "[", "R", "]"}]}], "]"}], " ", 
      RowBox[{"\[Psi]", "[", 
       RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"379e563f-54c9-314f-8ea7-75e8a88644dd"],

Cell[TextData[StyleBox["Use when testing:",
 FontWeight->Bold]], "Text",ExpressionUUID->"a12a9660-c6d5-ea43-8381-116b7b90c5f2"],

Cell["finite detector resolution", "Item",ExpressionUUID->"0168cee4-277a-8747-b32b-3480b636f0b8"],

Cell["coarse vs fine observation", "Item",ExpressionUUID->"44435eae-ab3f-1f48-bcf8-2c77a5699417"],

Cell["scale-relative emergence", "Item",ExpressionUUID->"511b5ea7-4a89-5b4c-8bd7-d1e33339c120"],

