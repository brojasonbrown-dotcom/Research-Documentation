Cell[CellGroupData[{

Cell["A. Symbolic correctness tests", "Subsection",ExpressionUUID->"71cfd7b3-3b07-3444-a27b-f1a86c34816a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"symbolicTests", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<EulerEquationsDerived\>\"", "->", "eulerLatent"}], ",", 
     "\[IndentingNewLine]", "  ", 
