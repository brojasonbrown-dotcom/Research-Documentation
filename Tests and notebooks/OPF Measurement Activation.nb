Cell[CellGroupData[{

Cell["2. Formal separation of state layers", "Section",ExpressionUUID->"02df70de-8869-334a-abba-58da950736c0"],

Cell["We distinguish three layers. ", "Text",ExpressionUUID->"05cb0d58-03db-8a4e-940f-dbfd2763e2c7"],

Cell[CellGroupData[{

Cell["Layer 0: latent unmeasured potential", "Subsection",ExpressionUUID->"d37c3c2a-a55d-644a-b372-028075863d80"],

Cell[TextData[{
 "This is ",
 StyleBox["not",
  FontWeight->Bold],
 " ordinary spacetime dynamics. It is metadata plus an uncollapsed symbolic \
carrier. "
}], "Text",ExpressionUUID->"2fcae590-bb06-794d-9d20-cf2cf230ce28"],

Cell[BoxData[
 RowBox[{
  RowBox[{"layer0", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<Interpretation\>\"", 
      "->", "\"\<Unmeasured potential / latent substrate\>\""}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<Geometry\>\"", "->", "\"\<Sphere\>\""}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<BoundaryDuality\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "Infinity"}], "}"}]}], ",", "\[IndentingNewLine]", 
     "  ", 
     RowBox[{"\"\<TemporalMode\>\"", 
      "->", "\"\<Timeless or pre-dynamical\>\""}], ",", "\[IndentingNewLine]",
      "  ", 
     RowBox[{"\"\<ObservedSpacetimeQ\>\"", "->", "False"}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",ExpressionUUID->\
"cdd5e42f-17ea-754b-a961-1ded5a4af7f6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer 1: pre-measurement field carrier", "Subsection",ExpressionUUID->"549e4e42-4c01-764b-8a37-ae8774baad6b"],

Cell["This is the symbolic field layer on which the action lives. ", "Text",ExpressionUUID->"1c08afb4-872a-f542-bdca-b22f01106f45"],

Cell[BoxData[
 RowBox[{
  RowBox[{"latentLagrangian", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]", "[", 
      RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"\[Chi]", "[", 
       RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "]"}]}], "+", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\[Chi]", "[", 
      RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], " ", 
     RowBox[{
      RowBox[{"r", "[", 
       RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], "^", "2"}]}], "+", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\[Alpha]", "/", "2"}], " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"\[Rho]", "[", 
            RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "#"}], 
          "]"}], "^", "2"}], " ", "&"}], " ", "/@", " ", "coords4"}], "]"}]}],
     "+", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\[Beta]", "/", "2"}], " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"\[Chi]", "[", 
            RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "#"}], 
          "]"}], "^", "2"}], " ", "&"}], " ", "/@", " ", "coords4"}], "]"}]}],
     "+", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\[Mu]", "/", "2"}], " ", 
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"r", "[", 
            RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", "#"}], 
          "]"}], "^", "2"}], " ", "&"}], " ", "/@", " ", "coords4"}], 
      "]"}]}]}]}], ";"}]], "Input",ExpressionUUID->"93d95aa6-8d78-d34f-b3d1-\
088b9c2b6795"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Layer 2: activated / observed spacetime sector", "Subsection",ExpressionUUID->"55e18b24-8090-f247-a9b7-48096c94664f"],

Cell["This requires a separate activation rule. ", "Text",ExpressionUUID->"8be566af-14f0-224a-a441-328c1bf7a1e6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"observedFields", "=", 
   RowBox[{"{", 
