Cell[CellGroupData[{

Cell["2. Formal separation of layers", "Title",ExpressionUUID->"7e81138e-c41a-e94d-9074-7d3e8f3b166b"],

Cell["\<\
We represent the three-layer structure by explicit symbolic objects. \
\>", "Text",ExpressionUUID->"e33b7cb4-9a71-9946-8265-8926e1b05ea2"],

Cell[CellGroupData[{

Cell["2.1 Layer 0: background/topological seed", "Section",ExpressionUUID->"8644995e-83c3-6b44-b027-f3815166b5fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "layer0", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"layer0", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\"\<Geometry\>\"", "->", 
      RowBox[{"Sphere", "[", "]"}]}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<BoundaryDuality\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"DirectedInfinity", "[", "1", "]"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<TemporalMode\>\"", "->", "\"\<Timeless\>\""}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<Substrate\>\"", "->", "\"\<EmptySpacetime\>\""}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<Potential\>\"", "->", "\"\<InfiniteComputational\>\""}]}], 
    "\[IndentingNewLine]", "|>"}]}], 
  ";"}], "\[IndentingNewLine]", "layer0"}], "Input",ExpressionUUID->"19ff5361-\
b12b-e744-bc44-52bcb66cfba3"],

Cell["\<\
For calculational purposes, the sphere is treated as a symbolic topological \
datum rather than as a metric manifold unless a chart is explicitly \
introduced. \
\>", "Text",ExpressionUUID->"6f0adbde-7766-9845-9e06-b227411177d0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2 Layer 1: field variables and action", "Section",ExpressionUUID->"352a10f3-befc-d04f-bc8b-2076523f6faf"],

Cell[TextData[{
 "We define the fundamental fields ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPsi]", "\[LongEqual]", "\[CapitalPsi]", 
         RowBox[{"[", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"]}], "]"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Psi = \\Psi[\\rho, \\chi, R],", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fb26467f-c97b-db43-8e0b-a1c16283f961"],
 "with scalar fields: "
}], "Text",ExpressionUUID->"7f7b18d7-baf5-0544-8153-706b25e74131"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "83eecf63-5ca8-8449-ae7a-6b91aebfb6bc"],
 ": information density"
}], "Item",ExpressionUUID->"c9da4cba-b040-6d4e-b8ce-0fb30e687377"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Chi]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\chi(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "98f3e8df-1915-da48-9902-ea9a8bcb51d3"],
 ": field complexity"
}], "Item",ExpressionUUID->"d108317a-92ef-3043-aa89-5c9d75615a6a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "R(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "871b6017-dc05-8048-aba9-646368f3b3af"],
 ": observational resolution"
}], "Item",ExpressionUUID->"831acf98-71d9-774c-9d8e-c0afd2e40143"],

Cell[TextData[{
 "The proposed bulk action density is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"]}], ")"}], "\[LongEqual]", "\[Rho]", "log", 
         RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{L}(\\rho,\\chi,R) = \\rho\\log(\\chi) + \\chi R^2.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a0cfefac-c4e0-cc4d-976f-a3aafadea6dc"],
 "To obtain nontrivial Euler--Lagrange equations, we distinguish two levels:"
}], "Text",ExpressionUUID->"2eb30f1f-960a-4d4c-9894-19db930174e9"],

Cell[TextData[{
 "1. ",
 StyleBox["Algebraic action",
  FontWeight->Bold],
 " using only the stated density"
}], "Text",ExpressionUUID->"de089ce3-c8d3-3e40-a1a4-cd74a100a2a2"],

Cell[TextData[{
 "2. ",
 StyleBox["Regularized variational action",
  FontWeight->Bold],
 " with derivative terms added minimally to make the PDE problem well posed"
}], "Text",ExpressionUUID->"f6aa3634-7ddc-6743-a3b5-19f4493fbc16"],

Cell["\<\
This distinction is essential: without derivative terms, the variational \
equations are pointwise algebraic constraints rather than PDEs. \
\>", "Text",ExpressionUUID->"331b12e6-3108-0048-92ea-ddd6f92cc51e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "x", ",", "y", ",", "z", ",", "t", ",", "coords3", ",", "coords4", ",", 
    "\[Rho]", ",", "\[Chi]", ",", "r", ",", "\[Psi]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords3", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"coords4", "=", 
    RowBox[{"{", 
     RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lagrangianAlgebraic", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]", "[", 
      RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"\[Chi]", "[", 
       RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], "]"}]}], "+", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\[Chi]", "[", 
      RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], " ", 
     RowBox[{
      RowBox[{"r", "[", 
       RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], "^", "2"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"lagrangianAlgebraic", " ", "//", " ", "TraditionalForm"}]}], "Input",\
ExpressionUUID->"a7981450-2a51-1543-8450-b78d7a29a255"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.3 Minimal regularization for variational analysis", "Section",ExpressionUUID->"06e0fba9-05a3-8140-a51b-62a84a275b5d"],

Cell[TextData[{
 "A mathematically controlled extension introduces quadratic gradient \
penalties: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["reg", FontSlant -> "Plain"]], "\[LongEqual]", "\[Rho]", 
         "log", "\[Chi]", "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "+", 
         FractionBox["\[Alpha]", "2"], "|", "\[Del]", "\[Rho]", 
         SuperscriptBox["|", "2"], "+", 
         FractionBox["\[Beta]", "2"], "|", "\[Del]", "\[Chi]", 
         SuperscriptBox["|", "2"], "+", 
         FractionBox["\[Mu]", "2"], "|", "\[Del]", 
         StyleBox["R", "TI"], 
         SuperscriptBox["|", "2"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{L}_{\\mathrm{reg}} = \\rho\\log\\chi + \\chi R^2 + \
\\frac{\\alpha}{2}|\\nabla \\rho|^2 + \\frac{\\beta}{2}|\\nabla \\chi|^2 + \
\\frac{\\mu}{2}|\\nabla R|^2.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ba3f48ce-3263-d74c-877b-f6df2803c63d"],
 "This does ",
 StyleBox["not",
  FontWeight->Bold],
 " claim physical uniqueness. It is the minimal analytic closure needed to \
study Euler--Lagrange structure, linearization, and spectra. "
}], "Text",ExpressionUUID->"442b03a8-099b-c44d-bedc-96caf3344dcd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "gradSq", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gradSq", "[", "f_", "]"}], ":=", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"f", " ", "@@", " ", "coords4"}], ",", "#"}], "]"}], "^", 
        "2"}], " ", "&"}], " ", "/@", " ", "coords4"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lagrangianReg", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Rho]", " ", "@@", " ", "coords4"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"\[Chi]", " ", "@@", " ", "coords4"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"\[Chi]", " ", "@@", " ", "coords4"}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", " ", "@@", " ", "coords4"}], ")"}], "^", "2"}]}], "+", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\[Alpha]", "/", "2"}], " ", 
     RowBox[{"gradSq", "[", "\[Rho]", "]"}]}], "+", 
    RowBox[{
     RowBox[{"\[Beta]", "/", "2"}], " ", 
     RowBox[{"gradSq", "[", "\[Chi]", "]"}]}], "+", 
    RowBox[{
     RowBox[{"\[Mu]", "/", "2"}], " ", 
     RowBox[{"gradSq", "[", "r", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"lagrangianReg", " ", "//", " ", "TraditionalForm"}]}], "Input",Expre\
ssionUUID->"89cebbbc-ef6b-1b45-8422-c819312935f7"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
