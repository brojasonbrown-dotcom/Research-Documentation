Cell[CellGroupData[{

Cell["12. Final derived summary", "Title",ExpressionUUID->"5774232b-1c70-bc44-bcf2-d14f5a8e059b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"finalSummary", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<Layer0\>\"", "->", "layer0"}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"\"\<OriginalAlgebraicStationarity\>\"", "->", "algEquations"}],
       ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<OriginalAlgebraicSolutions\>\"", "->", "algSolve"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<RegularizedEulerSystem\>\"", "->", "eulerSystem"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<ConstantFieldSolutions\>\"", "->", "constSolve"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<BackgroundConditions\>\"", "->", "backgroundConditions"}], 
      ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<DispersionDeterminant\>\"", "->", "dispersionDet"}], ",", 
