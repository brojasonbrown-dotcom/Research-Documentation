Cell[CellGroupData[{

Cell["1. Notebook initialization", "Title",ExpressionUUID->"1ccf33f7-55e1-3540-baa8-89d6551f7e29"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Rho]0", ",", "\[Chi]0", ",", "r0", ",", "\[Gamma]", ",", 
         "\[Omega]", ",", "kx", ",", "ky", ",", "kz", ",", "\[Lambda]", ",", 
         "\[Alpha]", ",", "\[Beta]", ",", "\[Mu]"}], "}"}], ",", "Reals"}], 
      "]"}], "&&", "\[IndentingNewLine]", "   ", 
     RowBox[{"\[Rho]0", ">", "0"}], "&&", 
     RowBox[{"\[Chi]0", ">", "0"}], "&&", 
     RowBox[{"r0", ">", "0"}], "&&", 
     RowBox[{"\[Gamma]", ">=", "0"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"opfVersion", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<Name\>\"", "->", "\"\<Ontological Physics Framework\>\""}],
       ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<Version\>\"", "->", "\"\<1.0-rigorous-test\>\""}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<Status\>\"", 
       "->", "\"\<Hypothetical mathematical framework\>\""}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<NotebookMode\>\"", "->", "\"\<VerificationFirst\>\""}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "opfVersion"}], "Input",Expr\
essionUUID->"982d0383-e9aa-c54c-b1a3-bd21bae4f575"],

