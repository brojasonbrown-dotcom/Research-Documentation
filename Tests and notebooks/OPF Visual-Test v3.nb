 RowBox[{"stiffnessMatrix", " ", "//", " ", "MatrixForm"}]}], "Input",Expressi\
onUUID->"03038317-0cf6-dd4e-8009-1131e9c9fc38"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.3 Exact spectral condition", "Section",ExpressionUUID->"56c8e593-3d13-6e46-b585-b50da69befb0"],

Cell[TextData[{
 "Stable harmonic modes satisfy the vanishing determinant condition: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"det", 
         StyleBox["K", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Omega]", ",", 
             StyleBox["k", FontSlant -> "Bold"]}], ")"}], "\[LongEqual]", 
         "0."}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\det K(\\omega,\\mathbf{k})=0.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "db66f4be-83ce-7641-a909-5f874b533356"]
}], "Text",ExpressionUUID->"624f264e-a189-fa4f-925c-76f2fd73c46d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dispersionDet", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Det", "[", "stiffnessMatrix", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"dispersionDet", " ", "//", " ", "TraditionalForm"}]}], "Input",Expre\
ssionUUID->"42081edb-cd58-f246-a454-4fe929102b80"],

Cell["Solve symbolically where possible. ", "Text",ExpressionUUID->"a2d5c06b-9300-3741-bc97-0324a7d31edd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dispersionSolve", "=", 
   RowBox[{"Quiet", "@", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"dispersionDet", "==", "0"}], ",", "\[Omega]", ",", "Reals"}], 
      "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", "dispersionSolve"}], "Input",ExpressionUUID->\
"b6ac97ac-d36c-df4f-a7bc-5ae1fcdd416c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.4 Eigenvalue-based stability filter", "Section",ExpressionUUID->"e0cdcf06-dd59-914e-a013-111a7903a883"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eigenvaluesK", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Eigenvalues", "[", 
      RowBox[{"stiffnessMatrix", ",", 
       RowBox[{"Cubics", "->", "True"}], ",", 
       RowBox[{"Quartics", "->", "True"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"auditStableModes", "=", 
    RowBox[{"Assuming", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{"$Assumptions", ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"Select", "[", 
       RowBox[{"eigenvaluesK", ",", 
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Re", "[", "#", "]"}], "==", "0"}], "&&", 
           RowBox[{
            RowBox[{"Im", "[", "#", "]"}], ">", "0"}]}], "]"}], " ", "&"}]}], 
       "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"<|", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"\"\<Eigenvalues\>\"", "->", "eigenvaluesK"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<UndampedOscillatoryModes\>\"", "->", "auditStableModes"}]}], 
  "\[IndentingNewLine]", "|>"}]}], "Input",ExpressionUUID->"d7fec456-b513-\
494e-86e9-0457bd7b129b"],

Cell["\<\
This section implements the requested resonance-style audit in a \
mathematically explicit way. If the result is empty, that is itself an \
important conclusion. \
\>", "Text",ExpressionUUID->"93aae273-c186-dd47-97d9-61a4f8264d18"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"71219147-897e-4144-895d-5e3cd0ac79c0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Maintenance operator and persistent-state analysis", "Title",ExpressionUUID->"7dda11df-6f7f-1248-99d3-882c97683f85"],

Cell[TextData[{
 "Layer 2 introduces a maintenance law of the form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["t", "TI"]], "\[CapitalPhi]", "+", 
         "\[CapitalGamma]\[CapitalPhi]", "\[LongEqual]", "0."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\partial_t \\Phi + \\Gamma \\Phi = 0.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f79e7ccb-b58a-4342-b8f4-c94c628deb84"],
 "We study this first abstractly, then for the OPF fields. "
}], "Text",ExpressionUUID->"b7c59514-5f0d-9a41-bc3a-5325ed136b21"],

Cell[CellGroupData[{

Cell["6.1 Abstract exact solution", "Section",ExpressionUUID->"a592183a-0211-b947-b19d-44038f83a0f4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"\[Phi]", ",", "\[CapitalGamma]"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maintenanceAbstract", "=", 
   RowBox[{"DSolveValue", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"\[Phi]", "[", "t", "]"}], ",", "t"}], "]"}], "+", 
       RowBox[{"\[CapitalGamma]", " ", 
        RowBox[{"\[Phi]", "[", "t", "]"}]}]}], "==", "0"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\[Phi]", "[", "t", "]"}], ",", "t"}], "\[IndentingNewLine]", 
    "]"}]}], ";"}], "\[IndentingNewLine]", "maintenanceAbstract"}], "Input",Ex\
pressionUUID->"da382a50-865c-874d-8d0e-c14fad671a2e"],

Cell[TextData[{
 "Expected exact form: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPhi]", 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["C", "TI"], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", "\[CapitalGamma]", 
            StyleBox["t", "TI"]}]], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\Phi(t)=C e^{-\\Gamma t}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5dd89c7-b124-db4e-9345-880629c2b2d3"]
}], "Text",ExpressionUUID->"90c13949-9a11-5749-9332-fb5514879584"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.2 Componentwise application to fields", "Section",ExpressionUUID->"bb2d31da-1057-fe47-be39-651759515c89"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"maintenanceSystem", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", "t"}], 
         "]"}], "+", 
        RowBox[{"\[Gamma]", " ", 
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}]}], "==", "0"}],
       ",", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Chi]", "[", 
           RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", "t"}], 
         "]"}], "+", 
        RowBox[{"\[Gamma]", " ", 
         RowBox[{"\[Chi]", "[", 
          RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}]}], "==", "0"}],
       ",", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"r", "[", 
           RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", "t"}], 
         "]"}], "+", 
        RowBox[{"\[Gamma]", " ", 
         RowBox[{"r", "[", 
          RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}]}], "==", 
       "0"}]}], "\[IndentingNewLine]", "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maintenanceSolutions", "=", 
   RowBox[{"DSolveValue", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{"maintenanceSystem", ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
       RowBox[{"\[Chi]", "[", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
       RowBox[{"r", "[", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", "   ", "t"}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", "maintenanceSolutions"}], "Input",ExpressionUU\
ID->"671a75b1-2d5b-dd4e-b9e3-e3005de9f147"],

Cell["\<\
This exact family provides the temporal persistence law independently of the \
variational field equations. Compatibility between this law and the \
Euler--Lagrange system must be checked rather than assumed. \
\>", "Text",ExpressionUUID->"a30321fd-1f1e-4544-87e8-8289af84d8d8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
6.3 Compatibility of maintenance and stationary action equations\
\>", "Section",ExpressionUUID->"71dda765-a6ea-364d-b690-cc6e1b35b9e0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"compatibilityCheck", "=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{"eulerSystem", " ", "/.", " ", 
     RowBox[{"Thread", "[", "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Rho]", "[", 
          RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
         RowBox[{"\[Chi]", "[", 
          RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
         RowBox[{"r", "[", 
          RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}], "}"}], "->", 
       "maintenanceSolutions"}], "\[IndentingNewLine]", "   ", "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"compatibilityCheck", " ", "//", " ", "TableForm"}]}], "Input",Expres\
sionUUID->"b0e0a60a-c354-e342-bf47-87b5f4906d6f"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"24580936-acd4-5746-88f3-3558c9e2be1f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Measurement map construction", "Title",ExpressionUUID->"4df89fe5-2e07-474b-844a-f93455481df2"],

Cell["\<\
We construct the Layer 2 measurement rule as an explicit operator acting on a \
field state. \
\>", "Text",ExpressionUUID->"fd6adc05-6afe-394a-b3f0-26ee1b562e70"],

Cell[CellGroupData[{

Cell["7.1 Abstract measurement functional", "Section",ExpressionUUID->"a935cc0a-4ae9-674d-9739-d51c9423177b"],

Cell[TextData[{
 "For a state field ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalPsi]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Psi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d3b73603-faed-6045-b6a4-09dc6aa14543"],
 ", define a measurement map over a domain ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[CapitalOmega]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Omega", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "77fab1ce-4c1a-8d46-97e1-435628fbf79a"],
 " and basis functions $e_n$ by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"[", "\[CapitalPsi]", "]"}], "\[LongEqual]", 
         SubscriptBox["\[Integral]", "\[CapitalOmega]"], "\[CapitalPsi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[DifferentialD]", 
         StyleBox["x", "TI"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{M}_n[\\Psi] = \\int_\\Omega \\Psi(x) e_n(x)\\,dx.",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9380078d-53af-c349-9ae0-3eaaca6f55f2"]
}], "Text",ExpressionUUID->"da78a132-55c0-4b4a-bfba-e932798459a4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "measurementFunctional", ",", "\[Psi]State", ",", "basisFn", ",", 
    "domain"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementFunctional", "[", 
    RowBox[{"\[Psi]_", ",", "basis_", ",", "vars_List", ",", "reg_"}], "]"}], 
   ":=", "\[IndentingNewLine]", "  ", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"\[Psi]", " ", "basis"}], ",", 
     RowBox[{
      RowBox[{"Evaluate", " ", "@", " ", "Sequence"}], " ", "@@", " ", 
      "reg"}], ",", 
     RowBox[{"GenerateConditions", "->", "True"}]}], "]"}]}], ";"}]}], "Input",\
ExpressionUUID->"877de54a-1f94-c749-a9b8-f3585bf2115c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.2 One-dimensional prototype with exact basis projection", "Section",ExpressionUUID->"c1943ee4-b0ca-7047-8719-62aff55c7d70"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"x1", ",", "n", ",", "\[Psi]1", ",", "basis1", ",", "meas1"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]1", "[", "x1_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{"-", 
     RowBox[{"x1", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"basis1", "[", "n_", "]"}], "[", "x1_", "]"}], ":=", 
    RowBox[{
     RowBox[{"HermiteH", "[", 
      RowBox[{"n", ",", "x1"}], "]"}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"x1", "^", "2"}]}], "/", "2"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"meas1", "[", 
     RowBox[{"n_Integer", "?", "NonNegative"}], "]"}], ":=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Psi]1", "[", "x1", "]"}], " ", 
        RowBox[{
         RowBox[{"basis1", "[", "n", "]"}], "[", "x1", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x1", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"GenerateConditions", "->", "True"}]}], "]"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"meas1", "[", "n", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"n", ",", "0", ",", "6"}], "}"}]}], "]"}]}], "Input",ExpressionUUI\
D->"ea0a71d6-b530-8849-b608-fc60114dafe5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.3 Three-dimensional separable prototype", "Section",ExpressionUUID->"99af52b0-3c9a-cb4c-b3f3-619f628e5d83"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"x2", ",", "x3", ",", "\[Psi]3", ",", "basis3", ",", "meas3"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Psi]3", "[", 
    RowBox[{"x1_", ",", "x2_", ",", "x3_"}], "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x1", "^", "2"}], "+", 
       RowBox[{"x2", "^", "2"}], "+", 
       RowBox[{"x3", "^", "2"}]}], ")"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"basis3", "[", 
      RowBox[{"n1_", ",", "n2_", ",", "n3_"}], "]"}], "[", 
     RowBox[{"x1_", ",", "x2_", ",", "x3_"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"basis1", "[", "n1", "]"}], "[", "x1", "]"}], " ", 
     RowBox[{
      RowBox[{"basis1", "[", "n2", "]"}], "[", "x2", "]"}], " ", 
     RowBox[{
      RowBox[{"basis1", "[", "n3", "]"}], "[", "x3", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"meas3", "[", 
     RowBox[{
      RowBox[{"n1_Integer", "?", "NonNegative"}], ",", 
      RowBox[{"n2_Integer", "?", "NonNegative"}], ",", 
      RowBox[{"n3_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
    "\[IndentingNewLine]", " ", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{"Integrate", "[", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Psi]3", "[", 
         RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}], " ", 
        RowBox[{
         RowBox[{"basis3", "[", 
          RowBox[{"n1", ",", "n2", ",", "n3"}], "]"}], "[", 
         RowBox[{"x1", ",", "x2", ",", "x3"}], "]"}]}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"{", 
        RowBox[{"x1", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"{", 
        RowBox[{"x2", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"{", 
        RowBox[{"x3", ",", 
         RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"GenerateConditions", "->", "True"}]}], "\[IndentingNewLine]", 
      "  ", "]"}], "\[IndentingNewLine]", " ", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"meas3", "[", 
  RowBox[{"0", ",", "0", ",", "0"}], "]"}]}], "Input",ExpressionUUID->\
"493e1c03-517d-994c-a3c5-70ec3128bc97"],

Cell["\<\
This provides a concrete, exact measurement prototype without conflating it \
with empirical observables. \
\>", "Text",ExpressionUUID->"ff34e9c7-0d72-3447-8361-7bbfe0d69c73"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"f68118b8-d363-fc41-a754-3e235a0e3a22"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "8. Composition pipeline ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], "0"], "\[Rule]", 
         SubscriptBox[
          StyleBox["L", "TI"], "1"], "\[Rule]", 
         SubscriptBox[
          StyleBox["L", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "L_0 \\to L_1 \\to L_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "49dff9ec-3aff-1a40-9c38-70c25d325156"]
}], "Title",ExpressionUUID->"6100a7ce-0b07-024d-9387-9caf774e6aae"],

Cell["We now expose the construction as callable maps. ", "Text",ExpressionUUID->"e579ede1-f11f-df41-8727-191b51029312"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"layer0ToLayer1", ",", "layer1ToLayer2", ",", "opfPipeline"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer0ToLayer1", "[", "topology_Association", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<InputLayer0\>\"", "->", "topology"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<ActionAlgebraic\>\"", "->", "lagrangianAlgebraic"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<ActionRegularized\>\"", "->", "lagrangianReg"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<EulerSystem\>\"", "->", "eulerSystem"}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer1ToLayer2", "[", "layer1_Association", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<InputLayer1\>\"", "->", "layer1"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<MaintenanceLaw\>\"", "->", "maintenanceSystem"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<MeasurementPrototype1D\>\"", "->", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"meas1", "[", "n", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "4"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<MeasurementPrototype3DGround\>\"", "->", 
       RowBox[{"meas3", "[", 
        RowBox[{"0", ",", "0", ",", "0"}], "]"}]}]}], "\[IndentingNewLine]", 
     "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"opfPipeline", "=", 
   RowBox[{"RightComposition", "[", 
    RowBox[{"layer0ToLayer1", ",", "layer1ToLayer2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"opfPipeline", "[", "layer0", "]"}]}], "Input",ExpressionUUID->\
"ef38e0e3-6d76-6440-a0c1-802dfd1307e4"],

Cell["This makes the morphism chain explicit and inspectable. ", "Text",ExpressionUUID->"86416a98-fb33-6643-8e88-65e163f2fb48"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"d501776b-ffe5-e44c-b85f-f924fd2637ed"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Residual analysis and symbolic self-checks", "Title",ExpressionUUID->"da455cee-7b02-8841-a96d-dfbcf770becb"],

Cell["\<\
A verification-first notebook should test not only derivations but also \
substitution residuals. \
\>", "Text",ExpressionUUID->"ebd0a0ff-8f31-7741-900e-a221e7d06da4"],

Cell[CellGroupData[{

Cell["9.1 Residuals for any candidate solution", "Section",ExpressionUUID->"cd76c16b-0abc-e24d-9afc-97bbf3bcc28f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "residualVector", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"residualVector", "[", 
    RowBox[{"\[Rho]cand_", ",", "\[Chi]cand_", ",", "rcand_"}], "]"}], ":=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"SubtractSides", " ", "/@", " ", "eulerSystem"}], ")"}], " ", "/.",
      " ", 
     RowBox[{"{", "\[IndentingNewLine]", "      ", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], "->", 
        "\[Rho]cand"}], ",", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"\[Chi]", "[", 
         RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], "->", 
        "\[Chi]cand"}], ",", "\[IndentingNewLine]", "      ", 
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], "->", 
        "rcand"}]}], "\[IndentingNewLine]", "   ", "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"17b25d70-5503-6449-ad46-4a0512ad3a70"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.2 Test residual: trivial constant candidate", "Section",ExpressionUUID->"21aef4cd-da3e-2949-b19e-786e0baf4261"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"trivialResidual", "=", 
   RowBox[{"residualVector", "[", 
    RowBox[{"0", ",", "1", ",", "0"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", "trivialResidual"}], "Input",ExpressionUUID->\
"e9a71b0a-dfbd-5b49-a52e-69956f51ad7f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.3 Normed residual summary", "Section",ExpressionUUID->"d72c0bf3-d5f5-7e41-bc46-78b0da134372"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "residualNorm", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"residualNorm", "[", "vec_List", "]"}], ":=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"Total", "[", 
      RowBox[{"vec", "^", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"residualNorm", "[", "trivialResidual", "]"}]}], "Input",ExpressionUU\
ID->"417cb9ef-091f-204b-abde-a9637d157558"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.4 SolveAlways audit", "Section",ExpressionUUID->"dc306bdb-2241-6344-8f35-781d5c1355db"],

Cell["\<\
We ask under what parameter conditions the trivial candidate solves the field \
equations identically. \
\>", "Text",ExpressionUUID->"4b3aa5c7-e087-4a4e-9bff-17a70c2029a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"solveAlwaysAudit", "=", 
   RowBox[{"SolveAlways", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"residualVector", "[", 
        RowBox[{"0", ",", "1", ",", "0"}], "]"}], "==", "0"}], "]"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", "solveAlwaysAudit"}], "Input",ExpressionUUID->\
"e16f9131-f113-2444-8339-9ee5a44b295b"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"b3264806-3d0d-5941-9778-58ebf0511ee0"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Numerical experiments with explicit limitations", "Title",ExpressionUUID->"ca1a71ad-b7e7-2048-a5ab-1abcb14d38d4"],

Cell["\<\
The prior sections are symbolic. Here we add controlled numerics only where \
symbolic closure becomes unavailable. \
\>", "Text",ExpressionUUID->"8f7c39bb-4723-e947-b48f-de356725227b"],

Cell[CellGroupData[{

Cell["10.1 One-dimensional static reduction", "Section",ExpressionUUID->"9f6eb500-d259-a64e-b9a1-a20635272562"],

Cell[TextData[{
 "Impose time independence and one spatial coordinate: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[LongEqual]", "\[Rho]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], ", ", "\[Chi]", "\[LongEqual]", 
         "\[Chi]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], ", ", 
         StyleBox["R", "TI"], "\[LongEqual]", 
         StyleBox["R", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\rho=\\rho(x),\\ \\chi=\\chi(x),\\ R=R(x).",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "901d7d68-7612-9740-9d16-92f158bc4a9a"]
}], "Text",ExpressionUUID->"17afc219-c7b8-9047-be56-3b8b64418797"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"x", ",", "\[Rho]1", ",", "\[Chi]1", ",", "r1"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lag1D", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Rho]1", "[", "x", "]"}], " ", 
      RowBox[{"Log", "[", 
       RowBox[{"\[Chi]1", "[", "x", "]"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"\[Chi]1", "[", "x", "]"}], " ", 
      RowBox[{
       RowBox[{"r1", "[", "x", "]"}], "^", "2"}]}], "+", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\[Alpha]", "/", "2"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Rho]1", "'"}], "[", "x", "]"}], "^", "2"}]}], "+", 
     RowBox[{
      RowBox[{"\[Beta]", "/", "2"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Chi]1", "'"}], "[", "x", "]"}], "^", "2"}]}], "+", 
     RowBox[{
      RowBox[{"\[Mu]", "/", "2"}], " ", 
      RowBox[{
       RowBox[{
        RowBox[{"r1", "'"}], "[", "x", "]"}], "^", "2"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eq1D", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{"{", "\[IndentingNewLine]", "     ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"lag1D", ",", 
           RowBox[{"\[Rho]1", "[", "x", "]"}]}], "]"}], "-", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"lag1D", ",", 
             RowBox[{
              RowBox[{"\[Rho]1", "'"}], "[", "x", "]"}]}], "]"}], ",", "x"}], 
          "]"}]}], "==", "0"}], ",", "\[IndentingNewLine]", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"lag1D", ",", 
           RowBox[{"\[Chi]1", "[", "x", "]"}]}], "]"}], "-", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"lag1D", ",", 
             RowBox[{
              RowBox[{"\[Chi]1", "'"}], "[", "x", "]"}]}], "]"}], ",", "x"}], 
          "]"}]}], "==", "0"}], ",", "\[IndentingNewLine]", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"lag1D", ",", 
           RowBox[{"r1", "[", "x", "]"}]}], "]"}], "-", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"lag1D", ",", 
             RowBox[{
              RowBox[{"r1", "'"}], "[", "x", "]"}]}], "]"}], ",", "x"}], 
          "]"}]}], "==", "0"}]}], "\[IndentingNewLine]", "   ", "}"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"eq1D", " ", "//", " ", "TableForm"}]}], "Input",ExpressionUUID->\
"2b17a82a-be00-6541-9424-a21ebdf832f4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.2 Exact search for special solutions", "Section",ExpressionUUID->"40d764e7-f44b-684d-98c1-fa3f66f736af"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"specialExact", "=", 
   RowBox[{"DSolve", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"eq1D", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Alpha]", "->", "1"}], ",", 
        RowBox[{"\[Beta]", "->", "1"}], ",", 
        RowBox[{"\[Mu]", "->", "1"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"\[Rho]1", ",", "\[Chi]1", ",", "r1"}], "}"}], ",", "x"}], 
    "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", "specialExact"}], "Input",ExpressionUUID->\
"6bf142cb-7059-9045-89b4-cac2eb9f2872"],

Cell["\<\
If empty or unresolved, that is a meaningful result: the system resists \
closed-form integration in this reduction. \
\>", "Text",ExpressionUUID->"507622d4-ecbf-ec46-8be5-4cf2ab7c8758"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.3 Controlled boundary-value numerics", "Section",ExpressionUUID->"842406db-3af3-1647-bfb2-da478bf0c60d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"numeric1D", "=", 
   RowBox[{"NDSolveValue", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"Join", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{"eq1D", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Alpha]", "->", "1"}], ",", 
          RowBox[{"\[Beta]", "->", "1"}], ",", 
          RowBox[{"\[Mu]", "->", "1"}]}], "}"}]}], ",", "\[IndentingNewLine]",
        "    ", 
       RowBox[{"{", "\[IndentingNewLine]", "     ", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Rho]1", "[", "0", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Rho]1", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", "     ", 
         RowBox[{
          RowBox[{"\[Chi]1", "[", "0", "]"}], "==", "1"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Chi]1", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
         "\[IndentingNewLine]", "     ", 
         RowBox[{
          RowBox[{"r1", "[", "0", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"r1", "'"}], "[", "0", "]"}], "==", "0"}]}], 
        "\[IndentingNewLine]", "    ", "}"}]}], "\[IndentingNewLine]", "   ", 
      "]"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"\[Rho]1", ",", "\[Chi]1", ",", "r1"}], "}"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "2"}], "}"}], ",", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<BoundaryValues\>\"", "->", "None"}], "}"}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"WorkingPrecision", "->", "80"}], ",", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{"AccuracyGoal", "->", "40"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"PrecisionGoal", "->", "40"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"7f822966-1f54-e24d-bd77-d2f864777d54"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.4 Visualization of numerical profiles", "Section",ExpressionUUID->"b65f1bca-6547-e84e-b967-c3d17c30b12b"],

Cell[BoxData[
 RowBox[{"Plot", "[", "\[IndentingNewLine]", " ", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"numeric1D", "[", "x", "]"}], "]"}], ",", "\[IndentingNewLine]", 
   " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "2"}], "}"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<\[Rho]\>\"", ",", "\"\<\[Chi]\>\"", ",", "\"\<R\>\""}], 
       "}"}], ",", "Right"}], "]"}]}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", " ", 
   RowBox[{"ImageSize", "->", "Large"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"c0059f0f-7370-b24d-bea4-fea7e4c16b19"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.5 Residual verification of numerical solution", "Section",ExpressionUUID->"94552ad8-388d-714b-977c-6d075761fe5d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"numericResiduals", "=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"eq1D", " ", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Alpha]", "->", "1"}], ",", 
        RowBox[{"\[Beta]", "->", "1"}], ",", 
        RowBox[{"\[Mu]", "->", "1"}]}], "}"}]}], " ", "/.", " ", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Rho]1", ",", "\[Chi]1", ",", "r1"}], "}"}], "->", 
       "numeric1D"}], "]"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", "numericResiduals"}], "Input",ExpressionUUID->\
"3d8cedec-c175-154a-9ac0-74359a04a383"],

Cell["\<\
For stronger diagnostics, evaluate the left-hand sides on a dense grid. \
\>", "Text",ExpressionUUID->"5c3a9774-e783-6648-a6ff-f080d236163c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"lhs1D", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"SubtractSides", " ", "/@", " ", 
       RowBox[{"(", 
        RowBox[{"eq1D", " ", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Alpha]", "->", "1"}], ",", 
           RowBox[{"\[Beta]", "->", "1"}], ",", 
           RowBox[{"\[Mu]", "->", "1"}]}], "}"}]}], ")"}]}], ")"}], " ", "/.",
      " ", "\[IndentingNewLine]", "   ", 
     RowBox[{"Thread", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Rho]1", ",", "\[Chi]1", ",", "r1"}], "}"}], "->", 
       "numeric1D"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"residualSamples", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"Through", "[", 
        RowBox[{"lhs1D", "[", "x", "]"}], "]"}], ",", "50"}], "]"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "2", ",", "0.1"}], "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"residualSamples", " ", "//", " ", "Short"}]}], "Input",ExpressionUUI\
D->"f50301fe-b748-8e46-8525-4b5eab54a0f1"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"9b8e7ccf-e798-b149-b345-b5200b83ff67"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Review passes and audit modules", "Title",ExpressionUUID->"d466539d-b568-764d-b572-d5d741f1bba2"],

Cell["\<\
This section performs multiple independent reviews of the construction. \
\>", "Text",ExpressionUUID->"bbb01f14-6cdd-d744-91ac-7811dfecae47"],

Cell[CellGroupData[{

Cell["11.1 Dimensional/formal audit", "Section",ExpressionUUID->"d1ba381a-86af-b240-8617-20ce4b42db48"],

Cell["\<\
The original action combines terms of different possible interpretations. \
Without a dimensional assignment, formal addition is syntactic but not yet \
physically dimensionally justified. \
\>", "Text",ExpressionUUID->"d71aed25-2abf-434a-8560-a6fcf0990669"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"formalAudit", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\"\<DerivativeTermsAddedForWellPosedness\>\"", "->", "True"}], ",",
      "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<OriginalActionIsPurelyAlgebraicInFields\>\"", "->", 
      "True"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<NontrivialFieldTheoryRequiresAdditionalStructure\>\"", "->",
       "True"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<DimensionalAssignmentsProvided\>\"", "->", "False"}]}], 
    "\[IndentingNewLine]", "|>"}]}], 
  ";"}], "\[IndentingNewLine]", "formalAudit"}], "Input",ExpressionUUID->\
"62e34808-04e5-b64b-95e2-29c24543fff5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.2 Convexity/Hessian audit of algebraic density", "Section",ExpressionUUID->"cdbd3343-a0ce-0e4a-a17d-2f0118a85461"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "hessianAlg", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hessianAlg", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]s", " ", 
        RowBox[{"Log", "[", "\[Chi]s", "]"}]}], "+", 
       RowBox[{"\[Chi]s", " ", 
        RowBox[{"rs", "^", "2"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Rho]s", ",", "\[Chi]s", ",", "rs"}], "}"}], ",", "2"}], 
       "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"hessianAlg", " ", "//", " ", "MatrixForm"}]}], "Input",ExpressionUUI\
D->"d92b6344-b2e7-9b40-b2df-c4be3158c670"],

Cell["Check determinant and principal minors. ", "Text",ExpressionUUID->"21f6e89b-216d-4249-9b38-94eae523d29f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hessianAudit", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\"\<Hessian\>\"", "->", "hessianAlg"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<Determinant\>\"", "->", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"Det", "[", "hessianAlg", "]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<PrincipalMinors\>\"", "->", 
      RowBox[{"{", "\[IndentingNewLine]", "     ", 
       RowBox[{
        RowBox[{"hessianAlg", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
        "     ", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{"Det", "[", 
          RowBox[{"hessianAlg", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"1", " ", ";;", " ", "2"}], ",", 
             RowBox[{"1", " ", ";;", " ", "2"}]}], "]"}], "]"}], "]"}], "]"}],
         ",", "\[IndentingNewLine]", "     ", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{"Det", "[", "hessianAlg", "]"}], "]"}]}], 
       "\[IndentingNewLine]", "   ", "}"}]}]}], "\[IndentingNewLine]", 
    "|>"}]}], ";"}], "\[IndentingNewLine]", "hessianAudit"}], "Input",Expressi\
onUUID->"a2ec504d-8bd0-e243-a2b3-7b498dd0c5bc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.3 Conservation-law audit", "Section",ExpressionUUID->"a6b965ad-dbe2-094d-a1ba-85ce518b95c7"],

Cell["\<\
Absent explicit symmetries generating Noether currents in the regularized \
system, no conservation law should be asserted without derivation. \
\>", "Text",ExpressionUUID->"9438b8bf-213a-ea47-a379-47a42143f726"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"conservationAudit", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\"\<NoetherAnalysisPerformed\>\"", "->", "False"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<ConservationLawClaimed\>\"", "->", "False"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<Reason\>\"", 
      "->", "\"\<Symmetries not yet specified\>\""}]}], "\[IndentingNewLine]",
     "|>"}]}], ";"}], "\[IndentingNewLine]", "conservationAudit"}], "Input",Ex\
pressionUUID->"c43460fb-6f03-a24c-be9e-59d635b717e8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.4 Linear-well-posedness audit", "Section",ExpressionUUID->"1d35191b-1655-b045-b009-13c629bd3f89"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"wellPosednessAudit", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\"\<LinearizationComputed\>\"", "->", "True"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<DispersionDeterminantComputed\>\"", "->", "True"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<BackgroundConsistencyChecked\>\"", "->", "True"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<StableModesRequireParameterAndBackgroundSelection\>\"", "->",
       "True"}]}], "\[IndentingNewLine]", "|>"}]}], 
  ";"}], "\[IndentingNewLine]", "wellPosednessAudit"}], "Input",ExpressionUUID\
->"b420d9d6-4ba0-834f-ba71-d3f3a8313fd8"]
}, Open  ]],

