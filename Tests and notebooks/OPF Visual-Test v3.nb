   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"5fe53238-e99b-894c-b7af-c9f0eeb0edd6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Exact variational derivation", "Title",ExpressionUUID->"3fd6ddd8-11ad-424c-bb4e-244e777cd316"],

Cell[CellGroupData[{

Cell["3.1 Algebraic stationarity equations", "Section",ExpressionUUID->"4b88ffba-f58d-914e-8d1b-af87d2036ca8"],

Cell["\<\
For the unregularized density, stationarity gives pointwise conditions: \
\>", "CodeText",ExpressionUUID->"974eff13-e804-be46-908d-cfc5de2e30b3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"\[Rho]s", ",", "\[Chi]s", ",", "rs"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Rho]s", "=", 
   RowBox[{"Unique", "[", "\"\<\[Rho]s\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Chi]s", "=", 
   RowBox[{"Unique", "[", "\"\<\[Chi]s\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rs", "=", 
    RowBox[{"Unique", "[", "\"\<rs\>\"", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"algEquations", "=", 
   RowBox[{"Thread", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Rho]s", " ", 
         RowBox[{"Log", "[", "\[Chi]s", "]"}]}], "+", 
        RowBox[{"\[Chi]s", " ", 
         RowBox[{"rs", "^", "2"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"\[Rho]s", ",", "\[Chi]s", ",", "rs"}], "}"}], "}"}]}], 
      "]"}], "==", "0"}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", "algEquations"}], "Input",ExpressionUUID->\
"8aecfff0-b503-0642-ad00-fe17605d5903"],

Cell[TextData[{
 "Expected equations: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"log", 
         RowBox[{"(", "\[Chi]", ")"}], "\[LongEqual]", "0", ",    ", 
         FractionBox["\[Rho]", "\[Chi]"], "+", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "\[LongEqual]", "0", ",    ", "2", 
         "\[Chi]", 
         StyleBox["R", "TI"], "\[LongEqual]", "0."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\log(\\chi)=0,\\qquad \\frac{\\rho}{\\chi}+R^2=0,\\qquad 2\\chi R=0.", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "638121af-6259-2b44-89db-1b17020d6780"],
 "We solve these exactly. "
}], "Text",ExpressionUUID->"e71ee7eb-1545-fe4d-b7a0-94cf6f5687e5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"algSolve", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{"algEquations", ",", 
      RowBox[{"{", 
       RowBox[{"\[Rho]s", ",", "\[Chi]s", ",", "rs"}], "}"}], ",", "Reals"}], 
     "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "algSolve"}], "Input",Expre\
ssionUUID->"9a6d37b4-328b-1b40-a171-0d447e2a7c10"],

Cell["\<\
This provides the first rigorous consistency checkpoint: the original \
algebraic action alone collapses strongly and does not support a nontrivial \
smooth field theory without additional structure. \
\>", "Text",ExpressionUUID->"5a372adc-b928-7f4c-a850-b52f42f823cb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3.2 Euler--Lagrange equations for the regularized action", "Section",ExpressionUUID->"1d6257b8-1ad9-7b49-8439-dc5acb1b719b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "eulerEquation", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"eulerEquation", "[", 
     RowBox[{"lag_", ",", "field_"}], "]"}], ":=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"lag", ",", 
        RowBox[{"field", " ", "@@", " ", "coords4"}]}], "]"}], "-", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"lag", ",", 
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"field", " ", "@@", " ", "coords4"}], ",", "var"}], 
              "]"}]}], "]"}], ",", "var"}], "]"}], " ", "&"}], " ", "/@", " ",
         "coords4"}], "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq\[Rho]", "=", 
   RowBox[{
    RowBox[{"eulerEquation", "[", 
     RowBox[{"lagrangianReg", ",", "\[Rho]"}], "]"}], "==", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq\[Chi]", "=", 
   RowBox[{
    RowBox[{"eulerEquation", "[", 
     RowBox[{"lagrangianReg", ",", "\[Chi]"}], "]"}], "==", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eqr", "=", 
    RowBox[{
     RowBox[{"eulerEquation", "[", 
      RowBox[{"lagrangianReg", ",", "r"}], "]"}], "==", "0"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eulerSystem", "=", 
   RowBox[{"{", 
    RowBox[{"eq\[Rho]", ",", "eq\[Chi]", ",", "eqr"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"eulerSystem", " ", "//", " ", "TableForm"}]}], "Input",ExpressionUUI\
D->"25c88ad7-99d7-3c4c-a44e-4ced7ffcb6d8"],

Cell["For readability, also display them in simplified form. ", "Text",ExpressionUUID->"317131e5-7e8a-d348-90f3-a148af86c532"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eulerSystemReduced", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"eulerSystem", " ", "/.", " ", 
      RowBox[{"{", "\[IndentingNewLine]", "     ", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[Alpha]", "/", "2"}], " ", 
                 RowBox[{"gradSq", "[", "\[Rho]", "]"}]}], ",", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"\[Rho]", " ", "@@", " ", "coords4"}], ",", "#"}], 
                 "]"}]}], "]"}], ",", "#"}], "]"}], " ", "&"}], " ", "/@", 
           " ", "coords4"}], "]"}], ":>", "\[IndentingNewLine]", "      ", 
         RowBox[{"\[Alpha]", " ", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"\[Rho]", " ", "@@", " ", "coords4"}], ",", 
               RowBox[{"{", 
                RowBox[{"#", ",", "2"}], "}"}]}], "]"}], " ", "&"}], " ", "/@",
             " ", "coords4"}], "]"}]}]}], ",", "\[IndentingNewLine]", "     ", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[Beta]", "/", "2"}], " ", 
                 RowBox[{"gradSq", "[", "\[Chi]", "]"}]}], ",", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"\[Chi]", " ", "@@", " ", "coords4"}], ",", "#"}], 
                 "]"}]}], "]"}], ",", "#"}], "]"}], " ", "&"}], " ", "/@", 
           " ", "coords4"}], "]"}], ":>", "\[IndentingNewLine]", "      ", 
         RowBox[{"\[Beta]", " ", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"\[Chi]", " ", "@@", " ", "coords4"}], ",", 
               RowBox[{"{", 
                RowBox[{"#", ",", "2"}], "}"}]}], "]"}], " ", "&"}], " ", "/@",
             " ", "coords4"}], "]"}]}]}], ",", "\[IndentingNewLine]", "     ", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"\[Mu]", "/", "2"}], " ", 
                 RowBox[{"gradSq", "[", "r", "]"}]}], ",", 
                RowBox[{"D", "[", 
                 RowBox[{
                  RowBox[{"r", " ", "@@", " ", "coords4"}], ",", "#"}], 
                 "]"}]}], "]"}], ",", "#"}], "]"}], " ", "&"}], " ", "/@", 
           " ", "coords4"}], "]"}], ":>", "\[IndentingNewLine]", "      ", 
         RowBox[{"\[Mu]", " ", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"D", "[", 
              RowBox[{
               RowBox[{"r", " ", "@@", " ", "coords4"}], ",", 
               RowBox[{"{", 
                RowBox[{"#", ",", "2"}], "}"}]}], "]"}], " ", "&"}], " ", "/@",
             " ", "coords4"}], "]"}]}]}]}], "\[IndentingNewLine]", "   ", 
       "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"eulerSystemReduced", " ", "//", " ", "TraditionalForm"}]}], "Input",\
ExpressionUUID->"156dda2f-2b38-fc40-a2f6-fe3c2faedc9d"],

Cell[TextData[{
 "A more transparent manual form is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"log", 
                    RowBox[{"(", "\[Chi]", ")"}], "-", "\[Alpha] ", 
                    "\[EmptySquare]", "\[Rho]"}]], "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", "0", ","}]], "InlineFormula"], 
                " "}]]}, {
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{
                    FractionBox["\[Rho]", "\[Chi]"], "+", 
                    SuperscriptBox[
                    StyleBox["R", "TI"], "2"], "-", "\[Beta] ", 
                    "\[EmptySquare]", "\[Chi]"}]], "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", "0", ","}]], "InlineFormula"], 
                " "}]]}, {
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"2", "\[Chi]", 
                    StyleBox["R", "TI"], "-", "\[Mu] ", "\[EmptySquare]", 
                    StyleBox["R", "TI"]}]], "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell[
                 BoxData[
                  RowBox[{"\[LongEqual]", "0", ","}]], "InlineFormula"], 
                " "}]]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}\n\\log(\\chi) - \\alpha\\,\\Box \\rho &= 0,\\\\\n\
\\frac{\\rho}{\\chi} + R^2 - \\beta\\,\\Box \\chi &= 0,\\\\\n2\\chi R - \
\\mu\\,\\Box R &= 0,\n\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d5877b05-f10a-9b47-ae01-1adeef9a713b"],
 "where here ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[EmptySquare]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\Box", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1142badc-3af0-2b42-8b86-1468e49ed624"],
 " denotes the flat coordinate second-derivative sum used in the \
regularization, not necessarily the Lorentzian d'Alembertian unless a \
signature is imposed. "
}], "Text",ExpressionUUID->"4d4de46d-c624-ca44-80d9-934398ab59ab"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"bbe525c7-3f61-684f-bad4-ddd3ccb3c8c9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Existence and consistency analysis", "Title",ExpressionUUID->"27950cde-d5bf-5c43-8d2d-3f43fb1775c5"],

Cell[CellGroupData[{

Cell["4.1 Constant-field solutions", "Section",ExpressionUUID->"38d6dee1-f662-3a4e-81e8-a22146b212a9"],

Cell[TextData[{
 "Assume constant fields: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[LongEqual]", 
         SubscriptBox["\[Rho]", "0"], ", ", "\[Chi]", "\[LongEqual]", 
         SubscriptBox["\[Chi]", "0"], ", ", 
         StyleBox["R", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["r", "TI"], "0"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho=\\rho_0,\\ \\chi=\\chi_0,\\ R=r_0.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "20715b8f-271d-f04a-bc3d-f377beb3230b"],
 "Then derivative terms vanish and the equilibrium equations reduce to: "
}], "CodeText",ExpressionUUID->"6fda00a8-ae0a-be43-ace7-e52ba6c6dcc4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"constSystem", "=", 
   RowBox[{"{", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{
      RowBox[{"Log", "[", "\[Chi]0", "]"}], "==", "0"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]0", "/", "\[Chi]0"}], "+", 
       RowBox[{"r0", "^", "2"}]}], "==", "0"}], ",", "\[IndentingNewLine]", 
     "   ", 
     RowBox[{
      RowBox[{"2", " ", "\[Chi]0", " ", "r0"}], "==", "0"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"constSolve", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{"constSystem", ",", 
      RowBox[{"{", 
       RowBox[{"\[Rho]0", ",", "\[Chi]0", ",", "r0"}], "}"}], ",", "Reals"}], 
     "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "constSolve"}], "Input",Exp\
ressionUUID->"85e3c67a-d583-e04c-b029-a1654eb2a3dd"],

Cell["\<\
This exact symbolic check tests whether nontrivial homogeneous equilibria \
exist. \
\>", "Text",ExpressionUUID->"34146d8c-891f-3f45-a85b-d78546579867"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2 General reduction and hidden constraints", "Section",ExpressionUUID->"3c2da1f4-01d4-0e4b-a73b-acb5dfb003dd"],

Cell["We compute consistency conditions among the fields. ", "Text",ExpressionUUID->"1e71f578-8306-2147-bef7-bf321d281d9c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hiddenConstraints", "=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{"Reduce", "[", "\[IndentingNewLine]", "    ", 
     RowBox[{
      RowBox[{"eulerSystem", " ", "/.", " ", 
       RowBox[{"{", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Rho]", "[", 
             RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
              "x", " ", "|", " ", "y", " ", "|", " ", "z", " ", "|", " ", 
               "t"}], ",", "2"}], "}"}]}], "]"}], "->", "0"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Chi]", "[", 
             RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
              "x", " ", "|", " ", "y", " ", "|", " ", "z", " ", "|", " ", 
               "t"}], ",", "2"}], "}"}]}], "]"}], "->", "0"}], ",", 
         "\[IndentingNewLine]", "      ", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"r", "[", 
             RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
              "x", " ", "|", " ", "y", " ", "|", " ", "z", " ", "|", " ", 
               "t"}], ",", "2"}], "}"}]}], "]"}], "->", "0"}]}], 
        "\[IndentingNewLine]", "    ", "}"}]}], ",", "\[IndentingNewLine]", 
      "    ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Rho]", "[", 
         RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
        RowBox[{"\[Chi]", "[", 
         RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ",", 
        RowBox[{"r", "[", 
         RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}], "}"}], ",", 
      "Reals", ",", "\[IndentingNewLine]", "    ", 
      RowBox[{"MaxExtraConditions", "->", "All"}]}], "\[IndentingNewLine]", 
     "   ", "]"}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", "hiddenConstraints"}], "Input",ExpressionUUID->\
"2b2083b8-4388-c74f-abad-b66d79c11b98"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
4.3 Missing-variable audit relative to common physical constant sets\
\>", "Section",ExpressionUUID->"c60a3914-c1e5-9245-98e3-0a6906d93e02"],

Cell["\<\
A structural audit is performed by comparing the variables appearing in the \
action to a list of conventional constants. \
\>", "Text",ExpressionUUID->"ffacef04-621e-1d40-8ff0-5546fab7e178"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "actionVariables", ",", "standardModelLikeConstants", ",", 
    "missingVariablesAudit"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"actionVariables", "=", 
    RowBox[{"DeleteDuplicates", " ", "@", " ", 
     RowBox[{"Cases", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{"lagrangianReg", ",", "\[IndentingNewLine]", "    ", 
       RowBox[{"s_Symbol", " ", "/;", " ", 
        RowBox[{
         RowBox[{"Context", "[", "s", "]"}], "===", "\"\<Global`\>\""}]}], ",",
        "\[IndentingNewLine]", "    ", "Infinity"}], "\[IndentingNewLine]", 
      "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"standardModelLikeConstants", "=", 
   RowBox[{"{", 
    RowBox[{
    "c", ",", "h", ",", "\:0127", ",", "G", ",", "kB", ",", "e", ",", 
     "\[CurlyEpsilon]0", ",", "\[Mu]0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"missingVariablesAudit", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{"actionVariables", ",", "standardModelLikeConstants"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"<|", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"\"\<ActionVariables\>\"", "->", "actionVariables"}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<ReferenceConstants\>\"", "->", "standardModelLikeConstants"}],
    ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<Complement\>\"", "->", "missingVariablesAudit"}]}], 
  "\[IndentingNewLine]", "|>"}]}], "Input",ExpressionUUID->"2c647970-ca56-\
f741-b7c2-9ad29fcdd245"],

Cell["\<\
This audit is purely structural; it does not imply that comparison to \
Standard Model constants is mathematically decisive. \
\>", "Text",ExpressionUUID->"33b5cc38-b0e8-624d-a48e-a860ffd8dcb6"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"e63b199f-8332-3c4b-bd54-f1b7c70f96b7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Linearization about a stationary background", "Title",ExpressionUUID->"9230c7e9-1a6a-0b48-905b-9932b280863c"],

Cell[TextData[{
 "To analyze stable frequencies, we linearize around a background \
configuration: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[LongEqual]", 
         SubscriptBox["\[Rho]", "0"], "+", "\[Epsilon]", 
         StyleBox["u", "TI"], ",    ", "\[Chi]", "\[LongEqual]", 
         SubscriptBox["\[Chi]", "0"], "+", "\[Epsilon]", 
         StyleBox["v", "TI"], ",    ", 
         StyleBox["R", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["r", "TI"], "0"], "+", "\[Epsilon]", 
         StyleBox["w", "TI"], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\rho=\\rho_0+\\varepsilon u,\\qquad\n\\chi=\\chi_0+\\varepsilon \
v,\\qquad\nR=r_0+\\varepsilon w,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "82bfb163-b730-4941-8ac2-d9e68efd0cee"],
 "keeping first-order terms in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\varepsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cc8f38cf-95fc-864c-adb6-a49a803493c7"],
 ". "
}], "Text",ExpressionUUID->"af3ac28d-b246-3f44-9b24-b8848f12e53d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"\[CurlyEpsilon]", ",", "u", ",", "v", ",", "w"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linSubs", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]", "[", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ":>", 
       RowBox[{"\[Rho]0", "+", 
        RowBox[{"\[CurlyEpsilon]", " ", 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"\[Chi]", "[", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ":>", 
       RowBox[{"\[Chi]0", "+", 
        RowBox[{"\[CurlyEpsilon]", " ", 
         RowBox[{"v", "[", 
          RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"r", "[", 
        RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}], ":>", 
       RowBox[{"r0", "+", 
        RowBox[{"\[CurlyEpsilon]", " ", 
         RowBox[{"w", "[", 
          RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "]"}]}]}]}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearizedSystem", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"SubtractSides", " ", "/@", " ", "eulerSystem"}], ")"}], 
           " ", "/.", " ", "linSubs"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[CurlyEpsilon]", ",", "0", ",", "1"}], "}"}]}], "]"}], 
        "]"}], ",", "\[CurlyEpsilon]"}], "]"}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"linearizedEquations", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{"linearizedSystem", "==", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"linearizedEquations", " ", "//", " ", "TableForm"}]}], "Input",Expre\
ssionUUID->"5d086977-0e76-0a4c-b2e5-07313734000e"],

Cell[CellGroupData[{

Cell["5.1 Background compatibility conditions", "Section",ExpressionUUID->"979d82e2-7760-194a-a896-b39ef019fc22"],

Cell["\<\
For a rigorous linearization, the background should satisfy the zeroth-order \
equations. \
\>", "Text",ExpressionUUID->"2d149b05-a487-1746-bfdf-899d9484a650"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"backgroundConditions", "=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"SubtractSides", " ", "/@", " ", "eulerSystem"}], ")"}], 
           " ", "/.", " ", "linSubs"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[CurlyEpsilon]", ",", "0", ",", "0"}], "}"}]}], "]"}], 
        "]"}], ",", "\[CurlyEpsilon]", ",", "0"}], "]"}], "==", "0"}], 
    "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", "backgroundConditions"}], "Input",ExpressionUU\
ID->"09e51fc8-f3ef-fd46-a017-e2ff80472d3b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.2 Plane-wave ansatz and dispersion matrix", "Section",ExpressionUUID->"d2b06282-0518-b141-aed2-a507ebecb9e1"],

Cell[TextData[{
 "Assume perturbations of the form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["u", "TI"], ",", 
         StyleBox["v", "TI"], ",", 
         StyleBox["w", "TI"], "\[Proportional]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], "(", 
            RowBox[{
              SubscriptBox[
               StyleBox["k", "TI"], 
               StyleBox["x", "TI"]], 
              StyleBox["x", "TI"], "+", 
              SubscriptBox[
               StyleBox["k", "TI"], 
               StyleBox["y", "TI"]], 
              StyleBox["y", "TI"], "+", 
              SubscriptBox[
               StyleBox["k", "TI"], 
               StyleBox["z", "TI"]], 
              StyleBox["z", "TI"], "-", "\[Omega]", 
              StyleBox["t", "TI"]}], ")"}]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "u,v,w \\propto e^{i(k_x x+k_y y+k_z z-\\omega t)}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0a0275be-203a-534e-945b-20ea990bafe3"]
}], "Text",ExpressionUUID->"0da74f0e-62fd-0144-9c14-2653dfcd77e2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
