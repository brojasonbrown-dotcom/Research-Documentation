}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
7. Exact constant-solution verification of the regularized PDEs\
\>", "Title",ExpressionUUID->"1509e663-49c6-5a48-aa43-38ec678452ac"],

Cell["\<\
The constant branch inherited from the bare action should also solve the \
regularized PDEs because all gradients vanish. \
\>", "Text",ExpressionUUID->"6aa513ec-c114-e041-b150-362072e3329e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "constantBranch2D", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"constantBranch2D", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]f", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"\[Chi]f", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "->", "1"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"resf", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "->", "0"}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"regularizedConstantCheck", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"eulerLagrange2D", " ", "/.", " ", "constantBranch2D"}], 
   "]"}]}]}], "Input",ExpressionUUID->"f6f6efca-57ae-3342-bbbf-f942df4d54ce"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"434e9f63-534d-104c-97dd-b2fcbcb37239"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
8. Spectral linearization of the regularized PDEs around the stationary branch\
\>", "Title",ExpressionUUID->"81ea741a-d243-c84c-a755-f942101f3fc2"],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[LongEqual]", "0", "+", "\[Epsilon]", 
         StyleBox["r", "TI"], ",    ", "\[Chi]", "\[LongEqual]", "1", "+", 
         "\[Epsilon]", 
         StyleBox["c", "TI"], ",    ", 
         StyleBox["R", "TI"], "\[LongEqual]", "0", "+", "\[Epsilon]", 
         StyleBox["q", "TI"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\rho = 0 + \\epsilon r, \\qquad \\chi = 1 + \\epsilon c, \\qquad R = 0 \
+ \\epsilon q.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b0967cfa-fbd8-3e4f-a2e7-2f4e2fc5f3d8"],
 "We derive the first-order linearized equations. "
}], "Text",ExpressionUUID->"3bf8a60b-4f01-a341-9372-69b582b0b677"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "\[Epsilon]", ",", "r", ",", "c", ",", "q", ",", "linRules", ",", 
    "linearizedPDEs"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Rho]f", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "->", 
       RowBox[{"\[Epsilon]", " ", 
        RowBox[{"r", "[", 
         RowBox[{"x", ",", "y"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{
       RowBox[{"\[Chi]f", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "->", 
       RowBox[{"1", "+", 
        RowBox[{"\[Epsilon]", " ", 
         RowBox[{"c", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}]}]}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{
       RowBox[{"resf", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "->", 
       RowBox[{"\[Epsilon]", " ", 
        RowBox[{"q", "[", 
         RowBox[{"x", ",", "y"}], "]"}]}]}]}], "\[IndentingNewLine]", "}"}]}],
    ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"linearizedPDEs", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Normal", "@", 
      RowBox[{"Series", "[", 
       RowBox[{
        RowBox[{"eulerLagrange2D", " ", "/.", " ", "linRules"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Epsilon]", ",", "0", ",", "1"}], "}"}]}], "]"}]}], " ", "/.",
      " ", 
     RowBox[{"Equal", "->", "Subtract"}]}], " ", "//", " ", "Expand"}], " ", "//",
    " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"#", ",", "\[Epsilon]", ",", "1"}], "]"}], " ", "&"}], " ", "/@",
      " ", "#"}], " ", "&"}]}]}]}], "Input",ExpressionUUID->"64d5201c-83d7-\
ab40-9782-e60e63adcba0"],

Cell["Recast them as equations: ", "CodeText",ExpressionUUID->"ccd2b17e-d36a-3645-a8b9-ab884cf19624"],

Cell[BoxData[
 RowBox[{"linearizedEquations", "=", 
  RowBox[{
   RowBox[{"Thread", "[", 
    RowBox[{"linearizedPDEs", "==", "0"}], "]"}], " ", "//", " ", 
   "FullSimplify"}]}]], "Input",ExpressionUUID->"355c54a6-83ed-7444-ba0c-\
362ea6b5d1a9"],

Cell[CellGroupData[{

Cell["8.1 Plane-wave spectral substitution", "Section",ExpressionUUID->"233d6e93-99ff-4e48-bedc-ce2e0818c2d7"],

Cell[TextData[{
 "For local spectral testing, use the plane-wave ansatz ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["r", "TI"], ",", 
             StyleBox["c", "TI"], ",", 
             StyleBox["q", "TI"]}], ")"}], "\[Proportional]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], "(", 
            RowBox[{
              SubscriptBox[
               StyleBox["k", "TI"], 
               StyleBox["x", "TI"]], 
              StyleBox["x", "TI"], "+", 
              SubscriptBox[
               StyleBox["k", "TI"], 
               StyleBox["y", "TI"]], 
              StyleBox["y", "TI"]}], ")"}]], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "(r,c,q) \\propto e^{i(k_x x + k_y y)}.", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "26fbb6f0-6245-3644-b43c-ee727bbec0ba"]
}], "Text",ExpressionUUID->"af801116-9aaa-e74b-9fb6-3bb6b8051632"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "kx", ",", "ky", ",", "rr", ",", "cc", ",", "qq", ",", "planeWaveRules"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"planeWaveRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"r", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "->", 
       RowBox[{"rr", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ky", " ", "y"}]}], ")"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"c", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "->", 
       RowBox[{"cc", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ky", " ", "y"}]}], ")"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"q", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "->", 
       RowBox[{"qq", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ky", " ", "y"}]}], ")"}]}], "]"}]}]}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"spectralAlgebraicSystem", "=", "\[IndentingNewLine]", "  ", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"linearizedPDEs", " ", "/.", " ", "planeWaveRules"}], ")"}], "/", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"kx", " ", "x"}], "+", 
        RowBox[{"ky", " ", "y"}]}], ")"}]}], "]"}]}], "]"}]}]}], "Input",Expre\
ssionUUID->"f1d737f3-d992-5144-bd8f-48c29905dfe8"],

Cell["Build the coefficient matrix: ", "CodeText",ExpressionUUID->"c9e875a6-ef42-6847-8331-b49eddf62b33"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "spectralMatrix", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"spectralMatrix", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"CoefficientArrays", "[", 
     RowBox[{"spectralAlgebraicSystem", ",", 
      RowBox[{"{", 
       RowBox[{"rr", ",", "cc", ",", "qq"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}], " ", "//", " ", "Normal"}]}]}], "Input",Ex\
pressionUUID->"c247b7d7-eb78-774c-a07e-acde2f30ae1c"],

Cell["\<\
Its determinant gives the dispersion constraint for nontrivial modes: \
\>", "CodeText",ExpressionUUID->"0b0cc2e3-5ab3-fe40-8e54-1159eaf0f131"],

Cell[BoxData[
 RowBox[{"dispersionRelation", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"Det", "[", "spectralMatrix", "]"}], "]"}]}]], "Input",ExpressionUU\
ID->"f129a405-f1a8-9b43-94c5-0a332eecdb6e"],

Cell["Eigenvalue-style information: ", "CodeText",ExpressionUUID->"d005bd20-c51c-144b-8a38-b4d9abdd6995"],

Cell[BoxData[
 RowBox[{"spectralEigenvalues", "=", 
  RowBox[{
   RowBox[{"Eigenvalues", "[", "spectralMatrix", "]"}], " ", "//", " ", 
   "FullSimplify"}]}]], "Input",ExpressionUUID->"85e94e0d-bc35-b947-b6a1-\
8c12118dc539"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"19c11fa9-f86f-224f-8484-d989ec895ef2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Observable construction and measurement kernel", "Title",ExpressionUUID->"8a6ff5f9-eccf-c246-8da0-d6a592dab371"],

Cell["\<\
We now define the formal measurement map from L1 fields to observables. \
\>", "Text",ExpressionUUID->"9dd30ec6-7cdb-0d46-9e92-cb20ec251e52"],

Cell[CellGroupData[{

Cell["9.1 General measurement operator", "Section",ExpressionUUID->"569995ea-bac3-3144-9883-82b04124b733"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "measurementKernel", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementKernel", "[", 
    RowBox[{"psi_", ",", "vars_List", ",", "region_"}], "]"}], ":=", 
   RowBox[{"Integrate", "[", 
    RowBox[{"psi", ",", 
     RowBox[{"Element", "[", 
      RowBox[{"vars", ",", "region"}], "]"}]}], "]"}]}], ";"}]}], "Input",Expr\
essionUUID->"bdb0ea19-fd44-1d40-897f-77a8e052c777"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.2 Example on a bounded disk domain", "Section",ExpressionUUID->"6fb9a3d5-33ca-e841-938e-c64ca072c7cb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"diskRegion", ",", "psiExample", ",", "diskObservable"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diskRegion", "=", 
   RowBox[{"Disk", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", "a"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"psiExample", "=", 
    RowBox[{
     RowBox[{"\[Rho]f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], "+", 
     RowBox[{"\[Chi]f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], "+", 
     RowBox[{"resf", "[", 
      RowBox[{"x", ",", "y"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"diskObservable", "=", 
  RowBox[{
   RowBox[{"measurementKernel", "[", 
    RowBox[{
     RowBox[{"psiExample", " ", "/.", " ", "constantBranch2D"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", "diskRegion"}], "]"}], " ", "//", 
   " ", "FullSimplify"}]}]}], "Input",ExpressionUUID->"b96a8808-36f2-ea45-\
acd2-0519962479ea"],

Cell[TextData[{
 "Since the constant branch gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPsi]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Psi = 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "96073de2-264a-8b49-8c83-b092233e8428"],
 ", this should return the area of the disk. "
}], "Text",ExpressionUUID->"c43bb4e3-1242-d449-9920-06071856a6e2"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"5a6d7ca6-d5fd-3648-9aa4-0901bdd775e2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Composed L0 \.1a L1 \.1a L2 morphism pipeline", "Title",ExpressionUUID->"4a74ebef-7ae5-3948-9139-e29441914634"],

Cell["\<\
We now expose a callable symbolic pipeline implementing the three-layer map. \
\>", "Text",ExpressionUUID->"4271aef2-00ae-9845-b6f9-56e3d213a6d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"layer0ToLayer1", ",", "layer1ToLayer2", ",", "opfPipeline"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer0ToLayer1", "[", "geom_", "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<Geometry\>\"", "->", "geom"}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"\"\<ActionDensity\>\"", "->", 
       RowBox[{"actionDensity", "[", 
        RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<StationarityEquations\>\"", "->", 
       RowBox[{"stationarityEquations", "[", 
        RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<StationarySolutions\>\"", "->", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"stationarityEquations", "[", 
          RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "}"}], ",", 
         "Reals"}], "]"}]}]}], "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"layer1ToLayer2", "[", 
     RowBox[{"state_Association", ",", "vars_List", ",", "region_"}], "]"}], ":=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<InputState\>\"", "->", "state"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<Observable\>\"", "->", 
       RowBox[{"measurementKernel", "[", "\[IndentingNewLine]", "      ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Rho]", "+", "\[Chi]", "+", "res"}], ")"}], " ", "/.", 
          " ", 
          RowBox[{"First", "[", 
           RowBox[{"state", "[", "\"\<StationarySolutions\>\"", "]"}], 
           "]"}]}], ",", "\[IndentingNewLine]", "      ", "vars", ",", 
         "\[IndentingNewLine]", "      ", "region"}], "\[IndentingNewLine]", 
        "   ", "]"}]}]}], "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"opfPipeline", "=", 
   RowBox[{"RightComposition", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{"layer0ToLayer1", ",", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"layer1ToLayer2", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], ",", 
        RowBox[{"Disk", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}], ",", "a"}], "]"}]}], "]"}], " ", 
      "&"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID\
->"9f01deb2-2974-5c40-8709-3271480fb597"],

Cell["Execute the symbolic pipeline: ", "CodeText",ExpressionUUID->"58b8261e-8d01-0b41-9941-50d90d178898"],

Cell[BoxData[
 RowBox[{"opfPipeline", "[", 
  RowBox[{"layer0", "[", "\"\<Geometry\>\"", "]"}], "]"}]], "Input",Expression\
UUID->"1c0b2ca4-41c4-2b4a-b165-85f25214a259"],

