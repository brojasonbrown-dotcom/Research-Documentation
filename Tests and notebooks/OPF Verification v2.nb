}, Open  ]],

Cell[CellGroupData[{

Cell["14. Proof and theorem infrastructure for future extensions", "Title",ExpressionUUID->"b683ee1d-36a5-7044-8d91-53063d705647"],

Cell["\<\
The notebook can also be extended with formal proof objects for algebraic \
consequences.\
\>", "Text",ExpressionUUID->"163301a4-3aaf-ab40-aa6e-b64f94fd4af0"],

Cell["\<\
A minimal equational-proof example illustrating the workflow: \
\>", "CodeText",ExpressionUUID->"a935db8a-0bdc-e043-8abd-7a8a1485696e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"proofExample", "=", 
   RowBox[{"FindEquationalProof", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"ForAll", "[", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"g", "[", "x", "]"}], "]"}], "==", 
        RowBox[{"g", "[", 
         RowBox[{"f", "[", "x", "]"}], "]"}]}]}], "]"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"ForAll", "[", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"f", "[", "x", "]"}], "==", 
        RowBox[{"g", "[", "x", "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Input",ExpressionUUID->"4c2dba7b-bd1f-ca4b-8fdf-\
1f49909534ed"],

Cell["View the proof notebook: ", "CodeText",ExpressionUUID->"bcfbedfc-002c-5c4b-8172-ffca5b4957b5"],

Cell[BoxData[
 RowBox[{"proofExample", "[", "\"\<ProofNotebook\>\"", "]"}]], "Input",Express\
ionUUID->"825fdc63-b923-7c4a-8b0a-a259c498772b"],

Cell[TextData[{
 "Relevant functions include ",
 ButtonBox["FindEquationalProof",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/FindEquationalProof"],
 ", ",
 ButtonBox["ProofObject",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/ProofObject"],
 ", and ",
 ButtonBox["AxiomaticTheory",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/AxiomaticTheory"],
 ". "
}], "Text",ExpressionUUID->"3cf2497f-fe44-5444-b335-8e6ac1a3084c"],

