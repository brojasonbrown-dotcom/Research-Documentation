Cell[CellGroupData[{

Cell["11. Formal consistency review suite", "Title",ExpressionUUID->"b637be80-1355-8642-81b0-c042f4a058d3"],

Cell["\<\
This section gathers consistency checks in a single structured report. \
\>", "Text",ExpressionUUID->"be3734cd-d5e1-e245-9eaa-54fd6bca3102"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "consistencyReview", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"consistencyReview", ":=", 
    RowBox[{"Dataset", "@", 
     RowBox[{"{", "\[IndentingNewLine]", "   ", 
      RowBox[{
       RowBox[{"reportTest", "[", 
        RowBox[{"\"\<Layer0 geometry declared\>\"", ",", 
         RowBox[{"MatchQ", "[", 
          RowBox[{
           RowBox[{"layer0", "[", "\"\<Geometry\>\"", "]"}], ",", "_Sphere"}],
           "]"}]}], "]"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"reportTest", "[", 
        RowBox[{"\"\<Temporal mode is timeless\>\"", ",", 
         RowBox[{"temporalMode", "===", "\"\<Timeless\>\""}]}], "]"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"reportTest", "[", 
        RowBox[{"\"\<Bare action stationary equations derived\>\"", ",", 
         "elEquations"}], "]"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"reportTest", "[", 
        RowBox[{"\"\<Exact stationary solution exists\>\"", ",", 
         "exactStationarySolutions"}], "]"}], ",", "\[IndentingNewLine]", 
       "   ", 
       RowBox[{"reportTest", "[", 
        RowBox[{"\"\<Stationary point satisfies equations\>\"", ",", 
         "proofCheck"}], "]"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"reportTest", "[", 
        RowBox[{"\"\<Residual vanishes at stationary point\>\"", ",", 
         RowBox[{"residualNormAtStationary", "==", "0"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"reportTest", "[", 
        RowBox[{"\"\<Hessian available\>\"", ",", 
         RowBox[{"MatrixQ", "[", "hessianAtStationary", "]"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"reportTest", "[", 
        RowBox[{"\"\<Linear maintenance solution\>\"", ",", 
         "maintenanceSolution"}], "]"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"reportTest", "[", 
        RowBox[{"\"\<Regularized PDEs derived\>\"", ",", "eulerLagrange2D"}], 
        "]"}], ",", "\[IndentingNewLine]", "   ", 
       RowBox[{"reportTest", "[", 
        RowBox[{"\"\<Constant branch solves regularized PDEs\>\"", ",", 
         "regularizedConstantCheck"}], "]"}], ",", "\[IndentingNewLine]", 
       "   ", 
       RowBox[{"reportTest", "[", 
        RowBox[{"\"\<Spectral matrix computed\>\"", ",", 
         RowBox[{"MatrixQ", "[", "spectralMatrix", "]"}]}], "]"}], ",", 
       "\[IndentingNewLine]", "   ", 
       RowBox[{"reportTest", "[", 
        RowBox[{"\"\<Pipeline callable\>\"", ",", 
         RowBox[{
          RowBox[{"Head", "[", "opfPipeline", "]"}], "=!=", "Symbol"}]}], 
        "]"}]}], "\[IndentingNewLine]", "}"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "consistencyReview"}], \
"Input",ExpressionUUID->"6bc15e6f-eeb5-7148-a73e-62adb44b7dcf"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"1b2f196c-bc87-8a4c-8d1c-2a601184a5e8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12. Extended symbolic review passes", "Title",ExpressionUUID->"6ce746f9-fcad-0245-95f3-bd5dfd2be050"],

Cell[CellGroupData[{

Cell["12.1 Pass A: algebraic minimization of the action density", "Section",ExpressionUUID->"d0bd0fc9-989f-8e43-bdff-86f257feb046"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"actionAtStationary", ",", "actionMinimizationCheck"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"actionAtStationary", "=", 
   RowBox[{
    RowBox[{"actionDensity", "[", 
     RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}], " ", "/.", " ", 
    "stationaryPoint"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"actionMinimizationCheck", "=", 
  RowBox[{"Reduce", "[", "\[IndentingNewLine]", "   ", 
   RowBox[{
    RowBox[{
     RowBox[{"actionDensity", "[", 
      RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}], "<", 
     "actionAtStationary"}], ",", "\[IndentingNewLine]", "   ", 
    RowBox[{"{", 
     RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "}"}], ",", 
    "\[IndentingNewLine]", "   ", "Reals"}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",ExpressionUUID->"316c51a1-cc66-264e-acbd-ec4b475b6586"],

Cell["\<\
This determines whether the stationary point is a strict local or global \
minimizer. Because the Lagrangian contains a logarithm and mixed-sign terms, \
convexity is not automatic. \
\>", "Text",ExpressionUUID->"eeb12534-921e-5c45-866e-89983c90b8d1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12.2 Pass B: domain restrictions", "Section",ExpressionUUID->"4d146af1-5032-094e-ab0c-1d685dbabc51"],

Cell[TextData[{
 "The logarithm requires ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Chi]", ">", "0."}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\chi > 0.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "80fe0fee-e333-8d4b-8298-3c93fa0fc7ee"],
 "We explicitly record admissibility: "
}], "CodeText",ExpressionUUID->"de29ddd4-b644-a246-ac43-b2347a8fd11a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "admissibilityConditions", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"admissibilityConditions", "=", 
   RowBox[{"\[Chi]", ">", "0"}]}], ";"}]}], "Input",ExpressionUUID->"90e2fc40-\
6c6b-194b-a999-edc7177b3eac"],

Cell["Combine with stationarity: ", "CodeText",ExpressionUUID->"1d1585f4-74b1-b543-a16b-45427f948bf1"],

Cell[BoxData[
 RowBox[{"admissibleSolutionSet", "=", 
  RowBox[{"Reduce", "[", 
   RowBox[{
    RowBox[{"elEquations", "&&", "admissibilityConditions"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "}"}], ",", "Reals"}], 
   "]"}]}]], "Input",ExpressionUUID->"05ac035e-fb36-4846-b238-905e5590d6e7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "12.3 Pass C: singular perturbation near ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Chi]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\chi=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d4752160-1975-6643-9d91-eda830f35887"]
}], "Section",ExpressionUUID->"ae429049-d31e-bd47-b859-1a18578db609"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "singularLimit", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"singularLimit", "=", 
  RowBox[{"Limit", "[", 
   RowBox[{
    RowBox[{"actionDensity", "[", 
     RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}], ",", 
    RowBox[{"\[Chi]", "->", "0"}], ",", 
    RowBox[{"Direction", "->", "\"\<FromAbove\>\""}]}], "]"}]}]}], "Input",Exp\
ressionUUID->"b279c866-d301-8541-9f60-f6df97611eae"],

Cell["\<\
This tests whether the model admits finite action near the logarithmic \
singularity. \
\>", "Text",ExpressionUUID->"ce1f6405-3313-0148-a252-0b79f14411be"]
}, Open  ]],

Cell[CellGroupData[{

Cell["12.4 Pass D: asymptotic growth at large resolution", "Section",ExpressionUUID->"1061d19d-b4ce-b34a-a9d3-fa1addcab8be"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "largeResolutionLimit", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"largeResolutionLimit", "=", 
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{"\[Chi]", ">", "0"}], ",", 
    RowBox[{"Limit", "[", 
     RowBox[{
      RowBox[{"actionDensity", "[", 
       RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}], ",", 
      RowBox[{"res", "->", "Infinity"}]}], "]"}]}], "]"}]}]}], "Input",Express\
ionUUID->"5faf609f-c12d-0b45-b950-b762d2f5574b"],

