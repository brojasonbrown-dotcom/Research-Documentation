Cell[CellGroupData[{

Cell["13. Numerical experiments with controlled assumptions", "Title",ExpressionUUID->"3b8e590c-5dee-634d-a0a7-56fa6a443d59"],

Cell["\<\
This section is intentionally separated from the exact symbolic derivations. \
\>", "Text",ExpressionUUID->"30f35359-8121-a940-89e6-29dfbf791240"],

Cell[CellGroupData[{

Cell["13.1 Parameterized regularized energy on a square domain", "Section",ExpressionUUID->"639c0b67-b146-554e-8f24-8505ca777d49"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"squareRegion", ",", "testFields", ",", "energyFunctional2D"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"squareRegion", "=", 
    RowBox[{"Rectangle", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"energyFunctional2D", "[", 
    RowBox[{
    "\[Rho]Expr_", ",", "\[Chi]Expr_", ",", "resExpr_", ",", 
     "pars_Association"}], "]"}], ":=", 
   RowBox[{"Integrate", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"(", "\[IndentingNewLine]", "     ", 
      RowBox[{
       RowBox[{"actionDensity", "[", 
        RowBox[{"\[Rho]Expr", ",", "\[Chi]Expr", ",", "resExpr"}], "]"}], "+",
        "\[IndentingNewLine]", "     ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"pars", "[", "\"\<AlphaRho\>\"", "]"}], "/", "2"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"\[Rho]Expr", ",", "x"}], "]"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"\[Rho]Expr", ",", "y"}], "]"}], "^", "2"}]}], ")"}]}], "+",
        "\[IndentingNewLine]", "     ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"pars", "[", "\"\<AlphaChi\>\"", "]"}], "/", "2"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"\[Chi]Expr", ",", "x"}], "]"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"\[Chi]Expr", ",", "y"}], "]"}], "^", "2"}]}], ")"}]}], "+",
        "\[IndentingNewLine]", "     ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"pars", "[", "\"\<AlphaRes\>\"", "]"}], "/", "2"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"resExpr", ",", "x"}], "]"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{"resExpr", ",", "y"}], "]"}], "^", "2"}]}], ")"}]}]}], 
      "\[IndentingNewLine]", "   ", ")"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], ",", "squareRegion"}], "]"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"Assumptions", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"pars", "[", "\"\<AlphaRho\>\"", "]"}], ">", "0"}], ",", 
        RowBox[{
         RowBox[{"pars", "[", "\"\<AlphaChi\>\"", "]"}], ">", "0"}], ",", 
        RowBox[{
         RowBox[{"pars", "[", "\"\<AlphaRes\>\"", "]"}], ">", "0"}]}], 
       "}"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionU\
UID->"84e19c9c-979a-644c-a622-6ab639da6e0f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["13.2 Trial-family comparison against the constant branch", "Section",ExpressionUUID->"c7f22694-eae5-3042-9135-83029fa060b4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "trialRho", ",", "trialChi", ",", "trialRes", ",", "trialPars", ",", 
    "trialEnergy"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trialRho", "=", 
   RowBox[{"a1", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"Pi", " ", "x"}], "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"Pi", " ", "y"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trialChi", "=", 
   RowBox[{"1", "+", 
    RowBox[{"a2", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", " ", "x"}], "]"}], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", " ", "y"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"trialRes", "=", 
    RowBox[{"a3", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", " ", "x"}], "]"}], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"Pi", " ", "y"}], "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"trialPars", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<AlphaRho\>\"", "->", "ar"}], ",", 
      RowBox[{"\"\<AlphaChi\>\"", "->", "ac"}], ",", 
      RowBox[{"\"\<AlphaRes\>\"", "->", "aq"}]}], "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"trialEnergy", "=", 
  RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
   RowBox[{
    RowBox[{"energyFunctional2D", "[", 
     RowBox[{"trialRho", ",", "trialChi", ",", "trialRes", ",", "trialPars"}],
      "]"}], ",", "\[IndentingNewLine]", "   ", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ac", ">", "0"}], ",", 
       RowBox[{"ar", ">", "0"}], ",", 
       RowBox[{"aq", ">", "0"}], ",", 
       RowBox[{
        RowBox[{"-", "1"}], "<", "a2", "<", "1"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",ExpressionUUID->"6f6482a6-9ac4-\
d544-bc7b-51672e7679ef"],

Cell["Compare with the constant branch energy: ", "CodeText",ExpressionUUID->"e12bb8f9-b7d1-ba49-896f-e03c984575aa"],

Cell[BoxData[
 RowBox[{"constantEnergy", "=", 
  RowBox[{
   RowBox[{"energyFunctional2D", "[", 
    RowBox[{"0", ",", "1", ",", "0", ",", "trialPars"}], "]"}], " ", "//", 
   " ", "FullSimplify"}]}]], "Input",ExpressionUUID->"acbec586-686e-814d-8bf7-\
2d5b82ae3cf0"],

Cell["Energy difference: ", "CodeText",ExpressionUUID->"301e90dc-e490-0f4d-a9c8-c03b0423c1d5"],

Cell[BoxData[
 RowBox[{"energyDifference", "=", 
  RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "   ", 
   RowBox[{
    RowBox[{"trialEnergy", "-", "constantEnergy"}], ",", 
    "\[IndentingNewLine]", "   ", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ac", ">", "0"}], ",", 
       RowBox[{"ar", ">", "0"}], ",", 
       RowBox[{"aq", ">", "0"}], ",", 
       RowBox[{
        RowBox[{"-", "1"}], "<", "a2", "<", "1"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",ExpressionUUID->"99ae83a9-76e2-\
7943-9338-ca06d7e5c3f8"],

