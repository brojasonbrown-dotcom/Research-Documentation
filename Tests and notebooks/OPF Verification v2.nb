Cell[CellGroupData[{

Cell["\<\
15. Geometry verification infrastructure for the spherical substrate\
\>", "Title",ExpressionUUID->"63652b89-b54c-634a-aa7b-10af67a46894"],

Cell["\<\
Since the foundational geometric substrate is spherical, one can use symbolic \
geometry tools to construct and test geometric consequences independently of \
the field dynamics.\
\>", "Text",ExpressionUUID->"cda52798-71e4-5d41-b713-d85ba5d0566e"],

Cell[TextData[{
 "Example entry points include ",
 ButtonBox["GeometricScene",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/GeometricScene"],
 ", ",
 ButtonBox["GeometricAssertion",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/GeometricAssertion"],
 ", ",
 ButtonBox["GeometricTest",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/GeometricTest"],
 ", and ",
 ButtonBox["FindGeometricConjectures",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/FindGeometricConjectures"],
 "."
}], "Text",ExpressionUUID->"b543899f-d1df-4e48-a038-e983073e81cf"],

Cell["A placeholder scene illustrating rigorous geometry tooling: ", \
"CodeText",ExpressionUUID->"67763196-10e5-804a-bab2-e90b0d004819"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "geomScene", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"geomScene", "=", 
   RowBox[{"GeometricScene", "[", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"{", "\[IndentingNewLine]", "     ", 
      RowBox[{
       RowBox[{"CircleThrough", "[", 
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}], "]"}], ",", 
       "\[IndentingNewLine]", "     ", 
       RowBox[{"GeometricAssertion", "[", 
        RowBox[{"\"\<Concyclic\>\"", ",", 
         RowBox[{"{", 
          RowBox[{"p1", ",", "p2", ",", "p3", ",", "p4"}], "}"}]}], "]"}]}], 
      "\[IndentingNewLine]", "   ", "}"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"67322a78-96f9-3047-9ddb-cedf50f5426a"],

Cell["\<\
This section is infrastructural and deliberately separate from the OPF \
variational content. \
\>", "Text",ExpressionUUID->"90404170-f8a0-4644-b7c9-cf85e84d6af3"],

