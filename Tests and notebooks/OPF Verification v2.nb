Cell[CellGroupData[{

Cell["17. Recommended execution order", "Title",ExpressionUUID->"92dbee76-3581-2240-a43d-b9a6ebaf70af"],

Cell["Evaluate the notebook in the following order:", "Text",ExpressionUUID->"9be18cf8-7349-e447-bab7-2b2a3f73d10e"],

Cell["\<\
1. Sections 1--5 for exact symbolic derivation of the bare theory.\
\>", "Text",ExpressionUUID->"fc130162-9abc-c044-83f9-c521b1db7bfb"],

Cell["2. Sections 6--8 for regularized PDE verification.", "Text",ExpressionUUID->"3050cfac-1428-f445-92bc-6029e16f6dae"],

Cell["\<\
3. Sections 9--10 for observable construction and pipeline composition.\
\>", "Text",ExpressionUUID->"3b58fdcc-9071-ab49-b343-34199372049d"],

Cell["\<\
4. Sections 11--13 for internal review passes and numerical experiments.\
\>", "Text",ExpressionUUID->"5ea20feb-6002-6c4c-9ca6-431c08fdc9b0"],

Cell["\<\
5. Sections 14--15 only if formal proof or geometry infrastructure is needed. \
\>", "Text",ExpressionUUID->"425a906d-cad9-954c-8a9a-04aed7af3ad8"],

