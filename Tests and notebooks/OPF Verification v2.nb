}, Open  ]],

Cell[CellGroupData[{

Cell["16. Final canonical outputs", "Title",ExpressionUUID->"081a1411-3e65-184a-8895-c6affd1ca611"],

Cell[CellGroupData[{

Cell["16.1 Bare-action canonical result", "Section",ExpressionUUID->"9e421c0d-5cc1-5146-9b0e-d70cb1e24852"],

Cell["\<\
The strict real stationary solution of the supplied action is: \
\>", "CodeText",ExpressionUUID->"8cf22aed-12df-334f-9d90-6ae00e909d72"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"canonicalBareResult", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<ActionDensity\>\"", "->", 
       RowBox[{"actionDensity", "[", 
        RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<DomainCondition\>\"", "->", 
       RowBox[{"(", 
        RowBox[{"\[Chi]", ">", "0"}], ")"}]}], ",", "\[IndentingNewLine]", 
      "   ", 
      RowBox[{"\"\<StationaryEquations\>\"", "->", "elEquations"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<RealStationarySolution\>\"", "->", "stationaryPoint"}], ",",
       "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<ResidualAtSolution\>\"", "->", "residualAtStationary"}], ",",
       "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<HessianAtSolution\>\"", "->", "hessianAtStationary"}], ",",
       "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<EigenvaluesAtSolution\>\"", "->", 
       RowBox[{"Eigenvalues", "[", "hessianAtStationary", "]"}]}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "canonicalBareResult"}], \
"Input",ExpressionUUID->"88386320-14ac-7541-8900-4c39aa0b5ba2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["16.2 Regularized-PDE canonical result", "Section",ExpressionUUID->"9bc8a6b4-7d81-e34c-8eb1-4c551e75030e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"canonicalRegularizedResult", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<RegularizedLagrangian2D\>\"", "->", "regLagrangian2D"}], ",",
       "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<EulerLagrangeEquations\>\"", "->", "eulerLagrange2D"}], ",",
       "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<ConstantSolutionCheck\>\"", "->", 
       "regularizedConstantCheck"}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<LinearizedEquations\>\"", "->", "linearizedEquations"}], ",",
       "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<SpectralMatrix\>\"", "->", "spectralMatrix"}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<DispersionRelation\>\"", "->", "dispersionRelation"}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", \
"canonicalRegularizedResult"}], "Input",ExpressionUUID->"3f4354e1-954c-aa46-\
a45e-5c844b617902"],

