Cell[CellGroupData[{

Cell["1. Formal statement of the framework", "Title",ExpressionUUID->"168c4557-e93b-e446-995d-8f2fce8f7063"],

Cell[CellGroupData[{

Cell["1.1 Layer L0: nothingness geometry", "Section",ExpressionUUID->"10a96483-581a-fb47-b84a-60977fd52acc"],

Cell[TextData[{
 "We formalize the geometric substrate as a sphere together with a \
boundary-duality marker carrying the two special labels 0 and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Infinity]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\infty", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a45c3daa-ac46-7547-8fad-0c4e1d0c3748"],
 ". "
}], "Text",ExpressionUUID->"03c0cee6-6a93-ec4c-be15-4dc2b76f0aa9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "layer0", ",", "boundaryDuality", ",", "temporalMode", ",", "substrate"}],
     "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"layer0", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"\"\<Geometry\>\"", "->", 
       RowBox[{"Sphere", "[", "]"}]}], ",", "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<BoundaryDuality\>\"", "->", 
       RowBox[{"<|", 
        RowBox[{"\"\<Vertices\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"0", ",", "Infinity"}], "}"}]}], "|>"}]}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<TemporalMode\>\"", "->", "\"\<Timeless\>\""}], ",", 
      "\[IndentingNewLine]", "   ", 
      RowBox[{"\"\<Substrate\>\"", "->", "\"\<EmptySpacetime\>\""}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"boundaryDuality", "=", 
   RowBox[{"layer0", "[", "\"\<BoundaryDuality\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"temporalMode", "=", 
   RowBox[{"layer0", "[", "\"\<TemporalMode\>\"", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"substrate", "=", 
   RowBox[{"layer0", "[", "\"\<Substrate\>\"", "]"}]}], ";"}]}], "Input",Expre\
ssionUUID->"972fa34b-9062-1a41-9b69-ab0a6352bec9"],

Cell["Basic verification object: ", "CodeText",ExpressionUUID->"a0fe5f13-1ff5-5d4e-b3ab-73a9a7490771"],

Cell[BoxData["layer0"], "Input",ExpressionUUID->"23bd5d11-fd21-2443-a8bc-5b587a5efb4d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.2 Layer L1: symbolic field content", "Section",ExpressionUUID->"71e66949-d9d8-c744-8ed3-0c18e26e1358"],

Cell[TextData[{
 "The primary field is a triadic state variable ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[CapitalPsi]", 
         RowBox[{"[", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"]}], "]"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\Psi[\\rho,\\chi,R],", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "936c5a16-3f25-0349-b959-e319024685ef"],
 "where: "
}], "Text",ExpressionUUID->"f73cee2e-463f-6f4a-a9a1-13b80375ebad"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Rho]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "46708d44-1975-ea4c-b5cf-b4770795623b"],
 " is information density,"
}], "Item",ExpressionUUID->"ca6d01c8-1296-9d44-b269-1470f06bc533"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Chi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\chi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1c4721ec-23b4-ce40-bf62-7b3f55ddd096"],
 " is field complexity,"
}], "Item",ExpressionUUID->"ec786551-c672-6141-a22a-7d67a45e17e8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f27d33d5-b248-8348-ac2d-bd8a531ae05b"],
 " is observational resolution."
}], "Item",ExpressionUUID->"fc842eca-da72-a14e-869f-bfd1eab5c78a"],

Cell["We implement these as scalar fields over a spatial domain. ", "Text",ExpressionUUID->"66cda7e5-0090-8f45-b161-9cbcf6636fdd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "x", ",", "y", ",", "z", ",", "\[CapitalOmega]", ",", "\[Rho]", ",", 
    "\[Chi]", ",", "res", ",", "coords2D", ",", "coords3D"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords2D", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coords3D", "=", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}]}], "Input",ExpressionUUI\
D->"ec7d7325-4685-ec49-b3b9-5e3c27cafb1c"],

Cell[TextData[{
 "Define the L1 action density from the supplied variational principle: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"]}], ")"}], "\[LongEqual]", "\[Rho]", "log", 
         RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{L}(\\rho,\\chi,R) = \\rho\\log(\\chi) + \\chi R^2.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8b64b83a-caf0-6348-937f-8bc98d9ab625"]
}], "Text",ExpressionUUID->"671f73c0-6187-0049-acdd-4063738d685f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "actionDensity", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"actionDensity", "[", 
    RowBox[{"\[Rho]_", ",", "\[Chi]_", ",", "res_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Rho]", " ", 
     RowBox[{"Log", "[", "\[Chi]", "]"}]}], "+", 
    RowBox[{"\[Chi]", " ", 
     RowBox[{"res", "^", "2"}]}]}]}], ";"}]}], "Input",ExpressionUUID->\
"cc9f5b5f-1660-d04f-af1e-9e61ce9e7292"],

Cell["\<\
For field-theoretic derivations we promote the quantities to fields over \
coordinates: \
\>", "CodeText",ExpressionUUID->"78638df2-8b77-4f4f-b4f7-41ba41bdd8f8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "\[Rho]f", ",", "\[Chi]f", ",", "resf", ",", "lagrangian2D", ",", 
     "lagrangian3D"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lagrangian2D", "=", 
   RowBox[{"actionDensity", "[", 
    RowBox[{
     RowBox[{"\[Rho]f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"\[Chi]f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"resf", "[", 
      RowBox[{"x", ",", "y"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lagrangian3D", "=", 
   RowBox[{"actionDensity", "[", 
    RowBox[{
     RowBox[{"\[Rho]f", "[", 
      RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
     RowBox[{"\[Chi]f", "[", 
      RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
     RowBox[{"resf", "[", 
      RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], "]"}]}], ";"}]}], "Input",Ex\
pressionUUID->"64dbdfee-a86b-e942-aad2-5146519e3492"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1.3 Layer L2: measured reality", "Section",ExpressionUUID->"bc9a9235-6e1a-0a45-8587-60df35494560"],

Cell["\<\
Measured observables are defined as integrated functionals of the Layer L1 \
state over a chosen eigenbasis or domain. \
\>", "Text",ExpressionUUID->"42a96194-56b7-5247-afcd-e59dea17774b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "measurementFunctional", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementFunctional", "[", 
    RowBox[{"psi_", ",", "vars_List", ",", 
     RowBox[{"region_", ":", " ", "Automatic"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"region", "===", "Automatic"}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"Integrate", "[", 
      RowBox[{"psi", ",", 
       RowBox[{"Sequence", " ", "@@", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], " ", "&"}], 
          " ", "/@", " ", "vars"}], ")"}]}]}], "]"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"Integrate", "[", 
      RowBox[{"psi", ",", 
       RowBox[{"Element", "[", 
        RowBox[{"vars", ",", "region"}], "]"}]}], "]"}]}], 
    "\[IndentingNewLine]", "  ", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"4d2b9796-d231-6644-99ed-796e978877ba"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"341fc4c2-7a29-ad48-8639-d7977d887607"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Variational derivation of the L1 field equations", "Title",ExpressionUUID->"26ae45bf-d550-f048-81cb-76fff3f98371"],

Cell[CellGroupData[{

Cell["2.1 Euler--Lagrange stationarity conditions", "Section",ExpressionUUID->"12d67a7a-aec7-7d4f-be4f-10709b683b28"],

Cell[TextData[{
 "Because the supplied action density contains no derivatives of the fields, \
the Euler--Lagrange equations reduce to algebraic stationarity conditions: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["L", "TI"]}], 
          RowBox[{"\[PartialD]", "\[Rho]"}]], "\[LongEqual]", "0", ",    ", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["L", "TI"]}], 
          RowBox[{"\[PartialD]", "\[Chi]"}]], "\[LongEqual]", "0", ",    ", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            StyleBox["L", "TI"]}], 
          RowBox[{"\[PartialD]", 
            StyleBox["R", "TI"]}]], "\[LongEqual]", "0."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\frac{\\partial \\mathcal{L}}{\\partial \\rho} = 0,\n\\qquad\n\
\\frac{\\partial \\mathcal{L}}{\\partial \\chi} = 0,\n\\qquad\n\
\\frac{\\partial \\mathcal{L}}{\\partial R} = 0.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c39491c5-9a5f-2047-bd26-504064c07e2f"]
}], "Text",ExpressionUUID->"0ab73d3e-d70c-2f46-8d9b-0e13b1b46408"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "stationarityEquations", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stationarityEquations", "[", 
     RowBox[{"\[Rho]_", ",", "\[Chi]_", ",", "res_"}], "]"}], ":=", 
    RowBox[{"Thread", "[", "\[IndentingNewLine]", "   ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"actionDensity", "[", 
         RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "}"}], "}"}]}], 
       "]"}], "==", "0"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"elEquations", "=", 
  RowBox[{"stationarityEquations", "[", 
   RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}]}]}], "Input",Expressio\
nUUID->"92647a9b-a989-7347-be22-34194869545f"],

Cell["Expected output: ", "CodeText",ExpressionUUID->"b622330f-ba37-9749-b2e7-c2184863d035"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Log", "[", "\[Chi]", "]"}], " ", "==", " ", "0"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Rho]", "/", "\[Chi]"}], " ", "+", " ", 
      RowBox[{"res", "^", "2"}]}], " ", "==", " ", "0"}], ",", " ", 
    RowBox[{
     RowBox[{"2", " ", "\[Chi]", " ", "res"}], " ", "==", " ", "0"}]}], "}"}],
   " ", "*)"}]], "Input",ExpressionUUID->"1a713214-59c8-6347-a2fd-\
215c778cbf1b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.2 Exact symbolic solution of the stationarity system", "Section",ExpressionUUID->"6590a159-f191-1349-8e37-2c75550a3c84"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "exactStationarySolutions", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"exactStationarySolutions", "=", 
  RowBox[{"FullSimplify", "@", 
   RowBox[{"Solve", "[", 
    RowBox[{"elEquations", ",", 
     RowBox[{"{", 
      RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "}"}], ",", "Reals"}], 
    "]"}]}]}]}], "Input",ExpressionUUID->"f17e32e7-757f-c747-8506-\
1fc011221faa"],

Cell["\<\
This derives the exact stationary branch implied by the action. \
\>", "Text",ExpressionUUID->"b3089ef3-14f4-434d-9238-b2028c69d9bf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2.3 Interpretation of the exact branch", "Section",ExpressionUUID->"61872d5f-aff4-ac41-9733-fa345c7418ac"],

Cell["From the symbolic system: ", "Text",ExpressionUUID->"bc32df37-ea94-7546-b317-fa0eecc9083c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"log", 
         RowBox[{"(", "\[Chi]", ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\log(\\chi)=0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "048b0b2d-3f30-574c-a894-ebc7b239318b"],
 " implies ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Chi]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\chi=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eeb5d4bb-727c-084b-af4b-5ab877aeb595"],
 ","
}], "Item",ExpressionUUID->"aa8849e3-5d55-514f-a4f2-17b39b436bcd"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"2", "\[Chi]", 
         StyleBox["R", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "2\\chi R=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c0380d73-052a-5e47-b39c-0697e3fd656c"],
 " then gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "R=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c34f25d7-2351-e347-b94f-48e864fdbd13"],
 " because ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Chi]", "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\chi=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5a5deb6c-4eec-9d41-b293-b09182d3b1d5"],
 ","
}], "Item",ExpressionUUID->"b2bbd995-efaf-1142-a065-573ad9bc7e1b"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "/", "\[Chi]", "+", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\rho/\\chi + R^2 = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "01c5c6f7-9ab8-b245-8281-7c02b2deac2d"],
 " gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\rho=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4a135c6b-77cc-7240-aaa0-5d2073f866af"],
 "."
}], "Item",ExpressionUUID->"3a9471e4-4efa-7643-b646-05314422f478"],

Cell[TextData[{
 "Thus the strict stationary point of the stated action is the unique real \
branch ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["R", "TI"]}], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"0", ",", "1", ",", "0"}], ")"}], "."}], TraditionalForm], 
     "errors" -> {}, "input" -> "(\\rho,\\chi,R)=(0,1,0).", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41a7574b-b4f2-974a-a909-b489b46fb250"],
 "We verify this directly: "
}], "CodeText",ExpressionUUID->"2bd345d5-14a4-2449-ab9d-219295181c7a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"stationaryPoint", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Rho]", "->", "0"}], ",", 
     RowBox[{"\[Chi]", "->", "1"}], ",", 
     RowBox[{"res", "->", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{"elEquations", " ", "/.", " ", "stationaryPoint"}], "]"}]}], "Input",\
ExpressionUUID->"df5b8df9-8910-9e49-8cef-e31a317d4167"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"f9524cb6-0f90-a647-84c0-0818cada5831"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
3. Missing-variable analysis relative to standard physics parameters\
\>", "Title",ExpressionUUID->"f2a8f31c-911b-d541-ba11-0d4ce45ef85f"],

Cell["\<\
The framework requests a comparison between variables in the L1 action and \
standard-model constants.\
\>", "Text",ExpressionUUID->"3301e830-9751-bc45-931f-0aca5d686278"],

Cell[TextData[{
 "Because the action only contains the formal symbols ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
         StyleBox["R", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho,\\chi,R", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "09ae9eee-3583-9149-be8d-c0a8bc4547ba"],
 ", the complement relative to a chosen list of conventional constants is \
simply the set of OPF variables not identified with those constants. "
}], "Text",ExpressionUUID->"b0343f19-fda7-184e-b31a-c95b0e3340ae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "opfVariables", ",", "standardPhysicsSymbols", ",", "missingVariables"}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"opfVariables", "=", 
   RowBox[{"{", 
    RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"standardPhysicsSymbols", "=", 
   RowBox[{"{", 
    RowBox[{
    "c", ",", "\[HBar]", ",", "G", ",", "kB", ",", "e", ",", "me", ",", 
     "mp"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"missingVariables", "=", 
  RowBox[{"Complement", "[", 
   RowBox[{"opfVariables", ",", "standardPhysicsSymbols"}], "]"}]}]}], "Input",\
ExpressionUUID->"189fcf1e-e431-ef44-9fe6-8e1469541bca"],

Cell["\<\
We also construct a generic solve-always consistency check for the field \
equations: \
\>", "CodeText",ExpressionUUID->"eb0bc5c9-3f6c-c442-97f9-1c1e8102ed3a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "solveAlwaysCheck", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"solveAlwaysCheck", "=", 
  RowBox[{"SolveAlways", "[", "\[IndentingNewLine]", "   ", 
   RowBox[{
    RowBox[{"And", " ", "@@", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Subtract", " ", "@@@", " ", "elEquations"}], "==", "0"}], 
      ")"}]}], ",", "\[IndentingNewLine]", "   ", 
    RowBox[{"{", 
     RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "}"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",ExpressionUUID->"447c02f0-660c-\
384a-929f-7fdb43377b28"],

Cell["\<\
Since the equations are not identities in the variables, this check is \
expected to be restrictive rather than universal. \
\>", "Text",ExpressionUUID->"9853b485-2329-8044-845f-eb15dc6bcfdf"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"34f15869-5272-224a-a923-cd5b9d605d2c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Local stability and spectral analysis", "Title",ExpressionUUID->"60ec2e38-c022-a847-8fdb-da68cb816ae1"],

Cell[CellGroupData[{

Cell["4.1 Hessian analysis at the stationary point", "Section",ExpressionUUID->"48c1a17a-fcfb-b64c-9009-03d795e62d09"],

Cell["\<\
For an action density without derivative terms, the local stability is \
governed by the Hessian matrix of second derivatives. \
\>", "Text",ExpressionUUID->"ac66ae9e-56aa-c04b-b447-0da84b809bf9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "hessian", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"hessian", "=", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"actionDensity", "[", 
     RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "}"}], ",", "2"}], 
     "}"}]}], "]"}]}]}], "Input",ExpressionUUID->"446e7fd5-5bfa-ab42-a162-\
06f0934bacbc"],

Cell["Evaluate at the stationary point: ", "CodeText",ExpressionUUID->"47540d2c-7532-fe45-a8f3-2658ef283815"],

Cell[BoxData[
 RowBox[{"hessianAtStationary", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"hessian", " ", "/.", " ", "stationaryPoint"}], "]"}]}]], "Input",E\
xpressionUUID->"6c998626-fdc5-e54e-b20d-b0c36085bee3"],

Cell["Compute eigenvalues: ", "CodeText",ExpressionUUID->"91352ec0-e688-4f47-8fb7-e96ee10fb7ed"],

Cell[BoxData[
 RowBox[{"spectralData", "=", 
  RowBox[{"Eigensystem", "[", "hessianAtStationary", "]"}]}]], "Input",Express\
ionUUID->"b0c1c9fb-68fd-fb47-86ba-7457a26197e8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2 Interpretation of spectral branches", "Section",ExpressionUUID->"a51a2a44-2d9c-3b4d-8f5c-5df9fb2d0727"],

Cell["\<\
The eigenvalues determine whether the stationary point is locally minimizing, \
maximizing, or saddle-like. Any zero eigenvalues indicate flat directions in \
the bare action density.\
\>", "Text",ExpressionUUID->"02c0fe2c-a06f-2947-bb50-912d1b700801"],

Cell["A test summary object: ", "CodeText",ExpressionUUID->"50f32382-7cfc-2942-924d-0968bbcb016a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"stabilitySummary", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"\"\<StationaryPoint\>\"", "->", "stationaryPoint"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<Hessian\>\"", "->", "hessianAtStationary"}], ",", 
     "\[IndentingNewLine]", "   ", 
     RowBox[{"\"\<EigenSystem\>\"", "->", "spectralData"}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",ExpressionUUID->\
"fb88a3b9-d91a-e949-864d-e1702e8e26f0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.3 Linearized maintenance dynamics", "Section",ExpressionUUID->"1a09b672-9a20-7346-8696-268efb46a736"],

Cell[TextData[{
 "The framework specifies a maintenance operator ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["u", "TI"]}], 
          RowBox[{
            StyleBox["d", "TI"], 
            StyleBox["t", "TI"]}]], "+", "\[CapitalGamma]", 
         StyleBox["u", "TI"], "\[LongEqual]", "0."}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\frac{d u}{dt} + \\Gamma u = 0.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3f7ad579-3ffa-2a41-b1fe-267b33f03a02"],
 "We solve this exactly for a generic observable mode ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["u", "TI"], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "u(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bc852f24-a4df-dc4d-b4ac-5ad309e1d6fe"],
 ". "
}], "Text",ExpressionUUID->"e5a7d564-28c8-0c45-b229-4d1decfe3234"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "u", ",", "t", ",", "\[CapitalGamma]", ",", "maintenanceEquation", ",", 
    "maintenanceSolution"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maintenanceEquation", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"u", "'"}], "[", "t", "]"}], "+", 
     RowBox[{"\[CapitalGamma]", " ", 
      RowBox[{"u", "[", "t", "]"}]}]}], "==", "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"maintenanceSolution", "=", 
  RowBox[{"DSolveValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"maintenanceEquation", ",", 
      RowBox[{
       RowBox[{"u", "[", "0", "]"}], "==", "u0"}]}], "}"}], ",", "u", ",", 
    "t"}], "]"}]}]}], "Input",ExpressionUUID->"9b35ff30-9969-5e42-b917-\
8249c1ca90f8"],

Cell[TextData[{
 "This yields ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["u", "TI"], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["u", "TI"], "0"], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"-", "\[CapitalGamma]", 
            StyleBox["t", "TI"]}]], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "u(t) = u_0 e^{-\\Gamma t}.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cf394696-ae6e-af41-b208-7f82d937b63f"],
 "Undamped harmonic modes require purely imaginary eigenvalues in a \
second-order or Hamiltonian-type system; the first-order maintenance equation \
instead yields exponential decay, neutrality, or growth depending on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[GothicCapitalR]", "(", "\[CapitalGamma]", ")"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\Re(\\Gamma)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dda07c15-f4ee-1548-8766-769cbe7c24ee"],
 "."
}], "Text",ExpressionUUID->"d42d8eac-4c8d-264b-9150-1f40cc154ffa"],

Cell["We classify these cases symbolically: ", "CodeText",ExpressionUUID->"096e3e10-68ed-914f-9397-56d6c09caf18"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "maintenanceClassification", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"maintenanceClassification", "=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", "\[IndentingNewLine]", "   ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Decay\>\"", ",", 
       RowBox[{
        RowBox[{"Re", "[", "\[CapitalGamma]", "]"}], ">", "0"}]}], "}"}], ",",
      "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<Neutral\>\"", ",", 
       RowBox[{
        RowBox[{"Re", "[", "\[CapitalGamma]", "]"}], "==", "0"}]}], "}"}], ",",
      "\[IndentingNewLine]", "   ", 
     RowBox[{"{", 
      RowBox[{"\"\<Growth\>\"", ",", 
       RowBox[{
        RowBox[{"Re", "[", "\[CapitalGamma]", "]"}], "<", "0"}]}], "}"}]}], 
    "\[IndentingNewLine]", "}"}], "]"}]}]}], "Input",ExpressionUUID->\
"1629eaf0-42d4-5a42-adf1-6ad21ac39093"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"6f316034-d824-e94c-aabd-8070e6da42b3"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Residual analysis and formal verification obligations", "Title",ExpressionUUID->"1d5fa9f2-0dda-a54f-b860-8b1cebda87a4"],

Cell[CellGroupData[{

Cell["5.1 Residuals of the Euler stationarity equations", "Section",ExpressionUUID->"6364413b-b807-a14a-be6b-7ee805746058"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "residualVector", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"residualVector", "[", 
     RowBox[{"\[Rho]_", ",", "\[Chi]_", ",", "res_"}], "]"}], ":=", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"actionDensity", "[", 
       RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "}"}], "}"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"residualAtStationary", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"residualVector", "[", 
     RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}], " ", "/.", " ", 
    "stationaryPoint"}], "]"}]}]}], "Input",ExpressionUUID->"a004eebf-3050-\
8d4e-9e18-2080837c04ef"],

Cell["Residual norm: ", "CodeText",ExpressionUUID->"e40cefac-b0b5-3e46-a546-5647ce67e7f7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "residualNorm", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"residualNorm", "[", 
    RowBox[{"\[Rho]_", ",", "\[Chi]_", ",", "res_"}], "]"}], ":=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Norm", "[", 
     RowBox[{"residualVector", "[", 
      RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"residualNormAtStationary", "=", 
  RowBox[{
   RowBox[{"residualNorm", "[", 
    RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "]"}], " ", "/.", " ", 
   "stationaryPoint"}]}]}], "Input",ExpressionUUID->"7aa06989-85c9-bd42-8b6f-\
851598b19285"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.2 Exact proof-style verification for the stationary branch", "Section",ExpressionUUID->"c12a6e0e-d1bd-e449-8664-cc757c0935d3"],

Cell["\<\
We verify that the derived branch indeed satisfies the equations. \
\>", "Text",ExpressionUUID->"ce913f42-fab6-6c47-92b8-77ee1572db7a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "proofCheck", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"proofCheck", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"And", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{"elEquations", " ", "/.", " ", "stationaryPoint"}], ")"}]}], 
   "]"}]}]}], "Input",ExpressionUUID->"6c436df6-6edb-a945-8f4b-eb6962966a9e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.3 Logical implication check", "Section",ExpressionUUID->"e67b98ba-4fa5-1345-b9cf-264cbb929c48"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "logicalReduction", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"logicalReduction", "=", 
  RowBox[{"Reduce", "[", 
   RowBox[{"elEquations", ",", 
    RowBox[{"{", 
     RowBox[{"\[Rho]", ",", "\[Chi]", ",", "res"}], "}"}], ",", "Reals"}], 
   "]"}]}]}], "Input",ExpressionUUID->"2bc0e9a5-50cc-9446-b734-cb85a10057ed"],

Cell["\<\
This is the rigorous canonical representation of all real stationary \
solutions implied by the action. \
\>", "Text",ExpressionUUID->"dd57658d-5e8e-5c42-9ef0-fea5975c7652"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"ef611a6f-2338-fe4d-95ca-b2975096d8aa"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Domain-regularized field model for nontrivial PDE testing", "Title",ExpressionUUID->"a0fec3b5-b4db-6e40-993e-744810532051"],

Cell[TextData[{
 "The supplied action density contains no derivatives and therefore does not \
generate a genuine PDE system. To support verification-first PDE experiments \
while preserving the original stationary content, we introduce a ",
 StyleBox["regularized extension",
  FontWeight->Bold],
 " with gradient penalties: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["L", "TI"], 
          StyleBox["reg", FontSlant -> "Plain"]], "\[LongEqual]", "\[Rho]", 
         "log", 
         RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi]", 
         SuperscriptBox[
          StyleBox["R", "TI"], "2"], "+", 
         FractionBox[
          SubscriptBox["\[Alpha]", "\[Rho]"], "2"], "|", "\[Del]", "\[Rho]", 
         SuperscriptBox["|", "2"], "+", 
         FractionBox[
          SubscriptBox["\[Alpha]", "\[Chi]"], "2"], "|", "\[Del]", "\[Chi]", 
         SuperscriptBox["|", "2"], "+", 
         FractionBox[
          SubscriptBox["\[Alpha]", 
           StyleBox["R", "TI"]], "2"], "|", "\[Del]", 
         StyleBox["R", "TI"], 
         SuperscriptBox["|", "2"], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{L}_{\\mathrm{reg}} = \\rho\\log(\\chi) + \\chi R^2 + \
\\frac{\\alpha_\\rho}{2}|\\nabla \\rho|^2 + \\frac{\\alpha_\\chi}{2}|\\nabla \
\\chi|^2 + \\frac{\\alpha_R}{2}|\\nabla R|^2.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "955426fe-2535-354b-ae9e-d56abab7c0f8"],
 "This section is explicitly an ",
 StyleBox["analytic extension for well-posed PDE verification",
  FontWeight->Bold],
 ", not part of the bare action unless adopted as an additional axiom. "
}], "Text",ExpressionUUID->"894ff9d0-d5a3-0b40-859f-27b305538305"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "\[Alpha]\[Rho]", ",", "\[Alpha]\[Chi]", ",", "\[Alpha]res", ",", 
     "gradSq2D", ",", "regLagrangian2D"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gradSq2D", "[", "f_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "^", "2"}], "+", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], "^", "2"}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"regLagrangian2D", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{"actionDensity", "[", 
     RowBox[{
      RowBox[{"\[Rho]f", "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", 
      RowBox[{"\[Chi]f", "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", 
      RowBox[{"resf", "[", 
       RowBox[{"x", ",", "y"}], "]"}]}], "]"}], "+", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Alpha]\[Rho]", "/", "2"}], ")"}], " ", 
     RowBox[{"gradSq2D", "[", "\[Rho]f", "]"}]}], "+", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Alpha]\[Chi]", "/", "2"}], ")"}], " ", 
     RowBox[{"gradSq2D", "[", "\[Chi]f", "]"}]}], "+", "\[IndentingNewLine]", 
    "  ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Alpha]res", "/", "2"}], ")"}], " ", 
     RowBox[{"gradSq2D", "[", "resf", "]"}]}]}]}], ";"}]}], "Input",Expression\
UUID->"ea00e84d-dbab-7a4f-9d47-1f1f9451bf52"],

Cell["Compute formal Euler--Lagrange PDEs: ", "CodeText",ExpressionUUID->"13084b9b-e233-f445-86a5-3e272c139ed3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "eulerLagrange2D", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"eulerLagrange2D", "=", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"regLagrangian2D", ",", 
         RowBox[{"\[Rho]f", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], "]"}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"regLagrangian2D", ",", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"\[Rho]f", "[", 
              RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}]}], "]"}], ",",
          "x"}], "]"}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"regLagrangian2D", ",", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"\[Rho]f", "[", 
              RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}], "]"}], ",",
          "y"}], "]"}]}], "==", "0"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"regLagrangian2D", ",", 
         RowBox[{"\[Chi]f", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], "]"}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"regLagrangian2D", ",", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"\[Chi]f", "[", 
              RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}]}], "]"}], ",",
          "x"}], "]"}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"regLagrangian2D", ",", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"\[Chi]f", "[", 
              RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}], "]"}], ",",
          "y"}], "]"}]}], "==", "0"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"regLagrangian2D", ",", 
         RowBox[{"resf", "[", 
          RowBox[{"x", ",", "y"}], "]"}]}], "]"}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"regLagrangian2D", ",", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"resf", "[", 
              RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}]}], "]"}], ",",
          "x"}], "]"}], "-", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"regLagrangian2D", ",", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"resf", "[", 
              RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}]}], "]"}], ",",
          "y"}], "]"}]}], "==", "0"}]}], "\[IndentingNewLine]", "}"}], " ", "//",
    " ", "FullSimplify"}]}]}], "Input",ExpressionUUID->"34c1df90-6f4f-ae4c-\
b413-d1c5f18ee29c"],

