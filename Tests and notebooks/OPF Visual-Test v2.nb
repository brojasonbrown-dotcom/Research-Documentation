Cell[CellGroupData[{

Cell["12. Linearization around a homogeneous background", "Section",ExpressionUUID->"65a07aa0-a4b6-9e49-a000-123fd78c6f87"],

Cell[TextData[{
 "To rigorously test modal stability, perturb around a stationary point: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Rho]", "\[LongEqual]", 
         SubscriptBox["\[Rho]", "0"], "+", "\[Epsilon]", 
         StyleBox["u", "TI"], ",  ", "\[Chi]", "\[LongEqual]", 
         SubscriptBox["\[Chi]", "0"], "+", "\[Epsilon]", 
         StyleBox["v", "TI"], ",  ", 
         StyleBox["r", "TI"], 
         StyleBox["e", "TI"], 
         StyleBox["s", "TI"], "\[LongEqual]", 
         StyleBox["r", "TI"], 
         StyleBox["e", "TI"], 
         SubscriptBox[
          StyleBox["s", "TI"], "0"], "+", "\[Epsilon]", 
         StyleBox["w", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\rho = \\rho_0 + \\epsilon u,\\quad\n\\chi = \\chi_0 + \\epsilon \
v,\\quad\nres = res_0 + \\epsilon w", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "be48b67f-e2d7-cb4d-ab33-002479f5bb5f"]
}], "Text",ExpressionUUID->"592cd5d8-91bf-1c43-982a-c8be22bea6d6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"perturbationRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
       RowBox[{"rho0", "+", 
        RowBox[{"epsilon", " ", 
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
       RowBox[{"chi0", "+", 
        RowBox[{"epsilon", " ", 
         RowBox[{"v", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}]}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
       RowBox[{"res0", "+", 
        RowBox[{"epsilon", " ", 
         RowBox[{"w", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}]}]}]}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linearizedEquations", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Normal", " ", "@", " ", 
       RowBox[{"Series", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Subtract", " ", "@@@", " ", "fieldEquations"}], ")"}], 
          " ", "/.", " ", "perturbationRules"}], ",", "\[IndentingNewLine]", 
         "    ", 
         RowBox[{"{", 
          RowBox[{"epsilon", ",", "0", ",", "1"}], "}"}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}], " ", "/.", " ", 
      RowBox[{"Equal", "->", "Subtract"}]}], " ", "//", " ", "Expand"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"firstOrderSystem", "=", 
   RowBox[{
    RowBox[{"Coefficient", "[", 
     RowBox[{"linearizedEquations", ",", "epsilon", ",", "1"}], "]"}], "==", 
    "0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", "firstOrderSystem", "]"}]}], "Input",ExpressionUUID->\
"97eb4ffa-2a0c-6f41-9010-bfc947d2bb71"],

Cell[CellGroupData[{

Cell["Fourier-mode reduction", "Subsection",ExpressionUUID->"25390f50-f2d4-e84a-8edd-1c5a4808a4b6"],

Cell[TextData[{
 "Use a normal-mode ansatz: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["u", "TI"], ",", 
         StyleBox["w", "TI"], ",", 
         StyleBox["v", "TI"], "\[Tilde]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], "(", 
            RowBox[{
              StyleBox["k", "TI"], 
              StyleBox["x", "TI"], "+", "\[Omega]\[Sigma]"}], ")"}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "u,w,v \\sim e^{i(kx + \\omega \\sigma)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1f246897-83dd-b64c-ba74-ca6e545f0d9d"]
}], "Text",ExpressionUUID->"3a73c226-9d99-154a-add1-e3278a10b250"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"modeRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
       RowBox[{"ur", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"v", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
       RowBox[{"vr", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"w", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
       RowBox[{"wr", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"kx", " ", "x"}], "+", 
            RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"algebraicModeSystem", "=", 
    RowBox[{"Simplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Subtract", " ", "@@@", " ", "firstOrderSystem"}], ")"}], " ",
        "/.", " ", "modeRules"}], " ", "/.", " ", 
      RowBox[{"{", "\[IndentingNewLine]", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"1", ",", "0"}], "]"}], "[", "u", "]"}], "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
         RowBox[{"I", " ", "kx", " ", "ur", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "x"}], "+", 
              RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"0", ",", "1"}], "]"}], "[", "u", "]"}], "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
         RowBox[{"I", " ", "ks", " ", "ur", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "x"}], "+", 
              RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"2", ",", "0"}], "]"}], "[", "u", "]"}], "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"kx", "^", "2"}]}], " ", "ur", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "x"}], "+", 
              RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"0", ",", "2"}], "]"}], "[", "u", "]"}], "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"ks", "^", "2"}]}], " ", "ur", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "x"}], "+", 
              RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"1", ",", "0"}], "]"}], "[", "v", "]"}], "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
         RowBox[{"I", " ", "kx", " ", "vr", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "x"}], "+", 
              RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"0", ",", "1"}], "]"}], "[", "v", "]"}], "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
         RowBox[{"I", " ", "ks", " ", "vr", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "x"}], "+", 
              RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"2", ",", "0"}], "]"}], "[", "v", "]"}], "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"kx", "^", "2"}]}], " ", "vr", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "x"}], "+", 
              RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"0", ",", "2"}], "]"}], "[", "v", "]"}], "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"ks", "^", "2"}]}], " ", "vr", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "x"}], "+", 
              RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"1", ",", "0"}], "]"}], "[", "w", "]"}], "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
         RowBox[{"I", " ", "kx", " ", "wr", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "x"}], "+", 
              RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"0", ",", "1"}], "]"}], "[", "w", "]"}], "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
         RowBox[{"I", " ", "ks", " ", "wr", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "x"}], "+", 
              RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"2", ",", "0"}], "]"}], "[", "w", "]"}], "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"kx", "^", "2"}]}], " ", "wr", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "x"}], "+", 
              RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}], ",", 
        "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", 
            RowBox[{"0", ",", "2"}], "]"}], "[", "w", "]"}], "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"ks", "^", "2"}]}], " ", "wr", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"kx", " ", "x"}], "+", 
              RowBox[{"ks", " ", "sigma"}]}], ")"}]}], "]"}]}]}]}], 
       "\[IndentingNewLine]", "  ", "}"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"modeMatrix", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"CoefficientArrays", "[", 
      RowBox[{
       RowBox[{"algebraicModeSystem", " ", "/.", " ", 
        RowBox[{
         RowBox[{"Exp", "[", "_", "]"}], "->", "1"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"ur", ",", "vr", ",", "wr"}], "}"}]}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}], " ", "//", " ", "Normal"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "modeMatrix", "]"}]}], "Input",ExpressionUUID->\
"e0ccf144-0892-bc4b-9aba-35e03ae39198"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Stability frequencies", "Subsection",ExpressionUUID->"7aacdbf0-d694-3549-813f-4dba6bf977ea"],

Cell["The relevant condition is where the determinant vanishes. ", "Text",ExpressionUUID->"bb78a387-52ee-a94e-9f8e-7edf836d2af8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dispersionRelation", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Det", "[", "modeMatrix", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", "dispersionRelation"}], "Input",ExpressionUUID\
->"614320a5-92c0-2146-9cfa-51e3a43af0b8"],

Cell["\<\
And for specific parameter choices one can solve for mode branches: \
\>", "CodeText",ExpressionUUID->"ade56003-96a5-7a4d-be62-9b5b306ff7d6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"exampleBranch", "=", 
    RowBox[{"Solve", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"dispersionRelation", " ", "/.", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"rho0", "->", "1"}], ",", 
          RowBox[{"chi0", "->", "1"}], ",", 
          RowBox[{"res0", "->", "0"}], ",", 
          RowBox[{"delta", "->", 
           RowBox[{"1", "/", "2"}]}], ",", 
          RowBox[{"lambda", "->", "1"}], ",", "\[IndentingNewLine]", "    ", 
          RowBox[{"alpha", "->", "1"}], ",", 
          RowBox[{"beta", "->", "1"}], ",", 
          RowBox[{"gamma", "->", "1"}], ",", 
          RowBox[{"eta", "->", "1"}], ",", 
          RowBox[{"zeta", "->", "1"}], ",", 
          RowBox[{"xi", "->", "1"}]}], "}"}], "==", "0"}]}], ",", 
      "\[IndentingNewLine]", "  ", "ks"}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", "exampleBranch"}], \
"Input",ExpressionUUID->"f8027da0-d27f-ec41-9287-2802540d2b32"],

