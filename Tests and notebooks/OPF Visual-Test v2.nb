Cell[CellGroupData[{

Cell["13. Visual modal diagnostics", "Section",ExpressionUUID->"8714f3b4-59d8-7d40-98ce-844160727c65"],

Cell[BoxData[
 RowBox[{"With", "[", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", "    ", 
    RowBox[{"params", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rho0", "->", "1"}], ",", 
       RowBox[{"chi0", "->", "1"}], ",", 
       RowBox[{"res0", "->", "0"}], ",", 
       RowBox[{"delta", "->", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{"lambda", "->", "1"}], ",", "\[IndentingNewLine]", "      ", 
       RowBox[{"alpha", "->", "1"}], ",", 
       RowBox[{"beta", "->", "1"}], ",", 
       RowBox[{"gamma", "->", "1"}], ",", 
       RowBox[{"eta", "->", "1"}], ",", 
       RowBox[{"zeta", "->", "1"}], ",", 
       RowBox[{"xi", "->", "1"}], ",", "\[IndentingNewLine]", "      ", 
       RowBox[{"kx", "->", "1"}]}], "}"}]}], "\[IndentingNewLine]", "  ", 
    "}"}], ",", "\[IndentingNewLine]", "  ", 
   RowBox[{"ContourPlot", "[", "\[IndentingNewLine]", "    ", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{"dispersionRelation", " ", "/.", " ", "params"}], " ", "/.", 
        " ", 
        RowBox[{"ks", "->", 
         RowBox[{"kr", "+", 
          RowBox[{"I", " ", "ki"}]}]}]}], "]"}], "]"}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{"{", 
      RowBox[{"kr", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ki", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", "\[IndentingNewLine]", 
     "    ", 
     RowBox[{"Contours", "->", 
      RowBox[{"{", "0", "}"}]}], ",", "\[IndentingNewLine]", "    ", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Re[ks]\>\"", ",", "\"\<Im[ks]\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", "    ", 
     RowBox[{
     "PlotLabel", "->", "\"\<Zero contour of Re[dispersion relation]\>\""}]}],
     "\[IndentingNewLine]", "  ", "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"27a1ad7f-e1a3-d842-9e27-d2212a88f1b2"],

