Cell[CellGroupData[{

Cell["6. Homogeneous stationary sector", "Section",ExpressionUUID->"5c47c897-9fed-ea4d-a01a-6e6ddb50f946"],

Cell[TextData[{
 "A constant background should be introduced by replacing fields by constants \
",
 StyleBox["and",
  FontWeight->Bold],
 " their derivatives by zero. "
}], "Text",ExpressionUUID->"2931c365-099c-6846-a92a-54e21f8ab9f8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"homogeneousRules", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "rho0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "chi0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "res0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"1", ",", "0"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "rho", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "chi", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"2", ",", "0"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Derivative", "[", 
          RowBox[{"0", ",", "2"}], "]"}], "[", "res", "]"}], "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], "->", "0"}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"homogeneousEquations", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"fieldEquations", " ", "/.", " ", "homogeneousRules"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"$Assumptions", "&&", 
        RowBox[{"chi0", ">", "0"}], "&&", 
        RowBox[{"Element", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", "Reals"}], 
         "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", "homogeneousEquations", "]"}]}], "Input",ExpressionUUI\
D->"65407b58-726a-2741-b1c8-ff59d56f501c"],

Cell[CellGroupData[{

Cell["Correct fixed-point solve", "Subsection",ExpressionUUID->"b7df092d-bbab-3d4c-b5e8-f131edc40ccf"],

Cell[TextData[{
 "The earlier use of ",
 ButtonBox["MaxExtraConditions",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/MaxExtraConditions"],
 " with ",
 ButtonBox["Reduce",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/Reduce"],
 " was invalid. Use: "
}], "CodeText",ExpressionUUID->"d326e0a4-3b43-8f4e-af33-ab6b6d0ffa87"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fixedPoints", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"Reduce", "[", "\[IndentingNewLine]", "    ", 
       RowBox[{"homogeneousEquations", ",", "\[IndentingNewLine]", "    ", 
        RowBox[{"{", 
         RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", 
        "\[IndentingNewLine]", "    ", "Reals"}], "\[IndentingNewLine]", "  ",
        "]"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"chi0", ">", "0"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "fixedPoints"}], "Input",Exp\
ressionUUID->"4aca5785-671c-5c48-882c-16fa53ffa0cc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Also solve explicitly when possible", "Subsection",ExpressionUUID->"cae71794-a2aa-4846-a3af-b1e7c384f49c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fixedPointRules", "=", 
    RowBox[{
     RowBox[{"Solve", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{"homogeneousEquations", ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", "Reals"}], "\[IndentingNewLine]", "]"}], 
     " ", "//", " ", "FullSimplify"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "fixedPointRules"}], "Input",\
ExpressionUUID->"a63658ac-0619-be40-ab07-f2d3a9c41fc6"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"5f9d8c0a-a337-464b-9076-f4ee023cbbc6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Potential-only analysis for boundedness and equilibrium", "Section",ExpressionUUID->"c97697ce-198e-ef40-9573-ee1d02eb36d1"],

Cell["\<\
A useful rigorous decomposition is to separate the homogeneous potential from \
gradient penalties. \
\>", "Text",ExpressionUUID->"6eb57ca8-39b3-c74a-83ad-f7436dacc54f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"potential", "[", 
    RowBox[{"r_", ",", "c_", ",", "q_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"r", " ", 
     RowBox[{"Log", "[", "c", "]"}]}], "+", 
    RowBox[{"c", " ", 
     RowBox[{"q", "^", "2"}]}], "+", 
    RowBox[{"delta", " ", "r", " ", "c", " ", "q"}], "+", 
    RowBox[{"lambda", " ", 
     RowBox[{"r", "^", "2"}]}]}]}], ";"}]], "Input",ExpressionUUID->"ad12b35a-\
7d98-ab40-8f74-8530a4850cfd"],

Cell[CellGroupData[{

Cell["Gradient-free fixed-point equations", "Subsection",ExpressionUUID->"d24fafa7-f6df-8144-9542-2d3327469bbb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"potentialStationary", "=", 
    RowBox[{
     RowBox[{"Thread", "[", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"Grad", "[", 
        RowBox[{
         RowBox[{"potential", "[", 
          RowBox[{"r0", ",", "chi0", ",", "res0"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"r0", ",", "chi0", ",", "res0"}], "}"}]}], "]"}], "==", 
       "0"}], "\[IndentingNewLine]", "]"}], " ", "//", " ", 
     "FullSimplify"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", "potentialStationary", "]"}]}], "Input",ExpressionUUID\
->"70dc16f7-6d80-954d-81b5-b811a31458a8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Hessian test", "Subsection",ExpressionUUID->"605aacf6-c327-c946-96d4-4d17cb93e50b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"potentialHessian", "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"potential", "[", 
       RowBox[{"r0", ",", "chi0", ",", "res0"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"r0", ",", "chi0", ",", "res0"}], "}"}], ",", "2"}], "}"}]}],
      "]"}], " ", "//", " ", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "potentialHessian", "]"}]}], "Input",ExpressionUUI\
D->"23727ad1-de6a-9542-87ad-32c63fc2f8b4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Positive-definiteness conditions near fixed points", "Subsection",ExpressionUUID->"849340f5-477b-2e4a-93e6-311b1d279253"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hessianEigenvaluesAt", "[", "rule_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Eigenvalues", "[", 
      RowBox[{"potentialHessian", " ", "/.", " ", "rule"}], "]"}], " ", "//", 
     " ", "FullSimplify"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fixedPointStability", "=", 
    RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
     "hessianEigenvaluesAt", ",", "\[IndentingNewLine]", "  ", 
      "fixedPointRules"}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "fixedPointStability"}], \
"Input",ExpressionUUID->"4563ff4f-5976-3f45-824e-acd048e8fd6c"],

Cell["\<\
This is one rigorous meaning of a local \"stable equilibrium\" claim. \
\>", "Text",ExpressionUUID->"42d1db22-bfb1-0841-8919-dc23d7094904"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"b5858d0e-15c6-294d-8e0c-3dd66a60a501"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Boundedness diagnostics", "Section",ExpressionUUID->"738a5c42-d00e-9848-bcba-001dd66a6e78"],

Cell["\<\
The original notebook mixes action-level stability and local equilibrium. \
Those are distinct.\
\>", "Text",ExpressionUUID->"c1be760a-f9bc-8743-a985-d0e8384f3404"],

Cell["\<\
A local minimum is not the same as global boundedness below. \
\>", "Text",ExpressionUUID->"76cc80d9-c4f0-e747-9596-0e082a1387ce"],

Cell[CellGroupData[{

Cell["Symbolic asymptotic probes", "Subsection",ExpressionUUID->"38673150-5804-b748-baed-73a6c119fc6f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"boundednessProbes", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<AlongLargePositiveRho\>\"", "->", 
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"potential", "[", 
          RowBox[{"r0", ",", "chi0", ",", "res0"}], "]"}], ",", 
         RowBox[{"r0", "->", "Infinity"}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{
           RowBox[{"chi0", ">", "0"}], "&&", 
           RowBox[{"res0", " ", "\[Element]", " ", "Reals"}]}]}]}], "]"}]}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<AlongLargeNegativeRho\>\"", "->", 
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"potential", "[", 
          RowBox[{"r0", ",", "chi0", ",", "res0"}], "]"}], ",", 
         RowBox[{"r0", "->", 
          RowBox[{"-", "Infinity"}]}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{
           RowBox[{"chi0", ">", "0"}], "&&", 
           RowBox[{"res0", " ", "\[Element]", " ", "Reals"}]}]}]}], "]"}]}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<AlongLargeRes\>\"", "->", 
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"potential", "[", 
          RowBox[{"r0", ",", "chi0", ",", "res0"}], "]"}], ",", 
         RowBox[{"res0", "->", "Infinity"}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{
           RowBox[{"chi0", ">", "0"}], "&&", 
           RowBox[{"r0", " ", "\[Element]", " ", "Reals"}]}]}]}], "]"}]}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<AlongChiToZeroPlus\>\"", "->", 
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"potential", "[", 
          RowBox[{"r0", ",", "chi0", ",", "res0"}], "]"}], ",", 
         RowBox[{"chi0", "->", "0"}], ",", 
         RowBox[{"Direction", "->", "\"\<FromAbove\>\""}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{
           RowBox[{"r0", ">", "0"}], "&&", 
           RowBox[{"res0", " ", "\[Element]", " ", "Reals"}]}]}]}], "]"}]}], ",",
       "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<AlongChiToInfinity\>\"", "->", 
       RowBox[{"Limit", "[", 
        RowBox[{
         RowBox[{"potential", "[", 
          RowBox[{"r0", ",", "chi0", ",", "res0"}], "]"}], ",", 
         RowBox[{"chi0", "->", "Infinity"}], ",", 
         RowBox[{"Assumptions", "->", 
          RowBox[{
           RowBox[{"r0", ">", "0"}], "&&", 
           RowBox[{"res0", " ", "\[Element]", " ", "Reals"}]}]}]}], "]"}]}]}],
      "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"boundednessProbes", " ", "//", " ", "Dataset"}]}], "Input",Expressio\
nUUID->"de9c0ef0-7ff0-fc4b-a18f-498840b8735f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visual slice plots", "Subsection",ExpressionUUID->"57e43687-779e-f940-8d9e-69aeb3fcb2ad"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"deltaVal", "=", 
      RowBox[{"1", "/", "2"}]}], ",", 
     RowBox[{"lambdaVal", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
   " ", 
   RowBox[{"Plot3D", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{
       RowBox[{"potential", "[", 
        RowBox[{"r", ",", "c", ",", "0"}], "]"}], " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"delta", "->", "deltaVal"}], ",", 
         RowBox[{"lambda", "->", "lambdaVal"}]}], "}"}]}], "]"}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"{", 
      RowBox[{"r", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "0.05", ",", "3"}], "}"}], ",", "\[IndentingNewLine]",
      "  ", 
     RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<rho\>\"", ",", "\"\<chi\>\"", ",", "\"\<V\>\""}], "}"}]}],
      ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
     "PlotLabel", "->", "\"\<Potential slice V(rho, chi, res=0)\>\""}], ",", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"Mesh", "->", "None"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"ColorFunction", "->", "\"\<SolarColors\>\""}]}], 
    "\[IndentingNewLine]", " ", "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",ExpressionUUID->"84623eb0-4ac7-2a47-a349-f3b7aa6b5eb7"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"deltaVal", "=", 
      RowBox[{"1", "/", "2"}]}], ",", 
     RowBox[{"lambdaVal", "=", "1"}], ",", 
