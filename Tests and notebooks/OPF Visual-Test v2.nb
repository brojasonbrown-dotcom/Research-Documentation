Cell[CellGroupData[{

Cell["3. Global reset and safe symbolic setup", "Section",ExpressionUUID->"77210d23-abab-d84e-a721-b228d01a231a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"$Assumptions", "=", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"alpha", ">", "0"}], "&&", 
     RowBox[{"beta", ">", "0"}], "&&", 
     RowBox[{"gamma", ">", "0"}], "&&", "\[IndentingNewLine]", "  ", 
     RowBox[{"eta", ">", "0"}], "&&", 
     RowBox[{"zeta", ">", "0"}], "&&", 
     RowBox[{"xi", ">", "0"}], "&&", "\[IndentingNewLine]", "  ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"delta", " ", "|", " ", "lambda"}], ",", "Reals"}], "]"}], "&&",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"x", " ", "|", " ", "sigma"}], ",", "Reals"}], "]"}], "&&", 
     "\[IndentingNewLine]", "  ", 
     RowBox[{"phi", ">", "1"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{"$Packages", ",", "\"\<VariationalMethods`\>\""}], "]"}], ",", 
    "Null", ",", 
    RowBox[{"Needs", "[", "\"\<VariationalMethods`\>\"", "]"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"e56ef428-d193-4f4f-bd4f-f05c4a3557c4"],

Cell[CellGroupData[{

Cell["Notes", "Subsection",ExpressionUUID->"8ce3fc60-3d4a-4544-9956-9fed0d2eb8a3"],

Cell[TextData[{
 "Avoid redefining ",
