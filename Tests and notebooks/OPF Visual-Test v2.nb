Cell[CellGroupData[{

Cell["1. Notebook goals", "Section",ExpressionUUID->"b9718499-73be-7c4c-b01d-31333dd79479"],

Cell["\<\
We want to rigorously test all valuable aspects of the framework: \
\>", "Text",ExpressionUUID->"f41f15ce-5491-464f-b10f-68b7fe5e3a55"],

Cell["Is the action implemented correctly?", "Item",ExpressionUUID->"16720cf9-3233-274b-8005-93ce6f5ec4fc"],

Cell["Are the Euler\[Dash]Lagrange equations actually correct?", "Item",ExpressionUUID->"472f970d-3d2a-b649-8c08-e274f0cc0717"],

Cell["Are stationary solutions computed correctly?", "Item",ExpressionUUID->"18185f4a-5ff2-e64d-b6ec-ca4817500b51"],

Cell["Are scale-ansatz substitutions mathematically consistent?", "Item",ExpressionUUID->"cbc12905-7e1b-dc4f-a79b-58bd06e1f2cd"],

Cell["\<\
Are stability claims justified by Hessian / eigenvalue analysis?\
\>", "Item",ExpressionUUID->"696fe23c-c311-3646-8d12-fdffc5017abe"],

Cell["Are numerical probes reproducible and well-defined?", "Item",ExpressionUUID->"fa36fbef-b7fa-3848-88d9-41f944131a59"],

Cell["\<\
Are terms like \"information\", \"measurement\", \"energy\", and \
\"self-measurement\" being used mathematically, operationally, or \
metaphorically?\
\>", "Item",ExpressionUUID->"7972495d-77b6-d444-b3d6-d1b3d23c82ef"],

Cell["What parts could be misunderstood?", "Item",ExpressionUUID->"ec162a5e-16e1-1d41-9f44-4db28bf87cc3"],

Cell["\<\
How should the framework be structured to minimize ambiguity?\
\>", "Item",ExpressionUUID->"820bb6fe-3f1f-9e4b-81ac-95f0f6f566fc"],

