Cell[CellGroupData[{

Cell["18. Regression tests", "Section",ExpressionUUID->"5573bd53-b69d-e547-bf38-8bee6344ff02"],

Cell["A no-regression notebook needs executable tests. ", "Text",ExpressionUUID->"d875df6d-d088-c047-954c-f9edbd7996ba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"regressionTests", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"VerificationTest", "[", 
       RowBox[{
        RowBox[{"Head", "[", "lagrangianDensity", "]"}], ",", "Plus", 
        ",", "\"\<LagrangianConstructed\>\""}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"VerificationTest", "[", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"eulerRho", ",", "lambda"}], "]"}]}], ",", "True", 
        ",", "\"\<EulerRhoHasLambda\>\""}], "]"}], ",", "\[IndentingNewLine]",
       "  ", 
      RowBox[{"VerificationTest", "[", 
       RowBox[{
        RowBox[{"!", " ", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"eulerChi", ",", 
           RowBox[{"1", "/", 
            RowBox[{"chi", "[", 
             RowBox[{"x", ",", "sigma"}], "]"}]}]}], "]"}]}], ",", "True", 
        ",", "\"\<EulerChiHasLogDerivative\>\""}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"VerificationTest", "[", 
       RowBox[{
        RowBox[{"FreeQ", "[", 
         RowBox[{"fixedPoints", ",", "MaxExtraConditions"}], "]"}], ",", 
        "True", ",", "\"\<NoInvalidReduceOption\>\""}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"VerificationTest", "[", 
       RowBox[{
        RowBox[{"Head", "[", "scaleReducedEquations", "]"}], ",", "List", 
        ",", "\"\<ScaleReductionProducesList\>\""}], "]"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"VerificationTest", "[", 
       RowBox[{
        RowBox[{"AssociationQ", "[", "eulerStructureTests", "]"}], ",", 
        "True", ",", "\"\<EulerStructureTestsAssociation\>\""}], "]"}]}], 
     "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"TestReport", "[", "regressionTests", "]"}]}], "Input",ExpressionUUID\
->"8a499b5c-895a-9741-a184-39c158b5014c"],

Cell["Add tests whenever a section is corrected. ", "Text",ExpressionUUID->"54ff609a-da61-8349-a5a7-bac6ffc2a6f5"],

