Cell["Critical framing", "Section",ExpressionUUID->"26baa612-34c1-5d40-aa84-667be70f9cd4"],

Cell[TextData[{
 "The OPF constructions below are treated as ",
 StyleBox["hypotheses and formal models",
  FontWeight->Bold],
 ", not established physics. The notebook is designed to test:"
}], "Text",ExpressionUUID->"17db5c9d-3513-2642-a19b-00df4229b10f"],

Cell[TextData[{
 "1. ",
 StyleBox["internal consistency",
  FontWeight->Bold],
 "2. ",
 StyleBox["correct Wolfram Language implementation",
  FontWeight->Bold],
 "3. ",
 StyleBox["symbolic derivability",
  FontWeight->Bold],
 "4. ",
 StyleBox["stability and fixed-point structure",
  FontWeight->Bold],
 "5. ",
 StyleBox["numerical reproducibility",
  FontWeight->Bold],
 "6. ",
 StyleBox["semantic overreach risks",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"27e51a3b-2d41-dc4b-a75a-fa95e3cf68e6"],

