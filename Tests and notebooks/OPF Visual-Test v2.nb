Cell[CellGroupData[{

Cell["4. Core fields and action density", "Section",ExpressionUUID->"47959d23-f4b0-6f46-9477-32bb589eedfe"],

Cell["We define: ", "Text",ExpressionUUID->"9743d699-6a43-9149-89f4-9c5d2a1f07c0"],

Cell[TextData[{
 Cell[BoxData[Cell["rho[x, sigma]",
   Background->None,ExpressionUUID->"b9c57283-0e73-7144-9ea3-f06c51887aaf"]], 
  "InlineCode",ExpressionUUID->"1cdd6543-dff5-304b-8cdf-b090908d0f77"],
 ": information-density field"
}], "Item",ExpressionUUID->"e3d24c43-b6c5-b949-ad11-6db32cd69b55"],

Cell[TextData[{
 Cell[BoxData[Cell["chi[x, sigma]",
   Background->None,ExpressionUUID->"f76d1ba9-818f-094e-b3e7-af1e86f8f41e"]], 
  "InlineCode",ExpressionUUID->"9373fd02-51d7-334b-a3aa-a344fbb2bd5f"],
 ": complexity field"
}], "Item",ExpressionUUID->"d325a48c-dc18-714e-9050-756aa60b2dd2"],

Cell[TextData[{
 Cell[BoxData[Cell["res[x, sigma]",
   Background->None,ExpressionUUID->"20b9f97f-036c-074b-96b4-a3b14602a404"]], 
  "InlineCode",ExpressionUUID->"3b8d239a-a8e0-424f-93aa-1da1b2a42226"],
 ": resolution field"
}], "Item",ExpressionUUID->"6d3f77bb-108c-6b4d-9b40-e3a3c72422cb"],

Cell[TextData[{
 "The proposed scale-extended density is: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["L", "TI"], "\[LongEqual]", "\[Rho]", "log", 
         RowBox[{"(", "\[Chi]", ")"}], "+", "\[Chi] ", 
         StyleBox["r", "TI"], 
         StyleBox["e", "TI"], 
         SuperscriptBox[
          StyleBox["s", "TI"], "2"], "+", "\[Alpha]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", "\[Sigma]"], "\[Rho]"}], ")"}], 
          "2"], "+", "\[Beta]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", "\[Sigma]"], "\[Chi]"}], ")"}], 
          "2"], "+", "\[Gamma]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", "\[Sigma]"], 
              StyleBox["r", "TI"], 
              StyleBox["e", "TI"], 
              StyleBox["s", "TI"]}], ")"}], "2"], "+", "\[Eta]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", 
               StyleBox["x", "TI"]], "\[Rho]"}], ")"}], "2"], "+", "\[Zeta]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", 
               StyleBox["x", "TI"]], "\[Chi]"}], ")"}], "2"], "+", "\[Xi]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SubscriptBox["\[PartialD]", 
               StyleBox["x", "TI"]], 
              StyleBox["r", "TI"], 
              StyleBox["e", "TI"], 
              StyleBox["s", "TI"]}], ")"}], "2"], "+", "\[Delta] ", 
         "\[Rho]\[Chi]", 
         StyleBox["r", "TI"], 
         StyleBox["e", "TI"], 
         StyleBox["s", "TI"], "+", "\[Lambda] ", 
         SuperscriptBox["\[Rho]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathcal{L} = \\rho\\log(\\chi) + \\chi\\,res^2\n+ \\alpha (\\partial_\
\\sigma \\rho)^2 + \\beta (\\partial_\\sigma \\chi)^2 + \\gamma \
(\\partial_\\sigma res)^2\n+ \\eta (\\partial_x \\rho)^2 + \\zeta \
(\\partial_x \\chi)^2 + \\xi (\\partial_x res)^2\n+ \\delta\\,\\rho\\chi res \
+ \\lambda\\,\\rho^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cd4657d3-4e57-2343-b89f-15d2e3b8b022"]
}], "Text",ExpressionUUID->"0d702c61-e77e-6c40-bd8c-e1bd61e45ae0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"lagrangianDensity", "=", "\[IndentingNewLine]", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{"Log", "[", 
      RowBox[{"chi", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], "]"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"chi", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{
      RowBox[{"res", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}]}], "+", 
    "\[IndentingNewLine]", "  ", 
    RowBox[{"alpha", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
      "2"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"beta", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"chi", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
      "2"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"gamma", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"res", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "sigma"}], "]"}], "^", 
      "2"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"eta", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"rho", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", "2"}]}], 
    "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"zeta", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"chi", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", "2"}]}], 
    "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"xi", " ", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"res", "[", 
         RowBox[{"x", ",", "sigma"}], "]"}], ",", "x"}], "]"}], "^", "2"}]}], 
    "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"delta", " ", 
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{"chi", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}], " ", 
     RowBox[{"res", "[", 
      RowBox[{"x", ",", "sigma"}], "]"}]}], "+", "\[IndentingNewLine]", "  ", 
    RowBox[{"lambda", " ", 
     RowBox[{
      RowBox[{"rho", "[", 
       RowBox[{"x", ",", "sigma"}], "]"}], "^", "2"}]}]}]}], ";"}]], "Input",E\
xpressionUUID->"0c194a96-a8b4-db4b-9c0f-0dc8ba71aaff"],

Cell[CellGroupData[{

Cell["Immediate domain condition", "Subsection",ExpressionUUID->"86cab3ec-c7f4-3b48-9041-684d45aebb4b"],

Cell[TextData[{
 "Because of ",
