Cell["19. Suggested next-step notebook split", "Section",ExpressionUUID->"eb0c3b10-f205-2a4d-ad7e-355bfc1920e8"],

Cell[TextData[{
 "The material would be cleaner as ",
 StyleBox["three notebooks",
  FontWeight->Bold],
 ": "
}], "Text",ExpressionUUID->"39a89324-0ffb-e34a-807f-f272bd26d427"],

