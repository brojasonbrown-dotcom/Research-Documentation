Cell[CellGroupData[{

Cell["9. Scale ansatz: corrected formulation", "Section",ExpressionUUID->"2b9380b8-6926-9a46-89f2-9eec322e5f1c"],

Cell[TextData[{
 "The original notebook incorrectly used ",
 Cell[BoxData[
  RowBox[{"Join", "[", 
   RowBox[{"$Assumptions", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"chiS", "[", "x", "]"}], ">", "0"}], "}"}]}], "]"}]], 
  "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "6682a334-b7fc-2443-a1b9-36f7f1fe413f"],
 " even though ",
 ButtonBox["$Assumptions",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/$Assumptions"],
 " is not a list."
}], "Text",ExpressionUUID->"5efbfd46-4ea0-8741-8f07-0ed7b11bea1d"],

Cell["Use logical conjunction instead. ", "Text",ExpressionUUID->"df2a6396-0ded-6a4f-a9e4-8b1f3f670cb3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"scaleAnsatz", "=", 
    RowBox[{"{", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
       RowBox[{
        RowBox[{"rhoS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"a", " ", "sigma"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"chi", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
       RowBox[{
        RowBox[{"chiS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"b", " ", "sigma"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"res", "[", 
        RowBox[{"x", ",", "sigma"}], "]"}], ":>", 
       RowBox[{
        RowBox[{"resS", "[", "x", "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"c", " ", "sigma"}], "]"}]}]}]}], "\[IndentingNewLine]", 
     "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scaleReducedEquations", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"fieldEquations", " ", "/.", " ", "scaleAnsatz"}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"$Assumptions", "&&", 
        RowBox[{
         RowBox[{"chiS", "[", "x", "]"}], ">", "0"}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", "scaleReducedEquations", "]"}]}], "Input",ExpressionUU\
ID->"0e9a0962-754e-4d46-9aa8-774f5081e8fb"],

Cell[CellGroupData[{

Cell["Exponent bookkeeping", "Subsection",ExpressionUUID->"1548b844-0d5c-9044-9a51-a1b61affedaa"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"expPowers", "[", "expr_", "]"}], ":=", 
    RowBox[{"DeleteDuplicates", " ", "@", " ", 
     RowBox[{"Cases", "[", 
      RowBox[{"expr", ",", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"k_.", " ", "sigma"}], "]"}], ":>", "k"}], ",", "Infinity"}],
       "]"}]}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"scalePowers", "=", 
    RowBox[{"AssociationThread", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<rhoEq\>\"", ",", "\"\<chiEq\>\"", ",", "\"\<resEq\>\""}], 
       "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"expPowers", " ", "/@", " ", 
       RowBox[{"(", 
        RowBox[{"Subtract", " ", "@@@", " ", "scaleReducedEquations"}], 
        ")"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"scalePowers", " ", "//", " ", "Dataset"}]}], "Input",ExpressionUUID->\
"405d2ffa-c034-754d-808f-c88f0b641f70"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Interpretation", "Subsection",ExpressionUUID->"c9a94e16-ef65-cd4c-83aa-349d7e827716"],

Cell["\<\
If multiple distinct exponential powers appear in a single reduced equation, \
then exact scale-covariance usually requires either: \
\>", "Text",ExpressionUUID->"282753eb-9176-9e4b-9c2d-4646f794c964"],

Cell[TextData[{
 "exponent matching constraints such as ",
 Cell[BoxData[Cell["a == c",
   Background->None,ExpressionUUID->"b85eeed2-6e03-2641-b049-366b54d5be6b"]], 
  "InlineCode",ExpressionUUID->"c339febd-faed-8b4f-a02d-9a6c454d92a6"],
 " or ",
 Cell[BoxData[Cell["b == 0",
   Background->None,ExpressionUUID->"f09d712d-df01-a441-94df-e9dcd9a32cd4"]], 
  "InlineCode",ExpressionUUID->"b6656fdf-d94f-3f48-98d7-8764ac446af4"]
}], "Item",ExpressionUUID->"310e64cb-9d1d-874a-a1d6-61f04049189b"],

Cell["vanishing coefficients of mismatched sectors", "Item",ExpressionUUID->"20017f45-8a37-0d4c-bb84-210f7ef7434e"],

Cell["a more carefully designed homogeneous action", "Item",ExpressionUUID->"c700875f-1493-d640-a6e7-5a242566fb73"],

Cell["\<\
This is one of the most important structural filters in the framework. \
\>", "Text",ExpressionUUID->"2b8c4688-df67-4446-8440-eca6c23dc55f"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"9ac57e1c-4d6e-fc4e-93e9-7c022e232131"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["10. Direct homogeneity test for candidate potentials", "Section",ExpressionUUID->"5bb5236b-6627-1041-8227-b24727e451ec"],

Cell[TextData[{
 "One of the strongest ideas in the user material is that ",
 StyleBox["scale-homogeneity is rare and diagnostic",
  FontWeight->Bold],
 ". We can formalize that directly."
}], "Text",ExpressionUUID->"777cdf09-48f5-394e-b0c6-e7692761b3fd"],

Cell[TextData[{
 "For a candidate potential ",
 Cell[BoxData[Cell["V[rho, chi, res]",
   Background->None,ExpressionUUID->"a60c7e78-67d5-0f4b-b34c-43a4133831f5"]], 
  "InlineCode",ExpressionUUID->"10e7cc14-3c51-3b47-8480-7d4fa7eaaa17"],
 ", define weighted homogeneity by: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["t", "TI"], 
              SubscriptBox[
               StyleBox["w", "TI"], "\[Rho]"]], "\[Rho]", ",", 
             SuperscriptBox[
              StyleBox["t", "TI"], 
              SubscriptBox[
               StyleBox["w", "TI"], "\[Chi]"]], "\[Chi]", ",", 
             SuperscriptBox[
              StyleBox["t", "TI"], 
              SubscriptBox[
               StyleBox["w", "TI"], 
               StyleBox["r", "TI"]]], 
             StyleBox["r", "TI"], 
             StyleBox["e", "TI"], 
             StyleBox["s", "TI"]}], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["t", "TI"], 
          StyleBox["d", "TI"]], 
         StyleBox["V", "TI"], 
         RowBox[{"(", 
           RowBox[{"\[Rho]", ",", "\[Chi]", ",", 
             StyleBox["r", "TI"], 
             StyleBox["e", "TI"], 
             StyleBox["s", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "V(t^{w_\\rho}\\rho, t^{w_\\chi}\\chi, t^{w_r}res) = t^d \
V(\\rho,\\chi,res)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5f77c758-f518-e541-a618-1ce599a35b6d"]
}], "Text",ExpressionUUID->"8fdc2c55-a473-2a4b-a6d5-b4397303513c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "weightedHomogeneousQ", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"weightedHomogeneousQ", "[", 
    RowBox[{"expr_", ",", "vars_", ",", "weights_", ",", "degree_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", "t", "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "    ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"expr", " ", "/.", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"vars", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"t", "^", "weights"}], " ", "vars"}], ")"}]}], "]"}]}], 
         ")"}], "==", 
        RowBox[{
         RowBox[{"t", "^", "degree"}], " ", "expr"}]}], ",", 
       "\[IndentingNewLine]", "    ", 
       RowBox[{"Assumptions", "->", 
        RowBox[{
         RowBox[{"t", ">", "0"}], "&&", 
         RowBox[{"And", " ", "@@", " ", 
          RowBox[{"Thread", "[", 
           RowBox[{"vars", ">", "0"}], "]"}]}]}]}]}], "\[IndentingNewLine]", 
      "  ", "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",Expressi\
onUUID->"506cc6ea-e646-9b44-8147-4ac4de7c068c"],

Cell[CellGroupData[{

Cell["Examples", "Subsection",ExpressionUUID->"f457ed2f-aae6-4245-ab95-95c7ff9eaac3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"candidatePotentials", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<Original\>\"", "->", 
       RowBox[{
        RowBox[{"rho0", " ", 
         RowBox[{"Log", "[", "chi0", "]"}]}], "+", 
        RowBox[{"chi0", " ", 
         RowBox[{"res0", "^", "2"}]}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<KLLike\>\"", "->", 
       RowBox[{
        RowBox[{"rho0", " ", 
         RowBox[{"Log", "[", 
          RowBox[{"rho0", "/", "chi0"}], "]"}]}], "-", "rho0", "+", "chi0", "+", 
        RowBox[{
         RowBox[{"res0", "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"2", " ", "chi0"}], ")"}]}]}]}], ",", "\[IndentingNewLine]",
       "  ", 
      RowBox[{"\"\<rho2chi\>\"", "->", 
       RowBox[{
        RowBox[{"rho0", "^", "2"}], " ", "chi0"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<chiR2+deltaRhoChiR+rho2chi\>\"", "->", 
       RowBox[{
        RowBox[{"chi0", " ", 
         RowBox[{"res0", "^", "2"}]}], "+", 
        RowBox[{"delta", " ", "rho0", " ", "chi0", " ", "res0"}], "+", 
        RowBox[{
         RowBox[{"rho0", "^", "2"}], " ", "chi0"}]}]}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"homogeneityTests", "=", 
    RowBox[{"AssociationMap", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"weightedHomogeneousQ", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"rho0", ",", "chi0", ",", "res0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", "1"}], "]"}], " ", 
       "&"}], ",", "\[IndentingNewLine]", "  ", "candidatePotentials"}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"homogeneityTests", " ", "//", " ", "Dataset"}]}], "Input",Expression\
UUID->"4239dca1-64a1-8c48-b068-99b3340a3d98"],

Cell["This makes the claim testable instead of rhetorical. ", "Text",ExpressionUUID->"86e2aa15-4723-de4a-8f69-a3cf5ad61d14"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"dcfc7f7d-c29b-9946-a13c-a0a6e320f4b9"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. Regression-oriented equation foundry in Wolfram Language", "Section",ExpressionUUID->"f285951f-a46a-ef42-a84d-f7992fb3afed"],

Cell["\<\
Below is a built-in-only WL version of the search idea. It is simpler than \
the Python version but structured for auditability. \
\>", "Text",ExpressionUUID->"65c351ad-b96f-2e4f-8689-0f52c190fbf2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "r", ",", "c", ",", "q", ",", "candidateTerms", ",", "makePotential"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"candidateTerms", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<rhoLogChi\>\"", "->", 
       RowBox[{"r", " ", 
        RowBox[{"Log", "[", "c", "]"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<rhoLogRhoOverChi\>\"", "->", 
       RowBox[{"r", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"r", "/", "c"}], "]"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<chiR2\>\"", "->", 
       RowBox[{"c", " ", 
        RowBox[{"q", "^", "2"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<R2Over2Chi\>\"", "->", 
       RowBox[{
        RowBox[{"q", "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "c"}], ")"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<lambdaRho2\>\"", "->", 
       RowBox[{"lambda", " ", 
        RowBox[{"r", "^", "2"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<deltaRhoChiR\>\"", "->", 
       RowBox[{"delta", " ", "r", " ", "c", " ", "q"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<minusRhoPlusChi\>\"", "->", 
       RowBox[{
        RowBox[{"-", "r"}], "+", "c"}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<rho2Chi\>\"", "->", 
       RowBox[{
        RowBox[{"r", "^", "2"}], " ", "c"}]}], ",", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{"\"\<chiLogChi\>\"", "->", 
       RowBox[{"c", " ", 
        RowBox[{"Log", "[", "c", "]"}]}]}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<R4\>\"", "->", 
       RowBox[{"q", "^", "4"}]}]}], "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"makePotential", "[", "names_List", "]"}], ":=", 
   RowBox[{"Total", "[", 
    RowBox[{"Lookup", "[", 
     RowBox[{"candidateTerms", ",", "names"}], "]"}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"93076f46-abd8-e643-83f1-e4a612b7cd06"],

Cell[CellGroupData[{

Cell["Basic scoring utilities", "Subsection",ExpressionUUID->"5f06f6b7-f098-eb4f-96ba-1d0690f09201"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "stationarySystem", ",", "hessianMatrix", ",", "localStableQ", ",", 
     "boundedSliceEvidence"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stationarySystem", "[", "expr_", "]"}], ":=", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"Grad", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "c", ",", "q"}], "}"}]}], "]"}], "==", "0"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hessianMatrix", "[", "expr_", "]"}], ":=", 
    RowBox[{"D", "[", 
     RowBox[{"expr", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"r", ",", "c", ",", "q"}], "}"}], ",", "2"}], "}"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"localStableQ", "[", 
     RowBox[{"expr_", ",", "sol_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "evals", "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"evals", "=", 
        RowBox[{
         RowBox[{"Eigenvalues", "[", 
          RowBox[{
           RowBox[{"hessianMatrix", "[", "expr", "]"}], " ", "/.", " ", 
           "sol"}], "]"}], " ", "//", " ", "N"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"VectorQ", "[", 
        RowBox[{"evals", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Re", "[", "#", "]"}], ">", "0"}], " ", "&"}]}], "]"}]}]}],
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"boundedSliceEvidence", "[", "expr_", "]"}], ":=", 
   RowBox[{"Association", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"\"\<rhoToInfinity\>\"", "->", 
      RowBox[{"Quiet", "@", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"Limit", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"r", "->", "Infinity"}], ",", 
           RowBox[{"Assumptions", "->", 
            RowBox[{"c", ">", "0"}]}]}], "]"}], ",", "$Failed"}], "]"}]}]}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<rhoToMinusInfinity\>\"", "->", 
      RowBox[{"Quiet", "@", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"Limit", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"r", "->", 
            RowBox[{"-", "Infinity"}]}], ",", 
           RowBox[{"Assumptions", "->", 
            RowBox[{"c", ">", "0"}]}]}], "]"}], ",", "$Failed"}], "]"}]}]}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<qToInfinity\>\"", "->", 
      RowBox[{"Quiet", "@", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"Limit", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"q", "->", "Infinity"}], ",", 
           RowBox[{"Assumptions", "->", 
            RowBox[{"c", ">", "0"}]}]}], "]"}], ",", "$Failed"}], "]"}]}]}], ",",
      "\[IndentingNewLine]", "  ", 
     RowBox[{"\"\<cToZeroPlus\>\"", "->", 
      RowBox[{"Quiet", "@", 
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"Limit", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"c", "->", "0"}], ",", 
           RowBox[{"Direction", "->", "\"\<FromAbove\>\""}], ",", 
           RowBox[{"Assumptions", "->", 
            RowBox[{"r", ">", "0"}]}]}], "]"}], ",", "$Failed"}], "]"}]}]}]}],
     "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",ExpressionUUID->\
"bef537b6-b3f7-6648-aac3-5f26018da286"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Enumerate subsets", "Subsection",ExpressionUUID->"68b7591f-0fb6-c548-878b-f840753fded8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"termNames", "=", 
   RowBox[{"Keys", "[", "candidateTerms", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"subsets", "=", 
   RowBox[{"Rest", "@", 
    RowBox[{"Subsets", "[", 
     RowBox[{"termNames", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "4"}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "subsets", "]"}]}], "Input",ExpressionUUID->"21fa80b8-\
f1b0-5448-abfe-bb8532ff3b5a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example audit of selected candidates", "Subsection",ExpressionUUID->"65f6d0b5-0621-cc4b-8d33-30cb0d6e6c9e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"auditCandidate", "[", "names_List", "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"expr", ",", "sols"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"expr", "=", 
        RowBox[{"makePotential", "[", "names", "]"}]}], ";", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"sols", "=", 
        RowBox[{"Quiet", "@", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"stationarySystem", "[", "expr", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "c", ",", "q"}], "}"}], ",", "Reals"}], 
          "]"}]}]}], ";", "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"\"\<Terms\>\"", "->", "names"}], ",", "\[IndentingNewLine]",
          "    ", 
         RowBox[{"\"\<Potential\>\"", "->", "expr"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StationarySolutions\>\"", "->", "sols"}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<StableSolutions\>\"", "->", 
          RowBox[{"Select", "[", 
           RowBox[{"sols", ",", 
            RowBox[{
             RowBox[{"localStableQ", "[", 
              RowBox[{"expr", ",", "#"}], "]"}], " ", "&"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"\"\<BoundednessEvidence\>\"", "->", 
          RowBox[{"boundedSliceEvidence", "[", "expr", "]"}]}]}], 
        "\[IndentingNewLine]", "  ", "|>"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sampleAudit", "=", 
    RowBox[{"auditCandidate", " ", "/@", " ", 
     RowBox[{"{", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<rhoLogChi\>\"", ",", "\"\<chiR2\>\""}], "}"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"{", 
        RowBox[{"\"\<rhoLogRhoOverChi\>\"", ",", "\"\<minusRhoPlusChi\>\"", 
         ",", "\"\<R2Over2Chi\>\""}], "}"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"{", "\"\<rho2Chi\>\"", "}"}], ",", "\[IndentingNewLine]", 
       "  ", 
       RowBox[{"{", 
        RowBox[{"\"\<chiR2\>\"", ",", "\"\<deltaRhoChiR\>\"", 
         ",", "\"\<rho2Chi\>\""}], "}"}]}], "\[IndentingNewLine]", "}"}]}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"sampleAudit", " ", "//", " ", "Dataset"}]}], "Input",ExpressionUUID->\
"ac9151d6-3912-124f-832f-317689b29248"],

