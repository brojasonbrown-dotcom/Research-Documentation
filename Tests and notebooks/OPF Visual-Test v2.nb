Cell[CellGroupData[{

Cell["2. Structure improvements over the source notebook", "Section",ExpressionUUID->"62b06a9b-1c78-8f47-8bc6-58544b17cdc6"],

Cell[CellGroupData[{

Cell["Main structural issues in the original material", "Subsection",ExpressionUUID->"3caec0d1-0bf9-ad4f-b506-a61937c13fc9"],

Cell[TextData[{
 "1. ",
 StyleBox["Definitions, derivations, and conclusions are mixed together.",
  FontWeight->Bold],
 "2. ",
 StyleBox["Some outputs shown are mathematically inconsistent with the \
declared Lagrangian.",
  FontWeight->Bold],
 "3. ",
 StyleBox["Implementation errors are present",
  FontWeight->Bold],
 " and need to be isolated before interpretation."
}], "Text",ExpressionUUID->"03286618-a3bf-d84a-9195-55f80d748704"],

Cell[TextData[{
 "4. ",
 StyleBox["Physics language outruns the mathematics",
  FontWeight->Bold],
 " in several places."
}], "Text",ExpressionUUID->"3a1aefd3-c9af-4845-994a-cb0ed5675b98"],

Cell[TextData[{
 "5. ",
 StyleBox["Regression tests are missing",
  FontWeight->Bold],
 ", so it is hard to know whether corrections preserve intended behavior. "
}], "Text",ExpressionUUID->"b850792d-ec44-7f49-801d-89d2b28c165e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Better structure", "Subsection",ExpressionUUID->"c4b2acf0-9365-7443-b7b6-f2ec7470b4e7"],

Cell["A stronger notebook should be organized as:", "Text",ExpressionUUID->"e25cb4cc-8e6c-fb4c-93d7-14048933604d"],

Cell[TextData[{
 "1. ",
 StyleBox["Axioms / hypotheses",
  FontWeight->Bold],
 "2. ",
 StyleBox["Formal variables and domains",
  FontWeight->Bold],
 "3. ",
 StyleBox["Action and admissibility conditions",
  FontWeight->Bold],
 "4. ",
 StyleBox["Symbolic derivation tests",
  FontWeight->Bold],
 "5. ",
 StyleBox["Homogeneous fixed-point sector",
  FontWeight->Bold],
 "6. ",
 StyleBox["Linearization and modal stability",
  FontWeight->Bold],
 "7. ",
 StyleBox["Scale ansatz consistency checks",
  FontWeight->Bold],
 "8. ",
 StyleBox["Measurement kernel definition and tests",
  FontWeight->Bold],
 "9. ",
 StyleBox["Numerical probes with deterministic seeds",
  FontWeight->Bold],
 "10. ",
 StyleBox["Claim audit: what is proved, what is suggested, what is metaphor",
  FontWeight->Bold],
 "11. ",
 StyleBox["Regression suite",
  FontWeight->Bold]
}], "Text",ExpressionUUID->"680c1f9e-4cf4-af4e-b3af-60ed6e223cb3"],

