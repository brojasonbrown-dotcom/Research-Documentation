Cell[CellGroupData[{

Cell["14. Measurement kernel section: operational meaning", "Section",ExpressionUUID->"98d7bc9d-ea2c-6342-a650-7d75af3c63ec"],

Cell["\<\
One of the biggest risks in the original notebook is that \
\"self-measurement\" is suggestive but not always operationally defined.\
\>", "Text",ExpressionUUID->"611d73e5-ed70-6a41-bc39-6db281476f04"],

Cell["\<\
A rigorous notebook should define a measurement kernel as a map, not a \
metaphor. \
\>", "Text",ExpressionUUID->"f67f8852-192a-9842-895e-c33d74e0fce2"],

Cell[CellGroupData[{

Cell["Example operator form", "Subsection",ExpressionUUID->"94019cf0-6980-504e-941a-59a8ee2da7d8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "kernelOperator", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kernelOperator", "[", 
    RowBox[{"psi_", ",", "xGrid_List", ",", "theta_", ",", "s_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dx", ",", "kernel"}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"dx", "=", 
       RowBox[{
        RowBox[{"xGrid", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"xGrid", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", "  ", 
      RowBox[{"kernel", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"xGrid", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "-", 
                RowBox[{"xGrid", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "^", "2"}]}], "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", 
              RowBox[{"s", "^", "2"}]}], ")"}]}], "]"}], " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"theta", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"xGrid", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "-", 
              RowBox[{"xGrid", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "xGrid", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Length", "[", "xGrid", "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "  ", "]"}]}], ";", "\[IndentingNewLine]", 
      "  ", 
      RowBox[{
       RowBox[{"kernel", ".", "psi"}], "*", "dx"}]}]}], "\[IndentingNewLine]",
     "]"}]}], ";"}]}], "Input",ExpressionUUID->"999fb0ca-bebd-8646-8df0-\
775f245d3a61"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Fixed-point iteration test", "Subsection",ExpressionUUID->"205e127d-453b-7548-b9e8-3554c3211638"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "powerIterate", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"powerIterate", "[", 
    RowBox[{"psi0_", ",", "xGrid_List", ",", "theta_", ",", "s_", ",", 
     RowBox[{"maxIter_", ":", " ", "400"}], ",", 
     RowBox[{"tol_", ":", " ", 
      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"psi", "=", 
        RowBox[{"Normalize", "[", "psi0", "]"}]}], ",", "new", ",", 
       RowBox[{"i", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"i", "<", "maxIter"}], ",", "\[IndentingNewLine]", "    ", 
        RowBox[{
         RowBox[{"new", "=", 
          RowBox[{"Normalize", "[", 
           RowBox[{"kernelOperator", "[", 
            RowBox[{"psi", ",", "xGrid", ",", "theta", ",", "s"}], "]"}], 
           "]"}]}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{"new", "-", "psi"}], "]"}], "<", "tol"}], ",", 
           RowBox[{"Return", "[", "new", "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", "    ", 
         RowBox[{"psi", "=", "new"}], ";", "\[IndentingNewLine]", "    ", 
         RowBox[{"i", "++"}], ";"}]}], "\[IndentingNewLine]", "  ", "]"}], ";",
       "\[IndentingNewLine]", "  ", "psi"}]}], "\[IndentingNewLine]", "]"}]}],
   ";"}]}], "Input",ExpressionUUID->"5b087e85-b7a6-5547-9721-126a9afd3728"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Deterministic reproducibility test", "Subsection",ExpressionUUID->"5d9655fd-e33b-d341-af55-0d28c93904d6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"xGrid", "=", 
   RowBox[{"Subdivide", "[", 
    RowBox[{"0.", ",", "10.", ",", "127"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"psi0a", "=", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"Length", "[", "xGrid", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "7", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"psi0b", "=", 
    RowBox[{"RandomReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
      RowBox[{"Length", "[", "xGrid", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"thetaVal", "=", 
   RowBox[{"2", " ", "GoldenRatio"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sVal", "=", "0.5"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"psiStarA", "=", 
   RowBox[{"powerIterate", "[", 
    RowBox[{"psi0a", ",", "xGrid", ",", "thetaVal", ",", "sVal"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"psiStarB", "=", 
    RowBox[{"powerIterate", "[", 
     RowBox[{"psi0b", ",", "xGrid", ",", "thetaVal", ",", "sVal"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"<|", "\[IndentingNewLine]", "  ", 
  RowBox[{
   RowBox[{"\"\<SameInitialSeed\>\"", "->", 
    RowBox[{"(", 
     RowBox[{"psi0a", "==", "psi0b"}], ")"}]}], ",", "\[IndentingNewLine]", 
   "  ", 
   RowBox[{"\"\<SameFixedPoint\>\"", "->", 
    RowBox[{"(", 
     RowBox[{"psiStarA", "==", "psiStarB"}], ")"}]}], ",", 
   "\[IndentingNewLine]", "  ", 
   RowBox[{"\"\<ResidualNorm\>\"", "->", 
    RowBox[{"Norm", "[", 
     RowBox[{
      RowBox[{"kernelOperator", "[", 
       RowBox[{"psiStarA", ",", "xGrid", ",", "thetaVal", ",", "sVal"}], 
       "]"}], "-", "psiStarA"}], "]"}]}]}], "\[IndentingNewLine]", 
  "|>"}]}], "Input",ExpressionUUID->"cf0ff15a-c054-004a-af13-08cbacaa42cb"],

Cell["\<\
This is the kind of explicit evidence a rigorous notebook should foreground. \
\>", "Text",ExpressionUUID->"04cece46-5bbb-1d45-bd8d-c1a00364b75a"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
   AutoDelete->False,
   FrameStyle->Directive[
     LightDarkSwitched[
      GrayLevel[0.8], 
      GrayLevel[0.4867756]], 
     AbsoluteThickness[1]],
   GridBoxDividers->{
    "Columns" -> {False, {True}, False}, "Rows" -> {False, {True}, False}},
   GridBoxItemSize->{"Columns" -> {{Fit}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Text", "MarkdownDelimiter",
 ShowStringCharacters->False,
 Background->None,ExpressionUUID->"5d839c83-ee0b-f346-9f63-20fe8afff926"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["15. Ratio and golden-parameter tests", "Section",ExpressionUUID->"e909c9bd-35ff-2c47-9afa-4456acc74576"],

Cell[TextData[{
 "Golden-ratio claims should be tested as ",
 StyleBox["parameterized spectral claims",
  FontWeight->Bold],
 ", not treated as inherently privileged. "
}], "Text",ExpressionUUID->"3af20534-4777-ba4e-98d7-e6aec68760c2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"testRatios", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<GoldenRatio\>\"", "->", 
       RowBox[{"N", "[", 
        RowBox[{"GoldenRatio", ",", "30"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<Sqrt2\>\"", "->", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", "2", "]"}], ",", "30"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<PiOver2\>\"", "->", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Pi", "/", "2"}], ",", "30"}], "]"}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<GoldenAngleFraction\>\"", "->", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"3", "-", 
            RowBox[{"Sqrt", "[", "5", "]"}]}], ")"}], "/", "2"}], ",", "30"}],
         "]"}]}]}], "\[IndentingNewLine]", "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"testRatios", " ", "//", " ", "Dataset"}]}], "Input",ExpressionUUID->\
"dfde3fea-12d3-5e42-b75c-fd10b8a674d9"],

Cell[CellGroupData[{

Cell["Important interpretation note", "Subsection",ExpressionUUID->"d820edf3-aaf4-4949-ba62-e021508740e8"],

Cell[TextData[{
 "Finding that a golden-ratio parameter produces a clean or interesting \
spectrum does ",
 StyleBox["not",
  FontWeight->Bold],
 " by itself imply: "
}], "Text",ExpressionUUID->"2da844b0-473c-e04a-83fb-b1bd1e93f4ff"],

Cell["physical fundamentality", "Item",ExpressionUUID->"98c44d91-34ba-944b-ba93-1a434b781929"],

Cell["ontological necessity", "Item",ExpressionUUID->"e2f7c777-1f8f-9e48-8969-8493d33f3831"],

Cell["consciousness relevance", "Item",ExpressionUUID->"cd152e26-8f8a-5e48-9642-c236d29f78b2"],

Cell["uniqueness", "Item",ExpressionUUID->"d996faf1-8d90-e04e-aba1-657ec75a3715"],

Cell["\<\
It only shows a property of a selected model family unless comparative \
exclusion tests are done. \
\>", "Text",ExpressionUUID->"b6a6ac08-a3f9-5e49-acc2-39888cace5f9"],

