Cell[CellGroupData[{

Cell["\<\
5. First rigorous check: derive Euler\[Dash]Lagrange equations correctly\
\>", "Section",ExpressionUUID->"e973095f-9a38-a248-ba90-30539c91a025"],

Cell["The earlier notebook output ", "Text",ExpressionUUID->"b20d597a-c4cf-bb46-a861-077127d4e8dd"],

Cell[TextData[Cell[BoxData[Cell["Log[chi[x, sigma]] == 0",
  Background->None,ExpressionUUID->
  "52a431e3-2eb6-9644-b9de-2df9d1f35466"]], \
"InlineCode",ExpressionUUID->"99cb248d-6ddd-b045-9d86-f5db74700f73"]], "Item",\
ExpressionUUID->"857bc99d-e2f1-1d4b-8564-261d5e08acfc"],

Cell[TextData[Cell[BoxData[Cell["res[x, sigma]^2 == 0",
  Background->None,ExpressionUUID->
  "250971bc-84a7-9e4f-885e-584d5f852cf4"]], \
"InlineCode",ExpressionUUID->"e40752e3-24de-114a-a0ec-ac66fdcafd72"]], "Item",\
ExpressionUUID->"f854f8c8-e2ab-0a4f-9fec-81c967b1cdda"],

Cell[TextData[Cell[BoxData[Cell["chi[x, sigma] (2 res[x, sigma] + delta \
rho[x, sigma]) == 0",
  Background->None,ExpressionUUID->
  "76258f97-5c2b-7e45-8dec-91ba83bf7c1d"]], \
"InlineCode",ExpressionUUID->"2ad905f2-4e07-d94e-b17e-524df2d7f0bd"]], "Item",\
ExpressionUUID->"70ebaa3e-a038-ae49-8190-ab2f4fea3382"],

Cell["\<\
cannot be the full Euler\[Dash]Lagrange system for the displayed Lagrangian \
because it omits: \
\>", "Text",ExpressionUUID->"84a9c898-a55b-f844-9dd6-936f9567753c"],

Cell["derivative terms from the gradient regularizers", "Item",ExpressionUUID->"76b0c1de-1e1d-8641-91c8-855a56bfed09"],

Cell[TextData[{
 "the ",
 Cell[BoxData[Cell["lambda rho^2",
   Background->None,ExpressionUUID->"b7bb7ec3-df32-5345-9e9c-92129641ee68"]], 
  "InlineCode",ExpressionUUID->"a847415f-807a-4e4f-ac02-4dc3958cdedf"],
 " contribution"
}], "Item",ExpressionUUID->"4be57feb-4532-a44c-9f28-b679403a0c20"],

Cell[TextData[{
 "the ",
 Cell[BoxData[Cell["delta rho chi res",
   Background->None,ExpressionUUID->"8075c593-abb4-d640-a16d-79c5cc7b1c6d"]], 
  "InlineCode",ExpressionUUID->"8198d994-e918-f84d-b819-c120b512c554"],
 " contribution in the first two variations"
}], "Item",ExpressionUUID->"0f8c5240-9732-a443-be80-8848612ff2a7"],

Cell[TextData[{
 "the derivative of ",
 Cell[BoxData[Cell["rho Log[chi]",
   Background->None,ExpressionUUID->"ceb9609e-53d3-0e49-9a7a-700a4f536415"]], 
  "InlineCode",ExpressionUUID->"7c70501c-9362-a941-8635-7d18bbcac42b"],
 " with respect to ",
 StyleBox["chi", "TI"]
}], "Item",ExpressionUUID->"d4f60504-19fd-4e4b-82d4-e0cb85fa7156"],

Cell["So we recompute them from scratch. ", "Text",ExpressionUUID->"3bcb45fe-37c9-464b-9825-3cf83b6c184f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eulerRho", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"VariationalMethods`VariationalD", "[", 
        RowBox[{"lagrangianDensity", ",", 
         RowBox[{"rho", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}], " ", "//", " ", 
       "First"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"$Assumptions", "&&", "domainCondition"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eulerChi", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"VariationalMethods`VariationalD", "[", 
        RowBox[{"lagrangianDensity", ",", 
         RowBox[{"chi", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}], " ", "//", " ", 
       "First"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"$Assumptions", "&&", "domainCondition"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eulerRes", "=", 
    RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"VariationalMethods`VariationalD", "[", 
        RowBox[{"lagrangianDensity", ",", 
         RowBox[{"res", "[", 
          RowBox[{"x", ",", "sigma"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "sigma"}], "}"}]}], "]"}], " ", "//", " ", 
       "First"}], ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"$Assumptions", "&&", "domainCondition"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fieldEquations", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eulerRho", ",", "eulerChi", ",", "eulerRes"}], "}"}], "==", 
     "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Column", "[", "fieldEquations", "]"}]}], "Input",ExpressionUUID->\
"3738b37b-68a2-bc41-b8c2-0bea2e21dc17"],

Cell[CellGroupData[{

Cell["Sanity checks on the symbolic structure", "Subsection",ExpressionUUID->"049b8cbd-0edb-e046-b0de-8f97f19248c7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eulerStructureTests", "=", 
    RowBox[{"<|", "\[IndentingNewLine]", "  ", 
     RowBox[{
      RowBox[{"\"\<RhoContainsLambdaTerm\>\"", "->", 
       RowBox[{"!", " ", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"eulerRho", ",", "lambda"}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<RhoContainsDeltaTerm\>\"", "->", 
       RowBox[{"!", " ", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"eulerRho", ",", "delta"}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<RhoContainsSecondDerivatives\>\"", "->", 
       RowBox[{"!", " ", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"eulerRho", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"2", ",", "0"}], "]"}], "[", "rho", "]"}], " ", "|", " ", 
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"0", ",", "2"}], "]"}], "[", "rho", "]"}]}]}], "]"}]}]}],
       ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ChiContainsLogDerivative\>\"", "->", 
       RowBox[{"!", " ", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"eulerChi", ",", 
          RowBox[{"1", "/", 
           RowBox[{"chi", "[", 
            RowBox[{"x", ",", "sigma"}], "]"}]}]}], "]"}]}]}], ",", 
      "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ChiContainsGradientTerms\>\"", "->", 
       RowBox[{"!", " ", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"eulerChi", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"2", ",", "0"}], "]"}], "[", "chi", "]"}], " ", "|", " ", 
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"0", ",", "2"}], "]"}], "[", "chi", "]"}]}]}], "]"}]}]}],
       ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ResContainsGradientTerms\>\"", "->", 
       RowBox[{"!", " ", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"eulerRes", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"2", ",", "0"}], "]"}], "[", "res", "]"}], " ", "|", " ", 
           RowBox[{
            RowBox[{"Derivative", "[", 
             RowBox[{"0", ",", "2"}], "]"}], "[", "res", "]"}]}]}], "]"}]}]}],
       ",", "\[IndentingNewLine]", "  ", 
      RowBox[{"\"\<ResContainsCouplingTerms\>\"", "->", 
       RowBox[{"!", " ", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"eulerRes", ",", "delta"}], "]"}]}]}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"eulerStructureTests", " ", "//", " ", "Dataset"}]}], "Input",Express\
ionUUID->"0efcc582-4847-e140-b1f1-372650fe7387"],

Cell[TextData[{
 "These tests should all evaluate to ",
 ButtonBox["True",
  BaseStyle->"Link",
  ButtonData->"paclet:ref/True"],
 ". If not, the implementation is wrong. "
}], "Text",ExpressionUUID->"380f77bb-ab44-7341-9048-59c6bd820ae4"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     TemplateBox[{0},
      "Spacer1"]},
    {
     TemplateBox[{0},
      "Spacer1"]}
   },
