Cell[CellGroupData[{

Cell["20. Final claim-status table", "Section",ExpressionUUID->"3a1d76ed-0904-884e-987e-214d97ce2578"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"claimAudit", "=", 
    RowBox[{"Dataset", "[", 
     RowBox[{"{", "\[IndentingNewLine]", "  ", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<Euler\[Dash]Lagrange equations can be derived \
symbolically\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", "->", "\"\<Testable now\>\""}], ",", 
         RowBox[{"\"\<Requirement\>\"", 
          "->", "\"\<Correct use of VariationalD\>\""}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<Original OPF potential is stable\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", 
          "->", "\"\<Needs testing / likely false in original form\>\""}], ",", 
         RowBox[{"\"\<Requirement\>\"", 
          "->", "\"\<Boundedness and Hessian analysis\>\""}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<KL-like potential is rediscovered by search\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", 
          "->", "\"\<Plausible if regression reproduced\>\""}], ",", 
         RowBox[{"\"\<Requirement\>\"", 
          "->", "\"\<Independent WL enumeration\>\""}]}], "|>"}], ",", 
       "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<Golden-ratio torus leaves spectral fingerprint\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", "->", "\"\<Model-testable\>\""}], ",", 
         RowBox[{"\"\<Requirement\>\"", 
          "->", "\"\<Repeatable spectral comparison against controls\>\""}]}],
         "|>"}], ",", "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<Self-measurement operator has deterministic fixed points\
\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", "->", "\"\<Testable\>\""}], ",", 
         RowBox[{"\"\<Requirement\>\"", 
          "->", "\"\<Operator residual and reproducibility\>\""}]}], "|>"}], ",",
        "\[IndentingNewLine]", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Claim\>\"", 
          "->", "\"\<Information arises as energy\>\""}], ",", 
         RowBox[{"\"\<Status\>\"", 
          "->", "\"\<Interpretive / not yet established\>\""}], ",", 
         RowBox[{"\"\<Requirement\>\"", 
          "->", "\"\<Operational derivation and physical observable \
map\>\""}]}], "|>"}]}], "\[IndentingNewLine]", "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", "claimAudit"}], "Input",Expr\
essionUUID->"74f6a6c3-c6b2-ed44-be53-26b31fca8deb"],

