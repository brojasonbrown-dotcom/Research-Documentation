Cell[CellGroupData[{

Cell["22. Recommended next actions", "Section",ExpressionUUID->"3ce7c7ef-7992-2040-8914-7e435e1ef53d"],

Cell["\<\
1. Run the symbolic sections first and verify the Euler equations.\
\>", "Text",ExpressionUUID->"ebbc33f8-8b28-a244-9193-fa0ad8a13197"],

Cell["2. Lock those outputs with regression tests.", "Text",ExpressionUUID->"bbf18e26-9f16-e14e-b955-8f2110590f24"],

Cell["\<\
3. Reproduce the candidate-potential search in pure Wolfram Language.\
\>", "Text",ExpressionUUID->"85faeab5-4ea9-7d49-9545-4b532374d297"],

Cell["\<\
4. Only then integrate the torus/Koopman and self-measurement probes.\
\>", "Text",ExpressionUUID->"85b8c5dc-a4ba-dd44-93db-44d550756917"],

Cell["\<\
5. Keep all high-level claims in a separate \[OpenCurlyDoubleQuote]claim \
audit\[CloseCurlyDoubleQuote] section. \
\>", "Text",ExpressionUUID->"4b76ca5a-c547-374c-af63-ade2fe348b1b"],

